# FastCom — Git Line-Ending & Binary Policy
* text=auto

# C# / .NET
*.cs     text eol=lf
*.razor  text eol=lf
*.csproj text eol=lf
*.sln    text eol=lf
*.props  text eol=lf

# Web
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.map  text eol=lf

# Docs
*.md  text eol=lf
*.txt text eol=lf

# Scripts
*.ps1 text eol=lf
*.sql text eol=lf

# Binary — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.otf  binary
*.ttf  binary
*.pdf  binary
*.xlsx binary
*.docx binary
*.zip  binary