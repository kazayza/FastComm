<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FastCom.Server</RootNamespace>
    <!-- ⚠️ مهم: الـ Client بيتنشر جوه wwwroot/app -->
    <StaticWebAssetBasePath Condition="'$(Configuration)'=='Release'">app</StaticWebAssetBasePath>
    <UserSecretsId>ffc2c64e-8fff-4979-afaf-2c4e97826182</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastCom.Application\FastCom.Application.csproj" />
    <ProjectReference Include="..\FastCom.Infrastructure\FastCom.Infrastructure.csproj" />
    <ProjectReference Include="..\FastCom.Shared\FastCom.Shared.csproj" />
    <!-- 🔗 Blazor WASM Client -->
    <ProjectReference Include="..\FastCom.Client\FastCom.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />

    <!-- 🔑 مهم: بيوفر UseBlazorFrameworkFiles() و UseWebAssemblyDebugging()
         بدونه بيطلع CS1061 في Program.cs -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.11" />

    <!-- 🔧 Design Time — لازم في الـ STARTUP project عشان dotnet ef يشتغل -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />

    <!-- PDF عربي -->
    <PackageReference Include="QuestPDF" Version="2024.10.3" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- Excel Export -->
    <PackageReference Include="ClosedXML" Version="0.104.1" />
  </ItemGroup>

</Project>
