{
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_USER_SECRETS__dotnet_user_secrets_set_ConnectionStrings:DefaultConnection"
  },

  "Jwt": {
    "Key": "SET_VIA_USER_SECRETS__dotnet_user_secrets_set_Jwt:Key__0123456789_ABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789",
    "Issuer": "FastCom",
    "Audience": "FastComClient",
    "ExpirationMinutes": 480
  },

  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7001",
      "http://localhost:5001"
    ]
  },

  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".xlsx", ".xls", ".docx", ".doc" ]
  },

  "Email": {
    "Provider": "Smtp",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "",
    "FromName": "FastCom"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
