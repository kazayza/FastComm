<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FastCom.Client</RootNamespace>
    <!-- ⚠️ مهم: الـ Client بيتنشر جوه wwwroot بتاع الـ Server -->
    <StaticWebAssetBasePath Condition="'$(Configuration)'=='Release'">app</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />

    <!-- 🔑 AuthenticationStateProvider / AuthorizeRouteView / CascadingAuthenticationState
         ⚠️ الحزمة دي مش transitively — لازم تتضاف صراحة -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.11" />

    <!-- 🔑 IHttpClientFactory + AddHttpClient + AddHttpMessageHandler -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />

    <!-- 🎨 الـ UI Framework -->
    <PackageReference Include="MudBlazor" Version="7.15.0" />
    <!-- 📊 الرسوم البيانية: ⏳ هتتضاف في Step 12 (Dashboard)
         ⚠️ Blazor-ApexCharts 3.6.1 مش موجود على NuGet (أحدث إصدار 4.0.0) -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastCom.Shared\FastCom.Shared.csproj" />
  </ItemGroup>

</Project>
