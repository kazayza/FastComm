@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

@* ═══════════════════════════════════════════
   دايلوج تغيير كلمة المرور — svc-modal (الكانون)
═══════════════════════════════════════════ *@
@if (Open)
{
    <div class="svc-modal-backdrop" @onclick="Cancel" role="dialog" aria-modal="true" aria-label="تغيير كلمة المرور">
        <div class="svc-modal cp-modal" @onclick:stopPropagation="true">

            <div class="svc-modal-head">
                <div class="svc-head-icon svc-icon-edit" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">تغيير كلمة المرور</div>
                    <div class="svc-head-sub">أدخل كلمة المرور الحالية ثم اختر كلمة جديدة آمنة</div>
                </div>
                <button class="svc-head-close" @onclick="Cancel" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="svc-banner @(_ok ? "svc-banner-ok" : "svc-banner-err")" role="alert">
                    <span class="svc-banner-msg">@_msg</span>
                    <button class="svc-banner-x" @onclick="() => _msg = null" type="button">&#10005;</button>
                </div>
            }

            <div class="svc-modal-body">
                <div class="cp-body">

                    <div class="svc-field">
                        <label class="svc-label">كلمة المرور الحالية <span class="svc-req">*</span></label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input type="password" class="svc-input with-prefix" @bind="_cur"
                                   placeholder="••••••••" autocomplete="current-password" />
                        </div>
                    </div>

                    <div class="svc-field">
                        <label class="svc-label">كلمة المرور الجديدة <span class="svc-req">*</span></label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3"/>
                                </svg>
                            </span>
                            <input type="@(_show ? "text" : "password")" class="svc-input with-prefix" @bind="_new"
                                   placeholder="8 أحرف على الأقل" autocomplete="new-password" />
                            <button type="button" class="cp-eye" @onclick="() => _show = !_show"
                                    title="@(_show ? "إخفاء" : "إظهار")" tabindex="-1">
                                @if (_show)
                                {
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/>
                                        <path d="M1 1l22 22" stroke-linecap="round"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                }
                            </button>
                        </div>
                        <div class="svc-hint">لا تقل عن 8 أحرف — وتختلف عن كلمة المرور الحالية</div>
                    </div>

                    <div class="svc-field">
                        <label class="svc-label">تأكيد كلمة المرور الجديدة <span class="svc-req">*</span></label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <input type="@(_show ? "text" : "password")" class="svc-input with-prefix" @bind="_conf"
                                   placeholder="أعد كتابة كلمة المرور الجديدة" autocomplete="new-password" />
                        </div>
                    </div>

                </div>
            </div>

            <div class="svc-modal-foot">
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="Cancel" type="button">إلغاء</button>
                    <button class="svc-btn-save" @onclick="SaveAsync" disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري التغيير...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>تغيير كلمة المرور</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback Close { get; set; }

    private string _cur = "", _new = "", _conf = "";
    private bool _show, _saving;
    private string? _msg;
    private bool _ok = true;

    private void Cancel()
    {
        _cur = _new = _conf = "";
        _msg = null; _show = false;
        _ = Close.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        if (string.IsNullOrWhiteSpace(_cur) || string.IsNullOrWhiteSpace(_new) || string.IsNullOrWhiteSpace(_conf))
        { _ok = false; _msg = "يرجى تعبئة الحقول الثلاثة"; return; }
        if (_new.Length < 8)
        { _ok = false; _msg = "كلمة المرور الجديدة يجب ألا تقل عن 8 أحرف"; return; }
        if (_new != _conf)
        { _ok = false; _msg = "كلمتا المرور الجديدتان غير متطابقتين"; return; }

        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/auth/change-password", new
            {
                currentPassword = _cur,
                newPassword     = _new,
                confirmPassword = _conf
            });
            var m = await MsgOf(res);
            _ok = res.IsSuccessStatusCode;
            if (_ok)
            {
                Snackbar.Add(m, Severity.Success);
                _cur = _new = _conf = ""; _show = false;
                await Close.InvokeAsync();
            }
            else _msg = m;
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم تغيير كلمة المرور بنجاح" : "حدث خطأ — يرجى المحاولة مرة أخرى"; }
    }
}

<style>
    .svc-modal-backdrop {
        position: fixed; inset: 0; z-index: 1400;
        background: rgba(10,27,59,.62);
        backdrop-filter: blur(6px);
        display: flex; align-items: center; justify-content: center;
        padding: 20px;
        animation: svc-fade .2s ease both;
    }
    .svc-modal {
        width: 100%; max-width: 560px;
        background: #fff; border-radius: 20px;
        box-shadow: 0 25px 60px rgba(10,27,59,.28), 0 8px 20px rgba(10,27,59,.12);
        overflow: hidden;
        animation: svc-pop .28s cubic-bezier(.22,.9,.36,1.1) both;
        max-height: 92vh;
        display: flex; flex-direction: column;
    }
    .svc-modal-head {
        display: flex; align-items: center; gap: 14px;
        padding: 20px 24px;
        background: linear-gradient(135deg, #0A1B3B 0%, #16306B 100%);
        color: #fff; flex: 0 0 auto;
        position: relative; overflow: hidden;
    }
    .svc-modal-head::before {
        content: "";
        position: absolute; top: -50px; right: -50px;
        width: 200px; height: 200px; border-radius: 50%;
        background: radial-gradient(circle, rgba(255,128,21,.15) 0%, transparent 70%);
        pointer-events: none;
    }
    .svc-head-icon {
        width: 46px; height: 46px; flex: 0 0 46px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 13px; position: relative; z-index: 1;
    }
    .svc-icon-create {
        background: rgba(27,158,94,.2); color: #6ee7b7;
        border: 1px solid rgba(110,231,183,.3);
    }
    .svc-icon-edit {
        background: rgba(255,128,21,.2); color: #FFD9B8;
        border: 1px solid rgba(255,128,21,.3);
    }
    .svc-head-text  { flex: 1; min-width: 0; position: relative; z-index: 1; }
    .svc-head-title { font-size: 16px; font-weight: 800; color: #fff; line-height: 1.3; }
    .svc-head-sub   { font-size: 11.5px; color: rgba(255,255,255,.62); margin-top: 3px; }
    .svc-head-sub strong { color: #FFD9B8; font-weight: 700; }
    .svc-head-close {
        width: 34px; height: 34px; flex: 0 0 34px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255,255,255,.15); border-radius: 9px;
        background: rgba(255,255,255,.06); color: rgba(255,255,255,.7);
        cursor: pointer; transition: all .15s; position: relative; z-index: 1;
    }
    .svc-head-close:hover {
        background: rgba(255,255,255,.14);
        color: #fff; transform: rotate(90deg);
    }
    .svc-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 20px; flex: 0 0 auto;
        font-size: 12.5px; font-weight: 600;
    }
    .svc-banner-ok  { background: #e9f8f0; color: #0e7a43; border-bottom: 1px solid #b5e8d0; }
    .svc-banner-err { background: #fff0f2; color: #D64545; border-bottom: 1px solid #ffc8cf; }
    .svc-banner-msg { flex: 1; }
    .svc-banner-x {
        background: none; border: none;
        color: inherit; opacity: .5;
        cursor: pointer; display: flex;
    }
    .svc-banner-x:hover { opacity: 1; }
    .svc-modal-body { flex: 1 1 auto; overflow-y: auto; padding: 0; }
    .svc-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }
    .svc-field  { display: flex; flex-direction: column; gap: 5px; }
    .svc-label {
        font-size: 11.5px; font-weight: 800; color: #344258;
        display: flex; align-items: center; gap: 4px;
    }
    .svc-req { color: #D64545; font-size: 13px; }
    .svc-input-wrap {
        position: relative; display: flex; align-items: center;
    }
    .svc-prefix {
        position: absolute; right: 12px; z-index: 1;
        display: flex; align-items: center;
        color: #9aaabb; pointer-events: none;
    }
    .svc-input {
        width: 100%; height: 42px;
        border: 1.5px solid #d8e2f0; border-radius: 10px;
        background: #fafcff; color: #1A2332;
        font-family: inherit; font-size: 13px;
        padding: 0 12px; outline: none;
        box-sizing: border-box;
        transition: border-color .15s, box-shadow .15s, background .15s;
    }
    .svc-input:focus {
        border-color: #0B56DF;
        box-shadow: 0 0 0 3px rgba(11,86,223,.1);
        background: #fff;
    }
    .svc-input:disabled {
        background: #f5f7fa; color: #8899ae; cursor: not-allowed;
    }
    .svc-input::placeholder { color: #b0bcc8; }
    .svc-hint {
        font-size: 10.5px; color: #8899ae; font-weight: 500;
        display: flex; align-items: center; gap: 5px;
    }
    .svc-modal-foot {
        display: flex; align-items: center;
        justify-content: space-between; gap: 10px;
        padding: 14px 20px;
        background: linear-gradient(180deg, #fafbfd 0%, #f4f6fb 100%);
        border-top: 1px solid #edf1f7;
        flex: 0 0 auto;
    }
    .svc-foot-left, .svc-foot-right {
        display: flex; align-items: center; gap: 8px;
    }
    .svc-foot-right { margin-right: auto; }
    .svc-btn-cancel {
        height: 38px; padding: 0 16px;
        border: 1.5px solid #d8e2f0; border-radius: 9px;
        background: #fff; color: #6B7A8F;
        font-family: inherit; font-size: 12px; font-weight: 700;
        cursor: pointer; transition: all .15s;
    }
    .svc-btn-cancel:hover {
        background: #f0f4fa; color: #1A2332; border-color: #c0ccd8;
    }
    .svc-btn-save {
        display: inline-flex; align-items: center; gap: 7px;
        height: 40px; padding: 0 22px;
        border: none; border-radius: 10px;
        background: linear-gradient(135deg, #0B56DF, #083CA8);
        color: #fff; font-family: inherit;
        font-size: 12.5px; font-weight: 800;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(11,86,223,.28);
        transition: all .18s;
    }
    .svc-btn-save:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(11,86,223,.4);
    }
    .svc-btn-save:disabled { opacity: .6; cursor: not-allowed; }
    .svc-spinner {
        width: 15px; height: 15px;
        border: 2px solid rgba(255,255,255,.3);
        border-top-color: #fff; border-radius: 50%;
        animation: doc-spin .7s linear infinite;
    }
    .svc-grid { grid-template-columns: 1fr; }
    .svc-modal { max-width: 100%; border-radius: 16px; }
    .svc-modal-head { padding: 16px 18px; }
    .svc-modal-foot { flex-direction: column-reverse; align-items: stretch; }
    .svc-foot-left, .svc-foot-right { width: 100%; justify-content: center; }
    .svc-btn-cancel, .svc-btn-save, .svc-btn-reset { flex: 1; justify-content: center; }
    @@keyframes svc-fade { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes svc-pop {
        from { opacity: 0; transform: translateY(20px) scale(.96); }
        to   { opacity: 1; transform: none; }
    }

    .svc-input.with-prefix { padding-right: 40px; }

    /* ── إضافات الدايلوج ── */
    .cp-modal { max-width: 470px; }
    .cp-body { padding: 20px 24px; display: flex; flex-direction: column; gap: 16px; }
    .cp-eye {
        position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
        display: flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; border: none; border-radius: 7px;
        background: transparent; color: #9aaabb; cursor: pointer; z-index: 1;
    }
    .cp-eye:hover { background: #eef2f8; color: #4a5a74; }
</style>
