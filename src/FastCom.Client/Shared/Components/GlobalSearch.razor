@using System.Net.Http.Json
@using FastCom.Client.Models
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@* ─────────────────────────────────────────────────────────────────────────
   🔍 البحث العام — الشريط العلوي
   بيبحث في: عملاء · حجوزات · عمليات · فواتير · رحلات · حاويات · سيارات
   ──────────────────────────────────────────────────────────────────────── *@
<div class="fc-search">
    @* 🔴 Value + ValueChanged (مش @bind-Value) — لأن @bind-Value
       بيولّد ValueChanged تلقائيًا، فلو كتبناها كمان بيطلع RZ10010 *@
    <MudAutocomplete T="SearchResult"
                     Value="_selected"
                     ValueChanged="OnSelected"
                     SearchFunc="SearchAsync"
                     Placeholder="@_placeholder"
                     AdornmentIcon="@Icons.Material.Filled.Search"
                     AdornmentColor="Color.Inherit"
                     MinCharacters="2"
                     DebounceInterval="350"
                     CoerceValue="false"
                     ResetValueOnEmptyText="true"
                     Clearable="true"
                     Dense="true"
                     Variant="Variant.Outlined"
                     Class="fc-search-input">

        <ItemTemplate Context="hit">
            <div class="fc-search-item">
                <span class="fc-search-badge">@hit.Entity</span>
                <span class="fc-search-main">
                    <strong>@hit.Code</strong>
                    <span>@hit.Title</span>
                </span>
                @if (!string.IsNullOrWhiteSpace(hit.Subtitle))
                {
                    <span class="fc-search-sub">@hit.Subtitle</span>
                }
                @if (!string.IsNullOrWhiteSpace(hit.Badge))
                {
                    <span class="fc-search-tag">@hit.Badge</span>
                }
            </div>
        </ItemTemplate>

        <NoItemsTemplate>
            <div class="fc-search-empty">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Small" />
                <span>@(_emptyMessage ?? "مفيش نتائج مطابقة")</span>
            </div>
        </NoItemsTemplate>

        <ProgressIndicatorTemplate>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="fc-search-progress" />
        </ProgressIndicatorTemplate>

    </MudAutocomplete>
</div>

@code {
    private SearchResult? _selected;
    private string? _lastError;
    private string? _emptyMessage;

    /// <summary>🔐 الوحدات اللي المستخدم يقدر يبحث فيها (بتيجي من الـ API).</summary>
    private List<string> _searchableIn = new();

    private string _placeholder => _searchableIn.Count > 0
        ? $"ابحث في: {string.Join(" · ", _searchableIn)}"
        : "ابحث عن عميل، حجز، عملية، فاتورة، رحلة، حاوية...";

    /// <summary>
    /// الصفحة اللي كل وحدة بتفتح عليها — + <c>?focus=</c> برقم السجل
    /// عشان القائمة تفلتر عليه على طول.
    /// 🔴 قبل كده كانت مسارات تفاصيل (<c>/customers/{0}</c>) — <b>مافيش صفحة واحدة منها موجودة</b>.
    /// </summary>
    private static readonly Dictionary<string, string> Routes = new(StringComparer.Ordinal)
    {
        ["عميل"]   = "/customers",
        ["حجز"]    = "/bookings",
        ["عملية"]  = "/operations",
        ["فاتورة"] = "/invoices",
        ["رحلة"]   = "/trips",
        ["حاوية"]  = "/containers",
        ["سيارة"]  = "/vehicles",
        ["سائق"]   = "/drivers",
        ["مورد"]   = "/suppliers",
        ["مصروف"]  = "/expenses",
        ["عهدة"]   = "/custodies",
        ["دفعة"]   = "/payments"
    };

    private async Task<IEnumerable<SearchResult>> SearchAsync(string term, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(term) || term.Trim().Length < 2)
            return Enumerable.Empty<SearchResult>();

        try
        {
            var url = $"api/search?q={Uri.EscapeDataString(term.Trim())}&take=25";
            var res = await Http.GetFromJsonAsync<SearchResponse>(url, ct);

            if (res is null) return Enumerable.Empty<SearchResult>();

            // 🔐 نحدّث الوحدات المتاحة
            if (res.SearchableIn is { Count: > 0 })
                _searchableIn = res.SearchableIn;

            if (!string.IsNullOrEmpty(res.Error))
            {
                _lastError = res.Error;
                return Enumerable.Empty<SearchResult>();
            }

            // 🔐 مافيش أي صلاحية بحث؟
            _emptyMessage = res.Results.Count == 0 && res.SearchableIn.Count == 0
                ? "ماعندكش صلاحية البحث في أي وحدة"
                : null;

            _lastError = null;
            return res.Results;
        }
        catch (Exception ex)
        {
            _lastError = ex.Message;
            return Enumerable.Empty<SearchResult>();
        }
    }

    private void OnSelected(SearchResult? hit)
    {
        if (hit is null) return;

        if (_lastError is not null)
        {
            Snackbar.Add($"البحث فشل: {_lastError}", Severity.Error);
            _lastError = null;
        }

        // 🎯 نفتح صفحة الوحدة نفسها ونفلتر على رقم السجل
        if (Routes.TryGetValue(hit.Entity, out var r))
        {
            Nav.NavigateTo($"{r}?focus={Uri.EscapeDataString(hit.Code)}");
            _selected = null;
            return;
        }

        // وحدة ملهاش صفحة — نفتح صفحة البحث بالرقم
        Nav.NavigateTo($"/search?entity={Uri.EscapeDataString(hit.Entity)}&id={hit.Id}&from={Uri.EscapeDataString(hit.Code)}");

        _selected = null;   // نفضّي الـ input بعد الاختيار
    }
}
