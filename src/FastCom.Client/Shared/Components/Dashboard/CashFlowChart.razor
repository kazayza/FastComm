@namespace FastCom.Client.Shared.Components.Dashboard
@using ApexCharts

@* 🚀 Cash Flow — Area Chart تفاعلي (ApexCharts) — مفوتر · محصّل · مصروفات آخر 6 شهور *@
@if (Points is null || Points.Count == 0)
{
    <div class="v3-empty">
        <div class="v3-empty-glow blue"></div>
        <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="MudBlazor.Size.Small" />
        <span>لا توجد حركات</span>
    </div>
}
else
{
    <ApexChart TItem="MonthFlow" Options="GetOptions()" Height="300">
        <ApexPointSeries TItem="MonthFlow" Items="Points" SeriesType="SeriesType.Area" Name="مفوتر"
                         XValue="@(p => p.MonthName)" YValue="@(p => p.Invoiced)" />
        <ApexPointSeries TItem="MonthFlow" Items="Points" SeriesType="SeriesType.Area" Name="محصّل"
                         XValue="@(p => p.MonthName)" YValue="@(p => p.Collected)" />
        <ApexPointSeries TItem="MonthFlow" Items="Points" SeriesType="SeriesType.Area" Name="مصروفات"
                         XValue="@(p => p.MonthName)" YValue="@(p => p.Expenses)" />
    </ApexChart>
}

@code {
    [Parameter] public List<MonthFlow> Points { get; set; } = new();

    private ApexChartOptions<MonthFlow>? _opts;
    private List<MonthFlow>? _optsFor;

    /// <summary>Options متخزّنة (Cached) — مبنية مرة واحدة لكل مجموعة بيانات،
    /// مش في كل render (إعادة البناء بتعمل re-init للشارت وارتجاف).</summary>
    private ApexChartOptions<MonthFlow> GetOptions()
    {
        if (_opts is null || !ReferenceEquals(_optsFor, Points))
        {
            _opts = BuildOptions();
            _optsFor = Points;
        }
        return _opts;
    }

    // ⚠️ كل chart لازم ياخد Options instance خاصة بيه — مينفعش تتشارك
    private ApexChartOptions<MonthFlow> BuildOptions() => new()
    {
        Chart = new Chart
        {
            Toolbar = new Toolbar { Show = false },
            Zoom = new Zoom { Enabled = false },
            Height = 300
        },
        Colors = new List<string> { "#3b82f6", "#10b981", "#f59e0b" },
        DataLabels = new DataLabels { Enabled = false },
        Stroke = new Stroke { Curve = Curve.Smooth },
        Legend = new Legend { Position = LegendPosition.Top },
        Tooltip = new Tooltip { Shared = true },
        Xaxis = new XAxis
        {
            Categories = Points.Select(p => p.MonthName).ToList()
        }
    };
}
