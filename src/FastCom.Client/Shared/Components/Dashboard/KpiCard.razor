@namespace FastCom.Client.Shared.Components.Dashboard
@inject NavigationManager Nav

@* 🚀 KPI Card المطور — حجم مدمج، تفاعلي وبدون أي إيموجي *@
<div class="fc-kpi-compact @ToneClass" @onclick="Go" role="button" tabindex="0" title="افتح @Label">
    <div class="fc-kpic-inner">
        <div class="fc-kpic-icon" aria-hidden="true">
            <MudIcon Icon="@Icon" Size="Size.Medium" />
        </div>
        <div class="fc-kpic-data">
            <div class="fc-kpic-num-row">
                <span class="fc-kpic-num">@Value</span>
                @if (TrendPct is decimal t)
                {
                    <span class="fc-kpic-trend @(t > 0 ? "up" : t < 0 ? "down" : "flat")" title="نسبة التغيير عن الشهر الماضي">
                        <MudIcon Icon="@(t > 0 ? Icons.Material.Filled.TrendingUp : t < 0 ? Icons.Material.Filled.TrendingDown : Icons.Material.Filled.TrendingFlat)" Size="Size.Small" />
                        <span>@Math.Abs(t).ToString("0.#")%</span>
                    </span>
                }
            </div>
            <div class="fc-kpic-label">@Label</div>
        </div>
    </div>
</div>

<style>
    /* ── KPI COMPACT STYLE ── */
    .fc-kpi-compact {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 12px;
        padding: 12px 16px;
        cursor: pointer;
        transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
        user-select: none;
        flex: 1;
        min-width: 140px;
    }

    .fc-kpi-compact:hover {
        background: rgba(255, 255, 255, 0.14);
        border-color: rgba(255, 255, 255, 0.25);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    }

    .fc-kpi-compact:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
    }

    .fc-kpic-inner {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .fc-kpic-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }
    .fc-kpi-compact:hover .fc-kpic-icon {
        transform: scale(1.05);
    }

    /* Tones mapping */
    .fc-kpi-blue .fc-kpic-icon   { background: rgba(125, 211, 252, 0.15); color: #7dd3fc; }
    .fc-kpi-red .fc-kpic-icon    { background: rgba(252, 165, 165, 0.15); color: #fca5a5; }
    .fc-kpi-gold .fc-kpic-icon   { background: rgba(252, 211, 77, 0.15);  color: #fcd34d; }
    .fc-kpi-green .fc-kpic-icon  { background: rgba(110, 231, 183, 0.15); color: #6ee7b7; }

    .fc-kpic-data {
        flex: 1;
        min-width: 0;
    }

    .fc-kpic-num-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
    }

    .fc-kpic-num {
        font-family: "Inter", Arial, sans-serif;
        font-size: 20px;
        font-weight: 900;
        color: #fff;
        line-height: 1;
    }

    .fc-kpic-label {
        font-size: 11px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.6);
        margin-top: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Trends within Compact Card */
    .fc-kpic-trend {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 1px 6px;
        border-radius: 6px;
        font-size: 9.5px;
        font-weight: 800;
        font-family: "Inter", Arial, sans-serif;
    }
    .fc-kpic-trend.up   { background: rgba(34, 197, 94, 0.2);  color: #86efac; }
    .fc-kpic-trend.down { background: rgba(239, 68, 68, 0.2);  color: #fca5a5; }
    .fc-kpic-trend.flat { background: rgba(255, 255, 255, 0.1); color: #e2e8f0; }

    @@media (max-width: 480px) {
        .fc-kpi-compact {
            padding: 10px 12px;
            min-width: 120px;
        }
        .fc-kpic-num { font-size: 18px; }
        .fc-kpic-icon { width: 34px; height: 34px; }
    }
</style>

@code {
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Circle;
    [Parameter] public string Tone { get; set; } = "blue"; // blue | red | gold | green
    [Parameter] public decimal? TrendPct { get; set; }
    [Parameter] public string Href { get; set; } = "";

    private string ToneClass => "fc-kpi-" + Tone;
    private void Go() { if (!string.IsNullOrWhiteSpace(Href)) Nav.NavigateTo(Href); }
}