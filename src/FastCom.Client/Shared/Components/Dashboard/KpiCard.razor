@namespace FastCom.Client.Shared.Components.Dashboard
@inject NavigationManager Nav

@* 🚀 KPI Card — تفاعلي: الضغط بيفتح الصفحة + نسبة تغيير اختيارية *@
<div class="fc-kpi fc-kpi-click" @onclick="Go" role="button" tabindex="0" title="افتح @Label">
    <div class="fc-kpi-ic @ToneClass"><MudIcon Icon="@Icon" /></div>
    <div>
        <div class="fc-kpi-num">@Value</div>
        <div class="fc-kpi-lb">@Label</div>
        @if (TrendPct is decimal t)
        {
            <div class="fc-kpi-trend @(t > 0 ? "up" : t < 0 ? "down" : "flat")">
                <MudIcon Icon="@(t > 0 ? Icons.Material.Filled.TrendingUp : t < 0 ? Icons.Material.Filled.TrendingDown : Icons.Material.Filled.TrendingFlat)" Size="Size.Small" />
                <span>@Math.Abs(t).ToString("0.#")%</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Circle;
    [Parameter] public string Tone { get; set; } = "blue";     // blue | red | gold | green
    [Parameter] public decimal? TrendPct { get; set; }
    [Parameter] public string Href { get; set; } = "";

    private string ToneClass => "fc-kpi-" + Tone;
    private void Go() { if (!string.IsNullOrWhiteSpace(Href)) Nav.NavigateTo(Href); }
}
