@namespace FastCom.Client.Shared.Components.Dashboard

@* 🚀 أعمار الديون — شريط مكدّس: لم تستحق · 30 · 60 · 90 · +90 يوم *@
@if (Aging is null || Aging.Total <= 0)
{
    <div class="v3-empty"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /><span>لايوجد اى  مديونيات مستحقة</span></div>
}
else
{
    <div class="v3-aging-wrap">
        <div class="v3-aging-track" role="img" aria-label="أعمار الديون">
            @if (Aging.Current > 0)
            {
                <div class="v3-aging-seg v3-aging-cur" style="width:@W(Aging.Current)" title="لم تستحق بعد: @M(Aging.Current) ج.م"></div>
            }
            @if (Aging.D30 > 0)
            {
                <div class="v3-aging-seg v3-aging-30" style="width:@W(Aging.D30)" title="1-30 يوم: @M(Aging.D30) ج.م"></div>
            }
            @if (Aging.D60 > 0)
            {
                <div class="v3-aging-seg v3-aging-60" style="width:@W(Aging.D60)" title="31-60 يوم: @M(Aging.D60) ج.م"></div>
            }
            @if (Aging.D90 > 0)
            {
                <div class="v3-aging-seg v3-aging-90" style="width:@W(Aging.D90)" title="61-90 يوم: @M(Aging.D90) ج.م"></div>
            }
            @if (Aging.D90Plus > 0)
            {
                <div class="v3-aging-seg v3-aging-90p" style="width:@W(Aging.D90Plus)" title="أكثر من 90 يوم: @M(Aging.D90Plus) ج.م"></div>
            }
        </div>

        <div class="v3-aging-legend">
            <span class="v3-aging-leg"><i class="v3-aging-dot v3-aging-cur"></i>لم تستحق — @M(Aging.Current)</span>
            <span class="v3-aging-leg"><i class="v3-aging-dot v3-aging-30"></i>1-30 — @M(Aging.D30)</span>
            <span class="v3-aging-leg"><i class="v3-aging-dot v3-aging-60"></i>31-60 — @M(Aging.D60)</span>
            <span class="v3-aging-leg"><i class="v3-aging-dot v3-aging-90"></i>61-90 — @M(Aging.D90)</span>
            <span class="v3-aging-leg"><i class="v3-aging-dot v3-aging-90p"></i>+90 — @M(Aging.D90Plus)</span>
        </div>
        <div class="v3-aging-total">إجمالي المديونيات المستحقة: @M(Aging.Total) ج.م</div>
    </div>
}

@code {
    [Parameter] public AgingOut? Aging { get; set; }

    private string M(decimal v) => v.ToString("N0");
    private string W(decimal v) => Math.Max(3m, Math.Round(v / Aging!.Total * 100m, 1))
        .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
