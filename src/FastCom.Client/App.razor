@using FastCom.Client.Shared.Layout
@using Microsoft.AspNetCore.Components.Authorization

@*
    🔴 D8: Blazor WASM.
    🔴 RTL من أول يوم — MudRTLProvider بيدّير الاتجاه على مستوى الـ DOM.
    🔴 Step 3.3: CascadingAuthenticationState + AuthorizeRouteView
*@
<MudThemeProvider Theme="@FastComTheme.Theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudRTLProvider RightToLeft="true">

    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">

                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>

                    <Authorizing>
                        <div class="fc-authorizing">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Class="muted mt-3">جارٍ التحقق من الصلاحيات...</MudText>
                        </div>
                    </Authorizing>

                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>

            <NotFound>
                <LayoutView Layout="@typeof(MainLayout)">
                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h5" Class="mt-4">الصفحة دي مش موجودة</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                            تأكد من الرابط أو ارجع للصفحة الرئيسية.
                        </MudText>
                        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6">
                            الصفحة الرئيسية
                        </MudButton>
                    </MudContainer>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>

</MudRTLProvider>
