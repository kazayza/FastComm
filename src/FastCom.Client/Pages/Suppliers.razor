@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("SUPPLIER.VIEW")   ?? false;
    private bool CanCreate => _user?.Can("SUPPLIER.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("SUPPLIER.EDIT")   ?? false;
    private bool CanDelete => _user?.Can("SUPPLIER.DELETE") ?? false;

    private static readonly Dictionary<string, string> Types = new()
    {
        ["TransportCompany"] = "شركة نقل",
        ["FuelStation"]      = "محطة وقود",
        ["Workshop"]         = "ورشة",
        ["PortServices"]     = "خدمات ميناء",
        ["PartsSupplier"]    = "مورد قطع غيار",
        ["Other"]            = "أخرى"
    };

    private List<Item> _items      = new();
    private bool       _loading;
    private string     _search     = "";
    private string     _typeFilter = "all";
    private int?       _confirmId;

    public class Item
    {
        public int    SupplierId   { get; set; }
        public string SupplierCode { get; set; } = "";
        public string SupplierType { get; set; } = "";
        public string NameAr       { get; set; } = "";
        public string? Phone       { get; set; }
        public bool   IsActive     { get; set; }
    }

    /* ── Helpers ── */
    private static string TypeName(string t) =>
        Types.TryGetValue(t, out var v) ? v : t;

    private static string TypeIcon(string t) => t switch
    {
        "TransportCompany" => "🚛",
        "FuelStation"      => "⛽",
        "Workshop"         => "🔧",
        "PortServices"     => "⚓",
        "PartsSupplier"    => "⚙️",
        _                  => "🏢"
    };

    private static string TypeChipClass(string t) => t switch
    {
        "TransportCompany" => "sup-type-chip chip-transport",
        "FuelStation"      => "sup-type-chip chip-fuel",
        "Workshop"         => "sup-type-chip chip-workshop",
        "PortServices"     => "sup-type-chip chip-port",
        "PartsSupplier"    => "sup-type-chip chip-parts",
        _                  => "sup-type-chip chip-other"
    };

    private static string AvatarClass(string t) => t switch
    {
        "TransportCompany" => "sup-avatar av-transport",
        "FuelStation"      => "sup-avatar av-fuel",
        "Workshop"         => "sup-avatar av-workshop",
        "PortServices"     => "sup-avatar av-port",
        "PartsSupplier"    => "sup-avatar av-parts",
        _                  => "sup-avatar av-other"
    };

    private IEnumerable<Item> Filtered
    {
        get
        {
            var q = _items.AsEnumerable();
            if (_typeFilter != "all")
                q = q.Where(s => s.SupplierType == _typeFilter);
            if (!string.IsNullOrWhiteSpace(_search))
                q = q.Where(s =>
                    s.NameAr.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    s.SupplierCode.Contains(_search, StringComparison.OrdinalIgnoreCase));
            return q;
        }
    }

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    private async Task Reload() { await LoadAsync(); }

    private void GoNew()        => Nav.NavigateTo("/suppliers/new");
    private void GoEdit(Item s) => Nav.NavigateTo($"/suppliers/new/{s.SupplierId}");

    private async Task LoadAsync()
    {
        _loading = true;
        try   { _items = await Http.GetFromJsonAsync<List<Item>>("api/suppliers") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task ToggleActive(Item s)
    {
        try
        {
            var res = await Http.PostAsync($"api/suppliers/{s.SupplierId}/toggle-active", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item s)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/suppliers/{s.SupplierId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}