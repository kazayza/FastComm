@page "/trailers/new"
@page "/trailers/new/{Id:int}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "مقطورة جديدة" : "تعديل مقطورة") — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">الأسطول · المقطورات</div>
                <h1 class="fc-hero-title">@(_id is null ? "مقطورة جديدة" : $"تعديل {_code}")</h1>
                <p class="fc-hero-sub">@(_id is null ? "الكود بيتولد تلقائيًا (TRL-)" : "عدّل بيانات المقطورة")</p>
            </div>
            <div class="fc-head-actions">
                <MudButton Variant="Variant.Outlined" OnClick="GoBack" Style="color:#9FB4CC">رجوع</MudButton>
                @if (CanSave)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">حفظ</MudButton>
                }
            </div>
        </div>
    </div>
</div>

<div class="fc-page">
    @if (!CanSave)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            @(_id is null ? "ليس لديك صلاحية إضافة مقطورة." : "ليس لديك صلاحية تعديل مقطورة.")
        </MudAlert>
    }
    else if (_loading)
    {
        <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">
            @if (_msg is not null)
            {
                <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined"
                          Class="mb-4">@_msg</MudAlert>
            }

            <div class="fc-panel-sub">بيانات المقطورة</div>
            <div class="fc-form-grid">
                <MudTextField T="string" @bind-Value="_f.TrailerType" Label="النوع * (سطحة / فنطاس / …)"
                              Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="_f.PlateNumber" Label="رقم اللوحة"
                              Variant="Variant.Outlined"
                              HelperText="اختياري — بس مافيش مقطورتين بنفس اللوحة" />
                <div><div class="fc-panel-sub" style="margin-bottom:6px">المقاس (قدم)</div>
                    <select class="fc-sel fc-sel-lg" value="@SizeVal()" @onchange="e => _f.SizeFeet = ParseSize(e.Value)">
                        <option value="">—</option>
                        <option value="20">20</option>
                        <option value="40">40</option>
                        <option value="45">45</option>
                        <option value="53">53</option>
                    </select></div>
                <div><div class="fc-panel-sub" style="margin-bottom:6px">الحالة</div>
                    <select class="fc-sel fc-sel-lg" @bind="_f.Status">
                        <option value="Available">متاحة</option>
                        <option value="InTrip">في رحلة</option>
                        <option value="Maintenance">صيانة</option>
                        <option value="OutOfService">خارج الخدمة</option>
                    </select></div>
            </div>

            <div class="fc-panel-sub" style="margin:26px 0 14px">الملكية</div>
            <div class="fc-form-grid">
                <div><div class="fc-panel-sub" style="margin-bottom:6px">نوع الملكية</div>
                    <select class="fc-sel fc-sel-lg" @bind="_f.OwnershipType">
                        <option value="Company">شركة</option>
                        <option value="External">خارجي</option>
                    </select></div>
                @if (_f.OwnershipType == "External")
                {
                    <div><div class="fc-panel-sub" style="margin-bottom:6px">المورد (المالك)</div>
                        <select class="fc-sel fc-sel-lg" @bind="_f.SupplierId">
                            <option value="">—</option>
                            @foreach (var s in _suppliers) { <option value="@s.Id">@s.Label</option> }
                        </select></div>
                }
            </div>
            @if (_f.OwnershipType == "External" && !_suppliers.Any())
            {
                <div class="fc-alert fc-alert-warn" style="margin-top:12px">
                    <div class="fc-alert-body">مافيش موردين متسجلين — ضيف المورد الأول من صفحة «الموردين».</div>
                </div>
            }

            <div class="fc-panel-sub" style="margin:26px 0 14px">الرخصة والتأمين</div>
            <div class="fc-form-grid">
                <div><div class="fc-panel-sub" style="margin-bottom:6px">انتهاء الرخصة</div>
                    <input type="date" class="fc-sel fc-sel-lg" value="@_f.LicenseExpiryDate"
                           @onchange="e => _f.LicenseExpiryDate = OptStr(e.Value)" /></div>
                <div><div class="fc-panel-sub" style="margin-bottom:6px">انتهاء التأمين</div>
                    <input type="date" class="fc-sel fc-sel-lg" value="@_f.InsuranceExpiryDate"
                           @onchange="e => _f.InsuranceExpiryDate = OptStr(e.Value)" /></div>
            </div>

            <div class="fc-panel-sub" style="margin:26px 0 14px">ملاحظات</div>
            <textarea class="fc-sel fc-sel-lg" rows="3" @bind="_f.Notes"
                      placeholder="أي تفاصيل إضافية عن المقطورة..."></textarea>

            <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:24px">
                <MudButton Variant="Variant.Outlined" OnClick="GoBack">إلغاء</MudButton>
                @if (CanSave)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">حفظ</MudButton>
                }
            </div>
        </div></div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private int? _id;
    private string _code = "";

    private AuthUser? _user;
    private bool CanSave => (_id is null ? _user?.Can("FLEET.CREATE") : _user?.Can("FLEET.EDIT")) ?? false;

    private bool _loading = true, _saving, _ok = true;
    private string? _msg;
    private Form _f = new();
    private List<Opt> _suppliers = new();

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    public class Form
    {
        public string TrailerType { get; set; } = "";
        public string? PlateNumber { get; set; }
        public byte? SizeFeet { get; set; }
        public string OwnershipType { get; set; } = "Company";
        public int? SupplierId { get; set; }
        public string? LicenseExpiryDate { get; set; }
        public string? InsuranceExpiryDate { get; set; }
        public string Status { get; set; } = "Available";
        public string? Notes { get; set; }
    }

    private class Detail
    {
        public string TrailerCode { get; set; } = "";
        public string? PlateNumber { get; set; }
        public string TrailerType { get; set; } = "";
        public byte? SizeFeet { get; set; }
        public string OwnershipType { get; set; } = "Company";
        public int? SupplierId { get; set; }
        public DateOnly? LicenseExpiryDate { get; set; }
        public DateOnly? InsuranceExpiryDate { get; set; }
        public string Status { get; set; } = "Available";
        public string? Notes { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id = Id;
        if (!CanSave) { _loading = false; return; }
        try { _suppliers = await Http.GetFromJsonAsync<List<Opt>>("api/options/suppliers") ?? new(); }
        catch { /* قائمة الموردين اختيارية */ }
        if (_id is not null) await LoadAsync();
        else _loading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var d = await Http.GetFromJsonAsync<Detail>($"api/fleet/trailers/{_id}");
            if (d is null) { _msg = "المقطورة مش موجودة"; _ok = false; return; }
            _code = d.TrailerCode;
            _f = new Form
            {
                TrailerType         = d.TrailerType,
                PlateNumber         = d.PlateNumber,
                SizeFeet            = d.SizeFeet,
                OwnershipType       = d.OwnershipType,
                SupplierId          = d.SupplierId,
                LicenseExpiryDate   = d.LicenseExpiryDate?.ToString("yyyy-MM-dd"),
                InsuranceExpiryDate = d.InsuranceExpiryDate?.ToString("yyyy-MM-dd"),
                Status              = d.Status,
                Notes               = d.Notes
            };
        }
        catch (Exception ex) { _ok = false; _msg = "فشل التحميل: " + ex.Message; }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        if (string.IsNullOrWhiteSpace(_f.TrailerType))
        { _ok = false; _msg = "نوع المقطورة مطلوب"; return; }

        _saving = true; _msg = null;
        try
        {
            var payload = new
            {
                plateNumber         = _f.PlateNumber,
                trailerType         = _f.TrailerType,
                sizeFeet            = _f.SizeFeet,
                ownershipType       = _f.OwnershipType,
                supplierId          = _f.OwnershipType == "External" ? _f.SupplierId : null,
                licenseExpiryDate   = _f.LicenseExpiryDate,
                insuranceExpiryDate = _f.InsuranceExpiryDate,
                status              = _f.Status,
                notes               = _f.Notes
            };
            var res = _id is null
                ? await Http.PostAsJsonAsync("api/fleet/trailers", payload)
                : await Http.PutAsJsonAsync($"api/fleet/trailers/{_id}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private void GoBack() => Nav.NavigateTo("/trailers");

    /* ── helpers: أي `"` جوه attribute = RZ1010 ── */
    private static string? OptStr(object? v)
    {
        var s = v?.ToString();
        return string.IsNullOrWhiteSpace(s) ? null : s;
    }

    private string SizeVal() => _f.SizeFeet is null ? "" : _f.SizeFeet.Value.ToString();

    private static byte? ParseSize(object? v) =>
        byte.TryParse(v?.ToString(), out var b) ? b : null;

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
