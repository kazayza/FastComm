@page "/supplier-invoices/new"
@page "/supplier-invoices/new/{Id:long}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "فاتورة مورد جديدة" : "تعديل فاتورة مورد") — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">المالية · الذمم الدائنة</div>
                <h1 class="fc-hero-title">@(_id is null ? "فاتورة مورد جديدة" : $"تعديل {_number}")</h1>
                <p class="fc-hero-sub">@(_id is null ? "الرقم بيتولد تلقائيًا (SINV-)" : _number)</p>
            </div>
            <div class="fc-head-actions">
                <MudButton Variant="Variant.Outlined" OnClick="GoBack" Style="color:#9FB4CC">رجوع</MudButton>
                @if (CanSave)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="SaveAsync">حفظ</MudButton>
                }
            </div>
        </div>
    </div>
</div>

<div class="fc-page">
    @if (!CanSave)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            @(_id is null ? "ليس لديك صلاحية إضافة فاتورة مورد." : "ليس لديك صلاحية التعديل.")
        </MudAlert>
    }
    else if (_loading)
    {
        <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">

            @if (_msg is not null)
            {
                <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Class="mb-4">@_msg</MudAlert>
            }

            @if (_id is not null && _status != "Draft")
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                    الفاتورة <b>@StatusAr(_status)</b> — التعديل مسموح في المسودة بس.
                </MudAlert>
            }

            @* ══════════ 1. بيانات الفاتورة ══════════ *@
            <div class="fc-panel-sub" style="margin-bottom:14px">بيانات الفاتورة</div>
            <div class="fc-form-grid">
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">المورد *</div>
                    <select class="fc-sel fc-sel-lg" @bind="_f.SupplierId" disabled="@(_id is not null && _status != "Draft")">
                        <option value="0">— اختر —</option>
                        @foreach (var s in _suppliers)
                        {
                            <option value="@s.Id">@s.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">الفرع *</div>
                    <select class="fc-sel fc-sel-lg" @bind="_f.BranchId" disabled="@(_id is not null && _status != "Draft")">
                        <option value="0">— اختر —</option>
                        @foreach (var b in _branches)
                        {
                            <option value="@b.Id">@b.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">تاريخ الفاتورة *</div>
                    <input type="date" class="fc-sel fc-sel-lg" value="@_f.InvoiceDate"
                           @onchange="e => _f.InvoiceDate = Req(e.Value)" />
                </div>
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">تاريخ الاستحقاق</div>
                    <input type="date" class="fc-sel fc-sel-lg" value="@_f.DueDate"
                           @onchange="e => _f.DueDate = OptStr(e.Value)" />
                    <div class="fc-field-hint">اللي بيتحسب عليه أعمار الديون</div>
                </div>
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">رقم فاتورة المورد</div>
                    <input class="fc-sel fc-sel-lg" @bind="_f.SupplierRefNumber" maxlength="100" dir="ltr"
                           style="text-align:right" />
                    <div class="fc-field-hint">الرقم عند المورد نفسه — للمطابقة</div>
                </div>
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">ملاحظات</div>
                    <input class="fc-sel fc-sel-lg" @bind="_f.Notes" maxlength="500" />
                </div>
            </div>

            @* ══════════ 2. البنود ══════════ *@
            <div class="fc-panel-sub" style="margin:26px 0 14px">البنود</div>

            <div class="fc-table-wrap"><table class="fc-table fc-table-pro2">
                <thead><tr>
                    <th>البيان *</th><th style="width:90px">الكمية</th>
                    <th style="width:120px">سعر الوحدة</th><th style="width:100px">الضريبة %</th>
                    <th style="width:110px">الإجمالي</th><th style="width:50px"></th>
                </tr></thead>
                <tbody>
                    @foreach (var l in _lines)
                    {
                        <tr>
                            <td><input class="fc-sel" @bind="l.Description" maxlength="300"
                                       disabled="@Locked" /></td>
                            <td><input type="number" min="0" step="0.01" class="fc-sel" value="@l.Quantity"
                                       @onchange="e => l.Quantity = ParseDec(e.Value) ?? 0m" disabled="@Locked" /></td>
                            <td><input type="number" min="0" step="0.01" class="fc-sel" value="@l.UnitPrice"
                                       @onchange="e => l.UnitPrice = ParseDec(e.Value) ?? 0m" disabled="@Locked" /></td>
                            <td>
                                <select class="fc-sel" @bind="l.TaxRateId" disabled="@Locked">
                                    <option value="">0%</option>
                                    @foreach (var t in _taxRates)
                                    {
                                        <option value="@t.Id">@t.Label</option>
                                    }
                                </select>
                            </td>
                            <td><b>@Money(LineTotal(l))</b></td>
                            <td>
                                @if (!Locked)
                                {
                                    <MudIconButton Size="Size.Small" title="حذف البند"
                                                   Icon="@Icons.Material.Filled.Delete"
                                                   OnClick="() => _lines.Remove(l)" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>

            @if (!Locked)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-3"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">بند جديد</MudButton>
            }

            @* ══════════ 3. الإجماليات ══════════ *@
            <div class="fc-stats" style="margin-top:22px">
                <div class="fc-stat">
                    <div class="fc-stat-head">
                        <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></div>
                        <div class="fc-stat-lb">الإجمالي قبل الضريبة</div>
                    </div>
                    <div class="fc-stat-num">@Money(SubTotal)</div>
                </div>
                <div class="fc-stat">
                    <div class="fc-stat-head">
                        <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Assessment" /></div>
                        <div class="fc-stat-lb">الضريبة</div>
                    </div>
                    <div class="fc-stat-num">@Money(TaxTotal)</div>
                    <div class="fc-stat-sub">افتراضيًا صفر</div>
                </div>
                <div class="fc-stat">
                    <div class="fc-stat-head">
                        <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                        <div class="fc-stat-lb">الإجمالي المستحق</div>
                    </div>
                    <div class="fc-stat-num is-neg">@Money(SubTotal + TaxTotal)</div>
                    <div class="fc-stat-sub">@_lines.Count بند</div>
                </div>
            </div>

            <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:26px">
                <MudButton Variant="Variant.Outlined" OnClick="GoBack">رجوع</MudButton>
                @if (CanSave && Locked == false)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                               OnClick="SaveAsync">حفظ</MudButton>
                }
            </div>

        </div></div>
    }
</div>

@code {
    [Parameter] public long? Id { get; set; }
    private long? _id;
    private string _number = "";
    private string _status = "Draft";

    private AuthUser? _user;
    private bool CanCreate => (_user?.Can("SUPPLIER.CREATE") ?? false);
    private bool CanEdit   => (_user?.Can("SUPPLIER.EDIT") ?? false);
    private bool CanSave   => _id is null ? CanCreate : CanEdit;

    /// <summary>الفاتورة المعتمدة ما تتعدّلش.</summary>
    private bool Locked => _id is not null && _status != "Draft";

    private bool _loading, _saving;
    private string? _msg; private bool _ok = true;

    private Form _f = new();
    private List<Line> _lines = new();

    private List<Opt> _suppliers = new();
    private List<Opt> _branches  = new();
    private List<Opt> _taxRates  = new();

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id = Id;
        if (!CanSave && !(_id is not null && CanEdit)) return;

        _suppliers = await SafeOpts("api/options/suppliers");
        _branches  = await SafeOpts("api/options/branches");

        /* 🔴 الضريبة بتتحمل بصمت — الـ endpoint محتاج OPERATION.VIEW،
              ومستخدم الموردين ممكن ما يكونش عنده. الافتراضي صفر على أي حال. */
        try { _taxRates = await Http.GetFromJsonAsync<List<Opt>>("api/options/tax-rates") ?? new(); }
        catch { _taxRates = new(); }

        if (_id is not null) await LoadAsync(_id.Value);
        else
        {
            _f.InvoiceDate = DateTime.Today.ToString("yyyy-MM-dd");
            if (_branches.Count > 0) _f.BranchId = _branches[0].Id;
            AddLine();
        }
    }

    private async Task LoadAsync(long id)
    {
        _loading = true;
        try
        {
            var d = await Http.GetFromJsonAsync<Detail>($"api/supplier-invoices/{id}");
            if (d is null) { _ok = false; _msg = "الفاتورة مش موجودة"; return; }

            _number = d.SupplierInvoiceNumber;
            _status = d.Status;

            _f = new Form
            {
                SupplierId        = d.SupplierId,
                BranchId          = d.BranchId,
                InvoiceDate       = d.InvoiceDate,
                DueDate           = d.DueDate,
                SupplierRefNumber = d.SupplierRefNumber,
                Notes             = d.Notes
            };

            _lines = d.Lines.Select(l => new Line
            {
                Description = l.Description,
                Quantity    = l.Quantity,
                UnitPrice   = l.UnitPrice,
                TaxRateId   = MatchTax(l.TaxRate)
            }).ToList();

            if (_lines.Count == 0) AddLine();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل التحميل: " + ex.Message; }
        finally { _loading = false; }
    }

    /// <summary>الكنترولر بيرجّع نسبة الضريبة — نحوّلها لـ Id في الدروبداون.</summary>
    private int? MatchTax(decimal rate)
    {
        if (rate <= 0m) return null;
        var hit = _taxRates.FirstOrDefault(t => TaxValue(t.Id) == rate);
        return hit?.Id;
    }

    private async Task<List<Opt>> SafeOpts(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Opt>>(url) ?? new(); }
        catch (Exception ex)
        {
            _ok = false;
            _msg = $"تعذّر تحميل القوائم ({url}): {ex.Message}";
            return new();
        }
    }

    private void AddLine() => _lines.Add(new Line { Quantity = 1m });

    private decimal TaxValue(int? id) =>
        id is null ? 0m : _taxRates.FirstOrDefault(t => t.Id == id.Value)?.Value ?? 0m;

    private decimal LineSub(Line l) => Math.Round(l.Quantity * l.UnitPrice, 4);

    private decimal LineTax(Line l) => Math.Round(LineSub(l) * TaxValue(l.TaxRateId) / 100m, 4);

    private decimal LineTotal(Line l) => LineSub(l) + LineTax(l);

    private decimal SubTotal => _lines.Sum(LineSub);

    private decimal TaxTotal => _lines.Sum(LineTax);

    /* 🔴 helpers — أي `"` جوه attribute = RZ1010 */
    private static string Req(object? v) => v?.ToString() ?? "";

    private static string? OptStr(object? v)
    {
        var t = v?.ToString();
        return string.IsNullOrWhiteSpace(t) ? null : t;
    }

    private static decimal? ParseDec(object? v) =>
        decimal.TryParse(v?.ToString(), out var d) ? d : null;

    private static string Money(decimal v) => v.ToString("N2");

    private static string StatusAr(string s) => s switch
    {
        "Draft" => "مسودة", "Approved" => "معتمدة", "PartiallyPaid" => "مدفوعة جزئيًا",
        "Paid" => "مدفوعة", "Cancelled" => "ملغاة", _ => s
    };

    private async Task SaveAsync()
    {
        _msg = null;

        if (_f.SupplierId <= 0) { _ok = false; _msg = "لازم تختار المورد"; return; }
        if (_f.BranchId <= 0)   { _ok = false; _msg = "لازم تختار الفرع"; return; }

        var lines = _lines.Where(l => l.Quantity > 0 && !string.IsNullOrWhiteSpace(l.Description)).ToList();
        if (lines.Count == 0) { _ok = false; _msg = "ضيف بند واحد على الأقل (بيان + كمية)"; return; }

        var payload = new
        {
            supplierId        = _f.SupplierId,
            branchId          = _f.BranchId,
            invoiceDate       = _f.InvoiceDate,
            dueDate           = _f.DueDate,
            supplierRefNumber = _f.SupplierRefNumber,
            notes             = _f.Notes,
            lines             = lines.Select(l => new
            {
                tripId        = (long?)null,
                operationId   = (long?)null,
                expenseTypeId = (int?)null,
                description   = l.Description.Trim(),
                quantity      = l.Quantity,
                unitPrice     = l.UnitPrice,
                taxRate       = TaxValue(l.TaxRateId)
            }).ToList()
        };

        _saving = true;
        try
        {
            var res = _id is null
                ? await Http.PostAsJsonAsync("api/supplier-invoices", payload)
                : await Http.PutAsJsonAsync($"api/supplier-invoices/{_id}", payload);

            _msg = Msg(await res.Content.ReadAsStringAsync(), res.IsSuccessStatusCode ? "✅ اتحفظت" : "الحفظ فشل");
            _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);

            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private void GoBack() => Nav.NavigateTo("/supplier-invoices");

    private static string Msg(string body, string fallback)
    {
        if (string.IsNullOrWhiteSpace(body) || body.TrimStart().StartsWith("<")) return fallback;
        try
        {
            using var d = System.Text.Json.JsonDocument.Parse(body);
            if (d.RootElement.TryGetProperty("message", out var m)) return m.GetString() ?? fallback;
        }
        catch { }
        return fallback;
    }

    /* ── DTOs ── */
    public class Form
    {
        public int     SupplierId        { get; set; }
        public int     BranchId          { get; set; }
        public string  InvoiceDate       { get; set; } = "";
        public string? DueDate           { get; set; }
        public string? SupplierRefNumber { get; set; }
        public string? Notes             { get; set; }
    }

    public class Line
    {
        public string   Description { get; set; } = "";
        public decimal  Quantity    { get; set; }
        public decimal  UnitPrice   { get; set; }
        public int?     TaxRateId   { get; set; }
    }

    public class Detail
    {
        public long    SupplierInvoiceId     { get; set; }
        public string  SupplierInvoiceNumber { get; set; } = "";
        public string? SupplierRefNumber     { get; set; }
        public int     SupplierId            { get; set; }
        public string  SupplierName          { get; set; } = "";
        public int     BranchId              { get; set; }
        public string  InvoiceDate           { get; set; } = "";
        public string? DueDate               { get; set; }
        public string  CurrencyCode          { get; set; } = "";
        public decimal SubTotal              { get; set; }
        public decimal TaxTotal              { get; set; }
        public decimal GrandTotal            { get; set; }
        public decimal PaidAmount            { get; set; }
        public string  Status                { get; set; } = "";
        public string  PaymentStatus         { get; set; } = "";
        public string? Notes                 { get; set; }
        public List<LineRes> Lines           { get; set; } = new();
    }

    public class LineRes
    {
        public long?   SupplierInvoiceItemId { get; set; }
        public long?   TripId                { get; set; }
        public long?   OperationId           { get; set; }
        public int?    ExpenseTypeId         { get; set; }
        public string  Description           { get; set; } = "";
        public decimal Quantity              { get; set; }
        public decimal UnitPrice             { get; set; }
        public decimal TaxRate               { get; set; }
        public decimal LineSubtotal          { get; set; }
        public decimal LineTax               { get; set; }
        public decimal LineTotal             { get; set; }
    }

    public class Opt
    {
        public int     Id    { get; set; }
        public string  Label { get; set; } = "";
        public decimal Value { get; set; }
    }
}
