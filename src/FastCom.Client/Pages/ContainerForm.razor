        animation: check-pop .3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .field-check-badge.check-warning {
        background: var(--fc-amber); color: #fff;
        box-shadow: 0 0 0 3px rgba(224, 154, 16, 0.12);
    }
    @@keyframes check-pop { 0% { transform: scale(0); } 60% { transform: scale(1.15); } 100% { transform: scale(1); } }

    .field-hint { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--fc-muted); font-weight: 500; }
    .field-hint.hint-valid { color: var(--fc-green); font-weight: 700; }
    .field-err-msg { font-size: 10.5px; color: var(--fc-red); font-weight: 700; }

    /* ── Bottom Actions ── */
    .bk-bottom-actions {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 14px 20px; background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 2px 8px rgba(15,41,82,.04);
    }
    .bk-bottom-back {
        display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 16px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer; transition: all .15s ease;
    }
    .bk-bottom-back:hover { background: #f0f4fa; color: var(--fc-text); }
    .bk-bottom-back svg { transform: rotate(180deg); }
    .bk-bottom-right { display: flex; align-items: center; gap: 10px; }

    .bk-next-btn {
        display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 16px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer; transition: all .15s ease;
    }
    .bk-next-btn:hover { background: var(--fc-blue); color: #fff; }
    .bk-next-btn svg { transform: rotate(180deg); }

    .bk-bottom-save {
        display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 22px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit; font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(30,110,245,.30); transition: all .15s ease;
    }
    .bk-bottom-save:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(30,110,245,.38); }
    .bk-bottom-save:disabled { opacity: .6; cursor: not-allowed; }
    .btn-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: bk-spin .7s linear infinite; }
    .btn-spinner.sm { width: 13px; height: 13px; }

    /* ── FAB ── */
    .glow-fab-wrap { position: fixed; left: 28px; bottom: 28px; z-index: 1299; width: 60px; height: 60px; }
    .glow-fab-container { position: relative; z-index: 2; width: 60px; height: 60px; }
    .glow-fab-btn {
        position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 58px; height: 58px; border-radius: 50%;
        background: linear-gradient(135deg, #1e6ef5, #0d47a1);
        border: 2.5px solid #fbbf24; color: #fff; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 16px rgba(30, 110, 245, .4); transition: transform .2s; z-index: 2;
    }
    .glow-fab-btn:hover { transform: translate(-50%, -50%) scale(1.05); }
    .glow-fab-icon { transition: transform .3s; }
    .glow-fab-wrap.is-open .glow-fab-icon { transform: rotate(130deg); }

    .glow-halo, .glow-ring { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none; }
    .glow-halo { width: 58px; height: 58px; background: radial-gradient(circle, rgba(30, 110, 245, .3) 0%, transparent 70%); animation: glow-breath 2s ease-in-out infinite; }
    .glow-ring { width: 58px; height: 58px; border: 2px solid rgba(30, 110, 245, .4); animation: glow-expand 2s ease-out infinite; }
    .glow-ring-2 { animation-delay: .3s; }
    .glow-ring-3 { animation-delay: .6s; }
    @@keyframes glow-breath { 0%, 100% { opacity: .5; transform: translate(-50%, -50%) scale(1); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); } }
    @@keyframes glow-expand { 0% { opacity: .8; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(2.5); } }

    .glow-fab-menu { position: absolute; bottom: 74px; left: 0; z-index: 3; display: flex; flex-direction: column; gap: 8px; opacity: 0; pointer-events: none; transform: translateY(10px); transition: opacity .2s, transform .2s; }
    .glow-fab-wrap.is-open .glow-fab-menu { opacity: 1; pointer-events: auto; transform: translateY(0); }
    .glow-fab-item { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 12px; background: #fff; border: 1px solid #dde5f0; box-shadow: 0 4px 12px rgba(0, 0, 0, .1); cursor: pointer; font-size: 13px; color: #1c2c44; white-space: nowrap; }
    .glow-fab-item:hover { background: #f4f7fb; border-color: var(--fc-blue); }
    .glow-fab-item-ic { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 8px; background: #eaf1ff; color: var(--fc-blue); }
    .glow-fab-scrim { position: fixed; inset: 0; background: rgba(9, 18, 35, .45); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 1298; }

    /* ── Responsive ── */
    @@media (max-width: 992px) {
        .bk-hero-summary { flex-wrap: wrap; }
        .bk-sum-item { flex: 0 0 50%; }
        .bk-sum-div:nth-child(4) { display: none; }
    }
    @@media (max-width: 768px) {
        .bk-body { padding: 12px 12px 90px; }
        .bk-form-grid { grid-template-columns: 1fr; }
        .bk-bottom-actions { flex-direction: column; }
        .bk-bottom-back, .bk-bottom-save, .bk-next-btn { width: 100%; justify-content: center; }
        .bk-bottom-right { width: 100%; flex-direction: column; }
        .bk-sum-item { flex: 0 0 100%; }
        .bk-sum-div { display: none; }
        .glow-fab-wrap { left: 18px; bottom: 18px; }
    }
</style>


@code {
    [Parameter] public long? Id { get; set; }
    private long? _id;
    private string ContainerNumber = "";

    private AuthUser? _user;
    private bool CanSave => _user?.Can("MASTERDATA.MANAGE") ?? false;

    private bool _loading; 
    private bool _saving;
    private bool _fabOpen;
    private bool _triedSave;
    private int _activeTab = 0;
    private string? _msg; 
    private bool _ok = true;

    private List<Opt> _types = new();
    private Form _f = new();

    private bool NumberOk =>
        !string.IsNullOrWhiteSpace(_f.ContainerNumber) &&
        System.Text.RegularExpressions.Regex.IsMatch(
            _f.ContainerNumber.Trim(), "^[A-Z]{4}[0-9]{7}$");

    public class Opt 
    { 
        public int Id { get; set; } 
        public string Label { get; set; } = ""; 
    }

    public class Form
    {
        public string ContainerNumber { get; set; } = "";
        public int ContainerTypeId { get; set; }
        public string OwnerType { get; set; } = "ShippingLine";
        public string? OwnerName { get; set; }
        public decimal? WeightKg { get; set; }
        public string CurrentStatus { get; set; } = "Available";
        public string? Notes { get; set; }
    }

    public class Detail
    {
        public long ContainerId { get; set; }
        public string ContainerNumber { get; set; } = "";
        public int ContainerTypeId { get; set; }
        public string OwnerType { get; set; } = "";
        public string? OwnerName { get; set; }
        public decimal? WeightKg { get; set; }
        public string CurrentStatus { get; set; } = "";
        public string? Notes { get; set; }
    }

    private static string StatusAr(string s) => s switch
    {
        "Available" => "متاحة للتشغيل", 
        "InTransit" => "في الطريق", 
        "AtPort" => "في الميناء",
        "AtDepot" => "في المخزن", 
        "Delivered" => "تم التسليم", 
        "Returned" => "مرتجعة", 
        _ => s
    };

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id = Id;
        if (!CanSave) return;

        _loading = true;
        try
        {
            _types = await SafeGetT<Opt>("api/options/container-types");
            if (_types.Count > 0 && _id is null) _f.ContainerTypeId = _types[0].Id;
            if (_id is not null) await LoadAsync(_id.Value);
        }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; _ok = false; }
        finally { _loading = false; }
    }

    private async Task LoadAsync(long id)
    {
        var d = await Http.GetFromJsonAsync<Detail>($"api/containers/{id}");
        if (d is null) { _msg = "الحاوية غير موجودة"; _ok = false; return; }

        ContainerNumber = d.ContainerNumber;
        _f = new Form
        {
            ContainerNumber = d.ContainerNumber,
            ContainerTypeId = d.ContainerTypeId,
            OwnerType       = d.OwnerType,
            OwnerName       = d.OwnerName,
            WeightKg        = d.WeightKg,
            CurrentStatus   = d.CurrentStatus,
            Notes           = d.Notes
        };
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _triedSave = true;
        _saving = true; 
        _msg = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_f.ContainerNumber))
            { 
                _msg = "رقم الحاوية مطلوب لإكمال التسجيل"; 
                _ok = false;
                _activeTab = 0;
                return; 
            }
            if (_f.ContainerTypeId <= 0)
            { 
                _msg = "يرجى اختيار نوع الحاوية"; 
                _ok = false;
                _activeTab = 0;
                return; 
            }

            var res = _id is null
                ? await Http.PostAsJsonAsync("api/containers", _f)
                : await Http.PutAsJsonAsync($"api/containers/{_id}", _f);

            _msg = await MsgOf(res); 
            _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private void GoBack() => Nav.NavigateTo("/containers");
    private void ToggleFab() => _fabOpen = !_fabOpen;

    private static decimal? ParseDec(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n > 0 ? n : null;

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم الحفظ بنجاح" : "حدث خطأ — يرجى المحاولة مرة أخرى"; }
    }
}