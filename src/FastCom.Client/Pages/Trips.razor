@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("TRIP.VIEW")   ?? false;
    private bool CanCreate => _user?.Can("TRIP.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("TRIP.EDIT")   ?? false;
    private bool CanCancel => _user?.Can("TRIP.CANCEL") ?? false;

    private static readonly (string Key, string Value)[] _statusTabs =
    {
        ("all",       "الكل"),
        ("Planned",   "مخططة"),
        ("Assigned",  "متعين"),
        ("Started",   "في الطريق"),
        ("Completed", "خلصت"),
        ("Cancelled", "ملغاة")
    };

    private List<Item> _items = new();
    private bool   _loading;
    private string _search = "";
    private string _tab    = "all";
    private long?  _confirmId;

    private long?   _startFor; private string? _startAt; private string? _startOdo;
    private long?   _endFor;   private string? _endAt;   private string? _endOdo;

    [SupplyParameterFromQuery(Name = "focus")] public string? Focus { get; set; }

    public class Item
    {
        public long      TripId          { get; set; }
        public string    TripNumber      { get; set; } = "";
        public string    DriverName      { get; set; } = "";
        public string    VehiclePlate    { get; set; } = "";
        public string?   TrailerPlate    { get; set; }
        public int       OperationsCount { get; set; }
        public decimal   DirectCost      { get; set; }
        public decimal   AllocatedCost   { get; set; }
        public string    Status          { get; set; } = "";
        public DateTime? PlannedStartAt  { get; set; }
        public DateTime? ActualStartAt   { get; set; }
        public DateTime? ActualEndAt     { get; set; }
    }

    /* ── Helpers ── */
    private static string StatusAr(string s) => s switch
    {
        "Planned"   => "مخططة",
        "Assigned"  => "متعين",
        "Started"   => "في الطريق",
        "Completed" => "خلصت",
        "Cancelled" => "ملغاة",
        _           => s
    };

    private static string ChipClass(string s) => s switch
    {
        "Planned"   => "chip-planned",
        "Assigned"  => "chip-assigned",
        "Started"   => "chip-started",
        "Completed" => "chip-completed",
        "Cancelled" => "chip-cancelled",
        _           => "chip-planned"
    };

    private static string ChipDotClass(string s) => s switch
    {
        "Planned"   => "cdot-planned",
        "Assigned"  => "cdot-assigned",
        "Started"   => "cdot-started",
        "Completed" => "cdot-completed",
        "Cancelled" => "cdot-cancelled",
        _           => "cdot-planned"
    };

    private static string AvatarClass(string s) => s switch
    {
        "Planned"   => "av-planned",
        "Assigned"  => "av-assigned",
        "Started"   => "av-started",
        "Completed" => "av-completed",
        "Cancelled" => "av-cancelled",
        _           => "av-planned"
    };

    private static string StatusDotColor(string s) => s switch
    {
        "all"       => "tdot-all",
        "Planned"   => "tdot-planned",
        "Assigned"  => "tdot-assigned",
        "Started"   => "tdot-started",
        "Completed" => "tdot-completed",
        "Cancelled" => "tdot-cancelled",
        _           => "tdot-all"
    };

    private static string Money(decimal v) => v.ToString("N0");

    private IEnumerable<Item> Filtered => _items.Where(t =>
        (_tab == "all" || t.Status == _tab) &&
        (string.IsNullOrWhiteSpace(_search) ||
         t.TripNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         t.DriverName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         t.VehiclePlate.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Focus)) _search = Focus.Trim();
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try   { _items = await Http.GetFromJsonAsync<List<Item>>("api/trips?take=300") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void GoNew()        => Nav.NavigateTo("/trips/new");
    private void GoEdit(Item t) => Nav.NavigateTo($"/trips/new/{t.TripId}");

    private void Start(Item t)
    {
        _startFor = t.TripId;
        _startAt  = (t.PlannedStartAt ?? DateTime.Now).ToString("yyyy-MM-ddTHH:mm");
        _startOdo = null;
    }

    private void Complete(Item t)
    {
        _endFor = t.TripId;
        _endAt  = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
        _endOdo = null;
    }

    private async Task ConfirmStart()
    {
        var id = _startFor; _startFor = null;
        if (id is null) return;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/trips/{id}/start",
                new { actualStartAt = _startAt, startOdometer = _startOdo });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task ConfirmComplete()
    {
        var id = _endFor; _endFor = null;
        if (id is null) return;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/trips/{id}/complete",
                new { actualEndAt = _endAt, endOdometer = _endOdo });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Post(Item t, string action)
    {
        try
        {
            var res = await Http.PostAsync($"api/trips/{t.TripId}/{action}", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item t)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/trips/{t.TripId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}