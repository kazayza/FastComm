@page "/trips"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>الرحلات — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">التشغيل · الرحلات</div>
                <h1 class="fc-hero-title">الرحلات</h1>
                <p class="fc-hero-sub">سائق وعربية وخروج واحد — ممكن ينفّذ كذا عملية، وتكلفته بتتوزّع عليهم</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="GoNew">رحلة جديدة</MudButton>
                }
            </div>
        </div>
        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.AirportShuttle" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">إجمالي الرحلات</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(t => t.Status == "Planned")</div><div class="fc-kpi-lb">مخططة</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.LocalShipping" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(t => t.Status == "Started")</div><div class="fc-kpi-lb">في الطريق</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Savings" /></div>
                    <div><div class="fc-kpi-num">@Money(_items.Sum(t => t.DirectCost))</div><div class="fc-kpi-lb">مصروفات الرحلات</div></div></div>
            </div>
        }
    </div>
</div>

<div class="fc-page">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">ليس لديك صلاحية عرض الرحلات.
</MudAlert>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">
            <div class="fc-toolbar">
                <div class="fc-filters">
                    @foreach (var t in Tabs)
                    {
                        <button class='fc-filter @(_tab == t.Key ? "on" : "")' @onclick="() => SetTab(t.Key)">@t.Value</button>
                    }
                </div>
                <MudTextField T="string" Value="_search" ValueChanged="v => _search = v"
                              Placeholder="دوّر برقم الرحلة أو السائق أو اللوحة..." Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="fc-search-box" Immediate="true" />
                <span class="fc-count">عرض @Filtered.Count() من @_items.Count</span>
            </div>

            @if (_loading)
            {
                <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else
            {
                <div class="fc-table-wrap"><table class="fc-table fc-table-pro">
                    <thead><tr>
                        <th>رقم الرحلة</th><th>السائق</th><th>العربية</th><th>المخطط</th>
                        <th>عمليات</th><th>المصروفات</th><th>الموزّع</th><th>الحالة</th>
                        <th style="width:180px; text-align:left">إجراءات</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var t in Filtered)
                        {
                            <tr>
                                <td><span class="fc-role-chip">@t.TripNumber</span></td>
                                <td><div class="fc-cell-main">@t.DriverName</div></td>
                                <td class="fc-cell-sub">@t.VehiclePlate
                                    @if (t.TrailerPlate is not null) { <div class="fc-cell-sub">+ @t.TrailerPlate</div> }</td>
                                <td class="fc-cell-sub">@(t.PlannedStartAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td><b>@t.OperationsCount</b></td>
                                <td class="fc-cell-sub">@Money(t.DirectCost)</td>
                                <td class="fc-cell-sub">@Money(t.AllocatedCost)</td>
                                <td><span class="fc-chip @ChipClass(t.Status)"><i></i>@StatusAr(t.Status)</span></td>
                                <td><div class="fc-row-actions">
                                    @if (t.Status is not ("Completed" or "Cancelled") && CanEdit)
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                                       Color="Color.Primary" title="تعديل" OnClick="() => GoEdit(t)" />
                                    }
                                    @if (t.Status is ("Planned" or "Assigned") && CanEdit)
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Route"
                                                       Color="Color.Success" title="الرحلة اتحركت" OnClick="() => Start(t)" />
                                    }
                                    @if (t.Status is ("Started" or "Planned" or "Assigned") && CanEdit)
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle"
                                                       Color="Color.Primary" title="إنهاء الرحلة" OnClick="() => Complete(t)" />
                                    }
                                    @if (t.Status is not ("Completed" or "Cancelled") && CanCancel)
                                    {
                                        @if (_confirmId == t.TripId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                                       OnClick='() => Post(t, "cancel")'>إلغاء؟</MudButton>
                                        }
                                        else
                                        {
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                                           Color="Color.Error" title="إلغاء" OnClick="() => _confirmId = t.TripId" />
                                        }
                                    }
                                    else if (t.Status is ("Planned" or "Cancelled") && CanCancel)
                                    {
                                        @if (_confirmId == t.TripId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                                       OnClick="() => Delete(t)">حذف؟</MudButton>
                                        }
                                        else
                                        {
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error" title="حذف" OnClick="() => _confirmId = t.TripId" />
                                        }
                                    }
                                </div></td>
                            </tr>
                        }
                        @if (!Filtered.Any())
                        {
                            <tr><td colspan="9"><div class="fc-empty"><div>مافيش رحلات في الفلتر ده</div></div></td></tr>
                        }
                    </tbody>
                </table></div>
            }
        </div></div>
    }

    @* ═══ مودال التحرك ═══ *@
    @if (_startFor is not null)
    {
        <div class="fc-modal-backdrop" @onclick="() => _startFor = null">
            <div class="fc-modal fc-modal-sm" @onclick:stopPropagation>
                <div class="fc-modal-head">
                    <div><div class="fc-modal-title">الرحلة اتحركت</div>
                        <div class="fc-modal-sub">سجّل وقت التحرك وعداد البداية</div></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _startFor = null" />
                </div>
                <div class="fc-modal-body">
                    <div class="fc-form-grid">
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">وقت التحرك</div>
                            <input type="datetime-local" class="fc-sel fc-sel-lg" value="@_startAt"
                                   @onchange="e => _startAt = e.Value?.ToString()" />
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">عداد البداية (كم)</div>
                            <input type="number" min="0" step="0.1" class="fc-sel fc-sel-lg" value="@_startOdo"
                                   @onchange="e => _startOdo = e.Value?.ToString()" />
                        </div>
                    </div>
                </div>
                <div class="fc-modal-foot">
                    <MudButton Variant="Variant.Outlined" OnClick="() => _startFor = null">إلغاء</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmStart">تحرك</MudButton>
                </div>
            </div>
        </div>
    }

    @* ═══ مودال الإنهاء ═══ *@
    @if (_endFor is not null)
    {
        <div class="fc-modal-backdrop" @onclick="() => _endFor = null">
            <div class="fc-modal fc-modal-sm" @onclick:stopPropagation>
                <div class="fc-modal-head">
                    <div><div class="fc-modal-title">إنهاء الرحلة</div>
                        <div class="fc-modal-sub">العمليات المرتبطة هتبقى «تم التسليم»</div></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _endFor = null" />
                </div>
                <div class="fc-modal-body">
                    <div class="fc-form-grid">
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">وقت الوصول</div>
                            <input type="datetime-local" class="fc-sel fc-sel-lg" value="@_endAt"
                                   @onchange="e => _endAt = e.Value?.ToString()" />
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">عداد النهاية (كم)</div>
                            <input type="number" min="0" step="0.1" class="fc-sel fc-sel-lg" value="@_endOdo"
                                   @onchange="e => _endOdo = e.Value?.ToString()" />
                        </div>
                    </div>
                </div>
                <div class="fc-modal-foot">
                    <MudButton Variant="Variant.Outlined" OnClick="() => _endFor = null">إلغاء</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmComplete">إنهاء</MudButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("TRIP.VIEW") ?? false;
    private bool CanCreate => _user?.Can("TRIP.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("TRIP.EDIT") ?? false;
    private bool CanCancel => _user?.Can("TRIP.CANCEL") ?? false;

    private static readonly Dictionary<string, string> Tabs = new()
    {
        ["all"] = "الكل", ["Planned"] = "مخططة", ["Assigned"] = "متعين",
        ["Started"] = "في الطريق", ["Completed"] = "خلصت", ["Cancelled"] = "ملغاة"
    };

    private List<Item> _items = new();
    private bool _loading; private string _search = ""; private string _tab = "all";

    private long? _confirmId;

    private long? _startFor; private string? _startAt; private string? _startOdo;
    private long? _endFor;   private string? _endAt;   private string? _endOdo;

    public class Item
    {
        public long TripId { get; set; }
        public string TripNumber { get; set; } = "";
        public string DriverName { get; set; } = "";
        public string VehiclePlate { get; set; } = "";
        public string? TrailerPlate { get; set; }
        public int OperationsCount { get; set; }
        public decimal DirectCost { get; set; }
        public decimal AllocatedCost { get; set; }
        public string Status { get; set; } = "";
        public DateTime? PlannedStartAt { get; set; }
        public DateTime? ActualStartAt { get; set; }
        public DateTime? ActualEndAt { get; set; }
    }

    private static string StatusAr(string s) => s switch
    {
        "Planned" => "مخططة", "Assigned" => "متعين", "Started" => "في الطريق",
        "Completed" => "خلصت", "Cancelled" => "ملغاة", _ => s
    };

    private static string ChipClass(string s) => s switch
    {
        "Planned" => "fc-chip-gray", "Assigned" => "fc-chip-blue",
        "Started" => "fc-chip-warn", "Completed" => "fc-chip-ok",
        "Cancelled" => "fc-chip-bad", _ => "fc-chip-gray"
    };

    private static string Money(decimal v) => v.ToString("N0");

    private IEnumerable<Item> Filtered => _items.Where(t =>
        (_tab == "all" || t.Status == _tab) &&
        (string.IsNullOrWhiteSpace(_search) ||
         t.TripNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         t.DriverName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         t.VehiclePlate.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    /// <summary>🔎 لما تيجي من البحث العام: <c>/customers?focus=CUST-001</c> — بنفلتر عليه.</summary>
    [SupplyParameterFromQuery(Name = "focus")] public string? Focus { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Focus)) _search = Focus.Trim();
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/trips?take=300") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void GoNew() => Nav.NavigateTo("/trips/new");
    private void GoEdit(Item t) => Nav.NavigateTo($"/trips/new/{t.TripId}");

    private void Start(Item t)
    {
        _startFor = t.TripId;
        _startAt = (t.PlannedStartAt ?? DateTime.Now).ToString("yyyy-MM-ddTHH:mm");
        _startOdo = null;
    }

    private void Complete(Item t)
    {
        _endFor = t.TripId;
        _endAt = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
        _endOdo = null;
    }

    private async Task ConfirmStart()
    {
        var id = _startFor; _startFor = null;
        if (id is null) return;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/trips/{id}/start",
                new { actualStartAt = _startAt, startOdometer = _startOdo });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task ConfirmComplete()
    {
        var id = _endFor; _endFor = null;
        if (id is null) return;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/trips/{id}/complete",
                new { actualEndAt = _endAt, endOdometer = _endOdo });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Post(Item t, string action)
    {
        try
        {
            var res = await Http.PostAsync($"api/trips/{t.TripId}/{action}", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item t)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/trips/{t.TripId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
