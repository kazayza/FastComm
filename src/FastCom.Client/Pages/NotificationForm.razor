@page "/notifications/new"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>إشعار جديد — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO — كارت مستقل بنفس تصميم القائمة
═══════════════════════════════════════════ *@
<div class="ntf-hero-wrapper">
    <div class="fc-hero fc-hero-ultra-slim">
        <div class="fc-hero-inner">

            <div class="ntf-hero-row">
                <div class="ntf-hero-left">
                    <div class="ntf-breadcrumb">
                        <a href="/notifications" class="ntf-bc-link">
                            <svg viewBox="0 0 24 24" width="11" height="11" fill="none"
                                 stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            الإشعارات
                        </a>
                        <span class="ntf-bc-sep">›</span>
                        <span class="ntf-bc-current">إشعار جديد</span>
                    </div>
                    <h1 class="ntf-hero-title">إنشاء وإرسال إشعار جديد</h1>
                    <span class="ntf-hero-sub">تكوين وإرسال تنبيه للمستخدمين أو ربطه بمستند تشغيلي</span>
                </div>

                <div class="ntf-hero-right">
                    <button class="ntf-back-btn" @onclick="GoBack">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                             stroke="currentColor" stroke-width="2.5">
                            <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        رجوع للقائمة
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="ntf-form-body">
    @if (!CanManage)
    {
        <div class="ntf-no-perm">
            <div class="ntf-no-perm-icon">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none"
                     stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية لإرسال إشعارات جديدة — تواصل مع المسؤول</p>
            <button class="ntf-no-perm-btn" @onclick="GoBack">العودة للقائمة</button>
        </div>
    }
    else
    {
        @* ── Banner للرسائل ── *@
        @if (_msg is not null)
        {
            <div class="ntf-banner @(_ok ? "ntf-banner-ok" : "ntf-banner-err")" role="alert">
                <div class="ntf-banner-icon" aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="ntf-banner-close" @onclick="() => _msg = null">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        }

        @* ── الكارت الرئيسي بـ MudTabs ── *@
        <div class="ntf-form-card">
            <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                     PanelClass="ntf-tab-panel" @bind-ActivePanelIndex="_activeTab" Class="ntf-mud-tabs">

                @* ══════ Tab 1: محتوى الإشعار ══════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="ntf-tab-label">
                            <div class="ntf-tab-ic ntf-tab-ic-blue">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <span>محتوى الإشعار</span>
                            @if (_triedSave && (string.IsNullOrWhiteSpace(_f.Title) || string.IsNullOrWhiteSpace(_f.Message)))
                            {
                                <span class="ntf-tab-err-dot"></span>
                            }
                        </div>
                    </TabContent>
                    <ChildContent>
                        <div class="ntf-tab-section">
                            <div class="ntf-sec-head">
                                <div class="ntf-sec-icon blue">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="ntf-sec-title">بيانات محتوى الإشعار</div>
                                    <div class="ntf-sec-sub">العنوان والنص التفصيلي مع مستوى الأولوية للتنبيه</div>
                                </div>
                            </div>

                            <div class="ntf-fields">
                                <div class="ntf-field">
                                    <label class="ntf-label">العنوان <span class="ntf-req">*</span></label>
                                    <input class="ntf-input @(string.IsNullOrWhiteSpace(_f.Title) && _triedSave ? "ntf-input-err" : "")"
                                           @bind="_f.Title" maxlength="200" placeholder="عنوان مختصر وواضح" />
                                    @if (string.IsNullOrWhiteSpace(_f.Title) && _triedSave)
                                    {
                                        <div class="ntf-err-msg">العنوان مطلوب</div>
                                    }
                                </div>

                                <div class="ntf-field">
                                    <label class="ntf-label">درجة الأولوية</label>
                                    <select class="ntf-input ntf-select" @bind="_f.Priority">
                                        <option value="Low">منخفضة</option>
                                        <option value="Normal">عادية</option>
                                        <option value="High">عالية</option>
                                        <option value="Critical">حرجة</option>
                                    </select>
                                    @if (_f.Priority is "High" or "Critical")
                                    {
                                        <div class="ntf-hint ntf-hint-red">
                                            <svg viewBox="0 0 16 16" width="11" height="11" fill="none"
                                                 stroke="currentColor" stroke-width="1.8">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            هذه الأولوية تصدر تنبيهاً فورياً ومميزاً
                                        </div>
                                    }
                                </div>

                                <div class="ntf-field ntf-full">
                                    <label class="ntf-label">نص الإشعار <span class="ntf-req">*</span></label>
                                    <textarea class="ntf-input ntf-textarea @(string.IsNullOrWhiteSpace(_f.Message) && _triedSave ? "ntf-input-err" : "")"
                                              @bind="_f.Message" rows="5" maxlength="1000"
                                              placeholder="اكتب تفاصيل الرسالة هنا..."></textarea>
                                    <div class="ntf-char-count"><span>@(_f.Message?.Length ?? 0)</span> / 1000</div>
                                    @if (string.IsNullOrWhiteSpace(_f.Message) && _triedSave)
                                    {
                                        <div class="ntf-err-msg">نص الإشعار مطلوب</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </MudTabPanel>

                @* ══════ Tab 2: المستهدفين والربط ══════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="ntf-tab-label">
                            <div class="ntf-tab-ic ntf-tab-ic-green">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                                    <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
                                </svg>
                            </div>
                            <span>المستهدفين والربط</span>
                            @if (_triedSave && !string.IsNullOrEmpty(_f.EntityType) && _f.EntityId is null)
                            {
                                <span class="ntf-tab-err-dot"></span>
                            }
                        </div>
                    </TabContent>
                    <ChildContent>
                        <div class="ntf-tab-section">
                            <div class="ntf-sec-head">
                                <div class="ntf-sec-icon green">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="ntf-sec-title">إعدادات النشر والربط بكيان</div>
                                    <div class="ntf-sec-sub">تحديد المستقبلين وإمكانية ربط الإشعار بملف تشغيلي مباشر</div>
                                </div>
                            </div>

                            <div class="ntf-fields">
                                <div class="ntf-field ntf-full">
                                    <div class="ntf-toggle-box @(_f.IsGlobal ? "ntf-toggle-on" : "")">
                                        <div class="ntf-toggle-content">
                                            <div class="ntf-toggle-icon @(_f.IsGlobal ? "icon-on" : "")">
                                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                                                     stroke="currentColor" stroke-width="1.8">
                                                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                                    <circle cx="9" cy="7" r="4"/>
                                                    <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                                </svg>
                                            </div>
                                            <div class="ntf-toggle-text">
                                                <div class="ntf-toggle-title">إشعار عام</div>
                                                <div class="ntf-toggle-sub">تفعيله يرسل الإشعار لجميع مستخدمي النظام فوراً</div>
                                            </div>
                                        </div>
                                        <label class="ntf-switch">
                                            <input type="checkbox" @bind="_f.IsGlobal" />
                                            <span class="ntf-sw-track"><span class="ntf-sw-dot"></span></span>
                                        </label>
                                    </div>
                                </div>

                                <div class="ntf-field">
                                    <label class="ntf-label">تصنيف الإشعار</label>
                                    <select class="ntf-input ntf-select" @bind="_f.NotificationType">
                                        @foreach (var t in Types) { <option value="@t.Key">@t.Value</option> }
                                    </select>
                                </div>

                                <div class="ntf-field">
                                    <label class="ntf-label">الربط بكيان (اختياري)</label>
                                    <select class="ntf-input ntf-select" @bind="_f.EntityType">
                                        <option value="">— بدون ربط —</option>
                                        @foreach (var e in Entities) { <option value="@e.Key">@e.Value</option> }
                                    </select>
                                    <div class="ntf-hint">الربط يتيح فتح المستند من الإشعار مباشرة</div>
                                </div>

                                @if (!string.IsNullOrEmpty(_f.EntityType))
                                {
                                    <div class="ntf-field">
                                        <label class="ntf-label">رقم الكيان <span class="ntf-req">*</span></label>
                                        <input type="number" min="1" class="ntf-input @(_f.EntityId is null && _triedSave ? "ntf-input-err" : "")"
                                               value="@_f.EntityId" @onchange="e => _f.EntityId = ParseLong(e.Value)"
                                               placeholder="رقم المستند" />
                                        @if (_f.EntityId is null && _triedSave)
                                        {
                                            <div class="ntf-err-msg">رقم الكيان مطلوب عند اختيار نوع الكيان</div>
                                        }
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(_f.EntityType) && _f.EntityId is null)
                            {
                                <div class="ntf-warn-box" role="alert">
                                    <div class="ntf-warn-icon">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                             stroke="currentColor" stroke-width="2">
                                            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                                            <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                                        </svg>
                                    </div>
                                    <div class="ntf-warn-body">
                                        <strong>رقم الكيان مفقود</strong>
                                        <p>اخترت الربط بـ «@EntityAr(_f.EntityType)» — اكتب الرقم أو أزل الربط</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </ChildContent>
                </MudTabPanel>

            </MudTabs>
        </div>

        @* ── شريط سفلي ── *@
        <div class="ntf-bottom-bar">
            <button class="ntf-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للقائمة
            </button>
        </div>
    }
</div>

@* ═══════════════════════════════════════════
   FAB — الوميض الأخضر للإرسال
═══════════════════════════════════════════ *@
@if (CanManage)
{
    <div class="ntf-save-fab-wrap">
        <button class="ntf-save-fab" @onclick="SaveAsync" disabled="@_saving"
                title="إرسال الإشعار" aria-label="إرسال الإشعار">
            @if (_saving)
            {
                <span class="ntf-fab-spinner"></span>
            }
            else
            {
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                     stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
            }
        </button>
    </div>
}

<style>
    /* ════════════════════════════════════════════════════════
       HERO WRAPPER — نفس تصميم القائمة
    ════════════════════════════════════════════════════════ */
    .ntf-hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px; margin: 0 auto;
        width: 100%; box-sizing: border-box;
        position: relative; z-index: 1;
    }
    .ntf-hero-wrapper .fc-hero {
        border-radius: 20px !important; overflow: hidden;
        box-shadow: 0 12px 32px rgba(13,38,84,0.15), 0 4px 12px rgba(13,38,84,0.08);
        border: 1px solid rgba(255,255,255,0.08);
    }
    .ntf-hero-wrapper .fc-hero.fc-hero-ultra-slim {
        padding-top: 14px !important; padding-bottom: 16px !important;
    }
    .ntf-hero-row {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; flex-wrap: wrap;
    }
    .ntf-hero-left { display: flex; flex-direction: column; gap: 4px; }
    .ntf-hero-title {
        margin: 0; font-size: clamp(16px,1.8vw,20px);
        font-weight: 900; color: #fff; line-height: 1.2;
    }
    .ntf-hero-sub { font-size: 10.5px; color: rgba(255,255,255,0.55); font-weight: 600; }
    .ntf-hero-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

    /* Breadcrumb */
    .ntf-breadcrumb {
        display: flex; align-items: center; gap: 6px;
        font-size: 10.5px; font-weight: 700; color: rgba(255,255,255,0.55);
    }
    .ntf-bc-link {
        display: inline-flex; align-items: center; gap: 3px;
        color: #7dd3fc; text-decoration: none; font-weight: 800;
    }
    .ntf-bc-link:hover { opacity: 0.75; }
    .ntf-bc-sep { color: rgba(255,255,255,0.35); }
    .ntf-bc-current { color: #fff; font-weight: 800; }

    .ntf-back-btn {
        display: inline-flex; align-items: center; gap: 5px;
        background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
        border-radius: 8px; color: rgba(255,255,255,0.75);
        font-family: inherit; font-size: 11px; font-weight: 700;
        padding: 6px 12px; cursor: pointer; transition: all 0.15s ease;
    }
    .ntf-back-btn:hover {
        background: rgba(255,255,255,0.16); color: #fff; border-color: rgba(255,255,255,0.28);
    }

    /* ════════════════════════════════════════════════════════
       FORM BODY
    ════════════════════════════════════════════════════════ */
    .ntf-form-body {
        padding: 18px clamp(16px, 3vw, 40px) 100px;
        max-width: 1440px; margin-inline: auto;
        width: 100%; box-sizing: border-box;
        position: relative; z-index: 2;
    }

    /* No Permission */
    .ntf-no-perm {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px; background: #fff;
        border: 1px solid #dde5f0; border-radius: 18px;
        padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,0.06);
    }
    .ntf-no-perm-icon {
        width: 68px; height: 68px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #fff0f2; color: #e03048;
    }
    .ntf-no-perm h3 { margin: 0; font-size: 17px; font-weight: 800; color: #1c2b44; }
    .ntf-no-perm p { margin: 0; font-size: 13px; color: #6b7d95; }
    .ntf-no-perm-btn {
        margin-top: 8px; padding: 9px 20px;
        border: 1px solid #dde5f0; border-radius: 9px;
        background: #fff; color: #1c2b44; font-family: inherit;
        font-size: 12px; font-weight: 700; cursor: pointer;
    }
    .ntf-no-perm-btn:hover { background: #f0f4fa; }

    /* Banner */
    .ntf-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600; margin-bottom: 14px;
        animation: ntf-banner-in 0.25s ease;
    }
    @@keyframes ntf-banner-in { from { opacity:0; transform:translateY(-6px) } to { opacity:1; transform:none } }
    .ntf-banner-ok { background: #e9f8f0; color: #0e7a43; border: 1px solid #b5e8d0; }
    .ntf-banner-err { background: #fff0f2; color: #e03048; border: 1px solid #ffc8cf; }
    .ntf-banner-icon { flex: 0 0 auto; }
    .ntf-banner-close {
        margin-right: auto; background: none; border: none;
        color: inherit; opacity: 0.6; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        width: 24px; height: 24px; border-radius: 5px;
    }
    .ntf-banner-close:hover { opacity: 1; }

    /* Form Card */
    .ntf-form-card {
        background: #fff; border: 1px solid #dde5f0;
        border-radius: 18px;
        box-shadow: 0 2px 6px rgba(15,41,82,0.04), 0 10px 30px rgba(15,41,82,0.06);
        overflow: hidden; width: 100%;
    }

    /* MudTabs */
    .ntf-mud-tabs .mud-tabs-toolbar {
        background: linear-gradient(180deg, #f9fafd 0%, #f3f6fb 100%);
        border-bottom: 2px solid #e8edf5;
        padding: 0 16px; min-height: 54px;
    }
    .ntf-mud-tabs .mud-tab {
        font-family: "Cairo","Tajawal","Inter",Arial,sans-serif;
        font-size: 12px; font-weight: 700; color: #6b7d95;
        padding: 0 6px; min-width: unset; transition: color 0.15s ease;
    }
    .ntf-mud-tabs .mud-tab.mud-tab-active { color: var(--fc-blue, #1e6ef5) !important; font-weight: 800; }
    .ntf-mud-tabs .mud-tab-slider { background: var(--fc-blue, #1e6ef5) !important; height: 3px; border-radius: 3px 3px 0 0; }
    .ntf-mud-tabs .mud-tab:hover:not(.mud-tab-active) { color: #1c2c44; background: rgba(0,0,0,0.03); border-radius: 8px; }
    .ntf-tab-panel { padding: 0; }

    /* Tab Labels */
    .ntf-tab-label { display: flex; align-items: center; gap: 7px; padding: 0 4px; white-space: nowrap; position: relative; }
    .ntf-tab-ic { width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: 7px; }
    .ntf-tab-ic-blue { background: #eaf1ff; color: var(--fc-blue, #1e6ef5); }
    .ntf-tab-ic-green { background: #e9f8f0; color: #16a35b; }
    .ntf-tab-err-dot {
        width: 7px; height: 7px; border-radius: 50%; background: #e03048;
        animation: ntf-pulse-err 1.5s ease infinite;
    }
    @@keyframes ntf-pulse-err { 0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,0.4); } 50% { box-shadow: 0 0 0 5px rgba(224,48,72,0); } }

    /* Section */
    .ntf-tab-section { padding: 24px 28px 28px; }
    .ntf-sec-head {
        display: flex; align-items: flex-start; gap: 12px;
        margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid #edf1f7;
    }
    .ntf-sec-icon {
        width: 42px; height: 42px; flex: 0 0 42px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
    }
    .ntf-sec-icon.blue { background: #eaf1ff; color: var(--fc-blue, #1e6ef5); border: 1px solid #bdd4fc; }
    .ntf-sec-icon.green { background: #e9f8f0; color: #16a35b; border: 1px solid #b0e0c5; }
    .ntf-sec-title { font-size: 15px; font-weight: 800; color: #1c2b43; line-height: 1.2; }
    .ntf-sec-sub { font-size: 11px; font-weight: 500; color: #6b7d95; margin-top: 3px; }

    /* Fields Grid */
    .ntf-fields { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; width: 100%; }
    .ntf-field { display: flex; flex-direction: column; gap: 6px; }
    .ntf-full { grid-column: 1 / -1; }

    .ntf-label { font-size: 12px; font-weight: 800; color: #344258; display: flex; align-items: center; gap: 4px; }
    .ntf-req { color: #e03048; font-size: 14px; line-height: 1; }

    .ntf-input {
        height: 42px; width: 100%; border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: #1c2c44; font-family: inherit; font-size: 13px;
        padding: 0 12px; outline: none; box-sizing: border-box;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .ntf-input:focus { border-color: var(--fc-blue, #1e6ef5); box-shadow: 0 0 0 3px rgba(30,110,245,0.1); background: #fff; }
    .ntf-input.ntf-input-err { border-color: #e03048; box-shadow: 0 0 0 3px rgba(224,48,72,0.08); background: #fffafb; }
    .ntf-input::placeholder { color: #b0bcc8; }

    .ntf-select {
        cursor: pointer; -webkit-appearance: none; -moz-appearance: none; appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236b7d95' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat; background-position: left 12px center; background-size: 14px; padding-left: 36px;
    }

    .ntf-textarea { height: auto; padding: 12px; resize: vertical; min-height: 100px; line-height: 1.6; }
    .ntf-char-count { text-align: left; font-size: 10.5px; color: #b4c0d0; margin-top: 4px; font-weight: 600; }
    .ntf-err-msg { font-size: 10.5px; color: #e03048; font-weight: 700; }
    .ntf-hint { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: #6b7d95; font-weight: 500; margin-top: 4px; }
    .ntf-hint-red { color: #e03048; font-weight: 700; }

    /* Toggle Box */
    .ntf-toggle-box {
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        padding: 16px 18px; border: 1px solid #dde5f0; border-radius: 12px;
        background: #f8fafc; transition: all 0.2s ease;
    }
    .ntf-toggle-box.ntf-toggle-on { border-color: #bdd4fc; background: #eaf1ff; box-shadow: 0 0 0 3px rgba(30,110,245,0.07); }
    .ntf-toggle-content { display: flex; align-items: center; gap: 14px; }
    .ntf-toggle-icon {
        width: 44px; height: 44px; flex: 0 0 44px; border-radius: 11px;
        display: flex; align-items: center; justify-content: center;
        background: #edf1f7; color: #6b7d95; transition: all 0.2s ease;
    }
    .ntf-toggle-icon.icon-on { background: #eaf1ff; color: var(--fc-blue, #1e6ef5); }
    .ntf-toggle-title { font-size: 13px; font-weight: 800; color: #1c2b44; }
    .ntf-toggle-sub { font-size: 11px; color: #6b7d95; margin-top: 2px; }

    .ntf-switch { display: flex; align-items: center; cursor: pointer; flex-shrink: 0; }
    .ntf-switch input { display: none; }
    .ntf-sw-track {
        position: relative; width: 46px; height: 26px; background: #d8e2f0;
        border-radius: 999px; transition: background 0.2s ease;
    }
    .ntf-switch input:checked + .ntf-sw-track { background: var(--fc-blue, #1e6ef5); }
    .ntf-sw-dot {
        position: absolute; left: 3px; width: 20px; height: 20px; top: 3px;
        border-radius: 50%; background: #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.2);
        transition: left 0.2s ease;
    }
    .ntf-switch input:checked + .ntf-sw-track .ntf-sw-dot { left: calc(100% - 23px); }

    /* Warning Box */
    .ntf-warn-box {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 14px 16px; margin-top: 18px; border-radius: 10px;
        background: #fffbeb; border: 1px solid #fde68a;
    }
    .ntf-warn-icon { flex: 0 0 auto; color: #d97706; }
    .ntf-warn-body strong { display: block; font-size: 12.5px; font-weight: 800; color: #78350f; }
    .ntf-warn-body p { margin: 4px 0 0; font-size: 11.5px; color: #92400e; line-height: 1.6; }

    /* Bottom Bar */
    .ntf-bottom-bar {
        display: flex; align-items: center; justify-content: flex-start;
        gap: 12px; margin-top: 16px; padding: 14px 20px;
        background: #fff; border: 1px solid #dde5f0; border-radius: 18px;
        box-shadow: 0 2px 8px rgba(15,41,82,0.04); width: 100%; box-sizing: border-box;
    }
    .ntf-bottom-back {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1px solid #dde5f0; border-radius: 9px;
        background: #fff; color: #6b7d95;
        font-family: inherit; font-size: 12px; font-weight: 700;
        cursor: pointer; transition: all 0.15s ease;
    }
    .ntf-bottom-back:hover { background: #f0f4fa; border-color: #c0ccd8; color: #1c2b44; }
    .ntf-bottom-back svg { transform: rotate(180deg); }

    /* ════════════════════════════════════════════════════════
       FAB — الوميض الأخضر للإرسال
    ════════════════════════════════════════════════════════ */
    .ntf-save-fab-wrap {
        position: fixed; bottom: 28px; left: 28px;
        z-index: 999; display: flex; flex-direction: column; align-items: center;
    }

    .ntf-save-fab {
        position: relative; width: 56px; height: 56px;
        border-radius: 50%; border: 2.5px solid #6ee7b7 !important;
        padding: 0; display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        background: linear-gradient(135deg, #10b981, #0f9d6b); color: #fff;
        box-shadow: 0 8px 24px rgba(16,185,129,0.45), 0 4px 12px rgba(110,231,183,0.3),
                    inset 0 1px 0 rgba(255,255,255,0.3);
        transition: all 0.25s cubic-bezier(0.34,1.3,0.64,1);
    }
    .ntf-save-fab::before {
        content: ""; position: absolute; inset: -6px; border-radius: 50%;
        background: radial-gradient(circle, rgba(110,231,183,0.5) 0%, rgba(16,185,129,0.2) 50%, rgba(16,185,129,0) 75%);
        filter: blur(8px); animation: ntf-halo 2.2s ease-in-out infinite;
        pointer-events: none; z-index: -1;
    }
    .ntf-save-fab:hover:not(:disabled) {
        transform: translateY(-4px) scale(1.06);
        box-shadow: 0 10px 28px rgba(16,185,129,0.55), 0 4px 12px rgba(110,231,183,0.4);
    }
    .ntf-save-fab:active { transform: scale(0.92); }
    .ntf-save-fab:disabled { opacity: 0.6; cursor: not-allowed; }
    @@keyframes ntf-halo { 0%,100% { opacity:0.6; transform:scale(1); } 50% { opacity:0.95; transform:scale(1.15); } }

    .ntf-fab-spinner {
        width: 20px; height: 20px;
        border: 2.5px solid rgba(255,255,255,0.3); border-top-color: #fff;
        border-radius: 50%; animation: ntf-spin 0.7s linear infinite;
    }

    /* ════════════════════════════════════════════════════════
       RESPONSIVE
    ════════════════════════════════════════════════════════ */
    @@media (max-width: 900px) {
        .ntf-fields { grid-template-columns: 1fr; }
        .ntf-form-body { padding: 14px 14px 90px; }
        .ntf-tab-section { padding: 18px 16px 22px; }
    }
    @@media (max-width: 680px) {
        .ntf-hero-wrapper { padding: 12px 12px 0; }
        .ntf-hero-wrapper .fc-hero { border-radius: 16px !important; }
        .ntf-hero-row { flex-direction: column; align-items: stretch; }
        .ntf-hero-right { justify-content: flex-end; }
        .ntf-bottom-bar { flex-direction: column; }
        .ntf-bottom-back { width: 100%; justify-content: center; }
        .ntf-save-fab-wrap { left: 18px; bottom: 18px; }
        .ntf-save-fab { width: 50px; height: 50px; }
    }
    @@media (max-width: 480px) {
        .ntf-form-body { padding: 10px 10px 90px; }
        .ntf-mud-tabs .mud-tab { font-size: 11px !important; padding: 0 8px !important; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .ntf-save-fab::before { animation: none; opacity: 0.4; }
    }
</style>

@code {
    private AuthUser? _user;
    private bool CanManage => _user?.Can("NOTIFICATION.MANAGE") ?? false;

    private bool _saving;
    private bool _loading;
    private string? _msg;
    private bool _ok = true;
    private int _activeTab;
    private bool _triedSave;

    private Form _f = new();

    private static readonly Dictionary<string, string> Types = new()
    {
        ["General"] = "عام", ["Alert"] = "تنبيه", ["Reminder"] = "تذكير",
        ["Finance"] = "مالي", ["Operations"] = "تشغيل", ["System"] = "النظام"
    };

    private static readonly Dictionary<string, string> Entities = new()
    {
        ["Operation"] = "عملية", ["Trip"] = "رحلة", ["Invoice"] = "فاتورة",
        ["Booking"] = "حجز", ["Custody"] = "عهدة", ["Driver"] = "سائق", ["Vehicle"] = "سيارة"
    };

    public class Form
    {
        public string? NotificationType { get; set; } = "General";
        public string? Title { get; set; }
        public string? Message { get; set; }
        public string? Priority { get; set; } = "Normal";
        public bool IsGlobal { get; set; } = true;
        public string? EntityType { get; set; }
        public long? EntityId { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _triedSave = true;

        if (string.IsNullOrWhiteSpace(_f.Title))
        {
            _ok = false; _msg = "يرجى كتابة عنوان الإشعار";
            _activeTab = 0; return;
        }
        if (string.IsNullOrWhiteSpace(_f.Message))
        {
            _ok = false; _msg = "يرجى كتابة نص الإشعار";
            _activeTab = 0; return;
        }
        if (!string.IsNullOrEmpty(_f.EntityType) && _f.EntityId is null)
        {
            _ok = false; _msg = "يرجى كتابة رقم الكيان أو إلغاء الربط";
            _activeTab = 1; return;
        }

        _saving = true; _msg = null;
        try
        {
            var payload = new
            {
                notificationType = _f.NotificationType,
                title = _f.Title.Trim(),
                message = _f.Message.Trim(),
                priority = _f.Priority,
                userId = _f.IsGlobal ? (int?)null : _user?.UserId,
                entityType = string.IsNullOrEmpty(_f.EntityType) ? null : _f.EntityType,
                entityId = _f.EntityId
            };

            var res = await Http.PostAsJsonAsync("api/notifications", payload);
            _msg = await MsgOf(res);
            _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل الإرسال: " + ex.Message; }
        finally { _saving = false; }
    }

    private void GoBack() => Nav.NavigateTo("/notifications");

    private static long? ParseLong(object? v) =>
        long.TryParse(v?.ToString(), out var n) && n > 0 ? n : null;

    private static string EntityAr(string t) => Entities.TryGetValue(t, out var v) ? v : t;

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم إرسال الإشعار بنجاح" : "حدث خطأ أثناء الإرسال"; }
    }
}