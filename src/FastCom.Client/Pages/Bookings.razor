    @@media (max-width: 680px) {
        .bl-body { padding: 10px 12px 24px; }
        .bl-toolbar { padding: 10px 12px; }
        .bl-booking-avatar { display: none; }
        .bl-booking-customer { max-width: 120px; }
        .bl-status-bar { padding: 8px 12px; }
        .bl-workflow-hint { padding: 8px 12px; display: none; }
