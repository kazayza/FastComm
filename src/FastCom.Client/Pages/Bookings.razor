@page "/bookings"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>الحجوزات — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">التشغيل · الحجوزات</div>
                <h1 class="fc-hero-title">الحجوزات</h1>
                <p class="fc-hero-sub">طلب العميل من أول ما ييجي لحد ما يتأكد ويتحول لعملية نقل</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="GoNew">حجز جديد</MudButton>
                }
            </div>
        </div>
        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.BookOnline" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">إجمالي الحجوزات</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(b => b.Status == "Draft")</div><div class="fc-kpi-lb">مسودة</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(b => b.Status == "Confirmed")</div><div class="fc-kpi-lb">مؤكد</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Route" /></div>
                    <div><div class="fc-kpi-num">@_items.Sum(b => b.ContainersQty)</div><div class="fc-kpi-lb">حاويات مطلوبة</div></div></div>
            </div>
        }
    </div>
</div>

<div class="fc-page">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">ليس لديك صلاحية عرض الحجوزات.</MudAlert>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">
            <div class="fc-toolbar">
                <div class="fc-filters">
                    @foreach (var t in Tabs)
                    {
                        <button class='fc-filter @(_tab == t.Key ? "on" : "")' @onclick="() => SetTab(t.Key)">@t.Value</button>
                    }
                </div>
                <MudTextField T="string" Value="_search" ValueChanged="v => _search = v"
                              Placeholder="ابحث برقم الحجز أو العميل..." Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="fc-search-box" Immediate="true" />
                <span class="fc-count">عرض @Filtered.Count() من @_items.Count</span>
            </div>

            @if (_loading)
            {
                <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else
            {
                <div class="fc-table-wrap"><table class="fc-table fc-table-pro">
                    <thead><tr>
                        <th>رقم الحجز</th><th>العميل</th><th>الخدمة</th><th>الخط</th>
                        <th>المطلوب</th><th>حاويات</th><th>الحالة</th>
                        <th style="width:150px; text-align:left">إجراءات</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var b in Filtered)
                        {
                            <tr>
                                <td><span class="fc-role-chip">@b.BookingNumber</span></td>
                                <td><div class="fc-cell-main">@b.CustomerName</div>
                                    @if (b.CustomerReference is not null)
                                    { <div class="fc-cell-sub">مرجع: @b.CustomerReference</div> }</td>
                                <td class="fc-cell-sub">@(b.ServiceName ?? "—")</td>
                                <td class="fc-cell-sub">@Route(b)</td>
                                <td class="fc-cell-sub">@(b.RequestedDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td><b>@b.ContainersQty</b></td>
                                <td><span class="fc-chip @ChipClass(b.Status)"><i></i>@StatusAr(b.Status)</span></td>
                                <td><div class="fc-row-actions">
                                    @if (b.Status == "Draft")
                                    {
                                        @if (CanEdit)
                                        {
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary" title="تعديل" OnClick="() => GoEdit(b)" />
                                        }
                                        @if (CanConfirm)
                                        {
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle"
                                                           Color="Color.Success" title="تأكيد" OnClick="() => Confirm(b)" />
                                        }
                                        @if (CanDelete)
                                        {
                                            @if (_confirmId == b.BookingId)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                                           OnClick="() => Delete(b)">متأكد؟</MudButton>
                                            }
                                            else
                                            {
                                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error" title="حذف" OnClick="() => _confirmId = b.BookingId" />
                                            }
                                        }
                                    }
                                    else if (b.Status == "Confirmed")
                                    {
                                        @if (CanEdit)
                                        {
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary" title="رجوع لمسودة" OnClick='() => SetStatus(b, "Draft")' />
                                        }
                                        @if (CanCancel)
                                        {
                                            @if (_confirmId == b.BookingId)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                                           OnClick='() => SetStatus(b, "Cancelled")'>إلغاء الحجز؟</MudButton>
                                            }
                                            else
                                            {
                                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                                               Color="Color.Error" title="إلغاء الحجز" OnClick="() => _confirmId = b.BookingId" />
                                            }
                                        }
                                    }
                                    else if (b.Status == "Cancelled" && CanEdit)
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Refresh"
                                                       Color="Color.Primary" title="إرجاع لمسودة" OnClick='() => SetStatus(b, "Draft")' />
                                    }
                                    else
                                    {
                                        <span class="fc-cell-sub">—</span>
                                    }
                                </div></td>
                            </tr>
                        }
                        @if (!Filtered.Any())
                        {
                            <tr><td colspan="8"><div class="fc-empty"><div>لايوجد اى حجوزاتفي الفلتر ده</div></div></td></tr>
                        }
                    </tbody>
                </table></div>
            }
        </div></div>
    }
</div>

@code {
    private AuthUser? _user;
    private bool CanView    => _user?.Can("BOOKING.VIEW") ?? false;
    private bool CanCreate  => _user?.Can("BOOKING.CREATE") ?? false;
    private bool CanEdit    => _user?.Can("BOOKING.EDIT") ?? false;
    private bool CanDelete  => _user?.Can("BOOKING.DELETE") ?? false;
    private bool CanConfirm => _user?.Can("BOOKING.CONFIRM") ?? false;
    private bool CanCancel  => _user?.Can("BOOKING.CANCEL") ?? false;

    private static readonly Dictionary<string, string> Tabs = new()
    {
        ["all"] = "الكل", ["Draft"] = "مسودة", ["Confirmed"] = "مؤكد",
        ["Assigned"] = "متخصص", ["InProgress"] = "قيد التنفيذ",
        ["Completed"] = "مكتمل", ["Cancelled"] = "ملغي"
    };

    private List<Item> _items = new();
    private bool _loading; private string _search = ""; private string _tab = "all";
    private long? _confirmId;

    public class Item
    {
        public long BookingId { get; set; }
        public string BookingNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string? ServiceName { get; set; }
        public string? PortName { get; set; }
        public string? DestinationName { get; set; }
        public string? CustomerReference { get; set; }
        public DateOnly? RequestedDate { get; set; }
        public int ContainersQty { get; set; }
        public string Status { get; set; } = "";
        public DateTime CreatedAt { get; set; }
    }

    private static string StatusAr(string s) => s switch
    {
        "Draft" => "مسودة", "Confirmed" => "مؤكد", "Assigned" => "متخصص",
        "InProgress" => "قيد التنفيذ", "Completed" => "مكتمل", "Cancelled" => "ملغي", _ => s
    };

    private static string ChipClass(string s) => s switch
    {
        "Draft" => "fc-chip-gray", "Confirmed" => "fc-chip-blue", "Assigned" => "fc-chip-purple",
        "InProgress" => "fc-chip-ok", "Completed" => "fc-chip-gold", "Cancelled" => "fc-chip-bad", _ => "fc-chip-gray"
    };

    private static string Route(Item b)
    {
        var from = b.PortName ?? "—";
        var to = b.DestinationName ?? "—";
        return $"{from} ← {to}";
    }

    private IEnumerable<Item> Filtered => _items.Where(b =>
        (_tab == "all" || b.Status == _tab) &&
        (string.IsNullOrWhiteSpace(_search) ||
         b.BookingNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         b.CustomerName.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/bookings?take=300") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void GoNew() => Nav.NavigateTo("/bookings/new");
    private void GoEdit(Item b) => Nav.NavigateTo($"/bookings/new/{b.BookingId}");

    private async Task Confirm(Item b) => await SetStatus(b, "Confirmed");

    private async Task SetStatus(Item b, string to)
    {
        try
        {
            var res = await Http.PostAsJsonAsync($"api/bookings/{b.BookingId}/status", new { to });
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item b)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/bookings/{b.BookingId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
