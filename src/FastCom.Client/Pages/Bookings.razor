    /* ================================================================
       RESPONSIVE
    ================================================================ */
    @@media (max-width: 1100px) {
        .bl-booking-customer { max-width: 140px; }
    }

    @@media (max-width: 900px) {
        .bl-toolbar { flex-direction: column; align-items: stretch; }
        .bl-search-wrap { max-width: 100%; }
        .bl-results-badge { margin-right: 0; }
        .bl-status-tabs { flex-wrap: wrap; }
