    .av-draft       { background: linear-gradient(135deg, #8899ae, #6b7d95); }
    .av-confirmed   { background: linear-gradient(135deg, #1558d6, #1e6ef5); }
    .av-assigned    { background: linear-gradient(135deg, #6035a0, #7c4dbd); }
    .av-inprogress  { background: linear-gradient(135deg, #0d8a48, #16a35b); }
    .av-completed   { background: linear-gradient(135deg, #b87d08, #e09a10); }
    .av-cancelled   { background: linear-gradient(135deg, #b02040, #e03048); }

    .bl-booking-info { min-width: 0; }

    .bl-booking-num { display: flex; align-items: center; gap: 6px; }

    .bl-code-chip {
        display: inline-flex; align-items: center;
        padding: 2px 8px; border-radius: 6px;
        background: #f0f4fa; border: 1px solid #e0e8f4;
        font-size: 11px; font-weight: 800; color: #5a6e88;
        font-family: "Inter", Arial, sans-serif;
    }

    .bl-booking-customer {
        font-size: 13px; font-weight: 800; color: #1c2c44;
        margin-top: 3px; white-space: nowrap;
        overflow: hidden; text-overflow: ellipsis; max-width: 180px;
    }

    .bl-booking-ref {
        display: flex; align-items: center; gap: 4px;
        font-size: 10px; color: #9aaabb; margin-top: 2px;
    }

    /* ── Route Cell ── */
    .bl-route-cell {
        display: flex; align-items: center; gap: 5px;
        justify-content: center;
    }

    .bl-route-from { font-size: 11px; font-weight: 700; color: var(--fc-blue); }
    .bl-route-to   { font-size: 11px; font-weight: 700; color: var(--fc-green); }
    .bl-route-arrow { color: #c0ccd8; display: flex; }

    /* ── Date Cell ── */
    .bl-date-cell {
        display: flex; align-items: center; gap: 4px;
        justify-content: center; color: #6b7d95; font-size: 12px;
    }

    /* ── Qty Badge ── */
    .bl-qty-badge {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 10px; border-radius: 8px;
        background: var(--fc-amber-lt); border: 1px solid #f0d898;
        color: #9a6d08; font-size: 12px;
    }
    .bl-qty-badge strong {
        font-size: 14px; font-weight: 900;
        font-family: "Inter", Arial, sans-serif;
    }

    /* ── Chips ── */
    .bl-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 8px;
        font-size: 10.5px; font-weight: 800;
    }

    .bl-chip-dot {
        width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px;
    }

    .chip-draft       { background: #f0f3f8;             color: #6b7d95; border: 1px solid #dde5f0; }
    .chip-confirmed   { background: var(--fc-blue-lt);   color: var(--fc-blue); border: 1px solid #c0d4fb; }
    .chip-assigned    { background: var(--fc-purple-lt); color: var(--fc-purple); border: 1px solid #d0bfef; }
    .chip-inprogress  { background: var(--fc-green-lt);  color: var(--fc-green); border: 1px solid #b0e0c5; }
    .chip-completed   { background: var(--fc-amber-lt);  color: #9a6d08; border: 1px solid #f0d898; }
    .chip-cancelled   { background: var(--fc-red-lt);    color: var(--fc-red); border: 1px solid #ffc8cf; }

    .cdot-draft       { background: #9aaabb; }
    .cdot-confirmed   { background: var(--fc-blue); }
    .cdot-assigned    { background: var(--fc-purple); }
    .cdot-inprogress  { background: var(--fc-green); }
    .cdot-completed   { background: var(--fc-amber); }
    .cdot-cancelled   { background: var(--fc-red); }

    /* ── Actions ── */
    .bl-actions {
        display: flex; align-items: center; gap: 4px; justify-content: center;
    }

    .bl-act-btn {
        width: 30px; height: 30px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; cursor: pointer;
        transition: all .15s ease; background: transparent;
    }

    .act-edit     { color: var(--fc-blue); }
    .act-confirm  { color: var(--fc-green); }
    .act-delete   { color: var(--fc-red); }
    .act-cancel   { color: var(--fc-red); }
    .act-revert   { color: var(--fc-blue); }

    .act-edit:hover     { background: var(--fc-blue-lt);  border-color: #c0d4fb; }
    .act-confirm:hover  { background: var(--fc-green-lt); border-color: #b0e0c5; }
    .act-delete:hover   { background: var(--fc-red-lt);   border-color: #ffc8cf; }
    .act-cancel:hover   { background: var(--fc-red-lt);   border-color: #ffc8cf; }
    .act-revert:hover   { background: var(--fc-blue-lt);  border-color: #c0d4fb; }

    .bl-confirm-del {
        height: 28px; padding: 0 10px;
        border: none; border-radius: 6px;
        background: linear-gradient(135deg, #e03048, #c0182e);
        color: #fff; font-family: inherit;
        font-size: 10px; font-weight: 800; cursor: pointer;
        animation: bl-pulse-del 1s ease infinite;
        white-space: nowrap;
    }
    @@keyframes bl-pulse-del {
        0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.35); }
        50%     { box-shadow: 0 0 0 5px rgba(224,48,72,0); }
