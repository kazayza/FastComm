@page "/bookings"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>الحجوزات — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">التشغيل · الحجوزات</div>
                <h1 class="fc-hero-title">الحجوزات</h1>
                <p class="fc-hero-sub">طلب العميل من أول ما ييجي لحد ما يتأكد ويتحول لعملية نقل</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="GoNew">حجز جديد</MudButton>
                }
            </div>
        </div>

        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.BookOnline" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">إجمالي الحجوزات</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(b => b.Status == "Draft")</div><div class="fc-kpi-lb">مسودة</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(b => b.Status == "Confirmed")</div><div class="fc-kpi-lb">مؤكد</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Route" /></div>
                    <div><div class="fc-kpi-num">@_items.Sum(b => b.ContainersQty)</div><div class="fc-kpi-lb">حاويات مطلوبة</div></div>
                </div>
            </div>
        }
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="bl-body">

    @if (!CanView)
    {
        <div class="bl-state-box">
            <div class="bl-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض الحجوزات — تواصل مع المسؤول</p>
        </div>
    }
    else
    {
        <div class="bl-card">

            @* ── Toolbar ── *@
            <div class="bl-toolbar">

                <div class="bl-search-wrap">
                    <svg class="bl-search-icon" viewBox="0 0 24 24"
                         width="16" height="16" fill="none" stroke="currentColor"
                         stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="bl-search-input"
                           placeholder="ابحث برقم الحجز أو العميل..."
                           @bind="_search"
                           @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="bl-search-clear"
                                @onclick="() => _search = string.Empty"
                                aria-label="مسح البحث">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="bl-results-badge">
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>

            </div>


            @* ── Status Filter Tabs ── *@
            <div class="bl-status-bar">

                <div class="bl-status-tabs" role="group" aria-label="فلتر الحالة">
                    @foreach (var t in _statusTabs)
                    {
                        var count = t.Key == "all"
                            ? _items.Count
                            : _items.Count(b => b.Status == t.Key);

                        <button class="bl-status-tab @(_tab == t.Key ? "active" : "") @StatusTabColor(t.Key)"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="bl-tab-dot @StatusDotColor(t.Key)"
                                  aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="bl-tab-count">@count</span>
                        </button>
                    }
                </div>

            </div>


            @* ── Workflow Hint ── *@
            <div class="bl-workflow-hint">
                <svg viewBox="0 0 24 24" width="14" height="14"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                </svg>
                <div class="bl-workflow-steps">
                    <span class="bl-wf-step wf-gray">مسودة</span>
                    <span class="bl-wf-arrow" aria-hidden="true">→</span>
                    <span class="bl-wf-step wf-blue">مؤكد</span>
                    <span class="bl-wf-arrow" aria-hidden="true">→</span>
                    <span class="bl-wf-step wf-purple">متخصص</span>
                    <span class="bl-wf-arrow" aria-hidden="true">→</span>
                    <span class="bl-wf-step wf-green">قيد التنفيذ</span>
                    <span class="bl-wf-arrow" aria-hidden="true">→</span>
                    <span class="bl-wf-step wf-amber">مكتمل</span>
                </div>
                <div class="bl-wf-note">
                    أنت بتتحكم في أول خطوتين فقط — الباقي بيتحرك تلقائياً حسب العمليات
                </div>
            </div>


            @* ── Content ── *@
            @if (_loading)
            {
                <div class="bl-loading">
                    <div class="bl-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل الحجوزات...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="bl-empty">
                    <div class="bl-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="40" height="40"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                            <path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"/>
                        </svg>
                    </div>
                    <div class="bl-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) ? "لا يوجد حجوزات في هذا الفلتر" : "لا توجد نتائج")
                    </div>
                    <div class="bl-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search)
                            ? "جرّب فلتر مختلف أو أنشئ حجز جديد"
                            : "جرّب كلمة بحث مختلفة")
                    </div>
                    @if (CanCreate && string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="bl-add-btn" @onclick="GoNew">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            حجز جديد
                        </button>
                    }
                </div>
            }
            else
            {
                @* ── الجدول ── *@
                <div class="bl-table-wrap">
                    <table class="bl-table" aria-label="قائمة الحجوزات">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">الحجز</th>
                                <th scope="col">الخدمة</th>
                                <th scope="col">المسار</th>
                                <th scope="col">التاريخ</th>
                                <th scope="col">حاويات</th>
                                <th scope="col">الحالة</th>
                                <th scope="col" style="width:160px">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Filtered)
                            {
                                <tr class="@(b.Status == "Cancelled" ? "row-cancelled" : "")">

                                    @* ── الحجز: رقم + عميل + مرجع ── *@
                                    <td class="td-start">
                                        <div class="bl-booking-cell">
                                            <div class="bl-booking-avatar @AvatarClass(b.Status)">
                                                <svg viewBox="0 0 24 24" width="16" height="16"
                                                     fill="none" stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                                </svg>
                                            </div>
                                            <div class="bl-booking-info">
                                                <div class="bl-booking-num">
                                                    <span class="bl-code-chip">@b.BookingNumber</span>
                                                </div>
                                                <div class="bl-booking-customer">@b.CustomerName</div>
                                                @if (!string.IsNullOrWhiteSpace(b.CustomerReference))
                                                {
                                                    <div class="bl-booking-ref">
                                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                                             aria-hidden="true">
                                                            <rect x="2" y="2" width="12" height="12" rx="2"/>
                                                            <path d="M5 8h6M5 5h6M5 11h4" stroke-linecap="round"/>
                                                        </svg>
                                                        @b.CustomerReference
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    @* ── الخدمة ── *@
                                    <td class="td-muted">@(b.ServiceName ?? "—")</td>

                                    @* ── المسار ── *@
                                    <td>
                                        @if (b.PortName is not null || b.DestinationName is not null)
                                        {
                                            <div class="bl-route-cell">
                                                <span class="bl-route-from">@(b.PortName ?? "—")</span>
                                                <span class="bl-route-arrow" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="12" height="12"
                                                         fill="none" stroke="currentColor" stroke-width="2.5">
                                                        <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round"
                                                              stroke-linejoin="round"/>
                                                    </svg>
                                                </span>
                                                <span class="bl-route-to">@(b.DestinationName ?? "—")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="td-muted">—</span>
                                        }
                                    </td>

                                    @* ── التاريخ ── *@
                                    <td class="td-muted">
                                        @if (b.RequestedDate.HasValue)
                                        {
                                            <div class="bl-date-cell">
                                                <svg viewBox="0 0 16 16" width="11" height="11"
                                                     fill="none" stroke="currentColor" stroke-width="1.7"
                                                     aria-hidden="true">
                                                    <rect x="2" y="3" width="12" height="11" rx="2"/>
                                                    <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                                                </svg>
                                                @b.RequestedDate.Value.ToString("yyyy-MM-dd")
                                            </div>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>

                                    @* ── حاويات ── *@
                                    <td>
                                        <span class="bl-qty-badge">
                                            <svg viewBox="0 0 24 24" width="12" height="12"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                            </svg>
                                            <strong>@b.ContainersQty</strong>
                                        </span>
                                    </td>

                                    @* ── الحالة ── *@
                                    <td>
                                        <span class="bl-chip @ChipClass(b.Status)">
                                            <span class="bl-chip-dot @ChipDotClass(b.Status)"
                                                  aria-hidden="true"></span>
                                            @StatusAr(b.Status)
                                        </span>
                                    </td>

                                    @* ── إجراءات ── *@
                                    <td>
                                        <div class="bl-actions">

                                            @if (b.Status == "Draft")
                                            {
                                                @if (CanEdit)
                                                {
                                                    <button class="bl-act-btn act-edit"
                                                            @onclick="() => GoEdit(b)"
                                                            title="تعديل"
                                                            aria-label="تعديل @b.BookingNumber">
                                                        <svg viewBox="0 0 24 24" width="15" height="15"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                        </svg>
                                                    </button>
                                                }

                                                @if (CanConfirm)
                                                {
                                                    <button class="bl-act-btn act-confirm"
                                                            @onclick="() => Confirm(b)"
                                                            title="تأكيد الحجز"
                                                            aria-label="تأكيد @b.BookingNumber">
                                                        <svg viewBox="0 0 24 24" width="15" height="15"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"
                                                                  stroke-linecap="round"/>
                                                            <path d="M22 4L12 14.01l-3-3"
                                                                  stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>
                                                    </button>
                                                }

                                                @if (CanDelete)
                                                {
                                                    @if (_confirmId == b.BookingId)
                                                    {
                                                        <button class="bl-confirm-del"
                                                                @onclick="() => Delete(b)">
                                                            متأكد؟ حذف
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="bl-act-btn act-delete"
                                                                @onclick="() => _confirmId = b.BookingId"
                                                                title="حذف"
                                                                aria-label="حذف @b.BookingNumber">
                                                            <svg viewBox="0 0 24 24" width="15" height="15"
                                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                            </svg>
                                                        </button>
                                                    }
                                                }
                                            }

                                            else if (b.Status == "Confirmed")
                                            {
                                                @if (CanEdit)
                                                {
                                                    <button class="bl-act-btn act-revert"
                                                            @onclick='() => SetStatus(b, "Draft")'
                                                            title="إرجاع لمسودة"
                                                            aria-label="إرجاع @b.BookingNumber لمسودة">
                                                        <svg viewBox="0 0 24 24" width="15" height="15"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M1 4v6h6" stroke-linecap="round"
                                                                  stroke-linejoin="round"/>
                                                            <path d="M3.51 15a9 9 0 102.13-9.36L1 10"
                                                                  stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>
                                                    </button>
                                                }

                                                @if (CanCancel)
                                                {
                                                    @if (_confirmId == b.BookingId)
                                                    {
                                                        <button class="bl-confirm-del"
                                                                @onclick='() => SetStatus(b, "Cancelled")'>
                                                            إلغاء الحجز؟
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="bl-act-btn act-cancel"
                                                                @onclick="() => _confirmId = b.BookingId"
                                                                title="إلغاء الحجز"
                                                                aria-label="إلغاء @b.BookingNumber">
                                                            <svg viewBox="0 0 24 24" width="15" height="15"
                                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                                <circle cx="12" cy="12" r="10"/>
                                                                <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                                            </svg>
                                                        </button>
                                                    }
                                                }
                                            }

                                            else if (b.Status == "Cancelled" && CanEdit)
                                            {
                                                <button class="bl-act-btn act-revert"
                                                        @onclick='() => SetStatus(b, "Draft")'
                                                        title="إرجاع لمسودة"
                                                        aria-label="إرجاع @b.BookingNumber لمسودة">
                                                    <svg viewBox="0 0 24 24" width="15" height="15"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M1 4v6h6" stroke-linecap="round"
                                                              stroke-linejoin="round"/>
                                                        <path d="M3.51 15a9 9 0 102.13-9.36L1 10"
                                                              stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </button>
                                            }

                                            else
                                            {
                                                <span class="td-muted" style="font-size:11px">تلقائي</span>
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   CSS
═══════════════════════════════════════════ *@
<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       BODY
    ================================================================ */
    .bl-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1300px; width: 100%;
        margin: 0 auto;
    }

    /* ================================================================
       STATES
    ================================================================ */
    .bl-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .bl-state-icon {
        width: 68px; height: 68px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .bl-state-icon.perm { background: #fff0f2; color: var(--fc-red); }

    .bl-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .bl-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* ================================================================
       CARD
    ================================================================ */
    .bl-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    /* ================================================================
       TOOLBAR
    ================================================================ */
    .bl-toolbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
        flex-wrap: wrap;
    }

    .bl-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px; max-width: 380px;
    }

    .bl-search-icon {
        position: absolute; right: 12px; color: #9aaabb; pointer-events: none;
    }

    .bl-search-input {
        width: 100%; height: 38px;
        padding: 0 36px 0 12px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .bl-search-input:focus {
        border-color: var(--fc-blue);
        box-shadow: 0 0 0 3px rgba(30,110,245,.10);
    }
    .bl-search-input::placeholder { color: #b0bcc8; }

    .bl-search-clear {
        position: absolute; left: 10px;
        display: flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        border: none; background: #edf1f7; color: #8899ae;
        cursor: pointer; transition: all .12s ease;
    }
    .bl-search-clear:hover { background: #dde5f0; color: var(--fc-text); }

    .bl-results-badge {
        display: flex; align-items: center; gap: 5px;
        margin-right: auto;
        font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap;
    }
    .bl-results-badge strong { color: #5a6e88; }

    /* ================================================================
       STATUS TABS
    ================================================================ */
    .bl-status-bar {
        padding: 10px 18px;
        background: #f9fafd;
        border-bottom: 1px solid #edf1f7;
        overflow-x: auto;
    }

    .bl-status-tabs {
        display: flex; gap: 5px;
        padding: 3px; border-radius: 10px; background: #f0f3f8;
    }

    .bl-status-tab {
        display: flex; align-items: center; gap: 5px;
        height: 34px; padding: 0 12px;
        border: none; border-radius: 8px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 11px; font-weight: 700;
        cursor: pointer; white-space: nowrap;
