</style>


@code {
    private AuthUser? _user;
    private bool CanView    => _user?.Can("BOOKING.VIEW")    ?? false;
    private bool CanCreate  => _user?.Can("BOOKING.CREATE")  ?? false;
    private bool CanEdit    => _user?.Can("BOOKING.EDIT")    ?? false;
    private bool CanDelete  => _user?.Can("BOOKING.DELETE")  ?? false;
    private bool CanConfirm => _user?.Can("BOOKING.CONFIRM") ?? false;
    private bool CanCancel  => _user?.Can("BOOKING.CANCEL")  ?? false;

    private static readonly (string Key, string Value)[] _statusTabs =
    {
        ("all",        "الكل"),
        ("Draft",      "مسودة"),
        ("Confirmed",  "مؤكد"),
        ("Assigned",   "متخصص"),
        ("InProgress", "قيد التنفيذ"),
        ("Completed",  "مكتمل"),
        ("Cancelled",  "ملغي")
    };

    private List<Item> _items = new();
    private bool   _loading;
    private string _search = "";
    private string _tab    = "all";
    private long?  _confirmId;

    public class Item
    {
        public long     BookingId         { get; set; }
        public string   BookingNumber     { get; set; } = "";
        public string   CustomerName      { get; set; } = "";
        public string?  ServiceName       { get; set; }
        public string?  PortName          { get; set; }
        public string?  DestinationName   { get; set; }
        public string?  CustomerReference { get; set; }
        public DateOnly? RequestedDate    { get; set; }
        public int      ContainersQty     { get; set; }
        public string   Status            { get; set; } = "";
        public DateTime CreatedAt         { get; set; }
    }

    /* ── Helpers ── */
    private static string StatusAr(string s) => s switch
    {
        "Draft"      => "مسودة",
        "Confirmed"  => "مؤكد",
        "Assigned"   => "متخصص",
        "InProgress" => "قيد التنفيذ",
        "Completed"  => "مكتمل",
        "Cancelled"  => "ملغي",
        _            => s
    };

    private static string ChipClass(string s) => s switch
    {
        "Draft"      => "chip-draft",
        "Confirmed"  => "chip-confirmed",
        "Assigned"   => "chip-assigned",
        "InProgress" => "chip-inprogress",
        "Completed"  => "chip-completed",
        "Cancelled"  => "chip-cancelled",
        _            => "chip-draft"
    };

    private static string ChipDotClass(string s) => s switch
    {
        "Draft"      => "cdot-draft",
        "Confirmed"  => "cdot-confirmed",
        "Assigned"   => "cdot-assigned",
        "InProgress" => "cdot-inprogress",
        "Completed"  => "cdot-completed",
        "Cancelled"  => "cdot-cancelled",
        _            => "cdot-draft"
    };

    private static string AvatarClass(string s) => s switch
    {
        "Draft"      => "av-draft",
        "Confirmed"  => "av-confirmed",
        "Assigned"   => "av-assigned",
        "InProgress" => "av-inprogress",
        "Completed"  => "av-completed",
        "Cancelled"  => "av-cancelled",
        _            => "av-draft"
    };

    private static string StatusTabColor(string s) => s switch
    {
        _ => ""
    };

    private static string StatusDotColor(string s) => s switch
    {
        "all"        => "dot-all",
        "Draft"      => "dot-draft",
        "Confirmed"  => "dot-confirmed",
        "Assigned"   => "dot-assigned",
        "InProgress" => "dot-inprogress",
        "Completed"  => "dot-completed",
        "Cancelled"  => "dot-cancelled",
        _            => "dot-all"
    };

    private IEnumerable<Item> Filtered => _items.Where(b =>
        (_tab == "all" || b.Status == _tab) &&
        (string.IsNullOrWhiteSpace(_search) ||
         b.BookingNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         b.CustomerName.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try   { _items = await Http.GetFromJsonAsync<List<Item>>("api/bookings?take=300") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void GoNew()        => Nav.NavigateTo("/bookings/new");
    private void GoEdit(Item b) => Nav.NavigateTo($"/bookings/new/{b.BookingId}");

    private async Task Confirm(Item b) => await SetStatus(b, "Confirmed");

    private async Task SetStatus(Item b, string to)
    {
        try
        {
            var res = await Http.PostAsJsonAsync($"api/bookings/{b.BookingId}/status", new { to });
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item b)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/bookings/{b.BookingId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}