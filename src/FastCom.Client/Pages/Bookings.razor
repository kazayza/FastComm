    .td-start { text-align: right !important; }
    .td-muted { color: #8899ae; font-size: 12px; }

    /* ── Booking Cell ── */
    .bl-booking-cell { display: flex; align-items: center; gap: 11px; }

    .bl-booking-avatar {
        width: 38px; height: 38px; flex: 0 0 38px; border-radius: 10px;
