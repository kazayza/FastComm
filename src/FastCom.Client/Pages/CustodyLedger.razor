.chip-approved{background:#e8fbf5;color:#0f766e;border-color:#bfeee4}
.chip-closed{background:#f1f5f9;color:#475569;border-color:#dde5ef}
.sdot-open{background:#3b82f6}.sdot-partial{background:#f59e0b}.sdot-submitted{background:#a855f7}.sdot-approved{background:#14b8a6}.sdot-closed{background:#64748b}
