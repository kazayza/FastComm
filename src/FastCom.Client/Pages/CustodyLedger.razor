@page "/custodies/{Id:long}"
@page "/custodies/{Id:long}/ledger"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>دفتر العهدة — فاست كوم</PageTitle>

<div class="cl-page">
@if (_loading)
{
    <div class="cl-state"><div class="cu-spinner"></div><span>جاري تحميل دفتر العهدة...</span></div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="cl-state cl-error">
        <h3>تعذّر تحميل الدفتر</h3>
        <p>@_error</p>
        <button class="cl-btn ghost" @onclick='() => Nav.NavigateTo("/custodies")'>العودة للعهد</button>
    </div>
}
else if (_data is null)
{
    <div class="cl-state"><p>لا توجد بيانات</p></div>
}
else
{
    var c = _data.Custody;
    var total = c.AmountIssued + c.AdditionalDue;
    var spentW = total > 0 ? (double)(c.AmountSpent / total * 100) : 0;
    var retW = total > 0 ? (double)(c.AmountReturned / total * 100) : 0;

    <div class="cl-hero fc-hero fc-hero-slim">
        <div class="cl-hero-inner">
            <div class="cl-hero-row">
                <div class="cl-hero-left">
                    <div class="cl-crumb-row">
                        <button type="button" class="cl-back" @onclick='() => Nav.NavigateTo("/custodies")' title="العودة لقائمة العهد">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            العهد
                        </button>
                        <span class="cl-crumb">المالية · العهد · دفتر العهدة</span>
                        <button type="button" class="cl-print-btn" @onclick='() => Nav.NavigateTo($"/custodies/print/{Id}")' title="طباعة دفتر العهدة PDF">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                            طباعة PDF
                        </button>
                    </div>
                    <div class="cl-title-row">
                        <h1 class="cl-title">@c.CustodyNumber</h1>
                        <span class="cu-chip @StatusChipClass(c.Status)"><span class="cu-chip-dot @StatusDotClass(c.Status)"></span>@StatusAr(c.Status)</span>
                    </div>
                    <div class="cl-meta">
                        <span class="cl-meta-item"><b>المستلم:</b> @c.OwnerName (@(c.OwnerType == "Driver" ? "سائق" : "موظف"))</span>
                        <span class="cl-meta-item"><b>تاريخ الصرف:</b> @c.CustodyDate.ToString("yyyy-MM-dd")</span>
                        @if (!string.IsNullOrWhiteSpace(c.TripNumber)) { <span class="cl-meta-item"><b>الرحلة:</b> @c.TripNumber @(!string.IsNullOrWhiteSpace(c.DriverName)? $"— {c.DriverName}" : "")</span> }
                        @if (!string.IsNullOrWhiteSpace(c.ParentCustodyNumber)) { <span class="cl-meta-item"><b>عهدة أصل:</b> @c.ParentCustodyNumber</span> }
                    </div>
                </div>
                <div class="cl-hero-right">
                    <div class="cl-kpis">
                        <div class="cl-kpi"><span class="cl-kpi-label">إجمالي المصروف</span><span class="cl-kpi-val">@Money(total)</span></div>
                        <div class="cl-kpi"><span class="cl-kpi-label">المنصرف</span><span class="cl-kpi-val spent">@Money(c.AmountSpent)</span></div>
                        <div class="cl-kpi"><span class="cl-kpi-label">المُردّ</span><span class="cl-kpi-val returned">@Money(c.AmountReturned)</span></div>
                        <div class="cl-kpi highlight"><span class="cl-kpi-label">المتبقي</span><span class="cl-kpi-val @(c.Remaining>0?"remaining":"ok")">@Money(c.Remaining)</span></div>
                    </div>
                    <div class="cl-progress">
                        <div class="cl-progress-bar">
                            <div class="seg spent" style="width:@Math.Min(spentW,100)%"></div>
                            <div class="seg returned" style="width:@Math.Min(retW,100)%"></div>
                        </div>
                        <div class="cl-progress-legend"><span>منصرف @spentW.ToString("0")%</span><span>مُرد @retW.ToString("0")%</span><span>متبقي @Math.Max(0,100-spentW-retW).ToString("0")%</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="cl-grid">
        <section class="cl-card cl-timeline-card">
            <div class="cl-card-head">
                <h2>سجل الحركات (Timeline)</h2>
                <span class="cl-count">@_data.Transactions.Count حركة</span>
            </div>
            @if (!_data.Transactions.Any())
            {
                <div class="cl-empty">لا توجد حركات مسجلة بعد</div>
            }
            else
            {
                <div class="cl-timeline">
                    @{ decimal running = 0; }
                    @foreach (var g in _data.Transactions.OrderBy(t=>t.TransactionDate).ThenBy(t=>t.CustodyTransactionId).GroupBy(t=>t.TransactionDate.Date))
                    {
                        <div class="cl-day">@g.Key.ToString("dddd، dd MMMM yyyy")</div>
                        @foreach (var t in g)
                        {
                            running = ApplyTx(running, t, c.AmountIssued);
                            var sign = TxSign(t.TransactionType);
                            var exp = ExpenseForTx(t);
                            <div class="cl-tl-item">
                                <div class="cl-tl-rail">
                                    <span class="cl-tl-dot @TxDotClass(t.TransactionType)"></span>
                                    <span class="cl-tl-line"></span>
                                </div>
                                <div class="cl-tl-body">
                                    <div class="cl-tl-top">
                                        <span class="cl-tl-type">@TxLabel(t.TransactionType)</span>
                                        <span class="cl-tl-date">@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</span>
                                    </div>
                                    <div class="cl-tl-main">
                                        <span class="cl-tl-amount @TxAmtClass(t.TransactionType)">@(sign)@Money(t.Amount) ج.م</span>
                                        @if (exp is not null)
                                        {
                                            <span class="cl-tl-ref">@ExpensePrimaryLabel(exp)</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(t.ExpenseNumber))
                                        {
                                            <span class="cl-tl-ref">@t.ExpenseNumber</span>
                                        }
                                    </div>
                                    @if (exp is not null)
                                    {
                                        <div class="cl-tl-exp">
                                            @if (!string.IsNullOrWhiteSpace(exp.Description)) { <div class="cl-tl-exp-desc"><b>البيان:</b> @exp.Description</div> }
                                            <div class="cl-tl-exp-meta">@ExpenseContextLabel(exp)</div>
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(TxContextLabel(t)))
                                    {
                                        <div class="cl-tl-exp"><div class="cl-tl-exp-meta">@TxContextLabel(t)</div></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(t.Notes)) { <div class="cl-tl-notes">@t.Notes</div> }
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="cl-tl-hint">الرصيد المتبقي الحالي: <b>@Money(c.Remaining) ج.م</b></div>
            }
        </section>

        <aside class="cl-side">
            <section class="cl-card">
                <div class="cl-card-head"><h2>المصروفات المرتبطة</h2><span class="cl-count">@_data.Expenses.Count</span></div>
                @if (!_data.Expenses.Any())
                {
                    <div class="cl-empty">لا توجد مصروفات مرتبطة</div>
                }
                else
                {
                    <div class="cl-exp-list">
                        @foreach (var e in _data.Expenses)
                        {
                            <div class="cl-exp">
                                <div class="cl-exp-top">
                                    <span class="cl-exp-title">@ExpensePrimaryLabel(e)</span>
                                    <span class="cl-exp-amt">@Money(e.Amount) ج.م</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(e.Description)) { <div class="cl-exp-desc"><b>البيان:</b> @e.Description</div> }
                                <div class="cl-exp-meta">@ExpenseContextLabel(e)</div>
                                <div class="cl-exp-meta"><span>@e.ExpenseDate.ToString("yyyy-MM-dd")</span><span class="cl-exp-status">@e.PaymentStatus</span><span class="cl-exp-no">@e.ExpenseNumber</span></div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="cl-card">
                <div class="cl-card-head"><h2>تفاصيل وملاحظات</h2></div>
                <dl class="cl-dl">
                    <div><dt>رقم العهدة</dt><dd>@c.CustodyNumber</dd></div>
                    <div><dt>الحالة</dt><dd>@StatusAr(c.Status)</dd></div>
                    <div><dt>المستلم</dt><dd>@c.OwnerName</dd></div>
                    <div><dt>تاريخ الصرف</dt><dd>@c.CustodyDate.ToString("yyyy-MM-dd HH:mm")</dd></div>
                    @if (!string.IsNullOrWhiteSpace(c.TripNumber)) { <div><dt>الرحلة</dt><dd>@c.TripNumber</dd></div> }
                    @if (c.ClosedAt is not null) { <div><dt>تاريخ الإغلاق</dt><dd>@c.ClosedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd></div> }
                </dl>
                @if (!string.IsNullOrWhiteSpace(c.Notes))
                {
                    <div class="cl-notes"><b>ملاحظات:</b><div>@c.Notes</div></div>
                }
            </section>
        </aside>
    </div>
}
</div>

<style>
