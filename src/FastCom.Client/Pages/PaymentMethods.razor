@page "/master/paymentmethods"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>طرق الدفع — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">البيانات الأساسية</div>
                <h1 class="fc-hero-title">طرق الدفع</h1>
                <p class="fc-hero-sub">نقدي · شيك · تحويل بنكي — التصنيف بيحدد هل الحركة تدخل الخزينة ولا لأ</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="LoadAsync" Style="color:#9FB4CC" />
                @if (CanManage)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="ResetForm">طريقة جديدة</MudButton>
                }
            </div>
        </div>

        <div class="fc-kpis-glass">
            <div class="fc-kpi">
                <div class="fc-kpi-lb">إجمالي الطرق</div>
                <div class="fc-kpi-num">@_items.Count</div>
            </div>
            <div class="fc-kpi">
                <div class="fc-kpi-lb">نقدية (تدخل الخزينة)</div>
                <div class="fc-kpi-num">@_items.Count(i => i.IsCashBased)</div>
            </div>
            <div class="fc-kpi">
                <div class="fc-kpi-lb">نشطة</div>
                <div class="fc-kpi-num">@_items.Count(i => i.IsActive)</div>
            </div>
        </div>
    </div>
</div>

<div class="fc-page">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">ليس لديك صلاحية عرض البيانات الأساسية.</MudAlert>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">

            <div class="fc-alert fc-alert-info">
                <div class="fc-alert-ic"><MudIcon Icon="@Icons.Material.Filled.Info" /></div>
                <div class="fc-alert-body">
                    <div class="fc-alert-title">«تدخل الخزينة» دي أهم خانة هنا</div>
                    <div>الطريقة <b>النقدية</b> بتسجّل الحركة في الخزينة تلقائيًا.
                        الشيكات والتحويلات <b>مش كاش في الدرج</b> — فمابتدخلش.
                        الخانة دي <b>مقفولة</b> لأي طريقة عليها حركات.</div>
                </div>
            </div>

            @* ══════════ الفورم ══════════ *@
            @if (CanManage)
            {
                <div class="fc-fsec">
                    <div class="fc-fsec-head">
                        <span class="fc-fsec-n">1</span>
                        <div>
                            <div class="fc-fsec-t">@(_editId is null ? "طريقة دفع جديدة" : $"تعديل: {_f.NameAr}")</div>
                            <div class="fc-fsec-d">الكود بالحروف الإنجليزية — زي CASH أو VODAFONE-CASH</div>
                        </div>
                        <span class="fc-fsec-ic"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" /></span>
                    </div>

                    @if (_msg is not null)
                    {
                        <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined"
                                  Class="mb-4">@_msg</MudAlert>
                    }

                    <div class="fc-form-grid">
                        <div class="fc-fld">
                            <div class="fc-fld-lb">الكود<i>*</i></div>
                            <input class="fc-sel fc-sel-lg" @bind="_f.Code" maxlength="30" dir="ltr"
                                   disabled="@(_editId is not null && _f.UsageCount > 0)" />
                            @if (_editId is not null && _f.UsageCount > 0)
                            {
                                <div class="fc-fld-hint">مقفل — مستخدم في @_f.UsageCount حركة</div>
                            }
                        </div>
                        <div class="fc-fld">
                            <div class="fc-fld-lb">الاسم بالعربي<i>*</i></div>
                            <input class="fc-sel fc-sel-lg" @bind="_f.NameAr" maxlength="100" />
                        </div>
                        <div class="fc-fld">
                            <div class="fc-fld-lb">الاسم بالإنجليزي</div>
                            <input class="fc-sel fc-sel-lg" @bind="_f.NameEn" maxlength="100" />
                        </div>
                        <div class="fc-fld">
                            <div class="fc-fld-lb">الترتيب في القوائم</div>
                            <input type="number" class="fc-sel fc-sel-lg" value="@_f.SortOrder"
                                   @onchange="e => _f.SortOrder = (int)ParseLong(e.Value)" />
                            <div class="fc-fld-hint">الرقم الأصغر يطلع الأول</div>
                        </div>
                        <div class="fc-fld">
                            <div class="fc-fld-lb">تدخل الخزينة؟</div>
                            <select class="fc-sel fc-sel-lg" @bind="_f.IsCashBased"
                                    disabled="@(_editId is not null && _f.UsageCount > 0)">
                                <option value="true">أيوه — فلوس بتدخل/تخرج من الدرج</option>
                                <option value="false">لأ — شيك أو تحويل أو بطاقة</option>
                            </select>
                            @if (_editId is not null && _f.UsageCount > 0)
                            {
                                <div class="fc-fld-hint">مقفل — تغييره يبوّظ رصيد الدرج</div>
                            }
                        </div>
                        <div class="fc-fld">
                            <div class="fc-fld-lb">الخيارات</div>
                            <div class="fc-active-toggle">
                                <MudCheckBox T="bool" @bind-Value="_f.RequiresChequeNo" Color="Color.Primary"
                                             Label="يطلب رقم شيك / مرجع" />
                                <MudCheckBox T="bool" @bind-Value="_f.IsActive" Color="Color.Secondary"
                                             Label="نشطة" />
                            </div>
                        </div>
                    </div>

                    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px">
                        @if (_editId is not null)
                        {
                            <MudButton Variant="Variant.Text" OnClick="ResetForm">إلغاء التعديل</MudButton>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">حفظ</MudButton>
                    </div>
                </div>
            }

            @* ══════════ الجدول ══════════ *@
            <div class="fc-fsec" style="margin-top:26px">
                <div class="fc-fsec-head">
                    <span class="fc-fsec-n">2</span>
                    <div>
                        <div class="fc-fsec-t">الطرق الموجودة</div>
                        <div class="fc-fsec-d">مرتبة حسب الترتيب</div>
                    </div>
                </div>

                <div class="fc-table-wrap"><table class="fc-table">
                    <thead><tr>
                        <th>الكود</th><th>الاسم</th><th>الخزينة</th>
                        <th>رقم شيك</th><th>الترتيب</th><th>استخدام</th><th style="width:110px"></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var m in _items)
                        {
                            <tr>
                                <td><span class="fc-role-chip">@m.Code</span></td>
                                <td class="fc-cell-main">
                                    @m.NameAr
                                    @if (!m.IsActive)
                                    {
                                        <span class="fc-chip fc-chip-gray">معطّلة</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(m.NameEn))
                                    {
                                        <div class="fc-cell-sub">@m.NameEn</div>
                                    }
                                </td>
                                <td>
                                    @if (m.IsCashBased)
                                    {
                                        <span class="fc-chip fc-chip-ok">تدخل الخزينة</span>
                                    }
                                    else
                                    {
                                        <span class="fc-chip fc-chip-gray">خارج الخزينة</span>
                                    }
                                </td>
                                <td>@(m.RequiresChequeNo ? "مطلوب" : "—")</td>
                                <td>@m.SortOrder</td>
                                <td>@m.UsageCount</td>
                                <td>
                                    @if (CanManage)
                                    {
                                        <div class="fc-row-actions">
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary" title="تعديل" OnClick="() => Edit(m)" />
                                            @if (m.IsActive)
                                            {
                                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                                               Color="Color.Error" title="تعطيل" OnClick="() => ToggleAsync(m, false)" />
                                            }
                                            else
                                            {
                                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle"
                                                               Color="Color.Success" title="تفعيل" OnClick="() => ToggleAsync(m, true)" />
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                        @if (_items.Count == 0)
                        {
                            <tr><td colspan="7"><div class="fc-empty">مافيش طرق دفع — ضيف أول طريقة</div></td></tr>
                        }
                    </tbody>
                </table></div>
            </div>

        </div></div>
    }
</div>

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("MASTERDATA.VIEW") ?? false;
    private bool CanManage => _user?.Can("MASTERDATA.MANAGE") ?? false;

    private List<Item> _items = new();
    private bool _saving;
    private string? _msg; private bool _ok = true;
    private int? _editId;
    private Form _f = new();

    /// <summary>مطابق لـ <c>PaymentMethodsController.ListItem</c> — 9 حقول.</summary>
    public class Item
    {
        public int PaymentMethodId { get; set; }
        public string Code { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string? NameEn { get; set; }
        public bool RequiresChequeNo { get; set; }
        public bool IsCashBased { get; set; }
        public int SortOrder { get; set; }
        public bool IsActive { get; set; }
        public int UsageCount { get; set; }
    }

    /// <summary>مطابق لـ <c>PaymentMethodsController.Upsert</c> — 7 حقول.</summary>
    public class Form
    {
        public string Code { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string? NameEn { get; set; }
        public bool RequiresChequeNo { get; set; }
        public bool IsCashBased { get; set; } = true;
        public int SortOrder { get; set; } = 100;
        public bool IsActive { get; set; } = true;
        /* مش بتتبعت للسيرفر — للـ UI بس (قفل الحقول) */
        public int UsageCount { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/master/payment-methods") ?? new(); }
        catch (Exception ex) { _ok = false; _msg = "فشل التحميل: " + ex.Message; }
    }

    private void ResetForm()
    {
        _editId = null;
        _f = new Form();
        _msg = null;
    }

    private void Edit(Item m)
    {
        _editId = m.PaymentMethodId;
        _f = new Form
        {
            Code             = m.Code,
            NameAr           = m.NameAr,
            NameEn           = m.NameEn,
            RequiresChequeNo = m.RequiresChequeNo,
            IsCashBased      = m.IsCashBased,
            SortOrder        = m.SortOrder,
            IsActive         = m.IsActive,
            UsageCount       = m.UsageCount
        };
        _msg = null;
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        if (string.IsNullOrWhiteSpace(_f.Code))   { _ok = false; _msg = "الكود مطلوب"; return; }
        if (string.IsNullOrWhiteSpace(_f.NameAr)) { _ok = false; _msg = "الاسم بالعربي مطلوب"; return; }

        _saving = true; _msg = null;
        try
        {
            var payload = new
            {
                code             = _f.Code,
                nameAr           = _f.NameAr,
                nameEn           = _f.NameEn,
                requiresChequeNo = _f.RequiresChequeNo,
                isCashBased      = _f.IsCashBased,
                sortOrder        = _f.SortOrder,
                isActive         = _f.IsActive
            };

            var res = _editId is null
                ? await Http.PostAsJsonAsync("api/master/payment-methods", payload)
                : await Http.PutAsJsonAsync($"api/master/payment-methods/{_editId}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { ResetForm(); await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task ToggleAsync(Item m, bool activate)
    {
        try
        {
            var url = $"api/master/payment-methods/{m.PaymentMethodId}/" + (activate ? "activate" : "deactivate");
            var res = await Http.PostAsync(url, null);
            var msg = await MsgOf(res);
            _ok = res.IsSuccessStatusCode; _msg = msg;
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
    }

    private static long ParseLong(object? v) => long.TryParse(v?.ToString(), out var n) ? n : 0;

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "✅ تم" : "حصل خطأ — حاول تاني"; }
    }
}
