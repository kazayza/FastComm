@code {
    [Parameter] public long? Id { get; set; }
    private long?  _id;
    private string ExpenseNumber  = "";
    private string _paymentStatus = "Unpaid";
    private bool   _cancelled;
    private int    _activeTab;
    private bool   _triedSave;

    private AuthUser? _user;
    private bool CanCreate => _user?.Can("EXPENSE.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("EXPENSE.EDIT")   ?? false;
    private bool CanSave   => _id is null ? CanCreate : CanEdit;

    private bool    _loading; private bool _saving;
    private string? _msg;     private bool _ok = true;

    private List<ExpType>    _types      = new();
    private List<TaxOpt>     _taxRates   = new();
    private List<MethodOpt>  _methods    = new();
    private List<Opt>        _suppliers  = new();
    private List<Opt>        _drivers    = new();
    private List<OpOpt>      _operations = new();
    private List<TripOpt>    _trips      = new();
    private List<CustodyOpt> _custodies  = new();

    private bool _isApproved;
    private Form _f = new();

    /* ── Validation ── */
    private bool HasTabError(int tab) => _triedSave && tab switch
    {
        1 => _f.ExpenseTypeId <= 0 || _f.Amount <= 0,
        _ => false
    };

    /* ── Treasury Status ── */
    private bool _stApproved  => _isApproved;
    private bool _stPaid      => _paymentStatus != "Unpaid";
    private bool _stNoCustody => _f.CustodyId is null;
    private bool _stCash      => CurrentMethod?.IsCashBased == true;
    private bool _willTreasury => _stApproved && _stPaid && _stNoCustody && _stCash;

    private ExpType?   CurrentType   => _types.FirstOrDefault(t => t.Id == _f.ExpenseTypeId);
    private MethodOpt? CurrentMethod => _methods.FirstOrDefault(m => m.Id == _f.PaymentMethodId);

    private bool IsOperationCost => CurrentType?.IsOperationCost ?? true;

    private string TypeHint => CurrentType is null ? ""
        : CurrentType.IsOperationCost
            ? "مصروف تشغيلي — بيتحمل على عملية، ولازم يتربط بواحدة"
            : "مصروف إداري — بيتحمل على الشركة، ومش محتاج ربط";

    private string LinkHint => IsOperationCost
        ? "مصروف تشغيلي — اربطه بالعملية أو الرحلة اللي اتصرف عليها"
        : "مصروف إداري — الربط اختياري";

    private decimal TotalWithTax
    {
        get
        {
            var rate = _taxRates.FirstOrDefault(t => t.Id == _f.TaxRateId)?.Value ?? 0m;
            return _f.Amount + (_f.Amount * rate / 100m);
        }
    }

    private string TreasuryReason
    {
        get
        {
            if (_f.CustodyId is not null) return "المصروف مربوط بعهدة — فلوسه اتصرفت وقت صرف العهدة، مش هيتحسب مرتين.";
            if (!_stApproved) return "لسه ما اتعتمدش — اعتمده من صفحة المصروفات.";
            if (!_stPaid)     return "لسه ما اتعلّمش مدفوع — علّمه مدفوع من صفحة المصروفات.";
            if (!_stCash)     return _f.PaymentMethodId is null
                ? "حدد طريقة الدفع الأول."
                : $"«{(CurrentMethod?.Label ?? "")}» مش طريقة نقدية — الفلوس مش في الدرج.";
            return "هيتسجل في الخزينة تلقائياً.";
        }
    }

    /* ── DTOs ── */
    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }
    public class TaxOpt    { public int Id { get; set; } public string Label { get; set; } = ""; public decimal Value { get; set; } }
    public class MethodOpt { public int Id { get; set; } public string Label { get; set; } = ""; public bool IsCashBased { get; set; } }
    public class ExpType   { public int Id { get; set; } public string Label { get; set; } = ""; public bool IsOperationCost { get; set; } public bool IsTaxDeductible { get; set; } }
    public class OpOpt     { public long OperationId { get; set; } public string OperationNumber { get; set; } = ""; public string CustomerName { get; set; } = ""; }
    public class TripOpt   { public long TripId { get; set; } public string TripNumber { get; set; } = ""; public string DriverName { get; set; } = ""; }
    public class CustodyOpt { public long Id { get; set; } public string Label { get; set; } = ""; public int OwnerId { get; set; } public string OwnerType { get; set; } = ""; public long? TripId { get; set; } }

    public class Form
    {
        public int     ExpenseTypeId    { get; set; }
        public string? ExpenseDate      { get; set; }
        public string? Description      { get; set; }
        public decimal Amount           { get; set; }
        public long?   OperationId      { get; set; }
        public long?   TripId           { get; set; }
        public int?    DriverId         { get; set; }
        public int?    SupplierId       { get; set; }
        public long?   CustodyId        { get; set; }
        public int?    TaxRateId        { get; set; }
        public bool?   IsTaxDeductible  { get; set; }
        public string? ReferenceNumber  { get; set; }
        public string? Notes            { get; set; }
        public int?    PaymentMethodId  { get; set; }
    }

    public class Detail
    {
        public long    ExpenseId        { get; set; }
        public string  ExpenseNumber    { get; set; } = "";
        public int     ExpenseTypeId    { get; set; }
        public string? ExpenseDate      { get; set; }
        public string? Description      { get; set; }
        public decimal Amount           { get; set; }
        public int?    TaxRateId        { get; set; }
        public bool    IsTaxDeductible  { get; set; }
        public long?   OperationId      { get; set; }
        public long?   TripId           { get; set; }
        public int?    DriverId         { get; set; }
        public int?    SupplierId       { get; set; }
        public long?   CustodyId        { get; set; }
        public string? ReferenceNumber  { get; set; }
        public string? Notes            { get; set; }
        public string  PaymentStatus    { get; set; } = "";
        public string  Status           { get; set; } = "";
        public bool    IsApproved       { get; set; }
        public decimal TaxRate          { get; set; }
        public int?    PaymentMethodId  { get; set; }
        public string? MethodName       { get; set; }
    }

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id   = Id;
        if (!CanSave) return;

        _loading = true;
        try
        {
            _types      = await SafeGetT<ExpType>("api/options/expense-types");
            _taxRates   = await SafeGetT<TaxOpt>("api/options/tax-rates");
            _methods    = await SafeGetT<MethodOpt>("api/options/payment-methods");
            _suppliers  = await SafeGetT<Opt>("api/options/suppliers");
            _drivers    = await SafeGetT<Opt>("api/options/drivers");
            _operations = await SafeGetT<OpOpt>("api/operations?take=200");
            _trips      = await SafeGetT<TripOpt>("api/trips?take=200");

            if (_id is not null) await LoadAsync(_id.Value);
            else NewDefaults();
        }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; _ok = false; }
        finally { _loading = false; }
    }

    private void NewDefaults()
    {
        _f = new Form
        {
            ExpenseTypeId = _types.FirstOrDefault()?.Id ?? 0,
            ExpenseDate   = DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
        };
        _f.IsTaxDeductible = CurrentType?.IsTaxDeductible;
    }

    private async Task LoadAsync(long id)
    {
        var d = await Http.GetFromJsonAsync<Detail>($"api/expenses/{id}");
        if (d is null) { _msg = "المصروف غير موجود"; _ok = false; return; }

        ExpenseNumber  = d.ExpenseNumber;
        _paymentStatus = d.PaymentStatus;
        _isApproved    = d.IsApproved;
        _cancelled     = d.Status == "Cancelled";

        _f = new Form
        {
            ExpenseTypeId   = d.ExpenseTypeId,
            ExpenseDate     = d.ExpenseDate,
            Description     = d.Description,
            Amount          = d.Amount,
            OperationId     = d.OperationId,
            TripId          = d.TripId,
            DriverId        = d.DriverId,
            SupplierId      = d.SupplierId,
            CustodyId       = d.CustodyId,
            TaxRateId       = d.TaxRateId,
            IsTaxDeductible = d.IsTaxDeductible,
            ReferenceNumber = d.ReferenceNumber,
            Notes           = d.Notes,
            PaymentMethodId = d.PaymentMethodId
        };

        await LoadCustodiesAsync();
    }

    /* ── Handlers ── */
    private void OnTypeChanged(ChangeEventArgs e)
    {
        _f.ExpenseTypeId = int.TryParse(e.Value?.ToString(), out var n) ? n : 0;
        var t = CurrentType;
        if (t is not null && !t.IsOperationCost)
        {
            _f.OperationId = null;
            _f.TripId      = null;
            _f.CustodyId   = null;
        }
        _f.IsTaxDeductible = t?.IsTaxDeductible;
    }

    private void OnTripChanged(ChangeEventArgs e)
    {
        _f.TripId    = long.TryParse(e.Value?.ToString(), out var t) && t > 0 ? t : null;
        _f.CustodyId = null;
        _ = LoadCustodiesAsync();
    }

    private void OnCustodyChanged(ChangeEventArgs e)
    {
        var id = long.TryParse(e.Value?.ToString(), out var c) && c > 0 ? c : (long?)null;
        _f.CustodyId = id;
        if (id is null) return;
        var cus = _custodies.FirstOrDefault(x => x.Id == id);
        if (cus is null) return;
        _f.TripId ??= cus.TripId;
        if (cus.OwnerType == "Driver") _f.DriverId ??= cus.OwnerId;
    }

    private async Task LoadCustodiesAsync()
    {
        _custodies = _f.TripId is null
            ? new()
            : await SafeGetT<CustodyOpt>($"api/options/custodies?tripId={_f.TripId}");
    }

    /* ── Save ── */
    private async Task SaveAsync(bool asDraft)
    {
        if (_saving) return;
        _triedSave = true;
        _saving    = true;
        _msg       = null;

        try
        {
            if (_f.ExpenseTypeId <= 0)
            { _ok = false; _msg = "اختار نوع المصروف"; _activeTab = 0; return; }

            if (_f.Amount <= 0)
            { _ok = false; _msg = "المبلغ لازم يكون أكتر من صفر"; _activeTab = 0; return; }

            if (IsOperationCost &&
                _f.OperationId is null && _f.TripId is null && _f.SupplierId is null)
            {
                _ok = false;
                _msg = "المصروف التشغيلي لازم يتربط بعملية أو رحلة أو مورد";
                _activeTab = 2;
                return;
            }

            var payload = new
            {
                expenseTypeId   = _f.ExpenseTypeId,
                expenseDate     = _f.ExpenseDate,
                description     = _f.Description,
                amount          = _f.Amount,
                operationId     = _f.OperationId,
                tripId          = _f.TripId,
                driverId        = _f.DriverId,
                supplierId      = _f.SupplierId,
                custodyId       = _f.CustodyId,
                taxRateId       = _f.TaxRateId,
                isTaxDeductible = _f.IsTaxDeductible,
                referenceNumber = _f.ReferenceNumber,
                notes           = _f.Notes,
                paymentMethodId = _f.PaymentMethodId,
                asDraft         = asDraft
            };

            var res = _id is null
                ? await Http.PostAsJsonAsync("api/expenses", payload)
                : await Http.PutAsJsonAsync($"api/expenses/{_id}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    /* ── Helpers ── */
    private void GoBack() => Nav.NavigateTo("/expenses");

    private static decimal ParseAmount(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n > 0 ? n : 0m;

    private static string Money(decimal v) => v.ToString("N2");

    private static string PayAr(string p) => p switch
    {
        "Unpaid"        => "غير مدفوع",
        "PartiallyPaid" => "مدفوع جزئياً",
        "Paid"          => "مدفوع",
        _               => "غير مدفوع"
    };

    private static string PayStatusBadge(string p) => p switch
    {
        "Paid"          => "badge-paid",
        "PartiallyPaid" => "badge-partial",
        _               => "badge-unpaid"
    };

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم الحفظ" : "حصل خطأ — حاول تاني"; }
    }
}