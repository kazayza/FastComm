@page "/expenses/new"
@page "/expenses/new/{Id:long}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "مصروف جديد" : "تعديل مصروف") — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">

            <div>
                <div class="fc-crumb">المالية · المصروفات</div>
                <h1 class="fc-hero-title">
                    @if (_id is null)
                    {
                        <span>مصروف جديد</span>
                        <span class="ex-hero-badge badge-new">جديد</span>
                    }
                    else
                    {
                        <span>@ExpenseNumber</span>
                        <span class="ex-hero-badge @PayStatusBadge(_paymentStatus)">
                            @PayAr(_paymentStatus)
                        </span>
                    }
                </h1>
                <p class="fc-hero-sub">سجّل المصروف وحدد مين دفعه وإزاي — والنظام يقرر يدخل الخزينة ولا لأ</p>
            </div>

            <div class="fc-head-actions">
                <button class="ex-back-btn" @onclick="GoBack">
                    <svg viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    المصروفات
                </button>
                @if (CanSave)
                {
                    <button class="ex-draft-btn"
                            @onclick="() => SaveAsync(true)"
                            disabled="@_saving">
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M12 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M12 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                        <span>مسودة</span>
                    </button>
                    <button class="ex-save-btn"
                            @onclick="() => SaveAsync(false)"
                            disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ وتأكيد</span>
                        }
                    </button>
                }
            </div>

        </div>

        @* ── Treasury Status Strip ── *@
        @if (!_loading)
        {
            <div class="ex-treasury-strip">

                <div class="ex-treasury-checks">
                    <div class="ex-chk @(_stApproved ? "chk-on" : "chk-off")">
                        <div class="ex-chk-dot" aria-hidden="true"></div>
                        <span>معتمد</span>
                    </div>
                    <div class="ex-chk-arrow" aria-hidden="true">→</div>
                    <div class="ex-chk @(_stPaid ? "chk-on" : "chk-off")">
                        <div class="ex-chk-dot" aria-hidden="true"></div>
                        <span>اتدفع</span>
                    </div>
                    <div class="ex-chk-arrow" aria-hidden="true">→</div>
                    <div class="ex-chk @(_stNoCustody ? "chk-on" : "chk-off")">
                        <div class="ex-chk-dot" aria-hidden="true"></div>
                        <span>مش عهدة</span>
                    </div>
                    <div class="ex-chk-arrow" aria-hidden="true">→</div>
                    <div class="ex-chk @(_stCash ? "chk-on" : "chk-off")">
                        <div class="ex-chk-dot" aria-hidden="true"></div>
                        <span>نقدي</span>
                    </div>
                </div>

                <div class="ex-treasury-result @(_willTreasury ? "result-yes" : "result-no")">
                    @if (_willTreasury)
                    {
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>هيدخل الخزينة</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                        </svg>
                        <span>مش هيدخل الخزينة</span>
                    }
                </div>

            </div>
        }

    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="ex-body">

    @* No Permission *@
    @if (!CanSave)
    {
        <div class="ex-state-box">
            <div class="ex-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>@(_id is null ? "ليس لديك صلاحية تسجيل مصروف" : "ليس لديك صلاحية تعديل مصروف")</p>
            <button class="ex-state-back" @onclick="GoBack">العودة للقائمة</button>
        </div>
    }

    @* Loading *@
    else if (_loading)
    {
        <div class="ex-loading-wrap">
            <div class="ex-spinner" aria-label="جاري التحميل"></div>
            <div class="ex-loading-text">جاري تحميل بيانات المصروف...</div>
        </div>
    }

    @* Main Form *@
    else
    {
        @* Cancelled Banner *@
        @if (_cancelled)
        {
            <div class="ex-cancelled-banner" role="alert">
                <div class="cancelled-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="cancelled-text">
                    <strong>المصروف ملغي</strong>
                    <span>المصروف ده ملغي — مش هينفع تعدّله</span>
                </div>
            </div>
        }

        @* Error/Success Banner *@
        @if (_msg is not null)
        {
            <div class="ex-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                <div aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="banner-close" @onclick="() => _msg = null" aria-label="إغلاق التنبيه">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
                             stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
            </div>
        }

        @* Treasury Reason Card *@
        <div class="ex-treasury-card @(_willTreasury ? "treasury-yes" : "treasury-no")">
            <div class="treasury-card-icon" aria-hidden="true">
                @if (_willTreasury)
                {
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        <circle cx="12" cy="14" r="2"/>
                        <path d="M12 16v2" stroke-linecap="round"/>
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                    </svg>
                }
            </div>
            <div class="treasury-card-text">
                <strong>
                    @(_willTreasury
                        ? "المصروف ده هيتسجل في الخزينة"
                        : "المصروف ده مش هيدخل الخزينة")
                </strong>
                <span>@TreasuryReason</span>
            </div>
        </div>


        @* ═══════ TABS ═══════ *@
        <div class="ex-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="ex-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="ex-mud-tabs">


                @* ══════════════════════════════════════
                   TAB 1 — بيانات المصروف
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="etab-label">
                            <div class="etab-num">١</div>
                            <div class="etab-icon etab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <span>بيانات المصروف</span>
                            @if (HasTabError(1))
                            {
                                <span class="etab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon blue" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">بيانات المصروف</div>
                                    <div class="tab-section-sub">إيه المصروف · بكام · وإمتى</div>
                                </div>
                            </div>

                            <div class="ex-form-grid">

                                @* نوع المصروف *@
                                <div class="form-field">
                                    <label class="field-label">
                                        نوع المصروف
                                        <span class="field-required">*</span>
                                    </label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                            <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                                        </svg>
                                        <select class="field-input field-select @(_f.ExpenseTypeId <= 0 && _triedSave ? "field-error" : "")"
                                                value="@_f.ExpenseTypeId"
                                                @onchange="OnTypeChanged"
                                                aria-required="true">
                                            @foreach (var t in _types)
                                            {
                                                <option value="@t.Id">@t.Label</option>
                                            }
                                        </select>
                                    </div>
                                    @if (CurrentType is not null)
                                    {
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            @TypeHint
                                        </div>
                                    }
                                    @if (_f.ExpenseTypeId <= 0 && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">اختيار نوع المصروف مطلوب</div>
                                    }
                                </div>

                                @* المبلغ *@
                                <div class="form-field">
                                    <label class="field-label">
                                        المبلغ
                                        <span class="field-required">*</span>
                                    </label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                        <input type="number" min="0.01" step="0.01"
                                               class="field-input with-prefix @(_f.Amount <= 0 && _triedSave ? "field-error" : "")"
                                               value="@_f.Amount"
                                               placeholder="0.00"
                                               @onchange="e => _f.Amount = ParseAmount(e.Value)"
                                               aria-required="true" />
                                    </div>
                                    @if (_f.Amount <= 0 && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">المبلغ لازم يكون أكتر من صفر</div>
                                    }
                                </div>

                                @* التاريخ *@
                                <div class="form-field">
                                    <label class="field-label">التاريخ</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input type="datetime-local"
                                               class="field-input with-prefix"
                                               value="@_f.ExpenseDate"
                                               @onchange="e => _f.ExpenseDate = e.Value?.ToString()" />
                                    </div>
                                </div>

                                @* رقم مرجعي *@
                                <div class="form-field">
                                    <label class="field-label">رقم مرجعي</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M4 7V4h16v3M9 20h6M12 4v16" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input class="field-input with-prefix"
                                               @bind="_f.ReferenceNumber"
                                               maxlength="100"
                                               placeholder="رقم الإيصال أو الفاتورة" />
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        رقم الإيصال أو فاتورة المورد
                                    </div>
                                </div>

                                @* البيان *@
                                <div class="form-field form-field-full">
                                    <label class="field-label">البيان</label>
                                    <input class="field-input"
                                           @bind="_f.Description"
                                           maxlength="500"
                                           placeholder="وصف مختصر للمصروف..." />
                                </div>

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 2 — المحاسبة والدفع
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="etab-label">
                            <div class="etab-num">٢</div>
                            <div class="etab-icon etab-green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="4" width="22" height="16" rx="2"/>
                                    <path d="M1 10h22"/>
                                </svg>
                            </div>
                            <span>المحاسبة والدفع</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon green" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="4" width="22" height="16" rx="2"/>
                                        <path d="M1 10h22"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">المحاسبة والدفع</div>
                                    <div class="tab-section-sub">الضريبة · طريقة الدفع اللي بتحدد دخول الخزينة</div>
                                </div>
                            </div>

                            <div class="ex-form-grid">

                                @* الضريبة *@
                                <div class="form-field">
                                    <label class="field-label">الضريبة</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M20 12V22H4V12M22 7H2v5h20V7zM12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
                                        </svg>
                                        <select class="field-input field-select" @bind="_f.TaxRateId">
                                            <option value="">بدون ضريبة</option>
                                            @foreach (var t in _taxRates)
                                            {
                                                <option value="@t.Id">@t.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                @* قابلة للخصم *@
                                <div class="form-field">
                                    <label class="field-label">الضريبة قابلة للخصم</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <select class="field-input field-select" @bind="_f.IsTaxDeductible">
                                            <option value="true">أيوه — تُخصم</option>
                                            <option value="false">لأ — ضريبة جدول</option>
                                        </select>
                                    </div>
                                </div>

                                @* طريقة الدفع *@
                                <div class="form-field">
                                    <label class="field-label">طريقة الدفع</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <rect x="1" y="4" width="22" height="16" rx="2"/>
                                            <path d="M1 10h22"/>
                                        </svg>
                                        <select class="field-input field-select" @bind="_f.PaymentMethodId">
                                            <option value="">— لسه ما اتحددش —</option>
                                            @foreach (var m in _methods)
                                            {
                                                <option value="@m.Id">@m.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        النقدي بيدخل الخزينة تلقائياً · التحويل والبطاقة لأ
                                    </div>
                                </div>

                                @* الإجمالي *@
                                @if (_f.Amount > 0 && _f.TaxRateId is not null)
                                {
                                    <div class="form-field">
                                        <label class="field-label">الإجمالي بعد الضريبة</label>
                                        <div class="ex-total-display">
                                            <span class="ex-total-num">@Money(TotalWithTax)</span>
                                            <span class="ex-total-curr">ج.م</span>
                                        </div>
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            المبلغ + الضريبة المحسوبة تلقائياً
                                        </div>
                                    </div>
                                }

                            </div>

                            @* Payment Method Visual *@
                            @if (CurrentMethod is not null)
                            {
                                <div class="ex-method-card @(CurrentMethod.IsCashBased ? "method-cash" : "method-noncash")">
                                    <div class="method-card-icon" aria-hidden="true">
                                        @if (CurrentMethod.IsCashBased)
                                        {
                                            <svg viewBox="0 0 24 24" width="20" height="20"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                                <circle cx="12" cy="14" r="2"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" width="20" height="20"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="1" y="4" width="22" height="16" rx="2"/>
                                                <path d="M1 10h22"/>
                                            </svg>
                                        }
                                    </div>
                                    <div class="method-card-text">
                                        <strong>@CurrentMethod.Label</strong>
                                        <span>
                                            @(CurrentMethod.IsCashBased
                                                ? "طريقة نقدية — المصروف هيدخل الخزينة لو باقي الشروط اتحققت"
                                                : "طريقة غير نقدية — المصروف مش هيدخل الخزينة حتى لو اتأكد")
                                        </span>
                                    </div>
                                </div>
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 3 — الربط
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="etab-label">
                            <div class="etab-num">٣</div>
                            <div class="etab-icon etab-amber" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                                    <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
                                </svg>
                            </div>
                            <span>الربط</span>
                            @if (IsOperationCost)
                            {
                                <span class="etab-required-badge">مطلوب</span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon amber" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                                        <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">الربط</div>
                                    <div class="tab-section-sub">@LinkHint</div>
                                </div>
                            </div>

                            @if (IsOperationCost)
                            {
                                <div class="ex-form-grid">

                                    @* العملية *@
                                    <div class="form-field">
                                        <label class="field-label">العملية</label>
                                        <div class="field-select-wrap">
                                            <svg class="field-select-icon" viewBox="0 0 24 24"
                                                 width="14" height="14" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                            </svg>
                                            <select class="field-input field-select" @bind="_f.OperationId">
                                                <option value="">—</option>
                                                @foreach (var o in _operations)
                                                {
                                                    <option value="@o.OperationId">
                                                        @o.OperationNumber — @o.CustomerName
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            مصروف تشغيلي — لازم يتربط عشان يدخل في تكلفة العملية
                                        </div>
                                    </div>

                                    @* الرحلة *@
                                    <div class="form-field">
                                        <label class="field-label">الرحلة</label>
                                        <div class="field-select-wrap">
                                            <svg class="field-select-icon" viewBox="0 0 24 24"
                                                 width="14" height="14" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <rect x="1" y="3" width="15" height="13" rx="2"/>
                                                <path d="M16 8h4l3 3v5h-7V8z"/>
                                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                                <circle cx="18.5" cy="18.5" r="2.5"/>
                                            </svg>
                                            <select class="field-input field-select"
                                                    value="@_f.TripId"
                                                    @onchange="OnTripChanged">
                                                <option value="">—</option>
                                                @foreach (var t in _trips)
                                                {
                                                    <option value="@t.TripId">
                                                        @t.TripNumber — @t.DriverName
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    @* العهدة *@
                                    <div class="form-field">
                                        <label class="field-label">العهدة</label>
                                        @if (_f.TripId is null)
                                        {
                                            <div class="ex-custody-hint">
                                                <svg viewBox="0 0 16 16" width="12" height="12"
                                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                                     aria-hidden="true">
                                                    <circle cx="8" cy="8" r="6"/>
                                                    <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                                </svg>
                                                اختار الرحلة أولاً لعرض العهد
                                            </div>
                                        }
                                        else if (!_custodies.Any())
                                        {
                                            <div class="ex-custody-hint">
                                                مافيش عهد مفتوحة على الرحلة دي
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="field-select-wrap">
                                                <svg class="field-select-icon" viewBox="0 0 24 24"
                                                     width="14" height="14" fill="none"
                                                     stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                    <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                                </svg>
                                                <select class="field-input field-select"
                                                        value="@_f.CustodyId"
                                                        @onchange="OnCustodyChanged">
                                                    <option value="">— بدون عهدة —</option>
                                                    @foreach (var c in _custodies)
                                                    {
                                                        <option value="@c.Id">@c.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            اللي من عهدة فلوسه اتصرفت — مش هيتحسب تاني
                                        </div>
                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="ex-admin-info">
                                    <div class="admin-info-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="22" height="22"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                            <path d="M9 22V12h6v10"/>
                                        </svg>
                                    </div>
                                    <div class="admin-info-text">
                                        <strong>ده مصروف إداري — مش محتاج ربط</strong>
                                        <p>
                                            بيتحمل على الشركة كلها، ومش بيدخل في تكلفة أي عملية.
                                            اختياريًا تقدر تربطه بمورد من التبويب التالي.
                                        </p>
                                    </div>
                                </div>
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 4 — الجهة والسائق
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="etab-label">
                            <div class="etab-num">٤</div>
                            <div class="etab-icon etab-purple" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                </svg>
                            </div>
                            <span>الجهة والملاحظات</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon purple" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">الجهة والسائق</div>
                                    <div class="tab-section-sub">مين اللي اتدفع له · ومين اللي صرف</div>
                                </div>
                            </div>

                            <div class="ex-form-grid">

                                @* المورد *@
                                <div class="form-field">
                                    <label class="field-label">المورد</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                            <path d="M9 22V12h6v10"/>
                                        </svg>
                                        <select class="field-input field-select" @bind="_f.SupplierId">
                                            <option value="">—</option>
                                            @foreach (var s in _suppliers)
                                            {
                                                <option value="@s.Id">@s.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                @* السائق *@
                                <div class="form-field">
                                    <label class="field-label">السائق</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        <select class="field-input field-select" @bind="_f.DriverId">
                                            <option value="">—</option>
                                            @foreach (var d in _drivers)
                                            {
                                                <option value="@d.Id">@d.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                @* ملاحظات *@
                                <div class="form-field form-field-full">
                                    <label class="field-label">ملاحظات</label>
                                    <textarea class="field-input field-textarea"
                                              rows="4"
                                              maxlength="500"
                                              placeholder="أي ملاحظات إضافية..."
                                              @onchange="e => _f.Notes = e.Value?.ToString()">@_f.Notes</textarea>
                                </div>

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


            </MudTabs>
        </div>


        @* ── Bottom Actions ── *@
        <div class="ex-bottom-actions">

            <button class="ex-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للقائمة
            </button>

            @if (CanSave)
            {
                <div class="ex-bottom-right">

                    @if (_activeTab < 3)
                    {
                        <button class="ex-next-btn" @onclick="() => _activeTab++">
                            التالي
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    }

                    <button class="ex-draft-bottom-btn"
                            @onclick="() => SaveAsync(true)"
                            disabled="@_saving">
                        <svg viewBox="0 0 24 24" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M12 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M12 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                        حفظ كمسودة
                    </button>

                    <button class="ex-confirm-btn"
                            @onclick="() => SaveAsync(false)"
                            disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ وتأكيد</span>
                        }
                    </button>

                </div>
            }

        </div>

    }
</div>


@* ═══════════════════════════════════════════
   CSS
═══════════════════════════════════════════ *@
<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       HERO ADDITIONS
    ================================================================ */
    .ex-hero-badge {
        display: inline-flex; align-items: center;
        padding: 3px 10px; border-radius: 20px;
        font-size: 11px; font-weight: 800;
    }

    .badge-new     { background: rgba(34,197,94,.2);  color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-unpaid  { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); border: 1px solid rgba(255,255,255,.2); }
    .badge-partial { background: rgba(234,179,8,.25); color: #fde68a; border: 1px solid rgba(234,179,8,.3); }
    .badge-paid    { background: rgba(34,197,94,.25); color: #86efac; border: 1px solid rgba(34,197,94,.3); }

    /* Treasury Strip */
    .ex-treasury-strip {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; flex-wrap: wrap;
        padding: 10px 14px;
        background: rgba(0,0,0,.12); border: 1px solid rgba(255,255,255,.10);
        border-radius: 10px; backdrop-filter: blur(8px);
        margin-top: 4px;
    }

    .ex-treasury-checks { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    .ex-chk {
        display: flex; align-items: center; gap: 5px;
        font-size: 10.5px; font-weight: 700;
    }

    .ex-chk-dot {
        width: 8px; height: 8px; border-radius: 50%; flex: 0 0 8px;
        border: 2px solid;
        transition: all .2s ease;
    }

    .chk-on  { color: #6ee7b7; }
    .chk-on .ex-chk-dot { background: #6ee7b7; border-color: #6ee7b7; }
    .chk-off { color: rgba(255,255,255,.35); }
    .chk-off .ex-chk-dot { background: transparent; border-color: rgba(255,255,255,.25); }

    .ex-chk-arrow { color: rgba(255,255,255,.2); font-size: 12px; font-weight: 700; }

    .ex-treasury-result {
        display: flex; align-items: center; gap: 6px;
        padding: 5px 12px; border-radius: 8px;
        font-size: 11px; font-weight: 800; white-space: nowrap;
    }

    .result-yes { background: rgba(34,197,94,.2); color: #6ee7b7; border: 1px solid rgba(34,197,94,.25); }
    .result-no  { background: rgba(255,255,255,.08); color: rgba(255,255,255,.55); border: 1px solid rgba(255,255,255,.12); }

    /* Hero Buttons */
    .ex-back-btn {
        display: inline-flex; align-items: center; gap: 5px;
        height: 36px; padding: 0 13px;
        border: 1px solid rgba(255,255,255,.2); border-radius: 9px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .ex-back-btn:hover { background: rgba(255,255,255,.14); }
    .ex-back-btn svg  { transform: rotate(180deg); }

    .ex-draft-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 14px;
        border: 1px solid rgba(255,255,255,.20); border-radius: 9px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .ex-draft-btn:hover:not(:disabled) { background: rgba(255,255,255,.14); }
    .ex-draft-btn:disabled { opacity: .5; cursor: not-allowed; }

    .ex-save-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 18px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .ex-save-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }
    .ex-save-btn:disabled { opacity: .6; cursor: not-allowed; }

    /* ================================================================
       BODY
    ================================================================ */
    .ex-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 180px);
        padding: 16px 20px 32px;
        max-width: 1050px; width: 100%;
        margin: 0 auto;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* ================================================================
       STATES
    ================================================================ */
    .ex-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 280px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .ex-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .ex-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .ex-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .ex-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    .ex-state-back {
        margin-top: 8px; padding: 9px 20px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-text);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .ex-state-back:hover { background: #f0f4fa; }

    /* ================================================================
       LOADING
    ================================================================ */
    .ex-loading-wrap {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 14px; min-height: 260px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .ex-spinner {
        width: 36px; height: 36px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: ex-spin .75s linear infinite;
    }
    @@keyframes ex-spin { to { transform: rotate(360deg); } }
    .ex-loading-text { font-size: 13px; font-weight: 600; color: var(--fc-muted); }

    /* ================================================================
       BANNERS
    ================================================================ */
    .ex-cancelled-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px; border-radius: 12px;
        background: linear-gradient(135deg, #fff0f2, #ffe8ec);
        border: 1px solid #ffc8cf;
    }
    .cancelled-icon  { flex: 0 0 auto; color: var(--fc-red); }
    .cancelled-text  { display: flex; flex-direction: column; gap: 2px; }
    .cancelled-text strong { font-size: 13px; font-weight: 800; color: #b02040; }
    .cancelled-text span   { font-size: 11.5px; color: var(--fc-red); }

    .ex-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600;
        animation: ex-banner-in .25s ease;
    }
    @@keyframes ex-banner-in {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .banner-success { background: #e9f8f0; color: #0e7a43; border: 1px solid #b5e8d0; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); border: 1px solid #ffc8d0; }
    .banner-close {
        margin-right: auto; background: none; border: none;
        color: inherit; opacity: .6; cursor: pointer; font-size: 13px;
    }
    .banner-close:hover { opacity: 1; }

    /* Treasury Card */
    .ex-treasury-card {
        display: flex; align-items: flex-start; gap: 14px;
        padding: 14px 18px; border-radius: 12px;
        transition: all .2s ease;
    }
    .treasury-yes { background: var(--fc-green-lt); border: 1px solid #b0e0c5; }
    .treasury-no  { background: #fafbfe; border: 1px solid #e4eaf3; }

    .treasury-card-icon { flex: 0 0 auto; }
    .treasury-yes .treasury-card-icon { color: var(--fc-green); }
