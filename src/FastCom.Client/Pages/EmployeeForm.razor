@page "/employees/new"
@page "/employees/new/{Id:int}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "موظف جديد" : "تعديل موظف") — فاست كوم</PageTitle>


<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">

            <div>
                <div class="fc-crumb">البيانات الأساسية · الموظفون</div>
                <h1 class="fc-hero-title">
                    @if (_id is null)
                    {
                        <span>موظف جديد</span>
                        <span class="emp-hero-badge badge-new">جديد</span>
                    }
                    else
                    {
                        <span>@EmployeeCode</span>
                        <span class="emp-hero-badge @StatusHeroBadge(_f.EmploymentStatus)">
                            @StatusName(_f.EmploymentStatus)
                        </span>
                    }
                </h1>
                <p class="fc-hero-sub">سجّل بيانات الموظف — والكود بيتولد تلقائياً (EMP-)</p>
            </div>

            <div class="fc-head-actions">
                <button class="emp-back-btn" @onclick="GoBack">
                    <svg viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    الموظفين
                </button>
                @if (CanSave)
                {
                    <button class="emp-save-btn" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ الموظف</span>
                        }
                    </button>
                }
            </div>

        </div>
    </div>
</div>


<div class="empf-body">

    @if (!CanSave)
    {
        <div class="empf-state-box">
            <div class="empf-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>@(_id is null ? "ليس لديك صلاحية إضافة موظف" : "ليس لديك صلاحية تعديل موظف")</p>
            <button class="empf-state-back" @onclick="GoBack">العودة للقائمة</button>
        </div>
    }
    else if (_loading)
    {
        <div class="empf-loading-wrap">
            <div class="empf-spinner" aria-label="جاري التحميل"></div>
            <div class="empf-loading-text">جاري تحميل بيانات الموظف...</div>
        </div>
    }
    else
    {
        @if (_msg is not null)
        {
            <div class="empf-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                <div aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="banner-close" @onclick="() => _msg = null">✕</button>
            </div>
        }

        @if (_id is not null && _f.EmploymentStatus == "Terminated")
        {
            <div class="empf-terminated-banner" role="alert">
                <div class="term-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 8v4M12 16h.01" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="term-text">
                    <strong>الموظف منتهي الخدمة</strong>
                    <span>مش هيظهر في قوائم الاختيار — بس سجله وبياناته محفوظين</span>
                </div>
            </div>
        }

        <div class="empf-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="empf-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="empf-mud-tabs">


                @* ══════════════════════════════════════
                   TAB 1 — الهوية والبيانات الشخصية
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="etab-label">
                            <div class="etab-icon etab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <span>الهوية</span>
                            @if (HasTabError(1))
                            {
                                <span class="etab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="empf-tab-section">

                            @* ── البيانات الأساسية ── *@
                            <div class="empf-section-card">
                                <div class="empf-section-head">
                                    <div class="empf-section-icon icon-blue" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="empf-section-title">البيانات الشخصية</div>
                                        <div class="empf-section-sub">الاسم والهوية الوطنية</div>
                                    </div>
                                </div>

                                <div class="empf-form-grid">

                                    <div class="empf-field">
                                        <label class="empf-label">
                                            الاسم بالعربي
                                            <span class="empf-required">*</span>
                                        </label>
                                        <input class="empf-input @(string.IsNullOrWhiteSpace(_f.FullNameAr) && _triedSave ? "input-error" : "")"
                                               @bind="_f.FullNameAr"
                                               maxlength="150"
                                               placeholder="الاسم الكامل بالعربي"
                                               aria-required="true" />
                                        @if (string.IsNullOrWhiteSpace(_f.FullNameAr) && _triedSave)
                                        {
                                            <div class="empf-err-msg" role="alert">الاسم بالعربي مطلوب</div>
                                        }
                                    </div>

                                    <div class="empf-field">
                                        <label class="empf-label">الاسم بالإنجليزي</label>
                                        <input class="empf-input"
                                               @bind="_f.FullNameEn"
                                               maxlength="150"
                                               placeholder="Full Name in English"
                                               dir="ltr" />
                                    </div>

                                    <div class="empf-field">
                                        <label class="empf-label">الرقم القومي</label>
                                        <div class="empf-input-group">
                                            <span class="empf-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 16 16" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="1.7">
                                                    <rect x="2" y="4" width="12" height="9" rx="1"/>
                                                    <circle cx="6" cy="8" r="1.5"/>
                                                    <path d="M9 7h3M9 9.5h2" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input class="empf-input with-prefix"
                                                   @bind="_f.NationalId"
                                                   maxlength="14"
                                                   placeholder="14 رقم"
                                                   dir="ltr" />
                                        </div>
                                        <div class="empf-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            14 رقم — مطلوب للتأمينات
                                        </div>
                                    </div>

                                </div>
                            </div>


                            @* ── التواصل ── *@
                            <div class="empf-section-card">
                                <div class="empf-section-head">
                                    <div class="empf-section-icon icon-green" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-4.99-5 19.79 19.79 0 01-3.07-8.67A2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="empf-section-title">بيانات التواصل</div>
                                        <div class="empf-section-sub">الموبايل والبريد والعنوان</div>
                                    </div>
                                </div>

                                <div class="empf-form-grid">

                                    <div class="empf-field">
                                        <label class="empf-label">الموبايل</label>
                                        <div class="empf-input-group">
                                            <span class="empf-prefix" aria-hidden="true">📱</span>
                                            <input class="empf-input with-prefix"
                                                   @bind="_f.Mobile"
                                                   maxlength="20"
                                                   placeholder="01X-XXXXXXXX"
                                                   type="tel"
                                                   dir="ltr" />
                                        </div>
                                    </div>

                                    <div class="empf-field">
                                        <label class="empf-label">البريد الإلكتروني</label>
                                        <div class="empf-input-group">
                                            <span class="empf-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                                    <path d="M22 6l-10 7L2 6"/>
                                                </svg>
                                            </span>
                                            <input class="empf-input with-prefix"
                                                   @bind="_f.Email"
                                                   maxlength="150"
                                                   placeholder="employee@company.com"
                                                   type="email"
                                                   dir="ltr" />
                                        </div>
                                    </div>

                                    <div class="empf-field empf-field-full">
                                        <label class="empf-label">العنوان</label>
                                        <div class="empf-input-group">
                                            <span class="empf-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                                    <circle cx="12" cy="10" r="3"/>
                                                </svg>
                                            </span>
                                            <input class="empf-input with-prefix"
                                                   @bind="_f.Address"
                                                   maxlength="300"
                                                   placeholder="العنوان الكامل" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 2 — الوظيفة والتعيين
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="etab-label">
                            <div class="etab-icon etab-amber" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/>
                                    <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>
                                </svg>
                            </div>
                            <span>الوظيفة</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="empf-tab-section">

                            <div class="empf-section-card">
                                <div class="empf-section-head">
                                    <div class="empf-section-icon icon-amber" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/>
                                            <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="empf-section-title">بيانات الوظيفة</div>
                                        <div class="empf-section-sub">القسم والمسمى والمدير المباشر</div>
                                    </div>
                                </div>

                                <div class="empf-form-grid">

                                    @* تاريخ التعيين *@
                                    <div class="empf-field">
                                        <label class="empf-label">تاريخ التعيين</label>
                                        <div class="empf-input-group">
                                            <span class="empf-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                    <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input type="date"
                                                   class="empf-input with-prefix"
                                                   value="@_f.HireDate"
                                                   @onchange="OnHireDateChanged" />
                                        </div>
                                    </div>

                                    @* القسم *@
                                    <div class="empf-field">
                                        <label class="empf-label">القسم</label>
                                        <div class="empf-select-wrap">
                                            <svg class="empf-sel-icon" viewBox="0 0 24 24"
                                                 width="14" height="14" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                                <path d="M9 22V12h6v10"/>
                                            </svg>
                                            <select class="empf-input empf-select" @bind="_f.DepartmentId">
                                                <option value="">— بدون قسم —</option>
                                                @foreach (var d in _depts)
                                                {
                                                    <option value="@d.Id">@d.Label</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    @* المسمى الوظيفي *@
                                    <div class="empf-field">
                                        <label class="empf-label">المسمى الوظيفي</label>
                                        <div class="empf-select-wrap">
                                            <svg class="empf-sel-icon" viewBox="0 0 24 24"
                                                 width="14" height="14" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/>
                                                <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>
                                            </svg>
                                            <select class="empf-input empf-select" @bind="_f.JobTitleId">
                                                <option value="">— بدون مسمى —</option>
                                                @foreach (var j in _titles)
                                                {
                                                    <option value="@j.Id">@j.Label</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    @* المدير المباشر *@
                                    <div class="empf-field">
                                        <label class="empf-label">المدير المباشر</label>
                                        <div class="empf-select-wrap">
                                            <svg class="empf-sel-icon" viewBox="0 0 24 24"
                                                 width="14" height="14" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                                <circle cx="9" cy="7" r="4"/>
                                                <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                            </svg>
                                            <select class="empf-input empf-select" @bind="_f.ManagerEmployeeId">
                                                <option value="">— بدون مدير —</option>
                                                @foreach (var m in Managers)
                                                {
                                                    <option value="@m.EmployeeId">
                                                        @m.FullNameAr (@m.EmployeeCode)
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                </div>

                                @if (_depts.Count == 0 && _titles.Count == 0)
                                {
                                    <div class="empf-info-box">
                                        <svg viewBox="0 0 24 24" width="16" height="16"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"/>
                                            <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                        </svg>
                                        مافيش أقسام ومسميات؟ بتتضاف من قاعدة البيانات — النظام لسه مافيهش شاشة ليها
                                    </div>
                                }

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 3 — حالة الخدمة
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="etab-label">
                            <div class="etab-icon etab-green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                    <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <span>حالة الخدمة</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="empf-tab-section">

                            <div class="empf-section-card">
                                <div class="empf-section-head">
                                    <div class="empf-section-icon icon-green" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="empf-section-title">حالة الخدمة الوظيفية</div>
                                        <div class="empf-section-sub">نشط / إجازة / موقوف / منتهي الخدمة</div>
                                    </div>
                                </div>

                                @* Status Cards *@
                                <div class="empf-status-grid" role="group" aria-label="حالة الموظف">

                                    @foreach (var (val, lbl, sub, cls, icon) in new[]
                                    {
                                        ("Active",     "نشط",              "يعمل حالياً",           "status-green",  "✅"),
                                        ("OnLeave",    "في إجازة",         "غائب مؤقتاً",           "status-amber",  "🌴"),
                                        ("Suspended",  "موقوف",            "موقوف عن العمل",        "status-red",    "⛔"),
                                        ("Terminated", "منتهي الخدمة",    "انتهت علاقة العمل",     "status-gray",   "🚪"),
                                    })
                                    {
                                        var v = val;
                                        <button type="button"
                                                class="empf-status-card @(_f.EmploymentStatus == v ? cls + " status-selected" : "")"
                                                @onclick="() => _f.EmploymentStatus = v"
                                                aria-pressed="@(_f.EmploymentStatus == v)">
                                            <span class="status-card-icon">@icon</span>
                                            <div class="status-card-text">
                                                <span class="status-card-label">@lbl</span>
                                                <span class="status-card-sub">@sub</span>
                                            </div>
                                            @if (_f.EmploymentStatus == v)
                                            {
                                                <span class="status-card-check" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="16" height="16"
                                                         fill="none" stroke="currentColor" stroke-width="2.5">
                                                        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </span>
                                            }
                                        </button>
                                    }

                                </div>

                                @if (_f.EmploymentStatus == "Terminated" && _id is not null)
                                {
                                    <div class="empf-warn-box" role="alert" style="margin-top:16px">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                                            <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                                        </svg>
                                        <div>
                                            <strong>تنبيه</strong>
                                            <p>الموظف بحالة «منتهي الخدمة» مش هيظهر في قوائم الاختيار — بس بياناته محفوظين</p>
                                        </div>
                                    </div>
                                }

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


            </MudTabs>
        </div>


        @* Bottom Actions *@
        <div class="empf-bottom-actions">
            <button class="empf-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للقائمة
            </button>

            @if (CanSave)
            {
                <div class="empf-bottom-right">

                    @if (_activeTab < 2)
                    {
                        <button class="empf-next-btn" @onclick="() => _activeTab++">
                            التالي
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    }

                    <button class="empf-bottom-save" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ الموظف</span>
                        }
                    </button>

                </div>
            }
        </div>

    }
</div>


<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* Hero */
    .emp-hero-badge {
        display: inline-flex; align-items: center;
        padding: 3px 10px; border-radius: 20px;
        font-size: 11px; font-weight: 800;
    }
    .badge-new      { background: rgba(34,197,94,.2);  color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-active   { background: rgba(34,197,94,.25); color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-onleave  { background: rgba(234,179,8,.25); color: #fde68a; border: 1px solid rgba(234,179,8,.3); }
    .badge-suspended  { background: rgba(239,68,68,.25); color: #fca5a5; border: 1px solid rgba(239,68,68,.3); }
    .badge-terminated { background: rgba(255,255,255,.12); color: rgba(255,255,255,.65); border: 1px solid rgba(255,255,255,.2); }
    .badge-edit     { background: rgba(234,179,8,.2);  color: #fde68a; border: 1px solid rgba(234,179,8,.3); }

    .emp-back-btn {
        display: inline-flex; align-items: center; gap: 5px;
        height: 36px; padding: 0 13px;
        border: 1px solid rgba(255,255,255,.2); border-radius: 9px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .emp-back-btn:hover { background: rgba(255,255,255,.14); }
    .emp-back-btn svg { transform: rotate(180deg); }

    .emp-save-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 18px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .emp-save-btn:hover:not(:disabled) { transform: translateY(-1px); }
    .emp-save-btn:disabled { opacity: .6; cursor: not-allowed; }

    /* Body */
    .empf-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 180px);
        padding: 16px 20px 32px;
        max-width: 900px; width: 100%;
        margin: 0 auto;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* States */
    .empf-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 280px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .empf-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .empf-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .empf-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .empf-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }
    .empf-state-back {
        margin-top: 8px; padding: 9px 20px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-text);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .empf-state-back:hover { background: #f0f4fa; }

    /* Loading */
    .empf-loading-wrap {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 14px; min-height: 260px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .empf-spinner {
        width: 36px; height: 36px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: empf-spin .75s linear infinite;
    }
    @@keyframes empf-spin { to { transform: rotate(360deg); } }
    .empf-loading-text { font-size: 13px; font-weight: 600; color: var(--fc-muted); }

    /* Banners */
    .empf-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600;
        animation: empf-banner-in .25s ease;
    }
    @@keyframes empf-banner-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
    .banner-success { background: #e9f8f0; color: #0e7a43; border: 1px solid #b5e8d0; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); border: 1px solid #ffc8d0; }
    .banner-close { margin-right: auto; background: none; border: none; color: inherit; opacity: .6; cursor: pointer; font-size: 13px; }

    .empf-terminated-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px; border-radius: 12px;
        background: #f0f3f8; border: 1px solid #dde5f0;
    }
    .term-icon { flex: 0 0 auto; color: #6b7d95; }
    .term-text { display: flex; flex-direction: column; gap: 2px; }
    .term-text strong { font-size: 13px; font-weight: 800; color: #344258; }
    .term-text span   { font-size: 11.5px; color: #6b7d95; }

    /* Tabs */
    .empf-tabs-wrap {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden; flex: 1;
    }

    .empf-mud-tabs .mud-tabs-toolbar {
        background: linear-gradient(180deg, #f9fafd 0%, #f3f6fb 100%);
        border-bottom: 2px solid #e8edf5; padding: 0 16px; min-height: 54px;
    }
    .empf-mud-tabs .mud-tab { font-family: "Cairo","Tajawal","Inter",Arial,sans-serif; font-size: 12px; font-weight: 700; color: var(--fc-muted); padding: 0 6px; min-width: unset; transition: color .15s ease; }
    .empf-mud-tabs .mud-tab.mud-tab-active { color: var(--fc-blue) !important; font-weight: 800; }
    .empf-mud-tabs .mud-tab-slider { background: var(--fc-blue) !important; height: 3px; border-radius: 3px 3px 0 0; }
    .empf-mud-tabs .mud-tab:hover:not(.mud-tab-active) { color: var(--fc-text); background: rgba(0,0,0,.03); border-radius: 8px; }
    .empf-tab-panel { padding: 0; }

    /* Tab Labels */
    .etab-label { display: flex; align-items: center; gap: 7px; padding: 0 4px; white-space: nowrap; }
    .etab-icon  { width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: 7px; }
    .etab-blue  { background: var(--fc-blue-lt);  color: var(--fc-blue); }
    .etab-amber { background: var(--fc-amber-lt); color: var(--fc-amber); }
    .etab-green { background: var(--fc-green-lt); color: var(--fc-green); }
    .etab-err-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--fc-red); flex: 0 0 7px; animation: empf-pulse 1.5s ease infinite; }
    @@keyframes empf-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.4); } 50% { box-shadow: 0 0 0 5px rgba(224,48,72,0); } }

    /* Tab Section */
    .empf-tab-section { padding: 20px 24px 24px; display: flex; flex-direction: column; gap: 16px; }

    /* Section Cards */
    .empf-section-card {
        border: 1px solid #e4edf8; border-radius: 14px;
        background: linear-gradient(180deg, #fafcff, #f5f8fb);
        padding: 18px 20px;
        transition: border-color .15s ease;
    }
    .empf-section-card:hover { border-color: #c8d8f0; }

    .empf-section-head {
        display: flex; align-items: flex-start; gap: 12px;
        margin-bottom: 18px; padding-bottom: 14px;
        border-bottom: 1px solid #e4edf8;
    }

    .empf-section-icon { width: 42px; height: 42px; flex: 0 0 42px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    .icon-blue   { background: var(--fc-blue-lt);  color: var(--fc-blue);  border: 1px solid #bdd4fc; }
    .icon-green  { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .icon-amber  { background: var(--fc-amber-lt); color: var(--fc-amber); border: 1px solid #f0d070; }

    .empf-section-title { font-size: 14.5px; font-weight: 800; color: #1c2b43; line-height: 1.2; }
    .empf-section-sub   { font-size: 11px; font-weight: 500; color: var(--fc-muted); margin-top: 3px; }

    /* Form */
    .empf-form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .empf-field { display: flex; flex-direction: column; gap: 6px; }
    .empf-field-full { grid-column: 1 / -1; }

    .empf-label { font-size: 12px; font-weight: 800; color: #344258; display: flex; align-items: center; gap: 4px; }
    .empf-required { color: var(--fc-red); font-size: 13px; }

    .empf-input {
        height: 42px; width: 100%;
        border: 1.5px solid #d8e2f0; border-radius: 9px;
        background: #fff; color: var(--fc-text);
        font-family: inherit; font-size: 13px; padding: 0 12px;
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .empf-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .empf-input.input-error { border-color: var(--fc-red); box-shadow: 0 0 0 3px rgba(224,48,72,.08); }
    .empf-input::placeholder { color: #b0bcc8; }

    .empf-input-group { position: relative; display: flex; align-items: center; }
    .empf-prefix {
        position: absolute; right: 12px;
        display: flex; align-items: center;
        color: #9aaabb; pointer-events: none; z-index: 1;
        font-size: 11px; font-weight: 700;
    }
    .empf-input.with-prefix { padding-right: 36px; }

    .empf-select-wrap { position: relative; }
    .empf-sel-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #9aaabb; pointer-events: none; z-index: 1; }
    .empf-select { padding-right: 36px; cursor: pointer; -webkit-appearance: none; appearance: none; }

    .empf-hint { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--fc-muted); font-weight: 500; }
    .empf-err-msg { font-size: 10.5px; color: var(--fc-red); font-weight: 700; }

    .empf-info-box {
        display: flex; align-items: center; gap: 8px;
        padding: 10px 13px; border-radius: 9px;
        background: var(--fc-blue-lt); border: 1px solid #bdd4fc;
        color: var(--fc-blue); font-size: 11px; font-weight: 600;
        margin-top: 14px;
    }

    /* ── Status Grid ── */
    .empf-status-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }

    .empf-status-card {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 16px; border-radius: 12px;
        border: 2px solid #e4edf8; background: #fafcff;
        cursor: pointer; text-align: right;
        font-family: inherit;
        transition: all .18s ease; position: relative;
    }
    .empf-status-card:hover:not(.status-selected) { border-color: #b0c4e0; transform: translateY(-1px); }

    .status-card-icon { font-size: 24px; flex: 0 0 auto; }

    .status-card-text { display: flex; flex-direction: column; gap: 3px; flex: 1; }
    .status-card-label { font-size: 13px; font-weight: 800; color: #1c2b43; }
    .status-card-sub   { font-size: 10px; color: #9aaabb; font-weight: 500; }

    .status-card-check {
        position: absolute; top: 10px; left: 10px;
        width: 22px; height: 22px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: currentColor; color: #fff;
        transition: all .15s ease;
    }

    /* Status Colors */
    .status-green.status-selected  { border-color: var(--fc-green); background: var(--fc-green-lt); box-shadow: 0 0 0 3px rgba(22,163,91,.10); }
    .status-amber.status-selected  { border-color: var(--fc-amber); background: var(--fc-amber-lt); box-shadow: 0 0 0 3px rgba(224,154,16,.10); }
    .status-red.status-selected    { border-color: var(--fc-red);   background: var(--fc-red-lt);   box-shadow: 0 0 0 3px rgba(224,48,72,.10); }
    .status-gray.status-selected   { border-color: #9aaabb; background: #f0f3f8; box-shadow: 0 0 0 3px rgba(154,170,187,.15); }

    .status-green.status-selected .status-card-label { color: var(--fc-green); }
    .status-amber.status-selected .status-card-label { color: #9a6d08; }
    .status-red.status-selected   .status-card-label { color: var(--fc-red); }
    .status-gray.status-selected  .status-card-label { color: #5a6e88; }

    .status-green.status-selected .status-card-check { background: var(--fc-green); color: #fff; }
    .status-amber.status-selected .status-card-check { background: var(--fc-amber); color: #fff; }
    .status-red.status-selected   .status-card-check { background: var(--fc-red);   color: #fff; }
    .status-gray.status-selected  .status-card-check { background: #9aaabb; color: #fff; }

    /* Warn Box */
    .empf-warn-box {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 14px 16px; border-radius: 12px;
        background: var(--fc-amber-lt); border: 1px solid #f0d898;
    }
    .empf-warn-box svg { flex: 0 0 auto; color: #d97706; margin-top: 2px; }
    .empf-warn-box strong { display: block; font-size: 13px; font-weight: 800; color: #92400e; }
    .empf-warn-box p { margin: 3px 0 0; font-size: 11.5px; color: #b45309; }

    /* Bottom Actions */
    .empf-bottom-actions {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; padding: 14px 20px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 2px 8px rgba(15,41,82,.04);
    }
    .empf-bottom-back {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .empf-bottom-back:hover { background: #f0f4fa; color: var(--fc-text); }
    .empf-bottom-back svg { transform: rotate(180deg); }

    .empf-bottom-right { display: flex; align-items: center; gap: 10px; }

    .empf-next-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 14px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .empf-next-btn:hover { background: var(--fc-blue); color: #fff; }
    .empf-next-btn svg { transform: rotate(180deg); }

    .empf-bottom-save {
        display: inline-flex; align-items: center; gap: 8px;
        height: 40px; padding: 0 22px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(30,110,245,.28);
        transition: all .15s ease;
    }
    .empf-bottom-save:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(30,110,245,.36); }
    .empf-bottom-save:disabled { opacity: .6; cursor: not-allowed; }

    .btn-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: empf-spin .7s linear infinite; }
    .btn-spinner.sm { width: 13px; height: 13px; }

    @@media (max-width: 900px) {
        .empf-form-grid   { grid-template-columns: 1fr; }
        .empf-status-grid { grid-template-columns: 1fr; }
        .empf-tab-section { padding: 16px 14px 20px; }
    }

    @@media (max-width: 680px) {
        .empf-body { padding: 10px 12px 24px; }
        .empf-bottom-actions { flex-direction: column; }
        .empf-bottom-back, .empf-bottom-save { width: 100%; justify-content: center; }
        .empf-bottom-right { width: 100%; flex-direction: column; }
        .empf-next-btn { width: 100%; justify-content: center; }
    }

</style>


@code {
    [Parameter] public int? Id { get; set; }
    private int?   _id;
    private string EmployeeCode = "";
    private int    _activeTab;
    private bool   _triedSave;

    private AuthUser? _user;
    private bool CanCreate => _user?.Can("EMPLOYEE.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("EMPLOYEE.EDIT")   ?? false;
    private bool CanSave   => _id is null ? CanCreate : CanEdit;

    private bool    _loading; private bool _saving;
    private string? _msg;     private bool _ok = true;

    private List<Opt> _depts  = new();
    private List<Opt> _titles = new();
    private List<Mgr> _all    = new();

    private Form _f = new();

    private IEnumerable<Mgr> Managers =>
        _id is null ? _all : _all.Where(m => m.EmployeeId != _id.Value);

    /* Validation */
    private bool HasTabError(int tab) => _triedSave && tab switch
    {
        1 => string.IsNullOrWhiteSpace(_f.FullNameAr),
        _ => false
    };

    /* Hero Badge */
    private static string StatusHeroBadge(string s) => s switch
    {
        "Active"     => "badge-active",
        "OnLeave"    => "badge-onleave",
        "Suspended"  => "badge-suspended",
        "Terminated" => "badge-terminated",
        _            => "badge-edit"
    };

    private static string StatusName(string s) => s switch
    {
        "Active"     => "نشط",
        "OnLeave"    => "في إجازة",
        "Suspended"  => "موقوف",
        "Terminated" => "منتهي الخدمة",
        _            => s
    };

    /* DTOs */
    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    public class Mgr
    {
        public int    EmployeeId       { get; set; }
        public string EmployeeCode     { get; set; } = "";
        public string FullNameAr       { get; set; } = "";
        public string EmploymentStatus { get; set; } = "";
    }

    public class Form
    {
        public string  FullNameAr        { get; set; } = "";
        public string? FullNameEn        { get; set; }
        public string? NationalId        { get; set; }
        public string? Mobile            { get; set; }
        public string? Email             { get; set; }
        public string? Address           { get; set; }
        public string? HireDate          { get; set; }
        public int?    DepartmentId      { get; set; }
        public int?    JobTitleId        { get; set; }
        public int?    BranchId          { get; set; }
        public int?    ManagerEmployeeId { get; set; }
        public string  EmploymentStatus  { get; set; } = "Active";
    }

    public class Detail
    {
        public int     EmployeeId        { get; set; }
        public string  EmployeeCode      { get; set; } = "";
        public string  FullNameAr        { get; set; } = "";
        public string? FullNameEn        { get; set; }
        public string? NationalId        { get; set; }
        public string? Mobile            { get; set; }
        public string? Email             { get; set; }
        public string? Address           { get; set; }
        public DateOnly? HireDate        { get; set; }
        public int?    DepartmentId      { get; set; }
        public int?    JobTitleId        { get; set; }
        public int?    BranchId          { get; set; }
        public int?    ManagerEmployeeId { get; set; }
        public string  EmploymentStatus  { get; set; } = "";
    }

    /* Init */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id   = Id;
        if (!CanSave) return;

        _loading = true;
        try
        {
            _depts  = await SafeGetT<Opt>("api/options/departments");
            _titles = await SafeGetT<Opt>("api/options/job-titles");
            _all    = await SafeGetT<Mgr>("api/employees?take=300");

            if (_id is not null)
                await LoadAsync(_id.Value);
            else
                _f = new Form
                {
                    EmploymentStatus = "Active",
                    HireDate         = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")
                };
        }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; _ok = false; }
        finally { _loading = false; }
    }

    private async Task LoadAsync(int id)
    {
        var d = await Http.GetFromJsonAsync<Detail>($"api/employees/{id}");
        if (d is null) { _msg = "الموظف غير موجود"; _ok = false; return; }

        EmployeeCode = d.EmployeeCode;
        _f = new Form
        {
            FullNameAr        = d.FullNameAr,
            FullNameEn        = d.FullNameEn,
            NationalId        = d.NationalId,
            Mobile            = d.Mobile,
            Email             = d.Email,
            Address           = d.Address,
            HireDate          = d.HireDate?.ToString("yyyy-MM-dd"),
            DepartmentId      = d.DepartmentId,
            JobTitleId        = d.JobTitleId,
            BranchId          = d.BranchId,
            ManagerEmployeeId = d.ManagerEmployeeId,
            EmploymentStatus  = d.EmploymentStatus
        };
    }

    /* Save */
    private async Task SaveAsync()
    {
        if (_saving) return;
        _triedSave = true;
        _saving    = true;
        _msg       = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_f.FullNameAr))
            { _msg = "الاسم بالعربي مطلوب"; _ok = false; _activeTab = 0; return; }

            var res = _id is null
                ? await Http.PostAsJsonAsync("api/employees", _f)
                : await Http.PutAsJsonAsync($"api/employees/{_id}", _f);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private void OnHireDateChanged(ChangeEventArgs e) =>
        _f.HireDate = e.Value?.ToString();

    private void GoBack() => Nav.NavigateTo("/employees");

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "✅ تم الحفظ" : "حصل خطأ — حاول تاني"; }
    }
}