@page "/maintenance"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>صيانة المركبات — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO SECTION (flt-* — نفس عيلة شاشة الأسطول)
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="flt-hero-row">
                <div class="flt-hero-left">
                    <div class="flt-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
                        </svg>
                        <span>الأسطول التشغيلي · سجل الصيانة</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">صيانة المركبات</h1>
                    <span class="flt-hero-sub">سجل عمليات الصيانة — متابعة التكلفة الشهرية والمواعيد المستحقة لكل مركبة</span>
                </div>

                <div class="flt-hero-right">
                    <button type="button" class="flt-hero-refresh" @onclick="LoadAsync" title="تحديث البيانات">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 4v6h-6"/>
                            <path d="M1 20v-6h6"/>
                            <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                        </svg>
                    </button>
                    @if (CanCreate)
                    {
                        <button type="button" class="flt-hero-add" @onclick="New">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            سجل صيانة
                        </button>
                    }
                    <span class="flt-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

            @* ── KPI Cards (flt-kpis-strip — فلاتر قابلة للنقر) ── *@
            @if (CanView && !_loading)
            {
                <div class="flt-kpis-strip">

                    <div class="flt-kpi-item @(_kpi == "open" ? "kpi-active" : "")" @onclick='() => SetKpi("open")' role="button" tabindex="0" title="تصفية السجلات المفتوحة">
                        <div class="flt-kpi-icon kpi-blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">سجلات مفتوحة</div>
                            <div class="flt-kpi-val">@_s.Open</div>
                        </div>
                    </div>

                    <div class="flt-kpi-div" aria-hidden="true"></div>

                    <div class="flt-kpi-item @(_kpi == "overdue" ? "kpi-active" : "")" @onclick='() => SetKpi("overdue")' role="button" tabindex="0" title="تصفية المتأخرة عن موعدها">
                        <div class="flt-kpi-icon kpi-red">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                                <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">متأخرة عن الموعد</div>
                            <div class="flt-kpi-val val-red">@_s.Overdue</div>
                        </div>
                    </div>

                    <div class="flt-kpi-div" aria-hidden="true"></div>

                    <div class="flt-kpi-item @(_kpi == "soon" ? "kpi-active" : "")" @onclick='() => SetKpi("soon")' role="button" tabindex="0" title="تصفية المستحقة خلال 30 يومًا">
                        <div class="flt-kpi-icon kpi-amber">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">مستحقة خلال 30 يومًا</div>
                            <div class="flt-kpi-val val-amber">@_s.DueSoon</div>
                        </div>
                    </div>

                    <div class="flt-kpi-div" aria-hidden="true"></div>

                    <div class="flt-kpi-item @(_kpi == "all" ? "kpi-active" : "")" @onclick='() => SetKpi("all")' role="button" tabindex="0" title="عرض كل السجلات (إلغاء التصفية)">
                        <div class="flt-kpi-icon kpi-green">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 1v22"/>
                                <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">تكلفة الشهر</div>
                            <div class="flt-kpi-val val-green">@_s.MonthCost.ToString("N0")</div>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY (flt-body / flt-card)
═══════════════════════════════════════════ *@
<div class="flt-body">
    <div class="flt-card">

        @if (!CanView)
        {
            <div class="flt-empty">
                <div class="flt-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="flt-empty-title">ليست لديك صلاحية</div>
                <div class="flt-empty-sub">ليست لديك الصلاحية الكافية لعرض سجل الصيانة</div>
            </div>
        }
        else
        {
            @* ── Toolbar: بحث + شارة النتائج ── *@
            <div class="flt-toolbar">
                <div class="flt-search-wrap">
                    <svg class="flt-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="flt-search-input"
                           placeholder="بحث برقم السجل أو اللوحة أو المورد..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="البحث في سجل الصيانة" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button type="button" class="flt-search-clear" @onclick="() => _search = string.Empty" title="مسح البحث">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="flt-results-badge">
                    <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="8" cy="8" r="6"/>
                        <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                    </svg>
                    <span>عرض <strong>@DisplayItems.Count</strong> من <strong>@_items.Count</strong> سجل</span>
                </div>
            </div>

            @* ── الفلاتر الإضافية ── *@
            <div class="flt-toolbar">
                <select class="svc-input svc-select" style="width:auto; min-width:160px" value="@_fStatus" @onchange="e => _fStatus = e.Value?.ToString()" aria-label="تصفية بالحالة">
                    <option value="">كل الحالات</option>
                    <option value="Scheduled">مجدولة</option>
                    <option value="InProgress">قيد التنفيذ</option>
                    <option value="Completed">مكتملة</option>
                    <option value="Cancelled">ملغاة</option>
                </select>
                <select class="svc-input svc-select" style="width:auto; min-width:160px" value="@_fVehicle" @onchange="e => _fVehicle = Nul(e.Value)" aria-label="تصفية بالمركبة">
                    <option value="">كل المركبات</option>
                    @foreach (var v in _vehicles) { <option value="@v.Id">@v.Label</option> }
                </select>
                <button type="button" class="flt-hero-add" @onclick="LoadAsync">تطبيق التصفية</button>
            </div>

            @* ── الجدول ── *@
            @if (_loading)
            {
                <div class="flt-loading">
                    <div class="flt-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل سجل الصيانة...</span>
                </div>
            }
            else if (!DisplayItems.Any())
            {
                <div class="flt-empty">
                    <div class="flt-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                            <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
                        </svg>
                    </div>
                    <div class="flt-empty-title">@(_items.Count == 0 ? "لا توجد سجلات صيانة" : "لا توجد نتائج مطابقة")</div>
                    <div class="flt-empty-sub">@(_items.Count == 0 ? "ابدأ بتسجيل أول عملية صيانة لأسطولك" : "جرّب تعديل البحث أو إلغاء التصفية من الكروت أعلاه")</div>
                </div>
            }
            else
            {
                <div class="flt-table-wrap">
                    <table class="flt-table" aria-label="سجل الصيانة">
                        <thead>
                            <tr>
                                <th class="th-start">المركبة والسجل</th>
                                <th>التاريخ</th>
                                <th>نوع الصيانة</th>
                                <th>المورد / الورشة</th>
                                <th>التكلفة</th>
                                <th>الصيانة القادمة</th>
                                <th>الحالة</th>
                                @if (CanEdit) { <th style="width:110px">إجراءات</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in DisplayItems)
                            {
                                <tr>
                                    <td class="td-start">
                                        <div class="flt-item-cell">
                                            <div class="flt-avatar av-maintenance" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
                                                </svg>
                                            </div>
                                            <div class="flt-item-info">
                                                <div class="flt-code-plate">
                                                    <span class="flt-code-chip">@m.MaintenanceNumber</span>
                                                </div>
                                                <div class="flt-plate-num">@m.VehiclePlate</div>
                                                @if (!string.IsNullOrWhiteSpace(m.VehicleModel))
                                                {
                                                    <div class="flt-brand-sub">@m.VehicleModel</div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>@m.MaintenanceDate.ToString("yyyy-MM-dd")</td>

                                    <td>
                                        <div class="flt-type-cell">
                                            <span class="flt-type-tag">@TypeAr(m.MaintenanceType)</span>
                                            @if (m.Odometer.HasValue)
                                            {
                                                <div class="flt-brand-sub">@m.Odometer.Value.ToString("N0") كم</div>
                                            }
                                        </div>
                                    </td>

                                    <td class="td-muted">@(m.SupplierName ?? "—")</td>

                                    <td><strong>@m.Cost.ToString("N2")</strong></td>

                                    <td>@DueCell(m)</td>

                                    <td>
                                        <span class="flt-status-chip @StatusChipClass(m.Status)">
                                            <span class="flt-status-dot @StatusDotClass(m.Status)" aria-hidden="true"></span>
                                            @StatusAr(m.Status)
                                        </span>
                                    </td>

                                    @if (CanEdit)
                                    {
                                        <td>
                                            <div class="flt-actions">
                                                <button type="button" class="flt-act-btn act-edit" @onclick="() => Edit(m)" title="تعديل السجل">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                                @if (CanDelete)
                                                {
                                                    @if (_confirmId == m.MaintenanceId)
                                                    {
                                                        <button type="button" class="flt-confirm-del" @onclick="() => DeleteAsync(m)">تأكيد الحذف؟</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="flt-act-btn act-del" @onclick="() => _confirmId = m.MaintenanceId" title="حذف السجل">
                                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                            </svg>
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>


@* ═══════════════════════════════════════════
   GLOW FAB (موضع ثابت في أسفل اليسار)
═══════════════════════════════════════════ *@
@if (CanCreate)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="() => { _fabOpen = false; New(); }">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
                    </svg>
                </span>
                <span>تسجيل عملية صيانة</span>
            </button>
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="() => { _fabOpen = false; _ = LoadAsync(); }">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M23 4v6h-6"/>
                        <path d="M1 20v-6h6"/>
                        <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                    </svg>
                </span>
                <span>تحديث البيانات</span>
            </button>
        </div>

        <div class="glow-fab-container">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="glow-fab-btn" @onclick="ToggleFab" aria-label="لوحة التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

    </div>
}

@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
}


@* ═══════════════════════════════════════════
   MODAL — سجل صيانة (svc-modal Standard)
═══════════════════════════════════════════ *@
@if (_open && (CanCreate || CanEdit))
{
    <div class="svc-modal-backdrop" @onclick="Close" role="dialog" aria-modal="true">
        <div class="svc-modal" @onclick:stopPropagation="true">

            <div class="svc-modal-head">
                <div class="svc-head-icon @(_editId is null ? "svc-icon-create" : "svc-icon-edit")" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">@(_editId is null ? "تسجيل عملية صيانة جديدة" : "تعديل سجل الصيانة")</div>
                    <div class="svc-head-sub">
                        @if (_editId is null)
                        {
                            <span>يتم توليد الرقم تلقائيًا بالبادئة (MAINT-)</span>
                        }
                        else
                        {
                            <span>تحديث بيانات عملية الصيانة: @_f.MaintenanceNumber</span>
                        }
                    </div>
                </div>
                <button class="svc-head-close" @onclick="Close" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="svc-banner @(_ok ? "svc-banner-ok" : "svc-banner-err")" role="alert">
                    <span class="svc-banner-msg">@_msg</span>
                    <button class="svc-banner-x" @onclick="() => _msg = null" type="button">&#10005;</button>
                </div>
            }

            <div class="svc-modal-body">
                <div class="svc-section">
                    <div class="svc-section-head">
                        <div class="svc-section-ic blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="svc-section-title">بيانات عملية الصيانة</div>
                            <div class="svc-section-sub">المركبة، الفرع، التاريخ، النوع، التكلفة، والحالة</div>
                        </div>
                    </div>

                    <div class="svc-grid">
                        <div class="svc-field">
                            <label class="svc-label">المركبة <span class="svc-req">*</span></label>
                            <div class="svc-input-wrap">
                                <select class="svc-input svc-select" @bind="_f.VehicleId">
                                    <option value="0">— اختر المركبة —</option>
                                    @foreach (var v in _vehicles) { <option value="@v.Id">@v.Label</option> }
                                </select>
                            </div>
                        </div>
                        <div class="svc-field">
                            <label class="svc-label">الفرع <span class="svc-req">*</span></label>
                            <div class="svc-input-wrap">
                                <select class="svc-input svc-select" @bind="_f.BranchId">
                                    <option value="0">— اختر الفرع —</option>
                                    @foreach (var b in _branches) { <option value="@b.Id">@b.Label</option> }
                                </select>
                            </div>
                        </div>
                        <div class="svc-field">
                            <label class="svc-label">تاريخ الصيانة <span class="svc-req">*</span></label>
                            <div class="svc-input-wrap">
                                <input type="date" class="svc-input" value="@_f.MaintenanceDate"
                                       @onchange="e => _f.MaintenanceDate = e.Value?.ToString()" />
                            </div>
                        </div>
                        <div class="svc-field">
                            <label class="svc-label">نوع الصيانة <span class="svc-req">*</span></label>
                            <div class="svc-input-wrap">
                                <select class="svc-input svc-select" @bind="_f.MaintenanceType">
                                    @foreach (var t in Types)
                                    {
                                        <option value="@t" selected="@(_f.MaintenanceType == t)">@TypeAr(t)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="svc-field">
                            <label class="svc-label">المورد / الورشة</label>
                            <div class="svc-input-wrap">
                                <select class="svc-input svc-select" value="@_f.SupplierId" @onchange="e => _f.SupplierId = Nul(e.Value)">
                                    <option value="">— بدون —</option>
                                    @foreach (var s in _suppliers) { <option value="@s.Id">@s.Label</option> }
                                </select>
                            </div>
                        </div>
                        <div class="svc-field">
                            <label class="svc-label">الحالة <span class="svc-req">*</span></label>
                            <div class="svc-input-wrap">
                                <select class="svc-input svc-select" @bind="_f.Status">
                                    <option value="Scheduled" selected="@(_f.Status == "Scheduled")">مجدولة</option>
                                    <option value="InProgress" selected="@(_f.Status == "InProgress")">قيد التنفيذ</option>
                                    <option value="Completed" selected="@(_f.Status == "Completed")">مكتملة</option>
                                    <option value="Cancelled" selected="@(_f.Status == "Cancelled")">ملغاة</option>
                                </select>
                            </div>
                        </div>
                        <div class="svc-field">
                            <label class="svc-label">قراءة العداد (كم)</label>
                            <div class="svc-input-wrap">
                                <input type="number" min="0" step="0.1" class="svc-input" value="@_f.Odometer"
                                       @onchange="e => _f.Odometer = DecN(e.Value)" />
                            </div>
                        </div>
                        <div class="svc-field">
                            <label class="svc-label">التكلفة (ج.م)</label>
                            <div class="svc-input-wrap">
                                <input type="number" min="0" step="0.01" class="svc-input" value="@_f.Cost"
                                       @onchange="e => _f.Cost = Dec(e.Value)" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="svc-section">
                    <div class="svc-section-head">
                        <div class="svc-section-ic blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div>
                            <div class="svc-section-title">الصيانة القادمة والوصف</div>
                            <div class="svc-section-sub">موعد الصيانة التالية بالتاريخ أو بالعداد — يظهر التنبيه تلقائيًا عند الاقتراب</div>
                        </div>
                    </div>

                    <div class="svc-grid">
                        <div class="svc-field">
                            <label class="svc-label">الصيانة القادمة — التاريخ</label>
                            <div class="svc-input-wrap">
                                <input type="date" class="svc-input" value="@_f.NextDueDate"
                                       @onchange="e => _f.NextDueDate = e.Value?.ToString()" />
                            </div>
                        </div>
                        <div class="svc-field">
                            <label class="svc-label">الصيانة القادمة — العداد</label>
                            <div class="svc-input-wrap">
                                <input type="number" min="0" step="0.1" class="svc-input" value="@_f.NextDueOdometer"
                                       @onchange="e => _f.NextDueOdometer = DecN(e.Value)" />
                            </div>
                        </div>
                        <div class="svc-field svc-field-full">
                            <label class="svc-label">الوصف</label>
                            <div class="svc-input-wrap">
                                <input class="svc-input" @bind="_f.Description" maxlength="1000" placeholder="ما تم أو ما سيتم تنفيذه في هذه الصيانة" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="svc-modal-foot">
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="Close" type="button">تراجع</button>
                    <button class="svc-btn-save" @onclick="SaveAsync" disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>@(_editId is null ? "تسجيل الصيانة" : "حفظ التعديلات")</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("MAINTENANCE.VIEW") ?? false;
    private bool CanCreate => _user?.Can("MAINTENANCE.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("MAINTENANCE.EDIT") ?? false;
    private bool CanDelete => _user?.Can("MAINTENANCE.DELETE") ?? false;

    private static readonly string[] Types =
    {
        "Oil", "Filter", "Brake", "Tire", "Battery", "Coolant",
        "Transmission", "Electrical", "Body", "Inspection", "Other"
    };

    private List<Item> _items = new();
    private Sum _s = new();
    private List<Opt> _vehicles = new(), _branches = new(), _suppliers = new();
    private string? _fStatus; private int? _fVehicle;
    private string _search = "";
    private bool _loading;

    private bool _open, _saving, _fabOpen;
    private string? _msg; private bool _ok = true;
    private long? _editId;
    private long? _confirmId;
    private Form _f = new();

    /* KPI = فلتر — الضغط مرة يفعّله ومرة يلغيه */
    private string _kpi = "all";
    private void SetKpi(string k) => _kpi = (_kpi == k && k != "all") ? "all" : k;

    private List<Item> DisplayItems
    {
        get
        {
            IEnumerable<Item> q = _items;
            q = _kpi switch
            {
                "open"    => q.Where(m => m.Status is "Scheduled" or "InProgress"),
                "overdue" => q.Where(m => m.NextDueDate is not null && m.DaysToDue < 0),
                "soon"    => q.Where(m => m.NextDueDate is not null && m.DaysToDue >= 0 && m.DaysToDue <= 30),
                _         => q
            };
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(m => m.MaintenanceNumber.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || m.VehiclePlate.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || (m.SupplierName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                              || TypeAr(m.MaintenanceType).Contains(s));
            }
            return q.ToList();
        }
    }

    private void ToggleFab() => _fabOpen = !_fabOpen;

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    public class Sum
    {
        public int Total { get; set; }
        public int Open { get; set; }
        public int Overdue { get; set; }
        public int DueSoon { get; set; }
        public decimal MonthCost { get; set; }
    }

    /// <summary>مطابق لـ <c>MaintenanceController.Item</c> — 18 حقل.</summary>
    public class Item
    {
        public long MaintenanceId { get; set; }
        public string MaintenanceNumber { get; set; } = "";
        public int VehicleId { get; set; }
        public string VehiclePlate { get; set; } = "";
        public string? VehicleModel { get; set; }
        public int BranchId { get; set; }
        public DateOnly MaintenanceDate { get; set; }
        public string MaintenanceType { get; set; } = "";
        public int? SupplierId { get; set; }
        public string? SupplierName { get; set; }
        public decimal? Odometer { get; set; }
        public decimal Cost { get; set; }
        public DateOnly? NextDueDate { get; set; }
        public decimal? NextDueOdometer { get; set; }
        public string? Description { get; set; }
        public string Status { get; set; } = "";
        public int DaysToDue { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    /// <summary>مطابق لـ <c>MaintenanceController.Upsert</c> — 11 حقل.</summary>
    public class Form
    {
        public int VehicleId { get; set; }
        public int BranchId { get; set; }
        public string? MaintenanceDate { get; set; }
        public string MaintenanceType { get; set; } = "Oil";
        public int? SupplierId { get; set; }
        public decimal? Odometer { get; set; }
        public decimal Cost { get; set; }
        public string? NextDueDate { get; set; }
        public decimal? NextDueOdometer { get; set; }
        public string? Description { get; set; }
        public string Status { get; set; } = "Completed";
        public string MaintenanceNumber { get; set; } = "";   /* للـ UI بس */
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        _vehicles = await SafeOpts("api/options/vehicles");
        _branches = await SafeOpts("api/options/branches");
        _suppliers = await SafeOpts("api/options/suppliers");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true;
        _confirmId = null;
        try
        {
            var qs = "";
            if (!string.IsNullOrWhiteSpace(_fStatus)) qs += $"status={_fStatus}&";
            if (_fVehicle is not null) qs += $"vehicleId={_fVehicle}&";
            _items = await Http.GetFromJsonAsync<List<Item>>("api/fleet/maintenance?" + qs) ?? new();
            _s = await Http.GetFromJsonAsync<Sum>("api/fleet/maintenance/summary") ?? new();
        }
        catch (Exception ex)
        {
            _ok = false; _msg = "فشل التحميل: " + ex.Message;
            Snackbar.Add(_msg, Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task<List<Opt>> SafeOpts(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Opt>>(url) ?? new(); }
        catch (Exception ex)
        {
            /* كان بيبلع الخطأ بصمت — فالدروبداون يفضى من غير أي سبب ظاهر */
            _ok = false;
            _msg = $"تعذّر تحميل القوائم ({url}): {ex.Message}";
            return new();
        }
    }

    private void New()
    {
        _editId = null;
        _f = new Form { MaintenanceDate = DateTime.Now.ToString("yyyy-MM-dd") };
        _msg = null; _open = true;
    }

    private void Edit(Item m)
    {
        _editId = m.MaintenanceId;
        _f = new Form
        {
            VehicleId = m.VehicleId, BranchId = m.BranchId,
            MaintenanceDate = m.MaintenanceDate.ToString("yyyy-MM-dd"),
            MaintenanceType = m.MaintenanceType, SupplierId = m.SupplierId,
            Odometer = m.Odometer, Cost = m.Cost,
            NextDueDate = m.NextDueDate?.ToString("yyyy-MM-dd"),
            NextDueOdometer = m.NextDueOdometer, Description = m.Description,
            Status = m.Status, MaintenanceNumber = m.MaintenanceNumber
        };
        _msg = null; _open = true;
    }

    private void Close() { _open = false; _msg = null; }

    private async Task SaveAsync()
    {
        if (_saving) return;
        if (_f.VehicleId <= 0) { _ok = false; _msg = "يرجى اختيار المركبة"; return; }
        if (_f.BranchId <= 0)  { _ok = false; _msg = "يرجى اختيار الفرع"; return; }
        if (string.IsNullOrWhiteSpace(_f.MaintenanceDate)) { _ok = false; _msg = "تاريخ الصيانة مطلوب"; return; }

        _saving = true; _msg = null;
        try
        {
            var payload = new
            {
                vehicleId = _f.VehicleId, branchId = _f.BranchId,
                maintenanceDate = _f.MaintenanceDate, maintenanceType = _f.MaintenanceType,
                supplierId = _f.SupplierId, odometer = _f.Odometer, cost = _f.Cost,
                nextDueDate = _f.NextDueDate, nextDueOdometer = _f.NextDueOdometer,
                description = _f.Description, status = _f.Status
            };
            var res = _editId is null
                ? await Http.PostAsJsonAsync("api/fleet/maintenance", payload)
                : await Http.PutAsJsonAsync($"api/fleet/maintenance/{_editId}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { Close(); await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(Item m)
    {
        _confirmId = null;
        try
        {
            var res = await Http.DeleteAsync($"api/fleet/maintenance/{m.MaintenanceId}");
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
    }

    /* أي " جوه attribute = RZ1010 — فالـ helpers بتخرج الـ class */

    /// <summary>خلية «الصيانة القادمة» — شارة ملونة زي رخص المركبات بالظبط.</summary>
    private RenderFragment DueCell(Item m) => __builder =>
    {
        @if (m.NextDueDate is null)
        {
            <span class="td-muted">—</span>
        }
        else
        {
            <div class="flt-doc-cell">
                <span class="flt-doc-badge @(m.DaysToDue < 0 ? "doc-expired" : m.DaysToDue < 30 ? "doc-warning" : "doc-valid")">
                    صيانة: @m.NextDueDate.Value.ToString("yyyy-MM-dd")
                </span>
                <span class="flt-brand-sub">
                    @(m.DaysToDue < 0 ? $"متأخرة {-m.DaysToDue} يومًا" : $"بعد {m.DaysToDue} يومًا")
                </span>
            </div>
        }
    };

    private static string StatusChipClass(string s) => s switch
    {
        "Scheduled"  => "chip-maintenance",
        "InProgress" => "chip-intrip",
        "Completed"  => "chip-available",
        "Cancelled"  => "chip-outofservice",
        _            => "chip-outofservice"
    };

    private static string StatusDotClass(string s) => s switch
    {
        "Scheduled"  => "dot-maintenance",
        "InProgress" => "dot-intrip",
        "Completed"  => "dot-available",
        "Cancelled"  => "dot-outofservice",
        _            => "dot-outofservice"
    };

    private static string StatusAr(string s) => s switch
    {
        "Scheduled" => "مجدولة", "InProgress" => "قيد التنفيذ",
        "Completed" => "مكتملة", "Cancelled" => "ملغاة", _ => s
    };
    private static string TypeAr(string t) => t switch
    {
        "Oil" => "زيت محرك", "Filter" => "فلاتر", "Brake" => "فرامل", "Tire" => "إطارات",
        "Battery" => "بطارية", "Coolant" => "دورة تبريد", "Transmission" => "ناقل حركة",
        "Electrical" => "كهرباء", "Body" => "أعمال هيكل", "Inspection" => "فحص فني",
        "Other" => "أخرى", _ => t
    };

    private static int? Nul(object? v) => int.TryParse(v?.ToString(), out var n) && n > 0 ? n : null;
    private static decimal Dec(object? v) => decimal.TryParse(v?.ToString(), out var n) && n >= 0 ? n : 0m;
    private static decimal? DecN(object? v) => decimal.TryParse(v?.ToString(), out var n) && n > 0 ? n : null;

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم بنجاح" : "حدث خطأ — يرجى المحاولة مرة أخرى"; }
    }
}

<style>

