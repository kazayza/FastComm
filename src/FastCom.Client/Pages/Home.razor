@page "/"
@attribute [Authorize]
@implements IDisposable
@using System.Net.Http.Json
@using FastCom.Client.Auth
@using FastCom.Client.Shared.Components.Dashboard
@inject CompanyService Company
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>الرئيسية — @_company.DisplayName</PageTitle>


@* ═══════════════════════════════════════════
   LOADING SKELETON
═══════════════════════════════════════════ *@
@if (_loading)
{
    <div class="home-skeleton" dir="rtl">
        <div class="sk-hero sk-pulse"></div>
        <div class="sk-kpi-row">
            @for (var i = 0; i < 4; i++)
            {
                <div class="sk-kpi sk-pulse"></div>
            }
        </div>
        <div class="sk-grid">
            <div class="sk-card sk-pulse"></div>
            <div class="sk-card-wide sk-pulse"></div>
        </div>
    </div>
}
else
{
    <div class="home-root" dir="rtl">


        @* ═══════════════════════════════════════════
           HERO — نفس نمط باقي النظام (.fc-hero)
           + 🚀 V4: Quick Actions + آخر تحديث + تحديث تلقائي
        ═══════════════════════════════════════════ *@
        <div class="fc-hero">
            <div class="fc-hero-inner">

                <div class="fc-page-head">
                    <div>
                        <div class="fc-crumb">@DateTime.Now.ToString("dddd، dd MMMM yyyy")</div>
                        <h1 class="fc-hero-title">أهلًا، @_user?.DisplayName </h1>
                        <p class="fc-hero-sub">@_company.DisplayName — لوحة مؤشرات اليوم</p>
                    </div>
                    <div class="fc-head-actions">
                        <span class="fc-updated" title="تحديث تلقائي كل 5 دقائق">
                            <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" />
                            آخر تحديث: @_lastUpdated
                        </span>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث البيانات"
                                       OnClick="Reload" Style="color:#9FB4CC" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.BarChart"
                                   OnClick="GoReports">التقارير</MudButton>
                    </div>
                </div>

                @* ── KPI التشغيل — 4 كروت تفاعلية (الضغط بيفتح الصفحة) ── *@
                <div class="fc-kpis fc-kpis-glass">
                    <KpiCard Value="@((_s?.OpenOperations ?? 0).ToString())" Label="عملية شغالة"
                             Icon="@Icons.Material.Filled.LocalShipping" Tone="blue" Href="/operations" />
                    <KpiCard Value="@((_s?.DelayedOperations ?? 0).ToString())" Label="عملية متأخرة"
                             Icon="@Icons.Material.Filled.Warning" Tone="red" Href="/operations" />
                    <KpiCard Value="@((_s?.TripsToday ?? 0).ToString())" Label="رحلات اليوم"
                             Icon="@Icons.Material.Filled.AirportShuttle" Tone="gold" Href="/trips" />
                    <KpiCard Value="@((_s?.ClosedThisMonth ?? 0).ToString())" Label="أُغلقت هذا الشهر"
                             Icon="@Icons.Material.Filled.CheckCircle" Tone="green" Href="/operations"
                             TrendPct="@_trends?.ClosedOps?.ChangePct" />
                </div>

                @* ── KPI المالية — للمصرح لهم بس + نسبة التغيير عن الشهر الماضي ── *@
                @if (CanSeeFinance)
                {
                    <div class="fc-kpis fc-kpis-glass" style="margin-top:12px">
                        <KpiCard Value="@Money(_trends?.Invoiced?.Current ?? 0)" Label="مفوتر هذا الشهر (ج.م)"
                                 Icon="@Icons.Material.Filled.ReceiptLong" Tone="blue" Href="/invoices"
                                 TrendPct="@_trends?.Invoiced?.ChangePct" />
                        <KpiCard Value="@Money(_trends?.Collected?.Current ?? 0)" Label="محصّل هذا الشهر (ج.م)"
                                 Icon="@Icons.Material.Filled.Paid" Tone="green" Href="/payments"
                                 TrendPct="@_trends?.Collected?.ChangePct" />
                        <KpiCard Value="@Money(_trends?.Expenses?.Current ?? 0)" Label="مصروفات الشهر (ج.م)"
                                 Icon="@Icons.Material.Filled.Receipt" Tone="gold" Href="/expenses"
                                 TrendPct="@_trends?.Expenses?.ChangePct" />
                        <KpiCard Value="@Money(_s?.Receivables ?? 0)" Label="مديونيات مستحقة (ج.م)"
                                 Icon="@Icons.Material.Filled.AccountBalanceWallet" Tone="red" Href="/invoices" />
                    </div>
                }

            </div>
        </div>

        <div class="home-content">

            <div class="v3-card v3-card-alerts">

                @* الهيدر الجديد *@
                <div class="v3-head">
                    <div class="v3-head-right">
                        <div class="v3-icon-box v3-icon-red" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="20" height="20"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                <path d="M13.73 21a2 2 0 01-3.46 0" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div>
                            <div class="v3-title">تنبيهات تحتاج قرار</div>
                            <div class="v3-subtitle">Management Alerts</div>
                        </div>
                    </div>
                    @if (_alerts.Any())
                    {
                        <div class="v3-badge v3-badge-red">
                            <span class="v3-badge-pulse" aria-hidden="true"></span>
                            @_alerts.Count
                        </div>
                    }
                    else
                    {
                        <div class="v3-badge v3-badge-green"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /></div>
                    }
                </div>

                @* المحتوى *@
                <div class="v3-body">
                    @if (!_alerts.Any())
                    {
                        <div class="v3-empty">
                            <div class="v3-empty-glow green"></div>
                            <svg viewBox="0 0 24 24" width="36" height="36"
                                 fill="none" stroke="currentColor" stroke-width="1.5"
                                 aria-hidden="true">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>لايوجد تنبيهات — كله تمام </span>
                        </div>
                    }
                    else
                    {
                        <div class="v3-alerts-list">
                            @foreach (var a in _alerts)
                            {
                                <button class="v3-alert-item v3-sev-@a.Severity"
                                        @onclick="() => Nav.NavigateTo(a.Route)">

                                    <div class="v3-alert-stripe" aria-hidden="true"></div>

                                    <div class="v3-alert-icon" aria-hidden="true">
                                        @if (a.Severity == "bad")
                                        {
                                            <svg viewBox="0 0 24 24" width="18" height="18"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                            </svg>
                                        }
                                        else if (a.Severity == "warn")
                                        {
                                            <svg viewBox="0 0 24 24" width="18" height="18"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="M12 8v4M12 16h.01" stroke-linecap="round"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" width="18" height="18"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                            </svg>
                                        }
                                    </div>

                                    <div class="v3-alert-body">
                                        <div class="v3-alert-title">
                                            @a.Kind <strong>— @a.Ref</strong>
                                        </div>
                                        <div class="v3-alert-detail">@a.Detail · @a.Date</div>
                                    </div>

                                    <div class="v3-alert-go" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="16" height="16"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M9 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </div>

                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

        <div class="v3-card v3-card-chart">

            <div class="v3-head">
                <div class="v3-head-right">
                    <div class="v3-icon-box v3-icon-blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 20V10M12 20V4M6 20v-6" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div>
                        <div class="v3-title">حركة آخر 6 شهور</div>
                        <div class="v3-subtitle">Cash Flow Trend</div>
                    </div>
                </div>
            </div>

            <div class="v3-body v3-chart-body">
                <CashFlowChart Points="_flow" />
            </div>
        </div>


        <div class="v3-card v3-card-donut">

            <div class="v3-head">
                <div class="v3-head-right">
                    <div class="v3-icon-box v3-icon-purple" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 2a10 10 0 019.54 7H12V2z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="v3-title">توزيع حالات العمليات</div>
                        <div class="v3-subtitle">Operations Breakdown</div>
                    </div>
                </div>
            </div>

            <div class="v3-body">
                <StatusDonut Counts="_opsStatus" />
            </div>
        </div>


        <div class="v3-card v3-card-fleet">

            <div class="v3-head">
                <div class="v3-head-right">
                    <div class="v3-icon-box v3-icon-green" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="1" y="3" width="15" height="13" rx="2"/>
                            <path d="M16 8h4l3 3v5h-7V8z"/>
                            <circle cx="5.5" cy="18.5" r="2.5"/>
                            <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                    </div>
                    <div>
                        <div class="v3-title">حالة الأسطول</div>
                        <div class="v3-subtitle">Fleet Status</div>
                    </div>
                </div>
            </div>

            <div class="v3-body">
                <FleetGauge Counts="_fleet" />
            </div>
        </div>


        <div class="v3-card v3-card-activity">

            <div class="v3-head">
                <div class="v3-head-right">
                    <div class="v3-icon-box v3-icon-blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 6v6l4 2" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div>
                        <div class="v3-title">آخر الأنشطة</div>
                        <div class="v3-subtitle">Recent Activity</div>
                    </div>
                </div>
            </div>

            <div class="v3-body">
                <ActivityFeed Items="_activity" />
            </div>
        </div>


        @if (CanSeeFinance)
        {
            <div class="v3-card v3-card-aging">

                <div class="v3-head">
                    <div class="v3-head-right">
                        <div class="v3-icon-box v3-icon-amber" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="20" height="20"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 8v4l3 3"/>
                                <circle cx="12" cy="12" r="10"/>
                            </svg>
                        </div>
                        <div>
                            <div class="v3-title">أعمار الديون</div>
                            <div class="v3-subtitle">Receivables Aging</div>
                        </div>
                    </div>
                    <div class="v3-head-chip">حسب تاريخ الاستحقاق</div>
                </div>

                <div class="v3-body">
                    <AgingBar Aging="_aging" />
                    @if (CanSeeFinance && (_s?.CustodyOutstanding ?? 0) > 0)
                    {
                        <div class="v3-custody-alert" role="alert" style="margin-top:14px">
                            <div class="v3-custody-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" /></div>
                            <div>
                                عهد سواقين مفتوحة بمبلغ <strong>@Money(_s!.CustodyOutstanding) ج.م</strong> لسه ماتسوّتش
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

            @if (CanSeeFinance)
            {
                <div class="v3-card v3-card-full v3-card-customers">

                    <div class="v3-head">
                        <div class="v3-head-right">
                            <div class="v3-icon-box v3-icon-purple" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="20" height="20"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                </svg>
                            </div>
                            <div>
                                <div class="v3-title">أعلى العملاء</div>
                                <div class="v3-subtitle">Top Customers — آخر 3 شهور</div>
                            </div>
                        </div>
                        <div class="v3-head-chip">
                            <svg viewBox="0 0 16 16" width="11" height="11"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <circle cx="8" cy="8" r="6"/>
                                <path d="M8 5v3l2 1" stroke-linecap="round"/>
                            </svg>
                            آخر 3 شهور
                        </div>
                    </div>

                    <div class="v3-body v3-body-flush">
                        @if (!_top.Any())
                        {
                            <div class="v3-empty">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                                <span>مافيش فواتير في الفترة دي</span>
                            </div>
                        }
                        else
                        {
                            <div class="v3-table-wrap">
                                <table class="v3-table" aria-label="جدول أعلى العملاء">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col" class="th-start">العميل</th>
                                            <th scope="col">فواتير</th>
                                            <th scope="col">الإيراد</th>
                                            <th scope="col">المحصّل</th>
                                            <th scope="col">المتبقي</th>
                                            <th scope="col">التحصيل</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (c, ci) in _top.Select((x, i) => (x, i + 1)))
                                        {
                                            var remaining = c.Invoiced - c.Paid;
                                            var paidPct   = c.Invoiced > 0
                                                ? (double)(c.Paid / c.Invoiced * 100)
                                                : 0;

                                            <tr>
                                                <td>
                                                    <span class="v3-rank v3-rank-@ci">@ci</span>
                                                </td>
                                                <td class="td-start">
                                                    <div class="v3-customer">
                                                        <div class="v3-avatar @(ci <= 3 ? $"v3-avatar-{ci}" : "")">
                                                            @(c.CustomerName.Length > 0
                                                                ? c.CustomerName[0].ToString()
                                                                : "؟")
                                                        </div>
                                                        <strong>@c.CustomerName</strong>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="v3-inv-chip">@c.Invoices</span>
                                                </td>
                                                <td class="td-money">
                                                    @Money(c.Invoiced)
                                                    <small>ج.م</small>
                                                </td>
                                                <td class="td-money td-muted">
                                                    @Money(c.Paid)
                                                    <small>ج.م</small>
                                                </td>
                                                <td>
                                                    <span class="@(remaining > 0 ? "v3-due" : "v3-paid")">
                                                        @Money(remaining)
                                                        <small>ج.م</small>
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="v3-pct-cell">
                                                        <div class="v3-pct-track">
                                                            <div class="v3-pct-fill @(paidPct >= 80 ? "fill-green" : paidPct >= 50 ? "fill-amber" : "fill-red")"
                                                                 style="width:@paidPct%"></div>
                                                        </div>
                                                        <span class="v3-pct-label @(paidPct >= 80 ? "pct-green" : paidPct >= 50 ? "pct-amber" : "pct-red")">
                                                            @paidPct.ToString("0")%
                                                        </span>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
        @* ── Footer ── *@
        <footer class="home-footer">
            <span>FastCom ERP © @DateTime.Now.Year</span>
            <span aria-hidden="true">·</span>
            <span>@_company.DisplayName</span>
        </footer>


        @* ⚡ FAB — الإجراءات السريعة (أسفل يسار الشاشة) *@
        @if (_fabOpen)
        {
            <div class="fc-fab-scrim" @onclick="CloseFab"></div>
        }

        <div class="fc-fab-wrap @(_fabOpen ? "is-open" : "") @(_fabHidden ? "fc-fab-hidden" : "")">
            <div class="fc-fab-menu" role="menu" aria-label="الإجراءات السريعة">
                @foreach (var q in QuickActions)
                {
                    <button type="button" class="fc-fab-item" role="menuitem" @onclick="() => Go(q.Url)">
                        <span class="fc-fab-ic"><MudIcon Icon="@q.Icon" Size="Size.Small" /></span>
                        <span class="fc-fab-lb">@q.Label</span>
                    </button>
                }
            </div>

            <button type="button" class="fc-fab" @onclick="ToggleFab" @onkeydown="OnFabKeyDown"
                    aria-label="الإجراءات السريعة" aria-expanded="@(_fabOpen ? "true" : "false")">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" />
            </button>
        </div>
    </div>
}


@code {
    private CompanyInfo _company = new();
    private AuthUser?   _user;
    private Summary?    _s;
    private TrendsOut?  _trends;
    private List<AlertItem>    _alerts    = new();
    private List<MonthFlow>    _flow      = new();
    private List<TopCustomer>  _top       = new();
    private List<StatusCount>  _opsStatus = new();
    private List<StatusCount>  _fleet     = new();
    private List<ActivityItem> _activity  = new();
    private AgingOut? _aging;
    private bool _loading = true;
    private string _lastUpdated = "—";
    private Timer? _timer;
    private readonly CancellationTokenSource _cts = new();

    private bool CanSeeFinance =>
        _user is not null &&
        (_user.Can("INVOICE.VIEW") || _user.Can("TREASURY.VIEW"));

    /* ── Helpers ── */
    private static string Money(decimal v) => v.ToString("N0");
    private void GoReports() => Nav.NavigateTo("/reports");

    /* ── ⚡ الإجراءات السريعة (FAB) ── */
    private bool _fabOpen;
    private bool _fabHidden;   // يختفي في أول الصفحة ويظهر بعد تمرير 280px

    private sealed record QuickAction(string Label, string Url, string Icon);

    private static readonly QuickAction[] QuickActions =
    {
        new("عملية جديدة", "/operations/new", Icons.Material.Filled.LocalShipping),
        new("حجز جديد", "/bookings/new", Icons.Material.Filled.Inventory2),
        new("رحلة جديدة", "/trips/new", Icons.Material.Filled.AirportShuttle),
        new("مصروف جديد", "/expenses/new", Icons.Material.Filled.Payments),
    };

    private void ToggleFab() => _fabOpen = !_fabOpen;
    private void CloseFab() => _fabOpen = false;

    // يخفي/يظهر الـ FAB حسب موضع التمرير (JS event على window) — الصفحة تبقى نظيفة في الهيرو
    private async Task OnScroll()
    {
        try
        {
            var y = await Js.InvokeAsync<int>("eval", "window.scrollY");
            var hidden = y < 280;
            if (hidden != _fabHidden) { _fabHidden = hidden; StateHasChanged(); }
        }
        catch (JSDisconnectedException) { /* الصفحة اتقفلت */ }
    }

    private void OnFabKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _fabOpen = false;
    }

    private void Go(string url)
    {
        _fabOpen = false;   // نقفل قبل التنقل عشان الحالة ما تفضلش مفتوحة
        Nav.NavigateTo(url);
    }

    /* ── Lifecycle ── */
    protected override async Task OnInitializedAsync()
    {
        _company = await Company.GetAsync();
        _user    = await Auth.GetUserAsync();
        await LoadAsync();

        // 🔄 تحديث تلقائي كل 5 دقائق
        _timer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await LoadAsync(silent: true);
        }), null, TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // نربط تمرير الـ window عشان نظافرة الهيرو (والـ FAB يظهر بعد النزول)
            await OnScroll();
        }
    }

    private async Task Reload() => await LoadAsync();

    private async Task LoadAsync(bool silent = false)
    {
        if (!silent) { _loading = true; StateHasChanged(); }
        try
        {
            _s         = await Http.GetFromJsonAsync<Summary>("api/dashboard/summary", _cts.Token);
            _alerts    = await Http.GetFromJsonAsync<List<AlertItem>>("api/dashboard/alerts?take=5", _cts.Token) ?? new();
            _flow      = await Http.GetFromJsonAsync<List<MonthFlow>>("api/dashboard/monthly", _cts.Token) ?? new();
            _trends    = await Http.GetFromJsonAsync<TrendsOut>("api/dashboard/trends", _cts.Token);
            _opsStatus = await Http.GetFromJsonAsync<List<StatusCount>>("api/dashboard/operation-status-breakdown", _cts.Token) ?? new();
            _fleet     = await Http.GetFromJsonAsync<List<StatusCount>>("api/dashboard/fleet-status", _cts.Token) ?? new();
            _activity  = await Http.GetFromJsonAsync<List<ActivityItem>>("api/dashboard/recent-activity?take=8", _cts.Token) ?? new();

            if (CanSeeFinance)
            {
                _top   = await Http.GetFromJsonAsync<List<TopCustomer>>("api/dashboard/top-customers?take=5", _cts.Token) ?? new();
                _aging = await Http.GetFromJsonAsync<AgingOut>("api/dashboard/receivables-aging", _cts.Token);
            }

            _lastUpdated = DateTime.Now.ToString("HH:mm");
        }
        catch (OperationCanceledException) { /* التحديث التلقائي اتلغى — عادي */ }
        catch (Exception ex)
        {
            // 🔴 الرئيسية ماتقعش لو فيه endpoint مفقود — نسجل ونكمّل
            Console.WriteLine("Home LoadAsync: " + ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
    }
}

