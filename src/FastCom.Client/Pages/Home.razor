    @@media (max-width: 680px) {
        .home-hero      { padding: 18px 14px 80px; }
        .hero-title     { font-size: 20px; }
        .hero-kpis      { grid-template-columns: repeat(2, 1fr); }
        .v3-ops-grid    { grid-template-columns: repeat(2, 1fr); }
        .home-content   { padding: 0 12px 16px; margin-top: -60px; }
        .hfin           { flex: 0 0 100%; }
