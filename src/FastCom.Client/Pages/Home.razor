@page "/"

<PageTitle>الرئيسية — @_company.DisplayName</PageTitle>

@inject CompanyService Company

@* ── الترويسة ─────────────────────────────────────────────────────────── *@
<div class="page-hero">
    <div>
        <MudText Typo="Typo.h4">أهلًا بك </MudText>
        <MudText Typo="Typo.body1" Class="muted mt-1">
            @_company.DisplayName — نظام إدارة مكتب نقل الحاويات والموانئ
        </MudText>
    </div>
    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Construction">
        Step 3 — الواجهة لسه بتتبنى
    </MudChip>
</div>

@* ── كروت المؤشرات (placeholder لحد Step 12) ─────────────────────────── *@
<MudGrid Class="mt-6">
    @foreach (var k in _kpis)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="kpi-card pa-5" Elevation="0">
                <div class="kpi-icon" style="background:@k.Color20">
                    <MudIcon Icon="@k.Icon" Color="Color.Primary" />
                </div>
                <MudText Typo="Typo.h4" Class="kpi-value">@k.Value</MudText>
                <MudText Typo="Typo.body2" Class="muted">@k.Label</MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@* ── حالة المشروع ────────────────────────────────────────────────────── *@
<MudPaper Class="pa-6 mt-6" Elevation="0">
    <MudText Typo="Typo.h5">
        <MudIcon Icon="@Icons.Material.Filled.Route" Class="ml-1" />
        خطة البناء
    </MudText>

    <MudList T="string" Dense="true" Class="mt-3">
        @foreach (var s in _steps)
        {
            <MudListItem T="string" Icon="@s.Icon" IconColor="@s.Color">
                <MudText Typo="Typo.body1">
                    <strong>@s.Name</strong>
                    <MudText Typo="Typo.caption" Class="muted mr-2">@s.Note</MudText>
                </MudText>
            </MudListItem>
        }
    </MudList>
</MudPaper>

@code {
    private CompanyInfo _company = new();

    protected override async Task OnInitializedAsync()
        => _company = await Company.GetAsync();

    private record Kpi(string Label, string Value, string Icon, string Color20);

    private readonly Kpi[] _kpis =
    {
        new("عمليات مفتوحة",  "—", Icons.Material.Filled.LocalShipping, "#E3EEF8"),
        new("فواتير غير محصّلة", "—", Icons.Material.Filled.ReceiptLong, "#FDF3DC"),
        new("عهد مفتوحة",     "—", Icons.Material.Filled.Savings,       "#E4F4EC"),
        new("رحلات اليوم",    "—", Icons.Material.Filled.AirportShuttle,"#EAF2F8"),
    };

    private record Step(string Name, string Note, string Icon, Color Color);

    private readonly Step[] _steps =
    {
        new("قاعدة البيانات", "68 جدول · 7 Views · 8 Triggers", Icons.Material.Filled.CheckCircle, Color.Success),
        new("هيكل المشروع",  "61 Entity · Build succeeded",     Icons.Material.Filled.CheckCircle, Color.Success),
        new("الواجهة",       "Blazor WASM + MudBlazor + RTL",   Icons.Material.Filled.HourglassTop, Color.Warning),
        new("المستخدمين والصلاحيات", "107 صلاحية · 11 دور",     Icons.Material.Filled.RadioButtonUnchecked, Color.Default),
        new("البيانات الأساسية",     "عملاء · موانئ · خدمات",  Icons.Material.Filled.RadioButtonUnchecked, Color.Default),
        new("الحجوزات",       "Booking + Containers",            Icons.Material.Filled.RadioButtonUnchecked, Color.Default),
        new("العمليات والرحلات", "Trips + Custody + Expenses",   Icons.Material.Filled.RadioButtonUnchecked, Color.Default),
        new("الفواتير والتحصيل", "Invoices + Payments",          Icons.Material.Filled.RadioButtonUnchecked, Color.Default),
        new("التقارير",       "ربحية · أداء · Dashboard",        Icons.Material.Filled.RadioButtonUnchecked, Color.Default),
    };
}
