@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("SUPPLIER.VIEW")   ?? false;
    private bool CanCreate => _user?.Can("SUPPLIER.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("SUPPLIER.EDIT")   ?? false;

    private static readonly (string Key, string Value)[] _statusTabs =
    {
        ("all",       "الكل"),
        ("Posted",    "مسجّلة"),
        ("Cancelled", "ملغاة"),
        ("Returned",  "مرتجعة")
    };

    private List<Item> _items = new();
    private List<Opt> _suppliers = new();
    private List<Opt> _methods = new();
    private bool _loading = true;
    private bool _busy;
    private bool _fabOpen;
    private string _search = "";
    private string _tab = "all";
    private string _supFilter = "";
    private string _methodFilter = "";
    private string? _msg;
    private bool _ok = true;
    private Detail? _detail;
    private Item? _voidTarget;

    private decimal PostedTotal => _items.Where(p => p.Status == "Posted").Sum(p => p.Amount);
    private int CancelledCount => _items.Count(p => p.Status == "Cancelled");

    private IEnumerable<Item> Filtered => _items
        .Where(p => _tab == "all" || p.Status == _tab)
        .Where(p => string.IsNullOrEmpty(_supFilter) || p.SupplierId.ToString() == _supFilter)
        .Where(p => string.IsNullOrEmpty(_methodFilter) || p.PaymentMethodId.ToString() == _methodFilter)
        .Where(p => string.IsNullOrWhiteSpace(_search)
                 || NormalizeArabic(p.SupplierPaymentNumber).Contains(NormalizeArabic(_search))
                 || NormalizeArabic(p.SupplierName).Contains(NormalizeArabic(_search))
                 || NormalizeArabic(p.ChequeNumber ?? "").Contains(NormalizeArabic(_search)));

    private static string NormalizeArabic(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        string[] diacritics = new[] { "َ", "ُ", "ِ", "ّ", "ً", "ٌ", "ٍ", "ْ", "ـ" };
        foreach (var d in diacritics) s = s.Replace(d, "");
        return s
            .Replace('أ', 'ا').Replace('إ', 'ا').Replace('آ', 'ا').Replace('ٱ', 'ا').Replace('ء', 'ا')
            .Replace('ة', 'ه').Replace('ى', 'ي').Replace('ؤ', 'و').Replace('ئ', 'ي')
            .Replace("  ", " ").ToLowerInvariant().Trim();
    }

    private static string Money(decimal v) => v.ToString("N2");

    private static string StatusAr(string s) => s switch
    {
        "Posted"    => "مسجّلة",
        "Cancelled" => "ملغاة",
        "Returned"  => "مرتجعة",
        _           => s
    };

    private static string StatusChipClass(string s) => s switch
    {
        "Posted"    => "chip-s-posted",
        "Cancelled" => "chip-s-cancelled",
        "Returned"  => "chip-s-returned",
        _           => "chip-s-posted"
    };

    private static string StatusDotClass(string s) => s switch
    {
        "Posted"    => "sdotc-posted",
        "Cancelled" => "sdotc-cancelled",
        "Returned"  => "sdotc-returned",
        _           => "sdotc-posted"
    };

    private static string AvatarClass(string s) => s switch
    {
        "Posted"    => "av-posted",
        "Cancelled" => "av-cancelled",
        "Returned"  => "av-returned",
        _           => "av-posted"
    };

    private static string StatusDotColor(string s) => s switch
    {
        "all"       => "sdot-all",
        "Posted"    => "sdot-posted",
        "Cancelled" => "sdot-cancelled",
        "Returned"  => "sdot-returned",
        _           => "sdot-all"
    };

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) { _loading = false; return; }

        _suppliers = await SafeOpts("api/options/suppliers");
        _methods   = await SafeOpts("api/options/payment-methods");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/supplier-payments") ?? new(); }
        catch (Exception ex) { _ok = false; _msg = "تعذّر تحميل دفعات الموردين: " + ex.Message; }
        finally { _loading = false; }
    }

    private async Task<List<Opt>> SafeOpts(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Opt>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task Reload() { _msg = null; await LoadAsync(); }
    private void SetTab(string s) { _tab = s; }
    private void ToggleFab() => _fabOpen = !_fabOpen;
    private void GoNew() => Nav.NavigateTo("/supplier-payments/new");

    private async Task ShowDetail(Item p)
    {
        try
        {
            _detail = await Http.GetFromJsonAsync<Detail>($"api/supplier-payments/{p.SupplierPaymentId}");
        }
        catch (Exception ex) { _ok = false; _msg = "تعذّر تحميل التفاصيل: " + ex.Message; }
    }

    private void AskVoid(Item p) { _voidTarget = p; }

    private async Task DoVoid()
    {
        if (_voidTarget is null) return;
        _busy = true;
        try
        {
            var res = await Http.PostAsync($"api/supplier-payments/{_voidTarget.SupplierPaymentId}/void", null);
            var m = await MsgOf(res);
            _msg = res.IsSuccessStatusCode ? "تم إلغاء السند بنجاح" : m;
            _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            {
                _voidTarget = null;
                await LoadAsync();
                Snackbar.Add("تم إلغاء السند بنجاح", Severity.Success);
            }
            else
            {
                Snackbar.Add(m, Severity.Error);
            }
        }
        catch (Exception ex) { _ok = false; _msg = "تعذّر الإلغاء: " + ex.Message; }
        finally { _busy = false; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم الحفظ" : $"حدث خطأ {(int)res.StatusCode}"; }
    }

    public class Item
    {
        public long SupplierPaymentId { get; set; }
        public string SupplierPaymentNumber { get; set; } = "";
        public int SupplierId { get; set; }
        public string SupplierName { get; set; } = "";
        public string PaymentDate { get; set; } = "";
        public int PaymentMethodId { get; set; }
        public string MethodName { get; set; } = "";
        public decimal Amount { get; set; }
        public string? ChequeNumber { get; set; }
        public string? BankAccount { get; set; }
        public string Status { get; set; } = "";
        public string? Notes { get; set; }
        public int InvoiceCount { get; set; }
    }

    public class Alloc
    {
        public long SupplierInvoiceId { get; set; }
        public string SupplierInvoiceNumber { get; set; } = "";
        public decimal AllocatedAmount { get; set; }
    }

    public class Detail
    {
        public long SupplierPaymentId { get; set; }
        public string SupplierPaymentNumber { get; set; } = "";
        public int SupplierId { get; set; }
        public string SupplierName { get; set; } = "";
        public string PaymentDate { get; set; } = "";
        public int PaymentMethodId { get; set; }
        public string MethodName { get; set; } = "";
        public decimal Amount { get; set; }
        public string? ChequeNumber { get; set; }
        public string? ChequeDate { get; set; }
        public string? BankAccount { get; set; }
        public string Status { get; set; } = "";
        public string? Notes { get; set; }
        public List<Alloc> Allocations { get; set; } = new();
    }

    public class Opt
    {
        public int Id { get; set; }
        public string Label { get; set; } = "";
    }
}