@page "/supplier-payments"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>دفعات الموردين — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">المالية · الذمم الدائنة</div>
                <h1 class="fc-hero-title">دفعات الموردين</h1>
                <p class="fc-hero-sub">سندات الصرف للموردين — بتتوزّع تلقائيًا على فواتيرهم المفتوحة (الأقدم أولًا)</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="GoNew">دفعة جديدة</MudButton>
                }
            </div>
        </div>
        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">عدد الدفعات</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                    <div><div class="fc-kpi-num">@Money(PostedTotal)</div><div class="fc-kpi-lb">إجمالي المسجّل</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Cancel" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(p => p.Status == "Cancelled")</div><div class="fc-kpi-lb">ملغاة</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.Receipt" /></div>
                    <div><div class="fc-kpi-num">@_items.Sum(p => p.InvoiceCount)</div><div class="fc-kpi-lb">فواتير مسدّدة</div></div></div>
            </div>
        }
    </div>
</div>

<div class="fc-page">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">ليس لديك صلاحية عرض دفعات الموردين.</MudAlert>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">
            <div class="fc-toolbar">
                <div class="fc-filters">
                    <button class='@TabClass("")' @onclick='() => SetTab("")'>الكل</button>
                    <button class='@TabClass("Posted")' @onclick='() => SetTab("Posted")'>مسجّلة</button>
                    <button class='@TabClass("Cancelled")' @onclick='() => SetTab("Cancelled")'>ملغاة</button>
                </div>
                <MudTextField T="string" Value="_search" ValueChanged="v => _search = v"
                              Placeholder="ابحث بالرقم أو المورد أو الشيك..." Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="fc-search-box" Immediate="true" />
                <span class="fc-count">عرض @Filtered.Count() من @_items.Count</span>
            </div>

            @if (_loading)
            {
                <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else
            {
                <div class="fc-table-wrap"><table class="fc-table fc-table-pro">
                    <thead><tr><th>الرقم</th><th>التاريخ</th><th>المورد</th><th>طريقة الدفع</th>
                        <th style="text-align:left">المبلغ</th><th>فواتير</th><th>الحالة</th>
                        @if (CanEdit) { <th style="width:110px; text-align:left">إجراءات</th> }</tr></thead>
                    <tbody>
                        @foreach (var p in Filtered)
                        {
                            <tr>
                                <td><span class="fc-role-chip">@p.SupplierPaymentNumber</span></td>
                                <td class="fc-cell-sub">@p.PaymentDate</td>
                                <td><div class="fc-cell-main">@p.SupplierName</div></td>
                                <td><div class="fc-cell-main">@p.MethodName</div>
                                    @if (!string.IsNullOrWhiteSpace(p.ChequeNumber))
                                    {
                                        <div class="fc-cell-sub">شيك @p.ChequeNumber</div>
                                    }</td>
                                <td class="is-neg" style="text-align:left; font-weight:800">@Money(p.Amount)</td>
                                <td>@p.InvoiceCount</td>
                                <td><span class="@StatusCls(p.Status)">@StatusAr(p.Status)</span></td>
                                @if (CanEdit)
                                {
                                    <td><div class="fc-row-actions">
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Assessment"
                                                       title="التفاصيل" OnClick="() => ShowDetail(p)" />
                                        @if (p.Status == "Posted")
                                        {
                                            @if (_voidId == p.SupplierPaymentId)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                                           OnClick="() => Void(p)">متأكد؟</MudButton>
                                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                                               OnClick="() => _voidId = null" />
                                            }
                                            else
                                            {
                                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.DeleteOutline"
                                                               Color="Color.Error" title="إلغاء الدفعة"
                                                               OnClick="() => _voidId = p.SupplierPaymentId" />
                                            }
                                        }
                                    </div></td>
                                }
                            </tr>
                        }
                        @if (!Filtered.Any())
                        {
                            <tr><td colspan="8"><div class="fc-empty"><div>مافيش دفعات مطابقة</div></div></td></tr>
                        }
                    </tbody>
                </table></div>
            }
        </div></div>
    }
</div>

@* ── مودال التفاصيل (للعرض بس — مافيش تعديل على دفعة مسجّلة) ── *@
@if (_detail is not null)
{
    <div class="fc-modal-backdrop" @onclick="() => _detail = null">
        <div class="fc-modal" @onclick:stopPropagation="true">
            <div class="fc-modal-head">
                <div>
                    <div class="fc-modal-title">@_detail.SupplierPaymentNumber</div>
                    <div class="fc-modal-sub">@_detail.SupplierName · @_detail.PaymentDate · @_detail.MethodName</div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _detail = null" />
            </div>
            <div class="fc-modal-body">
                <div class="fc-stats">
                    <div class="fc-stat"><div class="fc-stat-lb">المبلغ</div>
                        <div class="fc-stat-num is-neg">@Money(_detail.Amount)</div></div>
                    <div class="fc-stat"><div class="fc-stat-lb">الحالة</div>
                        <div class="fc-stat-num">@StatusAr(_detail.Status)</div></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_detail.ChequeNumber))
                {
                    <div class="fc-panel-sub" style="margin:16px 0 6px">بيانات الشيك</div>
                    <div class="fc-cell-sub">شيك @_detail.ChequeNumber @(_detail.ChequeDate is null ? "" : "· استحقاق " + _detail.ChequeDate)</div>
                }
                @if (!string.IsNullOrWhiteSpace(_detail.BankAccount))
                {
                    <div class="fc-panel-sub" style="margin:16px 0 6px">الحساب</div>
                    <div class="fc-cell-sub">@_detail.BankAccount</div>
                }
                <div class="fc-panel-sub" style="margin:16px 0 6px">اتوزّعت على @(_detail.Allocations.Count) فاتورة</div>
                <div class="fc-table-wrap"><table class="fc-table">
                    <thead><tr><th>الفاتورة</th><th style="text-align:left">المسدد منها</th></tr></thead>
                    <tbody>
                        @foreach (var a in _detail.Allocations)
                        {
                            <tr><td><span class="fc-role-chip">@a.SupplierInvoiceNumber</span></td>
                                <td style="text-align:left; font-weight:700">@Money(a.AllocatedAmount)</td></tr>
                        }
                        @if (!_detail.Allocations.Any())
                        {
                            <tr><td colspan="2"><div class="fc-empty"><div>مافيش توزيع</div></div></td></tr>
                        }
                    </tbody>
                </table></div>
                @if (!string.IsNullOrWhiteSpace(_detail.Notes))
                {
                    <div class="fc-panel-sub" style="margin:16px 0 6px">ملاحظات</div>
                    <div class="fc-cell-sub">@_detail.Notes</div>
                }
            </div>
            <div class="fc-modal-foot">
                <MudButton Variant="Variant.Outlined" OnClick="() => _detail = null">إغلاق</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("SUPPLIER.VIEW") ?? false;
    private bool CanCreate => _user?.Can("SUPPLIER.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("SUPPLIER.EDIT") ?? false;

    private bool _loading = true;
    private string _search = "";
    private string _status = "";
    private long? _voidId;
    private List<Item> _items = new();
    private Detail? _detail;

    public class Item
    {
        public long SupplierPaymentId { get; set; }
        public string SupplierPaymentNumber { get; set; } = "";
        public int SupplierId { get; set; }
        public string SupplierName { get; set; } = "";
        public string PaymentDate { get; set; } = "";
        public int PaymentMethodId { get; set; }
        public string MethodName { get; set; } = "";
        public decimal Amount { get; set; }
        public string? ChequeNumber { get; set; }
        public string? BankAccount { get; set; }
        public string Status { get; set; } = "";
        public string? Notes { get; set; }
        public int InvoiceCount { get; set; }
    }

    public class Alloc
    {
        public long SupplierInvoiceId { get; set; }
        public string SupplierInvoiceNumber { get; set; } = "";
        public decimal AllocatedAmount { get; set; }
    }

    public class Detail
    {
        public long SupplierPaymentId { get; set; }
        public string SupplierPaymentNumber { get; set; } = "";
        public int SupplierId { get; set; }
        public string SupplierName { get; set; } = "";
        public string PaymentDate { get; set; } = "";
        public int PaymentMethodId { get; set; }
        public string MethodName { get; set; } = "";
        public decimal Amount { get; set; }
        public string? ChequeNumber { get; set; }
        public string? ChequeDate { get; set; }
        public string? BankAccount { get; set; }
        public string Status { get; set; } = "";
        public string? Notes { get; set; }
        public List<Alloc> Allocations { get; set; } = new();
    }

    private decimal PostedTotal => _items.Where(p => p.Status == "Posted").Sum(p => p.Amount);

    private IEnumerable<Item> Filtered => _items
        .Where(p => string.IsNullOrEmpty(_status) || p.Status == _status)
        .Where(p => string.IsNullOrWhiteSpace(_search)
                 || p.SupplierPaymentNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || p.SupplierName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || (p.ChequeNumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
        else _loading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/supplier-payments") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task Reload() { await LoadAsync(); Snackbar.Add("اتحدّث", Severity.Info); }
    private void SetTab(string s) { _status = s; }
    private void GoNew() => Nav.NavigateTo("/supplier-payments/new");

    private async Task ShowDetail(Item p)
    {
        try { _detail = await Http.GetFromJsonAsync<Detail>($"api/supplier-payments/{p.SupplierPaymentId}"); }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Void(Item p)
    {
        try
        {
            var res = await Http.PostAsync($"api/supplier-payments/{p.SupplierPaymentId}/void", null);
            var m = await MsgOf(res);
            Snackbar.Add(m, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _voidId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    /* ── تنسيق ── */
    private string TabClass(string k) => _status == k ? "fc-filter on" : "fc-filter";
    private static string Money(decimal v) => v.ToString("N2");

    private static string StatusAr(string s) => s switch
    {
        "Posted"    => "مسجّلة",
        "Cancelled" => "ملغاة",
        "Returned"  => "مرتجعة",
        _           => s
    };

    private static string StatusCls(string s) => s switch
    {
        "Posted"    => "fc-chip-ok",
        "Cancelled" => "fc-chip-gray",
        "Returned"  => "fc-chip-warn",
        _           => "fc-chip-gray"
    };

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
