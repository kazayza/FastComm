@page "/supplier-payments"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>دفعات الموردين — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="sp-hero-row">
                <div class="sp-hero-left">
                    <div class="sp-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                        <span>المالية · الذمم الدائنة</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">دفعات الموردين</h1>
                    <span class="sp-hero-sub">سندات صرف الموردين — يتم توزيعها تلقائياً على الفواتير المفتوحة (الأقدم أولاً)</span>
                </div>

                <div class="sp-hero-right">
                    <button class="sp-hero-refresh" @onclick="Reload" title="تحديث البيانات">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 4v6h-6"/>
                            <path d="M1 20v-6h6"/>
                            <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                        </svg>
                    </button>
                    @if (CanCreate)
                    {
                        <button class="sp-hero-add" @onclick="GoNew">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            دفعة مورد جديدة
                        </button>
                    }
                    <span class="sp-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

        </div>

        @if (CanView && !_loading)
        {
            <div class="sp-kpis-strip">

                <div class="sp-kpi-item">
                    <div class="sp-kpi-icon kpi-blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="sp-kpi-text">
                        <div class="sp-kpi-label">إجمالي السندات</div>
                        <div class="sp-kpi-val">@_items.Count</div>
                    </div>
                </div>

                <div class="sp-kpi-div" aria-hidden="true"></div>

                <div class="sp-kpi-item">
                    <div class="sp-kpi-icon kpi-green" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="sp-kpi-text">
                        <div class="sp-kpi-label">إجمالي المدفوع الفعلي</div>
                        <div class="sp-kpi-val kpi-val-green">@Money(PostedTotal) <small>ج.م</small></div>
                    </div>
                </div>

                <div class="sp-kpi-div" aria-hidden="true"></div>

                <div class="sp-kpi-item">
                    <div class="sp-kpi-icon kpi-red" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="sp-kpi-text">
                        <div class="sp-kpi-label">السندات الملغاة</div>
                        <div class="sp-kpi-val kpi-val-red">@CancelledCount</div>
                    </div>
                </div>

                <div class="sp-kpi-div" aria-hidden="true"></div>

                <div class="sp-kpi-item">
                    <div class="sp-kpi-icon kpi-amber" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 11l3 3L22 4"/>
                            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                        </svg>
                    </div>
                    <div class="sp-kpi-text">
                        <div class="sp-kpi-label">فواتير مسددة كلياً أو جزئياً</div>
                        <div class="sp-kpi-val kpi-val-amber">@_items.Sum(p => p.InvoiceCount)</div>
                    </div>
                </div>

            </div>
        }

    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="sp-body">

    @if (!CanView)
    {
        <div class="sp-state-box">
            <div class="sp-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية لعرض دفعات الموردين. تواصل مع مدير النظام لتفعيل الصلاحية.</p>
        </div>
    }
    else
    {
        <div class="sp-card">

            @* ── Toolbar ── *@
            <div class="sp-toolbar">

                <div class="sp-search-wrap">
                    <svg class="sp-search-icon" viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="sp-search-input"
                           placeholder="بحث برقم السند أو المورد أو رقم الشيك..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="بحث في الدفعات" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="sp-search-clear" @onclick="() => _search = string.Empty" title="مسح البحث">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="sp-filter-wrap">
                    <svg class="sp-filter-icon" viewBox="0 0 24 24" width="13" height="13"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <select class="sp-filter-select" @bind="_supFilter" aria-label="تصفية حسب المورد">
                        <option value="">جميع الموردين</option>
                        @foreach (var s in _suppliers)
                        {
                            <option value="@s.Id">@s.Label</option>
                        }
                    </select>
                </div>

                <div class="sp-filter-wrap">
                    <svg class="sp-filter-icon" viewBox="0 0 24 24" width="13" height="13"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="2" y="6" width="20" height="12" rx="2"/>
                        <line x1="2" y1="10" x2="22" y2="10"/>
                    </svg>
                    <select class="sp-filter-select" @bind="_methodFilter" aria-label="تصفية حسب طريقة الدفع">
                        <option value="">جميع طرق الدفع</option>
                        @foreach (var m in _methods)
                        {
                            <option value="@m.Id">@m.Label</option>
                        }
                    </select>
                </div>

                <div class="sp-results-badge">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>
                    </svg>
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>

            </div>


            @* ── Status Tabs ── *@
            <div class="sp-status-bar">
                <div class="sp-status-tabs" role="group" aria-label="تصفية حسب الحالة">
                    @foreach (var t in _statusTabs)
                    {
                        var cnt = t.Key == "all"
                            ? _items.Count
                            : _items.Count(x => x.Status == t.Key);

                        <button class="sp-status-tab @(_tab == t.Key ? "active" : "")"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="sp-tab-dot @StatusDotColor(t.Key)" aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="sp-tab-count">@cnt</span>
                        </button>
                    }
                </div>
            </div>


            @* ── Banner ── *@
            @if (_msg is not null)
            {
                <div class="sp-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <div aria-hidden="true">
                        @if (_ok)
                        {
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                            </svg>
                        }
                    </div>
                    <span>@_msg</span>
                    <button class="banner-close" @onclick="() => _msg = null">✕</button>
                </div>
            }


            @* ── Content ── *@
            @if (_loading)
            {
                <div class="sp-loading">
                    <div class="sp-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل دفعات الموردين...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="sp-empty">
                    <div class="sp-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <div class="sp-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) && _tab == "all" && string.IsNullOrEmpty(_supFilter) && string.IsNullOrEmpty(_methodFilter)
                            ? "لا توجد دفعات موردين مسجّلة"
                            : "لا توجد نتائج مطابقة لمعايير البحث")
                    </div>
                    <div class="sp-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search) && _tab == "all" && string.IsNullOrEmpty(_supFilter) && string.IsNullOrEmpty(_methodFilter)
                            ? "ابدأ بتسجيل أول سند صرف لأحد الموردين"
                            : "جرّب تعديل معايير التصفية أو مسح البحث")
                    </div>
                    @if (CanCreate && string.IsNullOrWhiteSpace(_search) && _tab == "all")
                    {
                        <button class="sp-add-btn" @onclick="GoNew">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            تسجيل دفعة مورد جديدة
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="sp-table-wrap">
                    <table class="sp-table" aria-label="قائمة دفعات الموردين">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">بيانات السند</th>
                                <th scope="col">تاريخ الصرف</th>
                                <th scope="col">طريقة الدفع</th>
                                <th scope="col">المبلغ المدفوع</th>
                                <th scope="col">التوزيع</th>
                                <th scope="col">الحالة</th>
                                @if (CanEdit)
                                {
                                    <th scope="col" style="width:120px">إجراءات</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Filtered)
                            {
                                <tr class="@(p.Status == "Cancelled" ? "row-cancelled" : "")">

                                    <td class="td-start">
                                        <div class="sp-pay-cell">
                                            <div class="sp-avatar @AvatarClass(p.Status)" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                                </svg>
                                            </div>
                                            <div class="sp-pay-info">
                                                <div class="sp-pay-num">
                                                    <span class="sp-code-chip">@p.SupplierPaymentNumber</span>
                                                </div>
                                                <div class="sp-supplier-name">@p.SupplierName</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="td-muted">
                                        <div class="sp-date-cell">
                                            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                                <rect x="2" y="3" width="12" height="11" rx="2"/>
                                                <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                                            </svg>
                                            @p.PaymentDate
                                        </div>
                                    </td>

                                    <td>
                                        <div class="sp-method-cell">
                                            <span class="sp-method-badge">@p.MethodName</span>
                                            @if (!string.IsNullOrWhiteSpace(p.ChequeNumber))
                                            {
                                                <div class="sp-cheque-tag">
                                                    <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                        <rect x="2" y="6" width="20" height="12" rx="2"/>
                                                        <line x1="2" y1="10" x2="22" y2="10"/>
                                                    </svg>
                                                    شيك رقم: @p.ChequeNumber
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <div class="sp-amount-cell">
                                            <div class="sp-amount-val">@Money(p.Amount)</div>
                                            <div class="sp-amount-cur">ج.م</div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="sp-inv-count-badge">
                                            <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                <path d="M14 2v6h6"/>
                                            </svg>
                                            @p.InvoiceCount فاتورة
                                        </span>
                                    </td>

                                    <td>
                                        <span class="sp-chip @StatusChipClass(p.Status)">
                                            <span class="sp-chip-dot @StatusDotClass(p.Status)" aria-hidden="true"></span>
                                            @StatusAr(p.Status)
                                        </span>
                                    </td>

                                    @if (CanEdit)
                                    {
                                        <td>
                                            <div class="sp-actions">
                                                <button class="sp-act-btn act-view"
                                                        @onclick="() => ShowDetail(p)"
                                                        title="عرض التفاصيل"
                                                        aria-label="عرض تفاصيل @p.SupplierPaymentNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                        <circle cx="12" cy="12" r="3"/>
                                                    </svg>
                                                </button>

                                                @if (p.Status == "Posted")
                                                {
                                                    <button class="sp-act-btn act-cancel"
                                                            @onclick="() => AskVoid(p)"
                                                            title="إلغاء السند"
                                                            aria-label="إلغاء @p.SupplierPaymentNumber">
                                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"/>
                                                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   MODAL — تفاصيل الدفعة
═══════════════════════════════════════════ *@
@if (_detail is not null)
{
    <div class="sp-modal-backdrop" @onclick="() => _detail = null"
         role="dialog" aria-modal="true" aria-label="تفاصيل الدفعة">
        <div class="sp-modal sp-modal-lg" @onclick:stopPropagation="true">

            <div class="sp-modal-head">
                <div class="sp-modal-icon detail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                </div>
                <div>
                    <div class="sp-modal-title">تفاصيل سند الصرف</div>
                    <div class="sp-modal-sub">@_detail.SupplierPaymentNumber · @_detail.SupplierName</div>
                </div>
                <button class="sp-modal-close" @onclick="() => _detail = null" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            <div class="sp-modal-body">

                @* ── Summary Cards ── *@
                <div class="sp-detail-summary">
                    <div class="sp-ds-item">
                        <div class="sp-ds-label">المبلغ الإجمالي</div>
                        <div class="sp-ds-val amount-val">@Money(_detail.Amount) <small>ج.م</small></div>
                    </div>
                    <div class="sp-ds-sep" aria-hidden="true"></div>
                    <div class="sp-ds-item">
                        <div class="sp-ds-label">تاريخ الصرف</div>
                        <div class="sp-ds-val">@_detail.PaymentDate</div>
                    </div>
                    <div class="sp-ds-sep" aria-hidden="true"></div>
                    <div class="sp-ds-item">
                        <div class="sp-ds-label">طريقة الدفع</div>
                        <div class="sp-ds-val">@_detail.MethodName</div>
                    </div>
                    <div class="sp-ds-sep" aria-hidden="true"></div>
                    <div class="sp-ds-item">
                        <div class="sp-ds-label">الحالة</div>
                        <div class="sp-ds-val">
                            <span class="sp-chip @StatusChipClass(_detail.Status)">
                                <span class="sp-chip-dot @StatusDotClass(_detail.Status)" aria-hidden="true"></span>
                                @StatusAr(_detail.Status)
                            </span>
                        </div>
                    </div>
                </div>

                @* ── Cheque & Bank Info ── *@
                @if (!string.IsNullOrWhiteSpace(_detail.ChequeNumber) || !string.IsNullOrWhiteSpace(_detail.BankAccount))
                {
                    <div class="sp-detail-section">
                        <div class="sp-detail-section-title">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="2" y="6" width="20" height="12" rx="2"/>
                                <line x1="2" y1="10" x2="22" y2="10"/>
                            </svg>
                            بيانات الشيك والحساب البنكي
                        </div>
                        <div class="sp-detail-info-grid">
                            @if (!string.IsNullOrWhiteSpace(_detail.ChequeNumber))
                            {
                                <div class="sp-info-item">
                                    <div class="sp-info-label">رقم الشيك</div>
                                    <div class="sp-info-val">@_detail.ChequeNumber</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_detail.ChequeDate))
                                {
                                    <div class="sp-info-item">
                                        <div class="sp-info-label">تاريخ استحقاق الشيك</div>
                                        <div class="sp-info-val">@_detail.ChequeDate</div>
                                    </div>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.BankAccount))
                            {
                                <div class="sp-info-item sp-info-full">
                                    <div class="sp-info-label">الحساب البنكي</div>
                                    <div class="sp-info-val">@_detail.BankAccount</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ── Allocations ── *@
                <div class="sp-detail-section">
                    <div class="sp-detail-section-title">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
                        </svg>
                        توزيع المبلغ على الفواتير
                        <span class="sp-count-badge">@_detail.Allocations.Count فاتورة</span>
                    </div>

                    @if (!_detail.Allocations.Any())
                    {
                        <div class="sp-alloc-empty">
                            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 8v4M12 16h.01"/>
                            </svg>
                            <span>لا يوجد توزيع لهذا السند</span>
                        </div>
                    }
                    else
                    {
                        <div class="sp-alloc-list">
                            @foreach (var a in _detail.Allocations)
                            {
                                <div class="sp-alloc-item">
                                    <div class="sp-alloc-left">
                                        <div class="sp-alloc-icon">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                <path d="M14 2v6h6"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="sp-alloc-label">رقم الفاتورة</div>
                                            <div class="sp-alloc-num">@a.SupplierInvoiceNumber</div>
                                        </div>
                                    </div>
                                    <div class="sp-alloc-right">
                                        <div class="sp-alloc-label">المبلغ المخصص</div>
                                        <div class="sp-alloc-amt">@Money(a.AllocatedAmount) <small>ج.م</small></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* ── Notes ── *@
                @if (!string.IsNullOrWhiteSpace(_detail.Notes))
                {
                    <div class="sp-detail-section">
                        <div class="sp-detail-section-title">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                            </svg>
                            ملاحظات
                        </div>
                        <div class="sp-notes-box">@_detail.Notes</div>
                    </div>
                }

            </div>

            <div class="sp-modal-foot">
                <button class="sp-modal-close-btn" @onclick="() => _detail = null">إغلاق</button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — تأكيد الإلغاء
═══════════════════════════════════════════ *@
@if (_voidTarget is not null)
{
    <div class="sp-modal-backdrop" @onclick="() => _voidTarget = null"
         role="dialog" aria-modal="true" aria-label="تأكيد إلغاء السند">
        <div class="sp-modal" @onclick:stopPropagation="true">

            <div class="sp-modal-head">
                <div class="sp-modal-icon cancel-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <div class="sp-modal-title">تأكيد إلغاء سند الصرف</div>
                    <div class="sp-modal-sub">@_voidTarget.SupplierPaymentNumber · @_voidTarget.SupplierName</div>
                </div>
                <button class="sp-modal-close" @onclick="() => _voidTarget = null" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            <div class="sp-modal-body">

                <div class="sp-void-summary">
                    <div class="sp-vs-item">
                        <div class="sp-vs-label">المبلغ</div>
                        <div class="sp-vs-val">@Money(_voidTarget.Amount) ج.م</div>
                    </div>
                    <div class="sp-vs-sep" aria-hidden="true"></div>
                    <div class="sp-vs-item">
                        <div class="sp-vs-label">طريقة الدفع</div>
                        <div class="sp-vs-val">@_voidTarget.MethodName</div>
                    </div>
                    <div class="sp-vs-sep" aria-hidden="true"></div>
                    <div class="sp-vs-item">
                        <div class="sp-vs-label">التوزيع</div>
                        <div class="sp-vs-val">@_voidTarget.InvoiceCount فاتورة</div>
                    </div>
                </div>

                <div class="sp-cancel-warn" role="alert">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                        <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                    </svg>
                    <div>
                        <strong>تنبيه: هذا الإجراء نهائي</strong>
                        <p>سيتم إلغاء السند وعكس جميع التوزيعات على الفواتير المرتبطة به. ستعود الفواتير لحالتها قبل السداد. لا يمكن التراجع عن هذا الإجراء.</p>
                    </div>
                </div>

            </div>

            <div class="sp-modal-foot">
                <button class="sp-modal-cancel-btn" @onclick="() => _voidTarget = null">تراجع</button>
                <button class="sp-modal-confirm-btn" @onclick="DoVoid" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الإلغاء...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                        <span>تأكيد الإلغاء</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


@* ── FAB ── *@
@if (CanCreate)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="GoNew">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                    </svg>
                </span>
                <span>سند صرف جديد</span>
            </button>
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="Reload">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M23 4v6h-6"/>
                        <path d="M1 20v-6h6"/>
                        <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                    </svg>
                </span>
                <span>تحديث البيانات</span>
            </button>
        </div>

        <div class="glow-fab-container">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="glow-fab-btn" @onclick="ToggleFab" aria-label="الإجراءات السريعة" aria-expanded="@(_fabOpen ? "true" : "false")">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

    </div>
}

@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
}


<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ── Hero ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px; margin: 0 auto; width: 100%;
        box-sizing: border-box; position: relative; z-index: 1;
    }
    .hero-wrapper .fc-hero {
        border-radius: 20px !important; overflow: hidden;
        box-shadow: 0 12px 32px rgba(13,38,84,.15), 0 4px 12px rgba(13,38,84,.08);
        border: 1px solid rgba(255,255,255,.08);
    }
    .hero-wrapper .fc-hero.fc-hero-slim { padding-top: 18px !important; padding-bottom: 22px !important; }

    .sp-hero-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .sp-hero-left { flex: 1; min-width: 200px; }
    .sp-hero-crumb { display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: rgba(255,255,255,.55); margin-bottom: 6px; }
    .sp-hero-sub { font-size: 13px; color: rgba(255,255,255,.55); }
    .sp-hero-right { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

    .sp-hero-chip {
        display: flex; align-items: center; gap: 6px;
        padding: 6px 12px; border-radius: 20px;
        background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
        font-size: 11.5px; color: #fff;
    }

    .sp-hero-refresh {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.08);
        color: rgba(255,255,255,.75); cursor: pointer; transition: background .15s;
    }
    .sp-hero-refresh:hover { background: rgba(255,255,255,.14); }

    .sp-hero-add {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; border-radius: 9px;
        border: none; background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .sp-hero-add:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }

    /* ── KPIs ── */
    .sp-kpis-strip {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px); margin-top: 14px;
    }
    .sp-kpi-item { flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px 16px; }
    .sp-kpi-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }
    .sp-kpi-icon {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
    }
    .kpi-blue  { background: rgba(30,110,245,.2); color: #93c5fd; }
    .kpi-amber { background: rgba(234,179,8,.2);  color: #fde68a; }
    .kpi-red   { background: rgba(239,68,68,.2);  color: #fca5a5; }
    .kpi-green { background: rgba(34,197,94,.2);  color: #86efac; }

    .sp-kpi-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .sp-kpi-val { font-size: 15px; font-weight: 900; color: #fff; margin-top: 2px; }
    .sp-kpi-val small { font-size: 10px; font-weight: 600; opacity: .7; }
    .kpi-val-amber { color: #fde68a; }
    .kpi-val-red { color: #fca5a5; }
    .kpi-val-green { color: #86efac; }

    /* ── Body ── */
    .sp-body {
        background: var(--fc-bg); min-height: calc(100vh - 200px);
        padding: 18px clamp(16px, 3vw, 40px) 96px;
        max-width: 1440px; width: 100%; margin: 0 auto;
        box-sizing: border-box;
    }

    .sp-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .sp-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .sp-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .sp-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .sp-state-box p { margin: 0; font-size: 13px; color: var(--fc-muted); }

    .sp-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    /* ── Toolbar ── */
    .sp-toolbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7; flex-wrap: wrap;
    }

    .sp-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px; max-width: 340px;
    }
    .sp-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }
    .sp-search-input {
        width: 100%; height: 38px; padding: 0 36px 0 12px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s, box-shadow .15s;
    }
    .sp-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .sp-search-input::placeholder { color: #b0bcc8; }
    .sp-search-clear {
        position: absolute; left: 10px;
        width: 22px; height: 22px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        border: none; background: #edf1f7; color: #8899ae; cursor: pointer;
    }
    .sp-search-clear:hover { background: #dde3ed; }

    .sp-filter-wrap {
        position: relative; display: flex; align-items: center;
        min-width: 150px; max-width: 200px;
    }
    .sp-filter-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; z-index: 1; }
    .sp-filter-select {
        width: 100%; height: 38px; padding: 0 32px 0 10px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none; cursor: pointer;
        -webkit-appearance: none; appearance: none;
    }
    .sp-filter-select:focus { border-color: var(--fc-blue); }

    .sp-results-badge {
        display: flex; align-items: center; gap: 5px;
        margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap;
    }
    .sp-results-badge strong { color: #5a6e88; }

    /* ── Status Tabs ── */
    .sp-status-bar {
        padding: 10px 18px;
        background: #f9fafd; border-bottom: 1px solid #edf1f7;
    }
    .sp-status-tabs { display: flex; gap: 4px; padding: 3px; border-radius: 10px; background: #f0f3f8; width: fit-content; }
    .sp-status-tab {
        display: flex; align-items: center; gap: 5px;
        height: 32px; padding: 0 12px; border: none; border-radius: 7px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 11px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s;
    }
    .sp-status-tab:hover:not(.active) { color: var(--fc-text); background: rgba(255,255,255,.6); }
    .sp-status-tab.active { background: var(--fc-card); color: var(--fc-text); box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800; }
    .sp-tab-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 7px; }
    .sp-tab-count {
        min-width: 16px; height: 16px; border-radius: 4px; padding: 0 3px;
        display: flex; align-items: center; justify-content: center;
        font-size: 9px; font-weight: 900;
    }
    .sp-status-tab.active .sp-tab-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .sp-status-tab:not(.active) .sp-tab-count { background: #e4eaf3; color: #8899ae; }

    .sdot-all { background: var(--fc-blue); }
    .sdot-posted { background: var(--fc-green); }
    .sdot-cancelled { background: var(--fc-red); }
    .sdot-returned { background: var(--fc-amber); }

    /* ── Banner ── */
    .sp-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 18px; font-size: 12px; font-weight: 600;
        animation: sp-banner-in .25s ease;
    }
    @@keyframes sp-banner-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
    .banner-close { background: none; border: none; cursor: pointer; opacity: .6; margin-right: auto; }
    .banner-success { background: #e9f8f0; color: #0e7a43; }
    .banner-error { background: #fff0f2; color: var(--fc-red); }

    /* ── Loading / Empty ── */
    .sp-loading {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 200px; color: var(--fc-muted); font-size: 12px; font-weight: 600;
    }
    .sp-spinner {
        width: 32px; height: 32px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: sp-spin .75s linear infinite;
    }
    @@keyframes sp-spin { to { transform: rotate(360deg); } }

    .sp-empty {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 10px; min-height: 240px; padding: 40px; text-align: center;
    }
    .sp-empty-icon { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f4fa; color: #b0c4d8; }
    .sp-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .sp-empty-sub { font-size: 12px; color: var(--fc-muted); }

    .sp-add-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; margin-top: 6px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; transition: all .15s;
    }
    .sp-add-btn:hover { background: var(--fc-blue); color: #fff; }

    /* ── Table ── */
    .sp-table-wrap { overflow-x: auto; }
    .sp-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .sp-table thead th {
        padding: 10px 12px;
        background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 10.5px; font-weight: 800;
        text-align: center; border-bottom: 2px solid #e4eaf3;
        white-space: nowrap;
    }
    .sp-table .th-start { text-align: right; }
    .sp-table tbody tr { border-bottom: 1px solid #f0f3f8; transition: background .12s; }
    .sp-table tbody tr:last-child { border-bottom: none; }
    .sp-table tbody tr:hover { background: #fafcff; }
    .sp-table tbody tr.row-cancelled { opacity: .55; }
    .sp-table tbody td { padding: 11px 12px; color: #526070; text-align: center; vertical-align: middle; }
    .td-start { text-align: right !important; }
    .td-muted { color: #8899ae; font-size: 11px; }

    /* Payment Cell */
    .sp-pay-cell { display: flex; align-items: flex-start; gap: 10px; }
    .sp-avatar {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        color: #fff; box-shadow: 0 2px 6px rgba(0,0,0,.10); margin-top: 2px;
    }
    .av-posted { background: linear-gradient(135deg, #0d8a48, #16a35b); }
    .av-cancelled { background: linear-gradient(135deg, #b02040, #e03048); }
    .av-returned { background: linear-gradient(135deg, #b87d08, #e09a10); }

    .sp-pay-info { min-width: 0; }
    .sp-pay-num { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .sp-code-chip {
        display: inline-flex; padding: 2px 8px; border-radius: 6px;
        background: #f0f4fa; border: 1px solid #e0e8f4;
        font-size: 10.5px; font-weight: 800; color: var(--fc-green);
    }
    .sp-supplier-name { font-size: 12px; font-weight: 700; color: #344563; margin-top: 3px; }

    /* Date */
    .sp-date-cell { display: flex; align-items: center; gap: 4px; justify-content: center; font-size: 11px; color: #6b7d95; }

    /* Method Cell */
    .sp-method-cell { display: flex; flex-direction: column; gap: 3px; align-items: center; }
    .sp-method-badge {
        display: inline-flex; padding: 3px 10px; border-radius: 7px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-size: 11px; font-weight: 800; border: 1px solid #c0d4fb;
    }
    .sp-cheque-tag {
        display: inline-flex; align-items: center; gap: 3px;
        font-size: 9.5px; color: #9aaabb; margin-top: 2px;
    }

    /* Amount */
    .sp-amount-cell { display: flex; align-items: baseline; gap: 3px; justify-content: center; }
    .sp-amount-val { font-size: 14px; font-weight: 900; color: var(--fc-green); }
