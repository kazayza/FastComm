@page "/custodies/new"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>صرف عهدة جديدة — فاست كوم</PageTitle>

@* ═══════════ HERO ═══════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">
            <div class="bk-hero-row">
                <div class="bk-hero-left">
                    <div class="bk-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        </svg>
                        <span>التشغيل · العُهد</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim"><span>صرف عهدة جديدة</span></h1>
                    <span class="bk-hero-sub">يُنشأ الرقم تلقائيًا (CUS-) — ويُخصم المبلغ من خزينة الصرف عند الحفظ</span>
                </div>
                <div class="bk-hero-right">
                    <span class="bk-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@* ═══════════ BODY ═══════════ *@
<div class="bk-body">
    @if (!CanCreate)
    {
        <div class="bk-state-box">
            <div class="bk-state-icon perm">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>صرف العهدة محتاج صلاحية CUSTODY.CREATE.</p>
        </div>
    }
    else
    {
        <div class="bk-tabs-wrap">
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                 PanelClass="bk-tab-panel" Class="bk-mud-tabs">

            @* ── تاب واحد: كل بيانات العهدة في شاشة واحدة ── *@
            <MudTabPanel>
                <TabContent>
                    <div class="btab-label">
                        <div class="btab-icon btab-blue" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/></svg>
                        </div>
                        <span>بيانات العهدة</span>
                    </div>
                </TabContent>
                <ChildContent>

                    @* ═══ ١) صاحب العهدة ═══ *@
                    <div class="tab-section">
                        <div class="tab-section-head">
                            <div class="tab-section-icon blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                            </div>
                            <div>
                                <div class="tab-section-title">صاحب العهدة</div>
                                <div class="tab-section-sub">تُصرف العهدة لموظف فقط، من خزينته الخاصة، ودون أي ربط برحلة — تُربط مصروفاتها بعملياتها عند التسوية</div>
                            </div>
                        </div>

                        <div class="bk-form-grid">
                            <div class="form-field">
                                <label class="field-label">الموظف <span class="field-required" aria-label="مطلوب">*</span></label>
                                <div class="field-select-wrap">
                                    <select class="field-input field-select" value="@_f.OwnerId" @onchange="OnOwnerChanged">
                                        <option value="0">— اختر الموظف —</option>
                                        @foreach (var em in _employees) { <option value="@em.Id">@em.Label</option> }
                                    </select>
                                </div>
                                <div class="field-hint">العهدة تُصرف للموظف وحده — وما يدفعه للسائقين يُسجل بندًا على عهدته هو، لا عهدة جديدة باسم السائق.</div>
                            </div>

                            <div class="form-field">
                                <label class="field-label" for="ci-date">تاريخ الصرف</label>
                                <div class="field-input-group">
                                    <input id="ci-date" type="datetime-local" class="field-input" value="@_f.CustodyDate" @onchange="e => _f.CustodyDate = e.Value?.ToString() ?? _f.CustodyDate" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ═══ ٢) المبلغ وخزينة الصرف ═══ *@
                    <div class="tab-section">
                        <div class="tab-section-head">
                            <div class="tab-section-icon green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round"/></svg>
                            </div>
                            <div>
                                <div class="tab-section-title">مبلغ العهدة ومصدره</div>
                                <div class="tab-section-sub">يُخصم المبلغ من الخزينة عند الحفظ — وإن لم يكفِ الرصيد يمكنك تمويلها من هنا مباشرة</div>
                            </div>
                        </div>

                        <div class="bk-form-grid">
                            <div class="form-field">
                                <label class="field-label" for="ci-amt">مبلغ العهدة (ج.م) <span class="field-required" aria-label="مطلوب">*</span></label>
                                <div class="field-input-group">
                                    <input id="ci-amt" type="number" min="0" step="0.01" class="field-input" @bind="_f.AmountIssued" @bind:after="SyncFundDefaults" placeholder="0.00" />
                                </div>
                                @if (_f.AmountIssued <= 0 && _triedSave)
                                {
                                    <div class="field-err-msg" role="alert">المبلغ لازم يكون أكبر من صفر</div>
                                }
                            </div>

                            <div class="form-field">
                                <label class="field-label">خزينة الصرف</label>
                                    @if (_f.OwnerId <= 0)
                                    {
                                        <div class="field-hint" style="font-size:12.5px">اختر الموظف أولًا — تُصرف عهدته من <strong>خزينته الخاصة</strong> إلزاميًا.</div>
                                    }
                                    else if (EmployeeBox is null)
                                    {
                                        <div class="field-err-msg">لا توجد خزينة تشغيل باسم هذا الموظف بعد — أنشئها من شاشة الخزينة (مسؤول الخزينة = الموظف) ثم عُد للصرف.</div>
                                    }
                                    else
                                    {
                                        <div class="field-hint" style="font-size:12.5px">
                                            خزينة الموظف: <strong>@EmployeeBox.NameAr</strong> — رصيدها الحالي <strong>@EmployeeBox.CurrentBalance.ToString("N2") ج.م</strong>
                                        </div>
                                        @if (Shortage > 0)
                                        {
                                            <div class="fund-panel">
                                                <div class="fund-title">الرصيد غير كافٍ — العجز @Shortage.ToString("N2") ج.م</div>
                                                @if (CanTransfer)
                                                {
                                                    <div class="fund-row">
                                                        <div class="field-select-wrap" style="flex:2">
                                                            <select class="field-input field-select" value="@_fundFromBoxId" @onchange="e => _fundFromBoxId = ParseInt(e.Value)">
                                                                @foreach (var b in FundingSources)
                                                                {
                                                                    <option value="@b.CashBoxId">من: @b.NameAr — رصيد @b.CurrentBalance.ToString("N2")</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="field-input-group" style="flex:1">
                                                            <input type="number" min="0" step="0.01" class="field-input" @bind="_fundAmount" />
                                                        </div>
                                                    </div>
                                                    <div class="field-hint">اضغط «تحويل وصرف العهدة» في الأسفل — يتم التحويل إلى خزينة الموظف أولًا ثم تُصرف العهدة، دون مغادرة هذه الشاشة.</div>
                                                }
                                                else
                                                {
                                                    <div class="field-hint">محتاج صلاحية تحويل الخزينة (TREASURY.TRANSFER) عشان تموّلها من هنا — أو حد يحوّل لخزينة الموظف من شاشة الخزينة الأول.</div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            <div class="form-field">
                                <label class="field-label" for="ci-notes">ملاحظات</label>
                                <div class="field-input-group">
                                    <input id="ci-notes" class="field-input" @bind="_f.Notes" maxlength="500" placeholder="أي ملاحظات..." />
                                </div>
                            </div>
                        </div>
                    </div>

                </ChildContent>
            </MudTabPanel>
        </MudTabs>
        </div>

        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="field-err-msg" style="font-size:13px;margin-top:10px;@(_ok ? "color:var(--fc-green)" : "")">@_msg</div>
        }

        <div class="bk-bottom-actions">
            <button class="bk-bottom-back" @onclick='() => Nav.NavigateTo("/custodies")'>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للعُهد
            </button>
            <div class="bk-bottom-right">
            @if (NeedsFunding)
            {
                <button class="bk-bottom-save" style="background:var(--fc-amber)" @onclick="FundAndSaveAsync" disabled="@(_saving || _funding)">
                    @if (_funding)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري التحويل...</span>
                    }
                    else
                    {
                        <span>تحويل @(_fundAmount.ToString("N0")) ج.م وصرف العهدة</span>
                    }
                </button>
            }
            <button class="bk-bottom-save" @onclick="SaveAsync" disabled="@_saving">
                @if (_saving)
                {
                    <span class="btn-spinner sm" aria-hidden="true"></span>
                    <span>جاري الصرف...</span>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2M12 12v4M10 14h4" stroke-linecap="round"/>
                    </svg>
                    <span>صرف العهدة</span>
                }
            </button>
            </div>
        </div>
    }
</div>

@code {
    private AuthUser? _user;
    private bool CanCreate => _user?.Can("CUSTODY.CREATE") ?? false;

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }
    public class BoxOpt
    {
        public int CashBoxId { get; set; } public string NameAr { get; set; } = "";
        public string Code { get; set; } = ""; public decimal CurrentBalance { get; set; }
        public int? ResponsibleEmployeeId { get; set; }
    }
    private List<Opt> _employees = new();
    private List<BoxOpt> _boxes = new();

    private class Form
    {
        public int OwnerId { get; set; }
        public decimal AmountIssued { get; set; }
        public string CustodyDate { get; set; } = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
        public string? Notes { get; set; }
    }
    private Form _f = new();

    private bool _saving, _ok, _triedSave;
    private string? _msg;

    /* ── التمويل المباشر: خزينة الموظف + التحويل من نفس الشاشة ── */
    private bool CanTransfer => _user?.Can("TREASURY.TRANSFER") ?? false;
    private int _fundFromBoxId;
    private decimal _fundAmount;
    private bool _funding;

    private BoxOpt? EmployeeBox =>
        _f.OwnerId > 0
            ? _boxes.FirstOrDefault(b => b.ResponsibleEmployeeId == _f.OwnerId)
            : null;

    private decimal Shortage =>
        EmployeeBox is not null && _f.AmountIssued > EmployeeBox.CurrentBalance
            ? _f.AmountIssued - EmployeeBox.CurrentBalance
            : 0;

    private List<BoxOpt> FundingSources =>
        EmployeeBox is null
            ? new()
            : _boxes.Where(b => b.CashBoxId != EmployeeBox.CashBoxId).ToList();

    private bool NeedsFunding =>
        Shortage > 0 && CanTransfer && EmployeeBox is not null;

    private void SyncFundDefaults()
    {
        if (EmployeeBox is null) return;
        if (_fundAmount <= 0 && Shortage > 0) _fundAmount = Shortage;
        if (_fundFromBoxId == 0)
            _fundFromBoxId = FundingSources.FirstOrDefault()?.CashBoxId ?? 0;
    }

    private void OnOwnerChanged(ChangeEventArgs e)
    {
        _f.OwnerId = ParseInt(e.Value);
        _fundAmount = 0; _fundFromBoxId = 0;
        SyncFundDefaults();
    }

    private async Task FundAndSaveAsync()
    {
        if (EmployeeBox is null) return;
        if (_fundFromBoxId <= 0) { _ok = false; _msg = "اختر الخزينة التي سيتم التحويل منها"; return; }
        if (_fundAmount < Shortage) { _ok = false; _msg = $"مبلغ التحويل {_fundAmount:N2} أقل من العجز {Shortage:N2} — زوّده أو قلّل مبلغ العهدة"; return; }
        var src = _boxes.FirstOrDefault(b => b.CashBoxId == _fundFromBoxId);
        if (src is not null && src.CurrentBalance < _fundAmount)
        { _ok = false; _msg = $"رصيد «{src.NameAr}» {src.CurrentBalance:N2} لا يكفي للتحويل"; return; }

        _funding = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/treasury/transfer", new
            {
                fromCashBoxId = _fundFromBoxId,
                toCashBoxId   = EmployeeBox.CashBoxId,
                txDate        = DateTime.Today.ToString("yyyy-MM-dd"),
                amount        = _fundAmount,
                description   = $"تمويل خزينة موظف لصرف عهدة — {EmployeeBox.NameAr}"
            });
            var tmsg = await MsgOf(res);
            if (!res.IsSuccessStatusCode) { _ok = false; _msg = "التحويل فشل: " + tmsg; return; }

            Snackbar.Add($"✅ تم تحويل {_fundAmount:N2} ج.م إلى خزينة الموظف — يُستكمل صرف العهدة", Severity.Success);
            _boxes = await SafeGetT<BoxOpt>("api/custodies/cash-boxes");
        }
        catch (Exception ex) { _ok = false; _msg = "فشل التحويل: " + ex.Message; return; }
        finally { _funding = false; }

        await SaveAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanCreate) return;
        _employees = await SafeGetT<Opt>("api/custodies/employees");
        _boxes     = await SafeGetT<BoxOpt>("api/custodies/cash-boxes");
    }

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private static int ParseInt(object? v) => int.TryParse(v?.ToString(), out var i) ? i : 0;

    private async Task SaveAsync()
    {
        _triedSave = true;
        if (_f.OwnerId <= 0) { _ok = false; _msg = "اختر الموظف صاحب العهدة"; return; }
        if (_f.AmountIssued <= 0) { _ok = false; _msg = "أدخل مبلغ العهدة"; return; }

        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/custodies", new
            {
                tripId          = (long?)null,
                ownerType       = "Employee",
                ownerId         = _f.OwnerId,
                amountIssued    = _f.AmountIssued,
                custodyDate     = _f.CustodyDate,
                notes           = _f.Notes,
                isPrimary       = true,
                parentCustodyId = (long?)null,
                allocationType  = (string?)null,
                cashBoxId       = (int?)null
            });
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                Nav.NavigateTo("/custodies");
            }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
<style>

    /* ================================================================
       VARIABLES
    ================================================================ */
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       HERO ADDITIONS
    ================================================================ */
    .bk-hero-badge {
        display: inline-flex; align-items: center;
        padding: 3px 10px; border-radius: 20px;
        font-size: 11px; font-weight: 800;
    }

    .badge-new      { background: rgba(34,197,94,.2);  color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-draft    { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); border: 1px solid rgba(255,255,255,.2); }
    .badge-confirmed { background: rgba(59,130,246,.25); color: #93c5fd; border: 1px solid rgba(59,130,246,.3); }
    .badge-assigned  { background: rgba(168,85,247,.25); color: #d8b4fe; border: 1px solid rgba(168,85,247,.3); }
    .badge-inprogress { background: rgba(234,179,8,.25); color: #fde68a; border: 1px solid rgba(234,179,8,.3); }
    .badge-completed  { background: rgba(34,197,94,.25); color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-cancelled  { background: rgba(239,68,68,.25); color: #fca5a5; border: 1px solid rgba(239,68,68,.3); }

    /* Hero Buttons */
    .bk-back-btn {
        display: inline-flex; align-items: center; gap: 5px;
        height: 36px; padding: 0 13px;
        border: 1px solid rgba(255,255,255,.2); border-radius: 9px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .bk-back-btn:hover { background: rgba(255,255,255,.14); }
    .bk-back-btn svg { transform: rotate(180deg); }

    /* ── Hero Wrapper ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow:
            0 12px 32px rgba(13, 38, 84, 0.15),
            0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .bk-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .bk-hero-left { flex: 1; min-width: 200px; }

    .bk-hero-crumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 6px;
    }

    .bk-hero-sub {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.55);
    }

    .bk-hero-right {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .bk-hero-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(255, 255, 255, .1);
        border: 1px solid rgba(255, 255, 255, .2);
        font-size: 11.5px;
        color: #fff;
    }

    .bk-hero-chip.badge-new { background: rgba(30, 110, 245, .2); border-color: rgba(30, 110, 245, .4); }
    .bk-hero-chip.badge-progress { background: rgba(251, 191, 36, .2); border-color: rgba(251, 191, 36, .4); }
    .bk-hero-chip.badge-done { background: rgba(22, 163, 91, .2); border-color: rgba(22, 163, 91, .4); }
    .bk-hero-chip.badge-cancelled { background: rgba(224, 48, 72, .2); border-color: rgba(224, 48, 72, .4); }

    /* ── Glow FAB ── */
    .glow-fab-wrap {
        position: fixed;
        left: 28px;
        bottom: 28px;
        /* 🔴 أعلى من الـscrim (1298) — الزر والقايمة لازم يفضلوا فوقه وشغالين */
        z-index: 1299;
    }

    .glow-fab-container {
        position: relative;
        z-index: 2;
        width: 64px;
        height: 64px;
    }

    .glow-fab-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1e6ef5, #0d47a1);
        border: 2.5px solid #fbbf24;
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(30, 110, 245, .4);
        transition: transform .2s, box-shadow .2s;
        z-index: 2;
    }

    .glow-fab-btn:hover {
        transform: translate(-50%, -50%) scale(1.05);
        box-shadow: 0 6px 24px rgba(30, 110, 245, .5);
    }

    .glow-fab-icon { transition: transform .3s; }
    .glow-fab-wrap.is-open .glow-fab-icon { transform: rotate(130deg); }

    .glow-halo, .glow-ring {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        pointer-events: none;
    }

    .glow-halo {
        width: 60px;
        height: 60px;
        background: radial-gradient(circle, rgba(30, 110, 245, .3) 0%, transparent 70%);
        animation: glow-breath 2s ease-in-out infinite;
    }

    .glow-ring {
        width: 60px;
        height: 60px;
        border: 2px solid rgba(30, 110, 245, .4);
        animation: glow-expand 2s ease-out infinite;
    }

    .glow-ring-2 { animation-delay: .3s; }
    .glow-ring-3 { animation-delay: .6s; }

    @@keyframes glow-breath {
        0%, 100% { opacity: .5; transform: translate(-50%, -50%) scale(1); }
        50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
    }

    @@keyframes glow-expand {
        0% { opacity: .8; transform: translate(-50%, -50%) scale(1); }
        100% { opacity: 0; transform: translate(-50%, -50%) scale(2.5); }
    }

    .glow-fab-menu {
        position: absolute;
        bottom: 80px;
        left: 0;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 8px;
        opacity: 0;
        pointer-events: none;
        transform: translateY(10px);
        transition: opacity .2s, transform .2s;
    }

    .glow-fab-wrap.is-open .glow-fab-menu {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    .glow-fab-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        border-radius: 12px;
        background: #fff;
        border: 1px solid #dde5f0;
        box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
        cursor: pointer;
        font-size: 13px;
        color: #1c2c44;
        transition: background .15s, border-color .15s;
        white-space: nowrap;
    }

    .glow-fab-item:hover {
        background: #f4f7fb;
        border-color: #1e6ef5;
    }

    .glow-fab-item-ic {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #eaf1ff;
        color: #1e6ef5;
    }

    /* 🔴 الـscrim بقى شقيق للـ .glow-fab-wrap مش جوّاه.
       لما كان جوّه: الـ wrap بيعمل stacking context، فالـ 1298 كان بيترسم
       فوق القايمة (auto) وفوق الزر (2) ⇒ يبلع الكليك ويمنع استخدام الزر العائم. */
    .glow-fab-scrim {
        position: fixed;
        inset: 0;
        background: rgba(9, 18, 35, .45);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 1298;
        animation: glow-fadein .18s ease both;
    }

    @@keyframes glow-fadein {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    /* ── Mobile ── */
    @@media (max-width: 768px) {
        .hero-wrapper { padding: 12px 12px 0; }
        .hero-wrapper .fc-hero { border-radius: 16px !important; }
        .bk-hero-row { flex-direction: column; align-items: flex-start; }
        .bk-hero-right { width: 100%; justify-content: flex-start; }
    }

    .bk-save-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 18px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .bk-save-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }
    .bk-save-btn:disabled { opacity: .6; cursor: not-allowed; }

    /* Hero Summary Strip */
    .bk-hero-summary {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px);
        margin-top: 4px;
    }

    .bk-sum-item {
        flex: 1; display: flex; align-items: center; gap: 10px;
        padding: 12px 16px;
    }

    .bk-sum-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }

    .bk-sum-icon {
        width: 32px; height: 32px; flex: 0 0 32px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.10); color: rgba(255,255,255,.7);
    }

    .bk-sum-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .bk-sum-val   { font-size: 13px; font-weight: 800; color: #fff; margin-top: 2px; }

    /* ================================================================
       BODY
    ================================================================ */
    /* 🔴 نفس عرض .hero-wrapper بالحرف (1440px + نفس البادينج الأفقي)
       ⇒ حدّ كارت الهيرو = حدّ المحتوى اللي تحته على أي مقاس شاشة.
       الـ 96px تحت مساحة للزر العائم. */
    .bk-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 180px);
        padding: 18px clamp(16px, 3vw, 40px) 96px;
        max-width: 1440px; width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
        position: relative;
        z-index: 2;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* ================================================================
       STATES
    ================================================================ */
    .bk-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 280px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .bk-state-icon {
        width: 68px; height: 68px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .bk-state-icon.perm { background: #fff0f2; color: var(--fc-red); }

    .bk-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .bk-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    .bk-state-back {
        margin-top: 8px; padding: 9px 20px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-text);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .bk-state-back:hover { background: #f0f4fa; }

    /* ================================================================
       LOADING
    ================================================================ */
    .bk-loading-wrap {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 14px; min-height: 260px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .bk-spinner {
        width: 36px; height: 36px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: bk-spin .75s linear infinite;
    }
    @@keyframes bk-spin { to { transform: rotate(360deg); } }

    .bk-loading-text { font-size: 13px; font-weight: 600; color: var(--fc-muted); }

    /* ================================================================
       BANNERS
    ================================================================ */
    .bk-locked-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px; border-radius: 12px;
        background: linear-gradient(135deg, #fffbeb, #fff8e0);
        border: 1px solid #fde68a;
        box-shadow: 0 2px 10px rgba(234,179,8,.10);
    }

    .locked-icon { flex: 0 0 auto; color: #d97706; }

    .locked-text { display: flex; flex-direction: column; gap: 2px; }
    .locked-text strong { font-size: 13px; font-weight: 800; color: #92400e; }
    .locked-text span   { font-size: 11.5px; color: #b45309; }

    .bk-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600;
        animation: bk-banner-in .25s ease;
    }
    @@keyframes bk-banner-in {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .banner-success { background: #e9f8f0; color: #0e7a43; border: 1px solid #b5e8d0; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); border: 1px solid #ffc8d0; }

    .banner-close {
        margin-right: auto; background: none; border: none;
        color: inherit; opacity: .6; cursor: pointer; font-size: 13px;
        padding: 2px 6px; border-radius: 5px;
    }
    .banner-close:hover { opacity: 1; }

    /* ================================================================
       TABS
    ================================================================ */
    .bk-tabs-wrap {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden; flex: 1;
    }

    .bk-mud-tabs .mud-tabs-toolbar {
        background: linear-gradient(180deg, #f9fafd 0%, #f3f6fb 100%);
        border-bottom: 2px solid #e8edf5;
        padding: 0 16px; min-height: 54px;
    }

    .bk-mud-tabs .mud-tab {
        font-family: "Cairo","Tajawal","Inter",Arial,sans-serif;
        font-size: 12px; font-weight: 700; color: var(--fc-muted);
        padding: 0 6px; min-width: unset; transition: color .15s ease;
    }

    .bk-mud-tabs .mud-tab.mud-tab-active { color: var(--fc-blue) !important; font-weight: 800; }

    .bk-mud-tabs .mud-tab-slider {
        background: var(--fc-blue) !important;
        height: 3px; border-radius: 3px 3px 0 0;
    }

    .bk-mud-tabs .mud-tab:hover:not(.mud-tab-active) {
        color: var(--fc-text); background: rgba(0,0,0,.03); border-radius: 8px;
    }

    .bk-tab-panel { padding: 0; }

    /* Tab Labels */
    .btab-label {
        display: flex; align-items: center; gap: 7px;
        padding: 0 4px; white-space: nowrap;
    }

    .btab-icon {
        width: 26px; height: 26px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 7px;
    }

    .btab-blue  { background: var(--fc-blue-lt);  color: var(--fc-blue); }
    .btab-green { background: var(--fc-green-lt); color: var(--fc-green); }
    .btab-amber { background: var(--fc-amber-lt); color: var(--fc-amber); }

    .btab-err-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--fc-red); flex: 0 0 7px;
        animation: bk-pulse 1.5s ease infinite;
    }
    @@keyframes bk-pulse {
        0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.4); }
        50%      { box-shadow: 0 0 0 5px rgba(224,48,72,0); }
    }

    .btab-count {
        min-width: 18px; height: 18px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 5px; padding: 0 4px;
        background: var(--fc-amber-lt); color: #9a6d08;
        font-size: 10px; font-weight: 900;
        font-family: "Inter", Arial, sans-serif;
    }

    /* ================================================================
       TAB SECTION
    ================================================================ */
    .tab-section {
        padding: 24px clamp(16px, 3vw, 40px) 28px;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    .tab-section-head {
        display: flex; align-items: flex-start; gap: 12px;
        margin-bottom: 22px; padding-bottom: 18px;
        border-bottom: 1px solid #edf1f7;
    }

    .tab-section-icon {
        width: 42px; height: 42px; flex: 0 0 42px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 12px;
    }
    .tab-section-icon.blue  { background: var(--fc-blue-lt);  color: var(--fc-blue);  border: 1px solid #bdd4fc; }
    .tab-section-icon.green { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .tab-section-icon.amber { background: var(--fc-amber-lt); color: var(--fc-amber); border: 1px solid #f0d070; }

    .tab-section-title { font-size: 15px; font-weight: 800; color: #1c2b43; line-height: 1.2; }
    .tab-section-sub   { font-size: 11px; font-weight: 500; color: var(--fc-muted); margin-top: 3px; }

    .tab-section-sub-head {
        display: flex; align-items: center; gap: 7px;
        font-size: 12px; font-weight: 800; color: #344258;
        margin: 22px 0 10px;
        padding-top: 18px; border-top: 1px solid #edf1f7;
    }

    /* ================================================================
       FORM
    ================================================================ */
    .bk-form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 18px;
        width: 100%;
    }

    @@media (max-width: 768px) {
        .bk-form-grid {
            grid-template-columns: 1fr;
        }
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        position: relative;
    }

    .field-label {
        font-size: 12px; font-weight: 800; color: #344258;
        display: flex; align-items: center; gap: 4px;
    }

    .field-required { color: var(--fc-red); font-size: 14px; line-height: 1; }

    .field-input {
        height: 42px; width: 100%;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 13px; padding: 0 12px;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        outline: none;
    }
    .field-input:focus {
        border-color: var(--fc-blue);
        box-shadow: 0 0 0 3px rgba(30,110,245,.10);
        background: #fff;
    }
    .field-input:disabled { opacity: .7; background: #f3f5f8; cursor: not-allowed; }
    .field-input.field-error {
        border-color: var(--fc-red);
        box-shadow: 0 0 0 3px rgba(224,48,72,.08);
    }
    .field-input::placeholder { color: #b0bcc8; }

    .field-textarea {
        height: auto; padding: 10px 12px;
        resize: vertical; min-height: 80px;
    }

    /* Select with icon */
    .field-select-wrap {
        position: relative; display: flex; align-items: center;
    }

    .field-select-icon {
        position: absolute; right: 12px; color: #9aaabb;
        pointer-events: none; z-index: 1;
    }

    .field-select {
        padding-right: 36px; cursor: pointer;
        -webkit-appearance: none; appearance: none;
    }
    .field-select:disabled { cursor: not-allowed; }

    /* Input with prefix */
    .field-input-group { position: relative; display: flex; align-items: center; }

    .field-prefix {
        position: absolute; right: 12px;
        display: flex; align-items: center;
        color: #9aaabb; pointer-events: none; z-index: 1;
    }

    .field-input.with-prefix { padding-right: 36px; }

    /* Field Dropdown — للبحث (نفس تصميم field-input) */
    .field-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        left: 0;
        margin-top: 4px;
        background: #fafcff;
        border: 1px solid #d8e2f0;
        border-radius: 9px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
        max-height: 240px;
        overflow-y: auto;
        z-index: 100;
    }

    .field-dropdown-item {
        padding: 10px 12px;
        font-family: inherit;
        font-size: 13px;
        color: var(--fc-text);
        cursor: pointer;
        transition: background .1s;
    }

    .field-dropdown-item:hover {
        background: #eaf1ff;
    }

    .field-hint {
        display: flex; align-items: center; gap: 5px;
        font-size: 10.5px; color: var(--fc-muted); font-weight: 500;
    }

    .field-err-msg { font-size: 10.5px; color: var(--fc-red); font-weight: 700; }

    /* ================================================================
       ROUTE VISUAL
    ================================================================ */
    .bk-route-visual {
        display: flex; align-items: center; gap: 0;
        margin-top: 22px; padding: 14px 20px;
        background: linear-gradient(135deg, #f5f8ff, #eef4ff);
        border: 1px solid #c8d8fb; border-radius: 12px;
        animation: bk-banner-in .25s ease;
    }

    .route-point { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }

    .route-dot {
        width: 14px; height: 14px; border-radius: 50%;
        border: 3px solid;
    }
    .dot-from { background: var(--fc-blue-lt);  border-color: var(--fc-blue); }
    .dot-to   { background: var(--fc-green-lt); border-color: var(--fc-green); }

    .route-label { display: flex; flex-direction: column; gap: 2px; }
    .route-caption { font-size: 9px; font-weight: 600; color: #8899ae; }
    .route-label strong { font-size: 13px; font-weight: 800; color: var(--fc-text); }

    .route-line {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; gap: 0; position: relative; margin: 0 10px;
    }
    .route-truck { font-size: 20px; margin-top: -4px; }

    /* ================================================================
       CONTAINER CARDS
    ================================================================ */
    .bk-containers-empty {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 10px; min-height: 180px;
        border: 2px dashed #d8e8f8; border-radius: 12px;
        background: #f8fbff; text-align: center; padding: 30px;
    }

    .containers-empty-icon {
        width: 70px; height: 70px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #edf3fb; color: #b0c4d8;
    }
    .containers-empty-title { font-size: 14px; font-weight: 800; color: var(--fc-text); }
    .containers-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    .bk-add-line-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 14px;
        border: 1.5px solid var(--fc-amber);
        border-radius: 9px;
        background: var(--fc-amber-lt); color: #9a6d08;
        font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; white-space: nowrap; flex-shrink: 0;
        transition: all .15s ease;
    }
    .bk-add-line-btn:hover { background: var(--fc-amber); color: #fff; }
    .bk-add-line-btn.mt-10 { margin-top: 10px; }

    .bk-container-cards { display: flex; flex-direction: column; gap: 12px; }

    .bk-container-card {
        border: 1px solid #e4edf8; border-radius: 12px;
        background: linear-gradient(180deg, #fafcff, #f5f8fb);
        overflow: hidden;
        transition: border-color .18s ease, box-shadow .18s ease;
    }
    .bk-container-card:hover {
        border-color: #c8d8f0;
        box-shadow: 0 4px 14px rgba(15,41,82,.06);
    }

    .bk-cc-head {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 14px;
        background: linear-gradient(180deg, #f0f5fc, #eaf1f9);
        border-bottom: 1px solid #dce8f5;
    }

    .bk-cc-num {
        width: 26px; height: 26px; border-radius: 8px; flex: 0 0 26px;
        display: flex; align-items: center; justify-content: center;
        background: var(--fc-blue); color: #fff;
        font-size: 11px; font-weight: 900;
        font-family: "Inter", Arial, sans-serif;
    }

    .bk-cc-type-badge {
        display: flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 7px;
        background: rgba(30,110,245,.08); border: 1px solid rgba(30,110,245,.15);
        color: var(--fc-blue); font-size: 11px; font-weight: 800;
        white-space: nowrap;
    }

    .bk-cc-total {
        flex: 1; font-size: 11px; color: #6b7d95; font-weight: 600;
    }
    .bk-cc-total strong { color: var(--fc-text); font-weight: 900; }
    .bk-cc-total span   { color: #9aaabb; }

    .bk-cc-del {
        width: 30px; height: 30px; border-radius: 7px; flex: 0 0 30px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; background: transparent;
        color: var(--fc-red); cursor: pointer;
        transition: all .15s ease;
    }
    .bk-cc-del:hover { background: var(--fc-red-lt); border-color: #ffc8cf; }

    .bk-cc-body {
        /* السطر كله في شريط واحد متناسق:
           النوع · العدد · الوزن · الضمان · الملاحظات + زر «إضافة حاوية» */
        display: grid;
        grid-template-columns: 1.35fr .85fr .85fr 1.05fr 2.1fr;
        gap: 14px; padding: 14px 16px;
        align-items: start;
    }

    .bk-cc-notes { grid-column: auto; }

    /* زر «إضافة حاوية» بجانب حقل الملاحظات + عرض الباقي */
    .bk-notes-action-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .bk-notes-action-row .field-input {
        flex: 1;
        min-width: 0;
    }

    .bk-add-detail-inline-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 42px;
        padding: 0 14px;
        flex-shrink: 0;
        border: 1.5px dashed var(--fc-blue);
        border-radius: 9px;
        background: var(--fc-blue-lt);
        color: var(--fc-blue);
        font-family: inherit;
        font-size: 11.5px;
        font-weight: 800;
