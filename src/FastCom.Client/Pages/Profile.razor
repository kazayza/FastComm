@page "/profile"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth

<PageTitle>الملف الشخصي — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO (flt-* — عيلة الأسطول)
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">
            <div class="flt-hero-row">
                <div class="flt-hero-left">
                    <div class="flt-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span>النظام · الملف الشخصي</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">@(_me?.FullName is { Length: > 0 } ? _me.FullName : _me?.UserName ?? "الملف الشخصي")</h1>
                    <span class="flt-hero-sub">بيانات حسابك في النظام — للاطلاع، التعديل يتم بواسطة مسؤول النظام</span>
                </div>
                <div class="flt-hero-right">
                    @if (_me is not null && _me.Roles.Count > 0)
                    {
                        <span class="flt-hero-chip">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                            @string.Join(" · ", _me.Roles)
                        </span>
                    }
                    <span class="flt-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="flt-body">
    <div class="flt-card">

        @if (_loading)
        {
            <div class="flt-loading">
                <div class="flt-spinner" aria-label="جاري التحميل"></div>
                <span>جاري تحميل بيانات الحساب...</span>
            </div>
        }
        else if (_me is null)
        {
            <div class="flt-empty">
                <div class="flt-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="flt-empty-title">تعذّر تحميل بيانات الحساب</div>
                <div class="flt-empty-sub">يرجى إعادة تسجيل الدخول والمحاولة مرة أخرى</div>
            </div>
        }
        else
        {
            <div class="pf-head">
                <div class="pf-avatar" aria-hidden="true">
                    @(string.IsNullOrWhiteSpace(_me.FullName) ? (_me.UserName.Length > 0 ? _me.UserName[..1].ToUpperInvariant() : "؟") : _me.FullName[..1].ToString())
                </div>
                <div>
                    <div class="pf-head-name">@(_me.FullName.Length > 0 ? _me.FullName : _me.UserName)</div>
                    <div class="pf-head-sub">@@@_me.UserName</div>
                </div>
                <div class="pf-head-side">
                    <span class="flt-status-chip @(_me.UserStatus == "Active" ? "chip-available" : "chip-outofservice")">
                        <span class="flt-status-dot @(_me.UserStatus == "Active" ? "dot-available" : "dot-outofservice")" aria-hidden="true"></span>
                        @(_me.UserStatus == "Active" ? "حساب نشط" : _me.UserStatus == "Locked" ? "حساب مقفل" : "حساب موقوف")
                    </span>
                    <button type="button" class="flt-hero-add" @onclick="() => _pwdOpen = true">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3"/>
                        </svg>
                        تغيير كلمة المرور
                    </button>
                </div>
            </div>

            <div class="pf-rows">
                <div class="pf-row">
                    <div class="pf-label">الاسم الكامل</div>
                    <div class="pf-value">@(_me.FullName.Length > 0 ? _me.FullName : "—")</div>
                </div>
                <div class="pf-row">
                    <div class="pf-label">اسم المستخدم</div>
                    <div class="pf-value" dir="ltr">@_me.UserName</div>
                </div>
                <div class="pf-row">
                    <div class="pf-label">البريد الإلكتروني</div>
                    <div class="pf-value" dir="ltr">@(string.IsNullOrWhiteSpace(_me.Email) ? "—" : _me.Email)</div>
                </div>
                <div class="pf-row">
                    <div class="pf-label">رقم الهاتف</div>
                    <div class="pf-value" dir="ltr">@(string.IsNullOrWhiteSpace(_me.PhoneNumber) ? "—" : _me.PhoneNumber)</div>
                </div>
                <div class="pf-row">
                    <div class="pf-label">الفرع</div>
                    <div class="pf-value">@(BranchName ?? "—")</div>
                </div>
                <div class="pf-row">
                    <div class="pf-label">الأدوار</div>
                    <div class="pf-value">@(_me.Roles.Count > 0 ? string.Join(" · ", _me.Roles) : "—")</div>
                </div>
                <div class="pf-row">
                    <div class="pf-label">آخر تسجيل دخول</div>
                    <div class="pf-value">
                        @if (_me.LastLoginAt is null)
                        {
                            <text>—</text>
                        }
                        else
                        {
                            var lt = _me.LastLoginAt.Value.ToLocalTime();
                            <text>@lt.ToString("yyyy-MM-dd") — @lt.ToString("HH:mm")</text>
                        }
                    </div>
                </div>
            </div>

            <div class="pf-note">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                </svg>
                <span>لتعديل البيانات الأساسية للحساب (الاسم، البريد، الهاتف، الفرع، الأدوار) يرجى مراجعة مسؤول النظام من شاشة المستخدمين.</span>
            </div>
        }

    </div>
</div>

<ChangePasswordDialog Open="_pwdOpen" Close="ClosePwd" />

@code {
    private MeModel? _me;
    private List<Opt> _branches = new();
    private bool _loading = true;
    private bool _pwdOpen;

    private void ClosePwd() => _pwdOpen = false;

    private string? BranchName
    {
        get
        {
            if (_me?.BranchId is null) return null;
            var b = _branches.FirstOrDefault(x => x.Id == _me.BranchId.Value);
            return b?.Label;
        }
    }

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    /// <summary>مطابق لـ MeResponse بعد التوسيع.</summary>
    public class MeModel
    {
        public int UserId { get; set; }
        public string UserName { get; set; } = "";
        public string FullName { get; set; } = "";
        public string? Email { get; set; }
        public int? BranchId { get; set; }
        public string? PhoneNumber { get; set; }
        public string UserStatus { get; set; } = "Active";
        public DateTime? LastLoginAt { get; set; }
        public string? ProfileImagePath { get; set; }
        public List<string> Roles { get; set; } = new();
        public List<string> Permissions { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _me = await Http.GetFromJsonAsync<MeModel>("api/auth/me");
            try { _branches = await Http.GetFromJsonAsync<List<Opt>>("api/options/branches") ?? new(); }
            catch { _branches = new(); }
        }
        catch { _me = null; }
        finally { _loading = false; }
    }
}

<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ── Hero ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px; margin: 0 auto; width: 100%;
        box-sizing: border-box; position: relative; z-index: 1;
    }
    .hero-wrapper .fc-hero {
        border-radius: 20px !important; overflow: hidden;
        box-shadow: 0 12px 32px rgba(13,38,84,.15), 0 4px 12px rgba(13,38,84,.08);
        border: 1px solid rgba(255,255,255,.08);
    }
    .hero-wrapper .fc-hero.fc-hero-slim { padding-top: 18px !important; padding-bottom: 22px !important; }

    .flt-hero-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 6px; }
    .flt-hero-left { flex: 1; min-width: 200px; }
    .flt-hero-crumb { display: flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.55); margin-bottom: 2px; }
    .flt-hero-sub { font-size: 13px; color: rgba(255,255,255,.55); font-weight: 600; }
    .flt-hero-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .flt-hero-chip { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: 8px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: rgba(255,255,255,.7); font-size: 10.5px; font-weight: 700; white-space: nowrap; }

    .flt-hero-refresh {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.08);
        color: rgba(255,255,255,.75); cursor: pointer; transition: background .15s;
    }
    .flt-hero-refresh:hover { background: rgba(255,255,255,.14); }

    .flt-hero-add {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; border-radius: 9px;
        border: none; background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .flt-hero-add:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }

    /* ── KPIs Glass Strip ── */
    .flt-kpis-strip {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px); margin-top: 14px;
    }
    .flt-kpi-item {
        flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px 16px;
        cursor: pointer; transition: background .15s ease;
    }
    .flt-kpi-item:hover { background: rgba(255,255,255,.06); }
    .flt-kpi-item.kpi-active { background: rgba(30,110,245,.28); }
    .flt-kpi-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }
    .flt-kpi-icon {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
    }
    .kpi-blue  { background: rgba(30,110,245,.2); color: #93c5fd; }
    .kpi-amber { background: rgba(234,179,8,.2);  color: #fde68a; }
    .kpi-red   { background: rgba(239,68,68,.2);  color: #fca5a5; }
    .kpi-green { background: rgba(34,197,94,.2);  color: #86efac; }

    .flt-kpi-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .flt-kpi-val { font-size: 15px; font-weight: 900; color: #fff; margin-top: 2px; }
    .val-green { color: #86efac !important; }
    .val-red   { color: #fca5a5 !important; }
    .val-amber { color: #fde68a !important; }

    /* ── Body ── */
    .flt-body {
        background: var(--fc-bg); min-height: calc(100vh - 180px);
        padding: 18px clamp(16px, 3vw, 40px) 96px;
        max-width: 1440px; width: 100%; margin: 0 auto;
        box-sizing: border-box; position: relative; z-index: 2;
        display: flex; flex-direction: column; gap: 14px;
    }

    .flt-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px; background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center; box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .flt-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .flt-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .flt-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .flt-state-box p { margin: 0; font-size: 13px; color: var(--fc-muted); }

    .flt-card { background: var(--fc-card); border: 1px solid var(--fc-border); border-radius: var(--fc-radius); box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06); overflow: hidden; }

    /* ── Toolbar ── */
    .flt-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; background: linear-gradient(180deg, #fff 0%, #fafbfd 100%); border-bottom: 1px solid #edf1f7; flex-wrap: wrap; }
    .flt-search-wrap { position: relative; display: flex; align-items: center; flex: 1; min-width: 200px; max-width: 380px; }
    .flt-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }
    .flt-search-input {
        width: 100%; height: 42px; padding: 0 36px 0 12px; border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text); font-family: inherit; font-size: 13px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .flt-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .flt-search-input::placeholder { color: #b0bcc8; }
    .flt-search-clear { position: absolute; left: 10px; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; border: none; background: #edf1f7; color: #8899ae; cursor: pointer; }
    .flt-search-clear:hover { background: #dde3ed; }
    .flt-results-badge { display: flex; align-items: center; gap: 5px; margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap; }
    .flt-results-badge strong { color: #5a6e88; }

    /* ── Tabs ── */
    .flt-tab-bar { padding: 10px 18px; background: #f9fafd; border-bottom: 1px solid #edf1f7; }
    .flt-tabs { display: flex; gap: 4px; padding: 3px; border-radius: 10px; background: #f0f3f8; width: fit-content; }
    .flt-tab {
        display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border: none; border-radius: 7px;
        background: transparent; color: #6b7d95; font-family: inherit; font-size: 12px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .flt-tab:hover:not(.active) { color: var(--fc-text); background: rgba(255,255,255,.6); }
    .flt-tab.active { background: var(--fc-card); color: var(--fc-blue); box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800; }
    .flt-tab-count { min-width: 22px; height: 20px; border-radius: 5px; padding: 0 6px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 900; background: var(--fc-blue-lt); color: var(--fc-blue); }
    .flt-tab:not(.active) .flt-tab-count { background: #e4eaf3; color: #8899ae; }

    /* ── Loading / Empty ── */
    .flt-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 200px; color: var(--fc-muted); font-size: 12px; font-weight: 600; }
    .flt-spinner { width: 32px; height: 32px; border: 3px solid #dde5f0; border-top-color: var(--fc-blue); border-radius: 50%; animation: flt-spin .75s linear infinite; }
    @@keyframes flt-spin { to { transform: rotate(360deg); } }
    .flt-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 240px; padding: 40px; text-align: center; }
    .flt-empty-icon { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f4fa; color: #b0c4d8; }
    .flt-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .flt-empty-sub { font-size: 12px; color: var(--fc-muted); }

    /* ── Table ── */
    .flt-table-wrap { overflow-x: auto; }
    .flt-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .flt-table thead th {
        padding: 12px 14px; background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 10.5px; font-weight: 800; text-align: center;
        border-bottom: 2px solid #e4eaf3; white-space: nowrap;
    }
    .flt-table .th-start { text-align: right; }
    .flt-table tbody tr { border-bottom: 1px solid #f0f3f8; transition: background .12s ease; }
    .flt-table tbody tr:last-child { border-bottom: none; }
    .flt-table tbody tr:hover { background: #fafcff; }
    .flt-table tbody td { padding: 11px 12px; color: #526070; text-align: center; vertical-align: middle; }
    .td-start { text-align: right !important; }
    .td-muted { color: #8899ae; font-size: 11px; }

    .flt-item-cell { display: flex; align-items: center; gap: 10px; }
    .flt-avatar { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #fff; box-shadow: 0 2px 6px rgba(0,0,0,.10); }
    .av-available   { background: linear-gradient(135deg, #0d8a48, #16a35b); }
    .av-intrip      { background: linear-gradient(135deg, #1558d6, #1e6ef5); }
    .av-maintenance { background: linear-gradient(135deg, #b87d08, #e09a10); }
    .av-outofservice{ background: linear-gradient(135deg, #6b7d95, #4a5a74); }

    .flt-item-info { min-width: 0; }
    .flt-code-plate { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .flt-code-chip { display: inline-flex; padding: 2px 8px; border-radius: 6px; background: #f0f4fa; border: 1px solid #e0e8f4; font-size: 10.5px; font-weight: 800; color: var(--fc-blue); font-family: "Inter", Arial, sans-serif; }
    .flt-plate-num { font-size: 13px; font-weight: 800; color: #1c2b43; margin-top: 4px; font-family: "Inter", Arial, sans-serif; }

    .flt-type-cell { display: flex; flex-direction: column; gap: 4px; align-items: center; }
    .flt-type-tag { display: inline-flex; padding: 3px 10px; border-radius: 6px; background: var(--fc-blue-lt); color: var(--fc-blue); font-size: 11px; font-weight: 800; border: 1px solid #bdd4fc; }
    .flt-brand-sub { font-size: 10.5px; color: #8899ae; font-weight: 600; }

    .flt-ownership-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 800;
    }
    .ownership-company { background: #eaf1ff; color: var(--fc-blue); border: 1px solid #bdd4fc; }
    .ownership-external { background: #fff8e6; color: #9a6d08; border: 1px solid #f0d898; }

    .flt-doc-cell { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }
    .flt-doc-badge { display: inline-flex; padding: 2px 8px; border-radius: 5px; font-size: 10px; font-weight: 700; white-space: nowrap; }
    .doc-valid   { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .doc-warning { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }
    .doc-expired { background: var(--fc-red-lt); color: var(--fc-red); border: 1px solid #ffc8cf; }

    .flt-status-chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 7px; font-size: 10.5px; font-weight: 800; }
    .flt-status-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; }
    .chip-available   { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .chip-intrip      { background: var(--fc-blue-lt); color: var(--fc-blue); border: 1px solid #c0d4fb; }
    .chip-maintenance { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }
    .chip-outofservice{ background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }
    .dot-available    { background: var(--fc-green); }
    .dot-intrip       { background: var(--fc-blue); }
    .dot-maintenance  { background: var(--fc-amber); }
    .dot-outofservice { background: #6b7d95; }

