@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("USER.VIEW")   ?? false;
    private bool CanManage => _user?.Can("USER.MANAGE") ?? false;

    private List<UserItem> _users = new();
    private List<RoleItem> _roles = new();
    private bool   _loading;
    private string? _loadError;
    private string _search = "";
    private string _filter = "all";
    private int?   _confirmId;

    private bool    _panelOpen;
    private int?    _editingId;
    private UserForm _form = new();
    private bool    _saving;
    private string? _saveMsg;
    private bool    _saveOk;

    private UserItem? _pwdFor;
    private string   _newPwd  = "";
    private string   _newPwd2 = "";
    private bool     _savingPwd;

    private UserItem?        _ovFor;
    private bool             _ovLoading;
    private bool             _ovSaving;
    private List<PermModule> _ovCatalog = new();
    private Dictionary<int, string> _ovState = new();

    /* ── DTOs ── */
    public class UserItem
    {
        public int       Id          { get; set; }
        public string    UserName    { get; set; } = "";
        public string    FullName    { get; set; } = "";
        public string?   Email       { get; set; }
        public bool      IsActive    { get; set; }
        public string    UserStatus  { get; set; } = "";
        public DateTime? LastLoginAt { get; set; }
        public string    Roles       { get; set; } = "";
    }

    public class RoleItem
    {
        public int    Id        { get; set; }
        public string RoleCode  { get; set; } = "";
        public string NameAr    { get; set; } = "";
        public bool   IsSystem  { get; set; }
        public bool   IsActive  { get; set; }
        public int    UserCount { get; set; }
    }

    public class UserForm
    {
        public string  UserName { get; set; } = "";
        public string  Password { get; set; } = "";
        public string  FullName { get; set; } = "";
        public string? Email    { get; set; }
        public bool    IsActive { get; set; } = true;
        public List<int> RoleIds { get; set; } = new();
    }

    public class UserDetail
    {
        public int       Id       { get; set; }
        public string    UserName { get; set; } = "";
        public string    FullName { get; set; } = "";
        public string?   Email    { get; set; }
        public bool      IsActive { get; set; }
        public List<int> RoleIds  { get; set; } = new();
    }

    public class PermItem   { public int PermissionId { get; set; } public string PermissionCode { get; set; } = ""; public string NameAr { get; set; } = ""; }
    public class PermModule { public string ModuleCode { get; set; } = ""; public List<PermItem> Items { get; set; } = new(); }
    public class OvDto      { public int PermissionId { get; set; } public int IsGranted { get; set; } public string? Notes { get; set; } }

    /* ── Filtered ── */
    private IEnumerable<UserItem> Filtered
    {
        get
        {
            var q = _users.AsEnumerable();
            q = _filter switch
            {
                "on"  => q.Where(u => u.IsActive),
                "off" => q.Where(u => !u.IsActive),
                _     => q
            };
            return string.IsNullOrWhiteSpace(_search)
                ? q
                : q.Where(u =>
                    u.UserName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    u.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }
    }

    private static string Initials(UserItem u)
    {
        var parts = (u.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    private async Task Reload() { await LoadAsync(); Snackbar.Add("تم تحديث القائمة", Severity.Success); }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            _users = await Http.GetFromJsonAsync<List<UserItem>>("api/users") ?? new();
            _roles = await Http.GetFromJsonAsync<List<RoleItem>>("api/roles") ?? new();
        }
        catch (Exception ex) { _loadError = "فشل تحميل البيانات: " + ex.Message; }
        finally { _loading = false; }
    }

    /* ── Panel ── */
    private void NewUser()
    {
        _editingId = null; _form = new UserForm(); _saveMsg = null;
        _panelOpen = true; _pwdFor = null; _ovFor = null; _confirmId = null;
    }

    private async Task Edit(UserItem u)
    {
        _saveMsg = null; _pwdFor = null; _ovFor = null; _confirmId = null;
        try
        {
            var d = await Http.GetFromJsonAsync<UserDetail>($"api/users/{u.Id}");
            if (d is null) { Snackbar.Add("فشل تحميل المستخدم", Severity.Error); return; }
            _editingId = d.Id;
            _form = new UserForm { UserName = d.UserName, FullName = d.FullName, Email = d.Email, IsActive = d.IsActive, RoleIds = d.RoleIds };
            _panelOpen = true;
        }
        catch (Exception ex) { Snackbar.Add("فشل تحميل المستخدم: " + ex.Message, Severity.Error); }
    }

    private void ToggleRole(int id, bool v)
    {
        if (v && !_form.RoleIds.Contains(id)) _form.RoleIds.Add(id);
        if (!v) _form.RoleIds.Remove(id);
    }

    private void ClosePanel() { _panelOpen = false; _editingId = null; }

    private async Task SaveAsync()
    {
        _saveMsg = null;
        if (string.IsNullOrWhiteSpace(_form.FullName))
        { _saveOk = false; _saveMsg = "الاسم الكامل مطلوب"; return; }

        _saving = true;
        try
        {
            HttpResponseMessage res;
            if (_editingId is null)
            {
                if (string.IsNullOrWhiteSpace(_form.UserName) || _form.Password.Length < 8)
                { _saveOk = false; _saveMsg = "اسم المستخدم وكلمة مرور 8+ حروف مطلوبين"; _saving = false; return; }

                res = await Http.PostAsJsonAsync("api/users", new
                {
                    userName = _form.UserName.Trim(), password = _form.Password,
                    fullName = _form.FullName.Trim(), email = _form.Email,
                    branchId = (int?)null, roleIds = _form.RoleIds
                });
            }
            else
            {
                res = await Http.PutAsJsonAsync($"api/users/{_editingId}", new
                {
                    fullName = _form.FullName.Trim(), email = _form.Email,
                    branchId = (int?)null, isActive = _form.IsActive,
                    userStatus = _form.IsActive ? "Active" : "Inactive",
                    roleIds = _form.RoleIds
                });
            }

            var msg = await MsgOf(res); _saveOk = res.IsSuccessStatusCode; _saveMsg = msg;
            if (res.IsSuccessStatusCode) { Snackbar.Add(msg, Severity.Success); ClosePanel(); await LoadAsync(); }
        }
        catch (Exception ex) { _saveOk = false; _saveMsg = "مش قادر أوصل للسيرفر: " + ex.Message; }
        finally { _saving = false; }
    }

    /* ── Disable ── */
    private async Task Disable(UserItem u)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/users/{u.Id}");
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل التعطيل: " + ex.Message, Severity.Error); }
    }

    /* ── Password ── */
    private void OpenPwd(UserItem u) { _pwdFor = u; _newPwd = _newPwd2 = ""; _panelOpen = false; _ovFor = null; _confirmId = null; }

    private async Task SavePwdAsync()
    {
        if (_pwdFor is null) return;
        if (_newPwd.Length < 8)  { Snackbar.Add("كلمة المرور لازم تكون 8 حروف على الأقل", Severity.Error); return; }
        if (_newPwd != _newPwd2) { Snackbar.Add("التأكيد مش مطابق", Severity.Error); return; }

        _savingPwd = true;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/users/{_pwdFor.Id}/reset-password", new { newPassword = _newPwd });
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) _pwdFor = null;
        }
        catch (Exception ex) { Snackbar.Add("فشل التعيين: " + ex.Message, Severity.Error); }
        finally { _savingPwd = false; }
    }

    /* ── Overrides ── */
    private async Task OpenOverrides(UserItem u)
    {
        _ovFor = u; _panelOpen = false; _pwdFor = null; _confirmId = null;
        _ovLoading = true; _ovState = new();
        try
        {
            _ovCatalog = await Http.GetFromJsonAsync<List<PermModule>>("api/permissions") ?? new();
            var current = await Http.GetFromJsonAsync<List<OvDto>>($"api/users/{u.Id}/permissions") ?? new();
            foreach (var o in current) _ovState[o.PermissionId] = o.IsGranted != 0 ? "grant" : "deny";
        }
        catch (Exception ex) { Snackbar.Add("فشل تحميل الصلاحيات: " + ex.Message, Severity.Error); }
        finally { _ovLoading = false; }
    }

    private string OvState(int pid) => _ovState.TryGetValue(pid, out var s) ? s : "default";

    private void SetOv(int pid, string? v)
    {
        v ??= "default";
        if (v == "default") _ovState.Remove(pid);
        else _ovState[pid] = v;
    }

    private void CloseOverrides() { _ovFor = null; }

    private async Task SaveOverridesAsync()
    {
        if (_ovFor is null) return;
        _ovSaving = true;
        try
        {
            var payload = _ovState
                .Select(kv => new { permissionId = kv.Key, isGranted = kv.Value == "grant" ? 1 : 0, notes = (string?)null })
                .ToList();

            var res = await Http.PutAsJsonAsync($"api/users/{_ovFor.Id}/permissions", payload);
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) _ovFor = null;
        }
        catch (Exception ex) { Snackbar.Add("فشل الحفظ: " + ex.Message, Severity.Error); }
        finally { _ovSaving = false; }
    }

    /* ── Helpers ── */
    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var body = await res.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return res.IsSuccessStatusCode ? "تم" : "خطأ غير معروف";
            var doc = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(body);
            if (doc.TryGetProperty("message", out var m)) return m.GetString() ?? body;
            return body;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ HTTP {(int)res.StatusCode}"; }
    }
}