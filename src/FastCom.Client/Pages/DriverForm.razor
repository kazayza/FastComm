@page "/drivers/new"
@page "/drivers/new/{Id:int}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "سائق جديد" : "تعديل سائق") — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">الأسطول · السائقون</div>
                <h1 class="fc-hero-title">@(_id is null ? "سائق جديد" : $"تعديل {DriverCode}")</h1>
                <p class="fc-hero-sub">سجّل السائق ورخصته — والكود بيتولد تلقائيًا (DRV-)</p>
            </div>
            <div class="fc-head-actions">
                <MudButton Variant="Variant.Outlined" OnClick="GoBack" Style="color:#9FB4CC">رجوع</MudButton>
                @if (CanSave)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="SaveAsync">حفظ</MudButton>
                }
            </div>
        </div>
    </div>
</div>

<div class="fc-page">
    @if (!CanSave)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            @(_id is null ? "ليس لديك صلاحية إضافة سائق." : "ليس لديك صلاحية تعديل سائق.")
        </MudAlert>
    }
    else if (_loading)
    {
        <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">

            @if (_msg is not null)
            {
                <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Class="mb-4">@_msg</MudAlert>
            }

            @* ══════════ 1. الانتماء — بيتبدّل حسب النوع ══════════ *@
            <div class="fc-panel-sub" style="margin-bottom:14px">الانتماء</div>
            <div class="fc-form-grid">
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">نوع السائق *</div>
                    <select class="fc-sel fc-sel-lg" value="@_f.DriverType" @onchange="OnTypeChanged">
                        <option value="Internal">داخلي (موظف)</option>
                        <option value="External">خارجي (مورد)</option>
                    </select>
                </div>
                @if (IsInternal)
                {
                    <div>
                        <div class="fc-panel-sub" style="margin-bottom:6px">الموظف *</div>
                        <select class="fc-sel fc-sel-lg" @bind="_f.EmployeeId">
                            <option value="">— اختار —</option>
                            @foreach (var e in _employees) { <option value="@e.Id">@e.Label</option> }
                        </select>
                        <div class="fc-field-hint">الاسم بيتعبّى من ملف الموظف — بس تقدر تعدّله هنا</div>
                    </div>
                }
                else
                {
                    <div>
                        <div class="fc-panel-sub" style="margin-bottom:6px">المورد *</div>
                        <select class="fc-sel fc-sel-lg" @bind="_f.SupplierId">
                            <option value="">— اختار —</option>
                            @foreach (var s in _suppliers) { <option value="@s.Id">@s.Label</option> }
                        </select>
                    </div>
                }
            </div>

            @* ══════════ 2. البيانات الشخصية ══════════ *@
            <div class="fc-panel-sub" style="margin:26px 0 14px">البيانات الشخصية</div>
            <div class="fc-form-grid">
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">الاسم الكامل *</div>
                    <input class="fc-sel fc-sel-lg" @bind="_f.FullName" maxlength="150" />
                </div>
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">الرقم القومي</div>
                    <input class="fc-sel fc-sel-lg" @bind="_f.NationalId" maxlength="14" dir="ltr"
                           style="text-align:right" />
                </div>
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">الموبايل</div>
                    <input class="fc-sel fc-sel-lg" @bind="_f.Mobile" maxlength="20" dir="ltr"
                           style="text-align:right" />
                </div>
            </div>

            @* ══════════ 3. الرخصة ══════════ *@
            <div class="fc-panel-sub" style="margin:26px 0 14px">رخصة القيادة</div>
            <div class="fc-form-grid">
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">رقم الرخصة</div>
                    <input class="fc-sel fc-sel-lg" @bind="_f.LicenseNumber" maxlength="50" dir="ltr"
                           style="text-align:right" />
                </div>
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">درجة الرخصة</div>
                    <input class="fc-sel fc-sel-lg" @bind="_f.LicenseType" maxlength="20" />
                    <div class="fc-field-hint">أولى · ثانية · ثالثة…</div>
                </div>
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">تاريخ انتهاء الرخصة</div>
                    @* 🔴 `@bind` على `type="date"` محتاج DateOnly? — وده string. فـ `@onchange`. *@
                    <input type="date" class="fc-sel fc-sel-lg" value="@_f.LicenseExpiryDate"
                           @onchange="OnExpiryChanged" />
                    <div class="fc-field-hint">النظام بينبّه قبل الانتهاء بـ 30 يوم</div>
                </div>
            </div>

            @if (ExpiringSoon)
            {
                <div class="fc-alert fc-alert-warn" style="margin-top:18px">
                    <div class="fc-alert-ic"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div class="fc-alert-body">
                        <div class="fc-alert-title">الرخصة هتخلص قريبًا</div>
                        <div>فاضل @DaysLeft يوم على انتهاء الرخصة — جدّدها قبل ما السائق يقف.</div>
                    </div>
                </div>
            }

            @* ══════════ 4. الحالة ══════════ *@
            <div class="fc-panel-sub" style="margin:26px 0 14px">الحالة</div>
            <div class="fc-form-grid">
                <div>
                    <div class="fc-panel-sub" style="margin-bottom:6px">الحالة</div>
                    <select class="fc-sel fc-sel-lg" @bind="_f.Status">
                        <option value="Active">نشط</option>
                        <option value="Inactive">غير نشط</option>
                        <option value="Suspended">موقوف</option>
                    </select>
                </div>
            </div>

            <div class="fc-panel-sub" style="margin:26px 0 8px">ملاحظات</div>
            <textarea class="fc-sel" rows="3" maxlength="500"
                      @onchange="e => _f.Notes = e.Value?.ToString()">@_f.Notes</textarea>

            <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:26px">
                <MudButton Variant="Variant.Outlined" OnClick="GoBack">رجوع</MudButton>
                @if (CanSave)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                               OnClick="SaveAsync">حفظ</MudButton>
                }
            </div>

        </div></div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private int? _id;
    private string DriverCode = "";

    private AuthUser? _user;
    private bool CanCreate => _user?.Can("DRIVER.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("DRIVER.EDIT") ?? false;
    private bool CanSave   => _id is null ? CanCreate : CanEdit;

    private bool _loading; private bool _saving;
    private string? _msg; private bool _ok = true;

    private List<Opt> _employees = new();
    private List<Opt> _suppliers = new();
    private Form _f = new();

    private bool IsInternal => _f.DriverType == "Internal";

    private bool ExpiringSoon =>
        DateOnly.TryParse(_f.LicenseExpiryDate, out var d) &&
        d > DateOnly.FromDateTime(DateTime.Today) &&
        d <= DateOnly.FromDateTime(DateTime.Today.AddDays(30));

    private int DaysLeft =>
        DateOnly.TryParse(_f.LicenseExpiryDate, out var d)
            ? d.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber
            : 0;

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    /// <summary>مطابق لـ <c>DriversController.Upsert</c> — 11 حقل.</summary>
    public class Form
    {
        public string DriverType { get; set; } = "Internal";
        public int? EmployeeId { get; set; }
        public int? SupplierId { get; set; }
        public string FullName { get; set; } = "";
        public string? NationalId { get; set; }
        public string? Mobile { get; set; }
        public string? LicenseNumber { get; set; }
        public string? LicenseType { get; set; }
        public string? LicenseExpiryDate { get; set; }
        public string Status { get; set; } = "Active";
        public string? Notes { get; set; }
    }

    /// <summary>مطابق لـ <c>DriversController.Detail</c> — 13 حقل.</summary>
    public class Detail
    {
        public int DriverId { get; set; }
        public string DriverCode { get; set; } = "";
        public string DriverType { get; set; } = "";
        public int? EmployeeId { get; set; }
        public int? SupplierId { get; set; }
        public string FullName { get; set; } = "";
        public string? NationalId { get; set; }
        public string? Mobile { get; set; }
        public string? LicenseNumber { get; set; }
        public string? LicenseType { get; set; }
        public DateOnly? LicenseExpiryDate { get; set; }
        public string Status { get; set; } = "";
        public string? Notes { get; set; }
    }

    // ═══════════════ Init ═══════════════

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id = Id;
        if (!CanSave) return;

        _loading = true;
        try
        {
            _employees = await SafeGetT<Opt>("api/options/employees");
            _suppliers = await SafeGetT<Opt>("api/options/suppliers");
            if (_id is not null) await LoadAsync(_id.Value);
        }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; _ok = false; }
        finally { _loading = false; }
    }

    private async Task LoadAsync(int id)
    {
        var d = await Http.GetFromJsonAsync<Detail>($"api/drivers/{id}");
        if (d is null) { _msg = "السائق غير موجود"; _ok = false; return; }

        DriverCode = d.DriverCode;
        _f = new Form
        {
            DriverType        = d.DriverType,
            EmployeeId        = d.EmployeeId,
            SupplierId        = d.SupplierId,
            FullName          = d.FullName,
            NationalId        = d.NationalId,
            Mobile            = d.Mobile,
            LicenseNumber     = d.LicenseNumber,
            LicenseType       = d.LicenseType,
            LicenseExpiryDate = d.LicenseExpiryDate?.ToString("yyyy-MM-dd"),
            Status            = d.Status,
            Notes             = d.Notes
        };
    }

    // ═══════════════ Handlers ═══════════════

    /* 🔴 لما النوع يتبدّل نشيل الربط التاني — وإلا هنبعت employeeId و supplierId مع بعض. */
    private void OnTypeChanged(ChangeEventArgs e)
    {
        _f.DriverType = e.Value?.ToString() ?? "Internal";
        if (IsInternal) _f.SupplierId = null;
        else            _f.EmployeeId = null;
    }

    private void OnExpiryChanged(ChangeEventArgs e) =>
        _f.LicenseExpiryDate = e.Value?.ToString();

    // ═══════════════ Save ═══════════════

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true; _msg = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_f.FullName))
            { _msg = "الاسم الكامل مطلوب"; _ok = false; return; }
            if (IsInternal && _f.EmployeeId is null)
            { _msg = "اختار الموظف — السائق الداخلي لازم مربوط بموظف"; _ok = false; return; }
            if (!IsInternal && _f.SupplierId is null)
            { _msg = "اختار المورد — السائق الخارجي لازم مربوط بمورد"; _ok = false; return; }

            var payload = new
            {
                driverType        = _f.DriverType,
                employeeId        = _f.EmployeeId,
                supplierId        = _f.SupplierId,
                fullName          = _f.FullName,
                nationalId        = _f.NationalId,
                mobile            = _f.Mobile,
                licenseNumber     = _f.LicenseNumber,
                licenseType       = _f.LicenseType,
                licenseExpiryDate = _f.LicenseExpiryDate,
                status            = _f.Status,
                notes             = _f.Notes
            };

            var res = _id is null
                ? await Http.PostAsJsonAsync("api/drivers", payload)
                : await Http.PutAsJsonAsync($"api/drivers/{_id}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    // ═══════════════ Helpers ═══════════════

    private void GoBack() => Nav.NavigateTo("/drivers");

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "✅ تم الحفظ" : "حصل خطأ — حاول تاني"; }
    }
}
