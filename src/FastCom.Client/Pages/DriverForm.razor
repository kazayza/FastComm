        transition: all .15s ease;
    }
    .drv-bottom-save:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(30,110,245,.36); }
    .drv-bottom-save:disabled { opacity: .6; cursor: not-allowed; }

    .btn-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: drv-spin .7s linear infinite; }
    .btn-spinner.sm { width: 13px; height: 13px; }

    @@media (max-width: 900px) {
        .drv-form-grid { grid-template-columns: 1fr; }
        .drv-tab-section { padding: 16px 14px 20px; }
