@page "/drivers/new"
@page "/drivers/new/{Id:int}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "سائق جديد" : "تعديل سائق") — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO SECTION (bk-* — نفس عيلة فورم الفاتورة)
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="bk-hero-row">
                <div class="bk-hero-left">
                    <div class="bk-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span>الأسطول التشغيلي · السائقون</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">
                        @if (_id is null)
                        {
                            <span>سائق جديد</span>
                        }
                        else
                        {
                            <span>@DriverCode</span>
                        }
                    </h1>
                    <span class="bk-hero-sub">
                        @(_id is null ? "تسجيل سائق جديد وربطه بالموظف أو المورد — يُولَّد الكود تلقائيًا بالبادئة (DRV-)" : $"تعديل البيانات الشخصية ورخصة القيادة للسائق {DriverCode}")
                    </span>
                </div>

                <div class="bk-hero-right">
                    @if (_id is not null)
                    {
                        <span class="bk-hero-chip @StatusBadge(_f.Status)">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 6v6l4 2" stroke-linecap="round"/>
                            </svg>
                            @StatusAr(_f.Status)
                        </span>
                    }
                    <span class="bk-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

        </div>
    </div>
</div>


@* ── FAB (زر عائم للحفظ السريع) ── *@
@if (CanSave)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="SaveAsync" disabled="@_saving">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                        <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span class="glow-fab-item-lb">@(_saving ? "جاري الحفظ..." : "حفظ السائق")</span>
            </button>
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="GoBack">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span class="glow-fab-item-lb">إلغاء</span>
            </button>
        </div>

        <div class="glow-fab-container">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="glow-fab-btn" @onclick="ToggleFab" aria-label="التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

    </div>
}

@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
}


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="bk-body">

    @if (!CanSave)
    {
        <div class="bk-state-box">
            <div class="bk-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>@(_id is null ? "ليس لديك صلاحية إضافة سائق جديد." : "ليس لديك صلاحية تعديل بيانات هذا السائق.")</p>
            <button class="bk-state-back" @onclick="GoBack">العودة لقائمة السائقين</button>
        </div>
    }

    else if (_loading)
    {
        <div class="bk-loading-wrap">
            <div class="bk-spinner" aria-label="جاري التحميل"></div>
            <div class="bk-loading-text">جاري تحميل بيانات السائق...</div>
        </div>
    }

    else
    {
        @* تنبيه اقتراب انتهاء الرخصة *@
        @if (ExpiringSoon)
        {
            <div class="bk-banner banner-warn" role="alert">
                <div aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                        <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                    </svg>
                </div>
                <span><b>الرخصة قاربت على الانتهاء</b> — يتبقى <b>@DaysLeft يومًا</b> على انتهاء رخصة القيادة، يرجى تجديدها لتجنب إيقاف السائق.</span>
            </div>
        }

        @* بانر الرسائل *@
        @if (_msg is not null)
        {
            <div class="bk-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                <div aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="banner-close" @onclick="() => _msg = null">&#10005;</button>
            </div>
        }

        @* ═══════ TABS ═══════ *@
        <div class="bk-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="bk-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="bk-mud-tabs">

                @* ═══ TAB 1 — البيانات الأساسية ═══ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <span>البيانات الأساسية</span>
                            @if (HasTabError(1))
                            {
                                <span class="btab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            @* ── الانتماء ── *@
                            <div class="tab-section-head">
                                <div class="tab-section-icon blue" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">الانتماء</div>
                                    <div class="tab-section-sub">تحديد نوع السائق وربطه بالموظف أو المورد</div>
                                </div>
                            </div>

                            <div class="bk-form-grid">
                                <div class="form-field">
                                    <label class="field-label">
                                        نوع السائق
                                        <span class="field-required" aria-label="مطلوب">*</span>
                                    </label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                        </svg>
                                        <select class="field-input field-select" value="@_f.DriverType"
                                                @onchange="e => OnTypeChanged(e.Value?.ToString())">
                                            <option value="Internal" selected="@(_f.DriverType == "Internal")">داخلي (موظف)</option>
                                            <option value="External" selected="@(_f.DriverType == "External")">خارجي (مورد)</option>
                                        </select>
                                    </div>
                                </div>

                                @if (IsInternal)
                                {
                                    <div class="form-field">
                                        <label class="field-label">
                                            الموظف المرتبط
                                            <span class="field-required" aria-label="مطلوب">*</span>
                                        </label>
                                        <div class="field-select-wrap">
                                            <svg class="field-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                                <circle cx="12" cy="7" r="4"/>
                                            </svg>
                                            <select class="field-input field-select @(_f.EmployeeId is null && _triedSave ? "field-error" : "")"
                                                    value="@_f.EmployeeId" @onchange="e => _f.EmployeeId = Nul(e.Value)">
                                                <option value="">— اختر الموظف —</option>
                                                @foreach (var e in _employees)
                                                {
                                                    <option value="@e.Id">@e.Label</option>
                                                }
                                            </select>
                                        </div>
                                        @if (_f.EmployeeId is null && _triedSave)
                                        {
                                            <div class="field-err-msg" role="alert">يجب ربط السائق الداخلي بموظف</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="form-field">
                                        <label class="field-label">
                                            المورد المرتبط
                                            <span class="field-required" aria-label="مطلوب">*</span>
                                        </label>
                                        <div class="field-select-wrap">
                                            <svg class="field-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                                <path d="M9 22V12h6v10"/>
                                            </svg>
                                            <select class="field-input field-select @(_f.SupplierId is null && _triedSave ? "field-error" : "")"
                                                    value="@_f.SupplierId" @onchange="e => _f.SupplierId = Nul(e.Value)">
                                                <option value="">— اختر المورد —</option>
                                                @foreach (var s in _suppliers)
                                                {
                                                    <option value="@s.Id">@s.Label</option>
                                                }
                                            </select>
                                        </div>
                                        @if (_f.SupplierId is null && _triedSave)
                                        {
                                            <div class="field-err-msg" role="alert">يجب ربط السائق الخارجي بمورد</div>
                                        }
                                    </div>
                                }
                            </div>

                            @* ── البيانات الشخصية ── *@
                            <div class="tab-section-head">
                                <div class="tab-section-icon green" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">البيانات الشخصية</div>
                                    <div class="tab-section-sub">اسم السائق ووسائل التواصل والرقم القومي</div>
                                </div>
                            </div>

                            <div class="bk-form-grid">
                                <div class="form-field">
                                    <label class="field-label">
                                        الاسم الكامل
                                        <span class="field-required" aria-label="مطلوب">*</span>
                                    </label>
                                    <input class="field-input @(string.IsNullOrWhiteSpace(_f.FullName) && _triedSave ? "field-error" : "")"
                                           @bind="_f.FullName" maxlength="150"
                                           placeholder="الاسم الكامل للسائق" aria-required="true" />
                                    @if (string.IsNullOrWhiteSpace(_f.FullName) && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">الاسم الكامل مطلوب</div>
                                    }
                                </div>

                                <div class="form-field">
                                    <label class="field-label">الموبايل</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="5" y="2" width="14" height="20" rx="2"/>
                                                <path d="M12 18h.01" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input class="field-input with-prefix" @bind="_f.Mobile"
                                               maxlength="20" placeholder="01X-XXXXXXXX" type="tel" dir="ltr" />
                                    </div>
                                </div>

                                <div class="form-field">
                                    <label class="field-label">الرقم القومي</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7">
                                                <rect x="2" y="4" width="12" height="9" rx="1"/>
                                                <circle cx="6" cy="8" r="1.5"/>
                                                <path d="M9 7h3M9 9.5h2" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input class="field-input with-prefix" @bind="_f.NationalId"
                                               maxlength="14" placeholder="14 رقمًا" dir="ltr" />
                                    </div>
                                </div>
                            </div>

                            @* ── الحالة الوظيفية ── *@
                            <div class="tab-section-head">
                                <div class="tab-section-icon amber" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                        <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">الحالة الوظيفية</div>
                                    <div class="tab-section-sub">نشط / غير نشط / موقوف</div>
                                </div>
                            </div>

                            <div class="bk-form-grid">
                                <div class="form-field">
                                    <label class="field-label">
                                        الحالة
                                        <span class="field-required" aria-label="مطلوب">*</span>
                                    </label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"/>
                                            <path d="M12 6v6l4 2" stroke-linecap="round"/>
                                        </svg>
                                        <select class="field-input field-select" @bind="_f.Status">
                                            <option value="Active" selected="@(_f.Status == "Active")">نشط</option>
                                            <option value="Inactive" selected="@(_f.Status == "Inactive")">غير نشط</option>
                                            <option value="Suspended" selected="@(_f.Status == "Suspended")">موقوف</option>
                                        </select>
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        السائق غير النشط أو الموقوف لا يُرشَّح لإسناد الرحلات
                                    </div>
                                </div>
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>

                @* ═══ TAB 2 — رخصة القيادة ═══ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-amber" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                                    <path d="M2 10h20"/>
                                    <circle cx="7" cy="15" r="1.5" fill="currentColor"/>
                                </svg>
                            </div>
                            <span>رخصة القيادة</span>
                            @if (ExpiringSoon)
                            {
                                <span class="btab-warn-dot" aria-label="الرخصة قريبة الانتهاء"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon amber" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="5" width="20" height="14" rx="2"/>
                                        <path d="M2 10h20"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">رخصة القيادة</div>
                                    <div class="tab-section-sub">بيانات الرخصة وتاريخ الانتهاء — ينبّه النظام تلقائيًا قبل الانتهاء بـ 30 يومًا</div>
                                </div>
                            </div>

                            <div class="bk-form-grid">
                                <div class="form-field">
                                    <label class="field-label">رقم الرخصة</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7">
                                                <rect x="2" y="2" width="12" height="12" rx="2"/>
                                                <path d="M5 8h6M5 5h6M5 11h4" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input class="field-input with-prefix" @bind="_f.LicenseNumber"
                                               maxlength="50" placeholder="رقم الرخصة" dir="ltr" />
                                    </div>
                                </div>

                                <div class="form-field">
                                    <label class="field-label">درجة الرخصة</label>
                                    <input class="field-input" @bind="_f.LicenseType"
                                           maxlength="20" placeholder="أولى · ثانية · ثالثة..." />
                                </div>

                                <div class="form-field">
                                    <label class="field-label">تاريخ انتهاء الرخصة</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input type="date" class="field-input with-prefix @(ExpiringSoon ? "field-warn" : "")"
                                               value="@_f.LicenseExpiryDate" @onchange="OnExpiryChanged" />
                                    </div>
                                </div>
                            </div>

                            @* حالة الرخصة *@
                            @if (!string.IsNullOrWhiteSpace(_f.LicenseExpiryDate))
                            {
                                var lic = GetLicStatusStr(_f.LicenseExpiryDate);
                                @if (lic.cls != "")
                                {
                                    <div class="bk-banner @lic.cls" role="status">
                                        <div aria-hidden="true">
                                            @if (lic.cls == "banner-success")
                                            {
                                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                                    <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            }
                                            else if (lic.cls == "banner-warn")
                                            {
                                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                                                    <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                                </svg>
                                            }
                                        </div>
                                        <span><b>@lic.title</b> — @lic.detail</span>
                                    </div>
                                }
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>

                @* ═══ TAB 3 — الملاحظات ═══ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                            </div>
                            <span>الملاحظات</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">
                            <div class="tab-section-head">
                                <div class="tab-section-icon green" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">ملاحظات</div>
                                    <div class="tab-section-sub">أي تفاصيل إضافية عن السائق</div>
                                </div>
                            </div>
                            <div class="form-field">
                                <textarea class="field-input field-textarea" rows="5" maxlength="500"
                                          placeholder="ملاحظات خاصة بالسائق..." @bind="_f.Notes"></textarea>
                            </div>
                        </div>
                    </ChildContent>
                </MudTabPanel>

            </MudTabs>
        </div>

        @* ═══ الشريط السفلي ═══ *@
        <div class="bk-bottom-actions">
            <button class="bk-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                العودة لقائمة السائقين
            </button>
            @if (CanSave)
            {
                <div class="bk-bottom-right">
                    @if (_activeTab < 2)
                    {
                        <button class="bk-next-btn" @onclick="() => _activeTab++">
                            التالي
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    }
                    <button class="bk-bottom-save" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ السائق</span>
                        }
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private int?   _id;
    private string DriverCode  = "";
    private int    _activeTab;
    private bool   _triedSave;
    private bool   _fabOpen;

    private AuthUser? _user;
    private bool CanCreate => _user?.Can("DRIVER.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("DRIVER.EDIT")   ?? false;
    private bool CanSave   => _id is null ? CanCreate : CanEdit;

    private bool    _loading; private bool _saving;
    private string? _msg;     private bool _ok = true;

    private List<Opt> _employees = new();
    private List<Opt> _suppliers = new();
    private Form _f = new();

    private bool IsInternal => _f.DriverType == "Internal";

    private void ToggleFab() => _fabOpen = !_fabOpen;

    private bool ExpiringSoon =>
        DateOnly.TryParse(_f.LicenseExpiryDate, out var d) &&
        d > DateOnly.FromDateTime(DateTime.Today) &&
        d <= DateOnly.FromDateTime(DateTime.Today).AddDays(30);

    private int DaysLeft =>
        DateOnly.TryParse(_f.LicenseExpiryDate, out var d)
            ? d.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber
            : 0;

    /* تحقق التبويب الأول */
    private bool HasTabError(int tab) => _triedSave && tab switch
    {
        1 => string.IsNullOrWhiteSpace(_f.FullName) ||
             (IsInternal && _f.EmployeeId is null) ||
             (!IsInternal && _f.SupplierId is null),
        _ => false
    };

    /* حالة الرخصة — بدون أي إيموجي */
    private static (string cls, string title, string detail) GetLicStatusStr(string? dateStr)
    {
        if (!DateOnly.TryParse(dateStr, out var d))
            return ("", "", "");
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (d < today)
            return ("banner-error", "الرخصة منتهية", "يجب تجديد الرخصة فورًا قبل إسناد أي رحلة");
        var days = d.DayNumber - today.DayNumber;
        if (days <= 30)
            return ("banner-warn", $"تنتهي الرخصة بعد {days} يومًا", "يرجى التجديد في أقرب وقت");
        return ("banner-success", "الرخصة سارية", $"تنتهي في {d:yyyy-MM-dd}");
    }

    private static string StatusAr(string s) => s switch
    {
        "Active" => "نشط", "Inactive" => "غير نشط", "Suspended" => "موقوف", _ => s
    };

    private static string StatusBadge(string s) => s switch
    {
        "Active"    => "badge-active",
        "Suspended" => "badge-suspended",
        _           => "badge-inactive"
    };

    private static int? Nul(object? v) => int.TryParse(v?.ToString(), out var n) && n > 0 ? n : null;

    /* DTOs */
    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    public class Form
    {
        public string  DriverType        { get; set; } = "Internal";
        public int?    EmployeeId        { get; set; }
        public int?    SupplierId        { get; set; }
        public string  FullName          { get; set; } = "";
        public string? NationalId        { get; set; }
        public string? Mobile            { get; set; }
        public string? LicenseNumber     { get; set; }
        public string? LicenseType       { get; set; }
        public string? LicenseExpiryDate { get; set; }
        public string  Status            { get; set; } = "Active";
        public string? Notes             { get; set; }
    }

    public class Detail
    {
        public int     DriverId          { get; set; }
        public string  DriverCode        { get; set; } = "";
        public string  DriverType        { get; set; } = "";
        public int?    EmployeeId        { get; set; }
        public int?    SupplierId        { get; set; }
        public string  FullName          { get; set; } = "";
        public string? NationalId        { get; set; }
        public string? Mobile            { get; set; }
        public string? LicenseNumber     { get; set; }
        public string? LicenseType       { get; set; }
        public DateOnly? LicenseExpiryDate { get; set; }
        public string  Status            { get; set; } = "";
        public string? Notes             { get; set; }
    }

    /* Init */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id   = Id;
        if (!CanSave) return;

        _loading = true;
        try
        {
            _employees = await SafeGetT<Opt>("api/options/employees");
            _suppliers = await SafeGetT<Opt>("api/options/suppliers");
            if (_id is not null) await LoadAsync(_id.Value);
        }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; _ok = false; }
        finally { _loading = false; }
    }

    private async Task LoadAsync(int id)
    {
        var d = await Http.GetFromJsonAsync<Detail>($"api/drivers/{id}");
        if (d is null) { _msg = "السائق غير موجود"; _ok = false; return; }

        DriverCode = d.DriverCode;
        _f = new Form
        {
            DriverType        = d.DriverType,
            EmployeeId        = d.EmployeeId,
            SupplierId        = d.SupplierId,
            FullName          = d.FullName,
            NationalId        = d.NationalId,
            Mobile            = d.Mobile,
            LicenseNumber     = d.LicenseNumber,
            LicenseType       = d.LicenseType,
            LicenseExpiryDate = d.LicenseExpiryDate?.ToString("yyyy-MM-dd"),
            Status            = d.Status,
            Notes             = d.Notes
        };
    }

    /* Handlers */
    private void OnTypeChanged(string? type)
    {
        if (type is null) return;
        _f.DriverType = type;
        if (IsInternal) _f.SupplierId = null;
        else            _f.EmployeeId = null;
    }

    private void OnExpiryChanged(ChangeEventArgs e) =>
        _f.LicenseExpiryDate = e.Value?.ToString();

    /* Save */
    private async Task SaveAsync()
    {
        if (_saving) return;
        _triedSave = true;
        _saving    = true;
        _msg       = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_f.FullName))
            { _msg = "الاسم الكامل مطلوب"; _ok = false; _activeTab = 0; return; }

            if (IsInternal && _f.EmployeeId is null)
            { _msg = "يرجى اختيار الموظف — السائق الداخلي يجب ربطه بموظف"; _ok = false; _activeTab = 0; return; }

            if (!IsInternal && _f.SupplierId is null)
            { _msg = "يرجى اختيار المورد — السائق الخارجي يجب ربطه بمورد"; _ok = false; _activeTab = 0; return; }

            var payload = new
            {
                driverType        = _f.DriverType,
                employeeId        = _f.EmployeeId,
                supplierId        = _f.SupplierId,
                fullName          = _f.FullName,
                nationalId        = _f.NationalId,
                mobile            = _f.Mobile,
                licenseNumber     = _f.LicenseNumber,
                licenseType       = _f.LicenseType,
                licenseExpiryDate = _f.LicenseExpiryDate,
                status            = _f.Status,
                notes             = _f.Notes
            };

            var res = _id is null
                ? await Http.PostAsJsonAsync("api/drivers", payload)
                : await Http.PutAsJsonAsync($"api/drivers/{_id}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private void GoBack() => Nav.NavigateTo("/drivers");

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم الحفظ بنجاح" : "حدث خطأ — يرجى المحاولة مرة أخرى"; }
    }
}

<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
