@page "/drivers/new"
@page "/drivers/new/{Id:int}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "سائق جديد" : "تعديل سائق") — فاست كوم</PageTitle>


<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">

            <div>
                <div class="fc-crumb">الأسطول · السائقون</div>
                <h1 class="fc-hero-title">
                    @if (_id is null)
                    {
                        <span>سائق جديد</span>
                        <span class="drv-hero-badge badge-new">جديد</span>
                    }
                    else
                    {
                        <span>@DriverCode</span>
                        <span class="drv-hero-badge badge-edit">تعديل</span>
                    }
                </h1>
                <p class="fc-hero-sub">سجّل السائق ورخصته — والكود بيتولد تلقائياً (DRV-)</p>
            </div>

            <div class="fc-head-actions">
                <button class="drv-back-btn" @onclick="GoBack">
                    <svg viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    السائقين
                </button>
                @if (CanSave)
                {
                    <button class="drv-save-btn" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ السائق</span>
                        }
                    </button>
                }
            </div>

        </div>
    </div>
</div>


<div class="drv-body">

    @if (!CanSave)
    {
        <div class="drv-state-box">
            <div class="drv-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>@(_id is null ? "ليس لديك صلاحية إضافة سائق" : "ليس لديك صلاحية تعديل سائق")</p>
            <button class="drv-state-back" @onclick="GoBack">العودة للقائمة</button>
        </div>
    }
    else if (_loading)
    {
        <div class="drv-loading-wrap">
            <div class="drv-spinner" aria-label="جاري التحميل"></div>
            <div class="drv-loading-text">جاري تحميل بيانات السائق...</div>
        </div>
    }
    else
    {
        @if (_msg is not null)
        {
            <div class="drv-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                <div aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="banner-close" @onclick="() => _msg = null">✕</button>
            </div>
        }

        @if (ExpiringSoon)
        {
            <div class="drv-lic-warn" role="alert">
                <div class="lic-warn-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                        <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="lic-warn-text">
                    <strong>الرخصة هتخلص قريباً ⚠️</strong>
                    <span>فاضل <strong>@DaysLeft يوم</strong> على انتهاء الرخصة — جدّدها قبل ما السائق يقف</span>
                </div>
            </div>
        }

        <div class="drv-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="drv-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="drv-mud-tabs">


                @* ── TAB 1: الانتماء والبيانات ── *@
                <MudTabPanel>
                    <TabContent>
                        <div class="dtab-label">
                            <div class="dtab-icon dtab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <span>البيانات الأساسية</span>
                            @if (HasTabError(1))
                            {
                                <span class="dtab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="drv-tab-section">

                            @* ── نوع السائق ── *@
                            <div class="drv-section-card">
                                <div class="drv-section-head">
                                    <div class="drv-section-icon icon-blue" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                            <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="drv-section-title">الانتماء</div>
                                        <div class="drv-section-sub">داخلي (موظف) أو خارجي (مورد)</div>
                                    </div>
                                </div>

                                @* Type Toggle *@
                                <div class="drv-type-toggle" role="group" aria-label="نوع السائق">
                                    <button type="button"
                                            class="drv-type-btn @(_f.DriverType == "Internal" ? "type-active-blue" : "")"
                                            @onclick='() => OnTypeChangedClick("Internal")'
                                            aria-pressed="@(_f.DriverType == "Internal")">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        داخلي (موظف)
                                    </button>
                                    <button type="button"
                                            class="drv-type-btn @(_f.DriverType == "External" ? "type-active-purple" : "")"
                                            @onclick='() => OnTypeChangedClick("External")'
                                            aria-pressed="@(_f.DriverType == "External")">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                            <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                        </svg>
                                        خارجي (مورد)
                                    </button>
                                </div>

                                @* الربط *@
                                <div class="drv-form-grid" style="margin-top:16px">
                                    @if (IsInternal)
                                    {
                                        <div class="drv-field">
                                            <label class="drv-label">
                                                الموظف
                                                <span class="drv-required">*</span>
                                            </label>
                                            <div class="drv-select-wrap">
                                                <svg class="drv-sel-icon" viewBox="0 0 24 24" width="14" height="14"
                                                     fill="none" stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                                    <circle cx="12" cy="7" r="4"/>
                                                </svg>
                                                <select class="drv-input drv-select" @bind="_f.EmployeeId">
                                                    <option value="">— اختار الموظف —</option>
                                                    @foreach (var e in _employees)
                                                    {
                                                        <option value="@e.Id">@e.Label</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="drv-hint">
                                                <svg viewBox="0 0 16 16" width="10" height="10"
                                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                                     aria-hidden="true">
                                                    <circle cx="8" cy="8" r="6"/>
                                                    <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                                </svg>
                                                الاسم بيتعبّى من ملف الموظف — بس تقدر تعدّله
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="drv-field">
                                            <label class="drv-label">
                                                المورد
                                                <span class="drv-required">*</span>
                                            </label>
                                            <div class="drv-select-wrap">
                                                <svg class="drv-sel-icon" viewBox="0 0 24 24" width="14" height="14"
                                                     fill="none" stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                                    <path d="M9 22V12h6v10"/>
                                                </svg>
                                                <select class="drv-input drv-select" @bind="_f.SupplierId">
                                                    <option value="">— اختار المورد —</option>
                                                    @foreach (var s in _suppliers)
                                                    {
                                                        <option value="@s.Id">@s.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>


                            @* ── البيانات الشخصية ── *@
                            <div class="drv-section-card">
                                <div class="drv-section-head">
                                    <div class="drv-section-icon icon-green" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="drv-section-title">البيانات الشخصية</div>
                                        <div class="drv-section-sub">اسم السائق والتواصل</div>
                                    </div>
                                </div>

                                <div class="drv-form-grid">

                                    <div class="drv-field">
                                        <label class="drv-label">
                                            الاسم الكامل
                                            <span class="drv-required">*</span>
                                        </label>
                                        <input class="drv-input @(string.IsNullOrWhiteSpace(_f.FullName) && _triedSave ? "input-error" : "")"
                                               @bind="_f.FullName"
                                               maxlength="150"
                                               placeholder="الاسم الكامل للسائق"
                                               aria-required="true" />
                                        @if (string.IsNullOrWhiteSpace(_f.FullName) && _triedSave)
                                        {
                                            <div class="drv-err-msg" role="alert">الاسم الكامل مطلوب</div>
                                        }
                                    </div>

                                    <div class="drv-field">
                                        <label class="drv-label">الموبايل</label>
                                        <div class="drv-input-group">
                                            <span class="drv-prefix" aria-hidden="true">📱</span>
                                            <input class="drv-input with-prefix"
                                                   @bind="_f.Mobile"
                                                   maxlength="20"
                                                   placeholder="01X-XXXXXXXX"
                                                   type="tel"
                                                   dir="ltr" />
                                        </div>
                                    </div>

                                    <div class="drv-field">
                                        <label class="drv-label">الرقم القومي</label>
                                        <div class="drv-input-group">
                                            <span class="drv-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 16 16" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="1.7">
                                                    <rect x="2" y="4" width="12" height="9" rx="1"/>
                                                    <circle cx="6" cy="8" r="1.5"/>
                                                    <path d="M9 7h3M9 9.5h2" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input class="drv-input with-prefix"
                                                   @bind="_f.NationalId"
                                                   maxlength="14"
                                                   placeholder="14 رقم"
                                                   dir="ltr" />
                                        </div>
                                    </div>

                                </div>
                            </div>


                            @* ── الحالة ── *@
                            <div class="drv-section-card">
                                <div class="drv-section-head">
                                    <div class="drv-section-icon icon-amber" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="drv-section-title">الحالة الوظيفية</div>
                                        <div class="drv-section-sub">نشط / غير نشط / موقوف</div>
                                    </div>
                                </div>

                                <div class="drv-status-toggle" role="group" aria-label="حالة السائق">
                                    @foreach (var (val, lbl, cls) in new[]
                                    {
                                        ("Active",    "✅ نشط",     "status-green"),
                                        ("Inactive",  "⏸️ غير نشط", "status-gray"),
                                        ("Suspended", "🚫 موقوف",   "status-red")
                                    })
                                    {
                                        var v = val;
                                        <button type="button"
                                                class="drv-status-btn @(_f.Status == v ? cls + " status-active" : "")"
                                                @onclick="() => _f.Status = v"
                                                aria-pressed="@(_f.Status == v)">
                                            @lbl
                                        </button>
                                    }
                                </div>
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ── TAB 2: الرخصة ── *@
                <MudTabPanel>
                    <TabContent>
                        <div class="dtab-label">
                            <div class="dtab-icon dtab-amber" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                                    <path d="M2 10h20"/>
                                    <circle cx="7" cy="15" r="1.5" fill="currentColor"/>
                                </svg>
                            </div>
                            <span>رخصة القيادة</span>
                            @if (ExpiringSoon)
                            {
                                <span class="dtab-warn-dot" aria-label="الرخصة قريبة الانتهاء">⚠️</span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="drv-tab-section">

                            <div class="drv-section-card">
                                <div class="drv-section-head">
                                    <div class="drv-section-icon icon-amber" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="2" y="5" width="20" height="14" rx="2"/>
                                            <path d="M2 10h20"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="drv-section-title">رخصة القيادة</div>
                                        <div class="drv-section-sub">النظام ينبّه قبل الانتهاء بـ 30 يوم</div>
                                    </div>
                                </div>

                                <div class="drv-form-grid">

                                    <div class="drv-field">
                                        <label class="drv-label">رقم الرخصة</label>
                                        <div class="drv-input-group">
                                            <span class="drv-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 16 16" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="1.7">
                                                    <rect x="2" y="2" width="12" height="12" rx="2"/>
                                                    <path d="M5 8h6M5 5h6M5 11h4" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input class="drv-input with-prefix"
                                                   @bind="_f.LicenseNumber"
                                                   maxlength="50"
                                                   placeholder="رقم الرخصة"
                                                   dir="ltr" />
                                        </div>
                                    </div>

                                    <div class="drv-field">
                                        <label class="drv-label">درجة الرخصة</label>
                                        <input class="drv-input"
                                               @bind="_f.LicenseType"
                                               maxlength="20"
                                               placeholder="أولى · ثانية · ثالثة..." />
                                    </div>

                                    <div class="drv-field">
                                        <label class="drv-label">تاريخ انتهاء الرخصة</label>
                                        <div class="drv-input-group">
                                            <span class="drv-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="14" height="14"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                    <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input type="date"
                                                   class="drv-input with-prefix @(ExpiringSoon ? "input-warn" : "")"
                                                   value="@_f.LicenseExpiryDate"
                                                   @onchange="OnExpiryChanged" />
                                        </div>
                                        <div class="drv-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            النظام ينبّه قبل الانتهاء بـ 30 يوم
                                        </div>
                                    </div>

                                </div>

                                @* License Status Visual *@
                                @if (!string.IsNullOrWhiteSpace(_f.LicenseExpiryDate))
{
    var licStatus = GetLicStatusStr(_f.LicenseExpiryDate);
    <div class="drv-lic-status @licStatus.cls">
                                        <div class="lic-status-icon" aria-hidden="true">@licStatus.icon</div>
                                        <div class="lic-status-text">
                                            <strong>@licStatus.title</strong>
                                            <span>@licStatus.detail</span>
                                        </div>
                                    </div>
                                }

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ── TAB 3: الملاحظات ── *@
                <MudTabPanel>
                    <TabContent>
                        <div class="dtab-label">
                            <div class="dtab-icon dtab-purple" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                            </div>
                            <span>الملاحظات</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="drv-tab-section">
                            <div class="drv-section-card">
                                <div class="drv-section-head">
                                    <div class="drv-section-icon icon-purple" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="drv-section-title">ملاحظات</div>
                                        <div class="drv-section-sub">أي تفاصيل إضافية عن السائق</div>
                                    </div>
                                </div>
                                <div class="drv-field">
                                    <textarea class="drv-input drv-textarea"
                                              rows="5"
                                              maxlength="500"
                                              placeholder="أي ملاحظات خاصة بالسائق..."
                                              @onchange="e => _f.Notes = e.Value?.ToString()">@_f.Notes</textarea>
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </MudTabPanel>


            </MudTabs>
        </div>


        @* Bottom Actions *@
        <div class="drv-bottom-actions">
            <button class="drv-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للقائمة
            </button>
            @if (CanSave)
            {
                <div class="drv-bottom-right">
                    @if (_activeTab < 2)
                    {
                        <button class="drv-next-btn" @onclick="() => _activeTab++">
                            التالي
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    }
                    <button class="drv-bottom-save" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ السائق</span>
                        }
                    </button>
                </div>
            }
        </div>

    }
</div>


<style>

    :root {
