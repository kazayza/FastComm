        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .bk-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .bk-hero-left { flex: 1; min-width: 200px; }

    .bk-hero-crumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.55);
