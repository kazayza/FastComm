@code {
    /* ══════════════════════════════════════
       DTO CLASSES (Top-level clean)
    ══════════════════════════════════════ */
    public class Item
    {
        public int     CustomerId    { get; set; }
        public string  CustomerCode  { get; set; } = "";
        public string  CustomerType  { get; set; } = "";
        public string  NameAr        { get; set; } = "";
        public string? Phone         { get; set; }
        public string? TaxNumber     { get; set; }
        public string? CityAr        { get; set; }
        public bool    IsActive      { get; set; }
        public decimal CreditLimit   { get; set; }
        public bool    PortalEnabled { get; set; }
    }

    public class StmtLine
    {
        public DateTime Date        { get; set; }
        public string   Kind        { get; set; } = "";
        public string   Ref         { get; set; } = "";
        public string?  Description { get; set; }
        public decimal  Debit       { get; set; }
        public decimal  Credit      { get; set; }
        public decimal  Balance     { get; set; }
    }

    public class Statement
    {
        public string         CustomerName { get; set; } = "";
        public decimal        Opening      { get; set; }
        public List<StmtLine> Lines        { get; set; } = new();
        public decimal        TotalDebit   { get; set; }
        public decimal        TotalCredit  { get; set; }
        public decimal        Closing      { get; set; }
    }

    public class PortalForm
    {
        public string Purpose       { get; set; } = "Portal";
        public int    ExpiresInDays { get; set; } = 7;
        public int    MaxUses       { get; set; } = 50;
    }

    public class PToken
    {
        public long      PortalTokenId { get; set; }
        public string    Purpose       { get; set; } = "";
        public long?     InvoiceId     { get; set; }
        public DateTime  CreatedAt     { get; set; }
        public DateTime? ExpiresAt     { get; set; }
        public int?      MaxUses       { get; set; }
        public int       UsedCount     { get; set; }
        public DateTime? LastUsedAt    { get; set; }
        public bool      IsActive      { get; set; }
        public DateTime? RevokedAt     { get; set; }
    }

    public class NewToken
    {
        public long      PortalTokenId { get; set; }
        public string    Token         { get; set; } = "";
        public string    Path          { get; set; } = "";
        public DateTime? ExpiresAt     { get; set; }
        public string    FullUrl       { get; set; } = "";
    }

    public class ImportResult
    {
        public int          Success { get; set; }
        public int          Failed  { get; set; }
        public List<string> Errors  { get; set; } = new();
    }

    public class ImportResponse
    {
        public string?       Message { get; set; }
        public ImportResult? Result  { get; set; }
    }

    /* ══════════════════════════════════════
       STATE & FIELDS
    ══════════════════════════════════════ */
    private AuthUser? _user;
    private bool CanView      => _user?.Can("CUSTOMER.VIEW")         ?? false;
    private bool CanCreate    => _user?.Can("CUSTOMER.CREATE")       ?? false;
    private bool CanEdit      => _user?.Can("CUSTOMER.EDIT")         ?? false;
    private bool CanDelete    => _user?.Can("CUSTOMER.DELETE")       ?? false;
    private bool CanStatement => _user?.Can("CUSTOMER.STATEMENT")     ?? false;
    private bool CanPortal    => _user?.Can("CUSTOMER.PORTAL_TOKEN")  ?? false;

    private List<Item> _items     = new();
    private bool       _loading;
    private string?    _loadError;
    private string     _search    = "";
    private string     _filter    = "all";
    private int?       _confirmId;
    private bool       _fabOpen;

    /* ── Statement ── */
    private bool       _stmtOpen;
    private Statement? _stmt;
    private int        _stmtCustomerId;
    private string?    _stmtFrom;
    private string?    _stmtTo;

    /* ── Portal ── */
    private bool         _portalOpen;
    private Item?        _pt;
    private List<PToken> _ptokens = new();
    private PortalForm   _pf      = new();
    private NewToken?    _newToken;
    private bool         _psaving;
    private string?      _pmsg;
    private bool         _pok;

    /* ── Import Excel ── */
    private bool          _importOpen;
    private bool          _importing;
    private IBrowserFile? _importFile;
    private ImportResult? _importResult;

    /* ══════════════════════════════════════
       COMPUTED PROPERTIES
    ══════════════════════════════════════ */
    private IEnumerable<Item> Filtered
    {
        get
        {
            var q = _items.AsEnumerable();
            q = _filter switch
            {
                "co"  => q.Where(c => c.CustomerType == "Company"),
                "ind" => q.Where(c => c.CustomerType == "Individual"),
                _     => q
            };
            return string.IsNullOrWhiteSpace(_search)
                ? q
                : q.Where(c =>
                    NormalizeArabic(c.NameAr).Contains(NormalizeArabic(_search)) ||
                    NormalizeArabic(c.CustomerCode).Contains(NormalizeArabic(_search)) ||
                    NormalizeArabic(c.TaxNumber ?? "").Contains(NormalizeArabic(_search)));
        }
    }

    private static string NormalizeArabic(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        string[] diacritics = new[] { "َ", "ُ", "ِ", "ّ", "ً", "ٌ", "ٍ", "ْ", "ـ" };
        foreach (var d in diacritics) s = s.Replace(d, "");
        return s
            .Replace('أ', 'ا').Replace('إ', 'ا').Replace('آ', 'ا').Replace('ٱ', 'ا').Replace('ء', 'ا')
            .Replace('ة', 'ه').Replace('ى', 'ي').Replace('ؤ', 'و').Replace('ئ', 'ي')
            .Replace("  ", " ").ToLowerInvariant().Trim();
    }

    private static string Money(decimal v) => v.ToString("N2");

    private static string KindAr(string k) => k switch
    {
        "Invoice"    => "فاتورة مبيعات",
        "CreditNote" => "إشعار دائن",
        "Payment"    => "سند قبض",
        _            => k
    };

    private static string PurposeAr(string p) => p switch
    {
        "Portal"      => "البوابة الرقمية كاملة",
        "Statement"   => "كشف الحساب المالي",
        "InvoiceView" => "استعراض فاتورة واحدة",
        _             => p
    };

    private static string TokenChip(PToken t)
    {
        if (!t.IsActive || t.RevokedAt is not null) return "مُبطل";
        if (t.ExpiresAt is not null && t.ExpiresAt < DateTime.UtcNow) return "منتهي";
        if (t.MaxUses is not null && t.UsedCount >= t.MaxUses) return "استُنفد";
        return "نشط";
    }

    /* ══════════════════════════════════════
       METHODS & API CALLS
    ══════════════════════════════════════ */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    private async Task Reload()
    {
        await LoadAsync();
        Snackbar.Add("تم تحديث كشف بيانات العملاء بنجاح", Severity.Success);
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/customers") ?? new(); }
        catch (Exception ex) { _loadError = "فشل التحميل: " + ex.Message; }
        finally { _loading = false; }
    }

    private void GoNew()       => Nav.NavigateTo("/customers/new");
    private void GoEdit(Item c) => Nav.NavigateTo($"/customers/new/{c.CustomerId}");

    private async Task ToggleActive(Item c)
    {
        try
        {
            var res = await Http.PostAsync($"api/customers/{c.CustomerId}/toggle-active", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل الإيقاف/التفعيل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item c)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/customers/{c.CustomerId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("تعذر حذف ملف العميل: " + ex.Message, Severity.Error); }
    }

    private void SetTab(string t) { _filter = t; _confirmId = null; }
    private void ToggleFab() => _fabOpen = !_fabOpen;

    private void ResetFilters()
    {
        _search = "";
        _filter = "all";
        _confirmId = null;
        StateHasChanged();
    }

    /* ── Statement ── */
    private void OpenStatement(Item c)
    {
        _stmtCustomerId = c.CustomerId;
        _stmtFrom = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("yyyy-MM-dd");
        _stmtTo   = null;
        _stmtOpen = true;
        _ = LoadStatement();
    }

    private void CloseStatement() { _stmtOpen = false; _stmt = null; }

    private async Task LoadStatement()
    {
        try
        {
            var url = $"api/treasury/customer-statement?customerId={_stmtCustomerId}";
            if (!string.IsNullOrWhiteSpace(_stmtFrom)) url += "&from=" + Uri.EscapeDataString(_stmtFrom);
            if (!string.IsNullOrWhiteSpace(_stmtTo))   url += "&to="   + Uri.EscapeDataString(_stmtTo);
            _stmt = await Http.GetFromJsonAsync<Statement>(url);
        }
        catch (Exception ex) { Snackbar.Add("فشل تحميل الكشف: " + ex.Message, Severity.Error); }
    }

    /* ── Portal ── */
    private async Task OpenPortal(Item c)
    {
        _pt = c; _pf = new PortalForm();
        _newToken = null; _pmsg = null; _portalOpen = true;
        await LoadTokensAsync();
    }

    private void ClosePortal() { _portalOpen = false; _pt = null; _newToken = null; }

    private async Task LoadTokensAsync()
    {
        if (_pt is null) return;
        try
        {
            _ptokens = await Http.GetFromJsonAsync<List<PToken>>(
                $"api/portal/tokens?customerId={_pt.CustomerId}") ?? new();
        }
        catch (Exception ex) { Snackbar.Add("فشل تحميل الروابط: " + ex.Message, Severity.Error); }
    }

    private async Task CreateToken()
    {
        if (_pt is null) return;
        _psaving = true; _pmsg = null; _newToken = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/portal/tokens", new
            {
                customerId    = _pt.CustomerId,
                purpose       = _pf.Purpose,
                invoiceId     = (long?)null,
                expiresInDays = _pf.ExpiresInDays,
                maxUses       = _pf.MaxUses
            });
            if (res.IsSuccessStatusCode)
            {
                var t = await res.Content.ReadFromJsonAsync<NewToken>();
                if (t is not null) { t.FullUrl = Nav.BaseUri.TrimEnd('/') + t.Path; _newToken = t; }
                _pok = true; _pmsg = "تم توليد رابط الوصول بنجاح";
                await LoadTokensAsync();
            }
            else { _pok = false; _pmsg = await MsgOf(res); }
        }
        catch (Exception ex) { _pok = false; _pmsg = "تعذر التوليد: " + ex.Message; }
        finally { _psaving = false; }
    }

    private async Task CopyLink(string url)
    {
        try
        {
            await JS.InvokeAsync<bool>("fastcom.copyText", url);
            Snackbar.Add("تم نسخ رابط الولوج للحافظة بنجاح", Severity.Success);
        }
        catch { Snackbar.Add("يرجى نسخ الرابط يدوياً", Severity.Warning); }
    }

    private async Task Revoke(PToken t)
    {
        try
        {
            var res = await Http.PostAsync($"api/portal/tokens/{t.PortalTokenId}/revoke", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { _newToken = null; await LoadTokensAsync(); }
        }
        catch (Exception ex) { Snackbar.Add("تعذر إبطال الرابط: " + ex.Message, Severity.Error); }
    }

    /* ── Import Excel ── */
    private async Task DownloadTemplate()
    {
        try
        {
            var res = await Http.GetAsync("api/customers/import-template");
            if (!res.IsSuccessStatusCode)
            {
                Snackbar.Add("فشل تحميل القالب ماليًا: " + (int)res.StatusCode, Severity.Error);
                return;
            }

            var bytes = await res.Content.ReadAsByteArrayAsync();
            if (bytes is null || bytes.Length == 0) throw new Exception("السيرفر لم يرجع ملف قالب صحيح");

            await JS.InvokeAsync<bool>("fastcom.downloadBase64", Convert.ToBase64String(bytes),
                "customers-template.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add("تم تحميل قالب الاستيراد بنجاح", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add("تعذر التحميل: " + ex.Message, Severity.Error); }
    }

    private void OpenImport()
    {
        _importOpen = true;
        _importFile = null;
        _importResult = null;
    }

    private void CloseImport()
    {
        _importOpen = false;
        _importFile = null;
        _importResult = null;
    }

    private void OnImportFileSelected(InputFileChangeEventArgs e)
    {
        _importFile = e.File;
        _importResult = null;
    }

    private async Task DoImport()
    {
        if (_importFile is null) return;
        _importing = true;
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(_importFile.OpenReadStream(10 * 1024 * 1024));
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_importFile.ContentType);
            content.Add(sc, "file", _importFile.Name);

            var token = await Auth.GetTokenAsync();
            using var req = new HttpRequestMessage(HttpMethod.Post, "api/customers/import")
            {
                Content = content
            };
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var res = await Http.SendAsync(req);
            var msg = await MsgOf(res);

            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<ImportResponse>();
                _importResult = result?.Result;
                Snackbar.Add(msg, Severity.Success);
                await LoadAsync();
            }
            else Snackbar.Add(msg, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل الاستيراد: " + ex.Message, Severity.Error); }
        finally { _importing = false; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var body = await res.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return res.IsSuccessStatusCode ? "تم بنجاح" : "خطأ مالي غير معروف";
            var doc = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(body);
            if (doc.TryGetProperty("message", out var m)) return m.GetString() ?? body;
            return body;
        }
        catch { return res.IsSuccessStatusCode ? "تمت العملية بنجاح" : $"خطأ مالي استجابة السيرفر {(int)res.StatusCode}"; }
    }
}