@page "/vehicles"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>أسطول المركبات والمقطورات — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="flt-hero-row">
                <div class="flt-hero-left">
                    <div class="flt-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="1" y="3" width="15" height="13" rx="2"/>
                            <path d="M16 8h4l3 3v5h-7V8z"/>
                            <circle cx="5.5" cy="18.5" r="2.5"/>
                            <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                        <span>البيانات الأساسية · الأسطول التشغيلي</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">أسطول المركبات والمقطورات</h1>
                    <span class="flt-hero-sub">إدارة كاملة لأسطول العربيات والمقطورات — متابعة التراخيص، التأمينات، والحالة التشغيلية الحية</span>
                </div>

                <div class="flt-hero-right">
                    <button type="button" class="flt-hero-refresh" @onclick="Reload" title="تحديث البيانات">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 4v6h-6"/>
                            <path d="M1 20v-6h6"/>
                            <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                        </svg>
                    </button>
                    @if (CanCreate)
                    {
                        <button type="button" class="flt-hero-add" @onclick='() => { if (_tab == "v") NewVehicle(); else NewTrailer(); }'>
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            @(_tab == "v" ? "إضافة مركبة" : "إضافة مقطورة")
                        </button>
                    }
                    <span class="flt-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

            @* ── KPI Cards (Rounded Glass Grid & Click Filter) ── *@
            @if (CanView && !_loading)
            {
                <div class="flt-kpis-strip">

                    <div class="flt-kpi-item @(_kpiFilter == "" ? "kpi-active" : "")" @onclick='() => SetKpiFilter("")' role="button" tabindex="0" title="عرض إجمالي المركبات">
                        <div class="flt-kpi-icon kpi-blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="3" width="15" height="13" rx="2"/>
                                <path d="M16 8h4l3 3v5h-7V8z"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">إجمالي المركبات</div>
                            <div class="flt-kpi-val">@_vehicles.Count</div>
                        </div>
                    </div>

                    <div class="flt-kpi-div" aria-hidden="true"></div>

                    <div class="flt-kpi-item @(_kpiFilter == "Available" ? "kpi-active" : "")" @onclick='() => SetKpiFilter("Available")' role="button" tabindex="0" title="تصفية المركبات المتاحة للتشغيل">
                        <div class="flt-kpi-icon kpi-green">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">متاحة للتشغيل</div>
                            <div class="flt-kpi-val val-green">@_vehicles.Count(v => v.Status == "Available")</div>
                        </div>
                    </div>

                    <div class="flt-kpi-div" aria-hidden="true"></div>

                    <div class="flt-kpi-item">
                        <div class="flt-kpi-icon kpi-amber">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                                <line x1="4" y1="22" x2="4" y2="15"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">إجمالي المقطورات</div>
                            <div class="flt-kpi-val val-amber">@_trailers.Count</div>
                        </div>
                    </div>

                    <div class="flt-kpi-div" aria-hidden="true"></div>

                    <div class="flt-kpi-item @(_kpiFilter == "Maintenance" ? "kpi-active" : "")" @onclick='() => SetKpiFilter("Maintenance")' role="button" tabindex="0" title="تصفية المركبات في الصيانة">
                        <div class="flt-kpi-icon kpi-red">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">تحت الصيانة</div>
                            <div class="flt-kpi-val val-red">@_vehicles.Count(v => v.Status == "Maintenance")</div>
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="flt-body">

    @if (!CanView)
    {
        <div class="flt-state-box">
            <div class="flt-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليست لديك الصلاحية الأمنية الكافية لعرض بيانات أسطول المركبات والمقطورات.</p>
        </div>
    }
    else
    {
        <div class="flt-card">

            @* ── Toolbar ── *@
            <div class="flt-toolbar">

                <div class="flt-search-wrap">
                    <svg class="flt-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="flt-search-input"
                           placeholder="بحث برقم اللوحة أو الكود التعريفي..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="البحث في الأسطول" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button type="button" class="flt-search-clear" @onclick="() => _search = string.Empty" title="مسح البحث">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="flt-results-badge">
                    <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="8" cy="8" r="6"/>
                        <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                    </svg>
                    @if (_tab == "v")
                    {
                        <span>عرض <strong>@VehiclesFiltered.Count()</strong> من <strong>@_vehicles.Count</strong> مركبة</span>
                    }
                    else
                    {
                        <span>عرض <strong>@TrailersFiltered.Count()</strong> من <strong>@_trailers.Count</strong> مقطورة</span>
                    }
                </div>

            </div>


            @* ── Type Tabs ── *@
            <div class="flt-tab-bar">
                <div class="flt-tabs" role="group">
                    <button type="button" class='flt-tab @(_tab == "v" ? "active" : "")' @onclick='() => { _tab = "v"; _confirmV = null; _confirmT = null; }'>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="1" y="3" width="15" height="13" rx="2"/>
                            <path d="M16 8h4l3 3v5h-7V8z"/>
                            <circle cx="5.5" cy="18.5" r="2.5"/>
                            <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                        المركبات
                        <span class="flt-tab-count">@_vehicles.Count</span>
                    </button>
                    <button type="button" class='flt-tab @(_tab == "t" ? "active" : "")' @onclick='() => { _tab = "t"; _confirmV = null; _confirmT = null; }'>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                            <line x1="4" y1="22" x2="4" y2="15"/>
                        </svg>
                        المقطورات
                        <span class="flt-tab-count">@_trailers.Count</span>
                    </button>
                </div>
            </div>


            @* ── Content Table ── *@
            @if (_loading)
            {
                <div class="flt-loading">
                    <div class="flt-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل بيانات الأسطول التشغيلي...</span>
                </div>
            }
            else if (_tab == "v")
            {
                @if (!VehiclesFiltered.Any())
                {
                    <div class="flt-empty">
                        <div class="flt-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                                <rect x="1" y="3" width="15" height="13" rx="2"/>
                                <path d="M16 8h4l3 3v5h-7V8z"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                        </div>
                        <div class="flt-empty-title">لا توجد مركبات مسجلة</div>
                        <div class="flt-empty-sub">ابدأ بتسجيل أول مركبة في الأسطول التشغيلي</div>
                    </div>
                }
                else
                {
                    <div class="flt-table-wrap">
                        <table class="flt-table" aria-label="قائمة المركبات">
                            <thead>
                                <tr>
                                    <th class="th-start">بيانات المركبة</th>
                                    <th>النوع والماركة</th>
                                    <th>الملكية</th>
                                    <th>الحمولة</th>
                                    <th>الرخصة والتأمين</th>
                                    <th>الحالة</th>
                                    @if (CanEdit) { <th style="width:110px">إجراءات</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in VehiclesFiltered)
                                {
                                    <tr>
                                        <td class="td-start">
                                            <div class="flt-item-cell">
                                                <div class="flt-avatar @VehicleAvatarClass(v.Status)" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                                                        <path d="M16 8h4l3 3v5h-7V8z"/>
                                                        <circle cx="5.5" cy="18.5" r="2.5"/>
                                                        <circle cx="18.5" cy="18.5" r="2.5"/>
                                                    </svg>
                                                </div>
                                                <div class="flt-item-info">
                                                    <div class="flt-code-plate">
                                                        <span class="flt-code-chip">@v.VehicleCode</span>
                                                    </div>
                                                    <div class="flt-plate-num">@v.PlateNumber</div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="flt-type-cell">
                                                <span class="flt-type-tag">@v.VehicleType</span>
                                                @if (!string.IsNullOrWhiteSpace(v.Brand))
                                                {
                                                    <div class="flt-brand-sub">@v.Brand</div>
                                                }
                                            </div>
                                        </td>

                                        <td>
                                            <span class="flt-ownership-badge @(v.OwnershipType == "Company" ? "ownership-company" : "ownership-external")"
                                                  title="@(v.OwnershipType == "External" ? v.SupplierName : "ملكية المكتب")">
                                                @if (v.OwnershipType == "Company")
                                                {
                                                    <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                                    </svg>
                                                    <span>مكتب</span>
                                                }
                                                else
                                                {
                                                    <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                                        <circle cx="12" cy="7" r="4"/>
                                                    </svg>
                                                    <span>مورد</span>
                                                }
                                            </span>
                                        </td>

                                        <td class="td-muted">
                                            @(v.CapacityTon.HasValue ? $"{v.CapacityTon:0.##} طن" : "—")
                                        </td>

                                        <td>
                                            <div class="flt-doc-cell">
                                                @if (v.LicenseExpiryDate.HasValue)
                                                {
                                                    var days = (v.LicenseExpiryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).TotalDays;
                                                    <span class="flt-doc-badge @(days < 0 ? "doc-expired" : days < 30 ? "doc-warning" : "doc-valid")">
                                                        رخصة: @v.LicenseExpiryDate.Value.ToString("yyyy-MM-dd")
                                                    </span>
                                                }
                                                @if (v.InsuranceExpiryDate.HasValue)
                                                {
                                                    var days = (v.InsuranceExpiryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).TotalDays;
                                                    <span class="flt-doc-badge @(days < 0 ? "doc-expired" : days < 30 ? "doc-warning" : "doc-valid")">
                                                        تأمين: @v.InsuranceExpiryDate.Value.ToString("yyyy-MM-dd")
                                                    </span>
                                                }
                                                @if (!v.LicenseExpiryDate.HasValue && !v.InsuranceExpiryDate.HasValue)
                                                {
                                                    <span class="td-muted">لم يتم تسجيل بيانات</span>
                                                }
                                            </div>
                                        </td>

                                        <td>
                                            <span class="flt-status-chip @StatusChipClass(v.Status)">
                                                <span class="flt-status-dot @StatusDotClass(v.Status)" aria-hidden="true"></span>
                                                @StatusAr(v.Status)
                                            </span>
                                        </td>

                                        @if (CanEdit)
                                        {
                                            <td>
                                                <div class="flt-actions">
                                                    <button type="button" class="flt-act-btn act-edit" @onclick="() => EditVehicle(v)" title="تعديل بيانات المركبة">
                                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                        </svg>
                                                    </button>
                                                    @if (CanDelete)
                                                    {
                                                        @if (_confirmV == v.VehicleId)
                                                        {
                                                            <button type="button" class="flt-confirm-del" @onclick="() => DeleteVehicle(v)">تأكيد الحذف؟</button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="flt-act-btn act-del" @onclick="() => _confirmV = v.VehicleId" title="حذف المركبة">
                                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                                </svg>
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                @if (!TrailersFiltered.Any())
                {
                    <div class="flt-empty">
                        <div class="flt-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                                <line x1="4" y1="22" x2="4" y2="15"/>
                            </svg>
                        </div>
                        <div class="flt-empty-title">لا توجد مقطورات مسجلة</div>
                        <div class="flt-empty-sub">ابدأ بتسجيل أول مقطورة في الأسطول التشغيلي</div>
                    </div>
                }
                else
                {
                    <div class="flt-table-wrap">
                        <table class="flt-table" aria-label="قائمة المقطورات">
                            <thead>
                                <tr>
                                    <th class="th-start">بيانات المقطورة</th>
                                    <th>النوع والمقاس</th>
                                    <th>الرخصة والتأمين</th>
                                    <th>الحالة</th>
                                    @if (CanEdit) { <th style="width:110px">إجراءات</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in TrailersFiltered)
                                {
                                    <tr>
                                        <td class="td-start">
                                            <div class="flt-item-cell">
                                                <div class="flt-avatar @VehicleAvatarClass(t.Status)" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                                                        <line x1="4" y1="22" x2="4" y2="15"/>
                                                    </svg>
                                                </div>
                                                <div class="flt-item-info">
                                                    <div class="flt-code-plate">
                                                        <span class="flt-code-chip">@t.TrailerCode</span>
                                                    </div>
                                                    <div class="flt-plate-num">@(t.PlateNumber ?? "بدون لوحة")</div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="flt-type-cell">
                                                <span class="flt-type-tag">@t.TrailerType</span>
                                                @if (t.SizeFeet.HasValue)
                                                {
                                                    <div class="flt-brand-sub">@t.SizeFeet قدم</div>
                                                }
                                            </div>
                                        </td>

                                        <td>
                                            <div class="flt-doc-cell">
                                                <span class="td-muted">راجع تفاصيل المقطورة</span>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="flt-status-chip @StatusChipClass(t.Status)">
                                                <span class="flt-status-dot @StatusDotClass(t.Status)" aria-hidden="true"></span>
                                                @StatusAr(t.Status)
                                            </span>
                                        </td>

                                        @if (CanEdit)
                                        {
                                            <td>
                                                <div class="flt-actions">
                                                    <button type="button" class="flt-act-btn act-edit" @onclick="() => EditTrailer(t)" title="تعديل بيانات المقطورة">
                                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                        </svg>
                                                    </button>
                                                    @if (CanDelete)
                                                    {
                                                        @if (_confirmT == t.TrailerId)
                                                        {
                                                            <button type="button" class="flt-confirm-del" @onclick="() => DeleteTrailer(t)">تأكيد الحذف؟</button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="flt-act-btn act-del" @onclick="() => _confirmT = t.TrailerId" title="حذف المقطورة">
                                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                                </svg>
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   MODAL — مركبة (svc-modal Standard)
═══════════════════════════════════════════ *@
@if (_vOpen && CanCreate)
{
    <div class="svc-modal-backdrop" @onclick="CloseAll" role="dialog" aria-modal="true">
        <div class="svc-modal" @onclick:stopPropagation="true">

            <div class="svc-modal-head">
                <div class="svc-head-icon @(_vId is null ? "svc-icon-create" : "svc-icon-edit")" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                        <path d="M16 8h4l3 3v5h-7V8z"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                        <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">@(_vId is null ? "تسجيل مركبة جديدة بالأسطول" : "تعديل بيانات المركبة")</div>
                    <div class="svc-head-sub">
                        @if (_vId is null)
                        {
                            <span>يتم توليد الكود التعريفي تلقائياً بالبادئة (VEH-)</span>
                        }
                        else
                        {
                            <span>تحديث البيانات الفنية والتشغيلية والملفات الرسمية للمركبة</span>
                        }
                    </div>
                </div>
                <button class="svc-head-close" @onclick="CloseAll" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="svc-banner @(_ok ? "svc-banner-ok" : "svc-banner-err")" role="alert">
                    <span class="svc-banner-msg">@_msg</span>
                    <button class="svc-banner-x" @onclick="() => _msg = null" type="button">✕</button>
                </div>
            }

            <div class="svc-modal-body">
                <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                         PanelClass="svc-tab-panel" @bind-ActivePanelIndex="_vActiveTab" Class="svc-mud-tabs">

                    @* TAB 1 - البيانات الأساسية *@
                    <MudTabPanel>
                        <TabContent>
                            <div class="svc-tab-label">
                                <div class="svc-tab-ic svc-tab-ic-blue">
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                                        <path d="M16 8h4l3 3v5h-7V8z"/>
                                        <circle cx="5.5" cy="18.5" r="2.5"/>
                                    </svg>
                                </div>
                                <span>البيانات الأساسية</span>
                            </div>
                        </TabContent>
                        <ChildContent>
                            <div class="svc-section">
                                <div class="svc-section-head">
                                    <div class="svc-section-ic blue">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                            <path d="M14 2v6h6"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="svc-section-title">بيانات المركبة التعريفية والفنية</div>
                                        <div class="svc-section-sub">اللوحة، النوع، الماركة، الموديل، والحمولة الفنية</div>
                                    </div>
                                </div>

                                <div class="svc-grid">
                                    <div class="svc-field">
                                        <label class="svc-label">رقم اللوحة <span class="svc-req">*</span></label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="6" width="20" height="12" rx="2"/>
                                                    <line x1="8" y1="10" x2="16" y2="10"/>
                                                    <line x1="8" y1="14" x2="14" y2="14"/>
                                                </svg>
                                            </span>
                                            <input class="svc-input with-prefix" @bind="_vf.PlateNumber" placeholder="ب ب ك - 1234" maxlength="20" />
                                        </div>
                                    </div>

                                    <div class="svc-field">
                                        <label class="svc-label">نوع المركبة <span class="svc-req">*</span></label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                                </svg>
                                            </span>
                                            <input class="svc-input with-prefix" @bind="_vf.VehicleType" placeholder="جرار، نقل ثقيل، سطحة..." maxlength="50" />
                                        </div>
                                    </div>

                                    <div class="svc-field">
                                        <label class="svc-label">الماركة (اختياري)</label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M12 6l4 6-4 6-4-6z"/>
                                                </svg>
                                            </span>
                                            <input class="svc-input with-prefix" @bind="_vf.Brand" placeholder="مرسيدس، سكانيا، فولفو..." maxlength="50" />
                                        </div>
                                    </div>

                                    <div class="svc-field">
                                        <label class="svc-label">الموديل والفئة</label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                </svg>
                                            </span>
                                            <input class="svc-input with-prefix" @bind="_vf.Model" placeholder="Actros 2545..." maxlength="50" />
                                        </div>
                                    </div>

                                    <div class="svc-field">
                                        <label class="svc-label">الحمولة القصوى (طن)</label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix txt">طن</span>
                                            <input type="number" step="0.1" min="0" class="svc-input ltr with-prefix"
                                                   value="@_vf.CapacityTon" placeholder="25"
                                                   @onchange="e => _vf.CapacityTon = ParseNullDec(e.Value)" />
                                        </div>
                                    </div>

                                    <div class="svc-field">
                                        <label class="svc-label">عدد الحاويات (20 قدم)</label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                                </svg>
                                            </span>
                                            <input type="number" min="1" max="10" class="svc-input ltr with-prefix"
                                                   value="@_vf.ContainerSlots20"
                                                   @onchange="e => _vf.ContainerSlots20 = ParseByte(e.Value, 1)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </ChildContent>
                    </MudTabPanel>

                    @* TAB 2 - الملكية والحالة *@
                    <MudTabPanel>
                        <TabContent>
                            <div class="svc-tab-label">
                                <div class="svc-tab-ic svc-tab-ic-green">
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                    </svg>
                                </div>
                                <span>الملكية والحالة</span>
                            </div>
                        </TabContent>
                        <ChildContent>
                            <div class="svc-section">
                                <div class="svc-section-head">
                                    <div class="svc-section-ic green">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="svc-section-title">ملكية المركبة وحالتها التشغيلية</div>
                                        <div class="svc-section-sub">تحديد نوع الملكية (شركة أو مورد خارجي) والوضع الحالي</div>
                                    </div>
                                </div>

                                <div class="svc-grid">
                                    <div class="svc-field">
                                        <label class="svc-label">نوع الملكية <span class="svc-req">*</span></label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                                </svg>
                                            </span>
                                            <select class="svc-input svc-select with-prefix" @bind="_vf.OwnershipType">
                                                <option value="Company">مكتب (ملكية داخلية)</option>
                                                <option value="External">مورد (خارجي)</option>
                                            </select>
                                        </div>
                                    </div>

                                    @if (_vf.OwnershipType == "External")
                                    {
                                        <div class="svc-field">
                                            <label class="svc-label">المورد المالك <span class="svc-req">*</span></label>
                                            <div class="svc-input-wrap">
                                                <span class="svc-prefix">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="11" cy="11" r="8"/>
                                                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                                    </svg>
                                                </span>
                                                <input class="svc-input with-prefix"
                                                       value="@_supplierSearch"
                                                       placeholder="ابحث باسم المورد..."
                                                       @oninput="OnSupplierSearch"
                                                       @onkeydown="OnSupplierInputKeyDown"
                                                       @onfocus="OnSupplierInputFocus"
                                                       @onblur="OnSupplierInputBlur"
                                                       autocomplete="off" />
                                                @if (!string.IsNullOrEmpty(_supplierSearch))
                                                {
                                                    <button type="button" class="field-clear-btn" @onclick="ClearSupplierSelection">✕</button>
                                                }
                                            </div>
                                            @if (_showSupplierDropdown && _filteredSuppliers.Count > 0)
                                            {
                                                <div class="field-dropdown">
                                                    @for (int i = 0; i < _filteredSuppliers.Count; i++)
                                                    {
                                                        var s = _filteredSuppliers[i];
                                                        <div class="field-dropdown-item @(i == _focusedSupplierIndex ? "is-focused" : "")"
                                                             @onmousedown="() => PickSupplier(s)">
                                                            <span>@s.Label</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div class="svc-field @(_vf.OwnershipType == "Company" ? "svc-full" : "")">
                                        <label class="svc-label">الحالة التشغيلية</label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M12 6v6l4 2" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <select class="svc-input svc-select with-prefix" @bind="_vf.Status">
                                                <option value="Available">✅ متاحة للتشغيل</option>
                                                <option value="InTrip">🚛 في رحلة نشطة</option>
                                                <option value="Maintenance">🔧 قيد الصيانة</option>
                                                <option value="OutOfService">🚫 خارج الخدمة</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </ChildContent>
                    </MudTabPanel>

                    @* TAB 3 - الوثائق والرخص *@
                    <MudTabPanel>
                        <TabContent>
                            <div class="svc-tab-label">
                                <div class="svc-tab-ic svc-tab-ic-amber">
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                        <path d="M14 2v6h6"/>
                                    </svg>
                                </div>
                                <span>الوثائق والرخص</span>
                            </div>
                        </TabContent>
                        <ChildContent>
                            <div class="svc-section">
                                <div class="svc-section-head">
                                    <div class="svc-section-ic amber">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                            <path d="M14 2v6h6M9 13h6M9 17h6"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="svc-section-title">تواريخ الرخصة والتأمين</div>
                                        <div class="svc-section-sub">تنبيهات ذكية عند اقتراب انتهاء الوثائق الرسمية</div>
                                    </div>
                                </div>

                                <div class="svc-grid">
                                    <div class="svc-field">
                                        <label class="svc-label">تاريخ انتهاء الرخصة الرسمية</label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                    <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input type="date" class="svc-input with-prefix"
                                                   value="@_vf.LicenseExpiryDate"
                                                   @onchange="e => _vf.LicenseExpiryDate = e.Value?.ToString()" />
                                        </div>
                                    </div>

                                    <div class="svc-field">
                                        <label class="svc-label">تاريخ انتهاء التأمين البنكي</label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                                </svg>
                                            </span>
                                            <input type="date" class="svc-input with-prefix"
                                                   value="@_vf.InsuranceExpiryDate"
                                                   @onchange="e => _vf.InsuranceExpiryDate = e.Value?.ToString()" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </ChildContent>
                    </MudTabPanel>

                </MudTabs>
            </div>

            <div class="svc-modal-foot">
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="CloseAll" type="button">تراجع</button>
                    <button class="svc-btn-save" @onclick="SaveVehicleAsync" disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>@(_vId is null ? "تسجيل المركبة" : "حفظ التعديلات")</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — مقطورة (svc-modal Standard)
═══════════════════════════════════════════ *@
@if (_tOpen && CanCreate)
{
    <div class="svc-modal-backdrop" @onclick="CloseAll" role="dialog" aria-modal="true">
        <div class="svc-modal" @onclick:stopPropagation="true">

            <div class="svc-modal-head">
                <div class="svc-head-icon @(_tId is null ? "svc-icon-create" : "svc-icon-edit")" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                        <line x1="4" y1="22" x2="4" y2="15"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">@(_tId is null ? "تسجيل مقطورة جديدة بالأسطول" : "تعديل بيانات المقطورة")</div>
                    <div class="svc-head-sub">
                        @if (_tId is null)
                        {
                            <span>يتم توليد الكود التعريفي تلقائياً بالبادئة (TRL-)</span>
                        }
                        else
                        {
                            <span>تحديث البيانات التشغيلية والوثائق الرسمية للمقطورة</span>
                        }
                    </div>
                </div>
                <button class="svc-head-close" @onclick="CloseAll" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="svc-banner @(_ok ? "svc-banner-ok" : "svc-banner-err")" role="alert">
                    <span class="svc-banner-msg">@_msg</span>
                    <button class="svc-banner-x" @onclick="() => _msg = null" type="button">✕</button>
                </div>
            }

            <div class="svc-modal-body">
                <div class="svc-section">
                    <div class="svc-section-head">
                        <div class="svc-section-ic amber">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                                <line x1="4" y1="22" x2="4" y2="15"/>
                            </svg>
                        </div>
                        <div>
                            <div class="svc-section-title">البيانات التعريفية والفنية للمقطورة</div>
                            <div class="svc-section-sub">اللوحة، النوع، المقاس، الملكية والوثائق الرسمية</div>
                        </div>
                    </div>

                    <div class="svc-grid">
                        <div class="svc-field">
                            <label class="svc-label">رقم اللوحة</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="6" width="20" height="12" rx="2"/>
                                    </svg>
                                </span>
                                <input class="svc-input with-prefix" @bind="_tf.PlateNumber" placeholder="بدون رقم لوحة أحياناً..." maxlength="20" />
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label">نوع المقطورة <span class="svc-req">*</span></label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                    </svg>
                                </span>
                                <input class="svc-input with-prefix" @bind="_tf.TrailerType" placeholder="حاويات، سطحة، صهريج..." maxlength="50" />
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label">المقاس (قدم)</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix txt">قدم</span>
                                <select class="svc-input svc-select with-prefix"
                                        value="@_tf.SizeFeet"
                                        @onchange="e => _tf.SizeFeet = ParseNullByte(e.Value)">
                                    <option value="">— اختر المقاس —</option>
                                    <option value="20">20</option>
                                    <option value="40">40</option>
                                    <option value="45">45</option>
                                    <option value="53">53</option>
                                </select>
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label">نوع الملكية <span class="svc-req">*</span></label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                    </svg>
                                </span>
                                <select class="svc-input svc-select with-prefix" @bind="_tf.OwnershipType">
                                    <option value="Company">🏢 شركة (ملكية داخلية)</option>
                                    <option value="External">🚚 خارجي (مورد نقل)</option>
                                </select>
                            </div>
                        </div>

                        @if (_tf.OwnershipType == "External")
                        {
                            <div class="svc-field svc-full">
                                <label class="svc-label">المورد المالك</label>
                                <div class="svc-input-wrap">
                                    <span class="svc-prefix">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="11" cy="11" r="8"/>
                                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <input class="svc-input with-prefix"
                                           value="@_supplierSearch"
                                           placeholder="ابحث باسم المورد..."
                                           @oninput="OnSupplierSearch"
                                           @onkeydown="OnSupplierInputKeyDown"
                                           @onfocus="OnSupplierInputFocus"
                                           @onblur="OnSupplierInputBlur"
                                           autocomplete="off" />
                                    @if (!string.IsNullOrEmpty(_supplierSearch))
                                    {
                                        <button type="button" class="field-clear-btn" @onclick="ClearSupplierSelectionTrailer">✕</button>
                                    }
                                </div>
                                @if (_showSupplierDropdown && _filteredSuppliers.Count > 0)
                                {
                                    <div class="field-dropdown">
                                        @for (int i = 0; i < _filteredSuppliers.Count; i++)
                                        {
                                            var s = _filteredSuppliers[i];
                                            <div class="field-dropdown-item @(i == _focusedSupplierIndex ? "is-focused" : "")"
                                                 @onmousedown="() => PickSupplierTrailer(s)">
                                                <span>@s.Label</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="svc-field">
                            <label class="svc-label">تاريخ انتهاء الرخصة</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="5" width="18" height="16" rx="2"/>
                                        <path d="M7 3V7M17 3V7M3 10H21"/>
                                    </svg>
                                </span>
                                <input type="date" class="svc-input with-prefix"
                                       value="@_tf.LicenseExpiryDate"
                                       @onchange="e => _tf.LicenseExpiryDate = e.Value?.ToString()" />
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label">تاريخ انتهاء التأمين</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                </span>
                                <input type="date" class="svc-input with-prefix"
                                       value="@_tf.InsuranceExpiryDate"
                                       @onchange="e => _tf.InsuranceExpiryDate = e.Value?.ToString()" />
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label">الحالة التشغيلية</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 6v6l4 2"/>
                                    </svg>
                                </span>
                                <select class="svc-input svc-select with-prefix" @bind="_tf.Status">
                                    <option value="Available">✅ متاحة للتشغيل</option>
                                    <option value="InTrip">🚛 في رحلة نشطة</option>
                                    <option value="Maintenance">🔧 قيد الصيانة</option>
                                    <option value="OutOfService">🚫 خارج الخدمة</option>
                                </select>
                            </div>
                        </div>

                        <div class="svc-field svc-full">
                            <label class="svc-label">الملاحظات والبيان الفني</label>
                            <textarea class="svc-input" style="height: 70px; padding: 8px 12px; resize: none;"
                                      @bind="_tf.Notes"
                                      placeholder="أي ملاحظات فنية إضافية عن المقطورة..." maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="svc-modal-foot">
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="CloseAll" type="button">تراجع</button>
                    <button class="svc-btn-save" @onclick="SaveTrailerAsync" disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>@(_tId is null ? "تسجيل المقطورة" : "حفظ التعديلات")</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}


@* ── GLOW FAB (موضع ثابت في أسفل اليسار) ── *@
@if (CanCreate)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="NewVehicle">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                        <path d="M16 8h4l3 3v5h-7V8z"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                    </svg>
                </span>
                <span>تسجيل مركبة جديدة</span>
            </button>
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="NewTrailer">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                        <line x1="4" y1="22" x2="4" y2="15"/>
                    </svg>
                </span>
                <span>تسجيل مقطورة جديدة</span>
            </button>
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="Reload">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M23 4v6h-6"/>
                        <path d="M1 20v-6h6"/>
                        <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                    </svg>
                </span>
                <span>تحديث البيانات</span>
            </button>
        </div>

        <div class="glow-fab-container">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="glow-fab-btn" @onclick="ToggleFab" aria-label="لوحة التحكم">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

    </div>
}

@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
}


@* ═══════════════════════════════════════════
   CSS STYLES
═══════════════════════════════════════════ *@
<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ── Hero ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px; margin: 0 auto; width: 100%;
        box-sizing: border-box; position: relative; z-index: 1;
    }
    .hero-wrapper .fc-hero {
        border-radius: 20px !important; overflow: hidden;
        box-shadow: 0 12px 32px rgba(13,38,84,.15), 0 4px 12px rgba(13,38,84,.08);
        border: 1px solid rgba(255,255,255,.08);
    }
    .hero-wrapper .fc-hero.fc-hero-slim { padding-top: 18px !important; padding-bottom: 22px !important; }

    .flt-hero-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 6px; }
    .flt-hero-left { flex: 1; min-width: 200px; }
    .flt-hero-crumb { display: flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.55); margin-bottom: 2px; }
    .flt-hero-sub { font-size: 13px; color: rgba(255,255,255,.55); font-weight: 600; }
    .flt-hero-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .flt-hero-chip { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: 8px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: rgba(255,255,255,.7); font-size: 10.5px; font-weight: 700; white-space: nowrap; }

    .flt-hero-refresh {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.08);
        color: rgba(255,255,255,.75); cursor: pointer; transition: background .15s;
    }
    .flt-hero-refresh:hover { background: rgba(255,255,255,.14); }

    .flt-hero-add {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; border-radius: 9px;
        border: none; background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .flt-hero-add:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }

    /* ── KPIs Glass Strip ── */
    .flt-kpis-strip {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px); margin-top: 14px;
    }
    .flt-kpi-item {
        flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px 16px;
        cursor: pointer; transition: background .15s ease;
    }
    .flt-kpi-item:hover { background: rgba(255,255,255,.06); }
    .flt-kpi-item.kpi-active { background: rgba(30,110,245,.28); }
    .flt-kpi-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }
    .flt-kpi-icon {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
    }
    .kpi-blue  { background: rgba(30,110,245,.2); color: #93c5fd; }
    .kpi-amber { background: rgba(234,179,8,.2);  color: #fde68a; }
    .kpi-red   { background: rgba(239,68,68,.2);  color: #fca5a5; }
    .kpi-green { background: rgba(34,197,94,.2);  color: #86efac; }

    .flt-kpi-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .flt-kpi-val { font-size: 15px; font-weight: 900; color: #fff; margin-top: 2px; }
    .val-green { color: #86efac !important; }
    .val-red   { color: #fca5a5 !important; }
    .val-amber { color: #fde68a !important; }

    /* ── Body ── */
    .flt-body {
        background: var(--fc-bg); min-height: calc(100vh - 180px);
        padding: 18px clamp(16px, 3vw, 40px) 96px;
        max-width: 1440px; width: 100%; margin: 0 auto;
        box-sizing: border-box; position: relative; z-index: 2;
        display: flex; flex-direction: column; gap: 14px;
    }

    .flt-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px; background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center; box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .flt-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .flt-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .flt-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .flt-state-box p { margin: 0; font-size: 13px; color: var(--fc-muted); }

    .flt-card { background: var(--fc-card); border: 1px solid var(--fc-border); border-radius: var(--fc-radius); box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06); overflow: hidden; }

    /* ── Toolbar ── */
    .flt-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; background: linear-gradient(180deg, #fff 0%, #fafbfd 100%); border-bottom: 1px solid #edf1f7; flex-wrap: wrap; }
    .flt-search-wrap { position: relative; display: flex; align-items: center; flex: 1; min-width: 200px; max-width: 380px; }
    .flt-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }
    .flt-search-input {
        width: 100%; height: 42px; padding: 0 36px 0 12px; border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text); font-family: inherit; font-size: 13px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .flt-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .flt-search-input::placeholder { color: #b0bcc8; }
    .flt-search-clear { position: absolute; left: 10px; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; border: none; background: #edf1f7; color: #8899ae; cursor: pointer; }
    .flt-search-clear:hover { background: #dde3ed; }
    .flt-results-badge { display: flex; align-items: center; gap: 5px; margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap; }
    .flt-results-badge strong { color: #5a6e88; }

    /* ── Tabs ── */
    .flt-tab-bar { padding: 10px 18px; background: #f9fafd; border-bottom: 1px solid #edf1f7; }
    .flt-tabs { display: flex; gap: 4px; padding: 3px; border-radius: 10px; background: #f0f3f8; width: fit-content; }
    .flt-tab {
        display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border: none; border-radius: 7px;
        background: transparent; color: #6b7d95; font-family: inherit; font-size: 12px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .flt-tab:hover:not(.active) { color: var(--fc-text); background: rgba(255,255,255,.6); }
    .flt-tab.active { background: var(--fc-card); color: var(--fc-blue); box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800; }
    .flt-tab-count { min-width: 22px; height: 20px; border-radius: 5px; padding: 0 6px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 900; background: var(--fc-blue-lt); color: var(--fc-blue); }
    .flt-tab:not(.active) .flt-tab-count { background: #e4eaf3; color: #8899ae; }

    /* ── Loading / Empty ── */
    .flt-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 200px; color: var(--fc-muted); font-size: 12px; font-weight: 600; }
    .flt-spinner { width: 32px; height: 32px; border: 3px solid #dde5f0; border-top-color: var(--fc-blue); border-radius: 50%; animation: flt-spin .75s linear infinite; }
    @@keyframes flt-spin { to { transform: rotate(360deg); } }
    .flt-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 240px; padding: 40px; text-align: center; }
    .flt-empty-icon { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f4fa; color: #b0c4d8; }
    .flt-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .flt-empty-sub { font-size: 12px; color: var(--fc-muted); }

    /* ── Table ── */
    .flt-table-wrap { overflow-x: auto; }
    .flt-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .flt-table thead th {
        padding: 12px 14px; background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 10.5px; font-weight: 800; text-align: center;
        border-bottom: 2px solid #e4eaf3; white-space: nowrap;
    }
    .flt-table .th-start { text-align: right; }
    .flt-table tbody tr { border-bottom: 1px solid #f0f3f8; transition: background .12s ease; }
    .flt-table tbody tr:last-child { border-bottom: none; }
    .flt-table tbody tr:hover { background: #fafcff; }
    .flt-table tbody td { padding: 11px 12px; color: #526070; text-align: center; vertical-align: middle; }
    .td-start { text-align: right !important; }
    .td-muted { color: #8899ae; font-size: 11px; }

    .flt-item-cell { display: flex; align-items: center; gap: 10px; }
    .flt-avatar { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #fff; box-shadow: 0 2px 6px rgba(0,0,0,.10); }
    .av-available   { background: linear-gradient(135deg, #0d8a48, #16a35b); }
    .av-intrip      { background: linear-gradient(135deg, #1558d6, #1e6ef5); }
    .av-maintenance { background: linear-gradient(135deg, #b87d08, #e09a10); }
    .av-outofservice{ background: linear-gradient(135deg, #6b7d95, #4a5a74); }

    .flt-item-info { min-width: 0; }
    .flt-code-plate { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .flt-code-chip { display: inline-flex; padding: 2px 8px; border-radius: 6px; background: #f0f4fa; border: 1px solid #e0e8f4; font-size: 10.5px; font-weight: 800; color: var(--fc-blue); font-family: "Inter", Arial, sans-serif; }
    .flt-plate-num { font-size: 13px; font-weight: 800; color: #1c2b43; margin-top: 4px; font-family: "Inter", Arial, sans-serif; }

    .flt-type-cell { display: flex; flex-direction: column; gap: 4px; align-items: center; }
    .flt-type-tag { display: inline-flex; padding: 3px 10px; border-radius: 6px; background: var(--fc-blue-lt); color: var(--fc-blue); font-size: 11px; font-weight: 800; border: 1px solid #bdd4fc; }
    .flt-brand-sub { font-size: 10.5px; color: #8899ae; font-weight: 600; }

    .flt-ownership-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 800;
    }
    .ownership-company { background: #eaf1ff; color: var(--fc-blue); border: 1px solid #bdd4fc; }
    .ownership-external { background: #fff8e6; color: #9a6d08; border: 1px solid #f0d898; }

    .flt-doc-cell { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }
    .flt-doc-badge { display: inline-flex; padding: 2px 8px; border-radius: 5px; font-size: 10px; font-weight: 700; white-space: nowrap; }
    .doc-valid   { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .doc-warning { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }
    .doc-expired { background: var(--fc-red-lt); color: var(--fc-red); border: 1px solid #ffc8cf; }

    .flt-status-chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 7px; font-size: 10.5px; font-weight: 800; }
    .flt-status-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; }
    .chip-available   { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .chip-intrip      { background: var(--fc-blue-lt); color: var(--fc-blue); border: 1px solid #c0d4fb; }
    .chip-maintenance { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }
    .chip-outofservice{ background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }
    .dot-available    { background: var(--fc-green); }
    .dot-intrip       { background: var(--fc-blue); }
    .dot-maintenance  { background: var(--fc-amber); }
    .dot-outofservice { background: #6b7d95; }

    .flt-actions { display: flex; align-items: center; gap: 3px; justify-content: center; }
    .flt-act-btn { width: 30px; height: 30px; border-radius: 7px; display: flex; align-items: center; justify-content: center; border: 1px solid transparent; cursor: pointer; transition: all .15s ease; background: transparent; }
    .act-edit { color: var(--fc-blue); }
    .act-del  { color: var(--fc-red); }
    .act-edit:hover { background: var(--fc-blue-lt); border-color: #c0d4fb; }
    .act-del:hover  { background: var(--fc-red-lt); border-color: #ffc8cf; }

    .flt-confirm-del { height: 28px; padding: 0 10px; border: none; border-radius: 6px; background: linear-gradient(135deg, #e03048, #c0182e); color: #fff; font-family: inherit; font-size: 10px; font-weight: 800; cursor: pointer; animation: flt-pulse-del 1s ease infinite; white-space: nowrap; }
    @@keyframes flt-pulse-del { 0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.35); } 50% { box-shadow: 0 0 0 5px rgba(224,48,72,0); } }

    /* ── Modals (svc-modal) ── */
    .svc-modal-backdrop { position: fixed; inset: 0; z-index: 1400; background: rgba(10,27,59,.62); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; padding: 20px; animation: svc-fade .2s ease both; }
    @@keyframes svc-fade { from { opacity: 0; } to { opacity: 1; } }

