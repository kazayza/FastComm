    private async Task SaveVehicleAsync()
    {
        _saving = true;
        _msg = null;
        try
        {
            var res = _vId is null
                ? await Http.PostAsJsonAsync("api/fleet/vehicles", _vf)
                : await Http.PutAsJsonAsync($"api/fleet/vehicles/{_vId}", _vf);
            _msg = await MsgOf(res);
            _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                CloseAll();
                await LoadAsync();
            }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task SaveTrailerAsync()
    {
        _saving = true;
        _msg = null;
        try
        {
            var payload = new
            {
                plateNumber = _tf.PlateNumber,
                trailerType = _tf.TrailerType,
                sizeFeet = _tf.SizeFeet,
                ownershipType = _tf.OwnershipType,
                supplierId = _tf.SupplierId,
                licenseExpiryDate = _tf.LicenseExpiryDate,
                insuranceExpiryDate = _tf.InsuranceExpiryDate,
                status = _tf.Status,
                notes = _tf.Notes
            };
            var res = _tId is null
                ? await Http.PostAsJsonAsync("api/fleet/trailers", payload)
                : await Http.PutAsJsonAsync($"api/fleet/trailers/{_tId}", payload);
            _msg = await MsgOf(res);
            _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                CloseAll();
                await LoadAsync();
