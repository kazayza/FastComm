    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView)
        {
            await LoadAsync();
            if (CanCreate)
                try { _suppliers = await Http.GetFromJsonAsync<List<Opt>>("api/options/suppliers") ?? new(); } catch { }
        }
    }

    private async Task Reload() { await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _vehicles = await Http.GetFromJsonAsync<List<VItem>>("api/fleet/vehicles") ?? new();
            _trailers = await Http.GetFromJsonAsync<List<TItem>>("api/fleet/trailers") ?? new();
        }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

