    /* ══════════════════════════════════════
       STATE
    ══════════════════════════════════════ */
    private AuthUser? _user;
    private bool CanView => _user?.Can("FLEET.VIEW") ?? false;
    private bool CanCreate => _user?.Can("FLEET.CREATE") ?? false;
    private bool CanEdit => _user?.Can("FLEET.EDIT") ?? false;
    private bool CanDelete => _user?.Can("FLEET.DELETE") ?? false;

    private string _tab = "v";
    private string _search = "";
    private string _kpiFilter = "";
    private bool _loading;
    private List<VItem> _vehicles = new();
    private List<TItem> _trailers = new();
    private List<Opt> _suppliers = new();
    private List<Opt> _filteredSuppliers = new();
    private int? _confirmV, _confirmT;
    private bool _fabOpen;

    private bool _vOpen, _tOpen, _saving;
    private string? _msg;
    private bool _ok;
    private int? _vId, _tId;
    private VForm _vf = new();
    private TForm _tf = new();
    private int _vActiveTab = 0;

    private string _supplierSearch = "";
    private bool _showSupplierDropdown;
    private int _focusedSupplierIndex = -1;

    /* ══════════════════════════════════════
       COMPUTED
    ══════════════════════════════════════ */
    private static string StatusAr(string s) => s switch
    {
        "Available"    => "متاحة للتشغيل",
        "InTrip"       => "في رحلة نشطة",
        "Maintenance"  => "قيد الصيانة",
        "OutOfService" => "خارج الخدمة",
        _              => s
    };

    private static string StatusChipClass(string s) => s switch
    {
        "Available"    => "chip-available",
        "InTrip"       => "chip-intrip",
        "Maintenance"  => "chip-maintenance",
        "OutOfService" => "chip-outofservice",
        _              => "chip-outofservice"
    };

    private static string StatusDotClass(string s) => s switch
    {
        "Available"    => "dot-available",
        "InTrip"       => "dot-intrip",
        "Maintenance"  => "dot-maintenance",
        "OutOfService" => "dot-outofservice",
        _              => "dot-outofservice"
    };

    private static string VehicleAvatarClass(string s) => s switch
    {
        "Available"    => "av-available",
        "InTrip"       => "av-intrip",
        "Maintenance"  => "av-maintenance",
        "OutOfService" => "av-outofservice",
        _              => "av-outofservice"
    };

    private IEnumerable<VItem> VehiclesFiltered => _vehicles.Where(v =>
        (_kpiFilter == "" || v.Status == _kpiFilter) &&
        (string.IsNullOrWhiteSpace(_search) ||
         NormalizeArabic(v.PlateNumber).Contains(NormalizeArabic(_search)) ||
         NormalizeArabic(v.VehicleCode).Contains(NormalizeArabic(_search))));

    private IEnumerable<TItem> TrailersFiltered => _trailers.Where(t =>
        (_kpiFilter == "" || t.Status == _kpiFilter) &&
        (string.IsNullOrWhiteSpace(_search) ||
         NormalizeArabic(t.PlateNumber ?? "").Contains(NormalizeArabic(_search)) ||
         NormalizeArabic(t.TrailerCode).Contains(NormalizeArabic(_search))));

    private static string NormalizeArabic(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        string[] diacritics = new[] { "َ", "ُ", "ِ", "ّ", "ً", "ٌ", "ٍ", "ْ", "ـ" };
        foreach (var d in diacritics) s = s.Replace(d, "");
        return s
            .Replace('أ', 'ا').Replace('إ', 'ا').Replace('آ', 'ا').Replace('ٱ', 'ا').Replace('ء', 'ا')
            .Replace('ة', 'ه').Replace('ى', 'ي').Replace('ؤ', 'و').Replace('ئ', 'ي')
            .Replace("  ", " ").ToLowerInvariant().Trim();
    }

    private static decimal? ParseNullDec(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n >= 0 ? n : (decimal?)null;
    private static byte ParseByte(object? v, byte fallback) =>
        byte.TryParse(v?.ToString(), out var n) ? n : fallback;
    private static byte? ParseNullByte(object? v) =>
        byte.TryParse(v?.ToString(), out var n) ? n : (byte?)null;

    private void SetKpiFilter(string f) { _kpiFilter = _kpiFilter == f ? "" : f; }
    private void ToggleFab() => _fabOpen = !_fabOpen;

    /* ══════════════════════════════════════
       AUTOCOMPLETE (Supplier)
    ══════════════════════════════════════ */
    private void OnSupplierSearch(ChangeEventArgs e)
    {
        _supplierSearch = e.Value?.ToString() ?? "";
        _showSupplierDropdown = true;
        _focusedSupplierIndex = -1;
        FilterSuppliers(_supplierSearch);
    }

    private void FilterSuppliers(string search)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            _filteredSuppliers = _suppliers.Take(20).ToList();
            return;
        }
        var normalized = NormalizeArabic(search.Trim());
        _filteredSuppliers = _suppliers
            .Where(s => NormalizeArabic(s.Label).Contains(normalized))
            .Take(20)
            .ToList();
    }

    private void OnSupplierInputKeyDown(KeyboardEventArgs e)
    {
        if (!_showSupplierDropdown || !_filteredSuppliers.Any())
        {
            if (e.Key == "ArrowDown") _showSupplierDropdown = true;
            return;
        }
        if (e.Key == "ArrowDown")
            _focusedSupplierIndex = (_focusedSupplierIndex + 1) % _filteredSuppliers.Count;
        else if (e.Key == "ArrowUp")
            _focusedSupplierIndex = _focusedSupplierIndex <= 0 ? _filteredSuppliers.Count - 1 : _focusedSupplierIndex - 1;
        else if (e.Key == "Enter")
        {
            if (_focusedSupplierIndex >= 0 && _focusedSupplierIndex < _filteredSuppliers.Count)
            {
                if (_vOpen) PickSupplier(_filteredSuppliers[_focusedSupplierIndex]);
                else if (_tOpen) PickSupplierTrailer(_filteredSuppliers[_focusedSupplierIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            _showSupplierDropdown = false;
            _focusedSupplierIndex = -1;
        }
    }

    private void OnSupplierInputFocus()
    {
        _showSupplierDropdown = true;
        _focusedSupplierIndex = -1;
        FilterSuppliers(_supplierSearch);
    }

    private async Task OnSupplierInputBlur()
    {
        await Task.Delay(250);
        _showSupplierDropdown = false;
    }

    private void PickSupplier(Opt s)
    {
        _vf.SupplierId = s.Id;
        _supplierSearch = s.Label;
        _showSupplierDropdown = false;
        _focusedSupplierIndex = -1;
        StateHasChanged();
    }

    private void PickSupplierTrailer(Opt s)
    {
        _tf.SupplierId = s.Id;
        _supplierSearch = s.Label;
        _showSupplierDropdown = false;
        _focusedSupplierIndex = -1;
        StateHasChanged();
    }

    private void ClearSupplierSelection()
    {
        _vf.SupplierId = null;
        _supplierSearch = "";
