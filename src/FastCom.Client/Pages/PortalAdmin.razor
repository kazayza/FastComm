</style>

@code {
    private AuthUser? _user;
    private bool Can => _user?.Can("CUSTOMER.PORTAL_TOKEN") ?? false;

    private List<Opt> _customers = new();
    private List<Tok> _tokens = new();
    private List<Log> _logs = new();
    private int _cust;
    private long? _logsToken;
    private string? _newLink;

    private bool _open, _saving;
    private string? _msg; private bool _ok = true;
    private string _purpose = "Portal";
    private long _invoiceId;
    private int _days = 7;
    private int _maxUses = 20;
    private bool _fabOpen;
    private bool _loading;

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    public class Tok
    {
        public long PortalTokenId { get; set; }
        public string Purpose { get; set; } = "";
        public long? InvoiceId { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? ExpiresAt { get; set; }
        public int? MaxUses { get; set; }
        public int UsedCount { get; set; }
        public DateTime? LastUsedAt { get; set; }
        public bool IsActive { get; set; }
        public DateTime? RevokedAt { get; set; }
    }

    public class Log
    {
        public DateTime AccessedAt { get; set; }
        public string Action { get; set; } = "";
        public string? EntityType { get; set; }
        public long? EntityId { get; set; }
        public string? IpAddress { get; set; }
    }

    public class NewTok
    {
        public long PortalTokenId { get; set; }
        public string Token { get; set; } = "";
        public string Path { get; set; } = "";
        public DateTime? ExpiresAt { get; set; }
    }

    private string _custName => _customers.FirstOrDefault(c => c.Id == _cust)?.Label ?? "";

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!Can) return;
        try { _customers = await Http.GetFromJsonAsync<List<Opt>>("api/options/customers") ?? new(); }
        catch { _customers = new(); }
    }

    private async Task LoadTokensAsync()
    {
        _fabOpen = false;
        if (_cust == 0) return;
        _loading = true;
        try { _tokens = await Http.GetFromJsonAsync<List<Tok>>($"api/portal/tokens?customerId={_cust}") ?? new(); }
        catch (Exception ex) { _ok = false; _msg = "فشل تحميل البيانات: " + ex.Message; }
        finally { _loading = false; }
    }

    private void OpenNew() { _fabOpen = false; _msg = null; _newLink = null; _open = true; }
    private void Close() { _open = false; _msg = null; }

    private async Task CreateAsync()
    {
        if (_saving) return;
        if (_cust == 0) { _ok = false; _msg = "يرجى اختيار العميل المستهدف أولاً"; return; }
        if (_purpose == "InvoiceView" && _invoiceId <= 0) { _ok = false; _msg = "رقم الفاتورة المرتبطة مطلوب"; return; }

        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/portal/tokens", new
            {
                customerId = _cust,
                purpose = _purpose,
                invoiceId = _purpose == "InvoiceView" ? _invoiceId : (long?)null,
                expiresInDays = _days,
                maxUses = _maxUses > 0 ? _maxUses : (int?)null
            });

            if (res.IsSuccessStatusCode)
            {
                var nt = await res.Content.ReadFromJsonAsync<NewTok>();
                _newLink = nt is null ? null : Base() + nt.Path;
                _msg = "تم توليد رابط الوصول المؤقت للعميل بنجاح. يرجى نسخه فوراً لغايات الحماية.";
                _ok = true;
                _open = false;
                await LoadTokensAsync();
            }
            else
            {
                _msg = await MsgOf(res); _ok = false;
            }
            Snackbar.Add(_msg ?? "", _ok ? Severity.Success : Severity.Error);
        }
        catch (Exception ex) { _ok = false; _msg = "فشل توليد الرابط: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task RevokeAsync(Tok t)
    {
        try
        {
            var res = await Http.PostAsync($"api/portal/tokens/{t.PortalTokenId}/revoke", null);
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, _ok ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadTokensAsync();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل في إبطال الرابط: " + ex.Message; }
    }

    private async Task ShowLogs(Tok t)
    {
        _logsToken = t.PortalTokenId;
        try { _logs = await Http.GetFromJsonAsync<List<Log>>($"api/portal/tokens/{t.PortalTokenId}/logs") ?? new(); }
        catch { _logs = new(); }
    }

    private async Task CopyAsync()
    {
        if (_newLink is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newLink); }
        catch { }
        Snackbar.Add("تم نسخ الرابط الحافظة بنجاح", Severity.Success);
    }

    private static string ChipCls(Tok t)
    {
        if (!t.IsActive) return "fc-chip-gray";
        if (t.ExpiresAt is not null && t.ExpiresAt < DateTime.UtcNow) return "fc-chip-bad";
        return "fc-chip-ok";
    }

    private static string ChipTxt(Tok t)
    {
        if (!t.IsActive) return "مُبطل";
        if (t.ExpiresAt is not null && t.ExpiresAt < DateTime.UtcNow) return "منتهي";
        if (t.MaxUses is not null && t.UsedCount >= t.MaxUses) return "استنفد الحد";
        return "نشط";
    }

    private static string PurposeAr(string p) => p switch
    {
        "Portal" => "البوابة كاملة", "Statement" => "كشف الحساب",
        "InvoiceView" => "فاتورة واحدة", _ => p
    };

    private string Base() => Nav.BaseUri.TrimEnd('/');

    private static long Lng(object? v) => long.TryParse(v?.ToString(), out var n) && n > 0 ? n : 0;

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تمت العملية بنجاح" : "حصل خطأ غير متوقع"; }
    }

    /* ── FAB States ── */
    private void ToggleFab() => _fabOpen = !_fabOpen;
    private void CloseFab() => _fabOpen = false;
    private void OnFabKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") _fabOpen = false; }
}