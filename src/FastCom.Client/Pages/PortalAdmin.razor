    }
    .ptl-table .th-start { text-align: right; }
    .ptl-table tbody tr {
        border-bottom: 1px solid #f0f3f8; transition: background .12s ease;
    }
    .ptl-table tbody tr:last-child { border-bottom: none; }
    .ptl-table tbody tr:hover { background: #fafcff; }
    .ptl-table tbody td {
        padding: 12px 14px; color: #526070; text-align: center; vertical-align: middle;
    }
    .td-start { text-align: right !important; }
    .td-muted { color: #8899ae; font-size: 11.5px; }

    .ptl-purpose-cell { display: flex; flex-direction: column; gap: 2px; }
    .ptl-purpose-title { font-size: 12.5px; font-weight: 800; color: #1c2c44; }
    .ptl-invoice-id { font-size: 10px; color: #8899ae; font-weight: 700; }
    .ptl-expiry-date { font-family: "Inter", sans-serif; font-weight: 700; color: #1c2c44; }
    .ptl-use-count { font-family: "Inter", sans-serif; font-weight: 700; color: #1c2c44; }

    /* Indicator Status Chips */
    .ptl-status-chip {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 3px 9px; border-radius: 6px;
        font-size: 10px; font-weight: 800;
    }
    .fc-chip-ok   { background: #e9f8f0; color: #0e7a43; border: 1px solid #b0e0c5; }
    .fc-chip-bad  { background: #fff0f2; color: var(--fc-red); border: 1px solid #ffc8cf; }
    .fc-chip-gray { background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }
    .chip-dot { width: 5px; height: 5px; border-radius: 50%; }
    .fc-chip-ok .chip-dot   { background: #16a35b; }
    .fc-chip-bad .chip-dot  { background: #e03048; }
    .fc-chip-gray .chip-dot { background: #6b7d95; }

    /* Actions */
    .ptl-row-actions { display: flex; align-items: center; gap: 6px; justify-content: center; }
    .ptl-btn-action {
        width: 30px; height: 30px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; cursor: pointer;
        transition: all 0.15s ease; background: transparent;
    }
    .ptl-btn-action.view   { color: var(--fc-blue); }
    .ptl-btn-action.view:hover { background: #eaf1ff; border-color: #bdd4fc; }
    .ptl-btn-action.revoke { color: var(--fc-red); }
    .ptl-btn-action.revoke:hover { background: #fff0f2; border-color: #ffc8cf; }

    .ptl-empty-table { padding: 40px; text-align: center; color: #9aaabb; font-size: 13px; font-weight: 700; }

    /* ── Logs Section ── */
    .ptl-logs-section {
        margin-top: 24px;
        border-top: 1px solid #edf1f7;
    }
    .ptl-logs-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 18px 12px;
    }
    .ptl-logs-head-left { display: flex; flex-direction: column; gap: 2px; }
    .ptl-logs-title { font-size: 13.5px; font-weight: 800; color: #1c2b43; }
    .ptl-logs-sub { font-size: 10.5px; color: #8899ae; }

    /* ── Warning & Info Alerts ── */
    .ptl-inline-alert {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 12px 16px; border-radius: 10px;
        background: #fff0f2; border: 1px solid #ffc8cf;
    }
    .ptl-alert-icon { flex: 0 0 auto; color: var(--fc-red); margin-top: 2px; }
    .ptl-alert-body { font-size: 11.5px; color: #c02040; line-height: 1.6; }
    .ptl-alert-body strong { display: block; font-size: 12.5px; font-weight: 800; color: #b02040; }

    /* ── الـ Overlap لحماية الهيرو والتأكد من عدم تغطية المحتوى ── */
    .fc-overlap {
        margin-top: 20px !important;
        position: relative;
        z-index: 2;
    }

    /* ════════════════════════════════════════════════════════
       ⚡ GOLD GLOW FAB ANIMATION (نفس الـ markup والمحاذاة لـ app.css)
    ════════════════════════════════════════════════════════ */
    .fc-fab-main.fc-glow-gold {
        position: relative;
        background: linear-gradient(135deg, var(--fc-blue) 0%, var(--fc-navy) 100%) !important;
        border: 2px solid var(--fc-gold) !important;
        box-shadow: 0 4px 16px rgba(11, 86, 223, 0.4);
        animation: fc-gold-glow-pulse 2.2s infinite;
    }

    .fc-fab-main.fc-glow-gold::before {
        content: "";
        position: absolute;
        inset: -2px;
        border-radius: 50%;
        border: 2px solid var(--fc-gold);
        opacity: 0;
        pointer-events: none;
        animation: fc-ring-expand 2.2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
    }

    @@keyframes fc-gold-glow-pulse {
        0%, 100% {
            box-shadow: 
                0 0 0 0 rgba(255, 128, 21, 0.6), 
                0 8px 24px rgba(11, 86, 223, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }
        50% {
            box-shadow: 
