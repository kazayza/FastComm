@page "/portal-admin"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>بوابة العملاء — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO — كارت مستقل بحواف دائرية 20px
   يحفظ خلفية وتدرج ولولو الـ fc-hero الأصلي تماماً
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="ptl-hero-row">
                <div class="ptl-hero-left">
                    <div class="ptl-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                        </svg>
                        <span>الإدارة · بوابة العملاء</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">روابط بوابات العملاء المؤقتة</h1>
                    <span class="ptl-hero-sub">توفير وصول آمن مؤقت للعملاء لاستعراض فواتيرهم وكشوف الحسابات دون الحاجة للتسجيل</span>
                </div>

                <div class="ptl-hero-right">
                    <span class="ptl-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                    <span class="ptl-hero-chip ptl-chip-highlight">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                        </svg>
                        الروابط النشطة: @_tokens.Count(t => t.IsActive)
                    </span>
                </div>
            </div>

            @if (Can)
            {
                <div class="ptl-kpis-row">
                    <div class="ptl-kpi ptl-kpi-blue">
                        <div class="ptl-kpi-inner">
                            <div class="ptl-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" /></div>
                            <div class="ptl-kpi-data">
                                <div class="ptl-kpi-num">@_tokens.Count</div>
                                <div class="ptl-kpi-label">إجمالي الروابط</div>
                            </div>
                        </div>
                    </div>
                    <div class="ptl-kpi ptl-kpi-green">
                        <div class="ptl-kpi-inner">
                            <div class="ptl-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /></div>
                            <div class="ptl-kpi-data">
                                <div class="ptl-kpi-num">@_tokens.Count(t => t.IsActive)</div>
                                <div class="ptl-kpi-label">روابط نشطة حالياً</div>
                            </div>
                        </div>
                    </div>
                    <div class="ptl-kpi ptl-kpi-gold">
                        <div class="ptl-kpi-inner">
                            <div class="ptl-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /></div>
                            <div class="ptl-kpi-data">
                                <div class="ptl-kpi-num">@_tokens.Sum(t => t.UsedCount)</div>
                                <div class="ptl-kpi-label">إجمالي عدد الاستخدامات</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="ptl-body">
    @if (!Can)
    {
        <div class="ptl-state-box">
            <div class="state-icon-wrap perm">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليست لديك الصلاحية الكافية لإدارة بوابة العملاء (CUSTOMER.PORTAL_TOKEN)</p>
        </div>
    }
    else
    {
        <div class="ptl-card">

            @* ── رسائل الحالة والتأكيد ── *@
            @if (_msg is not null)
            {
                <div class="ptl-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <div class="banner-icon" aria-hidden="true">
                        @if (_ok)
                        {
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                            </svg>
                        }
                    </div>
                    <span>@_msg</span>
                    <button class="banner-close" @onclick="() => _msg = null">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }

            @* ── عرض الرابط المنشأ حديثاً (مرة واحدة فقط) ── *@
            @if (_newLink is not null)
            {
                <div class="ptl-banner banner-info" role="alert">
                    <div class="banner-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="ptl-new-link-inner">
                        <strong>رابط الوصول المؤقت جاهز ومفعل للعميل:</strong>
                        <div class="ptl-link-copy-box" @onclick="CopyAsync" title="اضغط للنسخ">
                            <span class="ptl-link-url">@_newLink</span>
                            <span class="ptl-link-action-tag">نسخ الرابط المباشر</span>
                        </div>
                        <p class="ptl-link-warning">يرجى ملاحظة أن هذا الرابط المباشر يظهر لك لمرة واحدة فقط لغايات الحماية التشغيلية. لا يتم حفظ الروابط المشفرة في النظام بل تحفظ البصمات الأمنية فقط.</p>
                    </div>
                </div>
            }

            @* ── شريط فلاتر واختيار العميل ── *@
            <div class="ptl-toolbar">
                <div class="ptl-filters">
                    <select class="ptl-select" @bind="_cust" style="max-width: 320px;" title="العميل">
                        <option value="0">— اختر العميل المستهدف —</option>
                        @foreach (var c in _customers) { <option value="@c.Id">@c.Label</option> }
                    </select>

                    <button class="ptl-btn-apply" @onclick="LoadTokensAsync" disabled="@(_cust == 0)">عرض الروابط الفعالة</button>
                </div>
            </div>

            @* ── جدول مصفوفة الروابط ── *@
            <div class="ptl-table-wrap">
                <table class="ptl-table" aria-label="مصفوفة الروابط">
                    <thead>
                        <tr>
                            <th scope="col" class="th-start">الغرض والوصول</th>
                            <th scope="col">تاريخ الإنشاء</th>
                            <th scope="col">تاريخ انتهاء الصلاحية</th>
                            <th scope="col">الاستخدام الحالي</th>
                            <th scope="col">آخر حركة وصول</th>
                            <th scope="col">حالة الرابط</th>
                            <th scope="col" style="width: 120px">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _tokens)
                        {
                            <tr>
                                <td class="td-start">
                                    <div class="ptl-purpose-cell">
                                        <span class="ptl-purpose-title">@PurposeAr(t.Purpose)</span>
                                        @if (t.InvoiceId is not null)
                                        {
                                            <span class="ptl-invoice-id">مرتبط بفاتورة رقم #@t.InvoiceId</span>
                                        }
                                    </div>
                                </td>
                                <td class="td-muted">@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (t.ExpiresAt is null)
                                    {
                                        <span class="td-muted">غير محدود الصلاحية</span>
                                    }
                                    else
                                    {
                                        <span class="ptl-expiry-date">@t.ExpiresAt.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                </td>
                                <td>
                                    <span class="ptl-use-count">@t.UsedCount</span>
                                    @if (t.MaxUses is not null)
                                    {
                                        <span class="td-muted"> / @t.MaxUses</span>
                                    }
                                </td>
                                <td class="td-muted">
                                    @(t.LastUsedAt is null ? "لم يتم الدخول بعد" : t.LastUsedAt.Value.ToString("yyyy-MM-dd HH:mm"))
                                </td>
                                <td>
                                    <span class="ptl-status-chip @ChipCls(t)">
                                        <span class="chip-dot" aria-hidden="true"></span>
                                        @ChipTxt(t)
                                    </span>
                                </td>
                                <td>
                                    <div class="ptl-row-actions">
                                        <button class="ptl-btn-action view" @onclick="() => ShowLogs(t)" title="استعراض سجلات الدخول للرابط">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                            </svg>
                                        </button>
                                        @if (t.IsActive)
                                        {
                                            <button class="ptl-btn-action revoke" @onclick="() => RevokeAsync(t)" title="إبطال وإلغاء فاعلية الرابط فوراً">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (_tokens.Count == 0)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="ptl-empty-table">
                                        @(_cust == 0 ? "يرجى تحديد العميل المستهدف أولاً من شريط الفلاتر العلوي" : "لا توجد أي روابط أو تصاريح وصول مسجلة للعميل المختار")
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ── كارد سجل حركة العميل للرابط المحدد ── *@
            @if (_logsToken is not null)
            {
                <div class="ptl-logs-section">
                    <div class="ptl-logs-head">
                        <div class="ptl-logs-head-left">
                            <span class="ptl-logs-title">سجل دخول ووصول العميل للرابط</span>
                            <span class="ptl-logs-sub">تفاصيل أحدث 200 حركة وصول للرابط التعريفي المختار رقم (#@_logsToken)</span>
                        </div>
                    </div>

                    <div class="ptl-table-wrap">
                        <table class="ptl-table ptl-table-compact" aria-label="جدول سجل حركة العميل">
                            <thead>
                                <tr>
                                    <th scope="col" class="th-start">توقيت وتاريخ الحركة</th>
                                    <th scope="col">العملية المنفذة</th>
                                    <th scope="col" class="th-start">المستند المستعرض</th>
                                    <th scope="col">عنوان شبكة الوصول IP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in _logs)
                                {
                                    <tr>
                                        <td class="td-muted td-start">@l.AccessedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td><strong>@l.Action</strong></td>
                                        <td class="td-start">
                                            @(string.IsNullOrWhiteSpace(l.EntityType) ? "—" : $"{l.EntityType} #{l.EntityId}")
                                        </td>
                                        <td class="td-muted font-mono">@(l.IpAddress ?? "—")</td>
                                    </tr>
                                }
                                @if (_logs.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4">
                                            <div class="ptl-empty-table">العميل لم يقم بتسجيل أي حركة دخول على هذا الرابط حتى الآن</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    }
</div>

@* ═══════════════════════════════════════════
   ⚡ GLOW FAB — الوميض الذهبي الدائم متعدد الإجراءات
═══════════════════════════════════════════ *@
@if (Can && !_loading)
{
    <div class="fc-fab-container">
        <div class="fc-fab-menu @(_fabOpen ? "is-open" : "")" role="menu" aria-label="الإجراءات السريعة">
            @* زر إنشاء رابط جديد *@
            <button type="button" class="fc-fab-item" role="menuitem" @onclick="OpenNew" disabled="@(_cust == 0)">
                <span class="fc-fab-icon"><MudIcon Icon="@Icons.Material.Filled.AddLink" Size="Size.Small" /></span>
                <span class="fc-fab-label">رابط بوابة جديد</span>
            </button>
            @* زر التحديث *@
            <button type="button" class="fc-fab-item" role="menuitem" @onclick="LoadTokensAsync">
                <span class="fc-fab-icon"><MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /></span>
                <span class="fc-fab-label">تحديث البيانات</span>
            </button>
        </div>

        @* زر الوميض *@
        <button type="button" class="fc-fab-main fc-glow-gold @(_fabOpen ? "is-open" : "")" @onclick="ToggleFab" aria-label="التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" class="fc-fab-svg">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
}

@* ═══════════════════════════════════════════
   MODAL — توليد رابط بوابة جديد
═══════════════════════════════════════════ *@
@if (_open && Can)
{
    <div class="cust-modal-backdrop" @onclick="Close" role="dialog" aria-modal="true">
        <div class="cust-modal cust-modal-sm" @onclick:stopPropagation="true">

            <div class="modal-head">
                <div class="modal-head-icon icon-blue" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15 7a2 2 0 012 2m-3.83 3.83a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                    </svg>
                </div>
                <div>
                    <div class="modal-title">إنشاء رابط بوابة جديد</div>
                    <div class="modal-sub">للعميل: @_custName</div>
                </div>
                <button class="modal-close-btn" @onclick="Close" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button class="banner-close" @onclick="() => _msg = null">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }

            <div class="modal-body">
                <div class="ptl-inline-alert" role="alert">
                    <div class="ptl-alert-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="ptl-alert-body">
                        <strong>متطلب مسبق:</strong> يرجى التأكد من تفعيل خانة "البوابة" ضمن ملف بيانات العميل الأساسية، وإلا سيقوم خادم الحماية برفض طلبات الربط والوصول.
                    </div>
                </div>

                <div class="modal-form-grid" style="margin-top: 14px;">
                    <div class="modal-form-field modal-field-full">
                        <label class="modal-field-label">الغرض وتصريح الوصول <span class="field-required">*</span></label>
                        <select class="modal-field-input" @bind="_purpose">
                            <option value="Portal">البوابة بالكامل (الفواتير وكشف الحساب المالي)</option>
                            <option value="Statement">كشف الحساب المالي فقط</option>
                            <option value="InvoiceView">عرض وإقرار فاتورة تشغيلية واحدة</option>
                        </select>
                    </div>

                    @if (_purpose == "InvoiceView")
                    {
                        <div class="modal-form-field modal-field-full">
                            <label class="modal-field-label">رقم الفاتورة المرتبطة <span class="field-required">*</span></label>
                            <input type="number" min="1" class="modal-field-input" value="@_invoiceId"
                                   @onchange="e => _invoiceId = Lng(e.Value)" placeholder="اكتب المعرف الرقمي للفاتورة المطلوبة" />
                        </div>
                    }

                    <div class="modal-form-field">
                        <label class="modal-field-label">مدة الفاعلية (أيام)</label>
                        <input type="number" min="1" max="365" class="modal-field-input" value="@_days"
                               @onchange="e => _days = (int)Lng(e.Value)" />
                        <div class="modal-field-hint">بحد أقصى سنة ميلادية واحدة</div>
                    </div>

                    <div class="modal-form-field">
                        <label class="modal-field-label">الحد الأقصى للاستخدام</label>
                        <input type="number" min="1" max="1000" class="modal-field-input" value="@_maxUses"
                               @onchange="e => _maxUses = (int)Lng(e.Value)" placeholder="اتركه فارغاً للاستخدام المفتوح" />
                        <div class="modal-field-hint">الحد الأقصى لمرات فتح واستعراض الرابط</div>
                    </div>
                </div>
            </div>

            <div class="modal-foot">
                <button class="modal-cancel-btn" @onclick="Close">إلغاء</button>
                <button class="modal-save-btn" @onclick="CreateAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm"></span>
                        <span>جاري الإنشاء...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M15 7a2 2 0 012 2m-3.83 3.83a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                        </svg>
                        <span>توليد الرابط</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

<style>
    /* ════════════════════════════════════════════════════════
       HERO WRAPPER — كارت مستقل بحواف دائرية 20px
       يحفظ خلفية وتدرج ولولو الـ fc-hero الأصلي تماماً
    ════════════════════════════════════════════════════════ */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: var(--fc-page-w);
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow:
            0 12px 32px rgba(13, 38, 84, 0.15),
            0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .fc-hero-title-slim {
        font-size: clamp(18px, 2vw, 24px) !important;
        margin: 0 !important;
    }

    .ptl-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .ptl-hero-left {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .ptl-hero-crumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 10.5px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 2px;
    }

    .ptl-hero-sub {
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.55);
        font-weight: 600;
    }

