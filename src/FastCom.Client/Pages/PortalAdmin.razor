    .ptl-kpi-blue .ptl-kpi-icon  { background: rgba(125, 211, 252, 0.15); color: #7dd3fc; }
    .ptl-kpi-green .ptl-kpi-icon { background: rgba(110, 231, 183, 0.15); color: #6ee7b7; }
    .ptl-kpi-gold .ptl-kpi-icon  { background: rgba(252, 211, 77, 0.15);  color: #fcd34d; }

    .ptl-kpi-data { flex: 1; min-width: 0; }
    .ptl-kpi-num { font-family: "Inter", Arial, sans-serif; font-size: 18px; font-weight: 900; color: #fff; line-height: 1; }
    .ptl-kpi-label { font-size: 10.5px; font-weight: 700; color: rgba(255, 255, 255, 0.6); margin-top: 3px; }

    /* ── Body Main Card ── */
    .ptl-body {
        padding: 18px clamp(16px, 3vw, 40px) 100px;
