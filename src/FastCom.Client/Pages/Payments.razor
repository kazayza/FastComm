@page "/payments"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>التحصيل — فاست كوم</PageTitle>


<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">المالية · تحصيل العملاء</div>
                <h1 class="fc-hero-title">التحصيل</h1>
                <p class="fc-hero-sub">دفعة واحدة ممكن تتوزّع على كذا فاتورة — والمديونية بتتحدّث أوتوماتيك</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="New">دفعة جديدة</MudButton>
                }
            </div>
        </div>

        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></div>
                    <div><div class="fc-kpi-num">@Money(Posted.Sum(p => p.Amount))</div><div class="fc-kpi-lb">إجمالي المحصّل</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                    <div><div class="fc-kpi-num">@Money(ThisMonth)</div><div class="fc-kpi-lb">تحصيل الشهر</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div><div class="fc-kpi-num">@Money(Unallocated)</div><div class="fc-kpi-lb">غير موزّع</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Close" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(p => p.Status == "Cancelled")</div><div class="fc-kpi-lb">دفعات ملغية</div></div>
                </div>
            </div>
        }
    </div>
</div>


<div class="pay-body">

    @if (!CanView)
    {
        <div class="pay-state-box">
            <div class="pay-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض المدفوعات</p>
        </div>
    }
    else
    {
        <div class="pay-card">

            @* ── Toolbar ── *@
            <div class="pay-toolbar">

                <div class="pay-search-wrap">
                    <svg class="pay-search-icon" viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="pay-search-input"
                           placeholder="ابحث برقم الدفعة أو العميل أو الشيك..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="pay-search-clear" @onclick="() => _search = string.Empty">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="pay-results-badge">
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>

            </div>


            @* ── Status Tabs ── *@
            <div class="pay-status-bar">
                <div class="pay-status-tabs" role="group" aria-label="فلتر الحالة">
                    @foreach (var t in _statusTabs)
                    {
                        var cnt = t.Key == "all"
                            ? _items.Count
                            : _items.Count(x => x.Status == t.Key);

                        <button class="pay-status-tab @(_tab == t.Key ? "active" : "")"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="pay-tab-dot @StatusDotColor(t.Key)" aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="pay-tab-count">@cnt</span>
                        </button>
                    }
                </div>
            </div>


            @* ── Content ── *@
            @if (_loading)
            {
                <div class="pay-loading">
                    <div class="pay-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل المدفوعات...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="pay-empty">
                    <div class="pay-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="42" height="42"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <circle cx="12" cy="14" r="2"/>
                        </svg>
                    </div>
                    <div class="pay-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) ? "لا توجد دفعات" : "لا توجد نتائج")
                    </div>
                    <div class="pay-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search) ? "سجّل أول دفعة تحصيل" : "جرّب كلمة بحث مختلفة")
                    </div>
                    @if (CanCreate && string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="pay-add-btn" @onclick="New">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            دفعة جديدة
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="pay-table-wrap">
                    <table class="pay-table" aria-label="قائمة المدفوعات">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">الدفعة</th>
                                <th scope="col">التاريخ</th>
                                <th scope="col">الطريقة</th>
                                <th scope="col">المبالغ</th>
                                <th scope="col">التوزيع</th>
                                <th scope="col">الحالة</th>
                                <th scope="col" style="width:140px">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Filtered)
                            {
                                <tr class="@(p.Status == "Cancelled" ? "row-cancelled" : "")">

                                    @* ── الدفعة ── *@
                                    <td class="td-start">
                                        <div class="pay-pay-cell">
                                            <div class="pay-avatar @AvatarClass(p.Status)"
                                                 aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="16" height="16"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                    <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                                    <circle cx="12" cy="14" r="2"/>
                                                </svg>
                                            </div>
                                            <div class="pay-pay-info">
                                                <button class="pay-code-btn"
                                                        @onclick="() => Open(p)"
                                                        aria-label="تفاصيل @p.PaymentNumber">
                                                    @p.PaymentNumber
                                                </button>
                                                <div class="pay-customer-name">@p.CustomerName</div>
                                                @if (p.ChequeNumber is not null)
                                                {
                                                    <div class="pay-cheque-tag">
                                                        <svg viewBox="0 0 16 16" width="9" height="9"
                                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                                             aria-hidden="true">
                                                            <rect x="2" y="4" width="12" height="9" rx="1"/>
                                                            <path d="M5 8h6M5 11h4" stroke-linecap="round"/>
                                                        </svg>
                                                        شيك @p.ChequeNumber
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    @* ── التاريخ ── *@
                                    <td>
                                        <div class="pay-date-cell">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.7"
                                                 aria-hidden="true">
                                                <rect x="2" y="3" width="12" height="11" rx="2"/>
                                                <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                                            </svg>
                                            @p.PaymentDate.ToString("yyyy-MM-dd")
                                        </div>
                                    </td>

                                    @* ── الطريقة ── *@
                                    <td>
                                        <span class="pay-method-tag">@p.MethodName</span>
                                    </td>

                                    @* ── المبالغ ── *@
                                    <td>
                                        <div class="pay-amounts-cell">
                                            <div class="pay-amount-main">@Money(p.Amount) <small>ج.م</small></div>
                                        </div>
                                    </td>

                                    @* ── التوزيع ── *@
                                    <td>
                                        <div class="pay-alloc-cell">
                                            @if (p.AllocationsCount > 0)
                                            {
                                                <div class="pay-alloc-bar-wrap">
                                                    @{
                                                        var allocPct = p.Amount > 0
                                                            ? (double)(p.Allocated / p.Amount * 100)
                                                            : 0;
                                                    }
                                                    <div class="pay-alloc-bar">
                                                        <div class="pay-alloc-fill @(p.Unallocated == 0 ? "fill-full" : "fill-partial")"
                                                             style="width:@Math.Min(allocPct, 100)%"></div>
                                                    </div>
                                                    <div class="pay-alloc-nums">
                                                        <span class="alloc-inv-count">@p.AllocationsCount فاتورة</span>
                                                        @if (p.Unallocated > 0)
                                                        {
                                                            <span class="alloc-remaining">@Money(p.Unallocated) فاضل</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="pay-unalloc-badge">غير موزّع</span>
                                            }
                                        </div>
                                    </td>

                                    @* ── الحالة ── *@
                                    <td>
                                        <span class="pay-chip @StatusChipClass(p.Status)">
                                            <span class="pay-chip-dot @StatusDotClass(p.Status)"
                                                  aria-hidden="true"></span>
                                            @StatusAr(p.Status)
                                        </span>
                                    </td>

                                    @* ── إجراءات ── *@
                                    <td>
                                        <div class="pay-actions">

                                            <button class="pay-act-btn act-info"
                                                    @onclick="() => Open(p)"
                                                    title="التفاصيل"
                                                    aria-label="تفاصيل @p.PaymentNumber">
                                                <svg viewBox="0 0 24 24" width="14" height="14"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                                </svg>
                                            </button>

                                            @if (p.Status == "Posted" && CanEdit)
                                            {
                                                <button class="pay-act-btn act-edit"
                                                        @onclick="() => Edit(p)"
                                                        title="تعديل"
                                                        aria-label="تعديل @p.PaymentNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                            }

                                            @if (p.Status == "Posted" && CanVoid)
                                            {
                                                @if (_confirmId == p.PaymentId)
                                                {
                                                    <button class="pay-confirm-void"
                                                            @onclick="() => Void(p)">
                                                        إلغاء؟
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="pay-act-btn act-void"
                                                            @onclick="() => _confirmId = p.PaymentId"
                                                            title="إلغاء الدفعة"
                                                            aria-label="إلغاء @p.PaymentNumber">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"/>
                                                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                                        </svg>
                                                    </button>
                                                }
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   MODAL — دفعة جديدة
═══════════════════════════════════════════ *@
@if (_modalOpen && CanCreate)
{
    <div class="pay-modal-backdrop" @onclick="Close"
         role="dialog" aria-modal="true" aria-label="تسجيل دفعة جديدة">
        <div class="pay-modal pay-modal-xl" @onclick:stopPropagation="true">

            <div class="pay-modal-head">
                <div class="pay-modal-icon pay-icon-green" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        <path d="M12 12v4M10 14h4" stroke-linecap="round"/>
                    </svg>
                </div>
                <div style="flex:1; min-width:0">
                    <div class="pay-modal-title">دفعة جديدة 💰</div>
                    <div class="pay-modal-sub">
                        الرقم بيتولد تلقائياً (PAY-)
                        @if (_f.Amount > 0)
                        {
                            <span> · المبلغ <strong>@Money(_f.Amount) ج.م</strong></span>
                        }
                        @if (Left < 0)
                        {
                            <span class="sub-warn"> · ⚠️ وزّعت أكتر من المبلغ</span>
                        }
                    </div>
                </div>
                <button class="pay-modal-close" @onclick="Close" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="pay-modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button @onclick="() => _msg = null">✕</button>
                </div>
            }

            <div class="pay-modal-body">

                @* ── بيانات الدفعة ── *@
                <div class="pay-form-section">
                    <div class="pay-form-section-title">
                        <svg viewBox="0 0 24 24" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        </svg>
                        بيانات الدفعة
                    </div>
                    <div class="pay-modal-grid">

                        <div class="pay-mfield">
                            <label class="pay-mlabel">العميل <span class="pay-mrequired">*</span></label>
                            <div class="pay-mselect-wrap">
                                <svg class="pay-msel-icon" viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                                <select class="pay-minput pay-msel"
                                        value="@_f.CustomerId"
                                        @onchange="OnCustomerChanged"
                                        aria-required="true">
                                    <option value="0">— اختر عميل —</option>
                                    @foreach (var c in _customers)
                                    {
                                        <option value="@c.Id">@c.Label (@c.Code)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="pay-mfield">
                            <label class="pay-mlabel">تاريخ القبض</label>
                            <div class="pay-mfield-group">
                                <span class="pay-mprefix" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="13" height="13"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="5" width="18" height="16" rx="2"/>
                                        <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <input type="date" class="pay-minput with-prefix"
                                       value="@_f.PaymentDate"
                                       @onchange="e => _f.PaymentDate = e.Value?.ToString()" />
                            </div>
                        </div>

                        <div class="pay-mfield">
                            <label class="pay-mlabel">طريقة الدفع <span class="pay-mrequired">*</span></label>
                            <div class="pay-mselect-wrap">
                                <svg class="pay-msel-icon" viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <rect x="1" y="4" width="22" height="16" rx="2"/>
                                    <path d="M1 10h22"/>
                                </svg>
                                <select class="pay-minput pay-msel"
                                        value="@_f.PaymentMethodId"
                                        @onchange="OnMethodChanged"
                                        aria-required="true">
                                    <option value="0">— اختر الطريقة —</option>
                                    @foreach (var m in _methods)
                                    {
                                        <option value="@m.Id">@m.Label</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="pay-mfield">
                            <label class="pay-mlabel">المبلغ <span class="pay-mrequired">*</span></label>
                            <div class="pay-mfield-group">
                                <span class="pay-mprefix" aria-hidden="true">ج.م</span>
                                <input type="number" min="0.01" step="0.01"
                                       class="pay-minput with-prefix"
                                       value="@_f.Amount"
                                       placeholder="0.00"
                                       @onchange="OnAmountChanged" />
                            </div>
                        </div>

                        @if (NeedCheque)
                        {
                            <div class="pay-mfield">
                                <label class="pay-mlabel">رقم الشيك <span class="pay-mrequired">*</span></label>
                                <div class="pay-mfield-group">
                                    <span class="pay-mprefix" aria-hidden="true">
                                        <svg viewBox="0 0 16 16" width="13" height="13"
                                             fill="none" stroke="currentColor" stroke-width="1.7">
                                            <rect x="2" y="4" width="12" height="9" rx="1"/>
                                            <path d="M5 8h6M5 11h4" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <input class="pay-minput with-prefix"
                                           value="@_f.ChequeNumber"
                                           maxlength="50"
                                           placeholder="رقم الشيك"
                                           dir="ltr"
                                           @onchange="e => _f.ChequeNumber = e.Value?.ToString()" />
                                </div>
                            </div>
                            <div class="pay-mfield">
                                <label class="pay-mlabel">تاريخ الشيك</label>
                                <div class="pay-mfield-group">
                                    <span class="pay-mprefix" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="13" height="13"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="5" width="18" height="16" rx="2"/>
                                            <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <input type="date" class="pay-minput with-prefix"
                                           value="@_f.ChequeDate"
                                           @onchange="e => _f.ChequeDate = e.Value?.ToString()" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pay-mfield">
                                <label class="pay-mlabel">الحساب البنكي / المرجع</label>
                                <input class="pay-minput"
                                       value="@_f.BankAccount"
                                       maxlength="100"
                                       placeholder="رقم الحساب أو المرجع"
                                       @onchange="e => _f.BankAccount = e.Value?.ToString()" />
                            </div>
                        }

                        <div class="pay-mfield pay-mfield-full">
                            <label class="pay-mlabel">ملاحظات</label>
                            <input class="pay-minput"
                                   value="@_f.Notes"
                                   maxlength="500"
                                   placeholder="أي ملاحظات..."
                                   @onchange="e => _f.Notes = e.Value?.ToString()" />
                        </div>

                    </div>
                </div>


                @* ── توزيع على الفواتير ── *@
                @if (_f.CustomerId > 0)
                {
                    <div class="pay-form-section">
                        <div class="pay-alloc-header">
                            <div class="pay-form-section-title">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                </svg>
                                توزيع على الفواتير
                            </div>
                            <div class="pay-alloc-summary">
                                <span class="alloc-left @(Left < 0 ? "left-negative" : Left == 0 ? "left-zero" : "left-positive")">
                                    @if (Left < 0)
                                    {
                                        <span>⚠️ وزّعت أكتر بـ @Money(-Left) ج.م</span>
                                    }
                                    else if (Left == 0)
                                    {
                                        <span>✅ موزّع بالكامل</span>
                                    }
                                    else
                                    {
                                        <span>المتبقي: @Money(Left) ج.م</span>
                                    }
                                </span>
                                <button class="pay-auto-alloc-btn" @onclick="AutoAllocate">
                                    <svg viewBox="0 0 24 24" width="13" height="13"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                        <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    توزيع تلقائي
                                </button>
                            </div>
                        </div>

                        <div class="pay-inv-table-wrap">
                            <table class="pay-inv-table" aria-label="توزيع الدفعة على الفواتير">
                                <thead>
                                    <tr>
                                        <th scope="col" class="th-start">الفاتورة</th>
                                        <th scope="col">التاريخ</th>
                                        <th scope="col">الإجمالي</th>
                                        <th scope="col">المتبقي</th>
                                        <th scope="col" style="width:140px">الموزّع</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!_open.Any())
                                    {
                                        <tr>
                                            <td colspan="5">
                                                <div class="pay-inv-empty">لا توجد فواتير مفتوحة لهذا العميل</div>
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var inv in _open)
                                    {
                                        var allocated = AllocOf(inv.InvoiceId);
                                        <tr class="@(allocated > 0 ? "inv-row-allocated" : "")">
                                            <td class="td-start">
                                                <span class="pay-inv-num">@inv.InvoiceNumber</span>
                                            </td>
                                            <td class="td-muted">@inv.InvoiceDate.ToString("yyyy-MM-dd")</td>
                                            <td class="td-num">@Money(inv.GrandTotal)</td>
                                            <td>
                                                <span class="pay-due-badge">@Money(inv.Due)</span>
                                            </td>
                                            <td>
                                                <div class="pay-alloc-input-wrap">
                                                    <input type="number" min="0" step="0.01"
                                                           class="pay-minput @(allocated > 0 ? "input-allocated" : "")"
                                                           value="@allocated"
                                                           @onchange="e => SetAlloc(inv.InvoiceId, ParseDec(e.Value))" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

            </div>

            <div class="pay-modal-foot">
                <button class="pay-modal-cancel" @onclick="Close">إلغاء</button>
                <button class="pay-modal-save pay-save-green"
                        @onclick="SaveAsync"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <circle cx="12" cy="14" r="2"/>
                        </svg>
                        <span>تسجيل الدفعة</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — تعديل الدفعة
═══════════════════════════════════════════ *@
@if (_patchOpen && CanEdit && _patchTarget is not null)
{
    <div class="pay-modal-backdrop" @onclick="ClosePatch"
         role="dialog" aria-modal="true" aria-label="تعديل الدفعة">
        <div class="pay-modal pay-modal-sm" @onclick:stopPropagation="true">

            <div class="pay-modal-head">
                <div class="pay-modal-icon pay-icon-blue" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                </div>
                <div>
                    <div class="pay-modal-title">تعديل @_patchTarget.PaymentNumber</div>
                    <div class="pay-modal-sub">المبلغ والتوزيع مش بيتعدّلوا — الغِ الدفعة وسجّل جديدة</div>
                </div>
                <button class="pay-modal-close" @onclick="ClosePatch" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="pay-modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button @onclick="() => _msg = null">✕</button>
                </div>
            }

            <div class="pay-modal-body">
                <div class="pay-modal-grid">

                    <div class="pay-mfield">
                        <label class="pay-mlabel">رقم الشيك</label>
                        <div class="pay-mfield-group">
                            <span class="pay-mprefix" aria-hidden="true">
                                <svg viewBox="0 0 16 16" width="13" height="13"
                                     fill="none" stroke="currentColor" stroke-width="1.7">
                                    <rect x="2" y="4" width="12" height="9" rx="1"/>
                                    <path d="M5 8h6M5 11h4" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input class="pay-minput with-prefix"
                                   value="@_patch.ChequeNumber"
                                   maxlength="50"
                                   placeholder="رقم الشيك"
                                   dir="ltr"
                                   @onchange="e => _patch.ChequeNumber = e.Value?.ToString()" />
                        </div>
                    </div>

                    <div class="pay-mfield">
                        <label class="pay-mlabel">تاريخ الشيك</label>
                        <div class="pay-mfield-group">
                            <span class="pay-mprefix" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="13" height="13"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                                    <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input type="date" class="pay-minput with-prefix"
                                   value="@_patch.ChequeDate"
                                   @onchange="e => _patch.ChequeDate = e.Value?.ToString()" />
                        </div>
                    </div>

                    <div class="pay-mfield">
                        <label class="pay-mlabel">الحساب البنكي / المرجع</label>
                        <input class="pay-minput"
                               value="@_patch.BankAccount"
                               maxlength="100"
                               placeholder="رقم الحساب أو المرجع"
                               @onchange="e => _patch.BankAccount = e.Value?.ToString()" />
                    </div>

                    <div class="pay-mfield">
                        <label class="pay-mlabel">ملاحظات</label>
                        <input class="pay-minput"
                               value="@_patch.Notes"
                               maxlength="500"
                               placeholder="أي ملاحظات..."
                               @onchange="e => _patch.Notes = e.Value?.ToString()" />
                    </div>

                </div>
            </div>

            <div class="pay-modal-foot">
                <button class="pay-modal-cancel" @onclick="ClosePatch">إلغاء</button>
                <button class="pay-modal-save pay-save-blue"
                        @onclick="SavePatch"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                            <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    حفظ التعديلات
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — تفاصيل الدفعة
═══════════════════════════════════════════ *@
@if (_detailOpen && _detail is not null)
{
    <div class="pay-modal-backdrop" @onclick="CloseDetail"
         role="dialog" aria-modal="true" aria-label="تفاصيل الدفعة">
        <div class="pay-modal pay-modal-xl" @onclick:stopPropagation="true">

            <div class="pay-modal-head pay-detail-header">
                <div class="pay-modal-icon @DetailIconClass(_detail.Payment.Status)"
                     aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        <circle cx="12" cy="14" r="2"/>
                    </svg>
                </div>
                <div style="flex:1; min-width:0">
                    <div class="pay-modal-title" style="display:flex; align-items:center; gap:8px; flex-wrap:wrap">
                        <span>@_detail.Payment.PaymentNumber</span>
                        <span class="pay-chip @StatusChipClass(_detail.Payment.Status)">
                            <span class="pay-chip-dot @StatusDotClass(_detail.Payment.Status)"
                                  aria-hidden="true"></span>
                            @StatusAr(_detail.Payment.Status)
                        </span>
                    </div>
                    <div class="pay-detail-meta">
                        <span class="detail-meta-tag">👤 @_detail.Payment.CustomerName</span>
                        <span class="detail-meta-tag">💳 @_detail.Payment.MethodName</span>
                        <span class="detail-meta-tag">📅 @_detail.Payment.PaymentDate</span>
                    </div>
                </div>
                <button class="pay-modal-close" @onclick="CloseDetail" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            <div class="pay-modal-body pay-detail-body">

                @* ── Summary Cards ── *@
                <div class="pay-detail-summary">
                    <div class="pay-detail-card">
                        <div class="detail-card-ring ring-amount" aria-hidden="true">💰</div>
                        <div>
                            <div class="detail-card-label">المبلغ الكلي</div>
                            <div class="detail-card-val amount-val">@Money(_detail.Payment.Amount)</div>
                        </div>
                    </div>
                    <div class="pay-detail-card">
                        <div class="detail-card-ring ring-alloc" aria-hidden="true">📑</div>
                        <div>
                            <div class="detail-card-label">الموزّع على فواتير</div>
                            <div class="detail-card-val alloc-val">@Money(_detail.Payment.Allocated)</div>
                        </div>
                    </div>
                    <div class="pay-detail-card @(_detail.Payment.Unallocated > 0 ? "card-unalloc" : "card-settled")">
                        <div class="detail-card-ring @(_detail.Payment.Unallocated > 0 ? "ring-unalloc" : "ring-settled")"
                             aria-hidden="true">
                            @(_detail.Payment.Unallocated > 0 ? "⏳" : "✅")
                        </div>
                        <div>
                            <div class="detail-card-label">الفاضل</div>
                            <div class="detail-card-val @(_detail.Payment.Unallocated > 0 ? "unalloc-val" : "settled-val")">
                                @Money(_detail.Payment.Unallocated)
                            </div>
                        </div>
                    </div>
                </div>

                @* Progress Bar *@
                @{
                    var allocPct = _detail.Payment.Amount > 0
                        ? (double)(_detail.Payment.Allocated / _detail.Payment.Amount * 100)
                        : 0;
                }
                <div class="pay-detail-progress">
                    <div class="pay-det-prog-bar">
                        <div class="pay-det-prog-fill @(_detail.Payment.Unallocated == 0 ? "fill-full" : "fill-partial")"
                             style="width:@Math.Min(allocPct, 100)%">
                        </div>
                    </div>
                    <div class="pay-det-prog-labels">
                        <span>موزّع @Money(_detail.Payment.Allocated) ج.م (@allocPct.ToString("0")%)</span>
                        <span>فاضل @Money(_detail.Payment.Unallocated) ج.م</span>
                    </div>
                </div>

                @* Cheque Notice *@
                @if (_detail.Payment.ChequeNumber is not null)
                {
                    <div class="pay-cheque-notice" role="status">
                        <svg viewBox="0 0 16 16" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="1.8"
                             aria-hidden="true">
                            <rect x="2" y="4" width="12" height="9" rx="1"/>
                            <path d="M5 8h6M5 11h4" stroke-linecap="round"/>
                        </svg>
                        شيك رقم <strong>@_detail.Payment.ChequeNumber</strong>
                        @if (_detail.Payment.ChequeDate is not null)
                        {
                            <span> · استحقاق <strong>@_detail.Payment.ChequeDate</strong></span>
                        }
                    </div>
                }

                @* ── التوزيع ── *@
                <div class="pay-detail-section">
                    <div class="pay-detail-section-head">
                        <span class="pay-det-sec-title">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                            </svg>
                            التوزيع على الفواتير
                        </span>
                        <span class="pay-det-sec-count">@_detail.Allocations.Count</span>
                    </div>

                    @if (!_detail.Allocations.Any())
                    {
                        <div class="pay-detail-empty">الدفعة دي مش موزّعة على فواتير لسه</div>
                    }
                    else
                    {
                        <div class="pay-alloc-detail-list">
                            @foreach (var a in _detail.Allocations)
                            {
                                var coveredPct = a.InvoiceTotal > 0
                                    ? (double)(a.InvoicePaid / a.InvoiceTotal * 100)
                                    : 0;
                                <div class="pay-alloc-detail-row">
                                    <div class="pay-alloc-inv-num">@a.InvoiceNumber</div>
                                    <div class="pay-alloc-inv-info">
                                        <div class="pay-alloc-prog">
                                            <div class="pay-alloc-prog-bar">
                                                <div class="pay-alloc-prog-fill"
                                                     style="width:@Math.Min(coveredPct, 100)%"></div>
                                            </div>
                                            <span class="pay-alloc-pct">@coveredPct.ToString("0")%</span>
                                        </div>
                                        <div class="pay-alloc-nums-row">
                                            <span>إجمالي @Money(a.InvoiceTotal)</span>
                                            <span>مدفوع @Money(a.InvoicePaid)</span>
                                        </div>
                                    </div>
                                    <div class="pay-alloc-this-pay">
                                        <span class="alloc-this-label">من الدفعة دي</span>
                                        <strong>@Money(a.AllocatedAmount) ج.م</strong>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Notes *@
                @if (_detail.Payment.Notes is not null)
                {
                    <div class="pay-detail-section">
                        <div class="pay-detail-section-head">
                            <span class="pay-det-sec-title">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                                ملاحظات
                            </span>
                        </div>
                        <div class="pay-detail-notes">@_detail.Payment.Notes</div>
                    </div>
                }

            </div>

            <div class="pay-modal-foot">
                <button class="pay-modal-cancel" @onclick="CloseDetail">إغلاق</button>
            </div>

        </div>
    </div>
}


<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-teal:      #0d9488;
        --fc-teal-lt:   #e6faf8;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       BODY
    ================================================================ */
    .pay-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1350px; width: 100%;
        margin: 0 auto;
    }

    /* States */
    .pay-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .pay-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .pay-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .pay-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .pay-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* Card */
    .pay-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    /* Toolbar */
    .pay-toolbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7; flex-wrap: wrap;
    }

    .pay-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px; max-width: 420px;
    }
    .pay-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }
    .pay-search-input {
        width: 100%; height: 38px; padding: 0 36px 0 12px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .pay-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .pay-search-input::placeholder { color: #b0bcc8; }
    .pay-search-clear {
        position: absolute; left: 10px;
        display: flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        border: none; background: #edf1f7; color: #8899ae; cursor: pointer;
    }

    .pay-results-badge {
        display: flex; align-items: center; gap: 5px;
        margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap;
    }
    .pay-results-badge strong { color: #5a6e88; }

    /* Status Tabs */
    .pay-status-bar { padding: 10px 18px; background: #f9fafd; border-bottom: 1px solid #edf1f7; overflow-x: auto; }
    .pay-status-tabs { display: flex; gap: 4px; padding: 3px; border-radius: 10px; background: #f0f3f8; width: fit-content; }
    .pay-status-tab {
        display: flex; align-items: center; gap: 5px;
        height: 32px; padding: 0 10px;
        border: none; border-radius: 7px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 10.5px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .pay-status-tab:hover:not(.active) { color: var(--fc-text); background: rgba(255,255,255,.6); }
    .pay-status-tab.active { background: var(--fc-card); color: var(--fc-text); box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800; }
    .pay-tab-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 7px; }
    .pay-tab-count {
        min-width: 16px; height: 16px; border-radius: 4px; padding: 0 3px;
        display: flex; align-items: center; justify-content: center;
        font-size: 9px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
    }
    .pay-status-tab.active .pay-tab-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .pay-status-tab:not(.active) .pay-tab-count { background: #e4eaf3; color: #8899ae; }

    .tdot-all       { background: var(--fc-blue); }
    .tdot-posted    { background: var(--fc-green); }
    .tdot-cancelled { background: var(--fc-red); }
    .tdot-returned  { background: var(--fc-amber); }

    /* Loading / Empty */
    .pay-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 200px; color: var(--fc-muted); font-size: 12px; font-weight: 600; }
    .pay-spinner { width: 32px; height: 32px; border: 3px solid #dde5f0; border-top-color: var(--fc-blue); border-radius: 50%; animation: pay-spin .75s linear infinite; }
    @@keyframes pay-spin { to { transform: rotate(360deg); } }

    .pay-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 240px; padding: 40px; text-align: center; }
    .pay-empty-icon { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f4fa; color: #b0c4d8; }
    .pay-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .pay-empty-sub   { font-size: 12px; color: var(--fc-muted); }
    .pay-add-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; margin-top: 6px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer; transition: all .15s ease;
    }
    .pay-add-btn:hover { background: var(--fc-blue); color: #fff; }

    /* Table */
    .pay-table-wrap { overflow-x: auto; }
    .pay-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
