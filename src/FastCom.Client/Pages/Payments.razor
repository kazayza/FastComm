@code {
    /* ══════════════════════════════════════
       DTO CLASSES (Top-level clean)
    ══════════════════════════════════════ */
    public class Cust
    {
        public int    Id    { get; set; }
        public string Label { get; set; } = "";
        public string Code  { get; set; } = "";
    }

    public class Method
    {
        public int    Id               { get; set; }
        public string Label            { get; set; } = "";
        public string Code             { get; set; } = "";
        public bool   RequiresChequeNo { get; set; }
        public bool   IsCashBased      { get; set; }
    }

    public class OpenInv
    {
        public long     InvoiceId     { get; set; }
        public string   InvoiceNumber { get; set; } = "";
        public DateOnly InvoiceDate   { get; set; }
        public decimal  GrandTotal    { get; set; }
        public decimal  PaidAmount    { get; set; }
        public decimal  Due           { get; set; }
    }

    public class Item
    {
        public long     PaymentId        { get; set; }
        public string   PaymentNumber    { get; set; } = "";
        public DateOnly PaymentDate      { get; set; }
        public string   CustomerName     { get; set; } = "";
        public string   MethodName       { get; set; } = "";
        public decimal  Amount           { get; set; }
        public decimal  Allocated        { get; set; }
        public decimal  Unallocated      { get; set; }
        public string   Status           { get; set; } = "";
        public string?  ChequeNumber     { get; set; }
        public int      AllocationsCount { get; set; }
    }

    public class Detail
    {
        public long    PaymentId       { get; set; }
        public string  PaymentNumber   { get; set; } = "";
        public string? PaymentDate     { get; set; }
        public int     CustomerId      { get; set; }
        public string  CustomerName    { get; set; } = "";
        public int     PaymentMethodId { get; set; }
        public string  MethodName      { get; set; } = "";
        public decimal Amount          { get; set; }
        public string? ChequeNumber    { get; set; }
        public string? ChequeDate      { get; set; }
        public string? BankAccount     { get; set; }
        public string? Notes           { get; set; }
        public string  Status          { get; set; } = "";
        public decimal Allocated       { get; set; }
        public decimal Unallocated     { get; set; }
    }

    public class AllocOut
    {
        public long    PaymentAllocationId { get; set; }
        public long    InvoiceId           { get; set; }
        public string  InvoiceNumber       { get; set; } = "";
        public decimal AllocatedAmount     { get; set; }
        public decimal InvoiceTotal        { get; set; }
        public decimal InvoicePaid         { get; set; }
    }

    public class Envelope
    {
        public Detail         Payment     { get; set; } = new();
        public List<AllocOut> Allocations { get; set; } = new();
    }

    public class Form
    {
        public int     CustomerId      { get; set; }
        public string? PaymentDate     { get; set; }
        public int     PaymentMethodId { get; set; }
        public decimal Amount          { get; set; }
        public string? ChequeNumber    { get; set; }
        public string? ChequeDate      { get; set; }
        public string? BankAccount     { get; set; }
        public string? Notes           { get; set; }
    }

    public class PatchForm
    {
        public string? ChequeNumber { get; set; }
        public string? ChequeDate   { get; set; }
        public string? BankAccount  { get; set; }
        public string? Notes        { get; set; }
    }

    /* ══════════════════════════════════════
       STATE & FIELDS
    ══════════════════════════════════════ */
    private AuthUser? _user;
    private bool CanView   => _user?.Can("PAYMENT.VIEW")   ?? false;
    private bool CanCreate => _user?.Can("PAYMENT.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("PAYMENT.EDIT")   ?? false;
    private bool CanVoid   => _user?.Can("PAYMENT.VOID")   ?? false;

    private static readonly (string Key, string Value)[] _statusTabs =
    {
        ("all",       "الكل"),
        ("Posted",    "مسجّلة"),
        ("Cancelled", "ملغاة"),
        ("Returned",  "مرتجعة")
    };

    private List<Item>    _items             = new();
    private List<Cust>    _customers         = new();
    private List<Cust>    _filteredCustomers = new();
    private List<Method>  _methods           = new();
    private List<OpenInv> _open              = new();

    private bool   _loading;
    private string _search    = "";
    private string _tab       = "all";
    private string _kpiFilter = "";
    private long?  _confirmId;
    private bool   _saving;
    private bool   _fabOpen;
    private string? _msg;
    private bool   _ok;

    private bool                      _modalOpen;
    private Form                      _f     = new();
    private Dictionary<long, decimal> _alloc = new();

    private string _customerSearch       = "";
    private bool   _showCustomerDropdown;
    private int    _focusedCustomerIndex = -1;
    private int    _activeTab            = 0;
    private bool   _triedSave;

    private bool      _patchOpen;
    private Item?     _patchTarget;
    private PatchForm _patch = new();

    private bool      _detailOpen;
    private Envelope? _detail;

    /* ══════════════════════════════════════
       COMPUTED PROPERTIES
    ══════════════════════════════════════ */
    private bool NeedCheque => _methods.FirstOrDefault(m => m.Id == _f.PaymentMethodId)?.RequiresChequeNo == true;

    private IEnumerable<Item> Posted => _items.Where(p => p.Status == "Posted");
    private decimal Unallocated => Posted.Sum(p => p.Unallocated);
    private decimal ThisMonth   => Posted
        .Where(p => p.PaymentDate.Year == DateTime.Now.Year && p.PaymentDate.Month == DateTime.Now.Month)
        .Sum(p => p.Amount);

    private decimal AllocTotal => _alloc.Values.Sum();
    private decimal Left       => _f.Amount - AllocTotal;

    private decimal AllocOf(long invoiceId) =>
        _alloc.TryGetValue(invoiceId, out var v) ? v : 0m;

    private void SetAlloc(long invoiceId, decimal v)
    {
        if (v <= 0) _alloc.Remove(invoiceId);
        else _alloc[invoiceId] = v;
    }

    private void AutoAllocate()
    {
        _alloc = new Dictionary<long, decimal>();
        var left = _f.Amount;
        foreach (var inv in _open.OrderBy(i => i.InvoiceDate).ThenBy(i => i.InvoiceId))
        {
            if (left <= 0) break;
            var take = Math.Min(inv.Due, left);
            if (take <= 0) continue;
            _alloc[inv.InvoiceId] = take;
            left -= take;
        }
    }

    /* ══════════════════════════════════════
       AUTOCOMPLETE SEARCH
    ══════════════════════════════════════ */
    private void OnCustomerSearch(ChangeEventArgs e)
    {
        _customerSearch = e.Value?.ToString() ?? "";
        _showCustomerDropdown = true;
        _focusedCustomerIndex = -1;
        FilterCustomers(_customerSearch);
    }

    private void FilterCustomers(string search)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            _filteredCustomers = _customers.Take(20).ToList();
            return;
        }

        var normalized = NormalizeArabic(search.Trim());
        _filteredCustomers = _customers
            .Where(c => NormalizeArabic(c.Label).Contains(normalized) ||
                        NormalizeArabic(c.Code).Contains(normalized))
            .Take(20)
            .ToList();
    }

    private void OnCustomerInputKeyDown(KeyboardEventArgs e)
    {
        if (!_showCustomerDropdown || !_filteredCustomers.Any())
        {
            if (e.Key == "ArrowDown") _showCustomerDropdown = true;
            return;
        }

        if (e.Key == "ArrowDown")
            _focusedCustomerIndex = (_focusedCustomerIndex + 1) % _filteredCustomers.Count;
        else if (e.Key == "ArrowUp")
            _focusedCustomerIndex = _focusedCustomerIndex <= 0 ? _filteredCustomers.Count - 1 : _focusedCustomerIndex - 1;
        else if (e.Key == "Enter")
        {
            if (_focusedCustomerIndex >= 0 && _focusedCustomerIndex < _filteredCustomers.Count)
                PickCustomer(_filteredCustomers[_focusedCustomerIndex]);
        }
        else if (e.Key == "Escape")
        {
            _showCustomerDropdown = false;
            _focusedCustomerIndex = -1;
        }
    }

    private void OnCustomerInputFocus()
    {
        _showCustomerDropdown = true;
        _focusedCustomerIndex = -1;
        FilterCustomers(_customerSearch);
    }

    private async Task OnCustomerInputBlur()
    {
        await Task.Delay(250);
        _showCustomerDropdown = false;

        if (_f.CustomerId > 0)
        {
            var current = _customers.FirstOrDefault(c => c.Id == _f.CustomerId);
            if (current != null) _customerSearch = current.Label;
        }
        else
        {
            _customerSearch = "";
        }
    }

    private void PickCustomer(Cust c)
    {
        _f.CustomerId = c.Id;
        _customerSearch = c.Label;
        _showCustomerDropdown = false;
        _focusedCustomerIndex = -1;
        _alloc = new Dictionary<long, decimal>();
        _ = LoadOpenInvoicesAsync();
        StateHasChanged();
    }

    private async Task LoadOpenInvoicesAsync()
    {
        if (_f.CustomerId <= 0) return;
        _open = await SafeGetT<OpenInv>($"api/payments/open-invoices?customerId={_f.CustomerId}");
        AutoAllocate();
        StateHasChanged();
    }

    private void ClearCustomerSelection()
    {
        _f.CustomerId = 0;
        _customerSearch = "";
        _focusedCustomerIndex = -1;
        _filteredCustomers = _customers.Take(20).ToList();
        _alloc = new Dictionary<long, decimal>();
        _open = new List<OpenInv>();
    }

    private static string NormalizeArabic(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;

        string[] diacritics = new[] { "َ", "ُ", "ِ", "ّ", "ً", "ٌ", "ٍ", "ْ", "ـ" };
        foreach (var d in diacritics)
            s = s.Replace(d, "");

        return s
            .Replace('أ', 'ا').Replace('إ', 'ا').Replace('آ', 'ا').Replace('ٱ', 'ا').Replace('ء', 'ا')
            .Replace('ة', 'ه')
            .Replace('ى', 'ي')
            .Replace('ؤ', 'و')
            .Replace('ئ', 'ي')
            .Replace("  ", " ")
            .ToLowerInvariant()
            .Trim();
    }

    /* ══════════════════════════════════════
       HELPERS
    ══════════════════════════════════════ */
    private static string StatusAr(string s) => s switch
    {
        "Posted"    => "مسجّلة",
        "Cancelled" => "ملغاة",
        "Returned"  => "مرتجعة",
        _           => s
    };

    private static string StatusChipClass(string s) => s switch
    {
        "Posted"    => "chip-posted",
        "Cancelled" => "chip-cancelled",
        "Returned"  => "chip-returned",
        _           => "chip-posted"
    };

    private static string StatusDotClass(string s) => s switch
    {
        "Posted"    => "dot-green",
        "Cancelled" => "dot-red",
        "Returned"  => "sdot-returned",
        _           => "dot-green"
    };

    private static string StatusDotColor(string s) => s switch
    {
        "all"       => "tdot-all",
        "Posted"    => "tdot-posted",
        "Cancelled" => "tdot-cancelled",
        "Returned"  => "tdot-returned",
        _           => "tdot-all"
    };

    private static string AvatarClass(string s) => s switch
    {
        "Posted"    => "av-posted",
        "Cancelled" => "av-cancelled",
        "Returned"  => "av-returned",
        _           => "av-posted"
    };

    private static string Money(decimal v)     => v.ToString("N2");
    private static decimal ParseDec(object? v) => decimal.TryParse(v?.ToString(), out var n) ? n : 0m;
    private static int ParseInt(object? v)     => int.TryParse(v?.ToString(), out var n) ? n : 0;

    private IEnumerable<Item> Filtered => _items.Where(p =>
        (_tab == "all" || p.Status == _tab) &&
        (_kpiFilter switch
        {
            "ThisMonth"   => p.PaymentDate.Year == DateTime.Now.Year && p.PaymentDate.Month == DateTime.Now.Month,
            "Unallocated" => p.Unallocated > 0 && p.Status == "Posted",
            "Cancelled"   => p.Status == "Cancelled",
            _             => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         NormalizeArabic(p.PaymentNumber).Contains(NormalizeArabic(_search)) ||
         NormalizeArabic(p.CustomerName).Contains(NormalizeArabic(_search)) ||
         NormalizeArabic(p.ChequeNumber ?? "").Contains(NormalizeArabic(_search))));

    private void SetKpiFilter(string filter)
    {
        _kpiFilter = _kpiFilter == filter ? "" : filter;
        _confirmId = null;
    }

    private void ToggleFab() => _fabOpen = !_fabOpen;

    /* ══════════════════════════════════════
       INITIALIZATION & API CALLS
    ══════════════════════════════════════ */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        await LoadAsync();
        _customers = await SafeGetT<Cust>("api/payments/customers");
        _methods   = await SafeGetT<Method>("api/options/payment-methods");
    }

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await Http.GetFromJsonAsync<List<Item>>("api/payments?take=300") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /* ══════════════════════════════════════
       MODAL ACTIONS
    ══════════════════════════════════════ */
    private void New()
    {
        _f = new Form { PaymentDate = DateTime.Now.ToString("yyyy-MM-dd") };
        _alloc = new();
        _open = new();
        _customerSearch = "";
        _msg = null;
        _modalOpen = true;
        _triedSave = false;
        _activeTab = 0;
    }

    private void Close() { _modalOpen = false; _msg = null; }

    private void OnMethodChanged(ChangeEventArgs e)
    {
        _f.PaymentMethodId = ParseInt(e.Value);
        if (!NeedCheque) { _f.ChequeNumber = null; _f.ChequeDate = null; }
    }

    private void OnAmountChanged(ChangeEventArgs e)
    {
        _f.Amount = ParseDec(e.Value);
        AutoAllocate();
    }

    private async Task SaveAsync()
    {
        _triedSave = true;
        _msg = null;

        if (_f.CustomerId <= 0)      { _ok = false; _msg = "يرجى اختيار العميل أولاً"; _activeTab = 0; return; }
        if (_f.PaymentMethodId <= 0) { _ok = false; _msg = "يرجى تحديد طريقة الدفع"; _activeTab = 0; return; }
        if (_f.Amount <= 0)          { _ok = false; _msg = "يرجى إدخال مبلغ صحيح أكبر من صفر"; _activeTab = 0; return; }
        if (Left < 0)                { _ok = false; _msg = $"الموزّع أكبر من مبلغ الدفعة الكلي بـ {(-Left):N2} ج.م"; _activeTab = 1; return; }

        _saving = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/payments", new
            {
                customerId      = _f.CustomerId,
                paymentDate     = _f.PaymentDate,
                paymentMethodId = _f.PaymentMethodId,
                amount          = _f.Amount,
                chequeNumber    = _f.ChequeNumber,
                chequeDate      = _f.ChequeDate,
                bankAccount     = _f.BankAccount,
                notes           = _f.Notes,
                allocations     = _alloc.Select(a => new { invoiceId = a.Key, amount = a.Value }).ToList()
            });
            _msg = await MsgOf(res);
            _ok  = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                Close();
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _ok  = false;
            _msg = "تعذر تسجيل السند: " + ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Edit(Item p)
    {
        try
        {
            var e = await Http.GetFromJsonAsync<Envelope>($"api/payments/{p.PaymentId}");
            if (e is null) return;
            _patchTarget = p;
            _patch = new PatchForm
            {
                ChequeNumber = e.Payment.ChequeNumber,
                ChequeDate   = e.Payment.ChequeDate,
                BankAccount  = e.Payment.BankAccount,
                Notes        = e.Payment.Notes
            };
            _msg       = null;
            _patchOpen = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add("تعذر جلب البيانات: " + ex.Message, Severity.Error);
        }
    }

    private void ClosePatch() { _patchOpen = false; _patchTarget = null; _msg = null; }

    private async Task SavePatch()
    {
        if (_patchTarget is null) return;
        _saving = true;
        _msg    = null;
        try
        {
            var res = await Http.PutAsJsonAsync($"api/payments/{_patchTarget.PaymentId}", new
            {
                chequeNumber = _patch.ChequeNumber,
                chequeDate   = _patch.ChequeDate,
                bankAccount  = _patch.BankAccount,
                notes        = _patch.Notes
            });
            _msg = await MsgOf(res);
            _ok  = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                ClosePatch();
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _ok  = false;
            _msg = "تعذر الحفظ: " + ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Open(Item p)
    {
        try
        {
            _detail = await Http.GetFromJsonAsync<Envelope>($"api/payments/{p.PaymentId}");
            if (_detail is null) return;
            _msg        = null;
            _detailOpen = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add("تعذر تحميل التفاصيل: " + ex.Message, Severity.Error);
        }
    }

    private void CloseDetail() { _detailOpen = false; }

    private async Task Void(Item p)
    {
        try
        {
            var res = await Http.PostAsync($"api/payments/{p.PaymentId}/void", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode)
            {
                _detailOpen = false;
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("تعذر إلغاء الدفعة: " + ex.Message, Severity.Error);
        }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch
        {
            return res.IsSuccessStatusCode ? "تم الحفظ بنجاح" : $"حدث خطأ مالي تعذر بعده الحفظ {(int)res.StatusCode}";
        }
    }
}