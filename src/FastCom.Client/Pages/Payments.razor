@page "/payments"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>تحصيل دفعات العملاء — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="pay-hero-row">
                <div class="pay-hero-left">
                    <div class="pay-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <circle cx="12" cy="14" r="2"/>
                        </svg>
                        <span>المالية · تحصيل العملاء</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">تحصيل دفعات العملاء</h1>
                    <span class="pay-hero-sub">إدارة وتسجيل المقبوضات النقدية والبنكية — تسوية وتوزيع الدفعات على فواتير المبيعات المفتوحة</span>
                </div>

                <div class="pay-hero-right">
                    <button type="button" class="pay-hero-refresh" @onclick="Reload" title="تحديث البيانات">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 4v6h-6"/>
                            <path d="M1 20v-6h6"/>
                            <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                        </svg>
                    </button>
                    @if (CanCreate)
                    {
                        <button type="button" class="pay-hero-add" @onclick="New">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            دفعة تحصيل جديدة
                        </button>
                    }
                    <span class="pay-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

            @* ── KPI Connected Glass Strip (Click to Filter) ── *@
            @if (CanView && !_loading)
            {
                <div class="pay-kpis-strip">

                    <div class="pay-kpi-item @(_kpiFilter == "" ? "kpi-active" : "")" @onclick='() => SetKpiFilter("")' role="button" tabindex="0" title="عرض جميع المقبوضات">
                        <div class="pay-kpi-icon kpi-blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="7" width="20" height="14" rx="2"/>
                                <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                <circle cx="12" cy="14" r="2"/>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">إجمالي المحصّل</div>
                            <div class="pay-kpi-val">@Money(Posted.Sum(p => p.Amount)) <small>ج.م</small></div>
                        </div>
                    </div>

                    <div class="pay-kpi-div" aria-hidden="true"></div>

                    <div class="pay-kpi-item @(_kpiFilter == "ThisMonth" ? "kpi-active" : "")" @onclick='() => SetKpiFilter("ThisMonth")' role="button" tabindex="0" title="مقبوضات الشهر الحالي">
                        <div class="pay-kpi-icon kpi-green">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">تحصيل الشهر الجاري</div>
                            <div class="pay-kpi-val kpi-val-green">@Money(ThisMonth) <small>ج.م</small></div>
                        </div>
                    </div>

                    <div class="pay-kpi-div" aria-hidden="true"></div>

                    <div class="pay-kpi-item @(_kpiFilter == "Unallocated" ? "kpi-active" : "")" @onclick='() => SetKpiFilter("Unallocated")' role="button" tabindex="0" title="المبالغ المعلقة غير الموزعة">
                        <div class="pay-kpi-icon kpi-amber">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="16" x2="12" y2="12"/>
                                <line x1="12" y1="8" x2="12.01" y2="8"/>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">مبالغ معلقة غير موزعة</div>
                            <div class="pay-kpi-val kpi-val-amber">@Money(Unallocated) <small>ج.م</small></div>
                        </div>
                    </div>

                    <div class="pay-kpi-div" aria-hidden="true"></div>

                    <div class="pay-kpi-item @(_kpiFilter == "Cancelled" ? "kpi-active" : "")" @onclick='() => SetKpiFilter("Cancelled")' role="button" tabindex="0" title="السندات الملغاة">
                        <div class="pay-kpi-icon kpi-red">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">السندات الملغاة</div>
                            <div class="pay-kpi-val kpi-val-red">@_items.Count(p => p.Status == "Cancelled")</div>
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="pay-body">

    @if (!CanView)
    {
        <div class="pay-state-box">
            <div class="pay-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليست لديك الصلاحية الأمنية الكافية لعرض سجلات مقبوضات العملاء.</p>
        </div>
    }
    else
    {
        <div class="pay-card">

            @* ── Toolbar ── *@
            <div class="pay-toolbar">

                <div class="pay-search-wrap">
                    <svg class="pay-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="pay-search-input"
                           placeholder="بحث برقم السند، اسم العميل، أو رقم الشيك..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="البحث في المقبوضات" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button type="button" class="pay-search-clear" @onclick="() => _search = string.Empty" title="مسح البحث">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="pay-results-badge">
                    <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="8" cy="8" r="6"/>
                        <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                    </svg>
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong> سند
                </div>

            </div>


            @* ── Status Tabs ── *@
            <div class="pay-status-bar">
                <div class="pay-status-tabs" role="group" aria-label="تصفية حسب الحالة المنهجية">
                    @foreach (var t in _statusTabs)
                    {
                        var cnt = t.Key == "all"
                            ? _items.Count
                            : _items.Count(x => x.Status == t.Key);

                        <button type="button" class="pay-status-tab @(_tab == t.Key ? "active" : "")"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="pay-tab-dot @StatusDotColor(t.Key)" aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="pay-tab-count">@cnt</span>
                        </button>
                    }
                </div>
            </div>


            @* ── Table Content ── *@
            @if (_loading)
            {
                <div class="pay-loading">
                    <div class="pay-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل سجلات مقبوضات العملاء...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="pay-empty">
                    <div class="pay-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <circle cx="12" cy="14" r="2"/>
                        </svg>
                    </div>
                    <div class="pay-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) ? "لا توجد سندات تحصيل مقيدة" : "لا توجد نتائج مطابقة لمعايير البحث")
                    </div>
                    <div class="pay-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search) ? "ابدأ بتسجيل أول دفعة تحصيل للعملاء لتسوية الفواتير المستحقة" : "جرّب تغيير معايير البحث والتصفية")
                    </div>
                </div>
            }
            else
            {
                <div class="pay-table-wrap">
                    <table class="pay-table" aria-label="قائمة مقبوضات العملاء">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">بيانات السند</th>
                                <th scope="col">تاريخ المعاملة</th>
                                <th scope="col">طريقة الدفع</th>
                                <th scope="col">المبلغ المحصل</th>
                                <th scope="col">التسوية والتوزيع</th>
                                <th scope="col">الحالة</th>
                                <th scope="col" style="width:130px">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Filtered)
                            {
                                <tr class="@(p.Status == "Cancelled" ? "row-cancelled" : "")">

                                    <td class="td-start">
                                        <div class="pay-pay-cell">
                                            <div class="pay-avatar @AvatarClass(p.Status)" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                    <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                                    <circle cx="12" cy="14" r="2"/>
                                                </svg>
                                            </div>
                                            <div class="pay-pay-info">
                                                <button type="button" class="pay-code-btn" @onclick="() => Open(p)">
                                                    @p.PaymentNumber
                                                </button>
                                                <div class="pay-customer-name">@p.CustomerName</div>
                                                @if (p.ChequeNumber is not null)
                                                {
                                                    <div class="pay-cheque-tag">
                                                        <svg viewBox="0 0 16 16" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                            <rect x="2" y="4" width="12" height="9" rx="1"/>
                                                            <path d="M5 8h6M5 11h4" stroke-linecap="round"/>
                                                        </svg>
                                                        شيك رقم: @p.ChequeNumber
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="pay-date-cell">
                                            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                                <rect x="2" y="3" width="12" height="11" rx="2"/>
                                                <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                                            </svg>
                                            @p.PaymentDate.ToString("yyyy-MM-dd")
                                        </div>
                                    </td>

                                    <td>
                                        <span class="pay-method-tag">@p.MethodName</span>
                                    </td>

                                    <td>
                                        <div class="pay-amounts-cell">
                                            <div class="pay-amount-main">@Money(p.Amount) <small>ج.م</small></div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="pay-alloc-cell">
                                            @if (p.AllocationsCount > 0)
                                            {
                                                <div class="pay-alloc-bar-wrap">
                                                    @{
                                                        var allocPercent = p.Amount > 0
                                                            ? (double)(p.Allocated / p.Amount * 100)
                                                            : 0;
                                                    }
                                                    <div class="pay-alloc-bar" title="تم تسوية: @allocPercent.ToString("0")%">
                                                        <div class="pay-alloc-fill @(p.Unallocated == 0 ? "fill-full" : "fill-partial")"
                                                             style="width:@Math.Min(allocPercent, 100)%"></div>
                                                    </div>
                                                    <div class="pay-alloc-nums">
                                                        <span class="alloc-inv-count">تسوية @p.AllocationsCount فاتورة</span>
                                                        @if (p.Unallocated > 0)
                                                        {
                                                            <span class="alloc-remaining">متبقي غير موزع: @Money(p.Unallocated)</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="pay-unalloc-badge">معلق بالكامل</span>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <span class="pay-chip @StatusChipClass(p.Status)">
                                            <span class="pay-chip-dot @StatusDotClass(p.Status)" aria-hidden="true"></span>
                                            @StatusAr(p.Status)
                                        </span>
                                    </td>

                                    <td>
                                        <div class="pay-actions">

                                            <button type="button" class="pay-act-btn act-info" @onclick="() => Open(p)" title="عرض التفاصيل">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                                </svg>
                                            </button>

                                            @if (p.Status == "Posted" && CanEdit)
                                            {
                                                <button type="button" class="pay-act-btn act-edit" @onclick="() => Edit(p)" title="تعديل الشيك والملاحظات">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                            }

                                            @if (p.Status == "Posted" && CanVoid)
                                            {
                                                @if (_confirmId == p.PaymentId)
                                                {
                                                    <button type="button" class="pay-confirm-void" @onclick="() => Void(p)">
                                                        تأكيد الإلغاء؟
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="pay-act-btn act-void" @onclick="() => _confirmId = p.PaymentId" title="إلغاء السند وعكس القيود">
                                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"/>
                                                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                                        </svg>
                                                    </button>
                                                }
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   MODAL 1 — تسجيل دفعة جديدة (معيار svc-modal)
═══════════════════════════════════════════ *@
@if (_modalOpen && CanCreate)
{
    <div class="svc-modal-backdrop" @onclick="Close" role="dialog" aria-modal="true">
        <div class="svc-modal" @onclick:stopPropagation="true">

            <div class="svc-modal-head">
                <div class="svc-head-icon svc-icon-create" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        <path d="M12 12v4M10 14h4" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">تسجيل دفعة سداد جديدة للعميل</div>
                    <div class="svc-head-sub">
                        @if (_f.Amount > 0)
                        {
                            <span>القيمة المحررة الحالية: <strong>@Money(_f.Amount) ج.م</strong></span>
                        }
                        else
                        {
                            <span>حدد العميل وطريقة الدفع وقيمة السند لبدء التسوية</span>
                        }
                    </div>
                </div>
                <button class="svc-head-close" @onclick="Close" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="svc-banner @(_ok ? "svc-banner-ok" : "svc-banner-err")" role="alert">
                    <div class="svc-banner-ic" aria-hidden="true">
                        @if (_ok)
                        {
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                            </svg>
                        }
                    </div>
                    <span class="svc-banner-msg">@_msg</span>
                    <button class="svc-banner-x" @onclick="() => _msg = null" type="button">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }

            <div class="svc-modal-body">
                <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                         PanelClass="svc-tab-panel" @bind-ActivePanelIndex="_activeTab"
                         Class="svc-mud-tabs">

                    @* TAB 1: البيانات المالية *@
                    <MudTabPanel>
                        <TabContent>
                            <div class="svc-tab-label">
                                <div class="svc-tab-ic svc-tab-ic-blue">
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                    </svg>
                                </div>
                                <span>بيانات السند المالي</span>
                                @if (_triedSave && (_f.CustomerId == 0 || _f.PaymentMethodId == 0 || _f.Amount <= 0))
                                {
                                    <span class="svc-tab-err"></span>
                                }
                            </div>
                        </TabContent>
                        <ChildContent>
                            <div class="svc-section">
                                <div class="svc-section-head">
                                    <div class="svc-section-ic blue">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="svc-section-title">بيانات الدفعة والمقاصة النقدية</div>
                                        <div class="svc-section-sub">تحديد العميل، وعاء التحصيل، وقيمة النقدية المستلمة</div>
                                    </div>
                                </div>

                                <div class="svc-grid">
                                    
                                    @* العميل — بحث ذكي *@
                                    <div class="svc-field">
                                        <label class="svc-label">العميل المسدد <span class="svc-req">*</span></label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="11" cy="11" r="8"/>
                                                    <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input class="svc-input with-prefix @(_triedSave && _f.CustomerId == 0 ? "svc-err" : "")"
                                                   value="@_customerSearch"
                                                   placeholder="ابحث باسم العميل..."
                                                   @oninput="OnCustomerSearch"
                                                   @onkeydown="OnCustomerInputKeyDown"
                                                   @onfocus="OnCustomerInputFocus"
                                                   @onblur="OnCustomerInputBlur"
                                                   autocomplete="off" />
                                            @if (!string.IsNullOrEmpty(_customerSearch))
                                            {
                                                <button type="button" class="field-clear-btn" @onclick="ClearCustomerSelection" title="مسح">✕</button>
                                            }
                                        </div>
                                        @if (_showCustomerDropdown && _filteredCustomers.Count > 0)
                                        {
                                            <div class="field-dropdown">
                                                @for (int i = 0; i < _filteredCustomers.Count; i++)
                                                {
                                                    var c = _filteredCustomers[i];
                                                    <div class="field-dropdown-item @(i == _focusedCustomerIndex ? "is-focused" : "")"
                                                         @onmousedown="() => PickCustomer(c)">
                                                        <span>@c.Label (@c.Code)</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @if (_triedSave && _f.CustomerId == 0)
                                        {
                                            <div class="svc-err-msg">يرجى تحديد العميل المستهدف</div>
                                        }
                                    </div>

                                    @* تاريخ الدفع *@
                                    <div class="svc-field">
                                        <label class="svc-label">تاريخ التحصيل</label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                    <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input type="date" class="svc-input with-prefix"
                                                   value="@_f.PaymentDate"
                                                   @onchange="e => _f.PaymentDate = e.Value?.ToString()" />
                                        </div>
                                    </div>

                                    @* طريقة الدفع *@
                                    <div class="svc-field">
                                        <label class="svc-label">طريقة الدفع <span class="svc-req">*</span></label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="1" y="4" width="22" height="16" rx="2"/>
                                                    <path d="M1 10h22"/>
                                                </svg>
                                            </span>
                                            <select class="svc-input svc-select with-prefix @(_triedSave && _f.PaymentMethodId == 0 ? "svc-err" : "")"
                                                    value="@_f.PaymentMethodId"
                                                    @onchange="OnMethodChanged">
                                                <option value="0">— اختر طريقة الدفع —</option>
                                                @foreach (var m in _methods)
                                                {
                                                    <option value="@m.Id">@m.Label</option>
                                                }
                                            </select>
                                        </div>
                                        @if (_triedSave && _f.PaymentMethodId == 0)
                                        {
                                            <div class="svc-err-msg">تحديد الطريقة المالية إلزامي</div>
                                        }
                                    </div>

                                    @* المبلغ *@
                                    <div class="svc-field">
                                        <label class="svc-label">القيمة المحصّلة <span class="svc-req">*</span></label>
                                        <div class="svc-input-wrap">
                                            <span class="svc-prefix txt">ج.م</span>
                                            <input type="number" min="0.01" step="0.01"
                                                   class="svc-input ltr with-prefix @(_triedSave && _f.Amount <= 0 ? "svc-err" : "")"
                                                   value="@_f.Amount"
                                                   placeholder="0.00"
                                                   @onchange="OnAmountChanged" />
                                        </div>
                                        @if (_triedSave && _f.Amount <= 0)
                                        {
                                            <div class="svc-err-msg">يجب إدخال مبلغ أكبر من صفر</div>
                                        }
                                    </div>

                                    @* الشيكات البنكية *@
                                    @if (NeedCheque)
                                    {
                                        <div class="svc-field">
                                            <label class="svc-label">رقم الشيك البنكي <span class="svc-req">*</span></label>
                                            <div class="svc-input-wrap">
                                                <span class="svc-prefix">
                                                    <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7">
                                                        <rect x="2" y="4" width="12" height="9" rx="1"/>
                                                        <path d="M5 8h6M5 11h4" stroke-linecap="round"/>
                                                    </svg>
                                                </span>
                                                <input class="svc-input ltr with-prefix"
                                                       value="@_f.ChequeNumber"
                                                       maxlength="50"
                                                       placeholder="00000000"
                                                       @onchange="e => _f.ChequeNumber = e.Value?.ToString()" />
                                            </div>
                                        </div>

                                        <div class="svc-field">
                                            <label class="svc-label">تاريخ استحقاق الشيك</label>
                                            <div class="svc-input-wrap">
                                                <span class="svc-prefix">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                        <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                                    </svg>
                                                </span>
                                                <input type="date" class="svc-input with-prefix"
                                                       value="@_f.ChequeDate"
                                                       @onchange="e => _f.ChequeDate = e.Value?.ToString()" />
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="svc-field">
                                            <label class="svc-label">الحساب البنكي / رقم المرجع</label>
                                            <div class="svc-input-wrap">
                                                <span class="svc-prefix">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M3 21h18M3 10h18M5 6h14M10 10v11M14 10v11" stroke-linecap="round"/>
                                                    </svg>
                                                </span>
                                                <input class="svc-input with-prefix"
                                                       value="@_f.BankAccount"
                                                       maxlength="100"
                                                       placeholder="رقم الحساب أو مرجع التحويل..."
                                                       @onchange="e => _f.BankAccount = e.Value?.ToString()" />
                                            </div>
                                        </div>
                                    }

                                    <div class="svc-field svc-full">
                                        <label class="svc-label">البيان والملاحظات</label>
                                        <textarea class="svc-input" style="height:60px; padding:8px 12px; resize:none"
                                                  @bind="_f.Notes"
                                                  placeholder="أدخل أي ملاحظات إدارية أو محاسبية ملحقة بسند المقبوضات الحاضر..."></textarea>
                                    </div>

                                </div>
                            </div>
                        </ChildContent>
                    </MudTabPanel>

                    @* TAB 2: توزيع المستحقات وتسوية الفواتير *@
                    <MudTabPanel Disabled="@(_f.CustomerId == 0)">
                        <TabContent>
                            <div class="svc-tab-label">
                                <div class="svc-tab-ic svc-tab-ic-green">
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                    </svg>
                                </div>
                                <span>توزيع فواتير العميل</span>
                                @if (_open.Count > 0)
                                {
                                    <span class="pay-tab-count" style="margin-inline-start:4px">@_open.Count</span>
                                }
                                @if (_triedSave && Left < 0)
                                {
                                    <span class="svc-tab-err"></span>
                                }
                            </div>
                        </TabContent>
                        <ChildContent>
                            <div class="svc-section" style="padding-top:16px">
                                
                                @* بطاقة بيان التوزيع الذكية ومؤشرات المتبقي *@
                                <div class="svc-margin-box" style="margin-bottom:18px; background: @(Left < 0 ? "linear-gradient(135deg, #fff0f2 0%, #fff0f2 100%)" : Left == 0 ? "linear-gradient(135deg, #f3faf5 0%, #e9f8f0 100%)" : "linear-gradient(135deg, #fdf8e6 0%, #fff8e6 100%)"); border-color: @(Left < 0 ? "#ffc8cf" : Left == 0 ? "#b0e0c5" : "#f0d898")">
                                    <div class="svc-margin-left">
                                        <div class="svc-margin-ic" style="background: @(Left < 0 ? "rgba(224,48,72,.15)" : Left == 0 ? "rgba(27,158,94,.15)" : "rgba(232,163,23,.15)"); color: @(Left < 0 ? "var(--fc-red)" : Left == 0 ? "var(--fc-green)" : "var(--fc-amber)"); border-color: @(Left < 0 ? "rgba(224,48,72,.3)" : Left == 0 ? "rgba(27,158,94,.3)" : "rgba(232,163,23,.3)")">
                                            @if (Left < 0)
                                            {
                                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                                                </svg>
                                            }
                                            else if (Left == 0)
                                            {
                                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/><path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                                                </svg>
                                            }
                                        </div>
                                        <div>
                                            <div class="svc-margin-title" style="color: @(Left < 0 ? "var(--fc-red)" : Left == 0 ? "var(--fc-green)" : "var(--fc-text)")">
                                                @if (Left < 0)
                                                {
                                                    <span>تجاوز: تم توزيع مبلغ أكبر من قيمة السند</span>
                                                }
                                                else if (Left == 0)
                                                {
                                                    <span>مكتمل: تم توزيع إجمالي المبلغ بالكامل</span>
                                                }
                                                else
                                                {
                                                    <span>متبقي: توجد نقدية متاحة للتوزيع والتسوية</span>
                                                }
                                            </div>
                                            <div class="svc-margin-sub">
                                                @if (Left < 0)
                                                {
                                                    <span>المبلغ الزائد الموزع بالخطأ: <strong>@Money(-Left) ج.م</strong> (يرجى خفض المبالغ لتتساوى مع قيمة السند)</span>
                                                }
                                                else if (Left == 0)
                                                {
                                                    <span>جاهز للتسجيل والحفظ فوراً</span>
                                                }
                                                else
                                                {
                                                    <span>المبلغ المتبقي المعلق بدون توزيع: <strong>@Money(Left) ج.م</strong></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="svc-margin-val @(Left < 0 ? "neg" : "pos")">
                                        @if (Left != 0)
                                        {
                                            <span>@Money(Left) <small>ج.م</small></span>
                                        }
                                    </div>
                                </div>

                                <div class="pay-alloc-header">
                                    <span class="pay-det-sec-title">فواتير العميل المفتوحة والقابلة للتسوية (@_open.Count)</span>
                                    <button type="button" class="pay-auto-alloc-btn" @onclick="AutoAllocate">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        توزيع تلقائي ذكي
                                    </button>
                                </div>

                                <div class="pay-inv-table-wrap">
                                    <table class="pay-inv-table" aria-label="توزيع الدفعة على الفواتير المفتوحة">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="th-start">رقم الفاتورة</th>
                                                <th scope="col">تاريخ الإصدار</th>
                                                <th scope="col">إجمالي القيمة</th>
                                                <th scope="col">المتبقي المطلوب</th>
                                                <th scope="col" style="width:140px">المخصّص الموزّع</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!_open.Any())
                                            {
                                                <tr>
                                                    <td colspan="5">
                                                        <div class="pay-inv-empty">لا توجد فواتير مفتوحة أو غير مسددة مسجلة على حساب هذا العميل حالياً</div>
                                                    </td>
                                                </tr>
                                            }
                                            @foreach (var inv in _open)
                                            {
                                                var allocated = AllocOf(inv.InvoiceId);
                                                <tr class="@(allocated > 0 ? "inv-row-allocated" : "")">
                                                    <td class="td-start">
                                                        <span class="pay-inv-num">@inv.InvoiceNumber</span>
                                                    </td>
                                                    <td class="td-muted">@inv.InvoiceDate.ToString("yyyy-MM-dd")</td>
                                                    <td class="td-num">@Money(inv.GrandTotal)</td>
                                                    <td>
                                                        <span class="pay-due-badge">@Money(inv.Due)</span>
                                                    </td>
                                                    <td>
                                                        <div class="pay-alloc-input-wrap">
                                                            <input type="number" min="0" step="0.01"
                                                                   class="pay-minput @(allocated > 0 ? "input-allocated" : "")"
                                                                   value="@allocated"
                                                                   @onchange="e => SetAlloc(inv.InvoiceId, ParseDec(e.Value))" />
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </ChildContent>
                    </MudTabPanel>

                </MudTabs>
            </div>

            <div class="svc-modal-foot">
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="Close" type="button">تراجع</button>
                    <button class="svc-btn-save" @onclick="SaveAsync" disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري تسجيل السند...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>تسجيل دفعة التحصيل</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL 2 — تعديل بيانات السند
═══════════════════════════════════════════ *@
@if (_patchOpen && CanEdit && _patchTarget is not null)
{
    <div class="svc-modal-backdrop" @onclick="ClosePatch" role="dialog" aria-modal="true">
        <div class="svc-modal svc-modal-sm" @onclick:stopPropagation="true">

            <div class="svc-modal-head">
                <div class="svc-head-icon svc-icon-edit" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">تعديل بيانات السند رقم @_patchTarget.PaymentNumber</div>
                    <div class="svc-head-sub">ملاحظة: لا يمكن تعديل المبلغ أو توزيع الفواتير من هنا (يرجى إلغاء السند لتغيير القيم)</div>
                </div>
                <button class="svc-head-close" @onclick="ClosePatch" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="svc-banner @(_ok ? "svc-banner-ok" : "svc-banner-err")" role="alert">
                    <span>@_msg</span>
                    <button class="svc-banner-x" @onclick="() => _msg = null" type="button">✕</button>
                </div>
            }

            <div class="svc-modal-body" style="padding: 22px 24px">
                <div class="svc-grid">

                    <div class="svc-field">
                        <label class="svc-label">رقم الشيك المرجعي</label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7">
                                    <rect x="2" y="4" width="12" height="9" rx="1"/>
                                    <path d="M5 8h6M5 11h4" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input class="svc-input with-prefix" value="@_patch.ChequeNumber" maxlength="50" placeholder="رقم الشيك" dir="ltr" @onchange="e => _patch.ChequeNumber = e.Value?.ToString()" />
                        </div>
                    </div>

                    <div class="svc-field">
                        <label class="svc-label">تاريخ استحقاق الشيك</label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                                    <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input type="date" class="svc-input with-prefix" value="@_patch.ChequeDate" @onchange="e => _patch.ChequeDate = e.Value?.ToString()" />
                        </div>
                    </div>

                    <div class="svc-field">
                        <label class="svc-label">الحساب البنكي / رقم المرجع</label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 21h18M3 10h18M5 6h14M10 10v11M14 10v11" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input class="svc-input with-prefix" value="@_patch.BankAccount" maxlength="100" placeholder="رقم الحساب..." @onchange="e => _patch.BankAccount = e.Value?.ToString()" />
                        </div>
                    </div>

                    <div class="svc-field">
                        <label class="svc-label">الملاحظات</label>
                        <input class="svc-input" value="@_patch.Notes" maxlength="500" placeholder="ملاحظات السند..." @onchange="e => _patch.Notes = e.Value?.ToString()" />
                    </div>

                </div>
            </div>

            <div class="svc-modal-foot">
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="ClosePatch" type="button">إلغاء</button>
                    <button class="svc-btn-save" @onclick="SavePatch" disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري التعديل...</span>
                        }
                        else
                        {
                            <span>حفظ التعديلات</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL 3 — تفاصيل الدفعة والتوزيعات
═══════════════════════════════════════════ *@
@if (_detailOpen && _detail is not null)
{
    var currentPayment = _detail.Payment;
    var currentAllocations = _detail.Allocations;
    var detailAllocPct = currentPayment.Amount > 0
        ? (double)(currentPayment.Allocated / currentPayment.Amount * 100)
        : 0;

    <div class="svc-modal-backdrop" @onclick="CloseDetail" role="dialog" aria-modal="true">
        <div class="svc-modal" @onclick:stopPropagation="true">

            <div class="svc-modal-head" style="background: linear-gradient(135deg, #101F3C 0%, #1c2c44 100%)">
                <div class="svc-head-icon" style="background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.2); color: #fff" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        <circle cx="12" cy="14" r="2"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title" style="display:flex; align-items:center; gap:8px; flex-wrap:wrap">
                        <span>سند التحصيل رقم @currentPayment.PaymentNumber</span>
                        <span class="pay-chip @StatusChipClass(currentPayment.Status)" style="border-radius:20px; font-size:9.5px">
                            <span class="pay-chip-dot @StatusDotClass(currentPayment.Status)" aria-hidden="true"></span>
                            @StatusAr(currentPayment.Status)
                        </span>
                    </div>
                    <div class="pay-detail-meta">
                        <span class="detail-meta-tag">👤 @currentPayment.CustomerName</span>
                        <span class="detail-meta-tag">💳 @currentPayment.MethodName</span>
                        <span class="detail-meta-tag">📅 @currentPayment.PaymentDate</span>
                    </div>
                </div>
                <button class="svc-head-close" @onclick="CloseDetail" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            <div class="svc-modal-body pay-detail-body" style="padding: 22px 24px">

                @* كروت تحليل المبالغ *@
                <div class="pay-detail-summary">
                    <div class="pay-detail-card">
                        <div class="detail-card-ring ring-amount" aria-hidden="true">💰</div>
                        <div>
                            <div class="detail-card-label">القيمة الكلية للسند</div>
                            <div class="detail-card-val amount-val">@Money(currentPayment.Amount) <small>ج.م</small></div>
                        </div>
                    </div>
                    <div class="pay-detail-card">
                        <div class="detail-card-ring ring-alloc" aria-hidden="true">📊</div>
                        <div>
                            <div class="detail-card-label">المخصص للتسوية</div>
                            <div class="detail-card-val alloc-val">@Money(currentPayment.Allocated) <small>ج.م</small></div>
                        </div>
                    </div>
                    <div class="pay-detail-card @(currentPayment.Unallocated > 0 ? "card-unalloc" : "card-settled")">
                        <div class="detail-card-ring @(currentPayment.Unallocated > 0 ? "ring-unalloc" : "ring-settled")" aria-hidden="true">
                            @(currentPayment.Unallocated > 0 ? "⏳" : "✓")
                        </div>
                        <div>
                            <div class="detail-card-label">المعلق غير المخصص</div>
                            <div class="detail-card-val @(currentPayment.Unallocated > 0 ? "unalloc-val" : "settled-val")">
                                @Money(currentPayment.Unallocated) <small>ج.م</small>
                            </div>
                        </div>
                    </div>
                </div>

                @* شريط تقدم التخصيص العام *@
                <div class="pay-detail-progress">
                    <div class="pay-det-prog-bar">
                        <div class="pay-det-prog-fill @(currentPayment.Unallocated == 0 ? "fill-full" : "fill-partial")"
                             style="width:@Math.Min(detailAllocPct, 100)%">
                        </div>
                    </div>
                    <div class="pay-det-prog-labels">
                        <span>موزع لتسوية الفواتير: @Money(currentPayment.Allocated) ج.م (@detailAllocPct.ToString("0")%)</span>
                        <span>معلق بالحساب الجاري: @Money(currentPayment.Unallocated) ج.م</span>
                    </div>
                </div>

                @* إشعار الشيك *@
                @if (currentPayment.ChequeNumber is not null)
                {
                    <div class="pay-cheque-notice" role="status">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <rect x="2" y="4" width="12" height="9" rx="1"/>
                            <path d="M5 8h6M5 11h4" stroke-linecap="round"/>
                        </svg>
                        <span>تم تحصيل السند عبر الشيك البنكي رقم: <strong>@currentPayment.ChequeNumber</strong> @(currentPayment.ChequeDate is not null ? " · استحقاق: " + currentPayment.ChequeDate : "")</span>
                    </div>
                }

                @* جدول التوزيع الفعلي *@
                <div class="pay-detail-section">
                    <div class="pay-detail-section-head">
                        <span class="pay-det-sec-title">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                            </svg>
                            تسويات الفواتير المقترنة بالسند
                        </span>
                        <span class="pay-det-sec-count">@currentAllocations.Count</span>
                    </div>

                    @if (!currentAllocations.Any())
                    {
                        <div class="pay-detail-empty">لا توجد تسويات جارية للفواتير — هذا السند معلق بحساب العميل الجاري</div>
                    }
                    else
                    {
                        <div class="pay-alloc-detail-list">
                            @foreach (var a in currentAllocations)
                            {
                                var coveredPct = a.InvoiceTotal > 0
                                    ? (double)(a.InvoicePaid / a.InvoiceTotal * 100)
                                    : 0;
                                <div class="pay-alloc-detail-row">
                                    <div class="pay-alloc-inv-num">@a.InvoiceNumber</div>
                                    <div class="pay-alloc-inv-info">
                                        <div class="pay-alloc-prog">
                                            <div class="pay-alloc-prog-bar">
                                                <div class="pay-alloc-prog-fill" style="width:@Math.Min(coveredPct, 100)%"></div>
                                            </div>
                                            <span class="pay-alloc-pct">@coveredPct.ToString("0")%</span>
                                        </div>
                                        <div class="pay-alloc-nums-row">
                                            <span>إجمالي الفاتورة: @Money(a.InvoiceTotal) ج.م</span>
                                            <span>المسدد منها إجمالاً: @Money(a.InvoicePaid) ج.م</span>
                                        </div>
                                    </div>
                                    <div class="pay-alloc-this-pay">
                                        <span class="alloc-this-label">المسدد من هذا السند</span>
                                        <strong>@Money(a.AllocatedAmount) ج.م</strong>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* ملاحظات السند *@
                @if (currentPayment.Notes is not null)
                {
                    <div class="pay-detail-section">
                        <div class="pay-detail-section-head">
                            <span class="pay-det-sec-title">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                                ملاحظات وتوصيات إدارية
                            </span>
                        </div>
                        <div class="pay-detail-notes">@currentPayment.Notes</div>
                    </div>
                }

            </div>

            <div class="svc-modal-foot">
                <button class="svc-btn-cancel" @onclick="CloseDetail" style="margin-right:auto" type="button">إغلاق النافذة</button>
            </div>

        </div>
    </div>
}


@* ── GLOW FAB (موضع ثابت وأداء دقيق في أسفل اليسار) ── *@
@if (CanView && CanCreate)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="New">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                    </svg>
                </span>
                <span>تسجيل دفعة تحصيل جديدة</span>
            </button>
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="Reload">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M23 4v6h-6"/>
                        <path d="M1 20v-6h6"/>
                        <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                    </svg>
                </span>
                <span>تحديث كشف البيانات</span>
            </button>
        </div>

        <div class="glow-fab-container">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="glow-fab-btn" @onclick="ToggleFab" aria-label="لوحة التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

    </div>
}

@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
}


@* ═══════════════════════════════════════════
   CSS STYLES
═══════════════════════════════════════════ *@
<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ── Hero ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px; margin: 0 auto; width: 100%;
        box-sizing: border-box; position: relative; z-index: 1;
    }
    .hero-wrapper .fc-hero {
        border-radius: 20px !important; overflow: hidden;
        box-shadow: 0 12px 32px rgba(13, 38, 84, 0.15), 0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .hero-wrapper .fc-hero.fc-hero-slim { padding-top: 18px !important; padding-bottom: 22px !important; }

    .pay-hero-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 6px; }
    .pay-hero-left { flex: 1; min-width: 200px; }
    .pay-hero-crumb { display: flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.55); margin-bottom: 2px; }
    .pay-hero-sub { font-size: 13px; color: rgba(255,255,255,.55); font-weight: 600; }
    .pay-hero-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .pay-hero-chip { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: 8px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: rgba(255,255,255,.7); font-size: 10.5px; font-weight: 700; white-space: nowrap; }

    .pay-hero-refresh {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.75); cursor: pointer; transition: background .15s;
    }
    .pay-hero-refresh:hover { background: rgba(255, 255, 255, 0.14); }

    .pay-hero-add {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; border-radius: 9px;
        border: none; background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .pay-hero-add:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }

    /* ── KPI Connected Glass Strip ── */
    .pay-kpis-strip {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px); margin-top: 14px;
    }
    .pay-kpi-item {
        flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px 16px;
        cursor: pointer; transition: background .15s ease;
    }
    .pay-kpi-item:hover { background: rgba(255,255,255,.06); }
    .pay-kpi-item.kpi-active { background: rgba(30,110,245,.28); border-radius: 8px; }
    .pay-kpi-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }
    .pay-kpi-icon {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
    }
    .kpi-blue  { background: rgba(30,110,245,.2); color: #93c5fd; }
    .kpi-amber { background: rgba(234,179,8,.2);  color: #fde68a; }
    .kpi-red   { background: rgba(239,68,68,.2);  color: #fca5a5; }
    .kpi-green { background: rgba(34,197,94,.2);  color: #86efac; }

    .pay-kpi-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .pay-kpi-val { font-size: 15px; font-weight: 900; color: #fff; margin-top: 2px; }
    .pay-kpi-val small { font-size: 10px; font-weight: 600; opacity: .7; }
    .kpi-val-amber { color: #fde68a; }
    .kpi-val-red   { color: #fca5a5; }
    .kpi-val-green { color: #86efac; }

    /* ── Body ── */
    .pay-body {
        background: var(--fc-bg); min-height: calc(100vh - 180px);
        padding: 18px clamp(16px, 3vw, 40px) 96px;
        max-width: 1440px; width: 100%; margin: 0 auto;
        box-sizing: border-box; position: relative; z-index: 2;
        display: flex; flex-direction: column; gap: 14px;
    }

    .pay-card { background: var(--fc-card); border: 1px solid var(--fc-border); border-radius: var(--fc-radius); box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06); overflow: hidden; }

    .pay-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px; background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center; box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .pay-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .pay-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .pay-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .pay-state-box p { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* ── Toolbar ── */
    .pay-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; background: linear-gradient(180deg, #fff 0%, #fafbfd 100%); border-bottom: 1px solid #edf1f7; flex-wrap: wrap; }
    .pay-search-wrap { position: relative; display: flex; align-items: center; flex: 1; min-width: 200px; max-width: 380px; }
    .pay-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }
    .pay-search-input {
        width: 100%; height: 42px; padding: 0 36px 0 12px; border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text); font-family: inherit; font-size: 13px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .pay-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .pay-search-input::placeholder { color: #b0bcc8; }
    .pay-search-clear { position: absolute; left: 10px; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; border: none; background: #edf1f7; color: #8899ae; cursor: pointer; }
    .pay-search-clear:hover { background: #dde3ed; }
    .pay-results-badge { display: flex; align-items: center; gap: 5px; margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap; }
    .pay-results-badge strong { color: #5a6e88; }

    /* ── Status Bar ── */
    .pay-status-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 18px; background: #f9fafd; border-bottom: 1px solid #edf1f7; overflow-x: auto; }
    .pay-status-tabs { display: flex; gap: 4px; padding: 3px; border-radius: 10px; background: #f0f3f8; }
    .pay-status-tab {
        display: flex; align-items: center; gap: 5px; height: 32px; padding: 0 10px; border: none; border-radius: 7px;
        background: transparent; color: #6b7d95; font-family: inherit; font-size: 10.5px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .pay-status-tab:hover:not(.active) { color: var(--fc-text); background: rgba(255,255,255,.6); }
    .pay-status-tab.active { background: var(--fc-card); color: var(--fc-text); box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800; }
    .pay-tab-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 7px; }
    .pay-tab-count { min-width: 16px; height: 16px; border-radius: 4px; padding: 0 3px; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 900; }
    .pay-status-tab.active .pay-tab-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .pay-status-tab:not(.active) .pay-tab-count { background: #e4eaf3; color: #8899ae; }

    .sdot-all       { background: var(--fc-blue); }
    .sdot-posted    { background: var(--fc-green); }
    .sdot-cancelled { background: var(--fc-red); }
    .sdot-returned  { background: var(--fc-amber); }

    /* ── Table Layout ── */
    .pay-table-wrap { overflow-x: auto; }
    .pay-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .pay-table thead th {
        padding: 12px 14px; background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 10.5px; font-weight: 800; text-align: center; border-bottom: 2px solid #e4eaf3; white-space: nowrap;
    }
    .pay-table .th-start { text-align: right; }
    .pay-table tbody tr { border-bottom: 1px solid #f0f3f8; transition: background .12s ease; }
    .pay-table tbody tr:last-child { border-bottom: none; }
    .pay-table tbody tr:hover { background: #fafcff; }
    .pay-table tbody tr.row-cancelled { opacity: .55; }
    .pay-table tbody td { padding: 11px 12px; color: #526070; text-align: center; vertical-align: middle; }
    .td-start { text-align: right !important; }
    .td-muted { color: #8899ae; font-size: 11px; }

    .pay-pay-cell { display: flex; align-items: flex-start; gap: 10px; }
    .pay-avatar { width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: #fff; box-shadow: 0 2px 6px rgba(0,0,0,.10); margin-top: 2px; }
    .av-posted    { background: linear-gradient(135deg, #0d8a48, #16a35b); }
    .av-cancelled { background: linear-gradient(135deg, #b02040, #e03048); }
    .av-returned  { background: linear-gradient(135deg, #b87d08, #e09a10); }

    .pay-pay-info { min-width: 0; }
    .pay-code-btn {
        background: none; border: none; padding: 2px 8px; border-radius: 6px; cursor: pointer;
        background: #f0f4fa; border: 1px solid #e0e8f4; font-size: 10.5px; font-weight: 800; color: var(--fc-blue);
        font-family: "Inter", Arial, sans-serif; transition: all .12s ease; display: inline-flex; align-items: center; gap: 5px;
    }
    .pay-code-btn:hover { background: var(--fc-blue); color: #fff; border-color: var(--fc-blue); }
    .pay-customer-name { font-size: 12px; font-weight: 700; color: #344563; margin-top: 4px; }
    .pay-cheque-tag { display: flex; align-items: center; gap: 3px; font-size: 9.5px; color: #8899ae; margin-top: 3px; }
    .pay-date-cell { display: flex; align-items: center; gap: 4px; justify-content: center; color: #6b7d95; font-size: 11px; }
    .pay-method-tag { display: inline-flex; padding: 3px 9px; border-radius: 6px; background: #f0f3f8; color: #6b7d95; font-size: 10.5px; font-weight: 700; border: 1px solid #dde5f0; }

    .pay-amounts-cell { text-align: center; }
    .pay-amount-main { font-family: "Inter", Arial, sans-serif; font-size: 13px; font-weight: 900; color: var(--fc-text); }
    .pay-amount-main small { font-size: 9px; color: #9aaabb; margin-inline-start: 2px; }

    .pay-alloc-cell { min-width: 100px; }
    .pay-alloc-bar-wrap { display: flex; flex-direction: column; gap: 5px; }
    .pay-alloc-bar { height: 5px; border-radius: 4px; background: #e4eaf3; overflow: hidden; width: 90px; }
    .pay-alloc-fill { height: 100%; border-radius: inherit; transition: width .4s ease; }
    .fill-full    { background: linear-gradient(90deg, #34d399, #10b981); }
    .fill-partial { background: linear-gradient(90deg, #fbbf24, #f59e0b); }
    .pay-alloc-nums { display: flex; flex-direction: column; gap: 1px; }
    .alloc-inv-count { font-size: 9.5px; color: #6b7d95; font-weight: 600; }
    .alloc-remaining { font-size: 9.5px; color: var(--fc-amber); font-weight: 700; }
    .pay-unalloc-badge { display: inline-flex; padding: 2px 7px; border-radius: 5px; background: #fff8e6; color: #9a6d08; font-size: 9.5px; font-weight: 800; border: 1px solid #f0d898; }

    .pay-chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 7px; font-size: 10.5px; font-weight: 800; white-space: nowrap; }
    .pay-chip-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; }
    .chip-posted    { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .chip-cancelled { background: var(--fc-red-lt);   color: var(--fc-red);   border: 1px solid #ffc8cf; }
    .chip-returned  { background: var(--fc-amber-lt); color: #9a6d08;         border: 1px solid #f0d898; }

    .pay-actions { display: flex; align-items: center; gap: 3px; justify-content: center; }
    .pay-act-btn { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; border: 1px solid transparent; cursor: pointer; transition: all .15s ease; background: transparent; }
    .act-info { color: var(--fc-blue); }
    .act-edit { color: var(--fc-blue); }
    .act-void { color: var(--fc-red); }
    .act-info:hover { background: var(--fc-blue-lt); border-color: #c0d4fb; }
    .act-edit:hover { background: var(--fc-blue-lt); border-color: #c0d4fb; }
    .act-void:hover { background: var(--fc-red-lt);  border-color: #ffc8cf; }

    .pay-confirm-void { height: 26px; padding: 0 9px; border: none; border-radius: 6px; background: linear-gradient(135deg, #e03048, #c0182e); color: #fff; font-family: inherit; font-size: 9.5px; font-weight: 800; cursor: pointer; animation: pay-pulse-del 1s ease infinite; white-space: nowrap; }
    @@keyframes pay-pulse-del { 0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.35); } 50% { box-shadow: 0 0 0 5px rgba(224,48,72,0); } }

    .pay-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 200px; color: var(--fc-muted); font-size: 12px; font-weight: 600; }
    .pay-spinner { width: 32px; height: 32px; border: 3px solid #dde5f0; border-top-color: var(--fc-blue); border-radius: 50%; animation: pay-spin .75s linear infinite; }
    @@keyframes pay-spin { to { transform: rotate(360deg); } }

    .pay-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 240px; padding: 40px; text-align: center; }
    .pay-empty-icon { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f4fa; color: #b0c4d8; }
    .pay-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .pay-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    /* ── Dialogs (svc-modal Standards) ── */
    .svc-modal-backdrop { position: fixed; inset: 0; z-index: 1400; background: rgba(10,27,59,.62); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; padding: 20px; animation: svc-fade .2s ease both; }
    @@keyframes svc-fade { from { opacity: 0; } to { opacity: 1; } }

    .svc-modal { width: 100%; max-width: 680px; background: #fff; border-radius: 20px; box-shadow: 0 25px 60px rgba(10,27,59,.28), 0 8px 20px rgba(10,27,59,.12); overflow: hidden; animation: svc-pop .28s cubic-bezier(.22,.9,.36,1.1) both; max-height: 92vh; display: flex; flex-direction: column; }
    .svc-modal-sm { max-width: 480px; }
    @@keyframes svc-pop { from { opacity: 0; transform: translateY(20px) scale(.96); } to { opacity: 1; transform: none; } }

    .svc-modal-head { display: flex; align-items: center; gap: 14px; padding: 20px 24px; background: linear-gradient(135deg, #0A1B3B 0%, #16306B 100%); color: #fff; flex: 0 0 auto; position: relative; overflow: hidden; }
    .svc-modal-head::before { content: ""; position: absolute; top: -50px; right: -50px; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, rgba(255,128,21,.15) 0%, transparent 70%); pointer-events: none; }
    .svc-head-icon { width: 46px; height: 46px; flex: 0 0 46px; display: flex; align-items: center; justify-content: center; border-radius: 13px; position: relative; z-index: 1; }
    .svc-icon-create { background: rgba(27,158,94,.2); color: #6ee7b7; border: 1px solid rgba(110,231,183,.3); }
    .svc-icon-edit   { background: rgba(255,128,21,.2); color: #FFD9B8; border: 1px solid rgba(255,128,21,.3); }
    .svc-head-text  { flex: 1; min-width: 0; position: relative; z-index: 1; }
    .svc-head-title { font-size: 16px; font-weight: 800; color: #fff; line-height: 1.3; }
    .svc-head-sub   { font-size: 11.5px; color: rgba(255,255,255,.62); margin-top: 3px; }
    .svc-head-close { width: 34px; height: 34px; flex: 0 0 34px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.15); border-radius: 9px; background: rgba(255,255,255,.06); color: rgba(255,255,255,.7); cursor: pointer; transition: all .15s; position: relative; z-index: 1; }
    .svc-head-close:hover { background: rgba(255,255,255,.14); color: #fff; transform: rotate(90deg); }

    .svc-banner { display: flex; align-items: center; gap: 10px; padding: 12px 20px; flex: 0 0 auto; font-size: 12.5px; font-weight: 600; }
    .svc-banner-ok  { background: #e9f8f0; color: #0e7a43; border-bottom: 1px solid #b5e8d0; }
    .svc-banner-err { background: #fff0f2; color: #D64545; border-bottom: 1px solid #ffc8cf; }
    .svc-banner-x { background: none; border: none; color: inherit; opacity: .5; cursor: pointer; display: flex; margin-right: auto; }
    .svc-modal-body { flex: 1 1 auto; overflow-y: auto; padding: 0; }

    /* MudTabs */
    .svc-mud-tabs .mud-tabs-toolbar { background: linear-gradient(180deg, #f8fafd, #f2f5fa) !important; border-bottom: 2px solid #e4eaf3 !important; padding: 0 16px !important; min-height: 52px !important; }
    .svc-mud-tabs .mud-tab { font-family: inherit !important; font-size: 12px !important; font-weight: 700 !important; color: #6B7A8F !important; padding: 0 10px !important; min-width: unset !important; text-transform: none !important; letter-spacing: 0 !important; min-height: 52px !important; }
    .svc-mud-tabs .mud-tab.mud-tab-active { color: #0B56DF !important; font-weight: 800 !important; }
    .svc-mud-tabs .mud-tab-slider { background: #0B56DF !important; height: 3px !important; border-radius: 3px 3px 0 0 !important; }
    .svc-mud-tabs .mud-tab:hover:not(.mud-tab-active) { color: #1A2332 !important; background: rgba(11,86,223,.04) !important; border-radius: 8px !important; }
    .svc-tab-panel { padding: 0 !important; }

    .svc-tab-label { display: flex; align-items: center; gap: 7px; padding: 0 4px; white-space: nowrap; position: relative; }
    .svc-tab-ic { width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: 7px; }
    .svc-tab-ic-blue  { background: #eaf1ff; color: #0B56DF; }
    .svc-tab-ic-green { background: #e9f8f0; color: #1B9E5E; }
    .svc-tab-err { width: 7px; height: 7px; border-radius: 50%; background: #D64545; animation: svc-pulse 1.5s ease infinite; }
    @@keyframes svc-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(214,69,69,.4); } 50% { box-shadow: 0 0 0 5px rgba(214,69,69,0); } }

    .svc-section { padding: 22px 24px 26px; }
    .svc-section-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #edf1f7; }
    .svc-section-ic { width: 40px; height: 40px; flex: 0 0 40px; display: flex; align-items: center; justify-content: center; border-radius: 11px; }
    .svc-section-ic.blue  { background: #eaf1ff; color: #0B56DF; border: 1px solid #bdd4fc; }
    .svc-section-ic.green { background: #e9f8f0; color: #1B9E5E; border: 1px solid #b0e0c5; }
    .svc-section-title { font-size: 14.5px; font-weight: 800; color: #1A2332; line-height: 1.2; }
    .svc-section-sub   { font-size: 11px; font-weight: 500; color: #6B7A8F; margin-top: 3px; }

    .svc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .svc-full { grid-column: 1 / -1; }
    .svc-field { display: flex; flex-direction: column; gap: 5px; position: relative; }
    .svc-label { font-size: 11.5px; font-weight: 800; color: #344258; display: flex; align-items: center; gap: 4px; }
    .svc-req { color: #D64545; font-size: 13px; }

    .svc-input-wrap { position: relative; display: flex; align-items: center; }
    .svc-prefix { position: absolute; right: 12px; z-index: 1; display: flex; align-items: center; color: #9aaabb; pointer-events: none; }
    .svc-prefix.txt { font-size: 11px; font-weight: 800; color: #6B7A8F; }
    .svc-input { width: 100%; height: 42px; border: 1.5px solid #d8e2f0; border-radius: 10px; background: #fafcff; color: #1A2332; font-family: inherit; font-size: 13px; padding: 0 12px; outline: none; box-sizing: border-box; transition: border-color .15s, box-shadow .15s, background .15s; }
    .svc-input:focus { border-color: #0B56DF; box-shadow: 0 0 0 3px rgba(11,86,223,.1); background: #fff; }
    .svc-input.svc-err { border-color: #D64545; box-shadow: 0 0 0 3px rgba(214,69,69,.08); background: #fffafb; }
    .svc-input:disabled { background: #f5f7fa; color: #8899ae; cursor: not-allowed; }
    .svc-input::placeholder { color: #b0bcc8; }
    .svc-input.with-prefix { padding-right: 40px; }

    .svc-select {
        cursor: pointer; -webkit-appearance: none; appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236B7A8F' stroke-width='2'%3e%3cpolyline points='6 9 12 15 18 9'/%3e%3c/svg%3e");
        background-repeat: no-repeat; background-position: left 12px center; background-size: 13px; padding-left: 34px;
    }

    .field-clear-btn { position: absolute; left: 12px; background: none; border: none; color: #9aaabb; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 4px; border-radius: 50%; font-size: 11px; font-weight: bold; }
    .field-clear-btn:hover { background: rgba(0,0,0,0.05); color: var(--fc-red); }

    .field-dropdown { position: absolute; top: 100%; right: 0; left: 0; margin-top: 4px; background: #fafcff; border: 1px solid #d8e2f0; border-radius: 9px; box-shadow: 0 8px 24px rgba(0,0,0,.12); max-height: 240px; overflow-y: auto; z-index: 100; }
    .field-dropdown-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; font-size: 13px; color: var(--fc-text); cursor: pointer; transition: background .1s; }
    .field-dropdown-item:hover, .field-dropdown-item.is-focused { background: #eaf1ff; color: var(--fc-blue); font-weight: 600; }

    .svc-err-msg { font-size: 10.5px; color: #D64545; font-weight: 700; animation: svc-fade .2s ease; margin-top: 2px; }

    .svc-margin-box { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 16px; border: 1.5px solid #e9f8f0; border-radius: 12px; transition: all .2s; }
    .svc-margin-left { display: flex; align-items: center; gap: 12px; }
    .svc-margin-ic { width: 40px; height: 40px; flex: 0 0 40px; display: flex; align-items: center; justify-content: center; border-radius: 10px; }
    .svc-margin-title { font-size: 13px; font-weight: 800; }
    .svc-margin-sub { font-size: 10.5px; color: #6B7A8F; margin-top: 2px; }
    .svc-margin-sub strong { color: #1c2b43; font-weight: 800; }
    .svc-margin-val { font-size: 17px; font-weight: 900; }
    .svc-margin-val.pos { color: #1B9E5E; }
    .svc-margin-val.neg { color: #D64545; }
    .svc-margin-val small { font-size: 11px; opacity: .7; margin-inline-start: 3px; }

    .pay-alloc-header { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 12px; }
    .pay-auto-alloc-btn { display: inline-flex; align-items: center; gap: 5px; height: 32px; padding: 0 12px; border: 1.5px solid var(--fc-blue); border-radius: 7px; background: var(--fc-blue-lt); color: var(--fc-blue); font-family: inherit; font-size: 11px; font-weight: 800; cursor: pointer; transition: all .12s ease; white-space: nowrap; }
    .pay-auto-alloc-btn:hover { background: var(--fc-blue); color: #fff; }

    .pay-inv-table-wrap { overflow-x: auto; }
    .pay-inv-table { width: 100%; border-collapse: collapse; font-size: 12px; border: 1px solid #e4edf8; border-radius: 10px; overflow: hidden; }
    .pay-inv-table thead th { padding: 9px 12px; background: linear-gradient(180deg, #f0f5fc, #eaf1f9); color: #4a5a74; font-size: 10px; font-weight: 800; text-align: center; border-bottom: 1px solid #dce8f5; }
    .pay-inv-table .th-start { text-align: right; }
    .pay-inv-table tbody tr { border-bottom: 1px solid #f0f5fb; transition: background .12s ease; }
    .pay-inv-table tbody tr:last-child { border-bottom: none; }
    .pay-inv-table tbody tr.inv-row-allocated { background: #f0fdf8; }
    .pay-inv-table tbody td { padding: 9px 12px; text-align: center; vertical-align: middle; }

    .pay-inv-num { font-size: 11px; font-weight: 800; color: var(--fc-blue); font-family: "Inter", Arial, sans-serif; }
    .pay-due-badge { display: inline-flex; padding: 2px 7px; border-radius: 5px; background: var(--fc-red-lt); color: var(--fc-red); font-size: 10px; font-weight: 800; border: 1px solid #ffc8cf; font-family: "Inter", Arial, sans-serif; }
    .pay-alloc-input-wrap input { height: 36px; font-size: 12px; width: 100%; border: 1px solid #d8e2f0; border-radius: 6px; padding: 0 8px; text-align: center; font-weight: 700; outline: none; }
    .pay-alloc-input-wrap input.input-allocated { border-color: var(--fc-green); background: #f0fdf8; }
    .pay-inv-empty { padding: 20px; text-align: center; color: #9aaabb; font-size: 12px; font-weight: 600; }

    .svc-modal-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 20px; background: linear-gradient(180deg, #fafbfd 0%, #f4f6fb 100%); border-top: 1px solid #edf1f7; flex: 0 0 auto; }
    .svc-foot-right { margin-right: auto; display: flex; align-items: center; gap: 8px; }
    .svc-btn-cancel { height: 38px; padding: 0 16px; border: 1.5px solid #d8e2f0; border-radius: 9px; background: #fff; color: #6B7A8F; font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer; transition: all .15s; }
    .svc-btn-cancel:hover { background: #f0f4fa; color: #1A2332; border-color: #c0ccd8; }
    .svc-btn-save { display: inline-flex; align-items: center; gap: 7px; height: 40px; padding: 0 22px; border: none; border-radius: 10px; background: linear-gradient(135deg, #0B56DF, #083CA8); color: #fff; font-family: inherit; font-size: 12.5px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 12px rgba(11,86,223,.28); transition: all .18s; }
    .svc-btn-save:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(11,86,223,.4); }
    .svc-btn-save:disabled { opacity: .6; cursor: not-allowed; }
    .svc-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: pay-spin .7s linear infinite; }

    /* ── Detail Modal Elements ── */
    .pay-detail-body { padding: 20px 22px; display: flex; flex-direction: column; gap: 16px; }
    .pay-detail-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
    .detail-meta-tag { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 6px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); font-size: 10.5px; font-weight: 700; color: #fff; }

    .pay-detail-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .pay-detail-card { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 12px; background: #f5f7fa; border: 1px solid #e4eaf3; }
    .card-unalloc { background: var(--fc-amber-lt); border-color: #f0d898; }
    .card-settled  { background: var(--fc-green-lt); border-color: #b0e0c5; }
    .detail-card-ring { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
    .ring-amount { background: var(--fc-blue-lt); border: 1px solid #c0d4fb; }
    .ring-alloc  { background: var(--fc-green-lt); border: 1px solid #b0e0c5; }
    .ring-unalloc { background: var(--fc-amber-lt); border: 1px solid #f0d898; }
    .ring-settled  { background: var(--fc-green-lt); border: 1px solid #b0e0c5; }
    .detail-card-label { font-size: 9.5px; color: #8899ae; font-weight: 600; }
    .detail-card-val { font-family: "Inter", Arial, sans-serif; font-size: 16px; font-weight: 900; color: var(--fc-text); margin-top: 3px; }
    .alloc-val   { color: var(--fc-green); }
    .unalloc-val { color: #9a6d08; }
    .settled-val { color: var(--fc-green); }

    .pay-detail-progress { display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 10px; background: linear-gradient(135deg, #f5f8ff, #eef4ff); border: 1px solid #c8d8fb; }
    .pay-det-prog-bar { height: 8px; border-radius: 6px; background: #e4eaf3; overflow: hidden; }
    .pay-det-prog-fill { height: 100%; border-radius: inherit; transition: width .5s ease; }
    .pay-det-prog-labels { display: flex; justify-content: space-between; font-size: 10.5px; color: #6b7d95; font-weight: 600; }

    .pay-cheque-notice { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 10px; background: var(--fc-blue-lt); border: 1px solid #bdd4fc; color: var(--fc-blue); font-size: 11.5px; font-weight: 600; }

    .pay-detail-section { display: flex; flex-direction: column; gap: 10px; }
    .pay-detail-section-head { display: flex; align-items: center; gap: 10px; padding-bottom: 8px; border-bottom: 1px solid #edf1f7; }
    .pay-det-sec-title { display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 800; color: #1c2b43; flex: 1; }
    .pay-det-sec-count { min-width: 20px; height: 20px; border-radius: 6px; padding: 0 5px; display: flex; align-items: center; justify-content: center; background: #f0f3f8; color: #6b7d95; font-size: 10px; font-weight: 900; font-family: "Inter", Arial, sans-serif; }
    .pay-detail-empty { padding: 16px; text-align: center; color: #9aaabb; font-size: 12px; font-weight: 600; border: 1px dashed #e4eaf3; border-radius: 10px; background: #f9fafc; }
    .pay-detail-notes { font-size: 12.5px; color: var(--fc-text); line-height: 1.6; padding: 12px 14px; border-radius: 10px; background: #f5f7fa; border: 1px solid #e4eaf3; }

    .pay-alloc-detail-list { display: flex; flex-direction: column; gap: 8px; }
    .pay-alloc-detail-row { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; padding: 10px 14px; border-radius: 10px; background: #fafcff; border: 1px solid #e8edf5; }
    .pay-alloc-inv-num { font-size: 11.5px; font-weight: 900; color: var(--fc-blue); font-family: "Inter", Arial, sans-serif; white-space: nowrap; }
    .pay-alloc-inv-info { display: flex; flex-direction: column; gap: 4px; }
    .pay-alloc-prog { display: flex; align-items: center; gap: 8px; }
    .pay-alloc-prog-bar { flex: 1; height: 6px; border-radius: 4px; background: #e4eaf3; overflow: hidden; }
    .pay-alloc-prog-fill { height: 100%; background: linear-gradient(90deg, #34d399, #10b981); border-radius: inherit; }
    .pay-alloc-pct { font-size: 9.5px; font-weight: 700; color: var(--fc-green); min-width: 30px; }
    .pay-alloc-nums-row { display: flex; gap: 10px; font-size: 9.5px; color: #8899ae; font-weight: 500; }
    .pay-alloc-this-pay { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; flex: 0 0 auto; }
    .alloc-this-label { font-size: 8.5px; color: #9aaabb; font-weight: 600; }
    .pay-alloc-this-pay strong { font-family: "Inter", Arial, sans-serif; font-size: 13px; font-weight: 900; color: var(--fc-text); }

    /* ── Precise Scoped FAB ── */
    .glow-fab-wrap { position: fixed; left: 28px; bottom: 28px; z-index: 1299; width: 60px; height: 60px; }
    .glow-fab-container { position: relative; z-index: 2; width: 60px; height: 60px; }
    .glow-fab-btn {
        position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 58px; height: 58px; border-radius: 50%;
        background: linear-gradient(135deg, #1e6ef5, #0d47a1);
        border: 2.5px solid #fbbf24; color: #fff; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 16px rgba(30, 110, 245, .4); transition: transform .2s; z-index: 2;
    }
    .glow-fab-btn:hover { transform: translate(-50%, -50%) scale(1.05); }
    .glow-fab-icon { transition: transform .3s; }
    .glow-fab-wrap.is-open .glow-fab-icon { transform: rotate(130deg); }

    .glow-halo, .glow-ring { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none; }
    .glow-halo { width: 58px; height: 58px; background: radial-gradient(circle, rgba(30, 110, 245, .3) 0%, transparent 70%); animation: glow-breath 2s ease-in-out infinite; }
    .glow-ring { width: 58px; height: 58px; border: 2px solid rgba(30, 110, 245, .4); animation: glow-expand 2s ease-out infinite; }
    .glow-ring-2 { animation-delay: .3s; }
    .glow-ring-3 { animation-delay: .6s; }
    @@keyframes glow-breath { 0%, 100% { opacity: .5; transform: translate(-50%, -50%) scale(1); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); } }
    @@keyframes glow-expand { 0% { opacity: .8; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(2.5); } }

    .glow-fab-menu {
        position: absolute; bottom: 74px; left: 0; z-index: 3;
        display: flex; flex-direction: column; gap: 8px;
        opacity: 0; pointer-events: none; transform: translateY(10px); transition: opacity .2s, transform .2s;
    }
    .glow-fab-wrap.is-open .glow-fab-menu { opacity: 1; pointer-events: auto; transform: translateY(0); }
    .glow-fab-item {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 16px; border-radius: 12px; background: #fff;
        border: 1px solid #dde5f0; box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
        cursor: pointer; font-size: 13px; color: #1c2c44; white-space: nowrap;
    }
    .glow-fab-item:hover { background: #f4f7fb; border-color: #1e6ef5; }
    .glow-fab-item-ic { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 8px; background: #eaf1ff; color: #1e6ef5; }
    .glow-fab-scrim { position: fixed; inset: 0; background: rgba(9, 18, 35, .45); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 1298; }

    /* ── Responsive ── */
    @@media (max-width: 992px) {
        .pay-kpis-strip { flex-wrap: wrap; }
        .pay-kpi-item { flex: 0 0 50%; }
