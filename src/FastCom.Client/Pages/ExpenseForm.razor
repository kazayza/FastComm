@page "/expenses/new"
@page "/expenses/new/{Id:long}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "مصروف جديد" : "تعديل مصروف") — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="ef-hero-row">
                <div class="ef-hero-left">
                    <div class="ef-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                        <span>المالية · المصروفات</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">
                        @if (_id is null)
                        {
                            <span>مصروف جديد</span>
                        }
                        else
                        {
                            <span>@ExpenseNumber</span>
                        }
                    </h1>
                    <span class="ef-hero-sub">
                        @(_id is null
                            ? "تسجيل المصروف وبيانات الدفع، ويُقيَّد في الخزينة تلقائيًا عند استيفاء الشروط"
                            : $"تعديل بيانات المصروف رقم {ExpenseNumber}")
                    </span>
                </div>

                <div class="ef-hero-right">
                    <span class="ef-hero-chip @(_id is null ? "badge-new" : PayStatusBadge(_paymentStatus))">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 6v6l4 2" stroke-linecap="round"/>
                        </svg>
                        @(_id is null ? "جديد" : PayAr(_paymentStatus))
                    </span>
                    <span class="ef-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

        </div>

        @* ── Treasury Status Strip ── *@
        @if (!_loading)
        {
            <div class="ex-treasury-strip">

                <div class="ex-treasury-checks">
                    <div class="ex-chk @(_stApproved ? "chk-on" : "chk-off")">
                        <div class="ex-chk-dot" aria-hidden="true"></div>
                        <span>معتمد</span>
                    </div>
                    <div class="ex-chk-arrow" aria-hidden="true">→</div>
                    <div class="ex-chk @(_stPaid ? "chk-on" : "chk-off")">
                        <div class="ex-chk-dot" aria-hidden="true"></div>
                        <span>مدفوع</span>
                    </div>
                    <div class="ex-chk-arrow" aria-hidden="true">→</div>
                    <div class="ex-chk @(_stNoCustody ? "chk-on" : "chk-off")">
                        <div class="ex-chk-dot" aria-hidden="true"></div>
                        <span>غير مرتبط بعُهدة</span>
                    </div>
                    <div class="ex-chk-arrow" aria-hidden="true">→</div>
                    <div class="ex-chk @(_stCash ? "chk-on" : "chk-off")">
                        <div class="ex-chk-dot" aria-hidden="true"></div>
                        <span>نقدي</span>
                    </div>
                </div>

                <div class="ex-treasury-result @(_willTreasury ? "result-yes" : "result-no")">
                    @if (_willTreasury)
                    {
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>يُقيَّد في الخزينة</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                        </svg>
                        <span>لا يُقيَّد في الخزينة</span>
                    }
                </div>

            </div>
        }

    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="ex-body">

    @* No Permission *@
    @if (!CanSave)
    {
        <div class="ex-state-box">
            <div class="ex-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>@(_id is null ? "ليس لديك صلاحية تسجيل مصروف" : "ليس لديك صلاحية تعديل مصروف")</p>
            <button class="ex-state-back" @onclick="GoBack">العودة للقائمة</button>
        </div>
    }

    @* Loading *@
    else if (_loading)
    {
        <div class="ex-loading-wrap">
            <div class="ex-spinner" aria-label="جاري التحميل"></div>
            <div class="ex-loading-text">جاري تحميل بيانات المصروف...</div>
        </div>
    }

    @* Main Form *@
    else
    {
        @* Cancelled Banner *@
        @if (_cancelled)
        {
            <div class="ex-cancelled-banner" role="alert">
                <div class="cancelled-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="cancelled-text">
                    <strong>المصروف ملغي</strong>
                    <span>هذا المصروف ملغى ولا يمكن تعديله</span>
                </div>
            </div>
        }

        @* Error/Success Banner *@
        @if (_msg is not null)
        {
            <div class="ex-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                <div aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="banner-close" @onclick="() => _msg = null" aria-label="إغلاق التنبيه">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
                             stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
            </div>
        }

        @* Treasury Reason Card *@
        <div class="ex-treasury-card @(_willTreasury ? "treasury-yes" : "treasury-no")">
            <div class="treasury-card-icon" aria-hidden="true">
                @if (_willTreasury)
                {
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        <circle cx="12" cy="14" r="2"/>
                        <path d="M12 16v2" stroke-linecap="round"/>
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                    </svg>
                }
            </div>
            <div class="treasury-card-text">
                <strong>
                    @(_willTreasury
                        ? "يُقيَّد هذا المصروف في الخزينة تلقائيًا"
                        : "لا يُقيَّد هذا المصروف في الخزينة")
                </strong>
                <span>@TreasuryReason</span>
            </div>
        </div>


        @* ═══════ SECTIONS ═══════ *@
        <div class="ex-tabs-wrap">

            @* ══════════════════════════════════════
               القسم ١ — بيانات المصروف
            ══════════════════════════════════════ *@
            <div class="tab-section">

                <div class="tab-section-head">
                    <div class="tab-section-icon blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div>
                        <div class="tab-section-title">بيانات المصروف</div>
                        <div class="tab-section-sub">نوع المصروف وقيمته وتاريخه</div>
                    </div>
                </div>

                <div class="ex-form-grid">
                                <div class="ex-row-top @(CurrentType?.IsReceiptRequired == true ? "has-rcpt" : "")">
                                @* التاريخ *@
                                <div class="form-field">
                                    <label class="field-label">التاريخ</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input type="datetime-local"
                                               class="field-input with-prefix"
                                               value="@_f.ExpenseDate"
                                               @onchange="e => _f.ExpenseDate = e.Value?.ToString()" />
                                    </div>
                                </div>

                                @* نوع المصروف *@
                                <div class="form-field">
                                    <label class="field-label">
                                        نوع المصروف
                                        <span class="field-required">*</span>
                                    </label>
                                    <div class="ex-type-row">
                                    <div class="form-field-with-dropdown ex-rcpt-grow">
                                        <div class="field-select-wrap">
                                            <svg class="field-select-icon" viewBox="0 0 24 24"
                                                 width="14" height="14" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                                <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                                            </svg>
                                            <input class="field-input field-select @(_f.ExpenseTypeId <= 0 && _triedSave ? "field-error" : "")"
                                                   value="@TypeText"
                                                   placeholder="ابحث عن النوع..."
                                                   @oninput="OnTypeSearch"
                                                   @onfocus="() => { _showTypeDd = true; _filteredTypes = FilterList(_types, x => x.Label, _typeSearch); }"
                                                   @onfocusout="() => _showTypeDd = false"
                                                   aria-required="true" />
                                        </div>
                                        @if (_showTypeDd && _filteredTypes.Count > 0)
                                        {
                                            <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                @foreach (var t in _filteredTypes)
                                                {
                                                    <div class="field-dropdown-item" @onmousedown="() => PickType(t)">@t.Label</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (_f.ExpenseTypeId > 0)
                                    {
                                        <button type="button" class="ex-type-btn ex-type-clear" @onclick="ClearType"
                                                title="مسح النوع والبحث من جديد" aria-label="مسح نوع المصروف">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4">
                                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                                            </svg>
                                        </button>
                                    }
                                    <button type="button" class="ex-type-btn" @onclick="() => _typeAdding = !_typeAdding"
                                            title="إضافة نوع مصروف جديد" aria-label="إضافة نوع مصروف جديد">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                        </svg>
                                    </button>
                                    </div>
                                    @if (_typeAdding)
                                    {
                                        <div class="ex-rcpt-new">
                                            <input class="field-input" @bind="_typeNewName" maxlength="100"
                                                   placeholder="اسم نوع المصروف الجديد" />
                                            <input class="field-input" @bind="_typeNewCode" maxlength="30"
                                                   placeholder="الكود (اختياري)" />
                                            <button type="button" class="ex-rcpt-save" @onclick="AddExpenseTypeAsync" disabled="@_typeSaving">
                                                @(_typeSaving ? "جارٍ الحفظ..." : "حفظ")
                                            </button>
                                        </div>
                                    }
                                    @if (CurrentType is not null)
                                    {
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            @TypeHint
                                        </div>
                                    }
                                    @if (_f.ExpenseTypeId <= 0 && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">اختيار نوع المصروف مطلوب</div>
                                    }
                                </div>

                                @* نوع الإيصال — يظهر لأنواع المصروفات الموسومة «يستدعي إيصالًا» *@
                                @if (CurrentType?.IsReceiptRequired == true)
                                {
                                    <div class="form-field">
                                        <label class="field-label">
                                            نوع الإيصال
                                            <span class="field-required">*</span>
                                        </label>
                                        <div class="ex-rcpt-row">
                                            <div class="form-field-with-dropdown ex-rcpt-grow">
                                                <div class="field-select-wrap">
                                                    <svg class="field-select-icon" viewBox="0 0 24 24"
                                                         width="14" height="14" fill="none"
                                                         stroke="currentColor" stroke-width="2"
                                                         aria-hidden="true">
                                                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                                    </svg>
                                                    <input class="field-input field-select"
                                                           value="@ReceiptText"
                                                           placeholder="ابحث عن نوع الإيصال..."
                                                           @oninput="OnReceiptSearch"
                                                           @onfocus="() => { _showRcptDd = true; _filteredRcpts = FilterList(_receiptTypes, x => x.Label, _rcptSearch); }"
                                                           @onfocusout="() => _showRcptDd = false" />
                                                </div>
                                                @if (_showRcptDd && _filteredRcpts.Count > 0)
                                                {
                                                    <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                        <div class="field-dropdown-item" @onmousedown="ClearReceipt">— من غير نوع —</div>
                                                        @foreach (var r in _filteredRcpts)
                                                        {
                                                            <div class="field-dropdown-item" @onmousedown="() => PickReceipt(r)">@r.Label</div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <button type="button" class="ex-rcpt-add-btn" @onclick="() => _rcptAdding = !_rcptAdding"
                                                    title="إضافة نوع إيصال جديد" aria-label="إضافة نوع إيصال جديد">
                                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2">
                                                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                                </svg>
                                            </button>
                                        </div>
                                        @if (_rcptAdding)
                                        {
                                            <div class="ex-rcpt-new">
                                                <input class="field-input" @bind="_rcptNewName" maxlength="100"
                                                       placeholder="اسم نوع الإيصال الجديد" />
                                                <input class="field-input" @bind="_rcptNewCode" maxlength="30"
                                                       placeholder="الكود (اختياري)" />
                                                <button type="button" class="ex-rcpt-save" @onclick="AddReceiptTypeAsync" disabled="@_rcptSaving">
                                                    @(_rcptSaving ? "جارٍ الحفظ..." : "حفظ")
                                                </button>
                                            </div>
                                        }
                                        <div class="field-hint">نوع هذا المصروف يستدعي إيصالًا — اختر نوعه، ورقمه في حقل «رقم مرجعي» بالأعلى</div>
                                    </div>
                                }

                                </div>
                                <div class="ex-row-3">
                                @* المبلغ *@
                                <div class="form-field">
                                    <label class="field-label">
                                        المبلغ
                                        <span class="field-required">*</span>
                                    </label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                        <input type="number" min="0.01" step="0.01"
                                               class="field-input with-prefix @(_f.Amount <= 0 && _triedSave ? "field-error" : "")"
                                               value="@_f.Amount"
                                               placeholder="0.00"
                                               @onchange="e => _f.Amount = ParseAmount(e.Value)"
                                               aria-required="true" />
                                    </div>
                                    @if (_f.Amount <= 0 && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">يجب أن يكون المبلغ أكبر من صفر</div>
                                    }
                                </div>

                                @* 🔴 القيمة المحمّلة على العميل *@
                                <div class="form-field">
                                    <label class="field-label">القيمة المحمّلة على العميل</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                        <input type="number" min="0" step="0.01"
                                               class="field-input with-prefix"
                                               value="@_f.BillableAmount"
                                               placeholder="0.00"
                                               @onchange="e => _f.BillableAmount = ParseAmount(e.Value)" />
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        القيمة المُحصَّلة من العميل — عند تركها صفرًا لا يُحمَّل المصروف على الفاتورة
                                    </div>
                                </div>

                                @* طريقة الدفع *@
                                <div class="form-field">
                                    <label class="field-label">طريقة الدفع</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <rect x="1" y="4" width="22" height="16" rx="2"/>
                                            <path d="M1 10h22"/>
                                        </svg>
                                        <select class="field-input field-select" @bind="_f.PaymentMethodId">
                                            <option value="">— لم يتم التحديد —</option>
                                            @foreach (var m in _methods)
                                            {
                                                <option value="@m.Id">@m.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        يُقيَّد الدفع النقدي في الخزينة تلقائيًا دون غيره
                                    </div>
                                </div>

                                </div>
                                @* رقم مرجعي *@
                                <div class="form-field">
                                    <label class="field-label">رقم مرجعي</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M4 7V4h16v3M9 20h6M12 4v16" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input class="field-input with-prefix"
                                               @bind="_f.ReferenceNumber"
                                               maxlength="100"
                                               placeholder="رقم الإيصال أو الفاتورة" />
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        رقم الإيصال أو فاتورة المورد
                                    </div>
                                </div>

                                @* البيان *@
                                <div class="form-field form-field-full">
                                    <label class="field-label">البيان</label>
                                    <input class="field-input"
                                           @bind="_f.Description"
                                           maxlength="500"
                                           placeholder="وصف مختصر للمصروف..." />
                                </div>

                </div>
            </div>

            @* ══════════════════════════════════════
               القسم ٢ — مصدر المال والربط
            ══════════════════════════════════════ *@
            <div class="tab-section">

                <div class="tab-section-head">
                    <div class="tab-section-icon amber" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                            <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
                        </svg>
                    </div>
                    <div>
                        <div class="tab-section-title">مصدر المال والربط</div>
                        <div class="tab-section-sub">اختر العهدة التي خرج منها المال، والعملية أو الرحلة إن عُرفتا الآن — ويمكن استكمال الربط وقت تسوية العهدة</div>
                    </div>
                </div>

                <div class="ex-form-grid">
                                    @* العملية *@
                                    <div class="form-field">
                                        <label class="field-label">العملية</label>
                                        <div class="form-field-with-dropdown">
                                            <div class="field-select-wrap">
                                                <svg class="field-select-icon" viewBox="0 0 24 24"
                                                     width="14" height="14" fill="none"
                                                     stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                                </svg>
                                                <input class="field-input field-select"
                                                       value="@OpText"
                                                       placeholder="ابحث عن العملية..."
                                                       @oninput="OnOpSearch"
                                                       @onfocus="() => { _showOpDd = true; _filteredOps = FilterList(_operations, OpSearchText, _opSearch); }"
                                                       @onfocusout="() => _showOpDd = false" />
                                            </div>
                                            @if (_showOpDd)
                                            {
                                                <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                    <div class="field-dropdown-item" @onmousedown="ClearOp">— بدون عملية —</div>
                                                    @foreach (var o in _filteredOps)
                                                    {
                                                        <div class="field-dropdown-item" @onmousedown="() => PickOp(o)">@OpLabel(o)</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            يدخل المصروف في تكلفة العملية عند ربطه بها — ويمكن إتمام الربط وقت تسوية العهدة
                                        </div>
                                    </div>

                                    @* مصدر المال: بعهدة؟ *@
                                    <div class="form-field">
                                        <label class="field-label">مصدر المال</label>
                                        <label class="ex-custody-toggle @(_withCustody ? "on" : "")">
                                            <input type="checkbox" @bind="_withCustody" />
                                            <span>مصروف من عهدة</span>
                                        </label>
                                        <div class="field-hint">فعّلها إن خرج المال من عهدة مفتوحة — واختر العهدة من القائمة المجاورة</div>
                                    </div>

@if (_withCustody)
                                    {
                                    @* العهدة *@
                                    <div class="form-field">
                                        <label class="field-label">العهدة</label>
                                        @if (!_custodies.Any())
                                        {
                                            <div class="ex-custody-hint">
                                                لا توجد عُهد مفتوحة حاليًا
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="field-select-wrap">
                                                <svg class="field-select-icon" viewBox="0 0 24 24"
                                                     width="14" height="14" fill="none"
                                                     stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                    <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                                </svg>
                                                <select class="field-input field-select"
                                                        value="@_f.CustodyId"
                                                        @onchange="OnCustodyChanged">
                                                    <option value="">— بدون عهدة (دفع مباشر) —</option>
                                                    @foreach (var c in _custodies)
                                                    {
                                                        <option value="@c.Id">@c.Label — @Money(c.AmountIssued) ج.م</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            المصروف المرتبط بعهدة صُرفت قيمته عند صرف العهدة ولا يُحتسب في الخزينة مرة أخرى
                                        </div>
                                    </div>

                                    }

                                    @* الرحلة *@
                                    <div class="form-field">
                                        <label class="field-label">الرحلة</label>
                                        <div class="form-field-with-dropdown">
                                            <div class="field-select-wrap">
                                                <svg class="field-select-icon" viewBox="0 0 24 24"
                                                     width="14" height="14" fill="none"
                                                     stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                                </svg>
                                                <input class="field-input field-select"
                                                       value="@TripText"
                                                       placeholder="ابحث عن الرحلة..."
                                                       @oninput="OnTripSearch"
                                                       @onfocus="() => { _showTripDd = true; _filteredTrips = FilterList(_trips, TripLabel, _tripSearch); }"
                                                       @onfocusout="() => _showTripDd = false" />
                                            </div>
                                            @if (_showTripDd)
                                            {
                                                <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                    <div class="field-dropdown-item" @onmousedown="ClearTrip">— بدون رحلة —</div>
                                                    @foreach (var t in _filteredTrips)
                                                    {
                                                        <div class="field-dropdown-item" @onmousedown="() => PickTrip(t)">@TripLabel(t)</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                </div>
            </div>

            @* ══════════════════════════════════════
               القسم ٣ — تفاصيل إضافية (مطوي افتراضيًا)
            ══════════════════════════════════════ *@
            <div class="tab-section">

                <div class="tab-section-head">
                    <div class="tab-section-icon green" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="1" y="4" width="22" height="16" rx="2"/>
                            <path d="M1 10h22"/>
                        </svg>
                    </div>
                    <div>
                        <div class="tab-section-title">تفاصيل إضافية</div>
                        <div class="tab-section-sub">الضريبة وقابليتها للخصم والمورد — عند الحاجة فقط</div>
                    </div>
                    <button type="button" class="ex-more-toggle" @onclick="() => _showMore = !_showMore"
                            aria-expanded="@_showMore">
                        @(_showMore ? "إخفاء" : "عرض")
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                             style="transform: rotate(@(_showMore ? 180 : 0)deg)" aria-hidden="true">
                            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>

                @if (_showMore)
                {
                    <div class="ex-form-grid">
                                @* الضريبة *@
                                <div class="form-field">
                                    <label class="field-label">الضريبة</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M20 12V22H4V12M22 7H2v5h20V7zM12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
                                        </svg>
                                        <select class="field-input field-select" @bind="_f.TaxRateId">
                                            <option value="">بدون ضريبة</option>
                                            @foreach (var t in _taxRates)
                                            {
                                                <option value="@t.Id">@t.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                @* قابلة للخصم *@
                                <div class="form-field">
                                    <label class="field-label">الضريبة قابلة للخصم</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <select class="field-input field-select" @bind="_f.IsTaxDeductible">
                                            <option value="true">نعم — ضريبة قابلة للخصم</option>
                                            <option value="false">لا — ضريبة غير قابلة للخصم</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-field">
                                    <label class="field-label">ضريبة القيمة المحمّلة %</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">%</span>
                                        <input type="number" min="0" max="100" step="0.01"
                                               class="field-input with-prefix"
                                               value="@_f.BillableTaxRate"
                                               placeholder="0"
                                               @onchange="e => _f.BillableTaxRate = ParseAmount(e.Value)" />
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        صفر تعني غير ضريبية (الافتراضي)
                                    </div>
                                </div>

                                @* المورد *@
                                <div class="form-field">
                                    <label class="field-label">المورد</label>
                                    <div class="form-field-with-dropdown">
                                        <div class="field-select-wrap">
                                            <svg class="field-select-icon" viewBox="0 0 24 24"
                                                 width="14" height="14" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                                <path d="M9 22V12h6v10"/>
                                            </svg>
                                            <input class="field-input field-select"
                                                   value="@SupText"
                                                   placeholder="ابحث عن المورد..."
                                                   @oninput="OnSupSearch"
                                                   @onfocus="() => { _showSupDd = true; _filteredSups = FilterList(_suppliers, x => x.Label, _supSearch); }"
                                                   @onfocusout="() => _showSupDd = false" />
                                        </div>
                                        @if (_showSupDd)
                                        {
                                            <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                <div class="field-dropdown-item" @onmousedown="ClearSup">— بدون مورد —</div>
                                                @foreach (var s in _filteredSups)
                                                {
                                                    <div class="field-dropdown-item" @onmousedown="() => PickSup(s)">@s.Label</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                    </div>
                                @* الإجمالي *@
                                @if (_f.Amount > 0 && _f.TaxRateId is not null)
                                {
                                    <div class="form-field">
                                        <label class="field-label">الإجمالي بعد الضريبة</label>
                                        <div class="ex-total-display">
                                            <span class="ex-total-num">@Money(TotalWithTax)</span>
                                            <span class="ex-total-curr">ج.م</span>
                                        </div>
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            المبلغ + الضريبة المحسوبة تلقائياً
                                        </div>
                                    </div>
                                }

                            @* Payment Method Visual *@
                            @if (CurrentMethod is not null)
                            {
                                <div class="ex-method-card @(CurrentMethod.IsCashBased ? "method-cash" : "method-noncash")">
                                    <div class="method-card-icon" aria-hidden="true">
                                        @if (CurrentMethod.IsCashBased)
                                        {
                                            <svg viewBox="0 0 24 24" width="20" height="20"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                                <circle cx="12" cy="14" r="2"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" width="20" height="20"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="1" y="4" width="22" height="16" rx="2"/>
                                                <path d="M1 10h22"/>
                                            </svg>
                                        }
                                    </div>
                                    <div class="method-card-text">
                                        <strong>@CurrentMethod.Label</strong>
                                        <span>
                                            @(CurrentMethod.IsCashBased
                                                ? "طريقة نقدية — المصروف هيدخل الخزينة لو باقي الشروط اتحققت"
                                                : "طريقة غير نقدية — لا يُقيَّد المصروف في الخزينة حتى بعد التأكيد")
                                        </span>
                                    </div>
                                </div>
                            }

                }

            </div>

        </div>


        @* ── Bottom Actions ── *@
        <div class="ex-bottom-actions">

            <button class="ex-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                العودة للقائمة
            </button>

            @if (CanSave)
            {
                <div class="ex-bottom-right">

                    <button class="ex-draft-bottom-btn"
                            @onclick="() => SaveAsync(true)"
                            disabled="@_saving">
                        <svg viewBox="0 0 24 24" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M12 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M12 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                        حفظ كمسودة
                    </button>

                    <button class="ex-confirm-btn"
                            @onclick="() => SaveAsync(false)"
                            disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ وتأكيد</span>
                        }
                    </button>

                </div>
            }

        </div>

    }
</div>


@* ═══════════════════════════════════════════
   CSS
═══════════════════════════════════════════ *@


<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       HERO ADDITIONS
    ================================================================ */
    .ex-hero-badge {
        display: inline-flex; align-items: center;
        padding: 3px 10px; border-radius: 20px;
        font-size: 11px; font-weight: 800;
    }

    .badge-new     { background: rgba(34,197,94,.2);  color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-unpaid  { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); border: 1px solid rgba(255,255,255,.2); }
    .badge-partial { background: rgba(234,179,8,.25); color: #fde68a; border: 1px solid rgba(234,179,8,.3); }
    .badge-paid    { background: rgba(34,197,94,.25); color: #86efac; border: 1px solid rgba(34,197,94,.3); }

    /* Treasury Strip */
    .ex-treasury-strip {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; flex-wrap: wrap;
        padding: 10px 14px;
        background: rgba(0,0,0,.12); border: 1px solid rgba(255,255,255,.10);
        border-radius: 10px; backdrop-filter: blur(8px);
        margin-top: 4px;
    }

    .ex-treasury-checks { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    .ex-chk {
        display: flex; align-items: center; gap: 5px;
        font-size: 10.5px; font-weight: 700;
    }

    .ex-chk-dot {
        width: 8px; height: 8px; border-radius: 50%; flex: 0 0 8px;
        border: 2px solid;
        transition: all .2s ease;
    }

    .chk-on  { color: #6ee7b7; }
    .chk-on .ex-chk-dot { background: #6ee7b7; border-color: #6ee7b7; }
    .chk-off { color: rgba(255,255,255,.35); }
    .chk-off .ex-chk-dot { background: transparent; border-color: rgba(255,255,255,.25); }

    .ex-chk-arrow { color: rgba(255,255,255,.2); font-size: 12px; font-weight: 700; }

    .ex-treasury-result {
        display: flex; align-items: center; gap: 6px;
        padding: 5px 12px; border-radius: 8px;
        font-size: 11px; font-weight: 800; white-space: nowrap;
    }

    .result-yes { background: rgba(34,197,94,.2); color: #6ee7b7; border: 1px solid rgba(34,197,94,.25); }
    .result-no  { background: rgba(255,255,255,.08); color: rgba(255,255,255,.55); border: 1px solid rgba(255,255,255,.12); }

    /* Hero Buttons */
    .ex-back-btn {
        display: inline-flex; align-items: center; gap: 5px;
        height: 36px; padding: 0 13px;
        border: 1px solid rgba(255,255,255,.2); border-radius: 9px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .ex-back-btn:hover { background: rgba(255,255,255,.14); }
    .ex-back-btn svg  { transform: rotate(180deg); }

    .ex-draft-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 14px;
        border: 1px solid rgba(255,255,255,.20); border-radius: 9px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .ex-draft-btn:hover:not(:disabled) { background: rgba(255,255,255,.14); }
    .ex-draft-btn:disabled { opacity: .5; cursor: not-allowed; }

    .ex-save-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 18px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .ex-save-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }
    .ex-save-btn:disabled { opacity: .6; cursor: not-allowed; }

    /* ================================================================
       BODY
    ================================================================ */
    .ex-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 180px);
        padding: 18px clamp(16px, 3vw, 40px) 96px;
        max-width: 1440px; width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* ── Hero (نفس مرجع InvoiceForm) ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }
    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow: 0 12px 32px rgba(13, 38, 84, 0.15), 0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }
    .ef-hero-row {
