    private static string OpLabel(OpOpt o)     => o.OperationNumber + " — " + o.CustomerName
        + (string.IsNullOrWhiteSpace(o.BookingReference) ? "" : $" — حجز وكيل {o.BookingReference}");
    private static string OpSearchText(OpOpt o) => OpLabel(o) + " " + (o.BookingReference ?? "");
    private static string TripLabel(TripOpt t) => t.TripNumber + " — " + t.DriverName;

    private string TypeText =>
        !_typeTouched && _f.ExpenseTypeId > 0
            ? (_types.FirstOrDefault(x => x.Id == _f.ExpenseTypeId)?.Label ?? "")
            : _typeSearch;

    private string OpText =>
        !_opTouched && _f.OperationId is not null
            ? (_operations.FirstOrDefault(x => x.OperationId == _f.OperationId) is { } o ? OpLabel(o) : "")
            : _opSearch;

    private string TripText =>
        !_tripTouched && _f.TripId is not null
            ? (_trips.FirstOrDefault(x => x.TripId == _f.TripId) is { } tr ? TripLabel(tr) : "")
            : _tripSearch;

    private string SupText =>
        !_supTouched && _f.SupplierId is not null
            ? (_suppliers.FirstOrDefault(x => x.Id == _f.SupplierId)?.Label ?? "")
            : _supSearch;

    private void OnTypeSearch(ChangeEventArgs e)
    {
