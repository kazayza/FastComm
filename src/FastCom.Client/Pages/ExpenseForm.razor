    private bool _rcptTouched, _rcptAdding, _rcptSaving;
    private bool _typeAdding, _typeSaving;
    private string _typeNewName = "", _typeNewCode = "";
    private string _rcptSearch = "", _rcptNewName = "", _rcptNewCode = "";
    private List<Opt> _filteredRcpts = new();
    private bool _typeTouched, _opTouched, _tripTouched, _supTouched;
    private string _typeSearch = "", _opSearch = "", _tripSearch = "", _supSearch = "";
    private List<ExpType> _filteredTypes = new();
    private List<OpOpt>   _filteredOps   = new();
