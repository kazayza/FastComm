        _filteredTypes = FilterList(_types, x => x.Label, _typeSearch);
    }

    private void OnOpSearch(ChangeEventArgs e)
    {
        _opSearch = e.Value?.ToString() ?? ""; _opTouched = true; _showOpDd = true;
        _filteredOps = FilterList(_operations, OpSearchText, _opSearch);
    }

    private void OnTripSearch(ChangeEventArgs e)
    {
        _tripSearch = e.Value?.ToString() ?? ""; _tripTouched = true; _showTripDd = true;
        _filteredTrips = FilterList(_trips, TripLabel, _tripSearch);
    }

    private void OnSupSearch(ChangeEventArgs e)
    {
        _supSearch = e.Value?.ToString() ?? ""; _supTouched = true; _showSupDd = true;
        _filteredSups = FilterList(_suppliers, x => x.Label, _supSearch);
    }

    private void PickType(ExpType t)
    {
        _showTypeDd = false; _typeTouched = true; _typeSearch = t.Label;
        _f.ExpenseTypeId = t.Id;
        _f.IsTaxDeductible = t.IsTaxDeductible;
        if (t.IsFreightAdvance) _withCustody = true;
    }

    private void PickOp(OpOpt o)
    { _showOpDd = false; _opTouched = true; _opSearch = OpLabel(o); _f.OperationId = o.OperationId; }

    private void ClearOp()
    { _showOpDd = false; _opTouched = true; _opSearch = ""; _f.OperationId = null; }

    /* اختيار الرحلة = نفس منطق #24/#29: العهد بتتحمل + العملية تتحدد تلقائي */
    private async Task PickTrip(TripOpt t)
    {
        _showTripDd = false; _tripTouched = true; _tripSearch = TripLabel(t);
        _f.TripId    = t.TripId;
        await LoadCustodiesAsync();

        var rops = await SafeGetT<OpOpt>($"api/options/trip-operations?tripId={t.TripId}");
        if (rops.Count > 0 && !rops.Any(o => o.OperationId == _f.OperationId))
        {
            _f.OperationId = rops[0].OperationId;
            _opTouched = false; _opSearch = "";
        }
    }

    private async Task ClearTrip()
    {
        _showTripDd = false; _tripTouched = true; _tripSearch = "";
        _f.TripId    = null;
        await LoadCustodiesAsync();
    }

    private string ReceiptText =>
        !_rcptTouched && _f.ReceiptTypeId is not null
            ? (_receiptTypes.FirstOrDefault(x => x.Id == _f.ReceiptTypeId)?.Label ?? "")
            : _rcptSearch;

    private void OnReceiptSearch(ChangeEventArgs e)
    {
        _rcptSearch = e.Value?.ToString() ?? ""; _rcptTouched = true; _showRcptDd = true;
        _filteredRcpts = FilterList(_receiptTypes, x => x.Label, _rcptSearch);
    }

    private void PickReceipt(Opt r)
    { _showRcptDd = false; _rcptTouched = true; _rcptSearch = r.Label; _f.ReceiptTypeId = r.Id; }

    private void ClearReceipt()
    { _showRcptDd = false; _rcptTouched = true; _rcptSearch = ""; _f.ReceiptTypeId = null; }

    private async Task AddReceiptTypeAsync()
    {
        if (string.IsNullOrWhiteSpace(_rcptNewName)) { Snackbar.Add("اكتب اسم نوع الإيصال", Severity.Warning); return; }
        _rcptSaving = true;
        try
        {
            var code = string.IsNullOrWhiteSpace(_rcptNewCode)
                ? "RC-" + DateTime.Now.ToString("HHmmss")
                : _rcptNewCode.Trim();
            var res = await Http.PostAsJsonAsync("api/receipt-types", new
            {
                code, nameAr = _rcptNewName.Trim(), nameEn = (string?)null, isActive = true
            });
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode)
            {
                _receiptTypes = await SafeGetT<Opt>("api/options/receipt-types");
                var created = _receiptTypes.FirstOrDefault(x => x.Label == _rcptNewName.Trim());
                if (created is not null) PickReceipt(created);
                _rcptNewName = ""; _rcptNewCode = ""; _rcptAdding = false;
            }
        }
        catch (Exception ex) { Snackbar.Add("فشل الإضافة: " + ex.Message, Severity.Error); }
        finally { _rcptSaving = false; }
    }

    private void ClearType()
    {
        _showTypeDd = false; _typeTouched = true; _typeSearch = "";
        _f.ExpenseTypeId = 0;
    }

    private async Task AddExpenseTypeAsync()
    {
        if (string.IsNullOrWhiteSpace(_typeNewName)) { Snackbar.Add("اكتب اسم نوع المصروف", Severity.Warning); return; }
        _typeSaving = true;
        try
        {
            var code = string.IsNullOrWhiteSpace(_typeNewCode)
                ? "EXP-" + DateTime.Now.ToString("HHmmss")
                : _typeNewCode.Trim();
            var res = await Http.PostAsJsonAsync("api/expense-types", new
            {
                code, nameAr = _typeNewName.Trim(), nameEn = (string?)null,
                isCustodyAllowed = true, isOperationCost = true, isTaxDeductible = true,
                isActive = true, isFreightAdvance = false, isReceiptRequired = false
            });
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode)
            {
                _types = await SafeGetT<ExpType>("api/options/expense-types");
                var created = _types.FirstOrDefault(x => x.Label == _typeNewName.Trim());
                if (created is not null) PickType(created);
                _typeNewName = ""; _typeNewCode = ""; _typeAdding = false;
            }
        }
        catch (Exception ex) { Snackbar.Add("فشل الإضافة: " + ex.Message, Severity.Error); }
        finally { _typeSaving = false; }
    }

    private void PickSup(Opt s)
    { _showSupDd = false; _supTouched = true; _supSearch = s.Label; _f.SupplierId = s.Id; }

    private void ClearSup()
    { _showSupDd = false; _supTouched = true; _supSearch = ""; _f.SupplierId = null; }

    private static List<T> FilterList<T>(List<T> src, Func<T, string> label, string search) =>
        string.IsNullOrWhiteSpace(search)
            ? src.Take(20).ToList()
            : src.Where(x => NormalizeArabic(label(x)).Contains(NormalizeArabic(search.Trim())))
                 .Take(20).ToList();

    private static string NormalizeArabic(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        return s
            .Replace('أ', 'ا').Replace('إ', 'ا').Replace('آ', 'ا').Replace('ٱ', 'ا')
            .Replace('ة', 'ه')
            .Replace('ى', 'ي')
            .Replace('ؤ', 'و')
            .Replace('ئ', 'ي');
    }

    private static decimal ParseAmount(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n > 0 ? n : 0m;

    private static string Money(decimal v) => v.ToString("N2");

    private static string PayAr(string p) => p switch
    {
        "Unpaid"        => "غير مدفوع",
        "PartiallyPaid" => "مدفوع جزئياً",
        "Paid"          => "مدفوع",
        _               => "غير مدفوع"
    };

    private static string PayStatusBadge(string p) => p switch
    {
        "Paid"          => "badge-paid",
        "PartiallyPaid" => "badge-partial",
        _               => "badge-unpaid"
    };

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم الحفظ" : "حصل خطأ — حاول تاني"; }
    }
