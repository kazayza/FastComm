                            <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                            <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>@(OperationId is null ? "إنشاء الطلب" : "حفظ الطلب")</span>
                    }
                </button>

            </div>
        </div>
    }
</div>

@code {
    [Parameter] public long? OperationId { get; set; }

    private AuthUser? _user;
    private bool CanViewFinancials => (_user?.IsAdmin ?? false) || (_user?.Can("OPERATION.VIEW_FINANCIALS") ?? false);
    private bool CanUse => OperationId is null
        ? (_user?.Can("OPERATION.CREATE") == true && _user?.Can("BOOKING.CREATE") == true)
        : (_user?.Can("OPERATION.EDIT") == true && _user?.Can("BOOKING.EDIT") == true);
    private bool CanEditContainerDetails => CanUse;
    private bool CanEditTrips => _user?.Can("TRIP.EDIT") ?? false;
    private bool CanTripCancel => _user?.Can("TRIP.CANCEL") ?? false;
    private bool CanTripCreate => _user?.Can("TRIP.CREATE") ?? false;

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    /* أنواع الحاويات بتيجي من السيرفر بمبلغ ضمانها — اختيار النوع بيعبّي الضمان */
    public class CTOpt { public int Id { get; set; } public string Label { get; set; } = ""; public decimal? GuaranteeAmount { get; set; } }
    private List<CTOpt> _containerTypes = new();

    private void OnLineTypeChange(LineRow ln, ChangeEventArgs e)
    {
        ln.ContainerTypeId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        var t = _containerTypes.FirstOrDefault(x => x.Id == ln.ContainerTypeId);
        if (t is null) ln.Guarantee = null;                          // رجع «اختر» — الضمان يتفضى
        else if (t.GuaranteeAmount is not null) ln.Guarantee = t.GuaranteeAmount;
    }

    private List<Opt> _agents = new(), _customers = new(), _services = new(), _ports = new(),
                      _destinations = new(), _tripTypes = new(), _suppliers = new(),
                      _guaranteeSuppliers = new(), _trailers = new();

    /* مورد الضمان متفلتر على «خدمات ميناء» (قرار المالك) — والمورّد المحفوظ
       على طلب قديم بيظهر حتى لو نوعه اتغير، عشان التعديل ما يضيّعوش */
    private List<Opt> GuaranteeOptions
    {
        get
        {
            var list = _guaranteeSuppliers.ToList();
            if (_f.GuaranteeSupplierId is int gid && gid > 0 && list.All(x => x.Id != gid))
            {
                var cur = _suppliers.FirstOrDefault(x => x.Id == gid);
                if (cur is not null) list.Insert(0, cur);
            }
            return list;
        }
    }

    /* ── التعيين: سائق/عربية بيتزاوجوا عن طريق المورد (قرار المالك) ── */
    public class PairOpt { public int Id { get; set; } public string Label { get; set; } = ""; public int? SupplierId { get; set; } public bool IsCompany { get; set; } public int? DefaultDriverId { get; set; } }
    private List<PairOpt> _driverPairs = new(), _vehiclePairs = new();

    private class TripRow
    {
        public int DriverId { get; set; }
        public int VehicleId { get; set; }
        public int? TrailerId { get; set; }
        public decimal? Freight { get; set; }
        public DateTime? PlannedStartAt { get; set; }

        /* حالة البحث في السائق/العربية */
        public string DriverSearch { get; set; } = "";
        public string VehicleSearch { get; set; } = "";
        public bool ShowDrivers { get; set; }
        public bool ShowVehicles { get; set; }
        public bool DriverTouched { get; set; }
        public bool VehicleTouched { get; set; }
        public List<PairOpt> FilteredDrivers { get; set; } = new();
        public List<PairOpt> FilteredVehicles { get; set; } = new();
    }

    private static List<PairOpt> FilterPairs(List<PairOpt> src, string search) =>
        string.IsNullOrWhiteSpace(search)
            ? src.Take(20).ToList()
            : src.Where(x => x.Label.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)).Take(20).ToList();

    private string DriverText(TripRow r) =>
        !r.DriverTouched && r.DriverId > 0
            ? (_driverPairs.FirstOrDefault(d => d.Id == r.DriverId)?.Label ?? "")
            : r.DriverSearch;

    private string VehicleText(TripRow r) =>
        !r.VehicleTouched && r.VehicleId > 0
            ? (_vehiclePairs.FirstOrDefault(v => v.Id == r.VehicleId)?.Label ?? "")
            : r.VehicleSearch;

    private void OnDriverSearch(TripRow r, ChangeEventArgs e)
    {
        r.DriverSearch = e.Value?.ToString() ?? "";
        r.DriverTouched = true;
        r.ShowDrivers = true;
        r.FilteredDrivers = FilterPairs(OrderedDriversFor(r), r.DriverSearch);
        if (string.IsNullOrWhiteSpace(r.DriverSearch)) r.DriverId = 0;
    }

    private void OnVehicleSearch(TripRow r, ChangeEventArgs e)
    {
        r.VehicleSearch = e.Value?.ToString() ?? "";
        r.VehicleTouched = true;
        r.ShowVehicles = true;
        r.FilteredVehicles = FilterPairs(OrderedVehiclesFor(r), r.VehicleSearch);
        if (string.IsNullOrWhiteSpace(r.VehicleSearch)) r.VehicleId = 0;
    }

    private void PickDriver(TripRow r, PairOpt d)
    {
        r.DriverId = d.Id;
        r.DriverSearch = d.Label;
        r.DriverTouched = false;
        r.ShowDrivers = false;
        AfterDriverPicked(r);
        /* التعبئة التلقائية للعربية من الربط لازم تنعكس في خانة بحثها */
        if (r.VehicleId > 0) { r.VehicleTouched = false; r.VehicleSearch = ""; }
    }

    private void PickVehicle(TripRow r, PairOpt v)
    {
        r.VehicleId = v.Id;
        r.VehicleSearch = v.Label;
        r.VehicleTouched = false;
        r.ShowVehicles = false;
        AfterVehiclePicked(r);
        if (r.DriverId > 0) { r.DriverTouched = false; r.DriverSearch = ""; }
    }
    private List<TripRow> _tripRows = new();

    private void AddTripRow() => _tripRows.Add(new TripRow
    {
        PlannedStartAt = DateTime.TryParse(_f.Date, out var d) ? d.AddHours(8) : DateTime.Today.AddHours(8)
    });

    private static string TripStatusAr(string s) => s switch
    {
        "Planned"         => "مخططة",
        "Assigned"        => "مُعيّنة",
        "DriverReceived"  => "استلم السائق",
        "Started"         => "في الطريق",
        "InTransit"       => "في الطريق",
        "Delivered"       => "تم التسليم",
        "ExpensesPending" => "بانتظار المصروفات",
        "CustodyPending"  => "بانتظار العهدة",
        "ReadyToClose"    => "جاهزة للإغلاق",
        "Completed"       => "مكتملة",
        "Closed"          => "مغلقة",
        "Cancelled"       => "ملغاة",
        _                 => s
    };

    private static bool SameSource(PairOpt a, PairOpt b) =>
        (a.IsCompany && b.IsCompany) ||
        (!a.IsCompany && !b.IsCompany && a.SupplierId is not null && a.SupplierId == b.SupplierId);

    private List<PairOpt> OrderedDriversFor(TripRow r)
    {
        var v = _vehiclePairs.FirstOrDefault(x => x.Id == r.VehicleId);
        if (v is null) return _driverPairs;
        return _driverPairs.OrderByDescending(p => SameSource(p, v) ? 1 : 0).ToList();
    }

    private List<PairOpt> OrderedVehiclesFor(TripRow r)
    {
        var d = _driverPairs.FirstOrDefault(x => x.Id == r.DriverId);
        if (d is null) return _vehiclePairs;
        return _vehiclePairs.OrderByDescending(p => SameSource(p, d) ? 1 : 0).ToList();
    }

    private void AfterDriverPicked(TripRow r)
    {
        var dr = _driverPairs.FirstOrDefault(x => x.Id == r.DriverId);
        if (dr is null) return;
        var cur = _vehiclePairs.FirstOrDefault(x => x.Id == r.VehicleId);
        if (cur is not null && SameSource(cur, dr)) return;
        var m = _vehiclePairs.Where(v => SameSource(v, dr)).ToList();
        if (m.Count == 1) r.VehicleId = m[0].Id;
    }

    private void AfterVehiclePicked(TripRow r)
    {
        var v = _vehiclePairs.FirstOrDefault(x => x.Id == r.VehicleId);
        if (v is null) return;
        var cur = _driverPairs.FirstOrDefault(x => x.Id == r.DriverId);
        if (cur is not null && SameSource(cur, v)) return;
        // السائق الافتراضي للسيارة يُقترح قبل قاعدة المرشح الوحيد
        if (v.DefaultDriverId is int dd && _driverPairs.Any(d => d.Id == dd)) { r.DriverId = dd; return; }
        var m = _driverPairs.Where(d => SameSource(d, v)).ToList();
        if (m.Count == 1) r.DriverId = m[0].Id;
    }

    private string ExistingDriverText(ExistingTrip t) => !t.DriverTouched && t.DriverId > 0 ? (_driverPairs.FirstOrDefault(d => d.Id == t.DriverId)?.Label ?? t.DriverName) : t.DriverSearch;
    private string ExistingVehicleText(ExistingTrip t) => !t.VehicleTouched && t.VehicleId > 0 ? (_vehiclePairs.FirstOrDefault(v => v.Id == t.VehicleId)?.Label ?? t.VehiclePlate) : t.VehicleSearch;
    private List<PairOpt> OrderedDriversForExisting(ExistingTrip t) { var v = _vehiclePairs.FirstOrDefault(x => x.Id == t.VehicleId); return v is null ? _driverPairs : _driverPairs.OrderByDescending(p => SameSource(p, v) ? 1 : 0).ToList(); }
    private List<PairOpt> OrderedVehiclesForExisting(ExistingTrip t) { var d = _driverPairs.FirstOrDefault(x => x.Id == t.DriverId); return d is null ? _vehiclePairs : _vehiclePairs.OrderByDescending(p => SameSource(p, d) ? 1 : 0).ToList(); }
    private void OnExistingDriverSearch(ExistingTrip t, ChangeEventArgs e) { t.DriverSearch = e.Value?.ToString() ?? ""; t.DriverTouched = true; t.ShowDrivers = true; t.FilteredDrivers = FilterPairs(OrderedDriversForExisting(t), t.DriverSearch); if (string.IsNullOrWhiteSpace(t.DriverSearch)) t.DriverId = 0; }
    private void OnExistingVehicleSearch(ExistingTrip t, ChangeEventArgs e) { t.VehicleSearch = e.Value?.ToString() ?? ""; t.VehicleTouched = true; t.ShowVehicles = true; t.FilteredVehicles = FilterPairs(OrderedVehiclesForExisting(t), t.VehicleSearch); if (string.IsNullOrWhiteSpace(t.VehicleSearch)) t.VehicleId = 0; }
    private void PickExistingDriver(ExistingTrip t, PairOpt d) { t.DriverId = d.Id; t.DriverSearch = d.Label; t.DriverTouched = false; t.ShowDrivers = false; var dr = _driverPairs.FirstOrDefault(x => x.Id == t.DriverId); if (dr is not null) { var cur = _vehiclePairs.FirstOrDefault(x => x.Id == t.VehicleId); if (cur is null || !SameSource(cur, dr)) { var m = _vehiclePairs.Where(v => SameSource(v, dr)).ToList(); if (m.Count == 1) t.VehicleId = m[0].Id; } } if (t.VehicleId > 0) { t.VehicleTouched = false; t.VehicleSearch = ""; t.VehiclePlate = _vehiclePairs.FirstOrDefault(v => v.Id == t.VehicleId)?.Label ?? t.VehiclePlate; } t.DriverName = d.Label; }
    private void PickExistingVehicle(ExistingTrip t, PairOpt v) { t.VehicleId = v.Id; t.VehicleSearch = v.Label; t.VehicleTouched = false; t.ShowVehicles = false; var cur = _driverPairs.FirstOrDefault(x => x.Id == t.DriverId); if (cur is null || !SameSource(cur, v)) { if (v.DefaultDriverId is int dd && _driverPairs.Any(d => d.Id == dd)) t.DriverId = dd; else { var m = _driverPairs.Where(d => SameSource(d, v)).ToList(); if (m.Count == 1) t.DriverId = m[0].Id; } } if (t.DriverId > 0) { t.DriverTouched = false; t.DriverSearch = ""; t.DriverName = _driverPairs.FirstOrDefault(d => d.Id == t.DriverId)?.Label ?? t.DriverName; } t.VehiclePlate = v.Label; }

    private async Task StartExistingTripAsync(ExistingTrip t)
    {
        try
        {
            var res = await Http.PostAsJsonAsync($"api/trips/{t.TripId}/start", new { actualStartAt = (string?)null, startOdometer = (string?)null });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode && OperationId is not null) _existingTrips = await SafeGetList<ExistingTrip>($"api/operations/{OperationId}/trips");
        }
        catch (Exception ex) { Snackbar.Add("فشل بدء الرحلة: " + ex.Message, Severity.Error); }
    }

    private async Task CompleteExistingTripAsync(ExistingTrip t)
    {
        try
        {
            var res = await Http.PostAsJsonAsync($"api/trips/{t.TripId}/complete", new { actualEndAt = (string?)null, endOdometer = (string?)null });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode && OperationId is not null) _existingTrips = await SafeGetList<ExistingTrip>($"api/operations/{OperationId}/trips");
        }
        catch (Exception ex) { Snackbar.Add("فشل إنهاء الرحلة: " + ex.Message, Severity.Error); }
    }

    private async Task RemoveTripAsync(ExistingTrip t)
    {
        try
        {
            HttpResponseMessage res;
            if (t.Status == "Planned")
                res = await Http.DeleteAsync($"api/trips/{t.TripId}");
            else
                res = await Http.PostAsync($"api/trips/{t.TripId}/cancel", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode && OperationId is not null)
                _existingTrips = await SafeGetList<ExistingTrip>($"api/operations/{OperationId}/trips");
        }
        catch (Exception ex) { Snackbar.Add("فشل حذف/إلغاء الرحلة: " + ex.Message, Severity.Error); }
    }

    public class ExistingTrip
    {
        public long TripId { get; set; } public string TripNumber { get; set; } = "";
        public int DriverId { get; set; } public int VehicleId { get; set; } public int? TrailerId { get; set; }
        public string DriverName { get; set; } = ""; public string VehiclePlate { get; set; } = "";
        public string Status { get; set; } = ""; public decimal? FreightAmount { get; set; }
        public DateTime? PlannedStartAt { get; set; } public int? TripTypeId { get; set; }
        public bool _editing;
        public string DriverSearch { get; set; } = ""; public bool DriverTouched; public bool ShowDrivers;
        public string VehicleSearch { get; set; } = ""; public bool VehicleTouched; public bool ShowVehicles;
        public List<PairOpt> FilteredDrivers { get; set; } = new();
        public List<PairOpt> FilteredVehicles { get; set; } = new();
    }
    private List<ExistingTrip> _existingTrips = new();

    private class LineRow
    {
        public int ContainerTypeId { get; set; }
        public int Qty { get; set; } = 1;
        public decimal? WeightKg { get; set; }
        public decimal? Guarantee { get; set; }
        public string? Notes { get; set; }
        public List<DetailRow> Details { get; set; } = new();
    }
    private class DetailRow
    {
        public long?    BookingContainerDetailId { get; set; }
        public long?    ContainerId              { get; set; }
        public string?  ContainerNumber          { get; set; }
