                                                        <path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/>
                                                        <circle cx="7" cy="17.5" r="1.8"/>
                                                        <circle cx="17" cy="17.5" r="1.8"/>
                                                    </svg>
                                                    <select class="field-input field-select" @bind="tr.TrailerId">
                                                        <option value="">— من غير مقطورة —</option>
                                                        @foreach (var t2 in _trailers)
