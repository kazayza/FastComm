@page "/transport-requests/new"
@page "/transport-requests/new/{OperationId:long}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(OperationId is null ? "طلب نقل جديد" : "تعديل طلب النقل") — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="bk-hero-row">
                <div class="bk-hero-left">
                    <div class="bk-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M13 2L3 14h7l-1 8 11-14h-8l1-6z" stroke-linejoin="round"/>
                        </svg>
                        <span>التشغيل · طلبات النقل</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">
                        @if (OperationId is null)
                        {
                            <span>طلب نقل جديد</span>
                        }
                        else
                        {
                            <span>@_opNumber</span>
                        }
                    </h1>
                    <span class="bk-hero-sub">سجّل الطلب من حجز الوكيل — الحجز وعمليته بيتنشأوا مع بعض</span>
                </div>

                <div class="bk-hero-right">
                    @if (OperationId is not null && !string.IsNullOrEmpty(_status))
                    {
                        <span class="bk-hero-chip">@StatusAr(_status)</span>
                    }
                    <span class="bk-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

            @* ── ملخص الطلب (يبان بس في التعديل) ── *@
            @if (OperationId is not null && !_loading)
            {
                <div class="bk-hero-summary">

                    <div class="bk-sum-item">
                        <div class="bk-sum-text">
                            <div class="bk-sum-label">العميل</div>
                            <div class="bk-sum-val">
                                @(_customers.FirstOrDefault(c => c.Id == _f.CustomerId)?.Label ?? "—")
                            </div>
                        </div>
                    </div>

                    <div class="bk-sum-div" aria-hidden="true"></div>

                    <div class="bk-sum-item">
                        <div class="bk-sum-text">
                            <div class="bk-sum-label">حجز الوكيل</div>
                            <div class="bk-sum-val">@(string.IsNullOrWhiteSpace(_f.BookingReference) ? "—" : _f.BookingReference)</div>
                        </div>
                    </div>

                    <div class="bk-sum-div" aria-hidden="true"></div>

                    <div class="bk-sum-item">
                        <div class="bk-sum-text">
                            <div class="bk-sum-label">الحاويات</div>
                            <div class="bk-sum-val">@_lines.Sum(l => l.Qty) حاوية</div>
                        </div>
                    </div>

                    <div class="bk-sum-div" aria-hidden="true"></div>

                    <div class="bk-sum-item">
                        <div class="bk-sum-text">
                            <div class="bk-sum-label">سعر البيع</div>
                            <div class="bk-sum-val">@(_f.UnitPrice?.ToString("N0") ?? "—") ج.م</div>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="bk-body">
    @if (!CanUse)
    {
        <div class="bk-state-box">
            <div class="bk-state-icon perm">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>إنشاء الطلب محتاج صلاحيات إنشاء الحجز والعملية، والتعديل محتاج صلاحيات تعديلهم.</p>
        </div>
    }
    else if (_loading)
    {
        <div class="bk-state-box"><h3>جاري التحميل…</h3></div>
    }
    else
    {
        <div class="bk-tabs-wrap">
        <MudTabs Elevation="0"
                 Rounded="false"
                 ApplyEffectsToContainer="true"
                 PanelClass="bk-tab-panel"
                 @bind-ActivePanelIndex="_activeTab"
                 Class="bk-mud-tabs">

            @* ══════════════════════════════════════
               TAB 1 — بيانات العميل
            ══════════════════════════════════════ *@
            <MudTabPanel>
                <TabContent>
                    <div class="btab-label">
                        <div class="btab-icon btab-blue" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                        </div>
                        <span>بيانات العميل</span>
                    </div>
                </TabContent>

                <ChildContent>
                    <div class="tab-section">

                        <div class="tab-section-head">
                            <div class="tab-section-icon blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <div>
                                <div class="tab-section-title">بيانات العميل</div>
                                <div class="tab-section-sub">العميل وجهة الاتصال والمرجع وتاريخ التنفيذ</div>
                            </div>
                        </div>

                        <div class="bk-form-grid">

                            @* العميل — بحث *@
                            <div class="form-field form-field-with-dropdown">
                                <label class="field-label" for="rf-customer">
                                    العميل
                                    <span class="field-required" aria-label="مطلوب">*</span>
                                </label>
                                <div class="field-input-group">
                                    <span class="field-prefix" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="11" cy="11" r="8"/>
                                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <input id="rf-customer"
                                           class="field-input with-prefix @(_f.CustomerId == 0 && _triedSave ? "field-error" : "")"
                                           value="@CustomerText"
                                           placeholder="ابحث بالاسم..."
                                           @oninput="OnCustomerSearch"
                                           @onfocus="() => { _showCustomerDropdown = true; _filteredCustomers = FilterOpts(_customers, _customerSearch); }"
                                           @onfocusout="() => _showCustomerDropdown = false"
                                           aria-required="true" />
                                </div>
                                @if (_showCustomerDropdown && _filteredCustomers.Count > 0)
                                {
                                    <div class="field-dropdown" @onmousedown:preventDefault="true">
                                        @foreach (var c in _filteredCustomers)
                                        {
                                            <div class="field-dropdown-item" @onmousedown="() => PickCustomer(c)">
                                                @c.Label
                                            </div>
                                        }
                                    </div>
                                }
                                @if (_f.CustomerId == 0 && _triedSave)
                                {
                                    <div class="field-err-msg" role="alert">اختيار العميل مطلوب</div>
                                }
                            </div>

                            @* العميل النهائي (اختياري) *@
                            <div class="form-field form-field-with-dropdown">
                                <label class="field-label" for="rf-endcustomer">العميل النهائي (اختياري)</label>
                                <div class="field-input-group">
                                    <span class="field-prefix" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="11" cy="11" r="8"/>
                                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <input id="rf-endcustomer"
                                           class="field-input with-prefix"
                                           value="@EndCustomerText"
                                           placeholder="ابحث بالاسم... (فاضي = نفس العميل)"
                                           @oninput="OnEndCustomerSearch"
                                           @onfocus="() => { _showEndCustomerDropdown = true; _filteredEndCustomers = FilterOpts(_customers, _endCustomerSearch); }"
                                           @onfocusout="() => _showEndCustomerDropdown = false" />
                                </div>
                                @if (_showEndCustomerDropdown && _filteredEndCustomers.Count > 0)
                                {
                                    <div class="field-dropdown" @onmousedown:preventDefault="true">
                                        @foreach (var c in _filteredEndCustomers)
                                        {
                                            <div class="field-dropdown-item" @onmousedown="() => PickEndCustomer(c)">
                                                @c.Label
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="field-hint">
                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                         aria-hidden="true">
                                        <circle cx="8" cy="8" r="6"/>
                                        <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                    </svg>
                                    سيبه فاضي لو العميل هو نفسه المستلم
                                </div>
                            </div>

                            @* جهة الاتصال *@
                            <div class="form-field">
                                <label class="field-label" for="rf-contact">جهة الاتصال</label>
                                <div class="field-select-wrap">
                                    <svg class="field-select-icon" viewBox="0 0 24 24"
                                         width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-4.99-5 19.79 19.79 0 01-3.07-8.67A2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                                    </svg>
                                    <select id="rf-contact"
                                            class="field-input field-select"
                                            @bind="_f.ContactId"
                                            disabled="@(_f.CustomerId == 0)">
                                        <option value="">—</option>
                                        @foreach (var c in _contacts)
                                        {
                                            <option value="@c.Id">@c.Label</option>
                                        }
                                    </select>
                                </div>
                                @if (_f.CustomerId == 0)
                                {
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        اختر العميل أولًا
                                    </div>
                                }
                            </div>

                            @* تاريخ التنفيذ المطلوب *@
                            <div class="form-field">
                                <label class="field-label" for="rf-reqdate">تاريخ التنفيذ المطلوب</label>
                                <div class="field-input-group">
                                    <span class="field-prefix" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <input id="rf-reqdate" type="date"
                                           class="field-input with-prefix"
                                           value="@_f.Date"
                                           @onchange="e => _f.Date = e.Value?.ToString() ?? _f.Date" />
                                </div>
                            </div>

                            @* مرجع العميل *@
                            <div class="form-field">
                                <label class="field-label" for="rf-custref">مرجع العميل</label>
                                <div class="field-input-group">
                                    <span class="field-prefix" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                                            <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <input id="rf-custref"
                                           class="field-input with-prefix"
                                           maxlength="100"
                                           placeholder="أمر توريد / بيان جمركي"
                                           @bind="_f.CustomerReference" />
                                </div>
                                <div class="field-hint">
                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                         aria-hidden="true">
                                        <circle cx="8" cy="8" r="6"/>
                                        <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                    </svg>
                                    الرقم الذي سجّله العميل نفسه لهذه العملية في مستنداته (أمر توريد أو بيان جمركي) — يُدوَّن ليتم أي استفسار أو مطابقة بذات الرقم لدى الطرفين
                                </div>
                            </div>

                        </div>
                    </div>
                </ChildContent>
            </MudTabPanel>


            @* ══════════════════════════════════════
               TAB 2 — بيانات النقل
            ══════════════════════════════════════ *@
            <MudTabPanel>
                <TabContent>
                    <div class="btab-label">
                        <div class="btab-icon btab-green" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="3" width="15" height="13" rx="2"/>
                                <path d="M16 8h4l3 3v5h-7V8z"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                        </div>
                        <span>بيانات النقل</span>
                    </div>
                </TabContent>

                <ChildContent>
                    <div class="tab-section">

                        <div class="tab-section-head">
                            <div class="tab-section-icon green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                </svg>
                            </div>
                            <div>
                                <div class="tab-section-title">بيانات النقل</div>
                                <div class="tab-section-sub">الخدمة ونوع الرحلة ومسار الشحن</div>
                            </div>
                        </div>

                        <div class="bk-form-grid">

                            @* رقم البوكينج الرسمي *@
                            <div class="form-field">
                                <label class="field-label" for="rf-bookingref">
                                    رقم البوكينج الرسمي
                                    <span class="field-required" aria-label="مطلوب">*</span>
                                </label>
                                <div class="field-input-group">
                                    <span class="field-prefix" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="4" width="18" height="16" rx="2"/>
                                            <path d="M7 8h10M7 12h10M7 16h6" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <input id="rf-bookingref"
                                           class="field-input with-prefix @(string.IsNullOrWhiteSpace(_f.BookingReference) && _triedSave ? "field-error" : "")"
                                           value="@_f.BookingReference"
                                           maxlength="100"
                                           placeholder="الرقم اللي الوكيل سلّمهولك"
                                           @onchange="e => _f.BookingReference = e.Value?.ToString() ?? string.Empty"
                                           aria-required="true" />
                                </div>
                                <div class="field-hint">
                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                         aria-hidden="true">
                                        <circle cx="8" cy="8" r="6"/>
                                        <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                    </svg>
                                    الرقم الرسمي من الوكيل الملاحي — زي ما هو في المستند
                                </div>
                                @if (string.IsNullOrWhiteSpace(_f.BookingReference) && _triedSave)
                                {
                                    <div class="field-err-msg" role="alert">رقم البوكينج الرسمي مطلوب</div>
                                }
                            </div>

                            @* رقم البوليصة (BL) *@
                            <div class="form-field">
                                <label class="field-label" for="rf-blnumber">رقم البوليصة (BL)</label>
                                <div class="field-input-group">
                                    <span class="field-prefix" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                            <path d="M14 2v6h6" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <input id="rf-blnumber"
                                           class="field-input with-prefix"
                                           @bind="_f.BLNumber" />
                                </div>
                            </div>

                            @* الخدمة *@
                            <div class="form-field">
                                <label class="field-label" for="rf-service">الخدمة</label>
                                <div class="field-select-wrap">
                                    <svg class="field-select-icon" viewBox="0 0 24 24"
                                         width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                                        <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" stroke-linecap="round"/>
                                    </svg>
                                    <select id="rf-service"
                                            class="field-input field-select"
                                            @bind="_f.ServiceId">
                                        <option value="">— اختر الخدمة —</option>
                                        @foreach (var s in _services)
                                        {
                                            <option value="@s.Id">@s.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="field-hint">
                                    الخدمة المختارة تنتقل تلقائيًا إلى العملية وتُستخدم في اقتراح الأسعار
                                </div>
                            </div>

                            @* نوع الرحلة *@
                            <div class="form-field">
                                <label class="field-label" for="rf-triptype">نوع الرحلة</label>
                                <div class="field-select-wrap">
                                    <svg class="field-select-icon" viewBox="0 0 24 24"
                                         width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 8v4l3 3" stroke-linecap="round"/>
                                    </svg>
                                    <select id="rf-triptype"
                                            class="field-input field-select"
                                            @bind="_f.TripTypeId">
                                        <option value="">— اختر —</option>
                                        @foreach (var t in _tripTypes)
                                        {
                                            <option value="@t.Id">@t.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @* من (الميناء) *@
                            <div class="form-field">
                                <label class="field-label" for="rf-port">من (الميناء)</label>
                                <div class="field-select-wrap">
                                    <svg class="field-select-icon" viewBox="0 0 24 24"
                                         width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <circle cx="12" cy="5" r="3"/>
                                        <path d="M12 22V8M5 12H2a10 10 0 0020 0h-3" stroke-linecap="round"/>
                                    </svg>
                                    <select id="rf-port"
                                            class="field-input field-select"
                                            @bind="_f.PortId">
                                        <option value="">— اختر —</option>
                                        @foreach (var p in _ports)
                                        {
                                            <option value="@p.Id">@p.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @* إلى (الجهة) *@
                            <div class="form-field">
                                <label class="field-label" for="rf-dest">إلى (الجهة)</label>
                                <div class="field-select-wrap">
                                    <svg class="field-select-icon" viewBox="0 0 24 24"
                                         width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                        <circle cx="12" cy="10" r="3"/>
                                    </svg>
                                    <select id="rf-dest"
                                            class="field-input field-select"
                                            @bind="_f.DestinationId">
                                        <option value="">— اختر —</option>
                                        @foreach (var p in _destinations)
                                        {
                                            <option value="@p.Id">@p.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @* التعتيق (الميناء النهائي) *@
                            <div class="form-field">
                                <label class="field-label" for="rf-tahteeq">التعتيق (الميناء النهائي)</label>
                                <div class="field-select-wrap">
                                    <svg class="field-select-icon" viewBox="0 0 24 24"
                                         width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <circle cx="12" cy="5" r="3"/>
                                        <path d="M12 22V8M5 12H2a10 10 0 0020 0h-3" stroke-linecap="round"/>
                                    </svg>
                                    <select id="rf-tahteeq"
                                            class="field-input field-select"
                                            @bind="_f.TahteeqPortId">
                                        <option value="">— اختر —</option>
                                        @foreach (var p in _ports)
                                        {
                                            <option value="@p.Id">@p.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @* الوكيل الملاحي *@
                            <div class="form-field">
                                <label class="field-label" for="rf-agent">الوكيل الملاحي</label>
                                <div class="field-select-wrap">
                                    <svg class="field-select-icon" viewBox="0 0 24 24"
                                         width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                    </svg>
                                    <select id="rf-agent"
                                            class="field-input field-select"
                                            @bind="_f.ShippingAgentId">
                                        <option value="">— اختر الوكيل —</option>
                                        @foreach (var a in _agents)
                                        {
                                            <option value="@a.Id">@a.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @* مورد الضمان *@
                            <div class="form-field">
                                <label class="field-label" for="rf-guarsup">مورد الضمان</label>
                                <div class="field-select-wrap">
                                    <svg class="field-select-icon" viewBox="0 0 24 24"
                                         width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                    <select id="rf-guarsup"
                                            class="field-input field-select"
                                            @bind="_f.GuaranteeSupplierId">
                                        <option value="">— اختر —</option>
                                        @foreach (var s in GuaranteeOptions)
                                        {
                                            <option value="@s.Id">@s.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>

                    @* ── سطر الإيراد (من شاشة العملية) ── *@
                    <div class="tab-section">

                        <div class="tab-section-head">
                            <div class="tab-section-icon amber" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div>
                                <div class="tab-section-title">سعر البيع للعميل</div>
                                <div class="tab-section-sub">بيبقى سطر إيراد العملية — والمقترح جاي من قواعد تسعير العميل</div>
                            </div>
                        </div>

                        <div class="bk-form-grid">
                            <div class="form-field">
                                <label class="field-label" for="rf-price">سعر الوحدة</label>
                                <div class="field-input-group">
                                    <span class="field-prefix" aria-hidden="true">ج.م</span>
                                    <input id="rf-price" type="number" min="0" step="0.01"
                                           class="field-input with-prefix"
                                           @bind="_f.UnitPrice" />
                                </div>
                                @if (!string.IsNullOrEmpty(_suggestHint))
                                {
                                    <div class="field-hint">@_suggestHint</div>
                                }
                            </div>

                            <div class="form-field" style="display:flex;align-items:flex-end">
                                <button type="button" class="bk-next-btn"
                                        @onclick="SuggestAsync"
                                        disabled="@(_f.CustomerId <= 0 || _f.ServiceId is null)">
                                    اقترح السعر
                                </button>
                            </div>
                        </div>
                    </div>
                </ChildContent>
            </MudTabPanel>


            @* ══════════════════════════════════════
               TAB 3 — الحاويات والملاحظات
            ══════════════════════════════════════ *@
            <MudTabPanel>
                <TabContent>
                    <div class="btab-label">
                        <div class="btab-icon btab-amber" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/>
                                <path d="M3 8l9 5 9-5M12 13v8"/>
                            </svg>
                        </div>
                        <span>الحاويات</span>
                    </div>
                </TabContent>

                <ChildContent>
                    <div class="tab-section">

                        <div class="tab-section-head">
                            <div class="tab-section-icon amber" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/>
                                    <path d="M3 8l9 5 9-5M12 13v8"/>
                                </svg>
                            </div>
                            <div>
                                <div class="tab-section-title">الحاويات المطلوبة</div>
                                <div class="tab-section-sub">النوع والعدد والوزن والضمان — وعدد الحاويات يحدد عدد رحلات العملية</div>
                            </div>
                        </div>

                        @if (_linesLocked)
                        {
                            <div class="field-hint" style="margin-bottom:12px">
                                في حاويات فعلية متسجلة على الحجز — السطور مقفولة ضد التعديل (أرقام الحاويات بتتعدل من شاشة الحجز).
                            </div>
                        }

                        <div class="bk-container-cards">
                            @foreach (var ln in _lines)
                            {
                                var idx = _lines.IndexOf(ln);

                                <div class="bk-container-card">

                                    <div class="bk-cc-head">
                                        <div class="bk-cc-num" aria-label="رقم السطر">
                                            @(idx + 1)
                                        </div>
                                        <div class="bk-cc-type-badge">
                                            <svg viewBox="0 0 24 24" width="13" height="13"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                            </svg>
                                            @(_containerTypes.FirstOrDefault(t => t.Id == ln.ContainerTypeId)?.Label ?? "نوع الحاوية")
                                        </div>
                                        <div class="bk-cc-total">
                                            إجمالي: <strong>@ln.Qty</strong> حاوية
                                            @if (ln.WeightKg.HasValue)
                                            {
                                                <span>· @ln.WeightKg كجم</span>
                                            }
                                        </div>
                                        @if (!_linesLocked)
                                        {
                                            <button type="button" class="bk-cc-del"
                                                    @onclick="() => _lines.Remove(ln)"
                                                    disabled="@(_lines.Count <= 1)"
                                                    title="حذف السطر"
                                                    aria-label="حذف السطر @(idx + 1)">
                                                <svg viewBox="0 0 24 24" width="15" height="15"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                </svg>
                                            </button>
                                        }
                                    </div>

                                    <div class="bk-cc-body">

                                        <div class="form-field">
                                            <label class="field-label">نوع الحاوية</label>
                                            <div class="field-select-wrap">
                                                <svg class="field-select-icon" viewBox="0 0 24 24"
                                                     width="13" height="13" fill="none"
                                                     stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                                </svg>
                                                <select class="field-input field-select"
                                                        value="@ln.ContainerTypeId" disabled="@_linesLocked"
                                                        @onchange="e => OnLineTypeChange(ln, e)">
                                                    <option value="0" selected="@(ln.ContainerTypeId == 0)">— اختر النوع —</option>
                                                    @foreach (var t in _containerTypes)
                                                    {
                                                        <option value="@t.Id" selected="@(t.Id == ln.ContainerTypeId)">@t.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <div class="form-field">
                                            <label class="field-label">العدد</label>
                                            <div class="bk-qty-control">
                                                <button type="button" class="qty-btn qty-minus"
                                                        @onclick="() => ln.Qty = Math.Max(1, ln.Qty - 1)"
                                                        disabled="@_linesLocked"
                                                        aria-label="إنقاص العدد">−</button>
                                                <input type="number" min="1"
                                                       class="field-input qty-input"
                                                       @bind="ln.Qty" disabled="@_linesLocked" />
                                                <button type="button" class="qty-btn qty-plus"
                                                        @onclick="() => ln.Qty++"
                                                        disabled="@_linesLocked"
                                                        aria-label="زيادة العدد">+</button>
                                            </div>
                                        </div>

                                        <div class="form-field">
                                            <label class="field-label">الوزن (كجم)</label>
                                            <div class="field-input-group">
                                                <span class="field-prefix" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M6 7h12l2 14H4L6 7z"/>
                                                        <path d="M9 7a3 3 0 016 0" stroke-linecap="round"/>
                                                    </svg>
                                                </span>
                                                <input type="number" min="0" step="0.01"
                                                       class="field-input with-prefix"
                                                       @bind="ln.WeightKg" disabled="@_linesLocked" />
                                            </div>
                                        </div>

                                        <div class="form-field">
                                            <label class="field-label">ضمان الحاوية الواحدة (ج.م)</label>
                                            <div class="field-input-group">
                                                <span class="field-prefix" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                                    </svg>
                                                </span>
                                                <input type="number" min="0" step="0.01"
                                                       class="field-input with-prefix"
                                                       @bind="ln.Guarantee" disabled="@_linesLocked" />
                                            </div>
                                            @if (ln.Guarantee is > 0)
                                            {
                                                <div class="bk-guar-linetotal">
                                                    إجمالي ضمان السطر: <strong>@((ln.Guarantee.Value * ln.Qty).ToString("N0")) ج.م</strong>
                                                </div>
                                            }
                                        </div>

                                        <div class="form-field bk-cc-notes">
                                            <label class="field-label">ملاحظات الحاوية</label>
                                            <div class="bk-notes-action-row">
                                                <input class="field-input"
                                                       @bind="ln.Notes" disabled="@_linesLocked"
                                                       placeholder="أي تفاصيل إضافية..." />
                                                @if (!_linesLocked)
                                                {
                                                    var remaining = Math.Max(0, ln.Qty - ln.Details.Count);
                                                    <button type="button" class="bk-add-detail-inline-btn"
                                                            @onclick="() => AddDetail(idx)"
                                                            title="إضافة رقم حاوية فعلية">
                                                        <svg viewBox="0 0 24 24" width="13" height="13"
                                                             fill="none" stroke="currentColor" stroke-width="2.5">
                                                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                                        </svg>
                                                        <span>تفاصيل حاوية</span>
                                                        @if (remaining > 0)
                                                        {
                                                            <span class="bk-add-detail-count" title="المتبقي">@remaining</span>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                    </div>

                                    @* أرقام الحاويات الفعلية لهذا السطر *@
                                    @if (ln.Details.Count > 0)
                                    {
                                        <div class="bk-cc-details">
                                            @foreach (var dt in ln.Details)
                                            {
                                                var dtIdx = ln.Details.IndexOf(dt);
                                                <div class="bk-cc-detail-row">
                                                    <div class="form-field">
                                                        <label class="field-label">رقم الحاوية</label>
                                                        <input type="text" class="field-input"
                                                               @bind="dt.ContainerNumber"
                                                               disabled="@_linesLocked"
                                                               placeholder="MSCU1234567" />
                                                    </div>
                                                    <div class="form-field">
                                                        <label class="field-label">رقم الرصاص</label>
                                                        <input type="text" class="field-input"
                                                               @bind="dt.SealNumber"
                                                               disabled="@_linesLocked" />
                                                    </div>
                                                    <div class="form-field">
                                                        <label class="field-label">شركة الشحن</label>
                                                        <input type="text" class="field-input"
                                                               @bind="dt.ShippingLine"
                                                               disabled="@_linesLocked" />
                                                    </div>
                                                    <div class="form-field">
                                                        <label class="field-label">رقم البوليصة</label>
                                                        <input type="text" class="field-input"
                                                               @bind="dt.BLNumber"
                                                               disabled="@_linesLocked" />
                                                    </div>
                                                    <div class="form-field">
                                                        <label class="field-label">رقم الحجز</label>
                                                        <input type="text" class="field-input"
                                                               @bind="dt.BookingReference"
                                                               disabled="@_linesLocked" />
                                                    </div>
                                                    <div class="form-field">
                                                        <label class="field-label">الوزن (كجم)</label>
                                                        <input type="number" class="field-input"
                                                               @bind="dt.WeightKg"
                                                               disabled="@_linesLocked" />
                                                    </div>
                                                    @if (!_linesLocked)
                                                    {
                                                        <button type="button" class="bk-cc-detail-del"
                                                                @onclick="() => RemoveDetail(idx, dtIdx)">
                                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                            </svg>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (!_linesLocked)
                        {
                            <button type="button" class="bk-add-line-btn mt-10" @onclick="() => _lines.Add(new())">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2.5"
                                     aria-hidden="true">
                                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                </svg>
                                إضافة سطر حاويات
                            </button>
                        }

                        @* ── ملاحظات الطلب ── *@
                        <div class="tab-section-sub-head">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                            </svg>
                            ملاحظات الطلب
                        </div>

                        <div class="form-field">
                            <textarea class="field-input field-textarea"
                                      rows="3"
                                      maxlength="1000"
                                      placeholder="أي ملاحظات خاصة بهذا الطلب..."
                                      @onchange="e => _f.Notes = e.Value?.ToString()">@_f.Notes</textarea>
                        </div>

                    </div>
                </ChildContent>
            </MudTabPanel>


            @* ══════════════════════════════════════
               TAB 4 — الرحلات والتعيين
            ══════════════════════════════════════ *@
            <MudTabPanel>
                <TabContent>
                    <div class="btab-label">
                        <div class="btab-icon btab-green" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="3" width="15" height="13" rx="2"/>
                                <path d="M16 8h4l3 3v5h-7V8z"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                        </div>
                        <span>الرحلات والتعيين</span>
                    </div>
                </TabContent>

                <ChildContent>
                    <div class="tab-section">

                        <div class="tab-section-head">
                            <div class="tab-section-icon green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                </svg>
                            </div>
                            <div>
                                <div class="tab-section-title">الرحلات والتعيين</div>
                                <div class="tab-section-sub">أسند السائق والسيارة الآن — أو اترك الإسناد لاحقًا من ملف العملية</div>
                            </div>
                        </div>

                        @if (OperationId is not null)
                        {
                            @* وضع التعديل: الرحلات المسجلة تُعرض بكروت بنفس تصميم
                               كروت الإضافة — عرض فقط، وتعديلها من شاشة الرحلة *@
                            @if (_existingTrips.Count == 0)
                            {
                                <div class="field-hint">لا توجد رحلات مسجلة على هذا الطلب بعد — أضف أول رحلة من الأسفل.</div>
                            }
                            else
                            {
                                <div class="bk-container-cards">
                                    @for (var i = 0; i < _existingTrips.Count; i++)
                                    {
                                        var t = _existingTrips[i];
                                        <div class="bk-container-card">
                                            <div class="bk-cc-head">
                                                <div class="bk-cc-num" aria-label="رقم الرحلة">@(i + 1)</div>
                                                <div class="bk-cc-type-badge">
                                                    <svg viewBox="0 0 24 24" width="13" height="13"
                                                         fill="none" stroke="currentColor" stroke-width="2"
                                                         aria-hidden="true">
                                                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                                                        <path d="M16 8h4l3 3v5h-7V8z"/>
                                                        <circle cx="5.5" cy="18.5" r="2.5"/>
                                                        <circle cx="18.5" cy="18.5" r="2.5"/>
                                                    </svg>
                                                    رحلة @t.TripNumber
                                                </div>
                                                <div class="bk-cc-total">@TripStatusAr(t.Status)</div>
                                                <a href="@($"/trips/new/{t.TripId}")"
                                                   style="font-size:12px;font-weight:800;color:var(--fc-blue);text-decoration:none">
                                                    فتح الرحلة
                                                </a>
                                            </div>
                                            <div class="bk-cc-body">
                                                <div class="form-field">
                                                    <label class="field-label">السائق</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input" value="@t.DriverName" readonly />
                                                    </div>
                                                </div>
                                                <div class="form-field">
                                                    <label class="field-label">السيارة</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input" value="@t.VehiclePlate" readonly />
                                                    </div>
                                                </div>
                                                <div class="form-field">
                                                    <label class="field-label">النولون</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input" value="@(t.FreightAmount?.ToString("N0") ?? "—")" readonly />
                                                    </div>
                                                </div>
                                                <div class="form-field">
                                                    <label class="field-label">الحالة</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input" value="@TripStatusAr(t.Status)" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="field-hint" style="margin-top:8px">تُعدَّل الرحلة المسجلة من شاشة الرحلة نفسها — والإضافة من الأسفل.</div>
                            }
                        }

                        @if (OperationId is null || CanTripCreate)
                        {
                            @if (OperationId is not null)
                            {
                                <div class="tab-section-title" style="margin:18px 0 10px;font-size:14.5px">إضافة رحلة جديدة</div>
                            }
                            <div class="bk-container-cards">
                                @foreach (var tr in _tripRows)
                                {
                                    var tidx = _tripRows.IndexOf(tr);

                                    <div class="bk-container-card">
                                        <div class="bk-cc-head">
                                            <div class="bk-cc-num" aria-label="رقم الرحلة">@(tidx + 1)</div>
                                            <div class="bk-cc-type-badge">
                                                <svg viewBox="0 0 24 24" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                                </svg>
                                                رحلة @(tidx + 1)
                                            </div>
                                            <div class="bk-cc-total">
                                                @(OrderedDriversFor(tr).FirstOrDefault(d => d.Id == tr.DriverId)?.Label ?? "بدون سائق بعد")
                                            </div>
                                            <button type="button" class="bk-cc-del"
                                                    @onclick="() => _tripRows.Remove(tr)"
                                                    disabled="@(OperationId is null && _tripRows.Count <= 1)"
                                                    title="حذف الرحلة"
                                                    aria-label="حذف الرحلة @(tidx + 1)">
                                                <svg viewBox="0 0 24 24" width="15" height="15"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                </svg>
                                            </button>
                                        </div>

                                        <div class="bk-cc-body">

                                            <div class="form-field form-field-with-dropdown">
                                                <label class="field-label">السائق</label>
                                                <div class="field-input-group">
                                                    <span class="field-prefix" aria-hidden="true">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="11" cy="11" r="8"/>
                                                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                                        </svg>
                                                    </span>
                                                    <input class="field-input with-prefix"
                                                           value="@DriverText(tr)"
