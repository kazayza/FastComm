    private class Suggestion { public decimal UnitPrice { get; set; } public string Source { get; set; } = ""; }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _agents         = await SafeGet("api/shipping-agents/options");
        _customers      = await SafeGet("api/options/customers");
        _services       = await SafeGet("api/options/services");
        _ports          = await SafeGet("api/options/ports");
        _destinations   = await SafeGet("api/options/destinations");
        _tripTypes      = await SafeGet("api/options/trip-types");
        _containerTypes = await SafeGetList<CTOpt>("api/options/container-types");
        _suppliers      = await SafeGet("api/options/suppliers");
        _guaranteeSuppliers = await SafeGet("api/options/guarantee-suppliers");
        _trailers       = await SafeGet("api/options/trailers");
        _driverPairs    = await SafeGetList<PairOpt>("api/options/drivers-pairing");
        _vehiclePairs   = await SafeGetList<PairOpt>("api/options/vehicles-pairing");

        if (OperationId is null)
        {
            AddTripRow();
            /* الخدمة الافتراضية بالاسم زي ما المالك حددها حرفيًا: «نقل حاوية» —
               مش أول اسم شبهها (كانت بتقع على «نقل حاوية مبرده») */
            _f.ServiceId = _services.FirstOrDefault(s => s.Label.Trim() == "نقل حاوية")?.Id;
        }
        else await LoadForEditAsync(OperationId.Value);
    }

    private async Task<List<T>> SafeGetList<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task LoadForEditAsync(long operationId)
    {
        _loading = true;
        try
        {
            var op = await Http.GetFromJsonAsync<OpDetailResp>($"api/operations/{operationId}");
            if (op is null) { _msg = "العملية غير موجودة"; return; }
            _opNumber = op.Operation.OperationNumber;
            _status   = op.Operation.Status;
            _bookingId = op.Operation.BookingId;
            _loadedEstimatedCost = op.Operation.EstimatedCost;
            _loadedRevLines = op.RevenueLines;

            if (_bookingId is not null)
            {
                var bk = await Http.GetFromJsonAsync<BkDetailResp>($"api/bookings/{_bookingId}");
                if (bk is not null)
                {
                    var b = bk.Booking;
                    _f.ShippingAgentId     = b.ShippingAgentId;
                    _f.BookingReference    = b.BookingReference ?? "";
                    _f.BLNumber            = b.BLNumber;
                    _f.CustomerId          = b.CustomerId;
                    _f.ServiceId           = b.ServiceId;
                    _f.PortId              = b.PortId;
                    _f.DestinationId       = b.DestinationId;
                    _f.TahteeqPortId       = b.TahteeqPortId;
                    _f.TripTypeId          = b.TripTypeId;
                    _f.Date                = string.IsNullOrEmpty(b.RequestedDate) ? _f.Date : b.RequestedDate[..10];
                    _f.GuaranteeSupplierId = b.GuaranteeSupplierId;
                    _f.Notes               = b.Notes;
                    _f.EndCustomerId       = b.EndCustomerId;
                    _f.ContactId           = b.ContactId;
                    _f.CustomerReference   = b.CustomerReference;
                    await LoadContactsAsync(b.CustomerId);

                    _lines = bk.Lines.Select(l => new LineRow
                    {
                        ContainerTypeId = l.ContainerTypeId,
                        Qty             = l.RequestedQty,
                        WeightKg        = l.WeightKg,
                        Guarantee       = l.GuaranteePerContainer,
                        Notes           = l.Notes,
                        Details         = l.ContainerDetails.Select(cd => new DetailRow
                        {
                            ContainerId      = cd.ContainerId,
                            ContainerNumber  = cd.ContainerNumber,
                            SealNumber       = cd.SealNumber,
                            ShippingLine     = cd.ShippingLine,
                            BLNumber         = cd.BLNumber,
                            BookingReference = cd.BookingReference,
                            WeightKg         = cd.WeightKg,
                            Notes            = cd.Notes
                        }).ToList()
                    }).ToList();
                    if (_lines.Count == 0) _lines.Add(new());
                    _linesLocked = bk.Lines.Any(l => l.ContainerDetails.Count > 0);
                }
            }

            var first = _loadedRevLines.FirstOrDefault();
            if (first is not null) _f.UnitPrice = first.UnitPrice;

            _existingTrips = await SafeGetList<ExistingTrip>($"api/operations/{operationId}/trips");
        }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; }
        finally { _loading = false; }
    }

    private async Task<List<Opt>> SafeGet(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Opt>>(url) ?? new(); }
        catch { return new(); }
    }

    private void GoBack() => Nav.NavigateTo("/transport-requests");

    private async Task SuggestAsync()
    {
        if (_f.CustomerId <= 0 || _f.ServiceId is null) return;
        var url = $"api/operations/price-suggest?customerId={_f.CustomerId}&serviceId={_f.ServiceId}" +
                  (_f.PortId is not null ? $"&portId={_f.PortId}" : "") +
                  (_f.DestinationId is not null ? $"&destinationId={_f.DestinationId}" : "") +
                  (_f.TahteeqPortId is not null ? $"&tahteeqPortId={_f.TahteeqPortId}" : "") +
                  (_f.TripTypeId is not null ? $"&tripTypeId={_f.TripTypeId}" : "") +
                  (_lines.FirstOrDefault()?.ContainerTypeId > 0 ? $"&containerTypeId={_lines[0].ContainerTypeId}" : "") +
                  $"&date={_f.Date}";
        try
        {
            var s = await Http.GetFromJsonAsync<Suggestion>(url);
            if (s is not null) { _f.UnitPrice = s.UnitPrice; _suggestHint = $"المصدر: {s.Source}"; }
        }
        catch { _suggestHint = "مفيش اقتراح متاح — دخل السعر يدوي"; }
    }

    private async Task SaveAsync()
    {
        _triedSave = true;
        if (_f.CustomerId <= 0) { _ok = false; _msg = "اختر العميل"; _activeTab = 0; return; }
        if (string.IsNullOrWhiteSpace(_f.BookingReference)) { _ok = false; _msg = "رقم البوكينج الرسمي مطلوب"; _activeTab = 1; return; }

        /* سعر سطر الإيراد إجباري — الطلب ما يتحفظش من غيره (تعليمات المالك) */
        if (_f.UnitPrice is null or <= 0)
        { _ok = false; _msg = "سجّل سعر سطر الإيراد (سعر البيع للعميل) أولًا"; _activeTab = 1; return; }

        /* نولون العربية إجباري لكل رحلة متعيّنة — ورحلة ناقصة (سائق بلا عربية
           أو العكس) بتقف بدل ما تتسجل ناقصة (تعليمات المالك) — في الإنشاء
           والتعديل على السواء (في التعديل الصفوف دي رحلات جديدة هتتضاف) */
        {
            foreach (var r in _tripRows)
            {
                var partial = (r.DriverId > 0) != (r.VehicleId > 0);
                if (partial)
                { _ok = false; _msg = "توجد رحلة غير مكتملة: اختر السائق والسيارة معًا أو احذف الرحلة"; _activeTab = 3; return; }
                if (r.DriverId > 0 && r.VehicleId > 0 && (r.Freight is null or <= 0))
                { _ok = false; _msg = "سجّل نولون السيارة لكل رحلة مُسندة قبل الحفظ"; _activeTab = 3; return; }
            }
        }

        _saving = true;
        try
        {
            if (OperationId is null) await CreateAsync();
            else await EditAsync();
        }
        catch (Exception ex) { _ok = false; _msg = "تعذر الاتصال بالخادم: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task CreateAsync()
    {
        var payload = new
        {
            shippingAgentId     = _f.ShippingAgentId,
            bookingReference    = _f.BookingReference,
            blNumber            = _f.BLNumber,
            customerId          = _f.CustomerId,
            endCustomerId       = _f.EndCustomerId,
            contactId           = _f.ContactId,
            customerReference   = _f.CustomerReference,
            serviceId           = _f.ServiceId,
            portId              = _f.PortId,
            destinationId       = _f.DestinationId,
            tahteeqPortId       = _f.TahteeqPortId,
            tripTypeId          = _f.TripTypeId,
            date                = _f.Date,
            guaranteeSupplierId = _f.GuaranteeSupplierId,
            notes               = _f.Notes,
            unitPrice           = _f.UnitPrice,
            lines = _lines.Where(l => l.ContainerTypeId > 0 && l.Qty >= 1)
                          .Select(l => new { containerTypeId = l.ContainerTypeId, requestedQty = l.Qty, guaranteePerContainer = l.Guarantee, weightKg = l.WeightKg, notes = l.Notes })
                          .ToList(),
            containerDetails = _lines.Where(l => l.ContainerTypeId > 0 && l.Qty >= 1)
                          .SelectMany((l, li) => l.Details.Select(d => new
                          {
                              containerId      = d.ContainerId,
                              containerNumber  = d.ContainerNumber,
                              sealNumber       = d.SealNumber,
                              shippingLine     = d.ShippingLine,
                              blNumber         = d.BLNumber,
                              bookingReference = d.BookingReference,
                              weightKg         = d.WeightKg,
                              notes            = d.Notes,
                              lineIndex        = li
                          }))
                          .ToList(),
            trips = _tripRows.Where(t => t.DriverId > 0 && t.VehicleId > 0)
                          .Select(t => new
                          {
                              driverId       = t.DriverId,
                              vehicleId      = t.VehicleId,
                              trailerId      = t.TrailerId,
                              freightAmount  = t.Freight,
                              plannedStartAt = t.PlannedStartAt?.ToString("yyyy-MM-ddTHH:mm")
                          })
                          .ToList()
        };
        var res = await Http.PostAsJsonAsync("api/operations/quick-create", payload);
        _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add(_msg, Severity.Success);
            Nav.NavigateTo("/transport-requests");
        }
    }

    private async Task EditAsync()
    {
        object? bkLines = null;
        object? bkDetails = null;
        if (!_linesLocked)
        {
            bkLines = _lines.Where(l => l.ContainerTypeId > 0 && l.Qty >= 1)
                .Select(l => new { containerTypeId = l.ContainerTypeId, requestedQty = l.Qty, weightKg = l.WeightKg, notes = l.Notes, guaranteePerContainer = l.Guarantee })
                .ToList();
            bkDetails = _lines.Where(l => l.ContainerTypeId > 0 && l.Qty >= 1)
                .SelectMany((l, li) => l.Details.Select(d => new
                {
                    containerId = d.ContainerId, containerNumber = d.ContainerNumber, sealNumber = d.SealNumber,
                    shippingLine = d.ShippingLine, blNumber = d.BLNumber, bookingReference = d.BookingReference,
                    weightKg = d.WeightKg, notes = d.Notes, lineIndex = li
                }))
                .ToList();
        }

        var bkPayload = new
        {
            customerId          = _f.CustomerId,
            requestedDate       = _f.Date,
            serviceId           = _f.ServiceId,
            portId              = _f.PortId,
            destinationId       = _f.DestinationId,
            tahteeqPortId       = _f.TahteeqPortId,
            endCustomerId       = _f.EndCustomerId,
            tripTypeId          = _f.TripTypeId,
            customerReference   = _f.CustomerReference,
            contactId           = _f.ContactId,
            notes               = _f.Notes,
            lines               = bkLines,
            containerDetails    = bkDetails,
            guaranteeSupplierId = _f.GuaranteeSupplierId,
            shippingAgentId     = _f.ShippingAgentId,
            bookingReference    = _f.BookingReference,
            blNumber            = _f.BLNumber
        };
        var res1 = await Http.PutAsJsonAsync($"api/bookings/{_bookingId}", bkPayload);
        var bookingLocked = false;
        if (!res1.IsSuccessStatusCode)
        {
            var m1 = await MsgOf(res1);
            /* الحجز مقفول للتعديل بعد التعيين (Assigned) — ده مش فشل يوقف
               الشغل كله: العملية والرحلات ليهم حياتهم المستقلة، فبنكمّل بيهم
               وبنبلّغ إن بيانات الحجز الأساسية بس هي اللي ما اتغيرتش */
            if (m1.Contains("لا تسمح بالتعديل")) bookingLocked = true;
            else { _ok = false; _msg = "تعديل الحجز فشل: " + m1; return; }
        }

        var revLines = _loadedRevLines.Select(l => new
        {
            serviceId   = l.ServiceId,
            description = l.Description,
            quantity    = l.Quantity,
            unitPrice   = l.UnitPrice,
            discount    = l.Discount,
            taxRateId   = l.TaxRateId,
            priceRuleId = l.PriceRuleId
        }).ToList<object>();
        if (revLines.Count > 0 && _f.UnitPrice is > 0)
        {
            var l0 = _loadedRevLines[0];
            revLines[0] = new
            {
                serviceId   = l0.ServiceId, description = l0.Description, quantity = l0.Quantity,
                unitPrice   = _f.UnitPrice.Value, discount = l0.Discount,
                taxRateId   = l0.TaxRateId, priceRuleId = l0.PriceRuleId
            };
        }
        else if (revLines.Count == 0 && _f.UnitPrice is > 0 && _f.ServiceId is not null)
        {
            revLines.Add(new
            {
                serviceId   = _f.ServiceId.Value, description = (string?)null, quantity = 1m,
                unitPrice   = _f.UnitPrice.Value, discount = 0m, taxRateId = (int?)null, priceRuleId = (long?)null
            });
        }

        var opPayload = new
        {
            bookingId       = _bookingId,
            customerId      = _f.CustomerId,
            serviceId       = _f.ServiceId,
            portId          = _f.PortId,
            destinationId   = _f.DestinationId,
            tahteeqPortId   = _f.TahteeqPortId,
            tripTypeId      = _f.TripTypeId,
            plannedDate     = _f.Date,
            estimatedCost   = _loadedEstimatedCost,
            notes           = _f.Notes,
            revenueLines    = revLines
        };
        var res2 = await Http.PutAsJsonAsync($"api/operations/{OperationId}", opPayload);
        _msg = await MsgOf(res2); _ok = res2.IsSuccessStatusCode;
        if (res2.IsSuccessStatusCode)
        {
            /* رحلات جديدة من تاب التعيين: بتتضاف على العملية الموجودة بعد
               حفظ التعديل (نفس آلية ملف العملية) — الفاشلة بتفضل في مكانها
               والرسالة بتقول وقفت ليه، والتعديل نفسه محفوظ */
            var tripErrors = await CreateAddedTripsAsync();
            if (tripErrors.Count == 0)
            {
                if (bookingLocked)
                    Snackbar.Add("⚠️ تم حفظ العملية والرحلات — لم تُعدَّل بيانات الحجز الأساسية لأن الحجز مقفل للتعديل بعد التعيين", Severity.Warning);
                else
                    Snackbar.Add("✅ تم حفظ تعديل الطلب", Severity.Success);
                Nav.NavigateTo("/transport-requests");
            }
            else
            {
                _ok = false;
                _msg = "تم حفظ التعديل، لكن توجد رحلات لم تُضف: " + string.Join(" · ", tripErrors)
                     + (bookingLocked ? " · ولم تُعدَّل بيانات الحجز الأساسية لأن الحجز مقفل للتعديل بعد التعيين" : "");
                _existingTrips = await SafeGetList<ExistingTrip>($"api/operations/{OperationId}/trips");
            }
        }
        else _msg = (bookingLocked ? "فشل تعديل العملية: " : "تم تعديل الحجز لكن فشل تعديل العملية: ") + _msg;
    }

    private bool CanTripCreate => _user?.Can("TRIP.CREATE") ?? false;

    private async Task<List<string>> CreateAddedTripsAsync()
    {
        var errors = new List<string>();
        if (OperationId is null || !CanTripCreate) return errors;
        var rows = _tripRows.Where(r => r.DriverId > 0 && r.VehicleId > 0).ToList();
        var seq = _existingTrips.Count;
        foreach (var r in rows)
        {
            var payload = new
            {
                driverId       = r.DriverId,
                vehicleId      = r.VehicleId,
                trailerId      = r.TrailerId,
                tripTypeId     = _f.TripTypeId,
                plannedStartAt = r.PlannedStartAt?.ToString("yyyy-MM-ddTHH:mm"),
                notes          = (string?)null,
                freightAmount  = r.Freight,
                portId         = (int?)null,
                destinationId  = (int?)null,
                tahteeqPortId  = (int?)null,
                operations     = new[] { new { operationId = OperationId.Value, sequenceNo = ++seq, pickupAt = (string?)null, deliveryAt = (string?)null, notes = (string?)null } }
            };
            try
            {
                var res = await Http.PostAsJsonAsync("api/trips", payload);
                if (res.IsSuccessStatusCode) _tripRows.Remove(r);
                else errors.Add(await MsgOf(res));
            }
            catch (Exception ex) { errors.Add(ex.Message); }
        }
        return errors;
    }

    private static string StatusAr(string s) => s switch
    {
        "Pending"         => "قيد الانتظار",
        "Assigned"        => "مُعيّنة",
        "DriverReceived"  => "استلم السائق",
        "InTransit"       => "في الطريق",
        "Delivered"       => "تم التسليم",
        "ExpensesPending" => "بانتظار المصروفات",
        "CustodyPending"  => "بانتظار العهدة",
        "ReadyToClose"    => "جاهزة للإغلاق",
        "Closed"          => "مغلقة",
        "Cancelled"       => "ملغاة",
        _                 => s
    };

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
