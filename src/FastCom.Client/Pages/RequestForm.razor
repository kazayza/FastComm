    .field-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        left: 0;
        margin-top: 4px;
        background: #fafcff;
        border: 1px solid #d8e2f0;
        border-radius: 9px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
        max-height: 240px;
        overflow-y: auto;
        z-index: 3000;
    }

    .field-dropdown-item {
        padding: 10px 12px;
        font-family: inherit;
        font-size: 13px;
        color: var(--fc-text);
        cursor: pointer;
        transition: background .1s;
    }

    .field-dropdown-item:hover {
        background: var(--fc-blue-lt);
    }

    .field-hint {
        display: flex; align-items: center; gap: 5px;
        font-size: 10.5px; color: var(--fc-muted); font-weight: 500;
    }

    .field-err-msg { font-size: 10.5px; color: var(--fc-red); font-weight: 700; }

    /* ================================================================
       CONTAINER / TRIP CARDS
    ================================================================ */
    .bk-add-line-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 14px;
        border: 1.5px solid var(--fc-amber);
        border-radius: 9px;
        background: var(--fc-amber-lt); color: #9a6d08;
        font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; white-space: nowrap; flex-shrink: 0;
        transition: all .15s ease;
    }
    .bk-add-line-btn:hover { background: var(--fc-amber); color: #fff; }
    .bk-add-line-btn.mt-10 { margin-top: 10px; }

    .bk-container-cards { display: flex; flex-direction: column; gap: 12px; }

    /* #80ب — أعمدة سطر الإيراد */
    /* #84 — سطر واحد لحد الخصم (الكمية أصغر)، والبيان في سطر لوحده وجنبه زرار */
    /* #99 — نوع الحاوية بقى عمود سادس ⇒ الشبكة 9 أعمدة بدل 8.
       الكمية (.58fr) والخصم (.58fr) ضيّقين عشان التسعة يقعدوا في سطر واحد،
       والبيان ياخد السطر اللي تحته كله (1 / 9) وجنبه زرار اقتراح السعر (9). */
    .bk-cc-body.rf-rev-body {
        grid-template-columns: 1.2fr 1fr 1fr 1fr 1fr 1fr .58fr .8fr .58fr;
    }

    .rf-rev-desc { grid-column: 1 / 9; }

    .rf-rev-act { grid-column: 9; display: flex; align-items: flex-end; }

    .rf-rev-act .rf-btn { width: 100%; justify-content: center; }

    .bk-container-card {
        border: 1px solid #e4edf8; border-radius: 12px;
        background: linear-gradient(180deg, #fafcff, #f5f8fb);
        overflow: visible; /* عشان قوائم السائق/العربية تفتح بحرية */
        transition: border-color .18s ease, box-shadow .18s ease;
    }
    .bk-container-card:hover {
        border-color: #c8d8f0;
        box-shadow: 0 4px 14px rgba(15,41,82,.06);
    }

    .bk-cc-head {
        display: flex; align-items: center; gap: 10px;
        flex-wrap: wrap;
        padding: 10px 14px;
        background: linear-gradient(180deg, #f0f5fc, #eaf1f9);
        border-bottom: 1px solid #dce8f5;
        border-radius: 11px 11px 0 0;
    }

    .bk-cc-num {
        width: 26px; height: 26px; border-radius: 8px; flex: 0 0 26px;
        display: flex; align-items: center; justify-content: center;
        background: var(--fc-blue); color: #fff;
        font-size: 11px; font-weight: 900;
        font-family: "Inter", Arial, sans-serif;
    }

    .bk-cc-type-badge {
        display: flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 7px;
        background: rgba(30,110,245,.08); border: 1px solid rgba(30,110,245,.15);
        color: var(--fc-blue); font-size: 11px; font-weight: 800;
        white-space: nowrap;
    }

    .bk-cc-total {
        flex: 1; font-size: 11px; color: var(--fc-muted); font-weight: 600;
    }
    .bk-cc-total strong { color: var(--fc-text); font-weight: 900; }
    .bk-cc-total span   { color: #9aaabb; }

    .bk-cc-del {
        width: 30px; height: 30px; border-radius: 7px; flex: 0 0 30px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; background: transparent;
        color: var(--fc-red); cursor: pointer;
        transition: all .15s ease;
    }
    .bk-cc-del:hover { background: var(--fc-red-lt); border-color: #ffc8cf; }
    .bk-cc-del:disabled { opacity: .35; cursor: not-allowed; }

    .bk-cc-body {
        /* السطر كله في شريط واحد متناسق:
           النوع · العدد · الوزن · الضمان · الملاحظات + زر «إضافة حاوية» */
        display: grid;
        grid-template-columns: 1.35fr .85fr .85fr 1.05fr 2.1fr;
        gap: 14px; padding: 14px 16px;
        align-items: start;
    }

    .bk-cc-notes { grid-column: auto; }

    /* زر «إضافة حاوية» بجانب حقل الملاحظات + عرض الباقي */
    .bk-notes-action-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .bk-notes-action-row .field-input {
        flex: 1;
        min-width: 0;
    }

    .bk-add-detail-inline-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 42px;
        padding: 0 14px;
        flex-shrink: 0;
        border: 1.5px dashed var(--fc-blue);
        border-radius: 9px;
        background: var(--fc-blue-lt);
        color: var(--fc-blue);
        font-family: inherit;
        font-size: 11.5px;
        font-weight: 800;
        white-space: nowrap;
        cursor: pointer;
        transition: all .15s ease;
    }
    .bk-add-detail-inline-btn:hover {
        background: var(--fc-blue);
        border-style: solid;
        color: #fff;
        box-shadow: 0 4px 12px rgba(30,110,245,.28);
    }
    .bk-add-detail-inline-btn:disabled { opacity: .5; cursor: not-allowed; }
    .bk-add-detail-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 9px;
        background: var(--fc-blue);
        color: #fff;
        font-size: 10px;
        font-weight: 800;
    }
    .bk-add-detail-inline-btn:hover .bk-add-detail-count {
        background: #fff;
        color: var(--fc-blue);
    }

    /* إجمالي الضمان — سطر */
    .bk-guar-linetotal {
        margin-top: 6px;
        font-size: 11.5px;
        font-weight: 700;
        color: #b45309;
    }

    /* صفوف الحاويات الفعلية */
    .bk-cc-details {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 0 16px 14px;
    }

    .bk-cc-detail-row {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr)) auto;
        gap: 12px;
        align-items: end;
        padding: 12px;
        background: #f8fafd;
        border: 1px dashed #cfdcef;
        border-radius: 10px;
    }

    .bk-cc-detail-del {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #ffd3d9;
        border-radius: 9px;
        background: var(--fc-red-lt);
        color: var(--fc-red);
        cursor: pointer;
        transition: all .15s ease;
    }
    .bk-cc-detail-del:hover {
        background: var(--fc-red);
        border-color: var(--fc-red);
        color: #fff;
        box-shadow: 0 4px 12px rgba(224,48,72,.28);
    }

    /* Qty Control */
    .bk-qty-control {
        display: flex; align-items: center; gap: 0;
        border: 1px solid #d8e2f0; border-radius: 9px;
        overflow: hidden; background: #fafcff;
    }

    .qty-btn {
        width: 36px; height: 42px; flex: 0 0 36px;
        display: flex; align-items: center; justify-content: center;
        border: none; background: transparent;
        cursor: pointer; font-size: 18px; font-weight: 900;
        transition: background .12s ease;
    }

    .qty-minus { color: var(--fc-red); border-left: 1px solid #d8e2f0; }
    .qty-plus  { color: var(--fc-green); border-right: 1px solid #d8e2f0; }

    .qty-minus:hover { background: var(--fc-red-lt); }
    .qty-plus:hover  { background: var(--fc-green-lt); }

    .qty-input {
        flex: 1; text-align: center; border: none !important;
        border-radius: 0 !important; background: transparent !important;
        box-shadow: none !important;
        font-weight: 800; font-size: 14px;
    }

    /* ── أزرار عمليات الرحلات المسجلة ── */
    /* #78 — شارة خط سير الرحلة */
    .rf-trip-route { display:inline-flex; align-items:center; gap:5px; padding:3px 9px; border-radius:8px; background:#eef4ff; border:1px solid #d5e3ff; color:#1d4f9c; font-size:11.5px; font-weight:700; white-space:nowrap; }
    .rf-trip-route svg { flex:none; opacity:.75; }
    @@media (max-width: 680px) { .rf-trip-route { white-space:normal; } }

    .rf-trip-act { display:inline-flex; align-items:center; gap:5px; border-radius:8px; padding:4px 10px; font-family:inherit; font-size:12px; font-weight:800; cursor:pointer; border:1px solid transparent; }
    .rf-trip-start { background:#16a35b; color:#fff; }
    .rf-trip-start:hover { background:#15803d; }
    .rf-trip-done { background:#0d9488; color:#fff; }
    .rf-trip-done:hover { background:#0f766e; }
    .rf-trip-cancel { background:#fff1f2; color:#b91c1c; border-color:#fecdd3; }
    .rf-trip-cancel:hover { background:#ffe4e6; }

    /* ================================================================
       BOTTOM ACTIONS
    ================================================================ */
    .bk-bottom-actions {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; padding: 14px 20px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 8px rgba(15,41,82,.04);
    }

    .bk-bottom-back {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .bk-bottom-back:hover { background: #f0f4fa; color: var(--fc-text); }
    .bk-bottom-back svg { transform: rotate(180deg); }

    .bk-bottom-right { display: flex; align-items: center; gap: 10px; }

    .bk-next-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .bk-next-btn:hover { background: var(--fc-blue); color: #fff; }
    .bk-next-btn svg { transform: rotate(180deg); }
    .bk-next-btn:disabled { opacity: .5; cursor: not-allowed; }

    .bk-bottom-save {
        display: inline-flex; align-items: center; gap: 8px;
        height: 40px; padding: 0 22px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(30,110,245,.30);
        transition: all .15s ease;
    }
    .bk-bottom-save:hover:not(:disabled) {
        transform: translateY(-1px); box-shadow: 0 6px 18px rgba(30,110,245,.38);
    }
    .bk-bottom-save:disabled { opacity: .6; cursor: not-allowed; }

    .btn-spinner {
        width: 15px; height: 15px;
        border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
        border-radius: 50%; animation: bk-spin .7s linear infinite;
    }
    .btn-spinner.sm { width: 13px; height: 13px; }

    /* ================================================================
       GLOW FAB — بتاعة الزر العائم في اللياوت (سيبتها زي ما هي)
    ================================================================ */
    .glow-fab-wrap {
        position: fixed;
        left: 28px;
        bottom: 28px;
        /* 🔴 أعلى من الـscrim (1298) — الزر والقايمة لازم يفضلوا فوقه وشغالين */
        z-index: 1299;
    }

    .glow-fab-container {
        position: relative;
        z-index: 2;
        width: 64px;
        height: 64px;
    }

    .glow-fab-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1e6ef5, #0d47a1);
        border: 2.5px solid #fbbf24;
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(30, 110, 245, .4);
        transition: transform .2s, box-shadow .2s;
        z-index: 2;
    }

    .glow-fab-btn:hover {
        transform: translate(-50%, -50%) scale(1.05);
        box-shadow: 0 6px 24px rgba(30, 110, 245, .5);
    }

    .glow-fab-icon { transition: transform .3s; }
    .glow-fab-wrap.is-open .glow-fab-icon { transform: rotate(130deg); }

    .glow-halo, .glow-ring {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        pointer-events: none;
    }

    .glow-halo {
        width: 60px;
        height: 60px;
        background: radial-gradient(circle, rgba(30, 110, 245, .3) 0%, transparent 70%);
        animation: glow-breath 2s ease-in-out infinite;
    }

    .glow-ring {
        width: 60px;
        height: 60px;
        border: 2px solid rgba(30, 110, 245, .4);
        animation: glow-expand 2s ease-out infinite;
    }

    .glow-ring-2 { animation-delay: .3s; }
    .glow-ring-3 { animation-delay: .6s; }

    @@keyframes glow-breath {
        0%, 100% { opacity: .5; transform: translate(-50%, -50%) scale(1); }
        50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
    }

    @@keyframes glow-expand {
        0% { opacity: .8; transform: translate(-50%, -50%) scale(1); }
        100% { opacity: 0; transform: translate(-50%, -50%) scale(2.5); }
    }

    .glow-fab-menu {
        position: absolute;
        bottom: 80px;
        left: 0;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 8px;
        opacity: 0;
        pointer-events: none;
        transform: translateY(10px);
        transition: opacity .2s, transform .2s;
    }

    .glow-fab-wrap.is-open .glow-fab-menu {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    .glow-fab-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        border-radius: 12px;
        background: #fff;
        border: 1px solid #dde5f0;
        box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
        cursor: pointer;
        font-size: 13px;
        color: #1c2c44;
        transition: background .15s, border-color .15s;
        white-space: nowrap;
    }

    .glow-fab-item:hover {
        background: #f4f7fb;
        border-color: #1e6ef5;
    }

    .glow-fab-item-ic {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #eaf1ff;
        color: #1e6ef5;
    }

    /* 🔴 الـscrim بقى شقيق للـ .glow-fab-wrap مش جوّاه.
       لما كان جوّه: الـ wrap بيعمل stacking context، فالـ 1298 كان بيترسم
       فوق القايمة (auto) وفوق الزر (2) ⇒ يبلع الكليك ويمنع استخدام الزر العائم. */
    .glow-fab-scrim {
        position: fixed;
        inset: 0;
        background: rgba(9, 18, 35, .45);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 1298;
        animation: glow-fadein .18s ease both;
    }

    @@keyframes glow-fadein {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    /* ================================================================
       #84 — عائلة أزرار موحّدة + شريط إجراءات الرحلة
    ================================================================ */
    .rf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px solid #D7E1EC;
        background: #fff;
        color: #33475B;
        font-size: 12px;
        font-weight: 800;
        border-radius: 9px;
        padding: 7px 13px;
        cursor: pointer;
        white-space: nowrap;
        transition: background .15s ease, color .15s ease, border-color .15s ease;
    }

    .rf-btn:hover { background: #F1F5F9; border-color: #B9C7D6; }

    .rf-btn-primary { border-color: #1e6ef5; color: #0B56DF; background: rgba(30, 110, 245, .06); }
    .rf-btn-primary:hover { background: #1e6ef5; border-color: #1e6ef5; color: #fff; }

    .rf-btn-go { border-color: #0e9f6e; color: #0e9f6e; background: rgba(14, 159, 110, .06); }
    .rf-btn-go:hover { background: #0e9f6e; border-color: #0e9f6e; color: #fff; }

    .rf-btn-danger { border-color: #e02424; color: #e02424; background: rgba(224, 36, 36, .05); }
    .rf-btn-danger:hover { background: #e02424; border-color: #e02424; color: #fff; }

    /* #101 — رحلة السطر: **6 أعمدة** بدل 5، عشان «إجراءات الرحلة» تقعد
       **جنب ميعاد التحرك** بدل ما تنزل سطر لوحدها.
       الترتيب: سائق · عربية · سحب · وجهة · تعتيق · نولون
                مبيت · تحويلة · حساب السيارة · ميعاد التحرك · [إجراءات = عمودين]
       ‏10 حقول + 2 للإجراءات = 12 خانة = سطرين بالظبط. */
    .bk-cc-body.rf-trip-body {
        grid-template-columns: 1.15fr 1fr 1fr 1fr 1fr .85fr;
    }

    .bk-cc-body.rf-trip-body .rf-lt-actions {
        grid-column: span 2;
        margin-top: 0;
    }

    /* شريط إجراءات الرحلة — بياخد عرض الشبكة كله تحت ميعاد التحرك */
    .rf-lt-actions {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
        padding: 10px 12px;
        border: 1px dashed #D7E1EC;
        border-radius: 10px;
        background: #fff;
    }

    .rf-lt-actions-k {
        font-size: 11.5px;
        font-weight: 800;
        color: #64748B;
        margin-inline-end: 4px;
    }

    /* ================================================================
       #82 — رحلة السطر (الحاويات والرحلات مدموجة 1:1)
    ================================================================ */
    .rf-line-trip {
        margin: 10px -2px 0;
        padding: 12px 12px 14px;
        border: 1px solid #E3E9F0;
        border-inline-start: 3px solid #1e6ef5;
        border-radius: 10px;
        background: #F8FAFD;
    }

    .rf-lt-head {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 10px;
        font-size: 13px;
        font-weight: 800;
        color: #0A1B3B;
    }

    .rf-lt-head svg { color: #1e6ef5; flex: none; }

    .rf-lt-ready {
        font-size: 11.5px;
        font-weight: 800;
        color: #0e9f6e;
        background: rgba(14, 159, 110, .1);
        border-radius: 999px;
        padding: 2px 9px;
    }

    .rf-lt-empty {
        font-size: 11.5px;
        font-weight: 600;
        color: #64748B;
    }

    /* #82 — رقم الرحلة وحالتها + أزرارها جوه قسم السطر */
    .rf-lt-num {
        font-size: 11.5px;
        font-weight: 800;
        color: #0A1B3B;
        background: rgba(30, 110, 245, .1);
        border-radius: 999px;
        padding: 2px 9px;
    }

    .rf-lt-status {
        font-size: 11.5px;
        font-weight: 700;
        color: #64748B;
        background: #EEF2F7;
        border-radius: 999px;
        padding: 2px 9px;
    }

    /* التحذير: ينبّه ولا يمنع */
    .rf-lt-warn {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 10px;
        padding: 9px 11px;
        border: 1px solid rgba(232, 163, 23, .45);
        border-radius: 9px;
        background: rgba(255, 128, 21, .09);
        color: #8A5A00;
        font-size: 12.5px;
        font-weight: 700;
        line-height: 1.6;
    }

    .rf-lt-warn svg { flex: none; margin-top: 2px; color: #E8A317; }

    .rf-lt-total {
        padding: 9px 12px;
        border: 1px solid #E3E9F0;
        border-radius: 9px;
        background: #fff;
        color: #0A1B3B;
        font-size: 14px;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
    }

    /* ================================================================
       RESPONSIVE
    ================================================================ */
    @@media (max-width: 900px) {
        .bk-form-grid { grid-template-columns: 1fr; }
        .bk-cc-body   { grid-template-columns: 1fr 1fr; }
        .bk-cc-body.rf-rev-body { grid-template-columns: 1fr 1fr; }
