        public int? GuaranteeSupplierId { get; set; }
        public string? Notes { get; set; }
        public decimal? UnitPrice { get; set; }
    }
    private Form _f = new();

    private int _activeTab;
    private bool _saving, _ok, _triedSave, _loading;
    private string? _msg, _suggestHint, _status, _opNumber;
    private long? _bookingId;
    private decimal _loadedEstimatedCost;
    private List<LoadedRevLine> _loadedRevLines = new();
    private List<Opt> _contacts = new();

    /* بحث العميل */
    private bool _showCustomerDropdown, _customerTouched;
    private string _customerSearch = "";
    private List<Opt> _filteredCustomers = new();
    private string CustomerText =>
        !_customerTouched && _f.CustomerId > 0
            ? (_customers.FirstOrDefault(c => c.Id == _f.CustomerId)?.Label ?? "")
            : _customerSearch;

    private void OnCustomerSearch(ChangeEventArgs e)
    {
        _customerSearch = e.Value?.ToString() ?? "";
        _customerTouched = true;
        _showCustomerDropdown = true;
        _filteredCustomers = FilterOpts(_customers, _customerSearch);
    }

    private async Task PickCustomer(Opt c)
    {
        _f.CustomerId = c.Id;
        _customerSearch = c.Label;
        _customerTouched = false;
        _showCustomerDropdown = false;
        _f.ContactId = null;
        await LoadContactsAsync(c.Id);
    }

    private async Task LoadContactsAsync(int customerId)
    {
        try
        {
            _contacts = await Http.GetFromJsonAsync<List<Opt>>(
                $"api/options/contacts?customerId={customerId}") ?? new();
        }
        catch { _contacts = new(); }
    }

    /* بحث العميل النهائي */
    private bool _showEndCustomerDropdown, _endCustomerTouched;
    private string _endCustomerSearch = "";
    private List<Opt> _filteredEndCustomers = new();
    private string EndCustomerText =>
