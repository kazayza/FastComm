    private void PickEndCustomer(Opt c)
    {
        _f.EndCustomerId = c.Id;
        _endCustomerSearch = c.Label;
        _endCustomerTouched = false;
        _showEndCustomerDropdown = false;
    }

    private static List<Opt> FilterOpts(List<Opt> src, string search) =>
        string.IsNullOrWhiteSpace(search)
            ? src.Take(20).ToList()
            : src.Where(x => x.Label.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)).Take(20).ToList();

    /* DTOs للتحميل في وضع التعديل */
    public class OpDetailResp { public OpDetail Operation { get; set; } = new(); public List<LoadedRevLine> RevenueLines { get; set; } = new(); }
    public class OpDetail
