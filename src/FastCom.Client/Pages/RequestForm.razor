    }
    private void AddDetail(int lineIdx)
    {
        if (lineIdx < 0 || lineIdx >= _lines.Count) return;
        _lines[lineIdx].Details.Add(new DetailRow());
    }
    private void RemoveDetail(int lineIdx, int detailIdx)
    {
        if (lineIdx < 0 || lineIdx >= _lines.Count) return;
        var details = _lines[lineIdx].Details;
        if (detailIdx >= 0 && detailIdx < details.Count) details.RemoveAt(detailIdx);
    }
    private List<LineRow> _lines = new() { new() };
    private bool _linesLocked;

    private class Form
    {
        public int? ShippingAgentId { get; set; }
        public string BookingReference { get; set; } = "";
        public string? BLNumber { get; set; }
        public int CustomerId { get; set; }
        public int? EndCustomerId { get; set; }
        public int? ContactId { get; set; }
        public string? CustomerReference { get; set; }
        public int? ServiceId { get; set; }
