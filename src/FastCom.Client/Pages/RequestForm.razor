    private void AddDetail(int lineIdx)
    {
        if (lineIdx < 0 || lineIdx >= _lines.Count) return;
        _lines[lineIdx].Details.Add(new DetailRow());
    }
    private void RemoveDetail(int lineIdx, int detailIdx)
    {
        if (lineIdx < 0 || lineIdx >= _lines.Count) return;
        var details = _lines[lineIdx].Details;
        if (detailIdx >= 0 && detailIdx < details.Count) details.RemoveAt(detailIdx);
    }
