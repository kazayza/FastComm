@page "/transport-requests/new"
@page "/transport-requests/new/{OperationId:long}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(OperationId is null ? "طلب نقل جديد" : "تعديل طلب النقل") — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="bk-hero-row">
                <div class="bk-hero-left">
                    <div class="bk-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M13 2L3 14h7l-1 8 11-14h-8l1-6z" stroke-linejoin="round"/>
                        </svg>
                        <span>التشغيل · طلبات النقل</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">
                        @if (OperationId is null)
                        {
                            <span>طلب نقل جديد</span>
                        }
                        else
                        {
                            <span>@_opNumber</span>
                        }
                    </h1>
                    <span class="bk-hero-sub">سجّل الطلب من حجز الوكيل — الحجز وعمليته بيتنشأوا مع بعض</span>
                </div>

                <div class="bk-hero-right">
                    @if (OperationId is not null && !string.IsNullOrEmpty(_status))
                    {
                        <span class="bk-hero-chip @StatusHeroCls(_status)">@StatusAr(_status)</span>
                    }
                    <span class="bk-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

            @* ── ملخص الطلب (ثابت وواضح) ── *@
            @if (!_loading)
            {
                <div class="rf-summary" role="region" aria-label="ملخص الطلب">
                    <div class="rf-sum-card">
                        <div class="rf-sum-k">العميل (حساب الفاتورة)</div>
                        <div class="rf-sum-v">@(_customers.FirstOrDefault(c => c.Id == _f.CustomerId)?.Label ?? "— اختر العميل —")</div>
                    </div>
                    <div class="rf-sum-card rf-sum-card-accent">
                        <div class="rf-sum-k">العميل النهائي (يظهر بالفاتورة)</div>
                        <div class="rf-sum-v">@(EndCustomerDisplayText ?? "نفس العميل / غير محدد")</div>
                    </div>
                    <div class="rf-sum-card">
                        <div class="rf-sum-k">حجز الوكيل / البوليصة</div>
                        <div class="rf-sum-v">@(string.IsNullOrWhiteSpace(_f.BookingReference) ? "—" : _f.BookingReference)@(string.IsNullOrWhiteSpace(_f.BLNumber) ? "" : " · " + _f.BLNumber)</div>
                    </div>
                    <div class="rf-sum-card">
                        <div class="rf-sum-k">الحاويات · السعر</div>
                        <div class="rf-sum-v">@_lines.Sum(l => l.Qty) حاوية · @_loadedRevLines.Sum(l => l.Quantity * l.UnitPrice - l.Discount).ToString("N0") ج.م</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="bk-body">
    @if (!CanUse)
    {
        <div class="bk-state-box">
            <div class="bk-state-icon perm">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>إنشاء الطلب محتاج صلاحيات إنشاء الحجز والعملية، والتعديل محتاج صلاحيات تعديلهم.</p>
            <button type="button" class="bk-state-back" @onclick="GoBack">رجوع للقائمة</button>
        </div>
    }
    else if (_loading)
    {
        <div class="bk-loading-wrap">
            <div class="bk-spinner" aria-hidden="true"></div>
            <div class="bk-loading-text">جاري تحميل بيانات الطلب…</div>
        </div>
    }
    else
    {
        <div class="bk-tabs-wrap">
            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="bk-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="bk-mud-tabs">

                @* ══════════════════════════════════════
                   TAB 1 — بيانات العميل
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <span>بيانات العميل والحجز</span>
                        </div>
                    </TabContent>
                    <ChildContent>
                        <div class="tab-section">
                            <div class="tab-section-head">
                                <div class="tab-section-icon blue" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">بيانات العميل</div>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(EndCustomerDisplayText))
                            {
                                <div class="field-hint" style="margin:0 0 12px 0;padding:10px 12px;border:1px solid #d8e7ff;border-radius:10px;background:#f6faff;font-weight:700;color:#174ea6">
                                    العميل النهائي الظاهر: @EndCustomerDisplayText
                                </div>
                            }

                            <div class="bk-form-grid">

                                @* العميل — بحث *@
                                <div class="form-field form-field-with-dropdown">
                                    <label class="field-label" for="rf-customer">
                                        العميل
                                        <span class="field-required" aria-label="مطلوب">*</span>
                                    </label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="11" cy="11" r="8"/>
                                                <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="rf-customer"
                                               class="field-input with-prefix @(_f.CustomerId == 0 && _triedSave ? "field-error" : "")"
                                               value="@CustomerText"
                                               placeholder="ابحث بالاسم..."
                                               @oninput="OnCustomerSearch"
                                               @onfocus="() => { _showCustomerDropdown = true; _filteredCustomers = FilterOpts(_customers, _customerSearch); }"
                                               @onfocusout="() => _showCustomerDropdown = false"
                                               aria-required="true" />
                                    </div>
                                    @if (_showCustomerDropdown && _filteredCustomers.Count > 0)
                                    {
                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                            @foreach (var c in _filteredCustomers)
                                            {
                                                <div class="field-dropdown-item" @onmousedown="() => PickCustomer(c)">
                                                    @c.Label
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (_f.CustomerId == 0 && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">اختيار العميل مطلوب</div>
                                    }
                                </div>

                                @* العميل النهائي (اختياري) *@
                                <div class="form-field form-field-with-dropdown">
                                    <label class="field-label" for="rf-endcustomer">العميل النهائي (اختياري — يظهر بالفاتورة)</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="11" cy="11" r="8"/>
                                                <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="rf-endcustomer"
                                               class="field-input with-prefix"
                                               value="@EndCustomerText"
                                               placeholder="ابحث بالاسم... (فاضي = نفس العميل)"
                                               @oninput="OnEndCustomerSearch"
                                               @onfocus="() => { _showEndCustomerDropdown = true; _filteredEndCustomers = FilterOpts(_customers, _endCustomerSearch); }"
                                               @onfocusout="() => _showEndCustomerDropdown = false" />
                                    </div>
                                    @if (_showEndCustomerDropdown && _filteredEndCustomers.Count > 0)
                                    {
                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                            @foreach (var c in _filteredEndCustomers)
                                            {
                                                <div class="field-dropdown-item" @onmousedown="() => PickEndCustomer(c)">
                                                    @c.Label
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        اختر عميلًا من القائمة أو اكتب اسمًا يدويًا — سيبه فاضي لو نفس العميل. الاسم النهائي يظهر في الفاتورة.
                                    </div>
                                </div>

                                @* جهة الاتصال *@
                                <div class="form-field">
                                    <label class="field-label" for="rf-contact">جهة الاتصال</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-4.99-5 19.79 19.79 0 01-3.07-8.67A2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                                        </svg>
                                        <select id="rf-contact"
                                                class="field-input field-select"
                                                @bind="_f.ContactId"
                                                disabled="@(_f.CustomerId == 0)">
                                            <option value="">—</option>
                                            @foreach (var c in _contacts)
                                            {
                                                <option value="@c.Id">@c.Label</option>
                                            }
                                        </select>
                                    </div>
                                    @if (_f.CustomerId == 0)
                                    {
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            اختر العميل أولًا
                                        </div>
                                    }
                                </div>

                                @* تاريخ التنفيذ المطلوب *@
                                <div class="form-field">
                                    <label class="field-label" for="rf-reqdate">تاريخ التنفيذ المطلوب</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="4" width="18" height="18" rx="2"/>
                                                <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="rf-reqdate" type="date"
                                               class="field-input with-prefix"
                                               value="@_f.Date"
                                               @onchange="e => _f.Date = e.Value?.ToString() ?? _f.Date" />
                                    </div>
                                </div>

                                @* مرجع العميل *@
                                <div class="form-field">
                                    <label class="field-label" for="rf-custref">مرجع العميل</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                                                <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="rf-custref"
                                               class="field-input with-prefix"
                                               maxlength="100"
                                               placeholder="أمر توريد / بيان جمركي"
                                               @bind="_f.CustomerReference" />
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        الرقم الذي سجّله العميل نفسه لهذه العملية في مستنداته (أمر توريد أو بيان جمركي) — يُدوَّن ليتم أي استفسار أو مطابقة بذات الرقم لدى الطرفين
                                    </div>
                                </div>


                                @* ═══ #82 — منقولة من تاب «بيانات النقل» ═══ *@
                                <div class="form-field">
                                    <label class="field-label" for="rf-bookingref">
                                        رقم البوكينج الرسمي
                                        <span class="field-required" aria-label="مطلوب">*</span>
                                    </label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="4" width="18" height="16" rx="2"/>
                                                <path d="M7 8h10M7 12h10M7 16h6" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="rf-bookingref"
                                               class="field-input with-prefix @(string.IsNullOrWhiteSpace(_f.BookingReference) && _triedSave ? "field-error" : "")"
                                               value="@_f.BookingReference"
                                               maxlength="100"
                                               placeholder="الرقم اللي الوكيل سلّمهولك"
                                               @onchange="e => _f.BookingReference = e.Value?.ToString() ?? string.Empty"
                                               aria-required="true" />
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        الرقم الرسمي من الوكيل الملاحي — زي ما هو في المستند
                                    </div>
                                    @if (string.IsNullOrWhiteSpace(_f.BookingReference) && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">رقم البوكينج الرسمي مطلوب</div>
                                    }
                                </div>
                                <div class="form-field">
                                    <label class="field-label" for="rf-blnumber">رقم البوليصة (BL)</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                <path d="M14 2v6h6" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="rf-blnumber"
                                               class="field-input with-prefix"
                                               @bind="_f.BLNumber" />
                                    </div>
                                </div>
                                <div class="form-field">
                                    <label class="field-label" for="rf-agent">الوكيل الملاحي</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                        </svg>
                                        <select id="rf-agent"
                                                class="field-input field-select"
                                                @bind="_f.ShippingAgentId">
                                            <option value="">— اختر الوكيل —</option>
                                            @foreach (var a in _agents)
                                            {
                                                <option value="@a.Id">@a.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-field">
                                    <label class="field-label" for="rf-guarsup">مورد الضمان</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                        <select id="rf-guarsup"
                                                class="field-input field-select"
                                                @bind="_f.GuaranteeSupplierId">
                                            <option value="">— اختر —</option>
                                            @foreach (var s in GuaranteeOptions)
                                            {
                                                <option value="@s.Id">@s.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 2 — بيانات النقل
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                </svg>
                            </div>
                            <span>بيانات النقل</span>
                        </div>
                    </TabContent>

                    <ChildContent>


                        @* #83 — خط سير الطلب بقى صف صغير (الخدمة ونوع الرحلة نزلوا على سطر الإيراد) *@


                        @if (CanViewFinancials)
                        {
                            @* ── سطر الإيراد (من شاشة العملية) ── *@
                            <div class="tab-section">

                                <div class="tab-section-head">
                                    <div class="tab-section-icon amber" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round"/>
                                        </svg>
                                    </div>
                                    <div>
                                        @* #83 — التاب بقى سطور إيراد بس *@
                                        <div class="tab-section-title">إيرادات العميل</div>
                                    </div>
                                </div>

                                @* ── #83 — سطور الإيراد ظاهرة في الإنشاء والتعديل.
                                   السعر يظهر أوتوماتيك من قائمة الأسعار أو يتدخل يدوي ── *@
                                    <div class="bk-container-cards">
                                        @foreach (var rl in _loadedRevLines)
                                        {
                                            <div class="bk-container-card">
                                                <div class="bk-cc-head">
                                                    <div class="bk-cc-num" aria-label="رقم السطر">@(_loadedRevLines.IndexOf(rl) + 1)</div>
                                                    <div class="bk-cc-type-badge">@(_services.FirstOrDefault(sv => sv.Id == rl.ServiceId)?.Label ?? "بدون خدمة")</div>
                                                    <div class="bk-cc-total">صافي: <strong>@((rl.Quantity * rl.UnitPrice - rl.Discount).ToString("N2"))</strong> ج.م</div>
                                                    <button type="button" class="bk-cc-del" title="حذف السطر"
                                                            aria-label="حذف سطر الإيراد"
                                                            @onclick="() => _loadedRevLines.Remove(rl)">
                                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none"
                                                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                </div>
                                                @* #80ب — bk-cc-body نفسه grid من 5 أعمدة، فالحقول بتتحط فيه على طول
                                                   (لفّ bk-form-grid جواه كان بيحشرهم في العمود الأول = شكل رأسي) *@
                                                <div class="bk-cc-body rf-rev-body">
                                                <div class="form-field">
                                                    <label class="field-label">الخدمة</label>
                                                    <select class="field-input field-select" value="@rl.ServiceId"
                                                            @onchange="e => OnRevLineServiceChange(rl, e)">
                                                        <option value="0">— اختر —</option>
                                                        @foreach (var sv in _services) { <option value="@sv.Id">@sv.Label</option> }
                                                    </select>
                                                </div>
                                                <div class="form-field form-field-with-dropdown">
                                                    <label class="field-label">التحميل</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input" value="@rl.PortSearch" placeholder="اكتب للبحث..."
                                                               @oninput="e => OnRevPortSearch(rl, e)"
                                                               @onfocus="() => { rl.ShowPorts = true; rl.FilteredPorts = FilterOpts(_ports, rl.PortSearch); }"
                                                               @onfocusout="() => rl.ShowPorts = false" />
                                                    </div>
                                                    @if (rl.ShowPorts && rl.FilteredPorts.Count > 0)
                                                    {
                                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                            @foreach (var o in rl.FilteredPorts)
                                                            { <div class="field-dropdown-item" @onmousedown="() => PickRevPort(rl, o)">@o.Label</div> }
                                                        </div>
                                                    }
                                                </div>
                                                <div class="form-field form-field-with-dropdown">
                                                    <label class="field-label">الوجهة</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input" value="@rl.DestSearch" placeholder="اكتب للبحث..."
                                                               @oninput="e => OnRevDestSearch(rl, e)"
                                                               @onfocus="() => { rl.ShowDests = true; rl.FilteredDests = FilterOpts(_destinations, rl.DestSearch); }"
                                                               @onfocusout="() => rl.ShowDests = false" />
                                                    </div>
                                                    @if (rl.ShowDests && rl.FilteredDests.Count > 0)
                                                    {
                                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                            @foreach (var o in rl.FilteredDests)
                                                            { <div class="field-dropdown-item" @onmousedown="() => PickRevDest(rl, o)">@o.Label</div> }
                                                        </div>
                                                    }
                                                </div>
                                                <div class="form-field form-field-with-dropdown">
                                                    <label class="field-label">التعتيق</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input" value="@rl.TahteeqSearch" placeholder="اكتب للبحث..."
                                                               @oninput="e => OnRevTahteeqSearch(rl, e)"
                                                               @onfocus="() => { rl.ShowTahteeqs = true; rl.FilteredTahteeqs = FilterOpts(_ports, rl.TahteeqSearch); }"
                                                               @onfocusout="() => rl.ShowTahteeqs = false" />
                                                    </div>
                                                    @if (rl.ShowTahteeqs && rl.FilteredTahteeqs.Count > 0)
                                                    {
                                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                            @foreach (var o in rl.FilteredTahteeqs)
                                                            { <div class="field-dropdown-item" @onmousedown="() => PickRevTahteeq(rl, o)">@o.Label</div> }
                                                        </div>
                                                    }
                                                </div>
                                                @* #83 — نوع الرحلة نزل من راس الطلب على السطر *@
                                                <div class="form-field">
                                                    <label class="field-label">نوع الرحلة</label>
                                                    <select class="field-input field-select" value="@rl.TripTypeId"
                                                            @onchange="e => OnRevLineTripTypeChange(rl, e)">
                                                        <option value="">— اختر —</option>
                                                        @foreach (var tt in _tripTypes) { <option value="@tt.Id">@tt.Label</option> }
                                                    </select>
                                                </div>
                                                @* #99 — نوع الحاوية بُعد في قواعد التسعير، فبقى على السطر.
                                                   بيتعبّى لوحده من تاب الحاويات وتقدر تغيّره *@
                                                <div class="form-field">
                                                    <label class="field-label">نوع الحاوية</label>
                                                    <select class="field-input field-select" value="@rl.ContainerTypeId"
                                                            @onchange="e => OnRevLineContainerChange(rl, e)">
                                                        <option value="0">— أي نوع —</option>
                                                        @foreach (var t in _containerTypes) { <option value="@t.Id">@t.Label</option> }
                                                    </select>
                                                </div>
                                                <div class="form-field">
                                                    <label class="field-label">الكمية</label>
                                                    <input type="number" min="0" step="1" class="field-input" @bind="rl.Quantity" />
                                                </div>
                                                <div class="form-field">
                                                    <label class="field-label">سعر الوحدة</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                                        <input type="number" min="0" step="0.01" class="field-input with-prefix"
                                                               value="@Money(rl.UnitPrice)" @onchange="e => OnRevLinePriceInput(rl, e)" />
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(rl.Hint))
                                                    { <div class="field-hint" title="@rl.HintDetail">@rl.Hint</div> }
                                                </div>
                                                <div class="form-field">
                                                    <label class="field-label">الخصم</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                                        <input type="number" min="0" step="0.01" class="field-input with-prefix" @bind="rl.Discount" />
                                                    </div>
                                                </div>
                                                @* #83 — البيان بالعرض الكامل للسطر *@
                                                <div class="form-field rf-rev-desc">
                                                    <label class="field-label">البيان</label>
                                                    <input type="text" class="field-input" value="@rl.Description"
                                                           @onchange="e => OnRevLineDescInput(rl, e)"
                                                           placeholder="مثال: نقل حاويات من ميناء الإسكندرية إلى مخزن العميل" />
                                                </div>
                                                <div class="form-field rf-rev-act">
                                                    <button type="button" class="rf-btn rf-btn-primary" @onclick="() => SuggestForLineAsync(rl, true)">اقترح السعر</button>
                                                </div>                                                </div>
                                            </div>
                                        }
                                    </div>
                                    @if (_loadedRevLines.Count == 0)
                                    {
                                        <div class="field-hint" style="margin-bottom:10px">مفيش سطور إيراد على العملية دي — ضيف أول سطر.</div>
                                    }
                                    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
                                        <button type="button" class="bk-add-line-btn" @onclick="AddRevLineAsync">+ إضافة سطر إيراد</button>
                                        <button type="button" class="bk-next-btn" @onclick="SuggestAsync"
                                                disabled="@(_f.CustomerId <= 0 || _loadedRevLines.Count == 0)">
                                            اقترح السعر لكل السطور
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_suggestHint))
                                    {
                                        <div class="field-hint" style="margin-top:8px">@_suggestHint</div>
                                    }
                            </div>
                        }

                        @* ══════ #80 — المصروفات جوه شاشة طلب النقل (وضع التعديل) ══════ *@
                        @if (CanViewFinancials && OperationId is not null)
                        {
                            <div class="tab-section">
                                <div class="tab-section-head">
                                    <div class="tab-section-icon amber" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/><path d="M8 7h8M8 11h8M8 15h5" stroke-linecap="round"/></svg>
                                    </div>
                                    <div>
                                        <div class="tab-section-title">المصروفات</div>
                                    </div>
                                </div>

                                @if (_expenses.Count > 0)
                                {
                                    <div class="bk-container-cards">
                                        @foreach (var ex in _expenses)
                                        {
                                            <div class="bk-container-card">
                                                <div class="bk-cc-head">
                                                    <div class="bk-cc-type-badge">@ex.TypeName</div>
                                                    @if (!string.IsNullOrEmpty(ex.TripNumber))
                                                    {
                                                        <div class="rf-trip-route">@ex.TripNumber@if (!string.IsNullOrEmpty(ex.DriverName)){ <span> — @ex.DriverName</span>}</div>
                                                    }
                                                    @* ملاحظة: GET api/expenses (‏ListItem) مابيرجّعش BillableAmount —
                                                       القيمة المحمّلة على العميل بتظهر في شاشة المصروفات *@
                                                    <div class="bk-cc-total">@ex.Amount.ToString("N2") ج.م</div>
                                                </div>
                                                @if (!string.IsNullOrEmpty(ex.Description))
                                                {
                                                    <div class="bk-cc-notes">@ex.Description</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="field-hint" style="margin-bottom:10px">مفيش مصروفات مسجلة على العملية دي.</div>
                                }

                                @* #80ب — التسجيل من شاشة المصروفات زي ما متعود.
                                   هنا عرض بس، عشان تشوف مصروفات العملية من غير ما تسيب الشاشة. *@
                                <div style="margin-top:12px">
                                    <a class="bk-next-btn" href="/expenses"
                                       style="display:inline-flex;align-items:center;gap:6px;text-decoration:none">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                        </svg>
                                        تسجيل مصروف من شاشة المصروفات
                                    </a>
                                </div>
                            </div>
                        }
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 3 — الحاويات والملاحظات
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-amber" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>
                            </div>
                            <span>الحاويات والرحلات</span>
                            @if (_lines.Sum(l => l.Qty) > 0)
                            { <span class="btab-count">@_lines.Sum(l => l.Qty)/@_lines.Count(t=>t.Trip.DriverId>0&&t.Trip.VehicleId>0)</span> }
                        </div>
                    </TabContent>
                    <ChildContent>
                        <div class="tab-section">
                            <div class="tab-section-head">
                                <div class="tab-section-icon amber" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">1) سطور الحاويات المطلوبة</div>
                                </div>
                            </div>
                            <div class="bk-container-cards">
                                @foreach (var ln in _lines)
                                {
                                    var idx = _lines.IndexOf(ln);
                                    <div class="bk-container-card">
                                        <div class="bk-cc-head">
                                            <div class="bk-cc-num" aria-label="رقم السطر">@(idx + 1)</div>
                                            <div class="bk-cc-type-badge">@(_containerTypes.FirstOrDefault(t => t.Id == ln.ContainerTypeId)?.Label ?? "نوع الحاوية")</div>
                                            <button type="button" class="bk-cc-del" @onclick="() => RemoveLineAsync(ln)" disabled="@(_lines.Count <= 1)" title="حذف السطر" aria-label="حذف السطر @(idx + 1)"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg></button>
                                        </div>
                                        <div class="bk-cc-body">
                                            <div class="form-field">
                                                <label class="field-label">نوع الحاوية</label>
                                                <div class="field-select-wrap">
                                                    <select class="field-input field-select" value="@ln.ContainerTypeId" @onchange="e => OnLineTypeChange(ln, e)">
                                                        <option value="0" selected="@(ln.ContainerTypeId == 0)">— اختر النوع —</option>
                                                        @foreach (var t in _containerTypes) { <option value="@t.Id" selected="@(t.Id == ln.ContainerTypeId)">@t.Label</option> }
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-field">
                                                <label class="field-label">العدد</label>
                                                <div class="bk-qty-control">
                                                    <button type="button" class="qty-btn qty-minus" @onclick="() => ln.Qty = Math.Max(1, ln.Qty - 1)" aria-label="إنقاص">−</button>
                                                    <input type="number" min="1" class="field-input qty-input" @bind="ln.Qty" />
                                                    <button type="button" class="qty-btn qty-plus" @onclick="() => ln.Qty++" aria-label="زيادة">+</button>
                                                </div>
                                            </div>
                                            <div class="form-field">
                                                <label class="field-label">الوزن (كجم)</label>
                                                <input type="number" min="0" step="0.01" class="field-input" @bind="ln.WeightKg" />
                                            </div>
                                            <div class="form-field">
                                                <label class="field-label">ضمان الحاوية (ج.م)</label>
                                                <input type="number" min="0" step="0.01" class="field-input" @bind="ln.Guarantee" />
                                                @if (ln.Guarantee is > 0) { <div class="bk-guar-linetotal">إجمالي ضمان السطر: <strong>@((ln.Guarantee.Value * ln.Qty).ToString("N0")) ج.م</strong></div> }
                                            </div>
                                            <div class="form-field bk-cc-notes">
                                                <label class="field-label">ملاحظات الحاوية</label>
                                                <div class="bk-notes-action-row">
                                                    <input class="field-input" @bind="ln.Notes" placeholder="تفاصيل إضافية..." />
                                                    @{ var remaining = Math.Max(0, ln.Qty - ln.Details.Count); }
                                                    <button type="button" class="bk-add-detail-inline-btn" @onclick="() => AddDetail(idx)" disabled="@(!CanEditContainerDetails)" title="إضافة رقم حاوية فعلية">
                                                        <span>تفاصيل حاوية فعلية</span>@if (remaining > 0){<span class="bk-add-detail-count" title="المتبقي">@remaining</span>}
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        @if (ln.Details.Count > 0)
                                        {
                                            <div class="bk-cc-details">
                                                @foreach (var dt in ln.Details)
                                                {
                                                    var dtIdx = ln.Details.IndexOf(dt);
                                                    <div class="bk-cc-detail-row">
                                                        <div class="form-field"><label class="field-label">رقم الحاوية</label><input type="text" class="field-input" @bind="dt.ContainerNumber" placeholder="MSCU1234567" /></div>
                                                        <div class="form-field"><label class="field-label">رقم الرصاص</label><input type="text" class="field-input" @bind="dt.SealNumber" /></div>
                                                        <div class="form-field"><label class="field-label">شركة الشحن</label><input type="text" class="field-input" @bind="dt.ShippingLine" /></div>
                                                        <div class="form-field"><label class="field-label">رقم البوليصة</label><input type="text" class="field-input" @bind="dt.BLNumber" /></div>
                                                        <div class="form-field"><label class="field-label">رقم الحجز</label><input type="text" class="field-input" @bind="dt.BookingReference" /></div>
                                                        <div class="form-field"><label class="field-label">الوزن (كجم)</label><input type="number" class="field-input" @bind="dt.WeightKg" /></div>
                                                        @if (CanEditContainerDetails)
                                                        { <button type="button" class="bk-cc-detail-del" @onclick="() => RemoveDetail(idx, dtIdx)" aria-label="حذف">×</button> }
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @* ═══ #82 — رحلة السطر ده (1:1) جوه نفس القسم ═══ *@
                                        <div class="rf-line-trip">
                                            <div class="rf-lt-head">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                                     stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                                </svg>
                                                <span>رحلة هذا السطر</span>
                                                @if (ln.Trip.TripId is not null)
                                                {
                                                    <span class="rf-lt-num">@ln.Trip.TripNumber</span>
                                                    <span class="rf-lt-status">@TripStatusAr(ln.Trip.Status)</span>
                                                }
                                                @if (ln.Trip.DriverId > 0 && ln.Trip.VehicleId > 0)
                                                {
                                                    <span class="rf-lt-ready">@(ln.Trip.TripId is null ? "جاهزة للحفظ" : "مسجّلة — التعديل هيحدّثها")</span>
                                                }
                                                else
                                                {
                                                    <span class="rf-lt-empty">اختيارية — السائق والعربية لازم يتحددوا عشان تتسجل</span>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(ln.ConflictMsg))
                                            {
                                                @* #82 — تحذير فقط، مش بيمنع الحفظ *@
                                                <div class="rf-lt-warn" role="status">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                                         stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                        <path d="M12 9v4M12 17h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/>
                                                    </svg>
                                                    <span>@ln.ConflictMsg</span>
                                                </div>
                                            }

                                            <div class="bk-cc-body rf-trip-body">
                                                <div class="form-field form-field-with-dropdown">
                                                    <label class="field-label">السائق</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/></svg></span>
                                                        <input class="field-input with-prefix" value="@DriverText(ln.Trip)" placeholder="ابحث باسم السائق..."
                                                               @oninput="e => OnDriverSearch(ln.Trip, e)"
                                                               @onfocus="() => { ln.Trip.ShowDrivers = true; ln.Trip.FilteredDrivers = FilterPairs(OrderedDriversFor(ln.Trip), ln.Trip.DriverSearch); }"
                                                               @onfocusout="() => ln.Trip.ShowDrivers = false" />
                                                    </div>
                                                    @if (ln.Trip.ShowDrivers && ln.Trip.FilteredDrivers.Count > 0)
                                                    {
                                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                            @foreach (var d in ln.Trip.FilteredDrivers)
                                                            { <div class="field-dropdown-item" @onmousedown="() => PickLineDriver(ln, d)">@d.Label</div> }
                                                        </div>
                                                    }
                                                </div>

                                                @* #82 — العربيات المتاحة بس (مش محجوزة ولا في رحلة بتاريخ الرحلة) *@
                                                <div class="form-field form-field-with-dropdown">
                                                    <label class="field-label">العربية المتاحة</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/></svg></span>
                                                        <input class="field-input with-prefix" value="@VehicleText(ln.Trip)" placeholder="ابحث برقم العربية المتاحة..."
                                                               @oninput="e => OnVehicleSearch(ln.Trip, e)"
                                                               @onfocus="() => OnLineVehicleFocus(ln)"
                                                               @onfocusout="() => ln.Trip.ShowVehicles = false" />
                                                    </div>
                                                    @if (ln.Trip.ShowVehicles && ln.Trip.FilteredVehicles.Count > 0)
                                                    {
                                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                            @foreach (var v in ln.Trip.FilteredVehicles)
                                                            { <div class="field-dropdown-item" @onmousedown="() => PickLineVehicle(ln, v)">@v.Label</div> }
                                                        </div>
                                                    }
                                                    @if (_availLoaded && OrderedVehiclesFor(ln.Trip).Count == 0)
                                                    { <div class="field-hint">مفيش عربية متاحة في التاريخ ده</div> }
                                                </div>

                                                @* #101 — المالك طلب إخفاء حقل المقطورة. فلاج مش حذف:
                                                   ‏`ln.Trip.TrailerId` لسه بيتحمل من الرحلة المسجّلة (MapTripsToLines)
                                                   وبيتبعت في الحفظ — فالإخفاء ما بيضيّعش أي داتا. *@
                                                @if (_showTrailerField)
                                                {
                                                    <div class="form-field">
                                                        <label class="field-label">المقطورة</label>
                                                        <div class="field-select-wrap">
                                                            <select class="field-input field-select" @bind="ln.Trip.TrailerId">
                                                                <option value="">— من غير مقطورة —</option>
                                                                @foreach (var t2 in _trailers)
                                                                { <option value="@t2.Id">@t2.Label</option> }
                                                            </select>
                                                        </div>
                                                    </div>
                                                }

                                                <div class="form-field form-field-with-dropdown">
                                                    <label class="field-label">سحب الرحلة</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input with-prefix" value="@ln.PortSearch" placeholder="اكتب اسم الجهة للبحث..."
                                                               @oninput="e => OnLinePortSearch(ln, e)"
                                                               @onfocus="() => { ln.ShowPorts = true; ln.FilteredPorts = FilterOpts(_ports, ln.PortSearch); }"
                                                               @onfocusout="() => ln.ShowPorts = false" />
                                                    </div>
                                                    @if (ln.ShowPorts && ln.FilteredPorts.Count > 0)
                                                    {
                                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                            @foreach (var o in ln.FilteredPorts)
                                                            { <div class="field-dropdown-item" @onmousedown="() => PickLinePort(ln, o)">@o.Label</div> }
                                                        </div>
                                                    }
                                                </div>

                                                <div class="form-field form-field-with-dropdown">
                                                    <label class="field-label">وجهة الرحلة</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input with-prefix" value="@ln.DestSearch" placeholder="اكتب اسم الجهة للبحث..."
                                                               @oninput="e => OnLineDestSearch(ln, e)"
                                                               @onfocus="() => { ln.ShowDests = true; ln.FilteredDests = FilterOpts(_destinations, ln.DestSearch); }"
                                                               @onfocusout="() => ln.ShowDests = false" />
                                                    </div>
                                                    @if (ln.ShowDests && ln.FilteredDests.Count > 0)
                                                    {
                                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                            @foreach (var o in ln.FilteredDests)
                                                            { <div class="field-dropdown-item" @onmousedown="() => PickLineDest(ln, o)">@o.Label</div> }
                                                        </div>
                                                    }
                                                </div>

                                                <div class="form-field form-field-with-dropdown">
                                                    <label class="field-label">تعتيق الرحلة</label>
                                                    <div class="field-input-group">
                                                        <input class="field-input with-prefix" value="@ln.TahteeqSearch" placeholder="اكتب اسم الجهة للبحث..."
                                                               @oninput="e => OnLineTahteeqSearch(ln, e)"
                                                               @onfocus="() => { ln.ShowTahteeqs = true; ln.FilteredTahteeqs = FilterOpts(_ports, ln.TahteeqSearch); }"
                                                               @onfocusout="() => ln.ShowTahteeqs = false" />
                                                    </div>
                                                    @if (ln.ShowTahteeqs && ln.FilteredTahteeqs.Count > 0)
                                                    {
                                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                                            @foreach (var o in ln.FilteredTahteeqs)
                                                            { <div class="field-dropdown-item" @onmousedown="() => PickLineTahteeq(ln, o)">@o.Label</div> }
                                                        </div>
                                                    }
                                                </div>

                                                @* #82 — المبالغ التلاتة: النولون كله = نولون + مبيت + تحويله *@
                                                <div class="form-field">
                                                    <label class="field-label">نولون السائق (ج.م)</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                                        @* #82 — value/onchange بدل @bind عشان نعرف إن المستخدم كتب بإيده *@
                                                        <input type="number" min="0" step="0.01" class="field-input with-prefix"
                                                               value="@ln.Trip.Freight"
                                                               @onchange="e => OnLineFreightInput(ln, e)" />
                                                    </div>
                                                </div>
                                                <div class="form-field">
                                                    <label class="field-label">مبيت (ج.م)</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                                        <input type="number" min="0" step="0.01" class="field-input with-prefix" @bind="ln.Trip.Overnight" />
                                                    </div>
                                                </div>
                                                <div class="form-field">
                                                    <label class="field-label">تحويلة (ج.م)</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                                        <input type="number" min="0" step="0.01" class="field-input with-prefix" @bind="ln.Trip.Transfer" />
                                                    </div>
                                                </div>
                                                <div class="form-field">
                                                    <label class="field-label">حساب السيارة على الرحلة</label>
                                                    <div class="rf-lt-total">@(ln.Trip.FreightTotal.ToString("N0")) ج.م</div>
                                                    @if (!string.IsNullOrWhiteSpace(ln.FreightHint))
                                                    { <div class="field-hint">@ln.FreightHint</div> }
                                                </div>

                                                @* #82 — التاريخ جزء من مطابقة قاعدة النولون ومن إتاحة العربية،
                                                   فأي تغيير فيه بيحدّث الاتنين *@
                                                <div class="form-field">
                                                    <label class="field-label">ميعاد التحرك</label>
                                                    <div class="field-input-group">
                                                        <input type="datetime-local" class="field-input"
                                                               value="@(ln.Trip.PlannedStartAt?.ToString("yyyy-MM-ddTHH:mm"))"
                                                               @onchange="e => OnLineDateChange(ln, e)" />
                                                    </div>
                                                </div>

                                                @* #84 — إجراءات الرحلة في شريط واحد جنب ميعاد التحرك *@
                                                <div class="rf-lt-actions">
                                                    <span class="rf-lt-actions-k">إجراءات الرحلة</span>
                                                    @* #101 — بيسحب التحميل/الوجهة/التعتيق من سطور الإيراد (تاب بيانات النقل) *@
                                                    <button type="button" class="rf-btn" title="ينسخ التحميل والوجهة والتعتيق من تاب «بيانات النقل» — وتقدر تغيّرهم بعده"
                                                            @onclick="() => PullRouteFromRevenueAsync(ln)">اسحب الوجهات من بيانات النقل</button>
                                                    <button type="button" class="rf-btn rf-btn-primary" @onclick="() => SuggestLineFreightAsync(ln, true)">اقترح النولون</button>
                                                    <button type="button" class="rf-btn" @onclick="() => CheckLineConflictAsync(ln)">افحص التعارض</button>
                                                    @if (ln.Trip.TripId is not null && ln.Trip.Status is not "Completed" and not "Closed" and not "Cancelled")
                                                    {
                                                        @if (ln.Trip.Status is "Planned" or "Assigned")
                                                        { <button type="button" class="rf-btn rf-btn-go" @onclick="() => StartExistingTripAsync(LineTripRef(ln))">بدء الرحلة</button> }
                                                        @if (ln.Trip.Status is "InTransit" or "Started" or "DriverReceived")
                                                        { <button type="button" class="rf-btn rf-btn-go" @onclick="() => CompleteExistingTripAsync(LineTripRef(ln))">إنهاء الرحلة</button> }
                                                        <button type="button" class="rf-btn rf-btn-danger" @onclick="() => RemoveTripAsync(LineTripRef(ln))">إلغاء الرحلة</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <button type="button" class="bk-add-line-btn mt-10" @onclick="AddLine">+ إضافة سطر حاويات ورحلة</button>
                            <div class="form-field" style="margin-top:14px">
                                <label class="field-label">ملاحظات الطلب</label>
                                <textarea class="field-input field-textarea" rows="3" maxlength="1000" placeholder="أي ملاحظات خاصة بهذا الطلب..." @onchange="e => _f.Notes = e.Value?.ToString()">@_f.Notes</textarea>
                            </div>
                        </div>

                    </ChildContent>
                </MudTabPanel>


            </MudTabs>
        </div>

        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="bk-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                @if (_ok)
                {
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01" stroke-linecap="round"/></svg>
                }
                <span>@_msg</span>
            </div>
        }

        @* ── Bottom Actions ── *@
        <div class="bk-bottom-actions">

            <button class="bk-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للقائمة
            </button>

            <div class="bk-bottom-right">

                @if (_activeTab < 3)
                {
                    <button class="bk-next-btn"
                            @onclick="() => _activeTab++">
                        التالي
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                }

                <button class="bk-bottom-save"
                        @onclick="SaveAsync"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                            <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>@(OperationId is null ? "إنشاء الطلب" : "حفظ الطلب")</span>
                    }
                </button>

            </div>
        </div>
    }
</div>

@code {
    [Parameter] public long? OperationId { get; set; }

    private AuthUser? _user;
    private bool CanViewFinancials => (_user?.IsAdmin ?? false) || (_user?.Can("OPERATION.VIEW_FINANCIALS") ?? false);
    private bool CanUse => OperationId is null
        ? (_user?.Can("OPERATION.CREATE") == true && _user?.Can("BOOKING.CREATE") == true)
        : (_user?.Can("OPERATION.EDIT") == true && _user?.Can("BOOKING.EDIT") == true);
    private bool CanEditContainerDetails => CanUse;
    private bool CanEditTrips => _user?.Can("TRIP.EDIT") ?? false;
    private bool CanTripCancel => _user?.Can("TRIP.CANCEL") ?? false;
    private bool CanTripCreate => _user?.Can("TRIP.CREATE") ?? false;

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    /* أنواع الحاويات بتيجي من السيرفر بمبلغ ضمانها — اختيار النوع بيعبّي الضمان */
    public class CTOpt { public int Id { get; set; } public string Label { get; set; } = ""; public decimal? GuaranteeAmount { get; set; } }
    private List<CTOpt> _containerTypes = new();

    /* #82 — async: نوع الحاوية بُعد في قاعدة النولون، فالاقتراح بيتحدّث معاه */
    private async Task OnLineTypeChange(LineRow ln, ChangeEventArgs e)
    {
        ln.ContainerTypeId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        var t = _containerTypes.FirstOrDefault(x => x.Id == ln.ContainerTypeId);
        if (t is null) ln.Guarantee = null;                          // رجع «اختر» — الضمان يتفضى
        else if (t.GuaranteeAmount is not null) ln.Guarantee = t.GuaranteeAmount;
        await SuggestLineFreightAsync(ln);
        /* #94 — نوع الحاوية بُعد في قواعد التسعير، فاختياره لازم يحدّث سعر
           سطور الإيراد كمان (مش النولون بس). اللي المستخدم كتبه بإيده ما يتداسش
           لأن SuggestForLineAsync بترجع فورًا لو PriceTouched. */
        /* #99 — نزامن نوع الحاوية على سطور الإيراد الأول، وبعدين نعيد التسعير */
        SyncRevContainerTypes();
        foreach (var rl in _loadedRevLines) await SuggestForLineAsync(rl);
    }

    /* #82 — اختيار السائق/العربية على سطر: بنعيد استخدام المنطق المشترك
       وبعدين بنفحص التعارض تلقائي — التحذير يظهر من غير ما المستخدم يطلبه */
    /* #101 — زرار «اسحب الوجهات من بيانات النقل»: بياخد التحميل/الوجهة/التعتيق
       من أول سطر إيراد فيه خط سير، ويحطهم على رحلة السطر ده.
       المستخدم يقدر يغيّرهم أو يعدّلهم بعده عادي — مافيش قفل.
       وبيعيد اقتراح النولون لأن خط السير بُعد في قاعدة النوالين. */
    private async Task PullRouteFromRevenueAsync(LineRow ln)
    {
        /* أول سطر إيراد فيه خط سير. ولو مفيش (مثلاً المستخدم مالوش حق المالية
           فقسم الإيرادات مش ظاهرله) ⇒ بنرجع لخط سير راس الطلب اللي جاي من الحجز. */
        var src = _loadedRevLines.FirstOrDefault(r =>
            r.PortId is not null || r.DestinationId is not null || r.TahteeqPortId is not null);

        int? portId = src?.PortId        ?? _f.PortId;
        int? destId = src?.DestinationId ?? _f.DestinationId;
        int? tahId  = src?.TahteeqPortId ?? _f.TahteeqPortId;

        if (portId is null && destId is null && tahId is null)
        {
            ln.ConflictMsg = "مفيش خط سير — عبّي التحميل والوجهة في تاب «بيانات النقل» الأول";
            return;
        }

        ln.ConflictMsg          = null;
        ln.Trip.PortId          = portId;
        ln.Trip.DestinationId   = destId;
        ln.Trip.TahteeqPortId   = tahId;
        ln.PortSearch           = PortLabel(portId);
        ln.DestSearch           = DestLabel(destId);
        ln.TahteeqSearch        = PortLabel(tahId);

        await SuggestLineFreightAsync(ln);
    }

    private async Task PickLineDriver(LineRow ln, PairOpt d)
    {
        PickDriver(ln.Trip, d);
        await CheckLineConflictAsync(ln);
    }

    private async Task PickLineVehicle(LineRow ln, PairOpt v)
    {
        PickVehicle(ln.Trip, v);
        await CheckLineConflictAsync(ln);
    }

    /* #82 — تغيير الميعاد: التاريخ بُعد في قاعدة النولون **و**في إتاحة العربية */
    private async Task OnLineDateChange(LineRow ln, ChangeEventArgs e)
    {
        ln.Trip.PlannedStartAt = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : ln.Trip.PlannedStartAt;
        await LoadAvailableVehiclesAsync(ln.Trip.PlannedStartAt);   // القائمة المتاحة بتتغيّر بالتاريخ
        await SuggestLineFreightAsync(ln);                          // والقاعدة السارية كمان
        await CheckLineConflictAsync(ln);                           // والتعارض بيتحسب بالتاريخ
    }

    /* #82 — المستخدم كتب النولون بإيده */
    private void OnLineFreightInput(LineRow ln, ChangeEventArgs e)
    {
        ln.Trip.Freight = decimal.TryParse(e.Value?.ToString(), out var v) ? v : null;
        ln.FreightTouched = true;
        ln.FreightHint = null;
    }

    private List<Opt> _agents = new(), _customers = new(), _services = new(), _ports = new(),
                      _destinations = new(), _tripTypes = new(), _suppliers = new(),
                      _guaranteeSuppliers = new(), _trailers = new();

    /* مورد الضمان متفلتر على «خدمات ميناء» (قرار المالك) — والمورّد المحفوظ
       على طلب قديم بيظهر حتى لو نوعه اتغير، عشان التعديل ما يضيّعوش */
    private List<Opt> GuaranteeOptions
    {
        get
        {
            var list = _guaranteeSuppliers.ToList();
            if (_f.GuaranteeSupplierId is int gid && gid > 0 && list.All(x => x.Id != gid))
            {
                var cur = _suppliers.FirstOrDefault(x => x.Id == gid);
                if (cur is not null) list.Insert(0, cur);
            }
            return list;
        }
    }

    /* ── التعيين: سائق/عربية بيتزاوجوا عن طريق المورد (قرار المالك) ── */
    public class PairOpt { public int Id { get; set; } public string Label { get; set; } = ""; public int? SupplierId { get; set; } public bool IsCompany { get; set; } public int? DefaultDriverId { get; set; } }
    private List<PairOpt> _driverPairs = new(), _vehiclePairs = new();

    /* #82 — العربيات المتاحة **بتاريخ الرحلة**. null = لسه ما اتحمّلتش،
       ووقتها منفلترش (أحسن من إننا نقفل الاختيار على الفاضي) */
    private HashSet<int>? _availVehicleIds;
    private string? _availForDate;
    private bool _availLoaded;

    private class TripRow
    {
        public int DriverId { get; set; }
        public int VehicleId { get; set; }
        public int? TrailerId { get; set; }
        /* #82 — لو السطر ده ليه رحلة مسجّلة أصلًا، بنعرفها عشان التعديل يعدّلها
           بدل ما يعمل رحلة تانية مكررة */
        public long? TripId { get; set; }
        public string TripNumber { get; set; } = "";
        public string Status { get; set; } = "";
        /* #102 — نوع رحلة السطر نفسه وملاحظاته (كانا بيضيعوا: النوع بيتبعت
           من نوع الحجز والملاحظات بتتبعت فاضية في أي حفظ) */
        public int? TripTypeId { get; set; }
        public string? Notes { get; set; }
        /* #102 — بصمة القيم وقت التحميل: الحفظ ما بيكتبش رحلة بصمتها ما اتغيرتش */
        public string? LoadedKey { get; set; }
        public decimal? Freight { get; set; }
        public DateTime? PlannedStartAt { get; set; }

        /* #82 — مبيت + تحويله. النولون الكلي = Freight + Overnight + Transfer
           وده اللي بيتبعت في freightAmount عشان التقارير تفضل زي ما هي */
        public decimal? Overnight { get; set; }
        public decimal? Transfer { get; set; }
        public decimal FreightTotal => (Freight ?? 0) + (Overnight ?? 0) + (Transfer ?? 0);

        /* #78 — خط سير الرحلة نفسها. بيتملأ افتراضي من الطلب،
           والمستخدم يغيّره لو الحاويات رايحة وجهات مختلفة. */
        public int? PortId { get; set; }
        public int? DestinationId { get; set; }
        public int? TahteeqPortId { get; set; }

        /* حالة البحث في السائق/العربية */
        public string DriverSearch { get; set; } = "";
        public string VehicleSearch { get; set; } = "";
        public bool ShowDrivers { get; set; }
        public bool ShowVehicles { get; set; }
        public bool DriverTouched { get; set; }
        public bool VehicleTouched { get; set; }
        public List<PairOpt> FilteredDrivers { get; set; } = new();
        public List<PairOpt> FilteredVehicles { get; set; } = new();
    }

    private static List<PairOpt> FilterPairs(List<PairOpt> src, string search) =>
        string.IsNullOrWhiteSpace(search)
            ? src.Take(20).ToList()
            : src.Where(x => x.Label.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)).Take(20).ToList();

    private string DriverText(TripRow r) =>
        !r.DriverTouched && r.DriverId > 0
            ? (_driverPairs.FirstOrDefault(d => d.Id == r.DriverId)?.Label ?? "")
            : r.DriverSearch;

    private string VehicleText(TripRow r) =>
        !r.VehicleTouched && r.VehicleId > 0
            ? (_vehiclePairs.FirstOrDefault(v => v.Id == r.VehicleId)?.Label ?? "")
            : r.VehicleSearch;

    private void OnDriverSearch(TripRow r, ChangeEventArgs e)
    {
        r.DriverSearch = e.Value?.ToString() ?? "";
        r.DriverTouched = true;
        r.ShowDrivers = true;
        r.FilteredDrivers = FilterPairs(OrderedDriversFor(r), r.DriverSearch);
        if (string.IsNullOrWhiteSpace(r.DriverSearch)) r.DriverId = 0;
    }

    private void OnVehicleSearch(TripRow r, ChangeEventArgs e)
    {
        r.VehicleSearch = e.Value?.ToString() ?? "";
        r.VehicleTouched = true;
        r.ShowVehicles = true;
        r.FilteredVehicles = FilterPairs(OrderedVehiclesFor(r), r.VehicleSearch);
        if (string.IsNullOrWhiteSpace(r.VehicleSearch)) r.VehicleId = 0;
    }

    private void PickDriver(TripRow r, PairOpt d)
    {
        r.DriverId = d.Id;
        r.DriverSearch = d.Label;
        r.DriverTouched = false;
        r.ShowDrivers = false;
        AfterDriverPicked(r);
        /* التعبئة التلقائية للعربية من الربط لازم تنعكس في خانة بحثها */
        if (r.VehicleId > 0) { r.VehicleTouched = false; r.VehicleSearch = ""; }
    }

    private void PickVehicle(TripRow r, PairOpt v)
    {
        r.VehicleId = v.Id;
        r.VehicleSearch = v.Label;
        r.VehicleTouched = false;
        r.ShowVehicles = false;
        AfterVehiclePicked(r);
        if (r.DriverId > 0) { r.DriverTouched = false; r.DriverSearch = ""; }
    }

    /* #80 — سطر إيراد جديد (وضع التعديل)
       #94 — بقى async: السطر الجديد بيجيب سعره من قائمة الأسعار على طول */
    private async Task AddRevLineAsync()
    {
        var rl = new LoadedRevLine
        {
            ServiceId     = _f.ServiceId ?? 0,
            Quantity      = 1,
            UnitPrice     = 0,
            Discount      = 0,
            /* #81 — السطر الجديد يرث مسار الطلب، و#83 — ونوع الرحلة */
            PortId        = _f.PortId,
            DestinationId = _f.DestinationId,
            TahteeqPortId = _f.TahteeqPortId,
            TripTypeId    = _f.TripTypeId,
            PortSearch    = PortLabel(_f.PortId),
            DestSearch    = DestLabel(_f.DestinationId),
            TahteeqSearch = PortLabel(_f.TahteeqPortId)
        };
        _loadedRevLines.Add(rl);
        SyncRevContainerTypes();          /* #99 — السطر الجديد يرث نوع الحاوية */
        await SuggestForLineAsync(rl);
    }

    /* #83 — اقتراح سعر لسطر معيّن حسب أبعاده هو (خدمة/مسار/نوع رحلة).
       بيشتغل تلقائي مع كل تغيير، واللي المستخدم كتبه بإيده ما يتستبدلش */
    private async Task SuggestForLineAsync(LoadedRevLine rl, bool force = false)
    {
        if (rl.PriceTouched && !force) return;

        /* مفيش عميل أو خدمة في السطر ⇒ مفيش حاجة نطابق عليها (من غير نداء ولا رسالة) */
        if (_f.CustomerId <= 0 || rl.ServiceId <= 0) { rl.Hint = null; return; }

        /* #99 — نوع الحاوية من السطر نفسه، مش من أول حاوية في التاب */
        var url = $"api/operations/price-suggest?customerId={_f.CustomerId}&serviceId={rl.ServiceId}" +
                  (rl.PortId        is not null ? $"&portId={rl.PortId}" : "") +
                  (rl.DestinationId is not null ? $"&destinationId={rl.DestinationId}" : "") +
                  (rl.TahteeqPortId is not null ? $"&tahteeqPortId={rl.TahteeqPortId}" : "") +
                  (rl.TripTypeId    is not null ? $"&tripTypeId={rl.TripTypeId}" : "") +
                  (rl.ContainerTypeId > 0       ? $"&containerTypeId={rl.ContainerTypeId}" : "") +
                  $"&date={_f.Date}";
        try
        {
            var sg = await Http.GetFromJsonAsync<Suggestion>(url);
            /* #95 — 🔴 السعر من قوائم الأسعار بس. null ⇒ مفيش قاعدة مطابقة،
               والسعر يفضل زي ما هو (ما نكتبش صفر على اللي المستخدم كاتبه) */
            /* #99 — الطلب: جملة بسيطة بس — «يوجد قاعدة تسعير» أو «لا يوجد».
               السبب التفصيلي من السيرفر بقى في HintDetail (title بالماوس) مش ظاهر. */
            if (sg is null) { rl.Hint = "لا يوجد قاعدة تسعير"; rl.HintDetail = null; }
            else if (sg.UnitPrice is null) { rl.Hint = "لا يوجد قاعدة تسعير"; rl.HintDetail = sg.Source; }
            else { rl.UnitPrice = sg.UnitPrice.Value; rl.Hint = "يوجد قاعدة تسعير"; rl.HintDetail = sg.Source; }
        }
        catch { rl.Hint = null; rl.HintDetail = null; /* الاقتراح اختياري — ما يوقفش الشغل */ }
    }

    /* #83 — تغييرات السطر: نحدّث راس الطلب وبعدين نقترح السعر */
    private async Task OnRevLineServiceChange(LoadedRevLine rl, ChangeEventArgs e)
    {
        rl.ServiceId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        SyncHeaderFromLines();
        await SuggestForLineAsync(rl);
    }

    private async Task OnRevLineTripTypeChange(LoadedRevLine rl, ChangeEventArgs e)
    {
        rl.TripTypeId = int.TryParse(e.Value?.ToString(), out var v) ? v : (int?)null;
        SyncHeaderFromLines();
        await SuggestForLineAsync(rl);
    }

    /* #99 — المستخدم اختار نوع الحاوية بإيده على السطر ⇒ نعلّمها عشان
       المزامنة التلقائية من تاب الحاويات ما تدوسش على اختياره */
    private async Task OnRevLineContainerChange(LoadedRevLine rl, ChangeEventArgs e)
    {
        rl.ContainerTypeId   = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        rl.ContainerTouched  = rl.ContainerTypeId > 0;
        await SuggestForLineAsync(rl);
    }

    /* #99 — نوع الحاوية يتعبّى لوحده في سطور الإيراد من تاب الحاويات.
       سطر الإيراد رقم 1 ياخد نوع سطر الحاويات رقم 1، ورقم 2 ياخد رقم 2 —
       عشان طلب فيه 20 قدم و40 قدم يسعّر كل سطر بنوعه صح.
       اللي المستخدم اختاره بإيده (ContainerTouched) ما يتلمسش. */
    private void SyncRevContainerTypes()
    {
        var types = _lines.Where(l => l.ContainerTypeId > 0).Select(l => l.ContainerTypeId).ToList();
        if (types.Count == 0) return;
        for (var i = 0; i < _loadedRevLines.Count; i++)
        {
            var rl = _loadedRevLines[i];
            if (rl.ContainerTouched) continue;
            rl.ContainerTypeId = i < types.Count ? types[i] : types[0];
        }
    }

    /* #84 — التحميل/الوجهة/التعتيق: بحث بالكتابة. أول ما تختار، السعر يقترح نفسه */
    private void OnRevPortSearch(LoadedRevLine rl, ChangeEventArgs e)
    { rl.PortSearch = e.Value?.ToString() ?? ""; rl.ShowPorts = true; rl.FilteredPorts = FilterOpts(_ports, rl.PortSearch); if (string.IsNullOrWhiteSpace(rl.PortSearch)) rl.PortId = null; }

    private async Task PickRevPort(LoadedRevLine rl, Opt o)
