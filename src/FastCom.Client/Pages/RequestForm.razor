    /* #83 — الخدمة ونوع الرحلة بقوا في السطر؛ راس الطلب (اللي بيتبعت للحجز
       والعملية والرحلات) بتاخد قيمة أول سطر إيراد */
    private void SyncHeaderFromLines()
    {
        var first = _loadedRevLines.FirstOrDefault();
        if (first is null) return;
        if (first.ServiceId > 0)          _f.ServiceId     = first.ServiceId;
        if (first.TripTypeId is not null) _f.TripTypeId    = first.TripTypeId;
        /* #84 — قسم خط السير اتشال من التاب؛ راس الطلب (اللي بيتبعت للحجز والعملية
           وبيورّث لرحلات الحاويات) بياخد قيمته من أول سطر إيراد */
        if (first.PortId is not null)        _f.PortId        = first.PortId;
        if (first.DestinationId is not null) _f.DestinationId = first.DestinationId;
        if (first.TahteeqPortId is not null) _f.TahteeqPortId = first.TahteeqPortId;
    }

    /* #83 — سطور الإيراد اللي بتتبعت للسيرفر (بأبعادها) */
    private List<object> BuildRevLines() => _loadedRevLines
        .Where(l => l.ServiceId > 0 && l.Quantity > 0)
        .Select(l => (object)new
        {
            serviceId     = l.ServiceId,
            description   = l.Description,
            quantity      = l.Quantity,
            unitPrice     = l.UnitPrice,
            discount      = l.Discount,
            taxRateId     = l.TaxRateId,
            priceRuleId   = l.PriceRuleId,
            portId        = l.PortId,
            destinationId = l.DestinationId,
            tahteeqPortId = l.TahteeqPortId,
            tripTypeId    = l.TripTypeId
        }).ToList();

    /* #82 — سطر حاويات جديد وليه رحلته. الرحلة ترث خط سير الطلب
       وتتعدّل لو الحاويات رايحة وجهة مختلفة */
    /* #82 — اسم الجهة مكتوب. فاضي لو مش محدد */
    /* #101 — المبلغ من غير أصفار زيادة: ‏18700.0000 ⇒ 18700 · ‏18700.50 ⇒ 18700.5
       ‏InvariantCulture لازم: ‏<input type="number"> ما بيقبلش أرقام عربية (١٨٧٠٠) */
    private static string Money(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string PortLabel(int? id) => _ports.FirstOrDefault(p => p.Id == id)?.Label ?? "";

    /* #95 — البيان بيتكتب أوتوماتيك من المسار (زي OperationForm.BuildRouteDesc):
       «من {التحميل} إلى {الوجهة} — تعتيق {التعتيق}».
       بيتكتب **مرة واحدة** بس: لو المستخدم عدّله بإيده ما ندوسش على كلامه. */
    private string? BuildRouteDesc(LoadedRevLine rl)
    {
        var from = PortLabel(rl.PortId);
        var to   = DestLabel(rl.DestinationId);
        var tah  = PortLabel(rl.TahteeqPortId);
        if (from.Length == 0 && to.Length == 0 && tah.Length == 0) return null;
        var s = from.Length > 0 && to.Length > 0 ? $"من {from} إلى {to}"
              : from.Length > 0                  ? $"من {from}"
              : to.Length   > 0                  ? $"إلى {to}" : "";
        if (tah.Length > 0) s = s.Length > 0 ? $"{s} — تعتيق {tah}" : $"تعتيق {tah}";
        return s;
    }

    private void AutoFillDesc(LoadedRevLine rl)
    {
        if (rl.DescTouched) return;                       /* المستخدم كتبه بإيده */
        var d = BuildRouteDesc(rl);
        if (d is not null) rl.Description = d;
    }
    private string DestLabel(int? id) => _destinations.FirstOrDefault(p => p.Id == id)?.Label ?? "";

    /* #82 — وضع التعديل: كل رحلة مسجّلة بتروح جوه سطر الحاوية بتاعها (1:1 بالترتيب)،
       فبيانات الرحلة تظهر في نفس القسم بدل ما تكون فاضية.
       الرحلة اللي اتوزّعت على سطر بتتشال من قسم «الرحلات والتعيين» عشان ما تتكررش. */
    /* #102 — بصمة القيم القابلة للتعديل في رحلة السطر: بتتحسب وقت التحميل
       ووقت الحفظ، وتساويها معناه إن الرحلة ما اتلمستش فما تتكتبش من أصله */
    private static string TripKeyOf(TripRow r) => string.Join("|",
        r.DriverId, r.VehicleId, r.TrailerId, r.TripTypeId,
        r.PlannedStartAt?.Ticks, r.Freight, r.Overnight, r.Transfer,
        r.PortId, r.DestinationId, r.TahteeqPortId, r.Notes);

    private void MapTripsToLines()
    {
        var mapped = new List<ExistingTrip>();
        for (var i = 0; i < _lines.Count && i < _existingTrips.Count; i++)
        {
            var ln = _lines[i];
            var t  = _existingTrips[i];
            ln.Trip.TripId         = t.TripId;
            ln.Trip.TripNumber     = t.TripNumber;
            ln.Trip.Status         = t.Status;
            ln.Trip.DriverId       = t.DriverId;
            ln.Trip.VehicleId      = t.VehicleId;
            ln.Trip.TrailerId      = t.TrailerId;
            ln.Trip.TripTypeId     = t.TripTypeId;
            ln.Trip.Notes          = t.Notes;
            ln.Trip.PlannedStartAt = t.PlannedStartAt;
            ln.Trip.PortId         = t.PortId         ?? _f.PortId;
            ln.Trip.DestinationId  = t.DestinationId  ?? _f.DestinationId;
            ln.Trip.TahteeqPortId  = t.TahteeqPortId  ?? _f.TahteeqPortId;
            ln.Trip.Overnight      = t.OvernightAmount;
            ln.Trip.Transfer       = t.TransferAmount;
            ln.Trip.Freight        = t.FreightBase;
            ln.Trip.DriverSearch   = t.DriverName;
            ln.Trip.VehicleSearch  = t.VehiclePlate;
            ln.PortSearch          = t.PortName     ?? PortLabel(ln.Trip.PortId);
            ln.DestSearch          = t.DestName     ?? DestLabel(ln.Trip.DestinationId);
            ln.TahteeqSearch       = t.TahteeqName  ?? PortLabel(ln.Trip.TahteeqPortId);
            /* النولون المحفوظ قيمة حقيقية — الاقتراح التلقائي ما يستبدلهاش */
            ln.FreightTouched      = true;
            /* #102 — بصمة ما اتحمّل: أي حفظ بعد كده ما بيكتبش الرحلة دي
               إلا لو المستخدم غيّر فيها حاجة فعلًا */
            ln.Trip.LoadedKey      = TripKeyOf(ln.Trip);
            mapped.Add(t);
        }
        _mappedTrips = mapped.Count;
        if (mapped.Count > 0) _existingTrips = _existingTrips.Except(mapped).ToList();

        /* السطور اللي ملهاش رحلة مسجّلة: تورّث خط سير الطلب وميعاده،
           والجهات تفضل مكتوبة بأسمائها (ومش بنلمس سطر المستخدم بدأ يعدّل فيه) */
        foreach (var ln in _lines.Where(x => x.Trip.TripId is null && x.Trip.DriverId == 0
                                          && x.Trip.PortId is null && x.Trip.DestinationId is null
                                          && x.Trip.TahteeqPortId is null))
        {
            ln.Trip.PlannedStartAt = DateTime.TryParse(_f.Date, out var d) ? d.AddHours(8) : DateTime.Today.AddHours(8);
            ln.Trip.PortId         = _f.PortId;
            ln.Trip.DestinationId  = _f.DestinationId;
            ln.Trip.TahteeqPortId  = _f.TahteeqPortId;
            ln.PortSearch          = PortLabel(ln.Trip.PortId);
            ln.DestSearch          = DestLabel(ln.Trip.DestinationId);
            ln.TahteeqSearch       = PortLabel(ln.Trip.TahteeqPortId);
        }
    }

    /* #82 — أزرار الرحلة المسجّلة (بدء/إنهاء/إلغاء) بتشتغل على رحلة السطر */
    private static ExistingTrip LineTripRef(LineRow ln) => new()
    {
        TripId = ln.Trip.TripId!.Value, TripNumber = ln.Trip.TripNumber, Status = ln.Trip.Status
    };

    private void AddLine() => _lines.Add(NewLineRow());

    private LineRow NewLineRow()
    {
        var ln = new LineRow
        {
            Trip = new TripRow
            {
                PlannedStartAt = DateTime.TryParse(_f.Date, out var d) ? d.AddHours(8) : DateTime.Today.AddHours(8),
                PortId         = _f.PortId,
                DestinationId  = _f.DestinationId,
                TahteeqPortId  = _f.TahteeqPortId
            }
        };
        /* #82 — الجهات مكتوبة بأسمائها في خانات السطر */
        ln.PortSearch     = PortLabel(ln.Trip.PortId);
        ln.DestSearch     = DestLabel(ln.Trip.DestinationId);
        ln.TahteeqSearch  = PortLabel(ln.Trip.TahteeqPortId);
        return ln;
    }

    /* #82 — حذف السطر: محليًا بس. الحفظ هو اللي بيمسحه من السيرفر
       (ولو ليه حاويات فعلية السيرفر بيرفض المسح) */
    private Task RemoveLineAsync(LineRow ln)
    {
        if (_lines.Count > 1) _lines.Remove(ln);
        return Task.CompletedTask;
    }

    /* #78 — ملخّص خط سير الرحلة للعرض */
    private static string? RouteOf(ExistingTrip t)
    {
        var s = t.PortName is not null && t.DestName is not null ? $"من {t.PortName} إلى {t.DestName}"
              : t.PortName is not null                           ? $"من {t.PortName}"
              : t.DestName is not null                           ? $"إلى {t.DestName}" : null;
        if (s is null && t.TahteeqName is null) return null;
        if (t.TahteeqName is not null) s = s is null ? $"تعتيق {t.TahteeqName}" : $"{s} — تعتيق {t.TahteeqName}";
        return s;
    }

    private static string TripStatusAr(string s) => s switch
    {
        "Planned"         => "مخططة",
        "Assigned"        => "مُعيّنة",
        "DriverReceived"  => "استلم السائق",
        "Started"         => "في الطريق",
        "InTransit"       => "في الطريق",
        "Delivered"       => "تم التسليم",
        "ExpensesPending" => "بانتظار المصروفات",
        "CustodyPending"  => "بانتظار العهدة",
        "ReadyToClose"    => "جاهزة للإغلاق",
        "Completed"       => "مكتملة",
        "Closed"          => "مغلقة",
        "Cancelled"       => "ملغاة",
        _                 => s
    };

    private static bool SameSource(PairOpt a, PairOpt b) =>
        (a.IsCompany && b.IsCompany) ||
        (!a.IsCompany && !b.IsCompany && a.SupplierId is not null && a.SupplierId == b.SupplierId);

    private List<PairOpt> OrderedDriversFor(TripRow r)
    {
        var v = _vehiclePairs.FirstOrDefault(x => x.Id == r.VehicleId);
        if (v is null) return _driverPairs;
        return _driverPairs.OrderByDescending(p => SameSource(p, v) ? 1 : 0).ToList();
    }

    /* ═══ #82 — بحث بمجرد الكتابة في التحميل/الوجهة/التعتيق.
       ملاحظة: FilterOpts نفسها موجودة أصلًا في الملف (بحث العميل النهائي) —
       بنستخدم الموجودة وما نكررهاش (CS0111). ═══ */
    private void OnPortSearch(ChangeEventArgs e)
