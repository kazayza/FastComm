    private void OnRevDestSearch(LoadedRevLine rl, ChangeEventArgs e)
    { rl.DestSearch = e.Value?.ToString() ?? ""; rl.ShowDests = true; rl.FilteredDests = FilterOpts(_destinations, rl.DestSearch); if (string.IsNullOrWhiteSpace(rl.DestSearch)) rl.DestinationId = null; }

    private async Task PickRevDest(LoadedRevLine rl, Opt o)
    { rl.DestinationId = o.Id; rl.DestSearch = o.Label; rl.ShowDests = false; AutoFillDesc(rl); SyncHeaderFromLines(); await SuggestForLineAsync(rl); }

    private void OnRevTahteeqSearch(LoadedRevLine rl, ChangeEventArgs e)
    { rl.TahteeqSearch = e.Value?.ToString() ?? ""; rl.ShowTahteeqs = true; rl.FilteredTahteeqs = FilterOpts(_ports, rl.TahteeqSearch); if (string.IsNullOrWhiteSpace(rl.TahteeqSearch)) rl.TahteeqPortId = null; }

    private async Task PickRevTahteeq(LoadedRevLine rl, Opt o)
    { rl.TahteeqPortId = o.Id; rl.TahteeqSearch = o.Label; rl.ShowTahteeqs = false; AutoFillDesc(rl); SyncHeaderFromLines(); await SuggestForLineAsync(rl); }

