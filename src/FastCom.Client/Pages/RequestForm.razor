        _f.ShowDests = true;
        _f.FilteredDests = FilterOpts(_destinations, _f.DestSearch);
        if (string.IsNullOrWhiteSpace(_f.DestSearch)) _f.DestinationId = null;
    }
    private void PickDest(Opt o) { _f.DestinationId = o.Id; _f.DestSearch = o.Label; _f.ShowDests = false; }

    private void OnTahteeqSearch(ChangeEventArgs e)
    {
        _f.TahteeqSearch = e.Value?.ToString() ?? "";
        _f.ShowTahteeqs = true;
        _f.FilteredTahteeqs = FilterOpts(_ports, _f.TahteeqSearch);
        if (string.IsNullOrWhiteSpace(_f.TahteeqSearch)) _f.TahteeqPortId = null;
    }
    private void PickTahteeq(Opt o) { _f.TahteeqPortId = o.Id; _f.TahteeqSearch = o.Label; _f.ShowTahteeqs = false; }

    /* ═══ #82 — بحث خط سير رحلة السطر (1:1) ═══ */
    private void OnLinePortSearch(LineRow ln, ChangeEventArgs e)
    {
        ln.PortSearch = e.Value?.ToString() ?? "";
        ln.ShowPorts = true;
        ln.FilteredPorts = FilterOpts(_ports, ln.PortSearch);
        if (string.IsNullOrWhiteSpace(ln.PortSearch)) ln.Trip.PortId = null;
    }
    private async Task PickLinePort(LineRow ln, Opt o)
    { ln.Trip.PortId = o.Id; ln.PortSearch = o.Label; ln.ShowPorts = false; await SuggestLineFreightAsync(ln); }

    private void OnLineDestSearch(LineRow ln, ChangeEventArgs e)
    {
        ln.DestSearch = e.Value?.ToString() ?? "";
        ln.ShowDests = true;
        ln.FilteredDests = FilterOpts(_destinations, ln.DestSearch);
        if (string.IsNullOrWhiteSpace(ln.DestSearch)) ln.Trip.DestinationId = null;
    }
    private async Task PickLineDest(LineRow ln, Opt o)
    { ln.Trip.DestinationId = o.Id; ln.DestSearch = o.Label; ln.ShowDests = false; await SuggestLineFreightAsync(ln); }

    private void OnLineTahteeqSearch(LineRow ln, ChangeEventArgs e)
    {
        ln.TahteeqSearch = e.Value?.ToString() ?? "";
        ln.ShowTahteeqs = true;
        ln.FilteredTahteeqs = FilterOpts(_ports, ln.TahteeqSearch);
        if (string.IsNullOrWhiteSpace(ln.TahteeqSearch)) ln.Trip.TahteeqPortId = null;
    }
    private async Task PickLineTahteeq(LineRow ln, Opt o)
    { ln.Trip.TahteeqPortId = o.Id; ln.TahteeqSearch = o.Label; ln.ShowTahteeqs = false; await SuggestLineFreightAsync(ln); }

    /* ═══ #82 — اقتراح نولون السائق من جدول النوالين
       (التحميل + الوجهة + التعتيق + نوع الحاوية + نوع الرحلة) ═══ */
    /* #82 — force=false (تلقائي): لو المستخدم كتب النولون بإيده ما ندوسش على كلامه.
       force=true (زرار «اقترح النولون»): طلب صريح ⇒ بيستبدل. */
    private async Task SuggestLineFreightAsync(LineRow ln, bool force = false)
    {
        if (ln.FreightTouched && !force) return;

        /* مفيش خط سير ولا نوع حاوية ⇒ مفيش حاجة نطابق عليها */
        if (ln.Trip.PortId is null && ln.Trip.DestinationId is null
            && ln.Trip.TahteeqPortId is null && ln.ContainerTypeId <= 0) return;

        try
        {
            var url = "api/trips/freight-suggest?_=1"
                + (ln.Trip.PortId        is int pi ? $"&portId={pi}"        : "")
                + (ln.Trip.DestinationId is int di ? $"&destinationId={di}" : "")
                + (ln.Trip.TahteeqPortId is int ti ? $"&tahteeqPortId={ti}" : "")
                + (_f.TripTypeId         is int tt ? $"&tripTypeId={tt}"    : "")
                + (ln.ContainerTypeId > 0          ? $"&containerTypeId={ln.ContainerTypeId}" : "")
                + (ln.Trip.PlannedStartAt is DateTime ps ? $"&date={ps:yyyy-MM-dd}" : "");

            var res = await Http.GetFromJsonAsync<FreightSug>(url);
            if (res is null || res.Amount <= 0)
            { ln.FreightHint = "مفيش قاعدة نولون مطابقة — أدخل النولون يدوي"; return; }

            /* المبيت والتحويلة فضلوا زي ما هما — الاقتراح بيعبّي نولون السائق بس */
            ln.Trip.Freight = res.Amount;
            ln.FreightHint  = "من جدول النوالين: " + res.Source;
        }
        catch { /* الاقتراح اختياري — ما يوقفش الشغل */ }
    }
    private class FreightSug { public decimal Amount { get; set; } public long? RuleId { get; set; } public string? Source { get; set; } }

    /* ═══ #82 — فحص تعارض العربية/السائق: تحذير فيه رقم اللوحة، مش بيمنع الحفظ ═══ */
    private async Task CheckLineConflictAsync(LineRow ln)
    {
        ln.ConflictMsg = null;
        if (ln.Trip.VehicleId <= 0 && ln.Trip.DriverId <= 0) return;
        try
        {
            var url = "api/trips/availability-check?_=1"
                + (ln.Trip.VehicleId > 0 ? $"&vehicleId={ln.Trip.VehicleId}" : "")
                + (ln.Trip.DriverId  > 0 ? $"&driverId={ln.Trip.DriverId}"   : "")
                + (ln.Trip.PlannedStartAt is DateTime ps ? $"&date={ps:yyyy-MM-ddTHH:mm}" : "");

            var res = await Http.GetFromJsonAsync<ConflictRes>(url);
            ln.ConflictMsg = res is { Conflicted: true } ? res.Message : null;
        }
        catch { /* الفحص اختياري — ما يمنعش الشغل */ }
    }
    private class ConflictRes { public bool Conflicted { get; set; } public string? Message { get; set; } }


    /* #82 — العربيات المتاحة في تاريخ الرحلة بس (مش محجوزة ولا في رحلة).
       عربية محجوزة يوم 25 تفضل متاحة لرحلة يوم 20 — نفس منطق السيرفر. */
    private List<PairOpt> OrderedVehiclesFor(TripRow r)
    {
        var src = _vehiclePairs;
        /* نسخة محلية — تحليل الـ nullable ما بيدخلش جوه الـ lambda (CS8602) */
        var avail = _availVehicleIds;
        if (avail is not null)
        {
            var onlyAvail = src.Where(v => avail.Contains(v.Id)).ToList();
            /* العربية المختارة حاليًا تفضل ظاهرة حتى لو بقت مش متاحة —
               عشان المستخدم يشوفها ويقدر يغيّرها بدل ما تختفي من تحت إيده */
            var cur = src.FirstOrDefault(v => v.Id == r.VehicleId);
            if (cur is not null && !onlyAvail.Any(v => v.Id == cur.Id)) onlyAvail.Insert(0, cur);
            src = onlyAvail;
        }
        var d = _driverPairs.FirstOrDefault(x => x.Id == r.DriverId);
        if (d is null) return src;
        return src.OrderByDescending(p => SameSource(p, d) ? 1 : 0).ToList();
    }

    /* #82 — فتح قايمة عربيات السطر: بتظهر المتاحة حالًا، وبتعاد التصفية
       بعد ما قائمة المتاحة توصل من السيرفر */
    private async Task OnLineVehicleFocus(LineRow ln)
    {
        ln.Trip.ShowVehicles = true;
        ln.Trip.FilteredVehicles = FilterPairs(OrderedVehiclesFor(ln.Trip), ln.Trip.VehicleSearch);
        await LoadAvailableVehiclesAsync(ln.Trip.PlannedStartAt);
        ln.Trip.FilteredVehicles = FilterPairs(OrderedVehiclesFor(ln.Trip), ln.Trip.VehicleSearch);
    }

    /* #82 — تحميل العربيات المتاحة لتاريخ معيّن (بيتنادى أول ما المستخدم
       يفتح قايمة العربيات أو يغيّر الميعاد) */
    private async Task LoadAvailableVehiclesAsync(DateTime? when)
    {
        var key = (when ?? DateTime.Today).ToString("yyyy-MM-dd");
        if (_availForDate == key && _availLoaded) return;
        try
        {
            var list = await Http.GetFromJsonAsync<List<PairOpt>>(
                $"api/options/vehicles-available?date={key}") ?? new();
            _availVehicleIds = list.Select(v => v.Id).ToHashSet();
            _availForDate = key;
            _availLoaded = true;
        }
        catch { _availLoaded = false; }   // لو الطلب فشل منفلترش — أحسن من قفل الاختيار
    }

    private void AfterDriverPicked(TripRow r)
    {
        var dr = _driverPairs.FirstOrDefault(x => x.Id == r.DriverId);
        if (dr is null) return;
        var cur = _vehiclePairs.FirstOrDefault(x => x.Id == r.VehicleId);
        if (cur is not null && SameSource(cur, dr)) return;
        var m = _vehiclePairs.Where(v => SameSource(v, dr)).ToList();
        if (m.Count == 1) r.VehicleId = m[0].Id;
    }

    private void AfterVehiclePicked(TripRow r)
    {
        var v = _vehiclePairs.FirstOrDefault(x => x.Id == r.VehicleId);
        if (v is null) return;
        var cur = _driverPairs.FirstOrDefault(x => x.Id == r.DriverId);
        if (cur is not null && SameSource(cur, v)) return;
        // السائق الافتراضي للسيارة يُقترح قبل قاعدة المرشح الوحيد
        if (v.DefaultDriverId is int dd && _driverPairs.Any(d => d.Id == dd)) { r.DriverId = dd; return; }
        var m = _driverPairs.Where(d => SameSource(d, v)).ToList();
        if (m.Count == 1) r.DriverId = m[0].Id;
    }

    private string ExistingDriverText(ExistingTrip t) => !t.DriverTouched && t.DriverId > 0 ? (_driverPairs.FirstOrDefault(d => d.Id == t.DriverId)?.Label ?? t.DriverName) : t.DriverSearch;
    private string ExistingVehicleText(ExistingTrip t) => !t.VehicleTouched && t.VehicleId > 0 ? (_vehiclePairs.FirstOrDefault(v => v.Id == t.VehicleId)?.Label ?? t.VehiclePlate) : t.VehicleSearch;
    private List<PairOpt> OrderedDriversForExisting(ExistingTrip t) { var v = _vehiclePairs.FirstOrDefault(x => x.Id == t.VehicleId); return v is null ? _driverPairs : _driverPairs.OrderByDescending(p => SameSource(p, v) ? 1 : 0).ToList(); }
    /* #82 — نفس فلترة المتاحة بالزي السطور الجديدة: العربية المتاحة في تاريخ الرحلة بس،
       والعربية المختارة حاليًا تفضل ظاهرة حتى لو بقت مش متاحة */
    private List<PairOpt> OrderedVehiclesForExisting(ExistingTrip t)
    {
        var src = _vehiclePairs;
        var avail = _availVehicleIds;
        if (avail is not null)
        {
            var onlyAvail = src.Where(v => avail.Contains(v.Id)).ToList();
            var cur = src.FirstOrDefault(v => v.Id == t.VehicleId);
            if (cur is not null && !onlyAvail.Any(v => v.Id == cur.Id)) onlyAvail.Insert(0, cur);
            src = onlyAvail;
        }
        var d = _driverPairs.FirstOrDefault(x => x.Id == t.DriverId);
        return d is null ? src : src.OrderByDescending(p => SameSource(p, d) ? 1 : 0).ToList();
    }

    /* #82 — فتح قايمة عربيات رحلة مسجّلة: المتاحة بتتحمّل بتاريخ الرحلة دي */
    private async Task OnExistingVehicleFocus(ExistingTrip t)
    {
        t.ShowVehicles = true;
        t.FilteredVehicles = FilterPairs(OrderedVehiclesForExisting(t), t.VehicleSearch);
        await LoadAvailableVehiclesAsync(t.PlannedStartAt);
