@page "/supplier-invoices"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>فواتير الموردين — فاست كوم</PageTitle>


<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">المالية · الذمم الدائنة</div>
                <h1 class="fc-hero-title">فواتير الموردين</h1>
                <p class="fc-hero-sub">اللي علينا للموردين — مسودة، اعتماد، دفع، أعمار ديون</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="New">فاتورة مورد جديدة</MudButton>
                }
            </div>
        </div>

        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">عدد الفواتير</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></div>
                    <div><div class="fc-kpi-num">@Money(OpenTotal)</div><div class="fc-kpi-lb">المتبقي للموردين</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div><div class="fc-kpi-num">@OverdueCount</div><div class="fc-kpi-lb">فاتورة متأخرة</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                    <div><div class="fc-kpi-num">@Money(PaidTotal)</div><div class="fc-kpi-lb">مدفوع</div></div>
                </div>
            </div>
        }
    </div>
</div>


<div class="si-body">

    @if (!CanView)
    {
        <div class="si-state-box">
            <div class="si-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض فواتير الموردين</p>
        </div>
    }
    else
    {
        <div class="si-card">

            @* ── Toolbar ── *@
            <div class="si-toolbar">

                <div class="si-search-wrap">
                    <svg class="si-search-icon" viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="si-search-input"
                           placeholder="ابحث بالرقم أو المورد..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="si-search-clear" @onclick="() => _search = string.Empty">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                @* Supplier Filter *@
                <div class="si-sup-filter-wrap">
                    <svg class="si-sup-icon" viewBox="0 0 24 24" width="13" height="13"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                        <path d="M9 22V12h6v10"/>
                    </svg>
                    <select class="si-sup-select" @bind="_supFilter">
                        <option value="">كل الموردين</option>
                        @foreach (var s in _suppliers)
                        {
                            <option value="@s.Id">@s.Label</option>
                        }
                    </select>
                </div>

                <div class="si-results-badge">
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>

            </div>


            @* ── Status Tabs ── *@
            <div class="si-status-bar">
                <div class="si-status-tabs" role="group" aria-label="فلتر الحالة">
                    @foreach (var t in _statusTabs)
                    {
                        var cnt = t.Key == "all"
                            ? _items.Count
                            : _items.Count(x => x.Status == t.Key);

                        <button class="si-status-tab @(_tab == t.Key ? "active" : "")"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="si-tab-dot @StatusDotColor(t.Key)" aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="si-tab-count">@cnt</span>
                        </button>
                    }
                </div>

                @* Overdue Warning Strip *@
                @if (OverdueCount > 0)
                {
                    <div class="si-overdue-strip" role="status">
                        <svg viewBox="0 0 24 24" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                            <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                        </svg>
                        <span><strong>@OverdueCount</strong> فاتورة عدى ميعاد سدادها</span>
                    </div>
                }
            </div>


            @* ── Banner ── *@
            @if (_msg is not null)
            {
                <div class="si-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button class="banner-close" @onclick="() => _msg = null">✕</button>
                </div>
            }


            @* ── Content ── *@
            @if (_loading)
            {
                <div class="si-loading">
                    <div class="si-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل الفواتير...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="si-empty">
                    <div class="si-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="42" height="42"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="si-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) && _tab == "all"
                            ? "لا توجد فواتير موردين"
                            : "لا توجد نتائج")
                    </div>
                    <div class="si-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search) && _tab == "all"
                            ? "سجّل أول فاتورة مورد"
                            : "جرّب فلتر مختلف")
                    </div>
                    @if (CanCreate && string.IsNullOrWhiteSpace(_search) && _tab == "all")
                    {
                        <button class="si-add-btn" @onclick="New">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            فاتورة مورد جديدة
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="si-table-wrap">
                    <table class="si-table" aria-label="قائمة فواتير الموردين">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">الفاتورة</th>
                                <th scope="col">التاريخ</th>
                                <th scope="col">الاستحقاق</th>
                                <th scope="col">المبالغ</th>
                                <th scope="col">التحصيل</th>
                                <th scope="col">الحالة</th>
                                <th scope="col">الدفع</th>
                                @if (CanEdit)
                                {
                                    <th scope="col" style="width:120px">إجراءات</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Filtered)
                            {
                                var isOverdue = i.Balance > 0 && IsOverdue(i.DueDate);
                                var paidPct   = i.GrandTotal > 0
                                    ? (double)(i.PaidAmount / i.GrandTotal * 100)
                                    : 0;

                                <tr class="@(i.Status == "Cancelled" ? "row-cancelled" : "")
                                           @(isOverdue ? "row-overdue" : "")">

                                    @* ── الفاتورة ── *@
                                    <td class="td-start">
                                        <div class="si-inv-cell">
                                            <div class="si-avatar @AvatarClass(i.Status)"
                                                 aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="15" height="15"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                                </svg>
                                            </div>
                                            <div class="si-inv-info">
                                                <div class="si-inv-num">
                                                    <span class="si-code-chip">@i.SupplierInvoiceNumber</span>
                                                    @if (isOverdue)
                                                    {
                                                        <span class="si-overdue-badge" title="متأخرة">⚠️</span>
                                                    }
                                                </div>
                                                <div class="si-supplier-name">@i.SupplierName</div>
                                                @if (!string.IsNullOrWhiteSpace(i.SupplierRefNumber))
                                                {
                                                    <div class="si-ref-tag">مرجع @i.SupplierRefNumber</div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    @* ── التاريخ ── *@
                                    <td class="td-muted">
                                        <div class="si-date-cell">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.7"
                                                 aria-hidden="true">
                                                <rect x="2" y="3" width="12" height="11" rx="2"/>
                                                <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                                            </svg>
                                            @i.InvoiceDate
                                        </div>
                                    </td>

                                    @* ── الاستحقاق ── *@
                                    <td>
                                        @if (i.DueDate is not null)
                                        {
                                            <div class="si-date-cell @(isOverdue ? "due-late" : "")">
                                                <svg viewBox="0 0 16 16" width="10" height="10"
                                                     fill="none" stroke="currentColor" stroke-width="1.7"
                                                     aria-hidden="true">
                                                    <circle cx="8" cy="8" r="6"/>
                                                    <path d="M8 5v3l2 2" stroke-linecap="round"/>
                                                </svg>
                                                @i.DueDate
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="td-muted">—</span>
                                        }
                                    </td>

                                    @* ── المبالغ ── *@
                                    <td>
                                        <div class="si-amounts-cell">
                                            <div class="si-grand-total">@Money(i.GrandTotal)</div>
                                            @if (i.TaxTotal > 0)
                                            {
                                                <div class="si-tax-sub">+ ضريبة @Money(i.TaxTotal)</div>
                                            }
                                        </div>
                                    </td>

                                    @* ── التحصيل ── *@
                                    <td>
                                        <div class="si-collection-cell">
                                            <div class="si-col-bar">
                                                <div class="si-col-fill @(i.PaymentStatus == "Paid" ? "fill-paid" : i.PaymentStatus == "PartiallyPaid" ? "fill-partial" : "fill-unpaid")"
                                                     style="width:@Math.Min(paidPct, 100)%"></div>
                                            </div>
                                            <div class="si-col-nums">
                                                <span class="si-paid-amt">@Money(i.PaidAmount)</span>
                                                @if (i.Balance > 0)
                                                {
                                                    <span class="si-balance-badge">@Money(i.Balance) متبقي</span>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    @* ── الحالة ── *@
                                    <td>
                                        <span class="si-chip @StatusChipClass(i.Status)">
                                            <span class="si-chip-dot @StatusDotClass(i.Status)"
                                                  aria-hidden="true"></span>
                                            @StatusAr(i.Status)
                                        </span>
                                    </td>

                                    @* ── الدفع ── *@
                                    <td>
                                        <span class="si-chip @PayChipClass(i.PaymentStatus)">
                                            <span class="si-chip-dot @PayDotClass(i.PaymentStatus)"
                                                  aria-hidden="true"></span>
                                            @PayAr(i.PaymentStatus)
                                        </span>
                                    </td>

                                    @* ── إجراءات ── *@
                                    @if (CanEdit)
                                    {
                                        <td>
                                            <div class="si-actions">

                                                @if (i.Status == "Draft")
                                                {
                                                    <button class="si-act-btn act-edit"
                                                            @onclick="() => Edit(i)"
                                                            title="تعديل"
                                                            aria-label="تعديل @i.SupplierInvoiceNumber">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                        </svg>
                                                    </button>

                                                    <button class="si-act-btn act-approve"
                                                            @onclick="() => Approve(i)"
                                                            title="اعتماد"
                                                            aria-label="اعتماد @i.SupplierInvoiceNumber"
                                                            disabled="@_busy">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M9 12l2 2 4-4"/>
                                                            <circle cx="12" cy="12" r="10"/>
                                                        </svg>
                                                    </button>
                                                }

                                                @if (i.Status != "Cancelled" && i.Status != "Paid" && i.PaidAmount <= 0)
                                                {
                                                    <button class="si-act-btn act-cancel"
                                                            @onclick="() => AskCancel(i)"
                                                            title="إلغاء"
                                                            aria-label="إلغاء @i.SupplierInvoiceNumber">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"/>
                                                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                                        </svg>
                                                    </button>
                                                }

                                            </div>
                                        </td>
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   MODAL — تأكيد الإلغاء
═══════════════════════════════════════════ *@
@if (_cancelTarget is not null)
{
    <div class="si-modal-backdrop" @onclick="() => _cancelTarget = null"
         role="dialog" aria-modal="true" aria-label="تأكيد إلغاء الفاتورة">
        <div class="si-modal" @onclick:stopPropagation="true">

            <div class="si-modal-head">
                <div class="si-modal-icon cancel-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <div class="si-modal-title">إلغاء فاتورة مورد</div>
                    <div class="si-modal-sub">@_cancelTarget.SupplierInvoiceNumber · @_cancelTarget.SupplierName</div>
                </div>
                <button class="si-modal-close" @onclick="() => _cancelTarget = null" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            <div class="si-modal-body">

                @* Invoice Summary *@
                <div class="si-cancel-summary">
                    <div class="si-cs-item">
                        <div class="si-cs-label">الإجمالي</div>
                        <div class="si-cs-val">@Money(_cancelTarget.GrandTotal) ج.م</div>
                    </div>
                    <div class="si-cs-sep" aria-hidden="true"></div>
                    <div class="si-cs-item">
                        <div class="si-cs-label">المتبقي</div>
                        <div class="si-cs-val balance-val">@Money(_cancelTarget.Balance) ج.م</div>
                    </div>
                    <div class="si-cs-sep" aria-hidden="true"></div>
                    <div class="si-cs-item">
                        <div class="si-cs-label">الحالة</div>
                        <div class="si-cs-val">@StatusAr(_cancelTarget.Status)</div>
                    </div>
                </div>

                <div class="si-cancel-warn" role="alert">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                        <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                    </svg>
                    <div>
                        <strong>اتأكد من الإلغاء ⚠️</strong>
                        <p>الفاتورة هتخرج من حساب المتبقي على المورد — الإجراء مايتراجعش</p>
                    </div>
                </div>

            </div>

            <div class="si-modal-foot">
                <button class="si-modal-cancel-btn" @onclick="() => _cancelTarget = null">رجوع</button>
                <button class="si-modal-confirm-btn"
                        @onclick="DoCancel"
                        disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الإلغاء...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                        <span>تأكيد الإلغاء</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-teal:      #0d9488;
        --fc-teal-lt:   #e6faf8;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       BODY
    ================================================================ */
    .si-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1400px; width: 100%;
        margin: 0 auto;
    }

    /* State */
    .si-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .si-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .si-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .si-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .si-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* Card */
    .si-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    /* ================================================================
       TOOLBAR
    ================================================================ */
    .si-toolbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7; flex-wrap: wrap;
    }

    .si-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px; max-width: 380px;
    }
    .si-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }
    .si-search-input {
        width: 100%; height: 38px; padding: 0 36px 0 12px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .si-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .si-search-input::placeholder { color: #b0bcc8; }
    .si-search-clear {
        position: absolute; left: 10px;
        display: flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        border: none; background: #edf1f7; color: #8899ae; cursor: pointer;
    }

    .si-sup-filter-wrap {
