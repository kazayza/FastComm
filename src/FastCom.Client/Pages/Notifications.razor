@page "/notifications"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>الإشعارات — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">النظام · الإشعارات</div>
                <h1 class="fc-hero-title">الإشعارات</h1>
                <p class="fc-hero-sub">تنبيهات النظام — بتاعتك إنت والإشعارات العامة</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="Reload" Style="color:#9FB4CC" />
                @if (_items.Any(n => !n.IsRead))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mr-2"
                               StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ReadAll">تعليم الكل كمقروء</MudButton>
                }
                @if (CanManage)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">إشعار جديد</MudButton>
                }
            </div>
        </div>
        <div class="fc-kpis fc-kpis-glass">
            <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.Notifications" /></div>
                <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">إجمالي الإشعارات</div></div></div>
            <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                <div><div class="fc-kpi-num">@_items.Count(n => !n.IsRead)</div><div class="fc-kpi-lb">لسه مااتقراش</div></div></div>
            <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                <div><div class="fc-kpi-num">@_items.Count(n => n.Priority is "High" or "Critical")</div><div class="fc-kpi-lb">أولوية عالية</div></div></div>
            <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Groups" /></div>
                <div><div class="fc-kpi-num">@_items.Count(n => n.IsGlobal)</div><div class="fc-kpi-lb">إشعارات عامة</div></div></div>
        </div>
    </div>
</div>

<div class="fc-page">
    <div class="fc-overlap"><div class="fc-card">
        <div class="fc-toolbar">
            <div class="fc-filters">
                @foreach (var t in Tabs)
                {
                    <button class='fc-filter @(_tab == t.Key ? "on" : "")' @onclick="() => SetTab(t.Key)">@t.Value</button>
                }
            </div>
            <span class="fc-count">عرض @Filtered.Count() من @_items.Count</span>
        </div>

        @if (_loading)
        {
            <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
        }
        else
        {
            <div class="fc-role-grid">
                @foreach (var n in Filtered)
                {
                    <div class="fc-role-card">
                        <div class="fc-role-card-meta">
                            <span class="fc-chip @PriChip(n.Priority)"><i></i>@PriAr(n.Priority)</span>
                            <span class="fc-cell-sub">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                            @if (n.IsGlobal) { <span class="fc-chip fc-chip-blue"><i></i>عام</span> }
                            @if (!n.IsRead)  { <span class="fc-chip fc-chip-gold"><i></i>جديد</span> }
                        </div>
                        <div class="fc-role-card-txt">
                            <b>@n.Title</b>
                            <div class="fc-cell-sub" style="margin-top:4px">@n.Message</div>
                        </div>
                        <div class="fc-row-actions" style="margin-top:10px">
                            @if (!n.IsRead)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           OnClick="() => Read(n)">تعليم كمقروء</MudButton>
                            }
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" title="حذف" OnClick="() => Delete(n)" />
                        </div>
                    </div>
                }
                @if (!Filtered.Any())
                {
                    <div class="fc-empty"><div>لايوجد إشعارات </div></div>
                }
            </div>
        }
    </div></div>

    @* ═══════════ مودال: إشعار جديد ═══════════ *@
    @if (_modalOpen && CanManage)
    {
        <div class="fc-modal-backdrop" @onclick="Close">
            <div class="fc-modal fc-modal-sm" @onclick:stopPropagation="true">
                <div class="fc-modal-head">
                    <div><div class="fc-modal-title">إشعار جديد</div>
                        <div class="fc-modal-sub">الإشعار العام بيوصل لكل المستخدمين</div></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" />
                </div>
                <div class="fc-modal-body">
                    @if (_msg is not null)
                    {
                        <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined"
                                  Class="mb-4">@_msg</MudAlert>
                    }
                    <div class="fc-form-grid">
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">العنوان *</div>
                            <input class="fc-sel fc-sel-lg" value="@_nf.Title" maxlength="200"
                                   @onchange="e => _nf.Title = e.Value?.ToString()" />
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">الأولوية</div>
                            <select class="fc-sel fc-sel-lg" @bind="_nf.Priority">
                                <option value="Low">منخفضة</option>
                                <option value="Normal">عادية</option>
                                <option value="High">عالية</option>
                                <option value="Critical">حرجة</option>
                            </select>
                        </div>
                        <div style="grid-column:1/-1">
                            <div class="fc-panel-sub" style="margin-bottom:6px">النص *</div>
                            <textarea class="fc-sel fc-sel-lg" rows="3" maxlength="1000" value="@_nf.Message"
                                      @onchange="e => _nf.Message = e.Value?.ToString()"></textarea>
                        </div>
                    </div>
                    <MudCheckBox T="bool" @bind-Value="_nf.IsGlobal" Label="إشعار عام لكل المستخدمين"
                                 Color="Color.Primary" />
                </div>
                <div class="fc-modal-foot">
                    <MudButton OnClick="Close">إلغاء</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.Notifications" OnClick="Save">إرسال</MudButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private AuthUser? _user;
    private bool CanManage => _user?.Can("NOTIFICATION.MANAGE") ?? false;

    private static readonly Dictionary<string, string> Tabs = new()
    {
        ["all"] = "الكل", ["unread"] = "مااتقراش", ["High"] = "عالية", ["Critical"] = "حرجة"
    };

    private List<Item> _items = new();
    private bool _loading; private string _tab = "all";
    private bool _saving; private string? _msg; private bool _ok;
    private bool _modalOpen; private NewForm _nf = new();

    public class Item
    {
        public long NotificationId { get; set; }
        public string NotificationType { get; set; } = "";
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public string? EntityType { get; set; }
        public long? EntityId { get; set; }
        public string Priority { get; set; } = "";
        public bool IsRead { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? ReadAt { get; set; }
        public bool IsGlobal { get; set; }
    }

    public class NewForm
    {
        public string? Title { get; set; }
        public string? Message { get; set; }
        public string Priority { get; set; } = "Normal";
        public bool IsGlobal { get; set; } = true;
    }

    private static string PriAr(string p) => p switch
    {
        "Low" => "منخفضة", "Normal" => "عادية", "High" => "عالية", "Critical" => "حرجة", _ => p
    };

    private static string PriChip(string p) => p switch
    {
        "Low" => "fc-chip-gray", "Normal" => "fc-chip-blue",
        "High" => "fc-chip-warn", "Critical" => "fc-chip-bad", _ => "fc-chip-gray"
    };

    private IEnumerable<Item> Filtered => _items.Where(n => _tab switch
    {
        "unread" => !n.IsRead,
        "all"    => true,
        _        => n.Priority == _tab
    });

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        await LoadAsync();
    }

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) => _tab = t;

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/notifications?take=200") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task Read(Item n)
    {
        try
        {
            var res = await Http.PostAsync($"api/notifications/{n.NotificationId}/read", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task ReadAll()
    {
        try
        {
            var res = await Http.PostAsync("api/notifications/read-all", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item n)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/notifications/{n.NotificationId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private void OpenNew()
    {
        _nf = new NewForm(); _msg = null; _modalOpen = true;
    }

    private void Close() { _modalOpen = false; }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_nf.Title))   { _ok = false; _msg = "اكتب عنوان"; return; }
        if (string.IsNullOrWhiteSpace(_nf.Message)) { _ok = false; _msg = "اكتب نص الإشعار"; return; }

        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/notifications", new
            {
                notificationType = "General",
                title            = _nf.Title,
                message          = _nf.Message,
                priority         = _nf.Priority,
                userId           = _nf.IsGlobal ? (int?)null : _user?.UserId,
                entityType       = (string?)null,
                entityId         = (long?)null
            });
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode) { Snackbar.Add(_msg, Severity.Success); Close(); await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
