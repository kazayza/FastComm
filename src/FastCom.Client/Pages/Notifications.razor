@page "/notifications"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>الإشعارات — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO — كارت مستقل بحواف دائرية + ارتفاع مضغوط
═══════════════════════════════════════════ *@
<div class="ntf-hero-wrapper">
    <div class="fc-hero fc-hero-ultra-slim">
        <div class="fc-hero-inner">

            <div class="ntf-hero-row">
                <div class="ntf-hero-left">
                    <h1 class="ntf-hero-title">مركز الإشعارات والتنبيهات</h1>
                    <span class="ntf-hero-sub">إدارة وتتبع جميع تنبيهات النظام والمستخدمين</span>
                </div>

                <div class="ntf-hero-right">
                    <span class="ntf-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                    <span class="ntf-hero-chip ntf-chip-highlight">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        </svg>
                        غير مقروء: @_items.Count(n => !n.IsRead)
                    </span>
                </div>
            </div>

            <div class="ntf-kpis-row">
                <div class="ntf-kpi ntf-kpi-blue">
                    <div class="ntf-kpi-inner">
                        <div class="ntf-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" /></div>
                        <div class="ntf-kpi-data">
                            <div class="ntf-kpi-num">@_items.Count</div>
                            <div class="ntf-kpi-label">إجمالي الإشعارات</div>
                        </div>
                    </div>
                </div>
                <div class="ntf-kpi ntf-kpi-gold">
                    <div class="ntf-kpi-inner">
                        <div class="ntf-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" /></div>
                        <div class="ntf-kpi-data">
                            <div class="ntf-kpi-num">@_items.Count(n => !n.IsRead)</div>
                            <div class="ntf-kpi-label">غير مقروء</div>
                        </div>
                    </div>
                </div>
                <div class="ntf-kpi ntf-kpi-red">
                    <div class="ntf-kpi-inner">
                        <div class="ntf-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" /></div>
                        <div class="ntf-kpi-data">
                            <div class="ntf-kpi-num">@_items.Count(n => n.Priority is "High" or "Critical")</div>
                            <div class="ntf-kpi-label">أولوية عالية</div>
                        </div>
                    </div>
                </div>
                <div class="ntf-kpi ntf-kpi-green">
                    <div class="ntf-kpi-inner">
                        <div class="ntf-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" /></div>
                        <div class="ntf-kpi-data">
                            <div class="ntf-kpi-num">@_items.Count(n => n.IsGlobal)</div>
                            <div class="ntf-kpi-label">إشعارات عامة</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="ntf-body">
    <div class="ntf-card">

        <div class="ntf-toolbar">
            <div class="ntf-filters">
                @foreach (var t in Tabs)
                {
                    <button class="ntf-filter @(_tab == t.Key ? "active" : "")" @onclick="() => SetTab(t.Key)">
                        @t.Value
                        @if (t.Key == "unread" && _items.Any(x => !x.IsRead))
                        {
                            <span class="ntf-filter-dot"></span>
                        }
                    </button>
                }
            </div>
            <div class="ntf-results">
                <svg viewBox="0 0 16 16" width="11" height="11" fill="none"
                     stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <circle cx="8" cy="8" r="6"/>
                    <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                </svg>
                عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
            </div>
        </div>

        @if (_loading)
        {
            <div class="ntf-loading">
                <div class="ntf-spinner"></div>
                <span>جاري تحميل الإشعارات...</span>
            </div>
        }
        else if (!Filtered.Any())
        {
            <div class="ntf-empty">
                <div class="ntf-empty-icon">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none"
                         stroke="currentColor" stroke-width="1.5">
                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                        <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h3 class="ntf-empty-title">لا توجد إشعارات حالياً</h3>
                <p class="ntf-empty-desc">عند ورود إشعارات أو تنبيهات، ستظهر لك هنا مباشرة</p>
            </div>
        }
        else
        {
            <div class="ntf-list">
                @foreach (var n in Filtered)
                {
                    <div class="ntf-item @(!n.IsRead ? "unread" : "")">
                        <div class="ntf-stripe ntf-stripe-@n.Priority" aria-hidden="true"></div>

                        <div class="ntf-item-head">
                            <div class="ntf-item-chips">
                                <span class="ntf-chip @PriChip(n.Priority)">
                                    <span class="ntf-chip-dot" aria-hidden="true"></span>
                                    @PriAr(n.Priority)
                                </span>
                                @if (n.IsGlobal)
                                {
                                    <span class="ntf-chip ntf-chip-global">
                                        <span class="ntf-chip-dot" aria-hidden="true"></span>
                                        عام
                                    </span>
                                }
                                @if (!n.IsRead)
                                {
                                    <span class="ntf-chip ntf-chip-new">
                                        <span class="ntf-chip-dot" aria-hidden="true"></span>
                                        جديد
                                    </span>
                                }
                            </div>
                            <span class="ntf-item-date">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>

                        <div class="ntf-item-content">
                            <h3 class="ntf-item-title">@n.Title</h3>
                            <p class="ntf-item-msg">@n.Message</p>
                        </div>

                        <div class="ntf-item-actions">
                            @if (!n.IsRead)
                            {
                                <button class="ntf-act-btn ntf-act-read" @onclick="() => Read(n)">
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
                                         stroke="currentColor" stroke-width="2.5">
                                        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    مقروء
                                </button>
                            }
                            <button class="ntf-act-btn ntf-act-del" @onclick="() => Delete(n)" title="حذف">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                                </svg>
                                حذف
                            </button>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

@* ═══════════════════════════════════════════
   FAB — الوميض الذهبي الدائم
═══════════════════════════════════════════ *@
@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="CloseFab"></div>
}

<div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

    <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
        @if (CanManage)
        {
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="GoNew">
                <span class="glow-fab-item-ic"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /></span>
                <span class="glow-fab-item-lb">إشعار جديد</span>
            </button>
        }
        @if (_items.Any(n => !n.IsRead))
        {
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="ReadAll">
                <span class="glow-fab-item-ic"><MudIcon Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" /></span>
                <span class="glow-fab-item-lb">تعليم الكل كمقروء</span>
            </button>
        }
        <button type="button" class="glow-fab-item" role="menuitem" @onclick="Reload">
            <span class="glow-fab-item-ic"><MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /></span>
            <span class="glow-fab-item-lb">تحديث البيانات</span>
        </button>
    </div>

    <div class="glow-fab-container">
        <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
        <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
        <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
        <span class="glow-halo" aria-hidden="true"></span>

        <button type="button" class="glow-fab-btn" @onclick="ToggleFab"
                @onkeydown="OnFabKeyDown"
                aria-label="الإجراءات السريعة"
                aria-expanded="@(_fabOpen ? "true" : "false")">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none"
                 stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
            </svg>
        </button>
    </div>

</div>

<style>
    /* ════════════════════════════════════════════════════════
       HERO WRAPPER — كارت مستقل بحواف دائرية
    ════════════════════════════════════════════════════════ */
    .ntf-hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .ntf-hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow:
            0 12px 32px rgba(13, 38, 84, 0.15),
            0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .ntf-hero-wrapper .fc-hero.fc-hero-ultra-slim {
        padding-top: 14px !important;
        padding-bottom: 16px !important;
    }

    .ntf-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .ntf-hero-left {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .ntf-hero-title {
        margin: 0;
        font-size: clamp(16px, 1.8vw, 20px);
        font-weight: 900;
        color: #fff;
        line-height: 1.2;
    }

    .ntf-hero-sub {
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.55);
        font-weight: 600;
    }

    .ntf-hero-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .ntf-hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: rgba(255, 255, 255, 0.7);
        font-size: 10.5px;
        font-weight: 700;
        font-family: "Inter", Arial, sans-serif;
        white-space: nowrap;
    }

    .ntf-chip-highlight {
        background: rgba(251, 191, 36, 0.15) !important;
        border-color: rgba(251, 191, 36, 0.35) !important;
        color: #fcd34d !important;
    }

    /* ── KPIs مدمجة ومضغوطة ── */
    .ntf-kpis-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
    }

    .ntf-kpi {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(12px);
        border-radius: 10px;
        padding: 10px 12px;
    }

    .ntf-kpi-inner { display: flex; align-items: center; gap: 10px; }

    .ntf-kpi-icon {
        width: 34px; height: 34px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .ntf-kpi-blue .ntf-kpi-icon   { background: rgba(125, 211, 252, 0.15); color: #7dd3fc; }
    .ntf-kpi-gold .ntf-kpi-icon   { background: rgba(252, 211, 77, 0.15);  color: #fcd34d; }
    .ntf-kpi-red .ntf-kpi-icon    { background: rgba(252, 165, 165, 0.15); color: #fca5a5; }
    .ntf-kpi-green .ntf-kpi-icon  { background: rgba(110, 231, 183, 0.15); color: #6ee7b7; }

    .ntf-kpi-data { flex: 1; min-width: 0; }
    .ntf-kpi-num { font-family: "Inter", Arial, sans-serif; font-size: 18px; font-weight: 900; color: #fff; line-height: 1; }
    .ntf-kpi-label { font-size: 10.5px; font-weight: 700; color: rgba(255, 255, 255, 0.6); margin-top: 3px; }

    /* ════════════════════════════════════════════════════════
       BODY — القائمة الرئيسية
    ════════════════════════════════════════════════════════ */
    .ntf-body {
        padding: 18px clamp(16px, 3vw, 40px) 100px;
        max-width: 1440px;
        margin-inline: auto;
        box-sizing: border-box;
        width: 100%;
        position: relative;
        z-index: 2;
    }

    .ntf-card {
        background: #fff;
        border: 1px solid #dde5f0;
        border-radius: 18px;
        box-shadow: 0 4px 24px rgba(15, 41, 82, 0.05);
        overflow: hidden;
    }

    /* ── Toolbar ── */
    .ntf-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
        flex-wrap: wrap;
    }

    .ntf-filters { display: flex; gap: 4px; }

    .ntf-filter {
        display: flex; align-items: center; gap: 6px;
        height: 32px; padding: 0 14px;
        border: none; border-radius: 7px;
        background: #f0f3f8; color: #6b7d95;
        font-family: inherit; font-size: 11.5px; font-weight: 700;
        cursor: pointer; position: relative;
        transition: all 0.15s ease;
    }
    .ntf-filter:hover { background: #e4eaf3; color: #1c2c44; }
    .ntf-filter.active {
        background: var(--fc-blue, #1e6ef5); color: #fff;
        box-shadow: 0 2px 6px rgba(30, 110, 245, 0.25);
    }

    .ntf-filter-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: #f59e0b;
        position: absolute; top: 4px; left: 4px;
    }

    .ntf-results {
        display: flex; align-items: center; gap: 5px;
        font-size: 11px; color: #8899ae; font-weight: 600;
    }
    .ntf-results strong { color: #5a6e88; }

    /* ── Loading ── */
    .ntf-loading {
        display: flex; align-items: center; justify-content: center; gap: 10px;
        min-height: 200px; color: #6b7d95; font-size: 12.5px; font-weight: 700;
    }
    .ntf-spinner {
        width: 28px; height: 28px;
        border: 2.5px solid #dde5f0; border-top-color: var(--fc-blue, #1e6ef5);
        border-radius: 50%; animation: ntf-spin .7s linear infinite;
    }
    @@keyframes ntf-spin { to { transform: rotate(360deg); } }

    /* ── Empty State ── */
    .ntf-empty {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 220px; text-align: center; padding: 40px;
    }
    .ntf-empty-icon {
        width: 64px; height: 64px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #f0f4fa; color: #b0c4d8;
    }
    .ntf-empty-title { font-size: 14.5px; font-weight: 800; color: #1c2b44; margin: 0; }
    .ntf-empty-desc { font-size: 11.5px; color: #6b7d95; max-width: 320px; line-height: 1.6; margin: 0; }

    /* ── Notification List ── */
    .ntf-list { display: flex; flex-direction: column; gap: 10px; padding: 18px; }

    .ntf-item {
        background: #fafcff;
        border: 1px solid #e8edf5;
        border-radius: 12px;
        padding: 14px 16px;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: all 0.18s ease;
    }
    .ntf-item:hover {
        border-color: #c8d8f0;
        box-shadow: 0 4px 14px rgba(15, 41, 82, 0.05);
        transform: translateX(-2px);
    }
    .ntf-item.unread {
        background: #f4f8ff;
        border-color: #bdd4fc;
    }

    /* ── Priority Stripes ── */
    .ntf-stripe {
        position: absolute; right: 0; top: 8px; bottom: 8px;
        width: 4px; border-radius: 0 4px 4px 0;
    }
    .ntf-stripe-Low      { background: #9aaabb; }
    .ntf-stripe-Normal   { background: var(--fc-blue, #1e6ef5); }
    .ntf-stripe-High     { background: #fbbf24; }
    .ntf-stripe-Critical { background: #e03048; }

    .ntf-item-head {
        display: flex; align-items: center; justify-content: space-between;
        padding-right: 8px;
    }

    .ntf-item-chips { display: flex; align-items: center; gap: 6px; }

    /* ── Chips ── */
    .ntf-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 9px; border-radius: 6px;
        font-size: 10px; font-weight: 800;
    }
    .ntf-chip-dot { width: 5px; height: 5px; border-radius: 50%; }

    .ntf-chip-gray { background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }
    .ntf-chip-gray .ntf-chip-dot { background: #6b7d95; }

    .ntf-chip-blue { background: #eaf1ff; color: var(--fc-blue, #1e6ef5); border: 1px solid #bdd4fc; }
    .ntf-chip-blue .ntf-chip-dot { background: var(--fc-blue, #1e6ef5); }

    .ntf-chip-warn { background: #fff8e6; color: #b87d08; border: 1px solid #fce8bd; }
    .ntf-chip-warn .ntf-chip-dot { background: #fbbf24; }

    .ntf-chip-bad { background: #fff0f2; color: #e03048; border: 1px solid #ffc8cf; }
    .ntf-chip-bad .ntf-chip-dot { background: #e03048; }

    .ntf-chip-global { background: #f3eeff; color: #7c4dbd; border: 1px solid #d0bfef; }
    .ntf-chip-global .ntf-chip-dot { background: #7c4dbd; }

    .ntf-chip-new { background: #edf8f0; color: #16a35b; border: 1px solid #b0e0c5; }
    .ntf-chip-new .ntf-chip-dot { background: #16a35b; }

    .ntf-item-date { font-size: 11px; color: #8899ae; font-weight: 700; font-family: "Inter", Arial, sans-serif; }

    .ntf-item-content { padding-right: 8px; }
    .ntf-item-title { font-size: 13px; font-weight: 800; color: #1c2c44; margin: 0 0 4px; }
    .ntf-item-msg { font-size: 11.5px; color: #6b7d95; margin: 0; line-height: 1.6; }

    .ntf-item-actions {
        display: flex; align-items: center; gap: 8px;
        padding-right: 8px; justify-content: flex-end;
        border-top: 1px dashed #e8edf5; padding-top: 8px;
    }

    .ntf-act-btn {
        display: inline-flex; align-items: center; gap: 5px;
        height: 28px; padding: 0 10px;
        border: 1px solid #dfe4ed; border-radius: 6px;
        background: #fff; font-family: inherit;
        font-size: 10.5px; font-weight: 800; cursor: pointer;
        transition: all 0.12s ease;
    }
    .ntf-act-read { color: var(--fc-blue, #1e6ef5); }
    .ntf-act-read:hover { background: #f4f8ff; border-color: #bdd4fc; }

    .ntf-act-del { color: #e03048; }
    .ntf-act-del:hover { background: #fff0f2; border-color: #ffc8cf; }

    /* ════════════════════════════════════════════════════════
       GLOW FAB
    ════════════════════════════════════════════════════════ */
    .glow-fab-scrim {
        position: fixed; inset: 0; z-index: 1298;
        background: rgba(10, 20, 40, 0.4); backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        animation: glow-fadein 0.2s ease both;
    }
    @@keyframes glow-fadein { from { opacity: 0; } to { opacity: 1; } }

    .glow-fab-wrap {
        position: fixed; left: 28px; bottom: 28px; z-index: 1299;
        display: flex; flex-direction: column; align-items: flex-start; gap: 14px;
    }

    .glow-fab-container {
        position: relative; width: 64px; height: 64px;
        display: flex; align-items: center; justify-content: center;
    }

    .glow-halo {
        position: absolute; inset: -6px; border-radius: 50%;
        background: radial-gradient(circle, rgba(251,191,36,0.55) 0%, rgba(245,158,11,0.35) 40%, rgba(245,158,11,0) 75%);
        filter: blur(12px); animation: glow-breath 2.5s ease-in-out infinite;
        pointer-events: none; z-index: 1;
    }
    @@keyframes glow-breath { 0%,100% { opacity:0.7; transform:scale(1); } 50% { opacity:1; transform:scale(1.15); } }

    .glow-ring {
        position: absolute; inset: 0; border-radius: 50%;
        border: 2.5px solid #fbbf24; pointer-events: none; opacity: 0; z-index: 2;
    }
    .glow-ring-1 { animation: glow-expand 2.4s ease-out infinite; animation-delay: 0s; }
    .glow-ring-2 { animation: glow-expand 2.4s ease-out infinite; animation-delay: 0.8s; }
    .glow-ring-3 { animation: glow-expand 2.4s ease-out infinite; animation-delay: 1.6s; }
    @@keyframes glow-expand {
        0% { opacity:0.8; transform:scale(1); border-width:3px; }
        60% { opacity:0.4; }
        100% { opacity:0; transform:scale(2); border-width:1px; }
    }

    .glow-fab-btn {
        position: relative; width: 60px; height: 60px; border-radius: 50%;
        border: 2.5px solid #fbbf24; padding: 0;
        display: flex; align-items: center; justify-content: center; cursor: pointer;
        background: linear-gradient(135deg, #1e6ef5 0%, #0d47a1 100%); color: #fff;
        box-shadow: 0 8px 24px rgba(30,110,245,0.5), 0 4px 12px rgba(251,191,36,0.35),
                    inset 0 1px 0 rgba(255,255,255,0.3);
        transition: transform 0.25s cubic-bezier(0.34,1.3,0.64,1); z-index: 3;
    }
    .glow-fab-btn:hover { transform: scale(1.08); }
    .glow-fab-btn:active { transform: scale(0.94); }

    .glow-fab-icon { transition: transform 0.3s cubic-bezier(0.34,1.3,0.64,1); }
    .glow-fab-wrap.is-open .glow-fab-icon { transform: rotate(135deg); }

    .glow-fab-wrap.is-open .glow-fab-btn {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
        border-color: #fca5a5;
        box-shadow: 0 8px 24px rgba(220,38,38,0.5), 0 4px 12px rgba(252,165,165,0.35);
    }
    .glow-fab-wrap.is-open .glow-halo {
        background: radial-gradient(circle, rgba(252,165,165,0.55) 0%, rgba(220,38,38,0.35) 40%, rgba(220,38,38,0) 75%);
    }
    .glow-fab-wrap.is-open .glow-ring { border-color: #fca5a5; }

    .glow-fab-menu {
        display: flex; flex-direction: column; gap: 8px;
        opacity: 0; pointer-events: none;
        transform: translateY(15px) scale(0.9);
        transform-origin: bottom left;
        transition: opacity 0.22s ease, transform 0.28s cubic-bezier(0.34,1.3,0.64,1);
    }
    .glow-fab-wrap.is-open .glow-fab-menu {
        opacity: 1; pointer-events: auto; transform: translateY(0) scale(1);
    }

    .glow-fab-item {
        display: inline-flex; align-items: center; gap: 10px;
        min-width: 190px; padding: 10px 14px;
        background: #fff; border: 1px solid #e4eaf2; border-radius: 12px;
        box-shadow: 0 6px 20px rgba(15,41,82,0.14), 0 2px 6px rgba(15,41,82,0.08);
        font-family: inherit; font-size: 12.5px; font-weight: 800; color: #1c2b43;
        cursor: pointer; transition: all 0.18s ease; white-space: nowrap;
    }
    .glow-fab-item:hover {
        border-color: #1e6ef5; transform: translateX(-4px);
        box-shadow: 0 8px 24px rgba(30,110,245,0.22), 0 3px 8px rgba(15,41,82,0.12);
    }

    .glow-fab-item-ic {
        width: 30px; height: 30px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #eaf1ff, #dbe8fc); color: #1e6ef5; flex-shrink: 0;
    }

    .glow-fab-item-lb { flex: 1; text-align: right; }

    .glow-fab-wrap.is-open .glow-fab-item:nth-child(1) { transition-delay: 0.04s; }
    .glow-fab-wrap.is-open .glow-fab-item:nth-child(2) { transition-delay: 0.08s; }
    .glow-fab-wrap.is-open .glow-fab-item:nth-child(3) { transition-delay: 0.12s; }

    /* ════════════════════════════════════════════════════════
       RESPONSIVE
    ════════════════════════════════════════════════════════ */
    @@media (max-width: 1024px) {
        .ntf-kpis-row { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 680px) {
        .ntf-hero-wrapper { padding: 12px 12px 0; }
        .ntf-hero-wrapper .fc-hero { border-radius: 16px !important; }
        .ntf-hero-chip:first-child { display: none; }
        .ntf-body { padding: 14px 12px 90px; }
        .ntf-list { padding: 10px; }
        .ntf-hero-row { flex-direction: column; align-items: stretch; }
        .ntf-hero-right { justify-content: flex-end; }
        .glow-fab-wrap { left: 18px; bottom: 18px; }
        .glow-fab-container { width: 58px; height: 58px; }
        .glow-fab-btn { width: 54px; height: 54px; }
    }
    @@media (max-width: 480px) {
        .ntf-kpis-row { grid-template-columns: 1fr 1fr; }
        .ntf-toolbar { flex-direction: column; align-items: stretch; }
        .ntf-filters { flex-wrap: wrap; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .glow-halo, .glow-ring { animation: none; }
        .glow-halo { opacity: 0.5; }
    }
</style>

@code {
    private AuthUser? _user;
    private bool CanManage => _user?.Can("NOTIFICATION.MANAGE") ?? false;

    private static readonly Dictionary<string, string> Tabs = new()
    {
        ["all"] = "الكل", ["unread"] = "غير مقروء", ["High"] = "عالية", ["Critical"] = "حرجة"
    };

    private List<Item> _items = new();
    private bool _loading;
    private string _tab = "all";
    private bool _fabOpen;

    private void ToggleFab() => _fabOpen = !_fabOpen;
    private void CloseFab() => _fabOpen = false;
    private void OnFabKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") _fabOpen = false; }

    private void GoNew()
    {
        _fabOpen = false;
        Nav.NavigateTo("/notifications/new");
    }

    public class Item
    {
        public long NotificationId { get; set; }
        public string NotificationType { get; set; } = "";
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public string? EntityType { get; set; }
        public long? EntityId { get; set; }
        public string Priority { get; set; } = "";
        public bool IsRead { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? ReadAt { get; set; }
        public bool IsGlobal { get; set; }
    }

    private static string PriAr(string p) => p switch
    {
        "Low" => "منخفضة", "Normal" => "عادية", "High" => "عالية", "Critical" => "حرجة", _ => p
    };

    private static string PriChip(string p) => p switch
    {
        "Low" => "ntf-chip-gray", "Normal" => "ntf-chip-blue",
        "High" => "ntf-chip-warn", "Critical" => "ntf-chip-bad", _ => "ntf-chip-gray"
    };

    private IEnumerable<Item> Filtered => _items.Where(n => _tab switch
    {
        "unread" => !n.IsRead,
        "all" => true,
        _ => n.Priority == _tab
    });

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        await LoadAsync();
    }

    private async Task Reload()
    {
        _fabOpen = false;
        await LoadAsync();
        Snackbar.Add("تم تحديث البيانات", Severity.Success);
    }

    private void SetTab(string t) => _tab = t;

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/notifications?take=200") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task Read(Item n)
    {
        try
        {
            var res = await Http.PostAsync($"api/notifications/{n.NotificationId}/read", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task ReadAll()
    {
        _fabOpen = false;
        try
        {
            var res = await Http.PostAsync("api/notifications/read-all", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item n)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/notifications/{n.NotificationId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم بنجاح" : $"خطأ {(int)res.StatusCode}"; }
    }
}