@page "/trips/new"
@page "/trips/new/{Id:long}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "رحلة جديدة" : "تعديل رحلة") — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">

            <div>
                <div class="fc-crumb">التشغيل · الرحلات</div>
                <h1 class="fc-hero-title">
                    @if (_id is null)
                    {
                        <span>رحلة جديدة</span>
                        <span class="tf-hero-badge badge-new">جديدة</span>
                    }
                    else
                    {
                        <span>@TripNumber</span>
                        <span class="tf-hero-badge @StatusBadgeClass(_status)">@StatusAr(_status)</span>
                    }
                </h1>
                <p class="fc-hero-sub">اختار السائق والسيارة، واربط العمليات اللي هتتنفذ في الخروج ده</p>
            </div>

            <div class="fc-head-actions">
                <button class="tf-back-btn" @onclick="GoBack">
                    <svg viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    الرحلات
                </button>
                @if (CanSave && !_locked)
                {
                    <button class="tf-save-btn"
                            @onclick="SaveAsync"
                            disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ الرحلة</span>
                        }
                    </button>
                }
            </div>

        </div>

        @* ── ملخص الرحلة (تعديل فقط) ── *@
        @if (_id is not null && !_loading)
        {
            <div class="tf-hero-summary">

                <div class="tf-sum-item">
                    <div class="tf-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div class="tf-sum-text">
                        <div class="tf-sum-label">السائق</div>
                        <div class="tf-sum-val">
                            @(_drivers.FirstOrDefault(d => d.Id == _f.DriverId)?.Label ?? "—")
                        </div>
                    </div>
                </div>

                <div class="tf-sum-div" aria-hidden="true"></div>

                <div class="tf-sum-item">
                    <div class="tf-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="1" y="3" width="15" height="13" rx="2"/>
                            <path d="M16 8h4l3 3v5h-7V8z"/>
                            <circle cx="5.5" cy="18.5" r="2.5"/>
                            <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                    </div>
                    <div class="tf-sum-text">
                        <div class="tf-sum-label">العمليات</div>
                        <div class="tf-sum-val">@_ops.Count عملية</div>
                    </div>
                </div>

                <div class="tf-sum-div" aria-hidden="true"></div>

                <div class="tf-sum-item">
                    <div class="tf-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"/>
                            <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                        </svg>
                    </div>
                    <div class="tf-sum-text">
                        <div class="tf-sum-label">إيراد الرحلة</div>
                        <div class="tf-sum-val sum-green">@TotalRevenue.ToString("N2")</div>
                    </div>
                </div>

                <div class="tf-sum-div" aria-hidden="true"></div>

                <div class="tf-sum-item">
                    <div class="tf-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2a10 10 0 100 20A10 10 0 0012 2z"/>
                            <path d="M12 6v6l4 2" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="tf-sum-text">
                        <div class="tf-sum-label">المصروفات</div>
                        <div class="tf-sum-val sum-red">@_directCost.ToString("N2")</div>
                    </div>
                </div>

            </div>
        }

    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="tf-body">

    @* No Permission *@
    @if (!CanCreate && _id is null)
    {
        <div class="tf-state-box">
            <div class="tf-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية إنشاء رحلة جديدة</p>
            <button class="tf-state-back" @onclick="GoBack">العودة للقائمة</button>
        </div>
    }

    @* Loading *@
    else if (_loading)
    {
        <div class="tf-loading-wrap">
            <div class="tf-spinner" aria-label="جاري التحميل"></div>
            <div class="tf-loading-text">جاري تحميل بيانات الرحلة...</div>
        </div>
    }

    @* Main Form *@
    else
    {
        @* Locked Banner *@
        @if (_locked)
        {
            <div class="tf-locked-banner" role="alert">
                <div class="locked-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="locked-text">
                    <strong>الرحلة مقفولة للتعديل</strong>
                    <span>الحالة «@StatusAr(_status)» — الرحلة في هذه الحالة لا تقبل التعديل</span>
                </div>
            </div>
        }

        @* Banner *@
        @if (_msg is not null)
        {
            <div class="tf-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                <div aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="banner-close" @onclick="() => _msg = null">✕</button>
            </div>
        }


        @* ═══════ TABS ═══════ *@
        <div class="tf-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="tf-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="tf-mud-tabs">


                @* ══════════════════════════════════════
                   TAB 1 — بيانات الرحلة
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="ttab-label">
                            <div class="ttab-icon ttab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                </svg>
                            </div>
                            <span>بيانات الرحلة</span>
                            @if (HasTabError(1))
                            {
                                <span class="ttab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon blue" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                                        <path d="M16 8h4l3 3v5h-7V8z"/>
                                        <circle cx="5.5" cy="18.5" r="2.5"/>
                                        <circle cx="18.5" cy="18.5" r="2.5"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">بيانات الرحلة الأساسية</div>
                                    <div class="tab-section-sub">السائق والسيارة والمقطورة والتاريخ</div>
                                </div>
                            </div>

                            <div class="tf-form-grid">

                                @* السائق *@
                                <div class="form-field">
                                    <label class="field-label">
                                        السائق
                                        <span class="field-required">*</span>
                                    </label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        <select class="field-input field-select @(_f.DriverId == 0 && _triedSave ? "field-error" : "")"
                                                @bind="_f.DriverId"
                                                disabled="@_locked"
                                                aria-required="true">
                                            <option value="0">— اختار السائق —</option>
                                            @foreach (var d in _drivers)
                                            {
                                                <option value="@d.Id">@d.Label</option>
                                            }
                                        </select>
                                    </div>
                                    @if (_f.DriverId == 0 && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">اختيار السائق مطلوب</div>
                                    }
                                </div>

                                @* السيارة *@
                                <div class="form-field">
                                    <label class="field-label">
                                        السيارة
                                        <span class="field-required">*</span>
                                    </label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <rect x="1" y="3" width="15" height="13" rx="2"/>
                                            <path d="M16 8h4l3 3v5h-7V8z"/>
                                            <circle cx="5.5" cy="18.5" r="2.5"/>
                                            <circle cx="18.5" cy="18.5" r="2.5"/>
                                        </svg>
                                        <select class="field-input field-select @(_f.VehicleId == 0 && _triedSave ? "field-error" : "")"
                                                @bind="_f.VehicleId"
                                                disabled="@_locked"
                                                aria-required="true">
                                            <option value="0">— اختار السيارة —</option>
                                            @foreach (var v in _vehicles)
                                            {
                                                <option value="@v.Id">@v.Label</option>
                                            }
                                        </select>
                                    </div>
                                    @if (_f.VehicleId == 0 && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">اختيار السيارة مطلوب</div>
                                    }
                                </div>

                                @* المقطورة *@
                                <div class="form-field">
                                    <label class="field-label">المقطورة</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <rect x="2" y="7" width="20" height="10" rx="2"/>
                                            <path d="M6 7V5M18 7V5" stroke-linecap="round"/>
                                        </svg>
                                        <select class="field-input field-select"
                                                @bind="_f.TrailerId"
                                                disabled="@_locked">
                                            <option value="">— من غير مقطورة —</option>
                                            @foreach (var t in _trailers)
                                            {
                                                <option value="@t.Id">@t.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        اختياري
                                    </div>
                                </div>

                                @* نوع الرحلة *@
                                <div class="form-field">
                                    <label class="field-label">نوع الرحلة</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"/>
                                            <path d="M12 8v4l3 3" stroke-linecap="round"/>
                                        </svg>
                                        <select class="field-input field-select"
                                                @bind="_f.TripTypeId"
                                                disabled="@_locked">
                                            <option value="">—</option>
                                            @foreach (var t in _tripTypes)
                                            {
                                                <option value="@t.Id">@t.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                @* التحرك المخطط *@
                                <div class="form-field">
                                    <label class="field-label">التحرك المخطط</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input type="datetime-local"
                                               class="field-input with-prefix"
                                               value="@_f.PlannedStartAt"
                                               disabled="@_locked"
                                               @onchange="e => _f.PlannedStartAt = e.Value?.ToString()" />
                                    </div>
                                </div>

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 2 — العمليات
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="ttab-label">
                            <div class="ttab-icon ttab-orange" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                </svg>
                            </div>
                            <span>العمليات</span>
                            @if (_ops.Count > 0)
                            {
                                <span class="ttab-count">@_ops.Count</span>
                            }
                            @if (HasTabError(2))
                            {
                                <span class="ttab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon orange" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                    </svg>
                                </div>
                                <div style="flex:1">
                                    <div class="tab-section-title">العمليات على الرحلة</div>
                                    <div class="tab-section-sub">
                                        @_ops.Count عملية · إيراد إجمالي
                                        <strong>@TotalRevenue.ToString("N2") ج.م</strong>
                                    </div>
                                </div>
                                @if (!_locked)
                                {
                                    <button class="tf-add-op-btn" @onclick="AddOp">
                                        <svg viewBox="0 0 24 24" width="15" height="15"
                                             fill="none" stroke="currentColor" stroke-width="2.5"
                                             aria-hidden="true">
                                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                        </svg>
                                        أضف عملية
                                    </button>
                                }
                            </div>

                            @if (_ops.Count == 0)
                            {
                                <div class="tf-ops-empty">
                                    <div class="ops-empty-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="40" height="40"
                                             fill="none" stroke="currentColor" stroke-width="1.4">
                                            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                        </svg>
                                    </div>
                                    <div class="ops-empty-title">لا توجد عمليات</div>
                                    <div class="ops-empty-sub">
                                        الرحلة لازم يكون عليها عملية واحدة على الأقل قبل التحرك
                                    </div>
                                    @if (!_locked)
                                    {
                                        <button class="tf-add-op-btn mt-10" @onclick="AddOp">
                                            <svg viewBox="0 0 24 24" width="15" height="15"
                                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                                 aria-hidden="true">
                                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                            </svg>
                                            أضف عملية
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="tf-op-cards">

                                    @foreach (var op in _ops)
                                    {
                                        var idx    = _ops.IndexOf(op);
                                        var avail  = _available.FirstOrDefault(a => a.OperationId == op.OperationId);
                                        var hasOp  = op.OperationId > 0;

                                        <div class="tf-op-card">

                                            @* Card Header *@
                                            <div class="tf-op-head">
                                                <div class="tf-op-num">@(idx + 1)</div>
                                                @if (hasOp && avail is not null)
                                                {
                                                    <div class="tf-op-badge">
                                                        <svg viewBox="0 0 24 24" width="12" height="12"
                                                             fill="none" stroke="currentColor" stroke-width="2"
                                                             aria-hidden="true">
                                                            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                                        </svg>
                                                        @avail.OperationNumber
                                                    </div>
                                                    <div class="tf-op-customer">@avail.CustomerName</div>
                                                    @if (!string.IsNullOrWhiteSpace(avail.Route))
                                                    {
                                                        <div class="tf-op-route">📍 @avail.Route</div>
                                                    }
                                                    <div class="tf-op-revenue">
                                                        إيراد: <strong>@avail.RevenueNet.ToString("N2") ج.م</strong>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="tf-op-badge unselected">اختار عملية</div>
                                                }
                                                @if (!_locked)
                                                {
                                                    <button class="tf-op-del"
                                                            @onclick="() => _ops.Remove(op)"
                                                            title="حذف السطر"
                                                            aria-label="حذف العملية @(idx + 1)">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            </div>

                                            @* Card Body *@
                                            <div class="tf-op-body">

                                                <div class="form-field">
                                                    <label class="field-label">العملية</label>
                                                    <div class="field-select-wrap">
                                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                                             width="13" height="13" fill="none"
                                                             stroke="currentColor" stroke-width="2"
                                                             aria-hidden="true">
                                                            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                                        </svg>
                                                        <select class="field-input field-select"
                                                                @bind="op.OperationId"
                                                                disabled="@_locked">
                                                            <option value="0">— اختار عملية —</option>
                                                            @foreach (var a in _available)
                                                            {
                                                                <option value="@a.OperationId">
                                                                    @a.OperationNumber — @a.CustomerName (@a.Route)
                                                                </option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="form-field">
                                                    <label class="field-label">استلام من الميناء</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true">
                                                            <svg viewBox="0 0 24 24" width="13" height="13"
                                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                                <circle cx="12" cy="12" r="10"/>
                                                                <path d="M12 6v6l4 2" stroke-linecap="round"/>
                                                            </svg>
                                                        </span>
                                                        <input type="datetime-local"
                                                               class="field-input with-prefix"
                                                               value="@op.PickupAt"
                                                               disabled="@_locked"
                                                               @onchange="e => op.PickupAt = e.Value?.ToString()" />
                                                    </div>
                                                </div>

                                                <div class="form-field">
                                                    <label class="field-label">تسليم للعميل</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true">
                                                            <svg viewBox="0 0 24 24" width="13" height="13"
                                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14"
                                                                      stroke-linecap="round"/>
                                                                <path d="M22 4L12 14.01l-3-3"
                                                                      stroke-linecap="round" stroke-linejoin="round"/>
                                                            </svg>
                                                        </span>
                                                        <input type="datetime-local"
                                                               class="field-input with-prefix"
                                                               value="@op.DeliveryAt"
                                                               disabled="@_locked"
                                                               @onchange="e => op.DeliveryAt = e.Value?.ToString()" />
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 3 — توزيع التكلفة والملاحظات
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="ttab-label">
                            <div class="ttab-icon ttab-green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23"/>
                                    <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                </svg>
                            </div>
                            <span>التكلفة والملاحظات</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon green" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="1" x2="12" y2="23"/>
                                        <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">توزيع تكلفة الرحلة والملاحظات</div>
                                    <div class="tab-section-sub">وزّع المصروفات على العمليات المرتبطة</div>
                                </div>
                            </div>

                            @* توزيع التكلفة — تعديل فقط *@
                            @if (_id is null)
                            {
                                <div class="tf-new-hint">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                    </svg>
                                    <div>
                                        <strong>توزيع التكلفة متاح بعد الحفظ</strong>
                                        <p>احفظ الرحلة الأول، وبعدين سجّل المصروفات ووزّع التكلفة على العمليات</p>
                                    </div>
                                </div>
                            }
                            else if (_directCost <= 0)
                            {
                                <div class="tf-info-box">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                    </svg>
                                    <div>
                                        مافيش مصروفات مسجلة على الرحلة لسه —
                                        سجّل المصروفات الأول وبعدين وزّع
                                    </div>
                                </div>
                            }
                            else if (_distributableCost <= 0)
                            {
                                <div class="tf-info-box">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                    </svg>
                                    <div>
                                        كل مصروفات الرحلة مربوطة بعمليات مباشرةً — مافيش حاجة تحتاج توزيع.
                                        (المصروف اللي عليه عملية بيتحسب عليها لوحده)
                                    </div>
                                </div>
                            }
                            else if (_allocRows.Count == 0)
                            {
                                <div class="tf-info-box">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                    </svg>
                                    <div>لا يوجد عمليات مربوطة — احفظ الرحلة بعملياتها الأول</div>
                                </div>
                            }
                            else
                            {
                                @* ── Cost Summary Strip ── *@
                                <div class="tf-cost-strip">
                                    <div class="cost-strip-item">
                                        <div class="cost-strip-label">مصروفات الرحلة</div>
                                        <div class="cost-strip-val cost-red">@_directCost.ToString("N2")</div>
                                    </div>
                                    <div class="cost-strip-sep" aria-hidden="true"></div>
                                    <div class="cost-strip-item">
                                        <div class="cost-strip-label">القابل للتوزيع</div>
                                        <div class="cost-strip-val cost-amber">@_distributableCost.ToString("N2")</div>
                                    </div>
                                    <div class="cost-strip-sep" aria-hidden="true"></div>
                                    <div class="cost-strip-item">
                                        <div class="cost-strip-label">اللي اتوزّع</div>
                                        <div class="cost-strip-val cost-green">
                                            @_allocRows.Sum(a => a.Amount).ToString("N2")
                                        </div>
                                    </div>
                                    <div class="cost-strip-sep" aria-hidden="true"></div>
                                    <div class="cost-strip-item">
                                        <div class="cost-strip-label">المتبقي</div>
                                        @{
                                            var remaining = _distributableCost - _allocRows.Sum(a => a.Amount);
                                        }
                                        <div class="cost-strip-val @(remaining <= 0 ? "cost-green" : "cost-red")">
                                            @remaining.ToString("N2")
                                        </div>
                                    </div>
                                </div>

                                @* ── طريقة التوزيع ── *@
                                <div class="tf-basis-row">
                                    <div class="form-field" style="max-width:280px">
                                        <label class="field-label">طريقة التوزيع</label>
                                        <div class="field-select-wrap">
                                            <svg class="field-select-icon" viewBox="0 0 24 24"
                                                 width="14" height="14" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                                <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                                            </svg>
                                            <select class="field-input field-select" @bind="_basis">
                                                <option value="Manual">متساوي</option>
                                                <option value="RevenueShare">على حسب الإيراد</option>
                                                <option value="ContainerCount">على حسب عدد الحاويات</option>
                                            </select>
                                        </div>
                                    </div>
                                    <button class="tf-distribute-btn"
                                            @onclick="DistributeAsync"
                                            disabled="@_distributing">
                                        @if (_distributing)
                                        {
                                            <span class="btn-spinner sm" aria-hidden="true"></span>
                                            <span>جاري التوزيع...</span>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" width="15" height="15"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <line x1="12" y1="1" x2="12" y2="23"/>
                                                <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                            </svg>
                                            <span>وزّع التكلفة</span>
                                        }
                                    </button>
                                    <div class="tf-distribute-note">
                                        <svg viewBox="0 0 16 16" width="11" height="11"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        الباقي على آخر عملية — المجموع بيطابق المصروفات بالظبط
                                    </div>
                                </div>

                                @* ── جدول التوزيع ── *@
                                <div class="tf-alloc-table-wrap">
                                    <table class="tf-alloc-table" aria-label="جدول توزيع التكلفة">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="th-start">العملية</th>
                                                <th scope="col">الإيراد</th>
                                                <th scope="col">النسبة</th>
                                                <th scope="col">المبلغ المُوزّع</th>
                                                <th scope="col">شريط</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var a in _allocRows)
                                            {
                                                <tr>
                                                    <td class="td-start">
                                                        <div class="alloc-op-name">@a.OperationNumber</div>
                                                    </td>
                                                    <td class="td-num">@a.Revenue.ToString("N2") <small>ج.م</small></td>
                                                    <td>
                                                        <span class="alloc-pct-chip">
                                                            @a.Percent.ToString("0.##")%
                                                        </span>
                                                    </td>
                                                    <td class="td-num td-strong">
                                                        @a.Amount.ToString("N2") <small>ج.م</small>
                                                    </td>
                                                    <td>
                                                        <div class="alloc-bar-wrap">
                                                            <div class="alloc-bar">
                                                                <div class="alloc-bar-fill"
                                                                     style="width:@a.Percent%"></div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @* ── ملاحظات ── *@
                            <div class="tf-notes-head">
                                <svg viewBox="0 0 24 24" width="16" height="16"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                                ملاحظات الرحلة
                            </div>

                            <div class="form-field">
                                <textarea class="field-input field-textarea"
                                          rows="4"
                                          maxlength="1000"
                                          disabled="@_locked"
                                          placeholder="أي ملاحظات خاصة بهذه الرحلة..."
                                          @onchange="e => _f.Notes = e.Value?.ToString()">@_f.Notes</textarea>
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


            </MudTabs>
        </div>


        @* ── Bottom Actions ── *@
        <div class="tf-bottom-actions">

            <button class="tf-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للقائمة
            </button>

            @if (CanSave && !_locked)
            {
                <div class="tf-bottom-right">

                    @if (_activeTab < 2)
                    {
                        <button class="tf-next-btn" @onclick="() => _activeTab++">
                            التالي
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    }

                    <button class="tf-bottom-save"
                            @onclick="SaveAsync"
                            disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ الرحلة</span>
                        }
                    </button>

                </div>
            }

        </div>

    }
</div>


@* ═══════════════════════════════════════════
   CSS
═══════════════════════════════════════════ *@
<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-orange:    #e06520;
        --fc-orange-lt: #fff3ec;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       HERO ADDITIONS
    ================================================================ */
    .tf-hero-badge {
        display: inline-flex; align-items: center;
        padding: 3px 10px; border-radius: 20px;
        font-size: 11px; font-weight: 800;
    }

    .badge-new       { background: rgba(34,197,94,.2);  color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-planned   { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); border: 1px solid rgba(255,255,255,.2); }
    .badge-assigned  { background: rgba(59,130,246,.25); color: #93c5fd; border: 1px solid rgba(59,130,246,.3); }
    .badge-started   { background: rgba(224,101,32,.25); color: #fdba74; border: 1px solid rgba(224,101,32,.3); }
    .badge-completed { background: rgba(34,197,94,.25);  color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-cancelled { background: rgba(239,68,68,.25);  color: #fca5a5; border: 1px solid rgba(239,68,68,.3); }

    .tf-back-btn {
        display: inline-flex; align-items: center; gap: 5px;
        height: 36px; padding: 0 13px;
        border: 1px solid rgba(255,255,255,.2); border-radius: 9px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .tf-back-btn:hover { background: rgba(255,255,255,.14); }
    .tf-back-btn svg  { transform: rotate(180deg); }

    .tf-save-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 18px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .tf-save-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }
    .tf-save-btn:disabled { opacity: .6; cursor: not-allowed; }

    /* Hero Summary */
    .tf-hero-summary {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px);
        margin-top: 4px;
    }

    .tf-sum-item {
        flex: 1; display: flex; align-items: center; gap: 10px;
        padding: 12px 16px;
    }

    .tf-sum-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }

    .tf-sum-icon {
        width: 32px; height: 32px; flex: 0 0 32px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.10); color: rgba(255,255,255,.7);
    }

    .tf-sum-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .tf-sum-val   { font-size: 13px; font-weight: 800; color: #fff; margin-top: 2px; }
    .sum-green    { color: #6ee7b7; }
    .sum-red      { color: #fca5a5; }

    /* ================================================================
       BODY
    ================================================================ */
    .tf-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 180px);
        padding: 16px 20px 32px;
        max-width: 1050px; width: 100%;
        margin: 0 auto;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* ================================================================
       STATES
    ================================================================ */
    .tf-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 280px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .tf-state-icon {
        width: 68px; height: 68px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .tf-state-icon.perm { background: #fff0f2; color: var(--fc-red); }

    .tf-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .tf-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    .tf-state-back {
        margin-top: 8px; padding: 9px 20px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-text);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .tf-state-back:hover { background: #f0f4fa; }

    /* ================================================================
       LOADING
    ================================================================ */
    .tf-loading-wrap {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 14px; min-height: 260px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .tf-spinner {
        width: 36px; height: 36px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: tf-spin .75s linear infinite;
    }
    @@keyframes tf-spin { to { transform: rotate(360deg); } }

    .tf-loading-text { font-size: 13px; font-weight: 600; color: var(--fc-muted); }

    /* ================================================================
       BANNERS
    ================================================================ */
    .tf-locked-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px; border-radius: 12px;
        background: linear-gradient(135deg, #fffbeb, #fff8e0);
        border: 1px solid #fde68a;
    }
    .locked-icon  { flex: 0 0 auto; color: #d97706; }
    .locked-text  { display: flex; flex-direction: column; gap: 2px; }
    .locked-text strong { font-size: 13px; font-weight: 800; color: #92400e; }
    .locked-text span   { font-size: 11.5px; color: #b45309; }

    .tf-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600;
        animation: tf-banner-in .25s ease;
    }
    @@keyframes tf-banner-in {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .banner-success { background: #e9f8f0; color: #0e7a43; border: 1px solid #b5e8d0; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); border: 1px solid #ffc8d0; }
    .banner-close {
        margin-right: auto; background: none; border: none;
        color: inherit; opacity: .6; cursor: pointer; font-size: 13px;
    }
    .banner-close:hover { opacity: 1; }

    /* ================================================================
       TABS
    ================================================================ */
    .tf-tabs-wrap {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden; flex: 1;
    }

    .tf-mud-tabs .mud-tabs-toolbar {
        background: linear-gradient(180deg, #f9fafd 0%, #f3f6fb 100%);
        border-bottom: 2px solid #e8edf5;
        padding: 0 16px; min-height: 54px;
    }

    .tf-mud-tabs .mud-tab {
        font-family: "Cairo","Tajawal","Inter",Arial,sans-serif;
        font-size: 12px; font-weight: 700; color: var(--fc-muted);
        padding: 0 6px; min-width: unset; transition: color .15s ease;
    }

    .tf-mud-tabs .mud-tab.mud-tab-active { color: var(--fc-blue) !important; font-weight: 800; }
    .tf-mud-tabs .mud-tab-slider {
        background: var(--fc-blue) !important;
        height: 3px; border-radius: 3px 3px 0 0;
    }
    .tf-mud-tabs .mud-tab:hover:not(.mud-tab-active) {
        color: var(--fc-text); background: rgba(0,0,0,.03); border-radius: 8px;
    }

    .tf-tab-panel { padding: 0; }

    .ttab-label { display: flex; align-items: center; gap: 7px; padding: 0 4px; white-space: nowrap; }

    .ttab-icon {
        width: 26px; height: 26px;
        display: flex; align-items: center; justify-content: center;
