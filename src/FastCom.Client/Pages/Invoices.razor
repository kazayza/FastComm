@page "/invoices"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>الفواتير — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">المالية · فواتير العملاء</div>
                <h1 class="fc-hero-title">الفواتير</h1>
                <p class="fc-hero-sub">بتتبنى من بنود إيرادات العمليات — مسودة، اعتماد، إصدار، إرسال</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="New">فاتورة جديدة</MudButton>
                }
            </div>
        </div>

        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.FactCheck" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">عدد الفواتير</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></div>
                    <div><div class="fc-kpi-num">@Money(OpenDue)</div><div class="fc-kpi-lb">غير محصّل</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div><div class="fc-kpi-num">@Overdue.Count()</div><div class="fc-kpi-lb">فاتورة متأخرة</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                    <div><div class="fc-kpi-num">@Money(ThisMonth)</div><div class="fc-kpi-lb">مفوتر الشهر</div></div>
                </div>
            </div>
        }
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="inv-body">

    @if (!CanView)
    {
        <div class="inv-state-box">
            <div class="inv-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض الفواتير</p>
        </div>
    }
    else
    {
        <div class="inv-card">

            @* ── Toolbar ── *@
            <div class="inv-toolbar">

                <div class="inv-search-wrap">
                    <svg class="inv-search-icon" viewBox="0 0 24 24"
                         width="16" height="16" fill="none" stroke="currentColor"
                         stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="inv-search-input"
                           placeholder="ابحث برقم الفاتورة أو العميل..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="inv-search-clear" @onclick="() => _search = string.Empty">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="inv-cust-filter-wrap">
                    <svg class="inv-cust-icon" viewBox="0 0 24 24" width="13" height="13"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <select class="inv-cust-select" @bind="_custFilter">
                        <option value="0">كل العملاء</option>
                        @foreach (var c in _customers)
                        {
                            <option value="@c.Id">@c.Label</option>
                        }
                    </select>
                </div>

                <div class="inv-results-badge">
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>

            </div>


            @* ── Status Tabs ── *@
            <div class="inv-status-bar">
                <div class="inv-status-tabs" role="group" aria-label="فلتر الحالة">
                    @foreach (var t in _statusTabs)
                    {
                        var cnt = t.Key == "all"
                            ? _items.Count
                            : _items.Count(x => x.Status == t.Key);

                        <button class="inv-status-tab @(_tab == t.Key ? "active" : "")"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="inv-tab-dot @StatusDotColor(t.Key)" aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="inv-tab-count">@cnt</span>
                        </button>
                    }
                </div>
            </div>


            @* ── Content ── *@
            @if (_loading)
            {
                <div class="inv-loading">
                    <div class="inv-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل الفواتير...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="inv-empty">
                    <div class="inv-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="42" height="42"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="inv-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) ? "لا توجد فواتير في هذا الفلتر" : "لا توجد نتائج")
                    </div>
                    <div class="inv-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search) ? "جرّب فلتر مختلف أو أنشئ فاتورة جديدة" : "جرّب كلمة بحث مختلفة")
                    </div>
                    @if (CanCreate && string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="inv-add-btn" @onclick="New">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            فاتورة جديدة
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="inv-table-wrap">
                    <table class="inv-table" aria-label="قائمة الفواتير">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">الفاتورة</th>
                                <th scope="col">التاريخ</th>
                                <th scope="col">المبالغ</th>
                                <th scope="col">التحصيل</th>
                                <th scope="col">الحالة</th>
                                <th scope="col">الدفع</th>
                                <th scope="col" style="width:240px">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Filtered)
                            {
                                var isOverdue = i.DueDate.HasValue
                                    && i.DueDate.Value < DateOnly.FromDateTime(DateTime.Now)
                                    && i.PaymentStatus != "Paid"
                                    && i.Status is "Issued" or "Sent";

                                var paidPct = i.GrandTotal > 0
                                    ? (double)(i.PaidAmount / i.GrandTotal * 100)
                                    : 0;

                                <tr class="@(i.Status == "Cancelled" ? "row-cancelled" : "")
                                           @(isOverdue ? "row-overdue" : "")">

                                    @* ── الفاتورة: رقم + عميل + عمليات ── *@
                                    <td class="td-start">
                                        <div class="inv-inv-cell">
                                            <div class="inv-avatar @InvAvatarClass(i.Status)"
                                                 aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="15" height="15"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                                </svg>
                                            </div>
                                            <div class="inv-inv-info">
                                                <button class="inv-code-btn"
                                                        @onclick="() => Open(i)"
                                                        aria-label="فتح تفاصيل @i.InvoiceNumber">
                                                    @i.InvoiceNumber
                                                    @if (i.DocumentTypeCode == "CreditNote")
                                                    {
                                                        <span class="inv-credit-tag">إشعار</span>
                                                    }
                                                </button>
                                                <div class="inv-customer-name">@i.CustomerName</div>
                                                <div class="inv-inv-meta">
                                                    @if (i.OperationsCount > 0)
                                                    {
                                                        <span class="inv-meta-tag tag-ops">
                                                            @i.OperationsCount عملية
                                                        </span>
                                                    }
                                                    <span class="inv-meta-tag tag-items">
                                                        @i.ItemsCount بند
                                                    </span>
                                                    @if (isOverdue)
                                                    {
                                                        <span class="inv-overdue-tag" role="alert">⚠️ متأخرة</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    @* ── التاريخ ── *@
                                    <td>
                                        <div class="inv-date-cell">
                                            <div class="inv-date-issue">
                                                <svg viewBox="0 0 16 16" width="10" height="10"
                                                     fill="none" stroke="currentColor" stroke-width="1.7"
                                                     aria-hidden="true">
                                                    <rect x="2" y="3" width="12" height="11" rx="2"/>
                                                    <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                                                </svg>
                                                @i.InvoiceDate.ToString("yyyy-MM-dd")
                                            </div>
                                            @if (i.DueDate is not null)
                                            {
                                                <div class="inv-date-due @(isOverdue ? "due-late" : "")">
                                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                                         fill="none" stroke="currentColor" stroke-width="1.7"
                                                         aria-hidden="true">
                                                        <circle cx="8" cy="8" r="6"/>
                                                        <path d="M8 5v3l2 2" stroke-linecap="round"/>
                                                    </svg>
                                                    استحقاق @i.DueDate.Value.ToString("yyyy-MM-dd")
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    @* ── المبالغ ── *@
                                    <td>
                                        <div class="inv-amounts-cell">
                                            <div class="inv-grand-total">@Money(i.GrandTotal)</div>
                                            @if (i.TaxTotal != 0)
                                            {
                                                <div class="inv-tax-sub">+ ضريبة @Money(i.TaxTotal)</div>
                                            }
                                        </div>
                                    </td>

                                    @* ── التحصيل ── *@
                                    <td>
                                        <div class="inv-collection-cell">
                                            <div class="inv-collection-bar"
                                                 title="محصّل @paidPct.ToString("0")%">
                                                <div class="inv-col-fill @(i.PaymentStatus == "Paid" ? "col-paid" : i.PaymentStatus == "PartiallyPaid" ? "col-partial" : "col-unpaid")"
                                                     style="width:@Math.Min(paidPct, 100)%">
                                                </div>
                                            </div>
                                            <div class="inv-collection-nums">
                                                <span class="inv-paid-num">@Money(i.PaidAmount)</span>
                                                <span class="inv-due-badge @(i.Due > 0 ? "due-pos" : "due-zero")">
                                                    @Money(i.Due)
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    @* ── الحالة ── *@
                                    <td>
                                        <span class="inv-chip @StatusChipClass(i.Status)">
                                            <span class="inv-chip-dot @StatusDotClass(i.Status)"
                                                  aria-hidden="true"></span>
                                            @StatusAr(i.Status)
                                        </span>
                                    </td>

                                    @* ── الدفع ── *@
                                    <td>
                                        <span class="inv-chip @PayChipClass(i.PaymentStatus)">
                                            <span class="inv-chip-dot @PayDotClass(i.PaymentStatus)"
                                                  aria-hidden="true"></span>
                                            @PayAr(i.PaymentStatus)
                                        </span>
                                    </td>

                                    @* ── إجراءات ── *@
                                    <td>
                                        <div class="inv-actions">

                                            @* تفاصيل *@
                                            <button class="inv-act-btn act-info"
                                                    @onclick="() => Open(i)"
                                                    title="التفاصيل">
                                                <svg viewBox="0 0 24 24" width="14" height="14"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                                </svg>
                                            </button>

                                            @* اعتماد *@
                                            @if (i.Status == "Draft" && CanApprove)
                                            {
                                                <button class="inv-act-btn act-approve"
                                                        @onclick='() => SetStatus(i, "Approved")'
                                                        title="اعتماد">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M9 12l2 2 4-4"/>
                                                        <circle cx="12" cy="12" r="10"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* إصدار *@
                                            @if (i.Status is "Draft" or "Approved" && CanIssue)
                                            {
                                                <button class="inv-act-btn act-issue"
                                                        @onclick='() => SetStatus(i, "Issued")'
                                                        title="إصدار">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                                                        <path d="M7 11V7a4 4 0 018 0" stroke-linecap="round"/>
                                                        <path d="M15 7h2" stroke-linecap="round"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* تعديل *@
                                            @if (i.Status is "Draft" or "Approved" && CanEdit)
                                            {
                                                <button class="inv-act-btn act-edit"
                                                        @onclick="() => Edit(i)"
                                                        title="تعديل">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* إشعار دائن *@
                                            @if (i.DocumentTypeCode != "CreditNote" &&
                                                 i.Status is "Issued" or "Sent" && CanCredit)
                                            {
                                                <button class="inv-act-btn act-credit"
                                                        @onclick="() => OpenCredit(i)"
                                                        title="إشعار دائن">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* تسليم *@
                                            @if (i.Status is "Approved" or "Issued" or "Sent" && CanSend)
                                            {
                                                <button class="inv-act-btn act-send"
                                                        @onclick="() => OpenSend(i)"
                                                        title="تسليم للعميل">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M22 2L11 13"/>
                                                        <path d="M22 2L15 22l-4-9-9-4 20-7z"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* طباعة *@
                                            @if (CanPrint)
                                            {
                                                <button class="inv-act-btn act-print"
                                                        @onclick="() => Print(i)"
                                                        title="طباعة">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <polyline points="6 9 6 2 18 2 18 9"/>
                                                        <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
                                                        <rect x="6" y="14" width="12" height="8"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* إلغاء *@
                                            @if (i.Status != "Cancelled" && CanCancel)
                                            {
                                                <button class="inv-act-btn act-cancel"
                                                        @onclick='() => SetStatus(i, "Cancelled")'
                                                        title="إلغاء">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10"/>
                                                        <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* حذف *@
                                            @if (i.Status == "Draft" && CanDelete)
                                            {
                                                @if (_confirmId == i.InvoiceId)
                                                {
                                                    <button class="inv-confirm-del"
                                                            @onclick="() => Delete(i)">
                                                        حذف؟
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="inv-act-btn act-delete"
                                                            @onclick="() => _confirmId = i.InvoiceId"
                                                            title="حذف">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   MODAL — فاتورة جديدة / تعديل
═══════════════════════════════════════════ *@
@if (_modalOpen && CanCreate)
{
    <div class="inv-modal-backdrop" @onclick="Close"
         role="dialog" aria-modal="true"
         aria-label="@(_editId is null ? "فاتورة جديدة" : "تعديل فاتورة")">
        <div class="inv-modal inv-modal-xl" @onclick:stopPropagation="true">

            @* ── STICKY HEADER ── *@
            <div class="inv-modal-head">
                <div class="inv-modal-icon inv-icon-blue" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                    </svg>
                </div>
                <div style="flex:1; min-width:0">
                    <div class="inv-modal-title">
                        @(_editId is null ? "فاتورة جديدة" : "تعديل فاتورة")
                    </div>
                    <div class="inv-modal-sub">
                        الرقم بيتولد تلقائياً (INV-)
                        @if (_f.Items.Any())
                        {
                            <span> · الإجمالي <strong>@Money(FormTotal) ج.م</strong></span>
                        }
                    </div>
                </div>
                <button class="inv-modal-close" @onclick="Close" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="inv-modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button @onclick="() => _msg = null">✕</button>
                </div>
            }

            @* ── SCROLLABLE BODY ── *@
            <div class="inv-modal-body">

                @* ── بيانات الفاتورة الأساسية ── *@
                <div class="inv-form-section">
                    <div class="inv-section-title">
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        بيانات الفاتورة
                    </div>
                    <div class="inv-modal-grid">

                        <div class="inv-mfield">
                            <label class="inv-mlabel">
                                العميل <span class="inv-mrequired">*</span>
                            </label>
                            <div class="inv-mselect-wrap">
                                <svg class="inv-msel-icon" viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                                <select class="inv-minput inv-msel"
                                        value="@_f.CustomerId"
                                        @onchange="OnCustomerChanged"
                                        aria-required="true">
                                    <option value="0">— اختر عميل —</option>
                                    @foreach (var c in _customers)
                                    {
                                        <option value="@c.Id">@c.Label (@c.Code)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="inv-mfield">
                            <label class="inv-mlabel">تاريخ الفاتورة</label>
                            <div class="inv-mfield-group">
                                <span class="inv-mprefix" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="5" width="18" height="16" rx="2"/>
                                        <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <input type="date" class="inv-minput with-prefix"
                                       value="@_f.InvoiceDate"
                                       @onchange="e => _f.InvoiceDate = e.Value?.ToString()" />
                            </div>
                        </div>

                        <div class="inv-mfield">
                            <label class="inv-mlabel">تاريخ الاستحقاق</label>
                            <div class="inv-mfield-group">
                                <span class="inv-mprefix" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 6v6l4 2" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <input type="date" class="inv-minput with-prefix"
                                       value="@_f.DueDate"
                                       @onchange="e => _f.DueDate = e.Value?.ToString()" />
                            </div>
                            <div class="inv-mhint">
                                <svg viewBox="0 0 16 16" width="10" height="10"
                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <circle cx="8" cy="8" r="6"/>
                                    <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                </svg>
                                فاضي = بيتحسب من شرط دفع العميل
                            </div>
                        </div>

                        <div class="inv-mfield">
                            <label class="inv-mlabel">ملاحظات</label>
                            <input class="inv-minput"
                                   value="@_f.Notes"
                                   maxlength="1000"
                                   placeholder="أي ملاحظات للفاتورة..."
                                   @onchange="e => _f.Notes = e.Value?.ToString()" />
                        </div>

                    </div>
                </div>


                @* ── إضافة من عملية ── *@
                @if (_f.CustomerId > 0)
                {
                    <div class="inv-form-section">
                        <div class="inv-section-title">
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                            </svg>
                            إضافة من عملية
                        </div>
                        <div class="inv-mselect-wrap">
                            <svg class="inv-msel-icon" viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                            </svg>
                            <select class="inv-minput inv-msel"
                                    value="@_pickOp"
                                    @onchange="OnPickOp">
                                <option value="0">— اختر عملية لإضافة بنودها تلقائياً —</option>
                                @foreach (var o in _ops)
                                {
                                    <option value="@o.OperationId">
                                        @o.OperationNumber — @Money(o.RevenueNet) ج.م
                                        @(o.InvoiceNumber is null ? "" : " · مفوترة في " + o.InvoiceNumber)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                }


                @* ── سطر يدوي ── *@
                <div class="inv-form-section">
                    <div class="inv-section-title">
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                        </svg>
                        إضافة سطر يدوي
                    </div>
                    <div class="inv-manual-grid">
                        <div class="inv-mfield">
                            <label class="inv-mlabel">الخدمة</label>
                            <div class="inv-mselect-wrap">
                                <svg class="inv-msel-icon" viewBox="0 0 24 24" width="13" height="13"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                    <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                                </svg>
                                <select class="inv-minput inv-msel"
                                        value="@_manual.ServiceId"
                                        @onchange="OnManualService">
                                    <option value="0">— اختر خدمة —</option>
                                    @foreach (var s in _services)
                                    {
                                        <option value="@s.Id">@s.Label</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="inv-mfield">
                            <label class="inv-mlabel">الكمية</label>
                            <input type="number" step="0.001" min="0"
                                   class="inv-minput"
                                   placeholder="1"
                                   value="@_manual.Quantity"
                                   @onchange="e => _manual.Quantity = ParseDec(e.Value)" />
                        </div>
                        <div class="inv-mfield">
                            <label class="inv-mlabel">السعر</label>
                            <div class="inv-mfield-group">
                                <span class="inv-mprefix" aria-hidden="true">ج.م</span>
                                <input type="number" step="0.01" min="0"
                                       class="inv-minput with-prefix"
                                       placeholder="0.00"
                                       value="@_manual.UnitPrice"
                                       @onchange="e => _manual.UnitPrice = ParseDec(e.Value)" />
                            </div>
                        </div>
                        <div class="inv-mfield">
                            <label class="inv-mlabel">الخصم</label>
                            <div class="inv-mfield-group">
                                <span class="inv-mprefix" aria-hidden="true">ج.م</span>
                                <input type="number" step="0.01" min="0"
                                       class="inv-minput with-prefix"
                                       placeholder="0.00"
                                       value="@_manual.Discount"
                                       @onchange="e => _manual.Discount = ParseDec(e.Value)" />
                            </div>
                        </div>
                        <div class="inv-mfield">
                            <label class="inv-mlabel">الضريبة</label>
                            <div class="inv-mselect-wrap">
                                <select class="inv-minput inv-msel"
                                        value="@_manual.TaxRateId"
                                        @onchange="e => _manual.TaxRateId = ParseInt(e.Value) == 0 ? null : ParseInt(e.Value)">
                                    <option value="0">بدون ضريبة</option>
                                    @foreach (var t in _taxRates)
                                    {
                                        <option value="@t.Id">@t.Label</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="inv-mfield" style="align-self:end">
                            <button class="inv-add-line-btn" @onclick="AddManual">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2.5"
                                     aria-hidden="true">
                                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                </svg>
                                إضافة
                            </button>
                        </div>
                    </div>
                </div>


                @* ── جدول البنود ── *@
                <div class="inv-form-section">
                    <div class="inv-section-title">
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <line x1="8" y1="6" x2="21" y2="6"/>
                            <line x1="8" y1="12" x2="21" y2="12"/>
                            <line x1="8" y1="18" x2="21" y2="18"/>
                            <line x1="3" y1="6" x2="3.01" y2="6"/>
                            <line x1="3" y1="12" x2="3.01" y2="12"/>
                            <line x1="3" y1="18" x2="3.01" y2="18"/>
                        </svg>
                        البنود
                        <span class="inv-items-count">@_f.Items.Count بند</span>
                        @if (_f.Items.Any())
                        {
                            <span class="inv-items-total">إجمالي @Money(FormTotal) ج.م</span>
                        }
                    </div>

                    @if (!_f.Items.Any())
                    {
                        <div class="inv-items-empty">ضيف بنود من عملية أو أضف سطراً يدوياً</div>
                    }
                    else
                    {
                        <div class="inv-items-table-wrap">
                            <table class="inv-items-table">
                                <thead>
                                    <tr>
                                        <th>البيان</th>
                                        <th>الكمية</th>
                                        <th>السعر</th>
                                        <th>الخصم</th>
                                        <th>الضريبة</th>
                                        <th>الإجمالي</th>
                                        <th style="width:40px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in _f.Items)
                                    {
                                        <tr>
                                            <td class="td-desc">
                                                <div class="item-desc">@l.Description</div>
                                                @if (l.OperationNumber is not null)
                                                {
                                                    <div class="item-op-tag">@l.OperationNumber</div>
                                                }
                                            </td>
                                            <td>
                                                <input type="number" step="0.001"
                                                       class="inv-cell-input"
                                                       value="@l.Quantity"
                                                       @onchange="e => l.Quantity = ParseDec(e.Value)" />
                                            </td>
                                            <td>
                                                <input type="number" step="0.01"
                                                       class="inv-cell-input"
                                                       value="@l.UnitPrice"
                                                       @onchange="e => l.UnitPrice = ParseDec(e.Value)" />
                                            </td>
                                            <td>
                                                <input type="number" step="0.01"
                                                       class="inv-cell-input"
                                                       value="@l.Discount"
                                                       @onchange="e => l.Discount = ParseDec(e.Value)" />
                                            </td>
                                            <td>
                                                <select class="inv-cell-select"
                                                        value="@(l.TaxRateId ?? 0)"
                                                        @onchange="e => OnLineTax(l, e)">
                                                    <option value="0">—</option>
                                                    @foreach (var t in _taxRates)
                                                    {
                                                        <option value="@t.Id">@t.Label</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="td-total">@Money(LineTotal(l))</td>
                                            <td>
                                                <button class="inv-del-line"
                                                        @onclick="() => _f.Items.Remove(l)"
                                                        aria-label="حذف السطر">
                                                    <svg viewBox="0 0 24 24" width="13" height="13"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                    </svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="items-total-row">
                                        <td colspan="5" class="total-label">الإجمالي الكلي</td>
                                        <td class="total-val">@Money(FormTotal) ج.م</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

            </div>

            @* ── STICKY FOOTER ── *@
            <div class="inv-modal-foot">
                <button class="inv-modal-cancel" @onclick="Close">إلغاء</button>
                <button class="inv-modal-save save-blue"
                        @onclick="SaveAsync"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                            <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>حفظ الفاتورة</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — إشعار دائن
═══════════════════════════════════════════ *@
@if (_creditOpen && CanCredit && _creditOriginal is not null)
{
    <div class="inv-modal-backdrop" @onclick="CloseCredit"
         role="dialog" aria-modal="true" aria-label="إشعار دائن">
        <div class="inv-modal inv-modal-xl" @onclick:stopPropagation="true">

            <div class="inv-modal-head">
                <div class="inv-modal-icon inv-icon-amber" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
                    </svg>
                </div>
                <div style="flex:1; min-width:0">
                    <div class="inv-modal-title">
                        إشعار دائن على @_creditOriginal.InvoiceNumber
                    </div>
                    <div class="inv-modal-sub">
                        البنود سالبة · الإجمالي <strong>@Money(CreditTotal) ج.م</strong>
                    </div>
                </div>
                <button class="inv-modal-close" @onclick="CloseCredit" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="inv-modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button @onclick="() => _msg = null">✕</button>
                </div>
            }

            <div class="inv-modal-body">

                <div class="inv-modal-grid">
                    <div class="inv-mfield">
                        <label class="inv-mlabel">سبب المرتجع</label>
                        <input class="inv-minput"
                               value="@_cf.ReasonCode"
                               maxlength="20"
                               placeholder="مثال: RETURN أو DISCOUNT"
                               dir="ltr"
                               @onchange="e => _cf.ReasonCode = e.Value?.ToString()" />
                    </div>
                    <div class="inv-mfield">
                        <label class="inv-mlabel">التاريخ</label>
                        <div class="inv-mfield-group">
                            <span class="inv-mprefix" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                                    <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input type="date" class="inv-minput with-prefix"
                                   value="@_cf.InvoiceDate"
                                   @onchange="e => _cf.InvoiceDate = e.Value?.ToString()" />
                        </div>
                    </div>
                </div>

                <div class="inv-form-section" style="margin-top:14px">
                    <div class="inv-section-title">
                        بنود الإشعار
                        <span class="inv-items-count">@_cf.Items.Count بند</span>
                    </div>

                    @if (!_cf.Items.Any())
                    {
                        <div class="inv-items-empty">مافيش بنود</div>
                    }
                    else
                    {
                        <div class="inv-items-table-wrap">
                            <table class="inv-items-table">
                                <thead>
                                    <tr>
                                        <th>البيان</th>
                                        <th>الكمية</th>
                                        <th>السعر</th>
                                        <th>الضريبة</th>
                                        <th>الإجمالي</th>
                                        <th style="width:40px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in _cf.Items)
                                    {
                                        <tr>
                                            <td class="td-desc">
                                                <div class="item-desc">@l.Description</div>
                                            </td>
                                            <td>
                                                <input type="number" step="0.001"
                                                       class="inv-cell-input"
                                                       value="@l.Quantity"
                                                       @onchange="e => l.Quantity = ParseDec(e.Value)" />
                                            </td>
                                            <td class="td-price">@Money(l.UnitPrice)</td>
                                            <td class="td-price">
                                                @(l.TaxRateId is null ? "—" : RateOf(l.TaxRateId.Value).ToString("0.##") + "%")
                                            </td>
                                            <td class="td-total credit-total">@Money(LineTotal(l))</td>
                                            <td>
                                                <button class="inv-del-line"
                                                        @onclick="() => _cf.Items.Remove(l)">
                                                    <svg viewBox="0 0 24 24" width="13" height="13"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                    </svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="items-total-row">
                                        <td colspan="4" class="total-label">الإجمالي</td>
                                        <td class="total-val credit-total-val">@Money(CreditTotal) ج.م</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

            </div>

            <div class="inv-modal-foot">
                <button class="inv-modal-cancel" @onclick="CloseCredit">إلغاء</button>
                <button class="inv-modal-save save-amber"
                        @onclick="SaveCredit"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
                        </svg>
                    }
                    إصدار الإشعار
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — تسليم الفاتورة
═══════════════════════════════════════════ *@
@if (_sendOpen && CanSend && _sendTarget is not null)
{
    <div class="inv-modal-backdrop" @onclick="CloseSend"
         role="dialog" aria-modal="true" aria-label="تسليم الفاتورة">
        <div class="inv-modal inv-modal-sm" @onclick:stopPropagation="true">

            <div class="inv-modal-head">
                <div class="inv-modal-icon inv-icon-green" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 2L11 13"/>
                        <path d="M22 2L15 22l-4-9-9-4 20-7z"/>
                    </svg>
                </div>
                <div>
                    <div class="inv-modal-title">تسليم @_sendTarget.InvoiceNumber 📤</div>
                    <div class="inv-modal-sub">بيسجّل في سجل التسليم ويحوّل الفاتورة «مُرسلة»</div>
                </div>
                <button class="inv-modal-close" @onclick="CloseSend" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="inv-modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button @onclick="() => _msg = null">✕</button>
                </div>
            }

            <div class="inv-modal-body">

                @* Channel Toggle *@
                <div class="inv-channel-group" role="group" aria-label="طريقة التسليم">
                    @foreach (var ch in new[] {
                        ("Manual", "يدوي", "✋"),
                        ("WhatsApp", "واتساب", "💬"),
                        ("Portal", "بوابة", "🌐"),
                        ("Fax", "فاكس", "📠")
                    })
                    {
                        <button type="button"
                                class="inv-channel-btn @(_sf.Channel == ch.Item1 ? "channel-active" : "")"
                                @onclick="() => _sf.Channel = ch.Item1"
                                aria-pressed="@(_sf.Channel == ch.Item1)">
                            <span>@ch.Item3</span>
                            <span>@ch.Item2</span>
                        </button>
                    }
                </div>

                <div class="inv-mfield" style="margin-top:16px">
                    <label class="inv-mlabel">
                        المستلم
                        <span class="inv-mrequired">*</span>
                    </label>
                    <input class="inv-minput"
                           value="@_sf.Recipient"
                           maxlength="254"
                           placeholder="اسم أو رقم واتساب أو إيميل..."
                           @onchange="e => _sf.Recipient = e.Value?.ToString()" />
                    <div class="inv-mhint">
                        <svg viewBox="0 0 16 16" width="10" height="10"
                             fill="none" stroke="currentColor" stroke-width="1.8"
                             aria-hidden="true">
                            <circle cx="8" cy="8" r="6"/>
                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                        </svg>
                        الإرسال بالإيميل لسه مش موصّل — سجل التسليم بيتكتب فقط
                    </div>
                </div>

            </div>

            <div class="inv-modal-foot">
                <button class="inv-modal-cancel" @onclick="CloseSend">إلغاء</button>
                <button class="inv-modal-save save-green"
                        @onclick="SaveSend"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M22 2L11 13"/>
                            <path d="M22 2L15 22l-4-9-9-4 20-7z"/>
                        </svg>
                    }
                    تسجيل التسليم
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — تفاصيل الفاتورة
═══════════════════════════════════════════ *@
@if (_detailOpen && _detail is not null)
{
    <div class="inv-modal-backdrop" @onclick="CloseDetail"
         role="dialog" aria-modal="true" aria-label="تفاصيل الفاتورة">
        <div class="inv-modal inv-modal-xl" @onclick:stopPropagation="true">

            @* ── STICKY HEADER ── *@
            <div class="inv-modal-head inv-detail-header">
                <div class="inv-modal-icon @DetailIconClass(_detail.Invoice.Status)"
                     aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                    </svg>
                </div>
                <div style="flex:1; min-width:0">
                    <div class="inv-modal-title" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                        <span>@_detail.Invoice.InvoiceNumber</span>
                        @if (_detail.Invoice.DocumentTypeCode == "CreditNote")
                        {
                            <span class="inv-credit-badge">إشعار دائن</span>
                        }
                        <span class="inv-chip @StatusChipClass(_detail.Invoice.Status)">
                            <span class="inv-chip-dot @StatusDotClass(_detail.Invoice.Status)"
                                  aria-hidden="true"></span>
                            @StatusAr(_detail.Invoice.Status)
                        </span>
                        <span class="inv-chip @PayChipClass(_detail.Invoice.PaymentStatus)">
                            <span class="inv-chip-dot @PayDotClass(_detail.Invoice.PaymentStatus)"
                                  aria-hidden="true"></span>
                            @PayAr(_detail.Invoice.PaymentStatus)
                        </span>
                    </div>
                    <div class="inv-detail-meta">
                        <span class="inv-detail-meta-tag">
                            <svg viewBox="0 0 16 16" width="11" height="11"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <path d="M13 14v-1a3 3 0 00-3-3H6a3 3 0 00-3 3v1"/>
                                <circle cx="8" cy="5" r="3"/>
                            </svg>
                            @_detail.Invoice.CustomerName
                        </span>
                        <span class="inv-detail-meta-tag">
                            @_detail.Invoice.InvoiceDate
                        </span>
                        @if (_detail.Invoice.CustomerTaxNumber is not null)
                        {
                            <span class="inv-detail-meta-tag">ر.ض @_detail.Invoice.CustomerTaxNumber</span>
                        }
                        @if (_detail.Invoice.CurrencyCode != "EGP")
                        {
                            <span class="inv-detail-meta-tag">@_detail.Invoice.CurrencyCode</span>
                        }
                    </div>
                </div>
                <button class="inv-modal-close" @onclick="CloseDetail" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @* ── SCROLLABLE BODY ── *@
            <div class="inv-modal-body inv-detail-body">

                @* ── Summary Cards ── *@
                <div class="inv-detail-summary">
                    <div class="inv-detail-card">
                        <div class="detail-card-ring ring-subtotal" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="1" x2="12" y2="23"/>
                                <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                            </svg>
                        </div>
                        <div>
                            <div class="detail-card-label">قبل الضريبة</div>
                            <div class="detail-card-val">@Money(_detail.Invoice.SubTotal)</div>
                        </div>
                    </div>
                    <div class="inv-detail-card">
                        <div class="detail-card-ring ring-discount" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 5L5 19M9 6.5a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0zM20 17.5a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="detail-card-label">الخصم</div>
                            <div class="detail-card-val discount-val">@Money(_detail.Invoice.DiscountTotal)</div>
                        </div>
                    </div>
                    <div class="inv-detail-card">
                        <div class="detail-card-ring ring-tax" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 12V22H4V12M22 7H2v5h20V7zM12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="detail-card-label">الضريبة</div>
                            <div class="detail-card-val">@Money(_detail.Invoice.TaxTotal)</div>
                        </div>
                    </div>
                    <div class="inv-detail-card card-grand">
                        <div class="detail-card-ring ring-grand" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="4" width="22" height="16" rx="2"/>
                                <path d="M1 10h22"/>
                            </svg>
                        </div>
                        <div>
                            <div class="detail-card-label">الإجمالي</div>
                            <div class="detail-card-val grand-val">@Money(_detail.Invoice.GrandTotal)</div>
                        </div>
                    </div>
                    <div class="inv-detail-card @(_detail.Invoice.Due > 0 ? "card-due" : "card-paid")">
                        <div class="detail-card-ring @(_detail.Invoice.Due > 0 ? "ring-due" : "ring-paid")"
                             aria-hidden="true">
                            @if (_detail.Invoice.Due > 0)
                            {
                                <svg viewBox="0 0 24 24" width="18" height="18"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <path d="M12 8v4M12 16h.01" stroke-linecap="round"/>
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="18" height="18"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                    <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            }
                        </div>
                        <div>
                            <div class="detail-card-label">المتبقي</div>
                            <div class="detail-card-val @(_detail.Invoice.Due > 0 ? "due-val" : "paid-val")">
                                @Money(_detail.Invoice.Due)
                            </div>
                        </div>
                    </div>
                </div>

                @* Progress bar التحصيل *@
                @{
                    var detailPaidPct = _detail.Invoice.GrandTotal > 0
                        ? (double)(_detail.Invoice.PaidAmount / _detail.Invoice.GrandTotal * 100)
                        : 0;
                }
                <div class="inv-detail-progress">
                    <div class="inv-det-prog-bar">
                        <div class="inv-det-prog-fill @(_detail.Invoice.PaymentStatus == "Paid" ? "fill-paid" : "fill-partial")"
                             style="width:@Math.Min(detailPaidPct, 100)%">
                        </div>
                    </div>
                    <div class="inv-det-prog-labels">
                        <span>محصّل @Money(_detail.Invoice.PaidAmount) ج.م (@detailPaidPct.ToString("0")%)</span>
                        <span>متبقي @Money(_detail.Invoice.Due) ج.م</span>
                    </div>
                </div>

                @* Credit Note Notice *@
                @if (_detail.Invoice.OriginalInvoiceNumber is not null)
                {
                    <div class="inv-credit-notice" role="status">
                        <svg viewBox="0 0 24 24" width="18" height="18"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                        </svg>
                        إشعار دائن على الفاتورة <strong>@_detail.Invoice.OriginalInvoiceNumber</strong>
                    </div>
                }

                @* ── جدول البنود ── *@
                <div class="inv-detail-section">
                    <div class="inv-detail-section-head">
                        <span class="inv-det-sec-title">
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                                <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                            </svg>
                            البنود
                        </span>
                        <span class="inv-det-sec-count">@_detail.Items.Count</span>
                    </div>
                    <div class="inv-items-table-wrap">
                        <table class="inv-items-table">
                            <thead>
                                <tr>
                                    <th>البيان</th><th>الكمية</th><th>السعر</th>
                                    <th>الخصم</th><th>الضريبة</th><th>الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in _detail.Items)
                                {
                                    <tr>
                                        <td class="td-desc">
                                            <div class="item-desc">@l.Description</div>
                                            @if (l.OperationNumber is not null)
                                            {
                                                <div class="item-op-tag">@l.OperationNumber</div>
                                            }
                                        </td>
                                        <td class="td-num">@l.Quantity.ToString("0.###")</td>
                                        <td class="td-num">@Money(l.UnitPrice)</td>
                                        <td class="td-num">@Money(l.Discount)</td>
                                        <td class="td-num">@l.TaxRate.ToString("0.##")%</td>
                                        <td class="td-total">@Money(l.LineTotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* ── العمليات ── *@
                @if (_detail.Operations.Any())
                {
                    <div class="inv-detail-section">
                        <div class="inv-detail-section-head">
                            <span class="inv-det-sec-title">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                </svg>
                                العمليات المرتبطة
                            </span>
                            <span class="inv-det-sec-count">@_detail.Operations.Count</span>
                        </div>
                        <div class="inv-detail-ops-list">
                            @foreach (var o in _detail.Operations)
                            {
                                <span class="inv-op-tag">@o.OperationNumber</span>
                            }
                        </div>
                    </div>
                }

                @* ── الدفعات ── *@
                @if (_detail.Allocations.Any())
                {
                    <div class="inv-detail-section">
                        <div class="inv-detail-section-head">
                            <span class="inv-det-sec-title">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <rect x="2" y="7" width="20" height="14" rx="2"/>
                                    <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                    <circle cx="12" cy="14" r="2"/>
                                </svg>
                                الدفعات المخصصة
                            </span>
                            <span class="inv-det-sec-count">@_detail.Allocations.Count</span>
                        </div>
                        <div class="inv-alloc-list">
                            @foreach (var a in _detail.Allocations)
                            {
                                <div class="inv-alloc-row">
                                    <span class="inv-alloc-num">@a.PaymentNumber</span>
                                    <span class="inv-alloc-amount">@Money(a.AllocatedAmount) ج.م</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ── الملاحظات ── *@
                @if (_detail.Invoice.Notes is not null)
                {
                    <div class="inv-detail-section">
                        <div class="inv-detail-section-head">
                            <span class="inv-det-sec-title">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                                ملاحظات
                            </span>
                        </div>
                        <div class="inv-detail-notes">@_detail.Invoice.Notes</div>
                    </div>
                }

            </div>

            @* ── STICKY FOOTER ── *@
            <div class="inv-modal-foot">
                <button class="inv-modal-cancel" @onclick="CloseDetail">إغلاق</button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   CSS
═══════════════════════════════════════════ *@
<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-teal:      #0d9488;
        --fc-teal-lt:   #e6faf8;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       BODY
    ================================================================ */
    .inv-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1400px; width: 100%;
        margin: 0 auto;
    }

    /* ================================================================
       STATES
    ================================================================ */
    .inv-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .inv-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .inv-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .inv-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .inv-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* ================================================================
       CARD
    ================================================================ */
    .inv-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    /* ================================================================
       TOOLBAR
    ================================================================ */
    .inv-toolbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7; flex-wrap: wrap;
    }

    .inv-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px; max-width: 380px;
    }

    .inv-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }

    .inv-search-input {
        width: 100%; height: 38px; padding: 0 36px 0 12px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .inv-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .inv-search-input::placeholder { color: #b0bcc8; }

    .inv-search-clear {
        position: absolute; left: 10px;
        display: flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        border: none; background: #edf1f7; color: #8899ae; cursor: pointer;
    }
    .inv-search-clear:hover { background: #dde5f0; }

    .inv-cust-filter-wrap {
        position: relative; display: flex; align-items: center;
        min-width: 160px; max-width: 220px;
    }
    .inv-cust-icon {
        position: absolute; right: 12px; color: #9aaabb; pointer-events: none; z-index: 1;
    }
    .inv-cust-select {
        width: 100%; height: 38px; padding: 0 32px 0 10px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none; cursor: pointer;
        -webkit-appearance: none; appearance: none;
        transition: border-color .15s ease;
    }
    .inv-cust-select:focus { border-color: var(--fc-blue); }

    .inv-results-badge {
        display: flex; align-items: center; gap: 5px;
        margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap;
    }
    .inv-results-badge strong { color: #5a6e88; }

    /* ================================================================
       STATUS TABS
    ================================================================ */
    .inv-status-bar {
        padding: 10px 18px; background: #f9fafd;
        border-bottom: 1px solid #edf1f7; overflow-x: auto;
    }

    .inv-status-tabs { display: flex; gap: 4px; padding: 3px; border-radius: 10px; background: #f0f3f8; width: fit-content; }

    .inv-status-tab {
        display: flex; align-items: center; gap: 5px;
        height: 32px; padding: 0 10px;
        border: none; border-radius: 7px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 10.5px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .inv-status-tab:hover:not(.active) { color: var(--fc-text); background: rgba(255,255,255,.6); }
    .inv-status-tab.active {
        background: var(--fc-card); color: var(--fc-text);
        box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800;
    }

    .inv-tab-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 7px; }

    .inv-tab-count {
        min-width: 16px; height: 16px; border-radius: 4px; padding: 0 3px;
        display: flex; align-items: center; justify-content: center;
        font-size: 9px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
    }
    .inv-status-tab.active .inv-tab-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .inv-status-tab:not(.active) .inv-tab-count { background: #e4eaf3; color: #8899ae; }

    /* Dots */
    .itdot-all       { background: var(--fc-blue); }
    .itdot-draft     { background: #9aaabb; }
    .itdot-approved  { background: var(--fc-blue); }
    .itdot-issued    { background: var(--fc-amber); }
    .itdot-sent      { background: var(--fc-purple); }
    .itdot-cancelled { background: var(--fc-red); }

    /* ================================================================
       LOADING / EMPTY
    ================================================================ */
    .inv-loading {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 200px;
        color: var(--fc-muted); font-size: 12px; font-weight: 600;
    }

    .inv-spinner {
        width: 32px; height: 32px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: inv-spin .75s linear infinite;
    }
    @@keyframes inv-spin { to { transform: rotate(360deg); } }

    .inv-empty {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 10px; min-height: 240px; padding: 40px; text-align: center;
    }
    .inv-empty-icon {
        width: 72px; height: 72px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #f0f4fa; color: #b0c4d8;
    }
    .inv-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .inv-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    .inv-add-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; margin-top: 6px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; transition: all .15s ease;
    }
    .inv-add-btn:hover { background: var(--fc-blue); color: #fff; }

    /* ================================================================
       TABLE
    ================================================================ */
    .inv-table-wrap { overflow-x: auto; }

    .inv-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }

    .inv-table thead th {
        padding: 10px 12px;
        background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 10.5px; font-weight: 800;
        text-align: center; border-bottom: 2px solid #e4eaf3;
        white-space: nowrap; position: sticky; top: 0; z-index: 1;
    }
    .inv-table .th-start { text-align: right; }

    .inv-table tbody tr {
        border-bottom: 1px solid #f0f3f8; transition: background .12s ease;
    }
    .inv-table tbody tr:last-child { border-bottom: none; }
    .inv-table tbody tr:hover { background: #fafcff; }
    .inv-table tbody tr.row-cancelled { opacity: .55; }
    .inv-table tbody tr.row-overdue { background: #fffbf5; }

    .inv-table tbody td {
        padding: 11px 12px; color: #526070; text-align: center; vertical-align: middle;
    }
    .td-start { text-align: right !important; }

    /* ── Invoice Cell ── */
    .inv-inv-cell { display: flex; align-items: flex-start; gap: 10px; }

    .inv-avatar {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        color: #fff; box-shadow: 0 2px 6px rgba(0,0,0,.10); margin-top: 2px;
    }

    .av-draft     { background: linear-gradient(135deg, #7a8a9a, #5c6e80); }
    .av-approved  { background: linear-gradient(135deg, #1558d6, #1e6ef5); }
    .av-issued    { background: linear-gradient(135deg, #b87d08, #e09a10); }
    .av-sent      { background: linear-gradient(135deg, #6035a0, #7c4dbd); }
    .av-cancelled { background: linear-gradient(135deg, #b02040, #e03048); }
    .av-returned  { background: linear-gradient(135deg, #0a7a6e, #0d9488); }

    .inv-inv-info { min-width: 0; }

    .inv-code-btn {
        background: none; border: none; padding: 2px 8px;
        border-radius: 6px; cursor: pointer;
        background: #f0f4fa; border: 1px solid #e0e8f4;
        font-size: 10.5px; font-weight: 800; color: var(--fc-blue);
        font-family: "Inter", Arial, sans-serif;
        transition: all .12s ease; display: inline-flex; align-items: center; gap: 5px;
    }
    .inv-code-btn:hover { background: var(--fc-blue); color: #fff; border-color: var(--fc-blue); }

    .inv-credit-tag {
        display: inline-flex; padding: 1px 5px; border-radius: 4px;
        background: var(--fc-amber-lt); color: #9a6d08;
        font-size: 9px; font-weight: 800; border: 1px solid #f0d898;
    }

    .inv-customer-name { font-size: 12px; font-weight: 700; color: #344563; margin-top: 4px; }

    .inv-inv-meta { display: flex; align-items: center; gap: 5px; margin-top: 3px; flex-wrap: wrap; }

    .inv-meta-tag {
        display: inline-flex; padding: 1px 6px; border-radius: 4px;
        font-size: 9.5px; font-weight: 700;
    }
    .tag-ops   { background: rgba(30,110,245,.08); color: var(--fc-blue); border: 1px solid rgba(30,110,245,.15); }
    .tag-items { background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }

    .inv-overdue-tag {
        display: inline-flex; padding: 1px 6px; border-radius: 4px;
        background: var(--fc-amber-lt); color: #9a6d08;
        font-size: 9.5px; font-weight: 800; border: 1px solid #f0d898;
    }

    /* ── Date Cell ── */
    .inv-date-cell { display: flex; flex-direction: column; gap: 3px; align-items: center; }
    .inv-date-issue { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #6b7d95; }
    .inv-date-due   { display: flex; align-items: center; gap: 4px; font-size: 10px; color: #9aaabb; }
    .inv-date-due.due-late { color: var(--fc-red); font-weight: 700; }

    /* ── Amounts Cell ── */
    .inv-amounts-cell { text-align: center; }
    .inv-grand-total {
        font-family: "Inter", Arial, sans-serif;
        font-size: 13px; font-weight: 900; color: var(--fc-text);
    }
    .inv-tax-sub { font-size: 9.5px; color: #9aaabb; margin-top: 2px; }

    /* ── Collection Cell ── */
    .inv-collection-cell { display: flex; flex-direction: column; gap: 6px; align-items: center; }

    .inv-collection-bar {
        width: 80px; height: 6px; border-radius: 5px;
        background: #e4eaf3; overflow: hidden;
    }

    .inv-col-fill {
        height: 100%; border-radius: inherit;
        transition: width .5s ease;
    }
    .col-paid    { background: linear-gradient(90deg, #34d399, #10b981); }
    .col-partial { background: linear-gradient(90deg, #fbbf24, #f59e0b); }
    .col-unpaid  { background: #e4eaf3; width: 0% !important; }

    .inv-collection-nums { display: flex; align-items: center; gap: 6px; }

    .inv-paid-num { font-size: 10px; color: #8899ae; font-weight: 600; font-family: "Inter", Arial, sans-serif; }

    .inv-due-badge {
        display: inline-flex; padding: 2px 7px; border-radius: 6px;
        font-family: "Inter", Arial, sans-serif;
        font-size: 11px; font-weight: 900;
    }
    .due-pos  { background: var(--fc-red-lt);   color: var(--fc-red);   border: 1px solid #ffc8cf; }
    .due-zero { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }

    /* ── Chips ── */
    .inv-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 9px; border-radius: 7px;
        font-size: 10px; font-weight: 800; white-space: nowrap;
    }
    .inv-chip-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; }

    /* Status */
    .chip-s-draft     { background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }
    .chip-s-approved  { background: var(--fc-blue-lt);   color: var(--fc-blue);   border: 1px solid #c0d4fb; }
    .chip-s-issued    { background: var(--fc-amber-lt);  color: #9a6d08;           border: 1px solid #f0d898; }
    .chip-s-sent      { background: var(--fc-purple-lt); color: var(--fc-purple);  border: 1px solid #d0bfef; }
    .chip-s-cancelled { background: var(--fc-red-lt);    color: var(--fc-red);     border: 1px solid #ffc8cf; }
    .chip-s-returned  { background: var(--fc-teal-lt);   color: var(--fc-teal);    border: 1px solid #b0e0dc; }

    .sdot-s-draft     { background: #9aaabb; }
    .sdot-s-approved  { background: var(--fc-blue); }
    .sdot-s-issued    { background: var(--fc-amber); }
    .sdot-s-sent      { background: var(--fc-purple); }
    .sdot-s-cancelled { background: var(--fc-red); }
    .sdot-s-returned  { background: var(--fc-teal); }

    /* Payment */
    .chip-p-unpaid   { background: var(--fc-amber-lt);  color: #9a6d08;          border: 1px solid #f0d898; }
    .chip-p-partial  { background: var(--fc-blue-lt);   color: var(--fc-blue);   border: 1px solid #c0d4fb; }
    .chip-p-paid     { background: var(--fc-green-lt);  color: var(--fc-green);  border: 1px solid #b0e0c5; }
    .chip-p-overpaid { background: var(--fc-purple-lt); color: var(--fc-purple); border: 1px solid #d0bfef; }

    .pdot-unpaid   { background: var(--fc-amber); }
    .pdot-partial  { background: var(--fc-blue); }
    .pdot-paid     { background: var(--fc-green); }
    .pdot-overpaid { background: var(--fc-purple); }

    /* ── Actions ── */
    .inv-actions { display: flex; align-items: center; gap: 2px; justify-content: center; flex-wrap: wrap; }

    .inv-act-btn {
        width: 27px; height: 27px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; cursor: pointer;
        transition: all .15s ease; background: transparent;
    }

    .act-info    { color: var(--fc-blue); }
    .act-approve { color: var(--fc-green); }
    .act-issue   { color: var(--fc-amber); }
    .act-edit    { color: var(--fc-blue); }
    .act-credit  { color: var(--fc-teal); }
    .act-send    { color: var(--fc-purple); }
    .act-print   { color: #6b7d95; }
    .act-cancel  { color: var(--fc-red); }
    .act-delete  { color: var(--fc-red); }

    .act-info:hover    { background: var(--fc-blue-lt);   border-color: #c0d4fb; }
    .act-approve:hover { background: var(--fc-green-lt);  border-color: #b0e0c5; }
    .act-issue:hover   { background: var(--fc-amber-lt);  border-color: #f0d898; }
    .act-edit:hover    { background: var(--fc-blue-lt);   border-color: #c0d4fb; }
    .act-credit:hover  { background: var(--fc-teal-lt);   border-color: #b0e0dc; }
    .act-send:hover    { background: var(--fc-purple-lt); border-color: #d0bfef; }
    .act-print:hover   { background: #f0f3f8; border-color: #dde5f0; }
    .act-cancel:hover  { background: var(--fc-red-lt);    border-color: #ffc8cf; }
    .act-delete:hover  { background: var(--fc-red-lt);    border-color: #ffc8cf; }

    .inv-confirm-del {
        height: 25px; padding: 0 9px;
        border: none; border-radius: 6px;
        background: linear-gradient(135deg, #e03048, #c0182e);
        color: #fff; font-family: inherit;
        font-size: 9.5px; font-weight: 800; cursor: pointer;
        animation: inv-pulse-del 1s ease infinite;
    }
    @@keyframes inv-pulse-del {
        0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.35); }
        50%     { box-shadow: 0 0 0 5px rgba(224,48,72,0); }
    }

    /* ================================================================
       MODALS — BASE
    ================================================================ */
    .inv-modal-backdrop {
        position: fixed; inset: 0; z-index: 9999;
        background: rgba(10,20,40,.60); backdrop-filter: blur(5px);
        display: flex; align-items: center; justify-content: center;
        padding: 20px; animation: inv-fade-in .2s ease;
    }
    @@keyframes inv-fade-in { from { opacity: 0; } to { opacity: 1; } }

    .inv-modal {
        width: 100%; max-width: 620px;
        background: var(--fc-card); border: 1px solid rgba(0,0,0,.08);
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(10,20,50,.18), 0 30px 80px rgba(10,20,50,.22);
        overflow: hidden;
        animation: inv-modal-in .28s cubic-bezier(.34,1.3,.64,1);
        max-height: calc(100vh - 40px);
        display: flex; flex-direction: column;
    }
    .inv-modal-sm { max-width: 480px; }
    .inv-modal-xl { max-width: 820px; }

    @@keyframes inv-modal-in {
        from { opacity: 0; transform: scale(.94) translateY(12px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* STICKY Header */
    .inv-modal-head {
        display: flex; align-items: center; gap: 14px;
        padding: 18px 22px; flex: 0 0 auto;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
        box-shadow: 0 2px 8px rgba(15,41,82,.05);
        position: relative; z-index: 2;
    }

    .inv-modal-icon {
        width: 48px; height: 48px; flex: 0 0 48px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
    }

    .inv-icon-blue  { background: linear-gradient(135deg, #eaf1ff, #dde8ff); color: var(--fc-blue);   border: 1px solid #bdd4fc; }
    .inv-icon-amber { background: linear-gradient(135deg, #fff8e6, #ffefc0); color: #9a6d08;           border: 1px solid #f0d898; }
    .inv-icon-green { background: linear-gradient(135deg, #e9f8f0, #d4f0e0); color: var(--fc-green);  border: 1px solid #b0e0c5; }

    /* Detail icon classes */
    .inv-det-draft     { background: linear-gradient(135deg, #f0f3f8, #e4eaf3); color: #6b7d95; border: 1px solid #dde5f0; }
    .inv-det-approved  { background: linear-gradient(135deg, #eaf1ff, #dde8ff); color: var(--fc-blue); border: 1px solid #bdd4fc; }
    .inv-det-issued    { background: linear-gradient(135deg, #fff8e6, #ffefc0); color: #9a6d08; border: 1px solid #f0d898; }
    .inv-det-sent      { background: linear-gradient(135deg, #f3eeff, #e8dfff); color: var(--fc-purple); border: 1px solid #d0bfef; }
    .inv-det-cancelled { background: linear-gradient(135deg, #fff0f2, #ffe8ec); color: var(--fc-red); border: 1px solid #ffc8cf; }

    .inv-modal-title { font-size: 15px; font-weight: 900; color: #1c2b43; }
    .inv-modal-sub   { font-size: 10.5px; color: var(--fc-muted); margin-top: 2px; }

    .inv-modal-close {
        margin-right: auto; width: 34px; height: 34px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid #e4eaf2; border-radius: 9px;
        background: none; color: #9aaabb; cursor: pointer;
        transition: all .15s ease;
    }
    .inv-modal-close:hover { background: #f0f4fa; color: var(--fc-text); border-color: #c0ccd8; }

    .inv-modal-banner {
        display: flex; align-items: center; justify-content: space-between;
        gap: 10px; padding: 10px 22px; font-size: 12px; font-weight: 600;
        flex: 0 0 auto;
    }
    .inv-modal-banner button { background: none; border: none; cursor: pointer; opacity: .6; }
    .banner-success { background: #e9f8f0; color: #0e7a43; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); }

    /* SCROLLABLE Body */
    .inv-modal-body {
        padding: 20px 22px;
        overflow-y: auto; flex: 1 1 auto; min-height: 0;
    }

    /* STICKY Footer */
    .inv-modal-foot {
        display: flex; align-items: center; justify-content: flex-end; gap: 10px;
        padding: 14px 22px; flex: 0 0 auto;
        background: linear-gradient(180deg, #fafbfd 0%, #f4f6fb 100%);
        border-top: 1px solid #edf1f7;
        position: relative; z-index: 2;
    }

    .inv-modal-cancel {
        height: 40px; padding: 0 18px;
        border: 1px solid var(--fc-border); border-radius: 10px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .inv-modal-cancel:hover { background: #f0f4fa; color: var(--fc-text); }

    .inv-modal-save {
        display: inline-flex; align-items: center; gap: 7px;
        height: 40px; padding: 0 20px;
        border: 0; border-radius: 10px;
        color: #fff; font-family: inherit;
        font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .inv-modal-save:hover:not(:disabled) { transform: translateY(-1px); }
    .inv-modal-save:disabled { opacity: .6; cursor: not-allowed; }

    .save-blue  { background: linear-gradient(135deg, #1e6ef5, #1558d6); box-shadow: 0 4px 14px rgba(30,110,245,.28); }
    .save-amber { background: linear-gradient(135deg, #e09a10, #c07d08); box-shadow: 0 4px 14px rgba(224,154,16,.28); }
    .save-green { background: linear-gradient(135deg, #16a35b, #0d8a48); box-shadow: 0 4px 14px rgba(22,163,91,.28); }

    /* ================================================================
       MODAL — Form Fields
    ================================================================ */
    .inv-form-section {
        margin-bottom: 20px; padding-bottom: 20px;
        border-bottom: 1px solid #edf1f7;
    }
    .inv-form-section:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

    .inv-section-title {
        display: flex; align-items: center; gap: 7px;
        font-size: 12.5px; font-weight: 800; color: #344258;
        margin-bottom: 14px;
    }

    .inv-items-count {
        min-width: 22px; height: 20px; border-radius: 5px; padding: 0 5px;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-size: 10px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
        border: 1px solid #c0d4fb;
    }

    .inv-items-total {
        margin-right: auto; font-size: 12px; font-weight: 800; color: var(--fc-green);
    }

    .inv-modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    .inv-mfield { display: flex; flex-direction: column; gap: 5px; }

    .inv-mlabel {
        font-size: 11.5px; font-weight: 800; color: #344258;
        display: flex; align-items: center; gap: 3px;
    }
    .inv-mrequired { color: var(--fc-red); font-size: 13px; }

    .inv-minput {
        height: 42px; width: 100%;
        border: 1.5px solid #d8e2f0; border-radius: 10px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 13px; padding: 0 12px;
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .inv-minput:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); background: #fff; }
    .inv-minput::placeholder { color: #b0bcc8; }

    .inv-mselect-wrap { position: relative; }
    .inv-msel-icon {
        position: absolute; right: 13px; top: 50%; transform: translateY(-50%);
        color: #9aaabb; pointer-events: none; z-index: 1;
    }
    .inv-msel { padding-right: 36px; cursor: pointer; -webkit-appearance: none; appearance: none; }

    .inv-mfield-group { position: relative; display: flex; align-items: center; }
    .inv-mprefix {
        position: absolute; right: 13px;
        display: flex; align-items: center;
        color: #9aaabb; pointer-events: none; z-index: 1;
        font-size: 11px; font-weight: 700;
    }
    .inv-minput.with-prefix { padding-right: 36px; }

    .inv-mhint { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--fc-muted); font-weight: 500; }

    /* Manual grid */
    .inv-manual-grid {
        display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr auto; gap: 10px; align-items: end;
    }

    .inv-add-line-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 5px;
        height: 42px; padding: 0 14px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 12px; font-weight: 800; cursor: pointer; white-space: nowrap;
        box-shadow: 0 3px 10px rgba(30,110,245,.25);
        transition: all .15s ease;
    }
    .inv-add-line-btn:hover { transform: translateY(-1px); }

    /* Items Table */
    .inv-items-table-wrap { overflow-x: auto; }

    .inv-items-table { width: 100%; border-collapse: collapse; font-size: 12px; }

    .inv-items-table thead th {
        padding: 8px 10px;
        background: linear-gradient(180deg, #f5f8ff, #eef4ff);
        color: #4a5a74; font-size: 10px; font-weight: 800;
        text-align: center; border-bottom: 1px solid #dce8f5;
    }

    .inv-items-table tbody tr { border-bottom: 1px solid #f0f5fb; }
    .inv-items-table tbody tr:hover { background: #f8faff; }

    .inv-items-table tbody td { padding: 8px 10px; text-align: center; vertical-align: middle; }

    .td-desc { text-align: right !important; min-width: 160px; }
    .td-num  { color: #6b7d95; font-family: "Inter", Arial, sans-serif; }
    .td-price { color: #6b7d95; font-family: "Inter", Arial, sans-serif; }
    .td-total { font-family: "Inter", Arial, sans-serif; font-size: 13px; font-weight: 900; color: var(--fc-text); }

    .credit-total     { color: var(--fc-red) !important; }
    .credit-total-val { color: var(--fc-red) !important; }

    .item-desc { font-size: 12px; font-weight: 700; color: #1c2c44; }
    .item-op-tag {
        display: inline-flex; margin-top: 2px; padding: 1px 6px; border-radius: 4px;
        background: rgba(30,110,245,.08); color: var(--fc-blue);
        font-size: 9px; font-weight: 700; border: 1px solid rgba(30,110,245,.15);
    }

    .inv-cell-input {
        height: 32px; width: 100%;
        border: 1px solid #d8e2f0; border-radius: 6px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; padding: 0 8px; outline: none;
        transition: border-color .12s ease;
    }
    .inv-cell-input:focus { border-color: var(--fc-blue); }

    .inv-cell-select {
        height: 32px; width: 100%;
        border: 1px solid #d8e2f0; border-radius: 6px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 11px; padding: 0 4px; outline: none; cursor: pointer;
        -webkit-appearance: none; appearance: none;
    }

    .inv-del-line {
        width: 26px; height: 26px; border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; background: transparent;
        color: var(--fc-red); cursor: pointer; transition: all .12s ease;
    }
    .inv-del-line:hover { background: var(--fc-red-lt); border-color: #ffc8cf; }

    .inv-items-empty {
        padding: 24px; text-align: center;
        color: #9aaabb; font-size: 12px; font-weight: 600;
        border: 1px dashed #e4eaf3; border-radius: 10px; background: #f9fafc;
    }

    .items-total-row td { background: linear-gradient(180deg, #f0f5fc, #eaf1f9); border-top: 2px solid #dce8f5; }
    .total-label { text-align: right !important; font-size: 11px; font-weight: 800; color: #344258; padding: 10px; }
    .total-val {
        font-family: "Inter", Arial, sans-serif;
        font-size: 14px; font-weight: 900; color: var(--fc-blue);
    }

    /* ================================================================
       MODAL — Channel Toggle (Send)
    ================================================================ */
    .inv-channel-group { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }

    .inv-channel-btn {
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        padding: 12px 8px; border: 2px solid #d8e2f0; border-radius: 12px;
        background: #fafcff; color: var(--fc-muted);
        font-family: inherit; font-size: 10.5px; font-weight: 700; cursor: pointer;
        transition: all .18s ease;
    }
    .inv-channel-btn span:first-child { font-size: 22px; }
    .inv-channel-btn:hover:not(.channel-active) { border-color: #b0c4e0; color: var(--fc-text); }

    .channel-active {
        border-color: var(--fc-purple) !important;
        background: var(--fc-purple-lt) !important;
        color: var(--fc-purple) !important;
        box-shadow: 0 0 0 3px rgba(124,77,189,.10);
    }

    /* ================================================================
       MODAL DETAIL — Specific
    ================================================================ */
    .inv-detail-header { box-shadow: 0 2px 10px rgba(15,41,82,.06); }

    .inv-detail-meta {
        display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
        margin-top: 4px;
    }

    .inv-detail-meta-tag {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 2px 8px; border-radius: 6px;
        background: rgba(255,255,255,.7); border: 1px solid #e4eaf3;
        font-size: 10px; font-weight: 700; color: #5a6e88;
    }

    .inv-detail-body { padding: 20px 22px; overflow-y: auto; flex: 1 1 auto; min-height: 0; }

    .inv-credit-badge {
        display: inline-flex; padding: 3px 10px; border-radius: 7px;
        background: var(--fc-amber-lt); color: #9a6d08;
        font-size: 10.5px; font-weight: 800; border: 1px solid #f0d898;
    }

    /* Summary Cards */
    .inv-detail-summary {
        display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px;
        margin-bottom: 16px;
    }

    .inv-detail-card {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 14px; border-radius: 12px;
        background: #f5f7fa; border: 1px solid #e4eaf3;
        transition: all .15s ease;
    }
    .inv-detail-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(15,41,82,.06); }
    .inv-detail-card.card-grand { background: var(--fc-blue-lt); border-color: #c0d4fb; }
    .inv-detail-card.card-due   { background: var(--fc-red-lt);  border-color: #ffc8cf; }
    .inv-detail-card.card-paid  { background: var(--fc-green-lt); border-color: #b0e0c5; }

    .detail-card-ring {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
    }

    .ring-subtotal { background: #f0f3f8; color: var(--fc-text); border: 1px solid #dde5f0; }
    .ring-discount { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }
    .ring-tax      { background: var(--fc-purple-lt); color: var(--fc-purple); border: 1px solid #d0bfef; }
    .ring-grand    { background: var(--fc-blue-lt); color: var(--fc-blue); border: 1px solid #c0d4fb; }
    .ring-due      { background: var(--fc-red-lt);   color: var(--fc-red);   border: 1px solid #ffc8cf; }
    .ring-paid     { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }

    .detail-card-label { font-size: 9.5px; color: #8899ae; font-weight: 600; }
    .detail-card-val {
        font-family: "Inter", Arial, sans-serif;
        font-size: 15px; font-weight: 900; color: var(--fc-text);
    }
    .discount-val { color: var(--fc-amber) !important; }
    .grand-val    { color: var(--fc-blue) !important; }
    .due-val      { color: var(--fc-red) !important; }
    .paid-val     { color: var(--fc-green) !important; }

    /* Progress */
    .inv-detail-progress {
        margin-bottom: 16px; padding: 12px 14px; border-radius: 10px;
        background: linear-gradient(135deg, #f5f8ff, #eef4ff);
        border: 1px solid #c8d8fb;
        display: flex; flex-direction: column; gap: 8px;
    }

    .inv-det-prog-bar {
        height: 10px; border-radius: 6px; background: #e4eaf3; overflow: hidden;
    }

    .inv-det-prog-fill {
        height: 100%; border-radius: inherit; transition: width .5s ease;
    }
    .fill-paid    { background: linear-gradient(90deg, #34d399, #10b981); }
    .fill-partial { background: linear-gradient(90deg, #fbbf24, #f59e0b); }

    .inv-det-prog-labels {
        display: flex; justify-content: space-between;
        font-size: 10.5px; color: #6b7d95; font-weight: 600;
    }

    /* Credit Notice */
    .inv-credit-notice {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 14px; border-radius: 10px;
        background: var(--fc-blue-lt); border: 1px solid #bdd4fc;
        font-size: 12px; font-weight: 600; color: var(--fc-blue);
        margin-bottom: 16px;
    }

    /* Detail Sections */
    .inv-detail-section { margin-bottom: 18px; }

    .inv-detail-section-head {
        display: flex; align-items: center; gap: 10px;
        padding-bottom: 10px; border-bottom: 1px solid #edf1f7; margin-bottom: 12px;
    }

    .inv-det-sec-title {
        display: flex; align-items: center; gap: 7px;
        font-size: 12.5px; font-weight: 800; color: #1c2b43; flex: 1;
    }

    .inv-det-sec-count {
        min-width: 20px; height: 20px; border-radius: 5px; padding: 0 4px;
        display: flex; align-items: center; justify-content: center;
        background: #f0f3f8; color: #6b7d95;
        font-size: 10px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
    }

    /* Ops Tags */
    .inv-detail-ops-list { display: flex; gap: 6px; flex-wrap: wrap; }

    .inv-op-tag {
        display: inline-flex; padding: 4px 10px; border-radius: 7px;
        background: rgba(30,110,245,.08); color: var(--fc-blue);
        font-size: 11px; font-weight: 800; border: 1px solid rgba(30,110,245,.15);
    }

    /* Allocations */
    .inv-alloc-list { display: flex; flex-direction: column; gap: 6px; }

    .inv-alloc-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 8px 12px; border-radius: 8px;
        background: var(--fc-green-lt); border: 1px solid #b0e0c5;
    }

    .inv-alloc-num { font-size: 11px; font-weight: 800; color: #344258; font-family: "Inter", Arial, sans-serif; }
    .inv-alloc-amount { font-size: 13px; font-weight: 900; color: var(--fc-green); font-family: "Inter", Arial, sans-serif; }

    /* Notes */
    .inv-detail-notes {
        font-size: 12.5px; color: var(--fc-text); line-height: 1.6;
        padding: 12px 14px; border-radius: 10px;
        background: #f5f7fa; border: 1px solid #e4eaf3;
    }

    /* Spinner */
    .btn-spinner {
        width: 15px; height: 15px;
        border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
        border-radius: 50%; animation: inv-spin .7s linear infinite;
    }
    .btn-spinner.sm { width: 13px; height: 13px; }

    /* ================================================================
       RESPONSIVE
    ================================================================ */
    @@media (max-width: 1100px) {
        .inv-detail-summary { grid-template-columns: repeat(3, 1fr); }
    }

    @@media (max-width: 900px) {
        .inv-toolbar { flex-direction: column; align-items: stretch; }
        .inv-search-wrap { max-width: 100%; }
        .inv-cust-filter-wrap { max-width: 100%; }
        .inv-results-badge { margin-right: 0; }
        .inv-modal-grid { grid-template-columns: 1fr; }
        .inv-manual-grid { grid-template-columns: 1fr 1fr; }
        .inv-detail-summary { grid-template-columns: repeat(2, 1fr); }
        .inv-channel-group { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 680px) {
        .inv-body { padding: 10px 12px 24px; }
        .inv-toolbar { padding: 10px 12px; }
        .inv-avatar { display: none; }
        .inv-status-bar { padding: 8px 12px; }
        .inv-detail-summary { grid-template-columns: repeat(2, 1fr); }
        .inv-manual-grid { grid-template-columns: 1fr; }
        .inv-modal-backdrop { padding: 10px; }
        .inv-modal { border-radius: 16px; }
    }

    @@media (max-width: 480px) {
        .inv-status-tabs { flex-wrap: wrap; }
        .inv-status-tab { padding: 0 7px; font-size: 9.5px; }
        .inv-tab-dot { display: none; }
        .inv-detail-summary { grid-template-columns: 1fr 1fr; }
        .inv-channel-group { grid-template-columns: repeat(2, 1fr); }
    }

