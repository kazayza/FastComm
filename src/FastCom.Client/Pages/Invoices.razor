        "Returned"  => "inv-chip-dot sdot-s-returned",
        _           => "inv-chip-dot sdot-s-draft"
    };

    private static string StatusDotColor(string s) => s switch
    {
        "all"       => "itdot-all",
        "Draft"     => "itdot-draft",
        "Approved"  => "itdot-approved",
        "Issued"    => "itdot-issued",
        "Sent"      => "itdot-sent",
        "Cancelled" => "itdot-cancelled",
        _           => "itdot-all"
    };

    private static string InvAvatarClass(string s) => s switch
    {
        "Draft"     => "av-draft",
        "Approved"  => "av-approved",
        "Issued"    => "av-issued",
        "Sent"      => "av-sent",
        "Cancelled" => "av-cancelled",
        "Returned"  => "av-returned",
        _           => "av-draft"
    };

    private static string DetailIconClass(string s) => s switch
    {
        "Draft"     => "inv-modal-icon inv-det-draft",
        "Approved"  => "inv-modal-icon inv-det-approved",
        "Issued"    => "inv-modal-icon inv-det-issued",
        "Sent"      => "inv-modal-icon inv-det-sent",
        "Cancelled" => "inv-modal-icon inv-det-cancelled",
        _           => "inv-modal-icon inv-det-draft"
    };

    private static string PayAr(string p) => p switch
    {
        "Unpaid"        => "غير مدفوع",
        "PartiallyPaid" => "جزئي",
        "Paid"          => "مدفوع",
        "Overpaid"      => "زيادة",
        _               => p
    };

    private static string PayChipClass(string p) => p switch
    {
        "Unpaid"        => "inv-chip chip-p-unpaid",
        "PartiallyPaid" => "inv-chip chip-p-partial",
        "Paid"          => "inv-chip chip-p-paid",
        "Overpaid"      => "inv-chip chip-p-overpaid",
        _               => "inv-chip chip-p-unpaid"
    };

    private static string PayDotClass(string p) => p switch
    {
