@code {
    private AuthUser? _user;
    private bool CanView    => _user?.Can("INVOICE.VIEW")       ?? false;
    private bool CanCreate  => _user?.Can("INVOICE.CREATE")     ?? false;
    private bool CanEdit    => _user?.Can("INVOICE.EDIT")       ?? false;
    private bool CanApprove => _user?.Can("INVOICE.APPROVE")    ?? false;
    private bool CanIssue   => _user?.Can("INVOICE.ISSUE")      ?? false;
    private bool CanCancel  => _user?.Can("INVOICE.CANCEL")     ?? false;
    private bool CanCredit  => _user?.Can("INVOICE.CREDITNOTE") ?? false;
    private bool CanDelete  => _user?.Can("INVOICE.DELETE")     ?? false;
    private bool CanSend    => _user?.Can("INVOICE.SEND")       ?? false;
    private bool CanPrint   => _user?.Can("INVOICE.PRINT")      ?? false;

    private static readonly (string Key, string Value)[] _statusTabs =
    {
        ("all",       "الكل"),
        ("Draft",     "مسودة"),
        ("Approved",  "معتمدة"),
        ("Issued",    "مصدّرة"),
        ("Sent",      "مُرسلة"),
        ("Cancelled", "ملغية")
    };

    private List<Item>  _items     = new();
    private List<Cust>  _customers = new();
    private List<OpRef> _ops       = new();
    private List<Svc>   _services  = new();
    private List<Tax>   _taxRates  = new();

    private bool   _loading;
    private string _search     = "";
    private string _tab        = "all";
    private int    _custFilter;
    private long?  _confirmId;
    private bool   _saving;
    private string? _msg;
    private bool   _ok;

    private bool    _modalOpen;   private long? _editId; private Form _f = new(); private LineForm _manual = new();
    /* بيُقرأ كقيمة الـ select بس — القيمة بتتغيّر عن طريق OnPickOp، مش بإسناد مباشر. */
#pragma warning disable CS0649
    private long    _pickOp;
#pragma warning restore CS0649
    private bool    _creditOpen;  private Item? _creditOriginal; private CreditForm _cf = new();
    private bool    _detailOpen;  private Envelope? _detail;
    private bool    _sendOpen;    private Item? _sendTarget; private SendForm _sf = new();

    /* ── DTOs ── */
    public class SendForm { public string Channel { get; set; } = "Manual"; public string? Recipient { get; set; } }
    public class Cust  { public int Id { get; set; } public string Label { get; set; } = ""; public string Code { get; set; } = ""; public int? PaymentTermId { get; set; } }
    public class Svc   { public int Id { get; set; } public string Label { get; set; } = ""; public string Unit { get; set; } = ""; public int? TaxRateId { get; set; } }
    public class Tax   { public int Id { get; set; } public string Label { get; set; } = ""; public decimal Rate { get; set; } }
    public class OpRef { public long OperationId { get; set; } public string OperationNumber { get; set; } = ""; public string CustomerName { get; set; } = ""; public decimal RevenueNet { get; set; } public string? InvoiceNumber { get; set; } }

    public class Item
    {
        public long    InvoiceId        { get; set; }
        public string  InvoiceNumber    { get; set; } = "";
        public string  DocumentTypeCode { get; set; } = "";
        public string  CustomerName     { get; set; } = "";
        public DateOnly InvoiceDate     { get; set; }
        public DateOnly? DueDate        { get; set; }
        public decimal SubTotal         { get; set; }
        public decimal TaxTotal         { get; set; }
        public decimal GrandTotal       { get; set; }
        public decimal PaidAmount       { get; set; }
        public decimal Due              { get; set; }
        public string  Status           { get; set; } = "";
        public string  PaymentStatus    { get; set; } = "";
        public int     ItemsCount       { get; set; }
        public int     OperationsCount  { get; set; }
    }

    public class LineForm
    {
        public long?   OperationId     { get; set; }
        public string? OperationNumber { get; set; }
        public int?    ServiceId       { get; set; }
        public long?   PriceRuleId     { get; set; }
        public string  Description     { get; set; } = "";
        public decimal Quantity        { get; set; } = 1;
        public decimal UnitPrice       { get; set; }
        public decimal Discount        { get; set; }
        public int?    TaxRateId       { get; set; }
    }

    public class LineOut
    {
        public long    InvoiceItemId   { get; set; }
        public long?   OperationId     { get; set; }
        public string? OperationNumber { get; set; }
        public int?    ServiceId       { get; set; }
        public string  Description     { get; set; } = "";
        public decimal Quantity        { get; set; }
        public decimal UnitPrice       { get; set; }
        public decimal Discount        { get; set; }
        public int?    TaxRateId       { get; set; }
        public decimal TaxRate         { get; set; }
        public decimal LineSubtotal    { get; set; }
        public decimal LineTax         { get; set; }
        public decimal LineTotal       { get; set; }

        public LineForm ToForm() => new()
        {
            OperationId = OperationId, OperationNumber = OperationNumber, ServiceId = ServiceId,
            Description = Description, Quantity = Quantity, UnitPrice = UnitPrice,
            Discount = Discount, TaxRateId = TaxRateId
        };
    }

    public class Detail
    {
        public long    InvoiceId              { get; set; }
        public string  InvoiceNumber          { get; set; } = "";
        public string  DocumentTypeCode       { get; set; } = "";
        public string  InvoiceType            { get; set; } = "";
        public int     CustomerId             { get; set; }
        public string  CustomerName           { get; set; } = "";
        public string? CustomerTaxNumber      { get; set; }
        public string? InvoiceDate            { get; set; }
        public string? DueDate                { get; set; }
        public decimal SubTotal               { get; set; }
        public decimal DiscountTotal          { get; set; }
        public decimal TaxTotal               { get; set; }
        public decimal GrandTotal             { get; set; }
        public decimal PaidAmount             { get; set; }
        public decimal Due                    { get; set; }
        public string  Status                 { get; set; } = "";
        public string  PaymentStatus          { get; set; } = "";
        public string? Notes                  { get; set; }
        public string? OriginalInvoiceNumber  { get; set; }
        public DateTime? IssuedAt             { get; set; }
        public string  CurrencyCode           { get; set; } = "EGP";
    }

    public class OpOut   { public long OperationId { get; set; } public string OperationNumber { get; set; } = ""; }
    public class Alloc   { public long PaymentId { get; set; } public string PaymentNumber { get; set; } = ""; public decimal AllocatedAmount { get; set; } public decimal InvoiceTotal { get; set; } public decimal InvoicePaid { get; set; } }

    public class Envelope
    {
        public Detail         Invoice     { get; set; } = new();
        public List<LineOut>  Items       { get; set; } = new();
        public List<OpOut>    Operations  { get; set; } = new();
        public List<Alloc>    Allocations { get; set; } = new();
    }

    public class Form
    {
        public int     CustomerId  { get; set; }
        public string? InvoiceDate { get; set; }
        public string? DueDate     { get; set; }
        public string? Notes       { get; set; }
        public List<LineForm> Items { get; set; } = new();
    }

    public class CreditForm
    {
        public long   OriginalInvoiceId { get; set; }
        public string? ReasonCode       { get; set; }
        public string? InvoiceDate      { get; set; }
        public string? Notes            { get; set; }
        public List<LineForm> Items     { get; set; } = new();
    }

    /* ── Computed ── */
    private decimal RateOf(int id)  => _taxRates.FirstOrDefault(t => t.Id == id)?.Rate ?? 0m;

    private decimal LineTotal(LineForm l) =>
        (l.Quantity * l.UnitPrice - l.Discount) *
        (1 + (l.TaxRateId is null ? 0m : RateOf(l.TaxRateId.Value)) / 100m);

    private decimal FormTotal   => _f.Items.Sum(LineTotal);
    private decimal CreditTotal => _cf.Items.Sum(LineTotal);

    private IEnumerable<Item> Active => _items.Where(i => i.Status != "Cancelled");

    private decimal OpenDue => Active.Where(i => i.Status != "Draft").Sum(i => i.Due);

    private IEnumerable<Item> Overdue => Active.Where(i =>
        i.DueDate is not null && i.DueDate.Value < DateOnly.FromDateTime(DateTime.Now) &&
        i.PaymentStatus != "Paid" && i.Status is "Issued" or "Sent");

    private decimal ThisMonth => _items
        .Where(i => i.Status != "Cancelled" && i.Status != "Draft" &&
                    i.InvoiceDate.Year == DateTime.Now.Year && i.InvoiceDate.Month == DateTime.Now.Month)
        .Sum(i => i.GrandTotal);

    private IEnumerable<Item> Filtered => _items.Where(i =>
        (_tab == "all" || i.Status == _tab) &&
        (_custFilter == 0 || i.CustomerName == _customers.FirstOrDefault(c => c.Id == _custFilter)?.Label) &&
        (string.IsNullOrWhiteSpace(_search) ||
         i.InvoiceNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         i.CustomerName.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    /* ── Helpers ── */
    private static string StatusAr(string s) => s switch
    {
        "Draft"     => "مسودة",   "Approved"  => "معتمدة",
        "Issued"    => "مصدّرة",  "Sent"      => "مُرسلة",
        "Cancelled" => "ملغية",   "Returned"  => "مرتجعة", _ => s
    };

    private static string StatusChipClass(string s) => s switch
    {
        "Draft"     => "inv-chip chip-s-draft",
        "Approved"  => "inv-chip chip-s-approved",
        "Issued"    => "inv-chip chip-s-issued",
        "Sent"      => "inv-chip chip-s-sent",
        "Cancelled" => "inv-chip chip-s-cancelled",
