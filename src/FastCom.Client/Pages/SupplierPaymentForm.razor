@code {
    private AuthUser? _user;
    private bool CanSave => _user?.Can("SUPPLIER.CREATE") ?? false;

    private bool _loading = true;
    private bool _saving;
    private bool _openLoading;
    private bool _ok = true;
    private bool _fabOpen;
    private int  _activeTab = 0;
    private string? _msg;
    private Form _f = new();

    private List<Opt> _suppliers = new();
    private List<Opt> _filteredSuppliers = new();
    private List<Opt> _branches = new();
    private List<Method> _methods = new();
    private List<OpenInv> _open = new();

    private string _supplierSearch = "";
    private bool _showSupplierDropdown;
    private int _focusedSupplierIndex = -1;
    private bool _triedSave;

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    public class Method
    {
        public int Id { get; set; }
        public string Label { get; set; } = "";
        public string Code { get; set; } = "";
        public bool RequiresChequeNo { get; set; }
        public bool IsCashBased { get; set; }
    }

    public class OpenInv
    {
        public long SupplierInvoiceId { get; set; }
        public string SupplierInvoiceNumber { get; set; } = "";
        public string InvoiceDate { get; set; } = "";
        public string Status { get; set; } = "";
        public string PaymentStatus { get; set; } = "";
        public decimal GrandTotal { get; set; }
        public decimal PaidAmount { get; set; }
    }

    public class Form
    {
        public int SupplierId { get; set; }
        public int BranchId { get; set; }
        public string? PaymentDate { get; set; }
        public int PaymentMethodId { get; set; }
        public decimal Amount { get; set; }
        public string? ChequeNumber { get; set; }
        public string? ChequeDate { get; set; }
        public string? BankAccount { get; set; }
        public string? Notes { get; set; }
    }

    private Method? SelectedMethod =>
        _methods.FirstOrDefault(m => m.Id == _f.PaymentMethodId);

    private bool HasTabError(int tab) => _triedSave && tab switch
    {
        1 => _f.SupplierId == 0 || _f.BranchId == 0 || _f.PaymentMethodId == 0 || _f.Amount <= 0 || string.IsNullOrWhiteSpace(_f.PaymentDate),
        _ => false
    };

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanSave) { _loading = false; return; }

        _f.PaymentDate = DateTime.Today.ToString("yyyy-MM-dd");

        _suppliers = await SafeOpts("api/options/suppliers");
        _branches  = await SafeOpts("api/options/branches");

        try { _methods = await Http.GetFromJsonAsync<List<Method>>("api/options/payment-methods") ?? new(); }
        catch { _methods = new(); }

        if (_branches.Count == 1) _f.BranchId = _branches[0].Id;
        _loading = false;
    }

    private async Task<List<Opt>> SafeOpts(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Opt>>(url) ?? new(); }
        catch { return new(); }
    }

    /* ── Autocomplete Search Mappings ── */
    private void OnSupplierSearch(ChangeEventArgs e)
    {
        _supplierSearch = e.Value?.ToString() ?? "";
        _showSupplierDropdown = true;
        _focusedSupplierIndex = -1;
        FilterSuppliers(_supplierSearch);
    }

    private void FilterSuppliers(string search)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            _filteredSuppliers = _suppliers.Take(20).ToList();
            return;
        }

        var normalized = NormalizeArabic(search.Trim());
        _filteredSuppliers = _suppliers
            .Where(s => NormalizeArabic(s.Label).Contains(normalized))
            .Take(20)
            .ToList();
    }

    private async Task OnSupplierInputKeyDown(KeyboardEventArgs e)
    {
        if (!_showSupplierDropdown || !_filteredSuppliers.Any())
        {
            if (e.Key == "ArrowDown") _showSupplierDropdown = true;
            return;
        }

        if (e.Key == "ArrowDown")
            _focusedSupplierIndex = (_focusedSupplierIndex + 1) % _filteredSuppliers.Count;
        else if (e.Key == "ArrowUp")
            _focusedSupplierIndex = _focusedSupplierIndex <= 0 ? _filteredSuppliers.Count - 1 : _focusedSupplierIndex - 1;
        else if (e.Key == "Enter")
        {
            if (_focusedSupplierIndex >= 0 && _focusedSupplierIndex < _filteredSuppliers.Count)
                await PickSupplier(_filteredSuppliers[_focusedSupplierIndex]);
        }
        else if (e.Key == "Escape")
        {
            _showSupplierDropdown = false;
            _focusedSupplierIndex = -1;
        }
    }

    private void OnSupplierInputFocus()
    {
        _showSupplierDropdown = true;
        _focusedSupplierIndex = -1;
        FilterSuppliers(_supplierSearch);
    }

    private async Task OnSupplierInputBlur()
    {
        await Task.Delay(200);
        _showSupplierDropdown = false;

        if (_f.SupplierId > 0)
        {
            var current = _suppliers.FirstOrDefault(s => s.Id == _f.SupplierId);
            if (current != null) _supplierSearch = current.Label;
        }
        else
        {
            _supplierSearch = "";
        }
    }

    private async Task PickSupplier(Opt s)
    {
        _f.SupplierId = s.Id;
        _supplierSearch = s.Label;
        _showSupplierDropdown = false;
        _focusedSupplierIndex = -1;
        await SupplierChanged();
        StateHasChanged();
    }

    private void ClearSupplierSelection()
    {
        _f.SupplierId = 0;
        _supplierSearch = "";
        _focusedSupplierIndex = -1;
        _filteredSuppliers = _suppliers.Take(20).ToList();
        _open.Clear();
    }

    private static string NormalizeArabic(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;

        string[] diacritics = new[] { "َ", "ُ", "ِ", "ّ", "ً", "ٌ", "ٍ", "ْ", "ـ" };
        foreach (var d in diacritics)
            s = s.Replace(d, "");

        return s
            .Replace('أ', 'ا').Replace('إ', 'ا').Replace('آ', 'ا').Replace('ٱ', 'ا').Replace('ء', 'ا')
            .Replace('ة', 'ه')
            .Replace('ى', 'ي')
            .Replace('ؤ', 'و')
            .Replace('ئ', 'ي')
            .Replace("  ", " ")
            .ToLowerInvariant()
            .Trim();
    }

    private async Task SupplierChanged()
    {
        _open.Clear();
        if (_f.SupplierId <= 0) return;
        _openLoading = true;
        try
        {
            var all = await Http.GetFromJsonAsync<List<OpenInv>>(
                $"api/supplier-invoices?supplierId={_f.SupplierId}") ?? new();

            _open = all.Where(i => i.Status != "Draft" && i.Status != "Cancelled"
                                && i.PaymentStatus != "Paid")
                       .OrderBy(i => i.InvoiceDate).ThenBy(i => i.SupplierInvoiceId)
                       .ToList();
        }
        catch (Exception ex) { Snackbar.Add("فشل تحميل الفواتير المفتوحة: " + ex.Message, Severity.Error); }
        finally { _openLoading = false; }
    }

    private async Task SaveAsync()
    {
        _triedSave = true;
        _msg = null;

        if (_f.SupplierId <= 0)      { _ok = false; _msg = "يرجى اختيار المورد أولاً"; _activeTab = 0; return; }
        if (_f.BranchId <= 0)        { _ok = false; _msg = "يرجى اختيار الفرع المالي"; _activeTab = 0; return; }
        if (_f.PaymentMethodId <= 0) { _ok = false; _msg = "يرجى تحديد طريقة الدفع"; _activeTab = 0; return; }
        if (_f.Amount <= 0)          { _ok = false; _msg = "يجب أن تكون قيمة الدفعة أكبر من صفر"; _activeTab = 0; return; }
        if (string.IsNullOrWhiteSpace(_f.PaymentDate)) { _ok = false; _msg = "تاريخ الصرف مطلوب"; _activeTab = 0; return; }

        _saving = true; 
        try
        {
            var payload = new
            {
                supplierId      = _f.SupplierId,
                branchId        = _f.BranchId,
                paymentDate     = _f.PaymentDate,
                paymentMethodId = _f.PaymentMethodId,
                amount          = _f.Amount,
                chequeNumber    = _f.ChequeNumber,
                chequeDate      = _f.ChequeDate,
                bankAccount     = _f.BankAccount,
                notes           = _f.Notes
            };
            var res = await Http.PostAsJsonAsync("api/supplier-payments", payload);
            _msg = await MsgOf(res); 
            _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل في تسجيل السند: " + ex.Message; }
        finally { _saving = false; }
    }

    private void GoBack() => Nav.NavigateTo("/supplier-payments");
    private void ToggleFab() => _fabOpen = !_fabOpen;

    private static string? OptStr(object? v)
    {
        var s = v?.ToString();
        return string.IsNullOrWhiteSpace(s) ? null : s;
    }

    private static decimal ParseDec(object? v) =>
        decimal.TryParse(v?.ToString(), out var d) ? d : 0m;

    private static string Money(decimal v) => v.ToString("N2");

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم الحفظ بنجاح" : $"حدث خطأ {(int)res.StatusCode}"; }
    }
}