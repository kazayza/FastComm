    .spf-mud-tabs .mud-tab { font-family: "Cairo","Tajawal","Inter",Arial,sans-serif; font-size: 12px; font-weight: 700; color: var(--fc-muted); padding: 0 6px; min-width: unset; transition: color .15s ease; }
    .spf-mud-tabs .mud-tab.mud-tab-active { color: var(--fc-blue) !important; font-weight: 800; }
    .spf-mud-tabs .mud-tab-slider { background: var(--fc-blue) !important; height: 3px; border-radius: 3px 3px 0 0; }
    .spf-mud-tabs .mud-tab:hover:not(.mud-tab-active) { color: var(--fc-text); background: rgba(0,0,0,.03); border-radius: 8px; }
    .spf-tab-panel { padding: 0; }

    /* Tab Labels */
    .stab-label { display: flex; align-items: center; gap: 7px; padding: 0 4px; white-space: nowrap; }
    .stab-icon  { width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: 7px; }
    .stab-blue  { background: var(--fc-blue-lt);  color: var(--fc-blue); }
    .stab-amber { background: var(--fc-amber-lt); color: var(--fc-amber); }
    .stab-err-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--fc-red); flex: 0 0 7px; animation: spf-pulse 1.5s ease infinite; }
    @@keyframes spf-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.4); } 50% { box-shadow: 0 0 0 5px rgba(224,48,72,0); } }

    /* Tab Section */
    .spf-tab-section { padding: 20px 24px 24px; display: flex; flex-direction: column; gap: 16px; }

    /* Section Cards */
    .spf-section-card {
        border: 1px solid #e4edf8; border-radius: 14px;
        background: linear-gradient(180deg, #fafcff, #f5f8fb);
        padding: 18px 20px;
        transition: border-color .15s ease;
    }
    .spf-section-card:hover { border-color: #c8d8f0; }

    .spf-section-head {
        display: flex; align-items: flex-start; gap: 12px;
        margin-bottom: 18px; padding-bottom: 14px;
        border-bottom: 1px solid #e4edf8;
    }

    .spf-section-icon { width: 42px; height: 42px; flex: 0 0 42px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    .icon-blue   { background: var(--fc-blue-lt);  color: var(--fc-blue);  border: 1px solid #bdd4fc; }
    .icon-green  { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .icon-amber  { background: var(--fc-amber-lt); color: var(--fc-amber); border: 1px solid #f0d070; }

    .spf-section-title { font-size: 14.5px; font-weight: 800; color: #1c2b43; line-height: 1.2; }
    .spf-section-sub   { font-size: 11px; font-weight: 500; color: var(--fc-muted); margin-top: 3px; }

    /* Form */
    .spf-form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .spf-field { display: flex; flex-direction: column; gap: 6px; }
    .spf-field-full { grid-column: 1 / -1; }

    .spf-label { font-size: 12px; font-weight: 800; color: #344258; display: flex; align-items: center; gap: 4px; }

    .spf-input {
        height: 42px; width: 100%;
