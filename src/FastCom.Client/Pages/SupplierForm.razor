@page "/suppliers/new"
@page "/suppliers/new/{Id:int}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "مورد جديد" : "تعديل مورد") — فاست كوم</PageTitle>


<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">

            <div>
                <div class="fc-crumb">البيانات الأساسية · الموردون</div>
                <h1 class="fc-hero-title">
                    @if (_id is null)
                    {
                        <span>مورد جديد</span>
                        <span class="spf-hero-badge badge-new">جديد</span>
                    }
                    else
                    {
                        <span>@SupplierCode</span>
                        <span class="spf-hero-badge badge-edit">تعديل</span>
                    }
                </h1>
                <p class="fc-hero-sub">سجّل بيانات المورد — والكود بيتولد تلقائياً (SUP-)</p>
            </div>

            <div class="fc-head-actions">
                <button class="spf-back-btn" @onclick="GoBack">
                    <svg viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    الموردين
                </button>
                @if (CanSave)
                {
                    <button class="spf-save-btn" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ المورد</span>
                        }
                    </button>
                }
            </div>

        </div>
    </div>
</div>


<div class="spf-body">

    @if (!CanSave)
    {
        <div class="spf-state-box">
            <div class="spf-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>@(_id is null ? "ليس لديك صلاحية إضافة مورد" : "ليس لديك صلاحية تعديل مورد")</p>
            <button class="spf-state-back" @onclick="GoBack">العودة للقائمة</button>
        </div>
    }
    else if (_loading)
    {
        <div class="spf-loading-wrap">
            <div class="spf-spinner" aria-label="جاري التحميل"></div>
            <div class="spf-loading-text">جاري تحميل بيانات المورد...</div>
        </div>
    }
    else
    {
        @if (_msg is not null)
        {
            <div class="spf-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                <div aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="banner-close" @onclick="() => _msg = null">✕</button>
            </div>
        }

        @* ── نوع المورد — Type Selector ── *@
        <div class="spf-type-selector-card">
            <div class="spf-type-selector-title">
                <svg viewBox="0 0 24 24" width="15" height="15"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                    <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                </svg>
                نوع المورد
                <span class="spf-required">*</span>
            </div>
            <div class="spf-type-grid" role="group" aria-label="اختر نوع المورد">
                @foreach (var t in Types)
                {
                    var tKey = t.Key;
                    var isSelected = _f.SupplierType == tKey;
                    <button type="button"
                            class="spf-type-tile @(isSelected ? "type-selected" : "")"
                            @onclick="() => _f.SupplierType = tKey"
                            aria-pressed="@isSelected">
                        <span class="spf-type-emoji">@TypeIcon(tKey)</span>
                        <span class="spf-type-name">@t.Value</span>
                        @if (isSelected)
                        {
                            <span class="spf-type-check" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="12" height="12"
                                     fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                        }
                    </button>
                }
            </div>
        </div>


        <div class="spf-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="spf-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="spf-mud-tabs">


                @* ══════════════════════════════════════
                   TAB 1 — التعريف والبيانات الأساسية
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="stab-label">
                            <div class="stab-icon stab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                    <path d="M9 22V12h6v10"/>
                                </svg>
                            </div>
                            <span>بيانات المورد</span>
                            @if (HasTabError(1))
                            {
                                <span class="stab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="spf-tab-section">

                            @* ── الأسماء ── *@
                            <div class="spf-section-card">
                                <div class="spf-section-head">
                                    <div class="spf-section-icon icon-blue" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                            <path d="M9 22V12h6v10"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="spf-section-title">التعريف</div>
                                        <div class="spf-section-sub">اسم المورد بالعربي والإنجليزي</div>
                                    </div>
                                </div>

                                <div class="spf-form-grid">

                                    <div class="spf-field">
                                        <label class="spf-label">
                                            الاسم بالعربي
                                            <span class="spf-required">*</span>
                                        </label>
                                        <input class="spf-input @(string.IsNullOrWhiteSpace(_f.NameAr) && _triedSave ? "input-error" : "")"
                                               @bind="_f.NameAr"
                                               maxlength="150"
                                               placeholder="الاسم الكامل للمورد"
                                               aria-required="true" />
                                        @if (string.IsNullOrWhiteSpace(_f.NameAr) && _triedSave)
                                        {
                                            <div class="spf-err-msg" role="alert">الاسم بالعربي مطلوب</div>
                                        }
                                    </div>

                                    <div class="spf-field">
                                        <label class="spf-label">الاسم بالإنجليزي</label>
                                        <input class="spf-input"
                                               value="@_f.NameEn"
                                               maxlength="150"
                                               placeholder="Supplier name in English"
                                               dir="ltr"
                                               @onchange="e => _f.NameEn = e.Value?.ToString()" />
                                    </div>

                                </div>
                            </div>


                            @* ── التواصل ── *@
                            <div class="spf-section-card">
                                <div class="spf-section-head">
                                    <div class="spf-section-icon icon-green" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-4.99-5 19.79 19.79 0 01-3.07-8.67A2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="spf-section-title">التواصل</div>
                                        <div class="spf-section-sub">التليفون والبريد والعنوان</div>
                                    </div>
                                </div>

                                <div class="spf-form-grid">

                                    <div class="spf-field">
                                        <label class="spf-label">التليفون</label>
                                        <div class="spf-input-group">
                                            <span class="spf-prefix" aria-hidden="true">📞</span>
                                            <input class="spf-input with-prefix"
                                                   value="@_f.Phone"
                                                   maxlength="30"
                                                   placeholder="02-XXXXXXXX"
                                                   type="tel"
                                                   dir="ltr"
                                                   @onchange="e => _f.Phone = e.Value?.ToString()" />
                                        </div>
                                    </div>

                                    <div class="spf-field">
                                        <label class="spf-label">البريد الإلكتروني</label>
                                        <div class="spf-input-group">
                                            <span class="spf-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                                    <path d="M22 6l-10 7L2 6"/>
                                                </svg>
                                            </span>
                                            <input class="spf-input with-prefix"
                                                   value="@_f.Email"
                                                   maxlength="150"
                                                   placeholder="supplier@company.com"
                                                   type="email"
                                                   dir="ltr"
                                                   @onchange="e => _f.Email = e.Value?.ToString()" />
                                        </div>
                                    </div>

                                    <div class="spf-field spf-field-full">
                                        <label class="spf-label">العنوان</label>
                                        <div class="spf-input-group">
                                            <span class="spf-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                                    <circle cx="12" cy="10" r="3"/>
                                                </svg>
                                            </span>
                                            <input class="spf-input with-prefix"
                                                   value="@_f.Address"
                                                   maxlength="300"
                                                   placeholder="العنوان الكامل"
                                                   @onchange="e => _f.Address = e.Value?.ToString()" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 2 — البيانات الضريبية والمالية
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="stab-label">
                            <div class="stab-icon stab-amber" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <span>ضريبي ومالي</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="spf-tab-section">

                            <div class="spf-section-card">
                                <div class="spf-section-head">
                                    <div class="spf-section-icon icon-amber" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="spf-section-title">البيانات الضريبية والمالية</div>
                                        <div class="spf-section-sub">مطلوبة للفواتير الضريبية وإقرارات الخصم</div>
                                    </div>
                                </div>

                                <div class="spf-form-grid">

                                    <div class="spf-field">
                                        <label class="spf-label">الرقم الضريبي</label>
                                        <div class="spf-input-group">
                                            <span class="spf-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 16 16" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="1.7">
                                                    <rect x="2" y="2" width="12" height="12" rx="2"/>
                                                    <path d="M5 8h6M5 5h6M5 11h4" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input class="spf-input with-prefix"
                                                   value="@_f.TaxNumber"
                                                   maxlength="50"
                                                   placeholder="000-000-000"
                                                   dir="ltr"
                                                   @onchange="e => _f.TaxNumber = e.Value?.ToString()" />
                                        </div>
                                        <div class="spf-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            مطلوب للفواتير الضريبية وإقرارات الخصم
                                        </div>
                                    </div>

                                    <div class="spf-field">
                                        <label class="spf-label">شرط السداد</label>
                                        <div class="spf-select-wrap">
                                            <svg class="spf-sel-icon" viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <rect x="1" y="4" width="22" height="16" rx="2"/>
                                                <path d="M1 10h22"/>
                                            </svg>
                                            <select class="spf-input spf-select" @bind="_f.PaymentTermId">
                                                <option value="">— كاش / حسب الاتفاق —</option>
                                                @foreach (var p in _terms)
                                                {
                                                    <option value="@p.Id">@p.Label</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="spf-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            بيحدد ميعاد استحقاق فاتورة المورد
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


            </MudTabs>
        </div>


        @* Bottom Actions *@
        <div class="spf-bottom-actions">
            <button class="spf-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للقائمة
            </button>

            @if (CanSave)
            {
                <div class="spf-bottom-right">
                    @if (_activeTab < 1)
                    {
                        <button class="spf-next-btn" @onclick="() => _activeTab++">
                            التالي
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    }
                    <button class="spf-bottom-save" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ المورد</span>
                        }
                    </button>
                </div>
            }
        </div>

    }
</div>


<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* Hero */
    .spf-hero-badge {
        display: inline-flex; align-items: center;
        padding: 3px 10px; border-radius: 20px;
        font-size: 11px; font-weight: 800;
    }
    .badge-new  { background: rgba(34,197,94,.2);  color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-edit { background: rgba(234,179,8,.2);   color: #fde68a; border: 1px solid rgba(234,179,8,.3); }

    .spf-back-btn {
        display: inline-flex; align-items: center; gap: 5px;
        height: 36px; padding: 0 13px;
        border: 1px solid rgba(255,255,255,.2); border-radius: 9px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .spf-back-btn:hover { background: rgba(255,255,255,.14); }
    .spf-back-btn svg { transform: rotate(180deg); }

    .spf-save-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 18px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .spf-save-btn:hover:not(:disabled) { transform: translateY(-1px); }
    .spf-save-btn:disabled { opacity: .6; cursor: not-allowed; }

    /* Body */
    .spf-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 180px);
        padding: 16px 20px 32px;
        max-width: 900px; width: 100%;
        margin: 0 auto;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* States */
    .spf-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 280px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .spf-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .spf-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .spf-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .spf-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }
    .spf-state-back { margin-top: 8px; padding: 9px 20px; border: 1px solid var(--fc-border); border-radius: 9px; background: var(--fc-card); color: var(--fc-text); font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }

    /* Loading */
    .spf-loading-wrap {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 14px; min-height: 260px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .spf-spinner {
        width: 36px; height: 36px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: spf-spin .75s linear infinite;
    }
    @@keyframes spf-spin { to { transform: rotate(360deg); } }
    .spf-loading-text { font-size: 13px; font-weight: 600; color: var(--fc-muted); }

    /* Banner */
    .spf-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600;
        animation: spf-banner-in .25s ease;
    }
    @@keyframes spf-banner-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
    .banner-success { background: #e9f8f0; color: #0e7a43; border: 1px solid #b5e8d0; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); border: 1px solid #ffc8d0; }
    .banner-close { margin-right: auto; background: none; border: none; color: inherit; opacity: .6; cursor: pointer; font-size: 13px; }

    /* ================================================================
       TYPE SELECTOR CARD
    ================================================================ */
    .spf-type-selector-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
