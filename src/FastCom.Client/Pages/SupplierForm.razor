        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .spf-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .spf-input.input-error { border-color: var(--fc-red); box-shadow: 0 0 0 3px rgba(224,48,72,.08); }
    .spf-input::placeholder { color: #b0bcc8; }

    .spf-input-group { position: relative; display: flex; align-items: center; }
    .spf-prefix {
        position: absolute; right: 12px;
        display: flex; align-items: center;
        color: #9aaabb; pointer-events: none; z-index: 1;
        font-size: 11px; font-weight: 700;
    }
    .spf-input.with-prefix { padding-right: 36px; }

    .spf-select-wrap { position: relative; }
    .spf-sel-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #9aaabb; pointer-events: none; z-index: 1; }
    .spf-select { padding-right: 36px; cursor: pointer; -webkit-appearance: none; appearance: none; }

    .spf-hint { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--fc-muted); font-weight: 500; }
    .spf-err-msg { font-size: 10.5px; color: var(--fc-red); font-weight: 700; }

    /* Bottom Actions */
    .spf-bottom-actions {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; padding: 14px 20px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 2px 8px rgba(15,41,82,.04);
    }

    .spf-bottom-back {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .spf-bottom-back:hover { background: #f0f4fa; color: var(--fc-text); }
    .spf-bottom-back svg { transform: rotate(180deg); }

    .spf-bottom-right { display: flex; align-items: center; gap: 10px; }

    .spf-next-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 14px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .spf-next-btn:hover { background: var(--fc-blue); color: #fff; }
    .spf-next-btn svg { transform: rotate(180deg); }

    .spf-bottom-save {
        display: inline-flex; align-items: center; gap: 8px;
        height: 40px; padding: 0 22px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(30,110,245,.28);
        transition: all .15s ease;
    }
    .spf-bottom-save:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(30,110,245,.36); }
    .spf-bottom-save:disabled { opacity: .6; cursor: not-allowed; }

    .btn-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: spf-spin .7s linear infinite; }
    .btn-spinner.sm { width: 13px; height: 13px; }

    @@media (max-width: 900px) {
        .spf-form-grid { grid-template-columns: 1fr; }
        .spf-type-grid { grid-template-columns: repeat(2, 1fr); }
        .spf-tab-section { padding: 16px 14px 20px; }
    }

    @@media (max-width: 680px) {
        .spf-body { padding: 10px 12px 24px; }
        .spf-type-grid { grid-template-columns: 1fr 1fr; }
        .spf-bottom-actions { flex-direction: column; }
        .spf-bottom-back, .spf-bottom-save { width: 100%; justify-content: center; }
