@page "/transport-requests"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>طلبات النقل — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="op-hero-row">
                <div class="op-hero-left">
                    <div class="op-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M13 2L3 14h7l-1 8 11-14h-8l1-6z" stroke-linejoin="round"/>
                        </svg>
                        <span>التشغيل · طلبات النقل</span>
                    </div>
                    <h1 class="fc-hero-title">طلبات النقل</h1>
                    <p class="fc-hero-sub">كل الطلبات في شاشة واحدة — ضيف وعدّل وتابع من نفس المكان، ورقم حجز الوكيل هو الأساس</p>
                </div>

                <div class="op-hero-right">
                    <span class="op-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

            @if (CanView)
            {
                <div class="fc-kpis fc-kpis-glass">
                    <div class="fc-kpi fc-kpi-click @(_tab == "all" ? "fc-kpi-active" : "")"
                         @onclick='() => SetTab("all")' role="button" aria-pressed="@(_tab == "all")">
                        <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.LocalShipping" /></div>
                        <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">إجمالي الطلبات</div></div>
                    </div>
                    <div class="fc-kpi fc-kpi-click @(_tab == "open" ? "fc-kpi-active" : "")"
                         @onclick='() => SetTab("open")' role="button" aria-pressed="@(_tab == "open")">
                        <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                        <div><div class="fc-kpi-num">@_items.Count(o => OpenStatuses.Contains(o.Status))</div><div class="fc-kpi-lb">جارية</div></div>
                    </div>
                    <div class="fc-kpi fc-kpi-click @(_tab == "Delivered" ? "fc-kpi-active" : "")"
                         @onclick='() => SetTab("Delivered")' role="button" aria-pressed="@(_tab == "Delivered")">
                        <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                        <div><div class="fc-kpi-num">@_items.Count(o => o.Status == "Delivered")</div><div class="fc-kpi-lb">مُسلّمة</div></div>
                    </div>
                    @if (CanViewFinancials)
                    {
                        <div class="fc-kpi fc-kpi-click @(_tab == "Closed" ? "fc-kpi-active" : "")"
                             @onclick='() => SetTab("Closed")' role="button" aria-pressed="@(_tab == "Closed")">
                            <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Savings" /></div>
                            <div>
                                <div class="fc-kpi-num @(_items.Sum(o => o.RevenueNet - o.ActualCost) >= 0 ? "" : "kpi-negative")">
                                    @Money(_items.Sum(o => o.RevenueNet - o.ActualCost))
                                </div>
                                <div class="fc-kpi-lb">صافي الربح</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="fc-kpi fc-kpi-click @(_tab == "Closed" ? "fc-kpi-active" : "")"
                             @onclick='() => SetTab("Closed")' role="button" aria-pressed="@(_tab == "Closed")">
                            <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Lock" /></div>
                            <div><div class="fc-kpi-num">@_items.Count(o => o.Status == "Closed")</div><div class="fc-kpi-lb">مغلقة</div></div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="op-body">

    @if (!CanView)
    {
        <div class="op-state-box">
            <div class="op-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض طلبات النقل — تواصل مع المسؤول</p>
        </div>
    }
    else
    {
        <div class="op-card">

            @* ── Toolbar ── *@
            <div class="op-toolbar">

                <div class="op-search-wrap">
                    <svg class="op-search-icon" viewBox="0 0 24 24"
                         width="16" height="16" fill="none" stroke="currentColor"
                         stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="op-search-input"
                           placeholder="ابحث برقم العملية أو حجز الوكيل أو العميل..."
                           @bind="_search"
                           @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="op-search-clear"
                                @onclick="() => _search = string.Empty"
                                aria-label="مسح البحث">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="op-status-tabs" role="group" aria-label="فلتر الحالة">
                    @foreach (var t in _statusTabs)
                    {
                        var count = t.Key == "all"
                            ? _items.Count
                            : t.Key == "open"
                                ? _items.Count(o => OpenStatuses.Contains(o.Status))
                                : _items.Count(o => o.Status == t.Key);

                        <button class="op-status-tab @(_tab == t.Key ? "active" : "")"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="op-tab-dot @StatusDotColor(t.Key)"
                                  aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="op-tab-count">@count</span>
                        </button>
                    }
                </div>

                @if (CanViewFinancials && _items.Any() && !_loading)
                {
                    <div class="op-fin-summary">
                        <div class="op-fin-item">
                            <span class="op-fin-label">الإيرادات</span>
                            <span class="op-fin-val fin-green">
                                @Money(Filtered.Sum(o => o.RevenueNet))
                            </span>
                        </div>
                        <div class="op-fin-sep" aria-hidden="true"></div>
                        <div class="op-fin-item">
                            <span class="op-fin-label">التكاليف</span>
                            <span class="op-fin-val fin-red">
                                @Money(Filtered.Sum(o => o.ActualCost))
                            </span>
                        </div>
                        <div class="op-fin-sep" aria-hidden="true"></div>
                        <div class="op-fin-item">
                            <span class="op-fin-label">الربح</span>
                            @{
                                var profit = Filtered.Sum(o => o.RevenueNet - o.ActualCost);
                            }
                            <span class="op-fin-val @(profit >= 0 ? "fin-green" : "fin-red")">
                                @Money(profit)
                            </span>
                        </div>
                    </div>
                }

                <div class="op-results-badge">
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>

            </div>

            @* ── Content ── *@
            @if (_loading)
            {
                <div class="op-loading">
                    <div class="op-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل الطلبات...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="op-empty">
                    <div class="op-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="40" height="40"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <rect x="1" y="3" width="15" height="13" rx="2"/>
                            <path d="M16 8h4l3 3v5h-7V8z"/>
                            <circle cx="5.5" cy="18.5" r="2.5"/>
                            <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                    </div>
                    <div class="op-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) ? "لا توجد طلبات في هذا الفلتر" : "لا توجد نتائج")
                    </div>
                    <div class="op-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search)
                            ? "جرّب فلتر مختلف أو أنشئ طلب نقل جديد"
                            : "جرّب كلمة بحث مختلفة")
                    </div>
                    @if (CanCreate && string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="op-add-btn" @onclick="OpenCreate">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            طلب نقل جديد
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="op-table-wrap">
                    <table class="op-table" aria-label="قائمة طلبات النقل">
                        <thead>
                            <tr>
                                <th class="th-start">الطلب والعميل</th>
                                <th>حجز الوكيل</th>
                                <th>المسار</th>
                                <th>التاريخ</th>
                                <th>حاويات / رحلات</th>
                                <th>الحالة</th>
                                @if (CanViewFinancials)
                                {
                                    <th>الإيراد</th>
                                    <th>الربح</th>
                                }
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Filtered)
                            {
                                var profit = o.RevenueNet - o.ActualCost;
                                <tr class="@(o.Status == "Cancelled" ? "row-cancelled" : "")">

                                    @* ── الطلب والعميل ── *@
                                    <td class="td-start">
                                        <div class="op-op-cell">
                                            <div class="op-avatar @AvatarClass(o.Status)"
                                                 aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="16" height="16"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                                </svg>
                                            </div>
                                            <div class="op-op-info">
                                                <div class="op-op-num">
                                                    <span class="op-code-chip">@o.OperationNumber</span>
                                                </div>
                                                <div class="op-customer-name">@o.CustomerName</div>
                                                @if (!string.IsNullOrWhiteSpace(o.EndCustomerName))
                                                {
                                                    <div class="td-muted" style="font-size:11px;line-height:1.25">عميل نهائي: @o.EndCustomerName</div>
                                                }
                                                <div class="op-op-meta">
                                                    @if (!string.IsNullOrWhiteSpace(o.ServiceName))
                                                    {
                                                        <span class="op-service-tag">@o.ServiceName</span>
                                                    }
                                                    @if (o.BookingNumber is not null)
                                                    {
                                                        <span class="op-booking-tag">
                                                            <svg viewBox="0 0 16 16" width="9" height="9"
                                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                                 aria-hidden="true">
                                                                <path d="M2 5h12M5 2v3M11 2v3M3 5v8a1 1 0 001 1h8a1 1 0 001-1V5H3z"/>
                                                            </svg>
                                                            @o.BookingNumber
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    @* ── حجز الوكيل ── *@
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(o.AgentReference))
                                        {
                                            <div class="op-op-num"><strong>@o.AgentReference</strong></div>
                                            <div class="td-muted">@(o.AgentName ?? "—")</div>
                                        }
                                        else
                                        {
                                            <span class="td-muted">— بدون حجز وكيل —</span>
                                        }
                                    </td>

                                    @* ── المسار ── *@
                                    <td>
                                        @if (o.PortName is not null || o.DestinationName is not null)
                                        {
                                            <div class="op-route-cell">
                                                <span class="op-route-from">@(o.PortName ?? "—")</span>
                                                <span class="op-route-arrow" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="11" height="11"
                                                         fill="none" stroke="currentColor" stroke-width="2.5">
                                                        <path d="M5 12h14M12 5l7 7-7 7"
                                                              stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </span>
                                                <span class="op-route-to">@(o.DestinationName ?? "—")</span>
                                                @if (o.TahteeqPortName is not null)
                                                {
                                                    <span class="op-route-arrow" aria-hidden="true">
                                                        <svg viewBox="0 0 24 24" width="11" height="11"
                                                             fill="none" stroke="currentColor" stroke-width="2.5">
                                                            <path d="M5 12h14M12 5l7 7-7 7"
                                                                  stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>
                                                    </span>
                                                    <span class="op-route-tah" title="ميناء التعتيق">
                                                        <span class="op-route-tah-tag">تعتيق</span>@o.TahteeqPortName
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="td-muted">—</span>
                                        }
                                    </td>

                                    @* ── التاريخ ── *@
                                    <td class="td-muted">
                                        @if (o.PlannedDate.HasValue)
                                        {
                                            <div class="op-date-cell">
                                                <svg viewBox="0 0 16 16" width="11" height="11"
                                                     fill="none" stroke="currentColor" stroke-width="1.7"
                                                     aria-hidden="true">
                                                    <rect x="2" y="3" width="12" height="11" rx="2"/>
                                                    <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                                                </svg>
                                                @o.PlannedDate.Value.ToString("yyyy-MM-dd")
                                            </div>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>

                                    @* ── حاويات / رحلات ── *@
                                    <td>
                                        <span class="op-code-chip">@o.ContainersQty حاوية</span>
                                        <span class="td-muted"> · @o.TripsCount رحلة</span>
                                    </td>

                                    @* ── الحالة ── *@
                                    <td>
                                        <span class="op-chip @ChipClass(o.Status)">
                                            <span class="op-chip-dot @ChipDotClass(o.Status)"
                                                  aria-hidden="true"></span>
                                            @StatusAr(o.Status)
                                        </span>
                                    </td>

                                    @* ── الإيراد ── *@
                                    @if (CanViewFinancials)
                                    {
                                        <td>
                                            <div class="op-money-cell">
                                                <span class="op-money-main">@Money(o.RevenueNet)</span>
                                                @if (o.RevenueTax > 0)
                                                {
                                                    <span class="op-money-sub">+ ضريبة @Money(o.RevenueTax)</span>
                                                }
                                            </div>
                                        </td>
                                    }

                                    @* ── الربح ── *@
                                    @if (CanViewFinancials)
                                    {
                                        <td>
                                            <span class="op-profit-badge @(profit >= 0 ? "profit-pos" : "profit-neg")">
                                                <span aria-hidden="true">@(profit >= 0 ? "↑" : "↓")</span>
                                                @Money(profit)
                                            </span>
                                        </td>
                                    }

                                    @* ── إجراءات ── *@
                                    <td>
                                        <div class="op-actions">
                                            <button class="op-act-btn act-file"
                                                    @onclick="() => GoFile(o)"
                                                    title="ملف العملية"
                                                    aria-label="ملف @o.OperationNumber">
                                                <svg viewBox="0 0 24 24" width="14" height="14"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
                                                </svg>
                                            </button>
                                            @if (CanEdit && o.Status is not ("Closed" or "Cancelled"))
                                            {
                                                <button class="op-act-btn act-edit"
                                                        @onclick="() => OpenEdit(o)"
                                                        title="تعديل الطلب"
                                                        aria-label="تعديل طلب @o.OperationNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M17 3a2.85 2.83 0 114 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                                    </svg>
                                                </button>
                                            }
                                            @{
                                                var tripActions = EffectiveActions(o);
                                                var canDeleteReq = CanDelete && o.Status is "Pending" or "Cancelled" && o.TripsCount == 0;
                                                var deleteBlocked = CanDelete && !canDeleteReq;
                                                var deleteWhy = !CanDelete ? null
                                                    : o.Status is not ("Pending" or "Cancelled") ? "الحذف متاح للطلبات المعلّقة/الملغاة فقط"
                                                    : o.TripsCount > 0 ? $"لا يمكن الحذف: مرتبط بـ {o.TripsCount} رحلة — احذف/ألغِ الرحلات أولًا من تفاصيل الطلب"
                                                    : null;
                                            }
                                            @if (CanTripEdit && tripActions.Count > 0)
                                            {
                                                <button class="op-act-btn act-start" @onclick="() => OpenTripPicker(o, tripActions)"
                                                        title="بدء/إنهاء رحلة (@tripActions.Count)"
                                                        aria-label="اختيار رحلة للطلب @o.OperationNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                                </button>
                                            }
                                            @if (CanOpClose && o.CanCloseOp)
                                            {
                                                <button class="op-act-btn act-closeop"
                                                        @onclick="() => CloseOperationAsync(o)"
                                                        title="إقفال العملية — كل رحلاتها انتهت"
                                                        aria-label="إقفال عملية طلب @o.OperationNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </button>
                                            }
                                            @if (canDeleteReq)
                                            {
                                                @if (_confirmDeleteId == o.OperationId)
                                                {
                                                    <button class="op-confirm-del" @onclick="() => DeleteAsync(o)">تأكيد حذف الطلب؟</button>
                                                }
                                                else
                                                {
                                                    <button class="op-act-btn act-delete" @onclick="() => { _confirmDeleteId = o.OperationId; _tripPickerItem = null; }"
                                                            title="حذف الطلب (معلّق/ملغى وبدون رحلات)" aria-label="حذف طلب @o.OperationNumber">
                                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                                                    </button>
                                                }
                                            }
                                            else if (deleteBlocked)
                                            {
                                                <button type="button" class="op-act-btn act-delete is-disabled" @onclick="() => ShowDeleteBlocked(deleteWhy)" title="@deleteWhy" aria-label="@deleteWhy">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@* ══════════════ FAB ══════════════ *@
@if (CanCreate && !_loading)
{
    @if (_fabOpen)
    {
        <div class="fc-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
    }

    <div class="fc-fab-container">
        <div class="fc-fab-menu @(_fabOpen ? "fc-fab-menu--open" : "")" role="menu">
            <button type="button" class="fc-fab-item" role="menuitem"
                    @onclick="HandleOpenCreate">
                <span class="fc-fab-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/>
                </span>
                <span class="fc-fab-label">طلب نقل جديد</span>
            </button>
            <button type="button" class="fc-fab-item" role="menuitem"
                    @onclick="HandleReload">
                <span class="fc-fab-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"/>
                </span>
                <span class="fc-fab-label">تحديث البيانات</span>
            </button>
        </div>

        <button type="button"
                class="fc-fab-main fc-glow-gold @(_fabOpen ? "is-open" : "")"
                @onclick="ToggleFab"
                aria-label="التحكم"
                aria-expanded="@(_fabOpen ? "true" : "false")">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none"
                 stroke="currentColor" stroke-width="2.5"
                 class="fc-fab-svg" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
}

@if (_tripPickerItem is not null)
{
    var pickerActions = EffectiveActions(_tripPickerItem);
    <div class="rq-trip-modal-backdrop" @onclick="CloseTripPicker">
        <div class="rq-trip-modal" @onclick:stopPropagation="true" role="dialog" aria-label="اختيار رحلة">
            <div class="rq-trip-modal-head">
                <div>
                    <div class="rq-trip-modal-title">إدارة رحلات الطلب @_tripPickerItem.OperationNumber</div>
                    <div class="rq-trip-modal-sub">اختر الرحلة، ثم اضغط <b>بدء</b> أو <b>إنهاء</b>. التنفيذ فوري على الرحلة المحددة فقط.</div>
                </div>
                <button type="button" class="rq-trip-close" @onclick="CloseTripPicker" aria-label="إغلاق">×</button>
            </div>
            <div class="rq-trip-modal-body">
                @foreach (var t in pickerActions)
                {
                    <div class="rq-trip-card @(t.CanStart?"rq-trip-canstart":"rq-trip-candone")">
                        <div class="rq-trip-card-main">
                            <div class="rq-trip-no">@t.TripNumber</div>
                            <div class="rq-trip-meta">@(string.IsNullOrWhiteSpace(t.DriverName) && string.IsNullOrWhiteSpace(t.VehiclePlate) ? "—" : $"{t.DriverName} · {t.VehiclePlate}")</div>
                            <div class="rq-trip-meta"><span class="opf-chip">@TripStatusAr(t.Status)</span>@(t.PlannedStartAt is not null ? $" · {t.PlannedStartAt:yyyy-MM-dd HH:mm}" : "")</div>
                        </div>
                        <button type="button" class="rq-trip-do @(t.CanStart?"is-start":"is-done")" disabled="@_tripBusy" @onclick="() => RunTripActionAsync(_tripPickerItem, t)">
                            @if (t.CanStart)
                            { <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg><span>بدء الرحلة</span> }
                            else
                            { <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>إنهاء الرحلة</span> }
                        </button>
                    </div>
                }
                @if (pickerActions.Count == 0)
                { <div class="rq-trip-meta" style="padding:10px 4px">لا توجد رحلة قابلة للبدء/الإنهاء الآن.</div> }
            </div>
        </div>
    </div>
}

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("OPERATION.VIEW") ?? false;
    private bool CanViewFinancials => (_user?.IsAdmin ?? false) || (_user?.Can("OPERATION.VIEW_FINANCIALS") ?? false);
    private bool CanCreate => (_user?.Can("OPERATION.CREATE") ?? false) && (_user?.Can("BOOKING.CREATE") ?? false);
    private bool CanEdit   => (_user?.Can("OPERATION.EDIT") ?? false) && (_user?.Can("BOOKING.EDIT") ?? false);
    private bool CanTripEdit => _user?.Can("TRIP.EDIT") ?? false;
    private bool CanOpClose => _user?.Can("OPERATION.CLOSE") ?? false;
    private bool CanDelete => _user?.Can("OPERATION.DELETE") ?? false;
    private Item? _tripPickerItem;
    private bool _tripBusy;
    private long? _confirmDeleteId;

    private void OpenTripPicker(Item o, List<RequestTripAction> actions) { _confirmDeleteId = null; _tripPickerItem = o; }
    private void CloseTripPicker() { if (!_tripBusy) _tripPickerItem = null; }
    private void ShowDeleteBlocked(string? why) => Snackbar.Add(string.IsNullOrWhiteSpace(why) ? "لا يمكن حذف هذا الطلب" : why, Severity.Warning);

    private static List<RequestTripAction> EffectiveActions(Item o)
    {
        if (o.ActionableTrips is { Count: > 0 }) return o.ActionableTrips;
        var list = new List<RequestTripAction>();
        if (o.StartTripId is long sid)
            list.Add(new RequestTripAction
            {
                TripId = sid,
                TripNumber = o.StartTripNumber ?? sid.ToString(),
                Status = "Assigned",
                DriverName = o.StartTripDriverName ?? "",
                VehiclePlate = o.StartTripVehiclePlate ?? ""
            });
        if (o.CompleteTripId is long cid)
            list.Add(new RequestTripAction
            {
                TripId = cid,
                TripNumber = o.CompleteTripNumber ?? cid.ToString(),
                Status = "Started",
                DriverName = o.CompleteTripDriverName ?? "",
                VehiclePlate = o.CompleteTripVehiclePlate ?? ""
            });
        return list;
    }

    /* ── القائمة ── */
    public class RequestTripAction
    {
        public long TripId { get; set; }
        public string TripNumber { get; set; } = "";
        public string Status { get; set; } = "";
        public string DriverName { get; set; } = "";
        public string VehiclePlate { get; set; } = "";
        public DateTime? PlannedStartAt { get; set; }
        public bool CanStart => Status is "Planned" or "Assigned";
        public bool CanComplete => Status == "Started";
    }

    public class Item
    {
        public long    OperationId     { get; set; }
        public string  OperationNumber { get; set; } = "";
        public long?   BookingId       { get; set; }
        public string? BookingNumber   { get; set; }
        public string? AgentName       { get; set; }
        public string? AgentReference  { get; set; }
        public string  CustomerName    { get; set; } = "";
        public string? EndCustomerName  { get; set; }
        public string? ServiceName     { get; set; }
        public string? PortName        { get; set; }
        public string? DestinationName { get; set; }
        public string? TahteeqPortName { get; set; }
        public DateTime? PlannedDate   { get; set; }
        public string  Status          { get; set; } = "";
        public int     ContainersQty   { get; set; }
        public int     TripsCount      { get; set; }
        public long?   StartTripId     { get; set; }
        public string? StartTripNumber { get; set; }
        public string? StartTripDriverName { get; set; }
        public string? StartTripVehiclePlate { get; set; }
        public long?   CompleteTripId     { get; set; }
        public string? CompleteTripNumber { get; set; }
        public string? CompleteTripDriverName { get; set; }
        public string? CompleteTripVehiclePlate { get; set; }
        public bool    CanCloseOp         { get; set; }
        public decimal RevenueNet      { get; set; }
        public decimal RevenueTax      { get; set; }
        public decimal ActualCost      { get; set; }
        public DateTime CreatedAt      { get; set; }
        public List<RequestTripAction> ActionableTrips { get; set; } = new();
        public bool _actionsOpen { get; set; } /* legacy, unused */
    }

    private List<Item> _items = new();
    private bool   _loading;
    private string _search = "";
    private string _tab    = "all";
    private bool   _fabOpen;

    private static readonly string[] OpenStatuses =
    {
        "Pending", "Assigned", "DriverReceived", "InTransit",
        "Delivered", "ExpensesPending", "CustodyPending", "ReadyToClose"
    };

    private static readonly (string Key, string Value)[] _statusTabs =
    {
        ("all",        "الكل"),
        ("open",       "جارية"),
        ("Pending",    "قيد الانتظار"),
        ("InTransit",  "في الطريق"),
        ("Delivered",  "مُسلّمة"),
        ("Closed",     "مغلقة"),
        ("Cancelled",  "ملغاة")
    };

    private IEnumerable<Item> Filtered
    {
        get
        {
            IEnumerable<Item> q = _items;
            if (_tab == "open") q = q.Where(o => OpenStatuses.Contains(o.Status));
            else if (_tab != "all") q = q.Where(o => o.Status == _tab);

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(o =>
                    o.OperationNumber.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    o.CustomerName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (o.EndCustomerName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (o.AgentReference?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (o.AgentName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (o.BookingNumber?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return q;
        }
    }

    private void SetTab(string t) => _tab = t;
    private void GoFile(Item o) => Nav.NavigateTo($"/operations/{o.OperationId}/file");
    private void ToggleFab() => _fabOpen = !_fabOpen;

    private async Task HandleReload()
    {
        _fabOpen = false;
        await LoadAsync();
        Snackbar.Add("تم تحديث البيانات", Severity.Success);
    }

    private async Task HandleOpenCreate()
    {
        _fabOpen = false;
        StateHasChanged();
        await Task.Delay(180);
        Nav.NavigateTo("/transport-requests/new");
    }

    private void OpenCreate() => Nav.NavigateTo("/transport-requests/new");
    private void OpenEdit(Item o) => Nav.NavigateTo($"/transport-requests/new/{o.OperationId}");

    private async Task RunTripActionAsync(Item o, RequestTripAction t)
    {
        o._actionsOpen = false; _tripBusy = true;
        try
        {
            var path = t.CanStart ? $"api/trips/{t.TripId}/start" : $"api/trips/{t.TripId}/complete";
            var body = t.CanStart
                ? (object)new { actualStartAt = (string?)null, startOdometer = (string?)null }
                : new { actualEndAt = (string?)null, endOdometer = (string?)null };
            var res = await Http.PostAsJsonAsync(path, body);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { _tripPickerItem = null; await LoadAsync(); }
        }
        catch (Exception ex) { Snackbar.Add("فشل إجراء الرحلة: " + ex.Message, Severity.Error); }
        finally { _tripBusy = false; }
    }

    /* بدء أقدم رحلة مخططة في الطلب مباشرة من القائمة — وقت البدء هو الآن،
       وعدّاد الكيلومترات يُسجل من شاشة الرحلات عند الحاجة */
    private async Task StartTripAsync(Item o)
    {
        if (o.StartTripId is null) return;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/trips/{o.StartTripId}/start",
                new { actualStartAt = (string?)null, startOdometer = (string?)null });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل بدء الرحلة: " + ex.Message, Severity.Error); }
    }

    /* إنهاء أقدم رحلة بدأت في الطلب — وقت الانتهاء الآن؛ إنهاء الرحلة
       يجعل العملية «مسلّمة» ولا يُقفلها */
    private async Task CompleteTripAsync(Item o)
    {
        if (o.CompleteTripId is null) return;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/trips/{o.CompleteTripId}/complete",
                new { actualEndAt = (string?)null, endOdometer = (string?)null });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل إنهاء الرحلة: " + ex.Message, Severity.Error); }
    }

    private async Task DeleteAsync(Item o)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/operations/{o.OperationId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmDeleteId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل الحذف: " + ex.Message, Severity.Error); }
    }

    /* إقفال العملية بعد انتهاء كل رحلاتها — قرار مستقل عن إنهاء الرحلات */
    private async Task CloseOperationAsync(Item o)
    {
        try
        {
            var res = await Http.PostAsync($"api/operations/{o.OperationId}/close", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل إقفال العملية: " + ex.Message, Severity.Error); }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await Http.GetFromJsonAsync<List<Item>>("api/operations/requests") ?? new();
        }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        await LoadAsync();
    }

    /* ── مساعدات العرض (نفس شاشة العمليات) ── */
    private static string TripStatusAr(string s) => s switch
    {
        "Planned"         => "مخططة",
        "Assigned"        => "مُعيّنة",
        "DriverReceived"  => "استلم السائق",
        "PickedUp"        => "تم الاستلام",
        "Started"         => "في الطريق",
        "InTransit"       => "في الطريق",
        "Delivered"       => "تم التسليم",
        "Completed"       => "مكتملة",
        "Cancelled"       => "ملغاة",
        "Closed"          => "مغلقة",
        _                 => s
    };
    private static string StatusAr(string s) => s switch
    {
        "Pending"         => "قيد الانتظار",
        "Assigned"        => "مُعيّنة",
        "DriverReceived"  => "استلم السائق",
        "InTransit"       => "في الطريق",
        "Delivered"       => "تم التسليم",
        "ExpensesPending" => "بانتظار المصروفات",
        "CustodyPending"  => "بانتظار العهدة",
        "ReadyToClose"    => "جاهزة للإغلاق",
        "Closed"          => "مغلقة",
        "Cancelled"       => "ملغاة",
        _                 => s
    };

    private static string ChipClass(string s) => s switch
    {
        "Pending"         => "chip-pending",
        "Assigned"        => "chip-assigned",
        "DriverReceived"  => "chip-driverrec",
        "InTransit"       => "chip-intransit",
        "Delivered"       => "chip-delivered",
        "ExpensesPending" => "chip-expspend",
        "CustodyPending"  => "chip-custpend",
        "ReadyToClose"    => "chip-readyclose",
        "Closed"          => "chip-closed",
        "Cancelled"       => "chip-cancelled",
        _                 => "chip-pending"
    };

    private static string ChipDotClass(string s) => s switch
    {
        "Pending"         => "cdot-pending",
        "Assigned"        => "cdot-assigned",
        "DriverReceived"  => "cdot-driverrec",
        "InTransit"       => "cdot-intransit",
        "Delivered"       => "cdot-delivered",
        "ExpensesPending" => "cdot-expspend",
        "CustodyPending"  => "cdot-custpend",
        "ReadyToClose"    => "cdot-readyclose",
        "Closed"          => "cdot-closed",
        "Cancelled"       => "cdot-cancelled",
        _                 => "cdot-pending"
    };

    private static string AvatarClass(string s) => s switch
    {
        "Pending"         => "av-pending",
        "Assigned"        => "av-assigned",
        "DriverReceived"  => "av-driverrec",
        "InTransit"       => "av-intransit",
        "Delivered"       => "av-delivered",
        "ExpensesPending" => "av-expspending",
        "CustodyPending"  => "av-custpending",
        "ReadyToClose"    => "av-readyclose",
        "Closed"          => "av-closed",
        "Cancelled"       => "av-cancelled",
        _                 => "av-pending"
    };

    private static string StatusDotColor(string s) => s switch
    {
        "all"       => "tdot-all",
        "open"      => "tdot-assigned",
        "Pending"   => "tdot-pending",
        "InTransit" => "tdot-intransit",
        "Delivered" => "tdot-delivered",
        "Closed"    => "tdot-closed",
        "Cancelled" => "tdot-cancelled",
        _           => "tdot-all"
    };

    private static string Money(decimal v) => v.ToString("N0");

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-orange:    #e06520;
        --fc-orange-lt: #fff3ec;
        --fc-teal:      #0d9488;
        --fc-teal-lt:   #e6faf8;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       KPI NEGATIVE
    ================================================================ */
    .kpi-negative { color: #fca5a5 !important; }

    /* ================================================================
       HERO — كارت دائري مستقل (نفس نمط شاشة الحجوزات)
       عرض الهيرو والجسم لازم يبقى نفس القيمة عشان يبقوا على خط واحد
    ================================================================ */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow:
            0 12px 32px rgba(13, 38, 84, 0.15),
            0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .hero-wrapper .fc-hero-sub { font-size: 13px; color: rgba(255, 255, 255, .55); }

    .op-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .op-hero-left { flex: 1; min-width: 200px; }

    .op-hero-crumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 10.5px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 6px;
    }

    .op-hero-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

    .op-hero-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(255, 255, 255, .1);
        border: 1px solid rgba(255, 255, 255, .2);
        font-size: 11.5px;
        color: #fff;
    }

    /* ================================================================
       شيبس فلترة الحجز — الرابط المباشر من شاشة الحجوزات
    ================================================================ */
    .op-booking-filter {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px 6px 8px;
        border-radius: 20px;
        background: var(--fc-amber-lt);
        border: 1px solid #f0d9a8;
        color: #8a5a06;
        font-size: 11.5px;
        font-weight: 700;
        white-space: nowrap;
    }
    .op-booking-filter strong { color: #6b4404; }
    .op-bf-clear {
        display: flex; align-items: center; justify-content: center;
        width: 18px; height: 18px; border-radius: 50%;
        border: none; background: rgba(138, 90, 6, .12); color: #8a5a06;
        cursor: pointer; transition: all .12s ease;
    }
    .op-bf-clear:hover { background: rgba(138, 90, 6, .25); }

    /* ================================================================
       FAB — زر عائم أسفل يسار (نفس وميض شاشة الحجوزات)
    ================================================================ */
    .op-fab-scrim {
        position: fixed;
        inset: 0;
        z-index: 998;
        background: rgba(10, 20, 40, .28);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        animation: op-scrim-fade .18s ease;
    }
    @@keyframes op-scrim-fade {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    /* ================================================================
       #67 — تأكيد إقفال / إعادة فتح
    ================================================================ */
    .op-confirm-scrim {
        position: fixed; inset: 0; z-index: 1200;
        display: flex; align-items: center; justify-content: center;
        padding: 16px;
        background: rgba(10, 20, 40, .45);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        animation: op-scrim-fade .18s ease;
    }
    .op-confirm-card {
        width: min(400px, calc(100vw - 32px));
        background: #fff; border-radius: 18px;
        box-shadow: 0 25px 60px rgba(10, 27, 59, .28);
        padding: 26px 24px 20px;
        text-align: center;
    }
    .op-confirm-ic {
        width: 46px; height: 46px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        margin-bottom: 12px;
    }
    .op-confirm-ic.ic-close  { background: var(--fc-red-lt);   color: var(--fc-red); }
    .op-confirm-ic.ic-reopen { background: var(--fc-amber-lt); color: var(--fc-amber); }
    .op-confirm-title { font-size: 16px; font-weight: 800; color: var(--fc-text); }
    .op-confirm-op {
        display: inline-block; margin-top: 6px; padding: 3px 12px;
        border-radius: 999px; background: var(--fc-blue-lt);
        color: var(--fc-blue); font-size: 12px; font-weight: 800;
    }
    .op-confirm-msg { margin: 12px 0 18px; font-size: 13px; line-height: 1.7; color: var(--fc-muted); }
    .op-confirm-btns { display: flex; gap: 10px; }
    .op-confirm-btn {
        flex: 1; padding: 10px 0; border-radius: 10px;
        font-size: 13.5px; font-weight: 800; cursor: pointer;
        font-family: inherit;
        border: 1.5px solid var(--fc-border); background: #fff; color: var(--fc-text);
    }
    .op-confirm-btn.btn-cancel:hover { background: #f6f8fb; }
    .op-confirm-btn.btn-do-close  { background: var(--fc-red);   border-color: var(--fc-red);   color: #fff; }
