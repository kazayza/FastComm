    /* ملحوظة: قواعد .fc-fab-container/.fc-fab-menu اللي كانت هنا من بلوك العمليات
       (z-index:1000 !important) اتشالت — كانت بتنزّل الزر تحت طبقة الـ scrim (1200)
       فالزر وقائمته بيبقوا تحت طبقة شفافة والضغطات بتروح للـ scrim.
       تعريفات الـ FAB المعتمدة هي بتاعة بلوك الموانئ تحت (حاوية 1300 فوق سكريم 1200). */

    .fc-glow-gold {
        position: relative;
        background: linear-gradient(135deg, #0B56DF 0%, #083CA8 100%) !important;
        border: 2px solid #FF8015 !important;
        color: #fff;
        box-shadow: 0 4px 16px rgba(11, 86, 223, .4);
        animation: fc-gold-pulse-op 2.2s infinite;
    }

    .fc-glow-gold::before {
        content: "";
        position: absolute; inset: -2px;
        border-radius: 50%;
        border: 2px solid #FF8015;
        opacity: 0; pointer-events: none;
        animation: fc-ring-expand-op 2.2s cubic-bezier(.24,0,.38,1) infinite;
    }

    @@keyframes fc-gold-pulse-op {
        0%, 100% { box-shadow: 0 0 0 0 rgba(255,128,21,.6), 0 8px 24px rgba(11,86,223,.4); }
        50%      { box-shadow: 0 0 0 12px rgba(255,128,21,0), 0 12px 32px rgba(11,86,223,.55); }
    }

    @@keyframes fc-ring-expand-op {
