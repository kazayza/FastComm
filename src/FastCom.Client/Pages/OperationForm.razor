    .fin-green { color: var(--fc-green); }
    .fin-red   { color: var(--fc-red); }

    .fin-sum-div {
        height: 1px; background: #c8d8fb; margin: 4px 0;
    }

    .fin-sum-profit {
        border: 2px solid; border-radius: 9px; padding: 10px 12px;
