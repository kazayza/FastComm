    .profit-pos { border-color: #b0e0c5; background: var(--fc-green-lt); color: var(--fc-green); }
    .profit-neg { border-color: #ffc8cf; background: var(--fc-red-lt);   color: var(--fc-red); }
    .profit-pos strong, .profit-neg strong { font-size: 16px !important; }

    /* ================================================================
       BOTTOM ACTIONS
    ================================================================ */
    .opf-bottom-actions {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; padding: 14px 20px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 2px 8px rgba(15,41,82,.04);
    }

    .opf-bottom-back {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .opf-bottom-back:hover { background: #f0f4fa; color: var(--fc-text); }
    .opf-bottom-back svg { transform: rotate(180deg); }

    .opf-bottom-right { display: flex; align-items: center; gap: 10px; }

    .opf-next-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .opf-next-btn:hover { background: var(--fc-blue); color: #fff; }
    .opf-next-btn svg { transform: rotate(180deg); }

    .opf-bottom-save {
        display: inline-flex; align-items: center; gap: 8px;
        height: 40px; padding: 0 22px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(30,110,245,.30);
        transition: all .15s ease;
    }
    .opf-bottom-save:hover:not(:disabled) {
        transform: translateY(-1px); box-shadow: 0 6px 18px rgba(30,110,245,.38);
    }
    .opf-bottom-save:disabled { opacity: .6; cursor: not-allowed; }

    /* ================================================================
       SPINNER
    ================================================================ */
    .btn-spinner {
        width: 15px; height: 15px;
        border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
        border-radius: 50%; animation: opf-spin .7s linear infinite;
    }
    .btn-spinner.sm { width: 13px; height: 13px; }

    /* ================================================================
       RESPONSIVE
    ================================================================ */
    @@media (max-width: 1000px) {
        .opf-rc-body { grid-template-columns: 1fr 1fr 1fr; }
        .opf-desc-field { grid-column: 1 / -1; }
    }

    @@media (max-width: 900px) {
        .opf-form-grid { grid-template-columns: 1fr; }
        .tab-section { padding: 18px 16px 22px; }
        .op-hero-summary { flex-wrap: wrap; }
        .op-sum-item { flex: 0 0 50%; }
        .op-sum-div:nth-child(4) { display: none; }
        .total-bar-nums { flex-wrap: wrap; gap: 8px; }
        .total-item { flex: 0 0 45%; }
        .total-sep { display: none; }
    }

    @@media (max-width: 680px) {
        .opf-body { padding: 10px 12px 24px; }
        .opf-rc-body { grid-template-columns: 1fr 1fr; }
        .opf-desc-field { grid-column: 1 / -1; }
        .opf-bottom-actions { flex-direction: column; }
        .opf-bottom-back, .opf-bottom-save { width: 100%; justify-content: center; }
        .opf-bottom-right { width: 100%; flex-direction: column; }
        .opf-next-btn { width: 100%; justify-content: center; }
        .op-sum-item { flex: 0 0 100%; }
        .op-sum-div { display: none; }
        .opf-booking-picker { flex-direction: column; align-items: flex-start; }
        .booking-picker-select-wrap { width: 100%; }
    }

    @@media (max-width: 480px) {
        .opf-rc-body { grid-template-columns: 1fr; }
        .op-hero-summary { display: none; }
        .opf-rc-head { flex-wrap: wrap; }
    }

