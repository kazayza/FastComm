    .opf-rev-card:hover {
        border-color: #c8d8f0; box-shadow: 0 4px 14px rgba(15,41,82,.06);
    }

    /* Card Header */
    .opf-rc-head {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 14px;
        background: linear-gradient(180deg, #f0f5fc, #eaf1f9);
        border-bottom: 1px solid #dce8f5;
        flex-wrap: wrap;
    }

    .opf-rc-num {
        width: 26px; height: 26px; border-radius: 8px; flex: 0 0 26px;
        display: flex; align-items: center; justify-content: center;
        background: var(--fc-green); color: #fff;
        font-size: 11px; font-weight: 900;
        font-family: "Inter", Arial, sans-serif;
    }

    .opf-rc-service-badge {
        display: flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 7px;
        background: rgba(22,163,91,.08); border: 1px solid rgba(22,163,91,.15);
        color: var(--fc-green); font-size: 11px; font-weight: 800; white-space: nowrap;
    }

    .opf-rc-total {
        flex: 1; font-size: 11px; color: #6b7d95; font-weight: 600;
    }
    .opf-rc-total strong { color: var(--fc-text); font-weight: 900; font-size: 13px; }
    .opf-rc-total span   { color: #9aaabb; font-size: 10px; }

    .opf-rc-suggest {
        display: inline-flex; align-items: center; gap: 5px;
        height: 28px; padding: 0 10px;
        border: 1px solid #bdd4fc; border-radius: 7px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 10px; font-weight: 800;
        cursor: pointer; white-space: nowrap;
        transition: all .12s ease;
    }
    .opf-rc-suggest:hover { background: var(--fc-blue); color: #fff; }

    .opf-rc-del {
        width: 28px; height: 28px; border-radius: 7px; flex: 0 0 28px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; background: transparent;
        color: var(--fc-red); cursor: pointer; transition: all .15s ease;
    }
    .opf-rc-del:hover { background: var(--fc-red-lt); border-color: #ffc8cf; }

    /* Card Body */
    .opf-rc-body {
        display: grid;
        grid-template-columns: 1.4fr 2fr 1fr 1fr 1fr 1fr;
        gap: 12px; padding: 14px 16px;
        align-items: start;
    }

    .opf-desc-field { grid-column: 2; }

    /* Qty Control */
    .opf-qty-control {
        display: flex; align-items: center;
        border: 1px solid #d8e2f0; border-radius: 9px;
        overflow: hidden; background: #fafcff;
    }

    .qty-btn {
        width: 34px; height: 42px; flex: 0 0 34px;
        display: flex; align-items: center; justify-content: center;
        border: none; background: transparent;
        cursor: pointer; font-size: 18px; font-weight: 900;
        transition: background .12s ease;
    }
    .qty-minus { color: var(--fc-red);  border-left: 1px solid #d8e2f0; }
    .qty-plus  { color: var(--fc-green); border-right: 1px solid #d8e2f0; }
    .qty-minus:hover { background: var(--fc-red-lt); }
    .qty-plus:hover  { background: var(--fc-green-lt); }

    .qty-input {
        flex: 1; text-align: center; border: none !important;
        border-radius: 0 !important; background: transparent !important;
        box-shadow: none !important; font-weight: 800; font-size: 13px;
    }

    /* Line Summary */
    .opf-rc-summary {
        display: flex; align-items: center;
        padding: 8px 16px;
        background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        border-top: 1px solid #dce8f5;
        gap: 0;
    }

    .rc-sum-item {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; gap: 2px; padding: 0 10px;
    }
    .rc-sum-item span   { font-size: 9px; color: #9aaabb; font-weight: 600; }
    .rc-sum-item strong { font-size: 13px; font-weight: 800; color: var(--fc-text); font-family: "Inter", Arial, sans-serif; }
    .rc-sum-total strong { color: var(--fc-blue); font-size: 14px; }

    .rc-sum-sep { width: 1px; height: 30px; background: #dde5f0; flex: 0 0 1px; }

    /* Total Bar */
    .opf-total-bar {
        display: flex; align-items: center; justify-content: space-between;
        gap: 20px; margin-top: 14px; padding: 16px 20px;
        background: linear-gradient(135deg, #f3f8ff, #eaf3ff);
        border: 1px solid #bdd4fc; border-radius: 12px;
