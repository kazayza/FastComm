    .dot-from     { background: var(--fc-blue-lt);  border-color: var(--fc-blue); }
    .dot-to       { background: var(--fc-green-lt); border-color: var(--fc-green); }

    .route-label    { display: flex; flex-direction: column; gap: 2px; }
    .route-caption  { font-size: 9px; font-weight: 600; color: #8899ae; }
    .route-label strong { font-size: 13px; font-weight: 800; color: var(--fc-text); }

    .route-line  {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; gap: 0; margin: 0 10px; position: relative;
    }
    .route-truck { font-size: 20px; margin-top: -4px; }

    /* ================================================================
       REVENUE LINES
    ================================================================ */
    .opf-lines-empty {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 10px; min-height: 180px;
        border: 2px dashed #d8e8f8; border-radius: 12px;
        background: #f8fbff; text-align: center; padding: 30px;
    }

    .lines-empty-icon {
        width: 70px; height: 70px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #edf3fb; color: #b0c4d8;
    }
    .lines-empty-title { font-size: 14px; font-weight: 800; color: var(--fc-text); }
    .lines-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    .opf-add-line-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 14px;
        border: 1.5px solid var(--fc-green); border-radius: 9px;
        background: var(--fc-green-lt); color: var(--fc-green);
        font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; white-space: nowrap; flex-shrink: 0;
        transition: all .15s ease;
    }
    .opf-add-line-btn:hover { background: var(--fc-green); color: #fff; }
    .opf-add-line-btn.mt-10 { margin-top: 10px; }

    .opf-rev-cards { display: flex; flex-direction: column; gap: 14px; }

    .opf-rev-card {
        border: 1px solid #e4edf8; border-radius: 12px;
        background: linear-gradient(180deg, #fafcff, #f5f8fb);
