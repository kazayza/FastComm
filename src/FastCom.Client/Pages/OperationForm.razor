    /* ── Helpers ── */
    private static string StatusAr(string s) => s switch
    {
        "Pending"        => "قيد الانتظار",
        "Assigned"       => "تم التعيين",
        "DriverReceived" => "استلم السائق",
        "InTransit"      => "في الطريق",
        "Delivered"      => "تم التسليم",
        "Closed"         => "مغلقة",
        "Cancelled"      => "ملغاة",
        _                => s
    };

    private static string StatusBadgeClass(string s) => s switch
    {
        "Pending"        => "badge-pending",
        "Assigned"       => "badge-assigned",
        "InTransit"      => "badge-intransit",
        "Delivered"      => "badge-delivered",
        "Closed"         => "badge-closed",
        "Cancelled"      => "badge-cancelled",
        _                => "badge-pending"
    };

    private static decimal? ParseDec(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n >= 0 ? n : null;

    private decimal RateOf(RevRow ln) =>
        ln.TaxRateId is null ? 0m : _taxRates.FirstOrDefault(x => x.Id == ln.TaxRateId.Value)?.Value ?? 0m;

    private decimal LineNet(RevRow ln)   => ln.Qty * ln.UnitPrice - ln.Discount;
    private decimal LineGross(RevRow ln) => LineNet(ln) + LineNet(ln) * RateOf(ln) / 100m;

    private decimal TotalNet => _lines.Sum(LineNet);
    private decimal TotalTax => _lines.Sum(ln => LineNet(ln) * RateOf(ln) / 100m);

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id   = Id;
        if (!CanSave) return;

        _loading = true;
        try
        {
            _customers    = await SafeGet("api/options/customers");
            _services     = await SafeGet("api/options/services");
            _ports        = await SafeGet("api/options/ports");
            _destinations = await SafeGet("api/options/destinations");
            _tripTypes    = await SafeGet("api/options/trip-types");
            try { _taxRates = await Http.GetFromJsonAsync<List<TaxOpt>>("api/options/tax-rates") ?? new(); }
            catch { _taxRates = new(); }

            if (_id is not null) await LoadOperationAsync(_id.Value);
            else
            {
                _bookings = await SafeGetBk("api/operations/available-bookings");
                AddLine();
            }
        }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; _ok = false; }
        finally { _loading = false; }
    }

    private async Task<List<Opt>> SafeGet(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Opt>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task<List<Bk>> SafeGetBk(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Bk>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task LoadOperationAsync(long id)
    {
        var d = await Http.GetFromJsonAsync<DetailResponse>($"api/operations/{id}");
        if (d is null) { _msg = "العملية مش موجودة"; _ok = false; return; }

        OpNumber = d.Operation.OperationNumber;
        _status  = d.Operation.Status;
        _locked  = _status is "Closed" or "Cancelled";

        _f = new Form
        {
            BookingId     = d.Operation.BookingId,
            CustomerId    = d.Operation.CustomerId,
            ServiceId     = d.Operation.ServiceId,
            PortId        = d.Operation.PortId,
            DestinationId = d.Operation.DestinationId,
            TripTypeId    = d.Operation.TripTypeId,
            PlannedDate   = d.Operation.PlannedDate,
            EstimatedCost = d.Operation.EstimatedCost,
            Notes         = d.Operation.Notes
        };

        _lines = d.RevenueLines.Select(r => new RevRow
        {
            ServiceId   = r.ServiceId,
            Description = r.Description,
            Qty         = r.Quantity,
            UnitPrice   = r.UnitPrice,
            Discount    = r.Discount,
            TaxRateId   = r.TaxRateId,
            PriceRuleId = r.PriceRuleId
        }).ToList();

        if (_lines.Count == 0) AddLine();
    }

    private void AddLine() => _lines.Add(new RevRow { ServiceId = _f.ServiceId ?? 0, Qty = 1 });

    private void RemoveLine(RevRow ln) => _lines.Remove(ln);

    private void OnCustomerChanged(ChangeEventArgs e)
    {
        _f.CustomerId = int.TryParse(e.Value?.ToString(), out var n) ? n : 0;
        _priceSource  = null;
    }

    private async Task OnBookingPicked(ChangeEventArgs e)
    {
        _selectedBooking = e.Value?.ToString() ?? "";
        if (!long.TryParse(_selectedBooking, out var bkId) || bkId <= 0)
        { _f.BookingId = null; return; }

        try
        {
            var d = await Http.GetFromJsonAsync<BookingDetail>($"api/bookings/{bkId}");
            if (d is null) return;

            _f.BookingId     = bkId;
            _f.CustomerId    = d.Booking.CustomerId;
            _f.ServiceId     = d.Booking.ServiceId;
            _f.PortId        = d.Booking.PortId;
            _f.DestinationId = d.Booking.DestinationId;
            _f.TripTypeId    = d.Booking.TripTypeId;
            if (d.Booking.RequestedDate is not null)
                _f.PlannedDate = d.Booking.RequestedDate + "T08:00";

            _lines.Clear();
            var row = new RevRow { ServiceId = d.Booking.ServiceId ?? 0, Qty = 1 };
            _lines.Add(row);
            await SuggestAsync(row);
        }
        catch (Exception ex) { _msg = "فشل قراءة الحجز: " + ex.Message; _ok = false; }
    }

    private async Task SuggestAsync(RevRow ln)
    {
        if (_f.CustomerId <= 0) { _msg = "اختار العميل الأول"; _ok = false; return; }
        if (ln.ServiceId <= 0)  { _msg = "اختار الخدمة في السطر"; _ok = false; return; }

        var url = $"api/operations/price-suggest?customerId={_f.CustomerId}&serviceId={ln.ServiceId}" +
                  (_f.PortId        is not null ? $"&portId={_f.PortId}" : "") +
                  (_f.DestinationId is not null ? $"&destinationId={_f.DestinationId}" : "") +
                  (_f.TripTypeId    is not null ? $"&tripTypeId={_f.TripTypeId}" : "");

        try
        {
            var s = await Http.GetFromJsonAsync<Suggestion>(url);
            if (s is null) return;

            ln.UnitPrice   = s.UnitPrice;
            ln.TaxRateId   = s.TaxRateId;
            ln.PriceRuleId = s.PriceRuleId;
            if (string.IsNullOrWhiteSpace(ln.Description))
                ln.Description = _services.FirstOrDefault(x => x.Id == ln.ServiceId)?.Label;
            if (s.CostPrice is not null && s.CostPrice > 0)
                _f.EstimatedCost = s.CostPrice.Value;

            _priceSource = s.Source;
            _msg = null;
        }
        catch (Exception ex) { _msg = "فشل اقتراح السعر: " + ex.Message; _ok = false; }
    }

    private void GoBack() => Nav.NavigateTo("/operations");

    private async Task SaveAsync()
    {
        _triedSave = true;
        _msg       = null;

        if (_f.CustomerId <= 0)
        {
            _ok = false; _msg = "لازم تختار العميل"; _activeTab = 0; return;
        }

        var lines = _lines.Where(l => l.ServiceId > 0 && l.Qty > 0).ToList();
        if (lines.Count == 0)
        {
            _ok = false; _msg = "ضيف سطر إيراد واحد على الأقل"; _activeTab = 1; return;
        }

        var payload = new
        {
            bookingId     = _f.BookingId,
            customerId    = _f.CustomerId,
            serviceId     = _f.ServiceId,
            portId        = _f.PortId,
            destinationId = _f.DestinationId,
            tripTypeId    = _f.TripTypeId,
            plannedDate   = _f.PlannedDate,
            estimatedCost = _f.EstimatedCost,
            notes         = _f.Notes,
            revenueLines  = lines.Select(l => new
            {
                serviceId   = l.ServiceId,
                description = l.Description,
                quantity    = l.Qty,
                unitPrice   = l.UnitPrice,
                discount    = l.Discount,
                taxRateId   = l.TaxRateId,
                priceRuleId = l.PriceRuleId
            })
        };

        _saving = true;
        try
        {
            var res = _id is null
                ? await Http.PostAsJsonAsync("api/operations", payload)
                : await Http.PutAsJsonAsync($"api/operations/{_id}", payload);

            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(msg, Severity.Success);
                Nav.NavigateTo("/operations");
            }
            else { _ok = false; _msg = msg; }
        }
        catch (Exception ex) { _ok = false; _msg = "مش قادر أوصل للسيرفر: " + ex.Message; }
        finally { _saving = false; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}