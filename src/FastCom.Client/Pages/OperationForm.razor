    .tab-section-icon.green  { background: var(--fc-green-lt); color: var(--fc-green);  border: 1px solid #b0e0c5; }
    .tab-section-icon.purple { background: var(--fc-purple-lt); color: var(--fc-purple); border: 1px solid #d0bfef; }

