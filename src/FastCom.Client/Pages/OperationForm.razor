@page "/operations/new"
@page "/operations/new/{Id:long}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "عملية جديدة" : "تعديل عملية") — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">

            <div>
                <div class="fc-crumb">التشغيل · العمليات</div>
                <h1 class="fc-hero-title">
                    @if (_id is null)
                    {
                        <span>عملية جديدة</span>
                        <span class="op-hero-badge badge-new">جديدة</span>
                    }
                    else
                    {
                        <span>@OpNumber</span>
                        <span class="op-hero-badge @StatusBadgeClass(_status)">@StatusAr(_status)</span>
                    }
                </h1>
                <p class="fc-hero-sub">الإيراد والتكلفة بيتحسبوا تلقائي — الرقم بيتولد (OP-)</p>
            </div>

            <div class="fc-head-actions">
                <button class="op-back-btn" @onclick="GoBack">
                    <svg viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    العمليات
                </button>
                @if (CanSave && !_locked)
                {
                    <button class="op-save-btn"
                            @onclick="SaveAsync"
                            disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ العملية</span>
                        }
                    </button>
                }
            </div>

        </div>

        @* ── ملخص العملية في التعديل ── *@
        @if (_id is not null && !_loading)
        {
            <div class="op-hero-summary">

                <div class="op-sum-item">
                    <div class="op-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div class="op-sum-text">
                        <div class="op-sum-label">العميل</div>
                        <div class="op-sum-val">
                            @(_customers.FirstOrDefault(c => c.Id == _f.CustomerId)?.Label ?? "—")
                        </div>
                    </div>
                </div>

                <div class="op-sum-div" aria-hidden="true"></div>

                <div class="op-sum-item">
                    <div class="op-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"/>
                            <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                        </svg>
                    </div>
                    <div class="op-sum-text">
                        <div class="op-sum-label">الإيراد الصافي</div>
                        <div class="op-sum-val sum-green">@TotalNet.ToString("N2")</div>
                    </div>
                </div>

                <div class="op-sum-div" aria-hidden="true"></div>

                <div class="op-sum-item">
                    <div class="op-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2a10 10 0 100 20A10 10 0 0012 2z"/>
                            <path d="M12 8v4l3 3" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="op-sum-text">
                        <div class="op-sum-label">التاريخ المخطط</div>
                        <div class="op-sum-val">@(_f.PlannedDate?.Substring(0, 10) ?? "غير محدد")</div>
                    </div>
                </div>

                <div class="op-sum-div" aria-hidden="true"></div>

                <div class="op-sum-item">
                    <div class="op-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="op-sum-text">
                        <div class="op-sum-label">الحالة</div>
                        <div class="op-sum-val">@StatusAr(_status)</div>
                    </div>
                </div>

            </div>
        }

    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="opf-body">

    @* No Permission *@
    @if (!CanCreate && _id is null)
    {
        <div class="opf-state-box">
            <div class="opf-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية إنشاء عملية جديدة</p>
            <button class="opf-state-back" @onclick="GoBack">العودة للقائمة</button>
        </div>
    }

    @* Loading *@
    else if (_loading)
    {
        <div class="opf-loading-wrap">
            <div class="opf-spinner" aria-label="جاري التحميل"></div>
            <div class="opf-loading-text">جاري تحميل بيانات العملية...</div>
        </div>
    }

    @* MAIN FORM *@
    else
    {
        @* Locked Banner *@
        @if (_locked)
        {
            <div class="opf-locked-banner" role="alert">
                <div class="locked-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="locked-text">
                    <strong>العملية مقفولة للتعديل</strong>
                    <span>الحالة «@StatusAr(_status)» — العملية في هذه الحالة لا تقبل التعديل</span>
                </div>
            </div>
        }

        @* Error/Success Banner *@
        @if (_msg is not null)
        {
            <div class="opf-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                <div aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="banner-close" @onclick="() => _msg = null">✕</button>
            </div>
        }


        @* ── Booking Picker (إضافة فقط) ── *@
        @if (_id is null && _bookings.Count > 0)
        {
            <div class="opf-booking-picker">
                <div class="booking-picker-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    </svg>
                </div>
                <div class="booking-picker-text">
                    <div class="booking-picker-title">من حجز مؤكد</div>
                    <div class="booking-picker-sub">اختار حجز وسيتم ملء البيانات تلقائياً</div>
                </div>
                <div class="booking-picker-select-wrap">
                    <svg class="bp-select-icon" viewBox="0 0 24 24" width="14" height="14"
                         fill="none" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2"/>
                        <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                    </svg>
                    <select class="booking-picker-select"
                            value="@_selectedBooking"
                            @onchange="OnBookingPicked">
                        <option value="">— عملية مستقلة من غير حجز —</option>
                        @foreach (var b in _bookings)
                        {
                            <option value="@b.BookingId">
                                @b.BookingNumber — @b.CustomerName
                            </option>
                        }
                    </select>
                </div>
            </div>
        }


        @* ═══════ TABS ═══════ *@
        <div class="opf-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="opf-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="opf-mud-tabs">


                @* ══════════════════════════════════════
                   TAB 1 — بيانات العملية
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="otab-label">
                            <div class="otab-icon otab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                </svg>
                            </div>
                            <span>بيانات العملية</span>
                            @if (HasTabError(1))
                            {
                                <span class="otab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon blue" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                                        <path d="M16 8h4l3 3v5h-7V8z"/>
                                        <circle cx="5.5" cy="18.5" r="2.5"/>
                                        <circle cx="18.5" cy="18.5" r="2.5"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">بيانات العملية الأساسية</div>
                                    <div class="tab-section-sub">العميل والتاريخ والمسار والتكلفة التقديرية</div>
                                </div>
                            </div>

                            <div class="opf-form-grid">

                                @* العميل *@
                                <div class="form-field">
                                    <label class="field-label" for="customer">
                                        العميل
                                        <span class="field-required" aria-label="مطلوب">*</span>
                                    </label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        <select id="customer"
                                                class="field-input field-select @(_f.CustomerId == 0 && _triedSave ? "field-error" : "")"
                                                value="@_f.CustomerId"
                                                disabled="@_locked"
                                                @onchange="OnCustomerChanged"
                                                aria-required="true">
                                            <option value="0">— اختار العميل —</option>
                                            @foreach (var c in _customers)
                                            {
                                                <option value="@c.Id">@c.Label</option>
                                            }
                                        </select>
                                    </div>
                                    @if (_f.CustomerId == 0 && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">اختيار العميل مطلوب</div>
                                    }
                                </div>

                                @* التاريخ المخطط *@
                                <div class="form-field">
                                    <label class="field-label" for="plandate">التاريخ المخطط</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="plandate"
                                               type="datetime-local"
                                               class="field-input with-prefix"
                                               value="@_f.PlannedDate"
                                               disabled="@_locked"
                                               @onchange="e => _f.PlannedDate = e.Value?.ToString()" />
                                    </div>
                                </div>

                                @* نوع الرحلة *@
                                <div class="form-field">
                                    <label class="field-label" for="triptype">نوع الرحلة</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"/>
                                            <path d="M12 8v4l3 3" stroke-linecap="round"/>
                                        </svg>
                                        <select id="triptype"
                                                class="field-input field-select"
                                                @bind="_f.TripTypeId"
                                                disabled="@_locked">
                                            <option value="">— اختار النوع —</option>
                                            @foreach (var t in _tripTypes)
                                            {
                                                <option value="@t.Id">@t.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                @* التكلفة التقديرية *@
                                <div class="form-field">
                                    <label class="field-label" for="estcost">التكلفة التقديرية</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                        <input id="estcost"
                                               type="number" min="0" step="0.01"
                                               class="field-input with-prefix"
                                               value="@_f.EstimatedCost"
                                               disabled="@_locked"
                                               placeholder="0.00"
                                               @onchange="e => _f.EstimatedCost = ParseDec(e.Value) ?? 0m" />
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        بيتملى تلقائياً من اقتراح السعر
                                    </div>
                                </div>

                                @* من (الميناء) *@
                                <div class="form-field">
                                    <label class="field-label" for="port">من (الميناء)</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                            <path d="M9 22V12h6v10"/>
                                        </svg>
                                        <select id="port"
                                                class="field-input field-select"
                                                @bind="_f.PortId"
                                                disabled="@_locked">
                                            <option value="">— اختار الميناء —</option>
                                            @foreach (var p in _ports)
                                            {
                                                <option value="@p.Id">@p.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                @* إلى (الجهة) *@
                                <div class="form-field">
                                    <label class="field-label" for="dest">إلى (الجهة)</label>
                                    <div class="field-select-wrap">
                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                             width="14" height="14" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        <select id="dest"
                                                class="field-input field-select"
                                                @bind="_f.DestinationId"
                                                disabled="@_locked">
                                            <option value="">— اختار الجهة —</option>
                                            @foreach (var d in _destinations)
                                            {
                                                <option value="@d.Id">@d.Label</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                            </div>

                            @* Route Visual *@
                            @if (_f.PortId.HasValue && _f.DestinationId.HasValue)
                            {
                                <div class="opf-route-visual">
                                    <div class="route-point">
                                        <div class="route-dot dot-from" aria-hidden="true"></div>
                                        <div class="route-label">
                                            <span class="route-caption">ميناء الإقلاع</span>
                                            <strong>@(_ports.FirstOrDefault(p => p.Id == _f.PortId)?.Label ?? "—")</strong>
                                        </div>
                                    </div>
                                    <div class="route-line" aria-hidden="true">
                                        <svg viewBox="0 0 100 20" width="100" height="20"
                                             preserveAspectRatio="none">
                                            <path d="M0 10 Q50 2 100 10" fill="none"
                                                  stroke="#1e6ef5" stroke-width="1.5"
                                                  stroke-dasharray="4 3"/>
                                        </svg>
                                        <div class="route-truck" aria-hidden="true">🚛</div>
                                    </div>
                                    <div class="route-point">
                                        <div class="route-dot dot-to" aria-hidden="true"></div>
                                        <div class="route-label">
                                            <span class="route-caption">جهة الوصول</span>
                                            <strong>@(_destinations.FirstOrDefault(d => d.Id == _f.DestinationId)?.Label ?? "—")</strong>
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 2 — سطور الإيراد
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="otab-label">
                            <div class="otab-icon otab-green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23"/>
                                    <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                </svg>
                            </div>
                            <span>سطور الإيراد</span>
                            @if (_lines.Count > 0)
                            {
                                <span class="otab-count">@_lines.Count</span>
                            }
                            @if (HasTabError(2))
                            {
                                <span class="otab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon green" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="1" x2="12" y2="23"/>
                                        <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                    </svg>
                                </div>
                                <div style="flex:1">
                                    <div class="tab-section-title">سطور الإيراد</div>
                                    <div class="tab-section-sub">
                                        @if (_priceSource is not null)
                                        {
                                            <span>مصدر السعر المقترح: <strong>@_priceSource</strong></span>
                                        }
                                        else
                                        {
                                            <span>السعر بييجي من قواعد تسعير العميل — تقدر تعدّله</span>
                                        }
                                    </div>
                                </div>
                                @if (!_locked)
                                {
                                    <button class="opf-add-line-btn" @onclick="AddLine">
                                        <svg viewBox="0 0 24 24" width="15" height="15"
                                             fill="none" stroke="currentColor" stroke-width="2.5"
                                             aria-hidden="true">
                                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                        </svg>
                                        أضف سطر
                                    </button>
                                }
                            </div>

                            @* ── Revenue Line Cards ── *@
                            @if (_lines.Count == 0)
                            {
                                <div class="opf-lines-empty">
                                    <div class="lines-empty-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="40" height="40"
                                             fill="none" stroke="currentColor" stroke-width="1.4">
                                            <line x1="12" y1="1" x2="12" y2="23"/>
                                            <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                        </svg>
                                    </div>
                                    <div class="lines-empty-title">لا توجد سطور إيراد</div>
                                    <div class="lines-empty-sub">أضف سطر إيراد واحد على الأقل</div>
                                    @if (!_locked)
                                    {
                                        <button class="opf-add-line-btn mt-10" @onclick="AddLine">
                                            <svg viewBox="0 0 24 24" width="15" height="15"
                                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                                 aria-hidden="true">
                                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                            </svg>
                                            أضف سطر
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="opf-rev-cards">

                                    @foreach (var ln in _lines)
                                    {
                                        var idx      = _lines.IndexOf(ln);
                                        var lineNet   = LineNet(ln);
                                        var lineGross = LineGross(ln);

                                        <div class="opf-rev-card">

                                            @* Card Header *@
                                            <div class="opf-rc-head">
                                                <div class="opf-rc-num">@(idx + 1)</div>
                                                <div class="opf-rc-service-badge">
                                                    <svg viewBox="0 0 24 24" width="12" height="12"
                                                         fill="none" stroke="currentColor" stroke-width="2"
                                                         aria-hidden="true">
                                                        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                                        <path d="M2 17l10 5 10-5M2 12l10 5 10-5"
                                                              stroke-linecap="round"/>
                                                    </svg>
                                                    @(_services.FirstOrDefault(s => s.Id == ln.ServiceId)?.Label ?? "اختار الخدمة")
                                                </div>
                                                <div class="opf-rc-total">
                                                    إجمالي السطر:
                                                    <strong>@lineGross.ToString("N2")</strong>
                                                    <span>(صافي @lineNet.ToString("N2"))</span>
                                                </div>
                                                @if (!_locked)
                                                {
                                                    <button class="opf-rc-suggest"
                                                            @onclick="() => SuggestAsync(ln)"
                                                            title="اقتراح السعر"
                                                            aria-label="اقتراح السعر للسطر @(idx + 1)">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="11" cy="11" r="8"/>
                                                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                                        </svg>
                                                        اقتراح
                                                    </button>
                                                    <button class="opf-rc-del"
                                                            @onclick="() => RemoveLine(ln)"
                                                            title="حذف السطر"
                                                            aria-label="حذف السطر @(idx + 1)">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            </div>

                                            @* Card Body *@
                                            <div class="opf-rc-body">

                                                <div class="form-field">
                                                    <label class="field-label">الخدمة</label>
                                                    <div class="field-select-wrap">
                                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                                             width="13" height="13" fill="none"
                                                             stroke="currentColor" stroke-width="2"
                                                             aria-hidden="true">
                                                            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                                            <path d="M2 17l10 5 10-5M2 12l10 5 10-5"
                                                                  stroke-linecap="round"/>
                                                        </svg>
                                                        <select class="field-input field-select"
                                                                @bind="ln.ServiceId"
                                                                disabled="@_locked">
                                                            <option value="0">— اختار —</option>
                                                            @foreach (var s in _services)
                                                            {
                                                                <option value="@s.Id">@s.Label</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="form-field opf-desc-field">
                                                    <label class="field-label">البيان</label>
                                                    <input class="field-input"
                                                           value="@ln.Description"
                                                           disabled="@_locked"
                                                           maxlength="300"
                                                           placeholder="وصف الخدمة..."
                                                           @onchange="e => ln.Description = e.Value?.ToString()" />
                                                </div>

                                                <div class="form-field">
                                                    <label class="field-label">الكمية</label>
                                                    <div class="opf-qty-control">
                                                        @if (!_locked)
                                                        {
                                                            <button class="qty-btn qty-minus"
                                                                    @onclick="() => { if (ln.Qty > 1) ln.Qty -= 1; }"
                                                                    aria-label="تقليل">−</button>
                                                        }
                                                        <input type="number" min="0.001" step="0.001"
                                                               class="field-input qty-input"
                                                               value="@ln.Qty"
                                                               disabled="@_locked"
                                                               @onchange="e => ln.Qty = ParseDec(e.Value) ?? 1m" />
                                                        @if (!_locked)
                                                        {
                                                            <button class="qty-btn qty-plus"
                                                                    @onclick="() => ln.Qty += 1"
                                                                    aria-label="زيادة">+</button>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="form-field">
                                                    <label class="field-label">سعر الوحدة</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                                        <input type="number" min="0" step="0.01"
                                                               class="field-input with-prefix"
                                                               value="@ln.UnitPrice"
                                                               disabled="@_locked"
                                                               placeholder="0.00"
                                                               @onchange="e => ln.UnitPrice = ParseDec(e.Value) ?? 0m" />
                                                    </div>
                                                </div>

                                                <div class="form-field">
                                                    <label class="field-label">الخصم</label>
                                                    <div class="field-input-group">
                                                        <span class="field-prefix" aria-hidden="true">ج.م</span>
                                                        <input type="number" min="0" step="0.01"
                                                               class="field-input with-prefix"
                                                               value="@ln.Discount"
                                                               disabled="@_locked"
                                                               placeholder="0.00"
                                                               @onchange="e => ln.Discount = ParseDec(e.Value) ?? 0m" />
                                                    </div>
                                                </div>

                                                <div class="form-field">
                                                    <label class="field-label">الضريبة</label>
                                                    <div class="field-select-wrap">
                                                        <svg class="field-select-icon" viewBox="0 0 24 24"
                                                             width="13" height="13" fill="none"
                                                             stroke="currentColor" stroke-width="2"
                                                             aria-hidden="true">
                                                            <path d="M20 12V22H4V12M22 7H2v5h20V7zM12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
                                                        </svg>
                                                        <select class="field-input field-select"
                                                                @bind="ln.TaxRateId"
                                                                disabled="@_locked">
                                                            <option value="">0%</option>
                                                            @foreach (var t in _taxRates)
                                                            {
                                                                <option value="@t.Id">@t.Label</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>

                                            </div>

                                            @* Line Summary *@
                                            <div class="opf-rc-summary">
                                                <div class="rc-sum-item">
                                                    <span>صافي</span>
                                                    <strong>@lineNet.ToString("N2")</strong>
                                                </div>
                                                <div class="rc-sum-sep" aria-hidden="true"></div>
                                                <div class="rc-sum-item">
                                                    <span>ضريبة</span>
                                                    <strong>@((lineGross - lineNet).ToString("N2"))</strong>
                                                </div>
                                                <div class="rc-sum-sep" aria-hidden="true"></div>
                                                <div class="rc-sum-item rc-sum-total">
                                                    <span>الإجمالي</span>
                                                    <strong>@lineGross.ToString("N2")</strong>
                                                </div>
                                            </div>

                                        </div>
                                    }

                                </div>

                                @* ── Total Bar ── *@
                                <div class="opf-total-bar">
                                    <div class="total-bar-label">
                                        <svg viewBox="0 0 24 24" width="16" height="16"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <line x1="12" y1="1" x2="12" y2="23"/>
                                            <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                        </svg>
                                        الإجمالي الكلي
                                    </div>
                                    <div class="total-bar-nums">
                                        <div class="total-item">
                                            <span>صافي الإيراد</span>
                                            <strong class="total-green">@TotalNet.ToString("N2")</strong>
                                        </div>
                                        <div class="total-sep" aria-hidden="true"></div>
                                        <div class="total-item">
                                            <span>الضريبة</span>
                                            <strong>@TotalTax.ToString("N2")</strong>
                                        </div>
                                        <div class="total-sep" aria-hidden="true"></div>
                                        <div class="total-item total-grand">
                                            <span>الإجمالي مع الضريبة</span>
                                            <strong>@((TotalNet + TotalTax).ToString("N2"))</strong>
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 3 — الملاحظات والملخص
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="otab-label">
                            <div class="otab-icon otab-purple" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                            </div>
                            <span>الملاحظات</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon purple" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18"
                                         fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">الملاحظات والملخص المالي</div>
                                    <div class="tab-section-sub">ملاحظات العملية ومراجعة الأرقام قبل الحفظ</div>
                                </div>
                            </div>

                            @* ملاحظات *@
                            <div class="form-field">
                                <label class="field-label">ملاحظات العملية</label>
                                <textarea class="field-input field-textarea"
                                          rows="4"
                                          maxlength="1000"
                                          disabled="@_locked"
                                          placeholder="أي ملاحظات أو تفاصيل إضافية..."
                                          @onchange="e => _f.Notes = e.Value?.ToString()">@_f.Notes</textarea>
                            </div>

                            @* ملخص مالي *@
                            <div class="opf-fin-summary">
                                <div class="fin-summary-title">
                                    <svg viewBox="0 0 24 24" width="16" height="16"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         aria-hidden="true">
                                        <line x1="12" y1="1" x2="12" y2="23"/>
                                        <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                    </svg>
                                    الملخص المالي
                                </div>
                                <div class="fin-summary-grid">
                                    <div class="fin-sum-row">
                                        <span>صافي الإيراد</span>
                                        <strong class="fin-green">@TotalNet.ToString("N2") ج.م</strong>
                                    </div>
                                    <div class="fin-sum-row">
                                        <span>ضريبة الإيراد</span>
                                        <strong>@TotalTax.ToString("N2") ج.م</strong>
                                    </div>
                                    <div class="fin-sum-row">
                                        <span>إجمالي الإيراد</span>
                                        <strong>@((TotalNet + TotalTax).ToString("N2")) ج.م</strong>
                                    </div>
                                    <div class="fin-sum-div"></div>
                                    <div class="fin-sum-row">
                                        <span>التكلفة التقديرية</span>
                                        <strong class="fin-red">@_f.EstimatedCost.ToString("N2") ج.م</strong>
                                    </div>
                                    <div class="fin-sum-row fin-sum-profit @(TotalNet - _f.EstimatedCost >= 0 ? "profit-pos" : "profit-neg")">
                                        <span>الربح التقديري</span>
                                        <strong>@((TotalNet - _f.EstimatedCost).ToString("N2")) ج.م</strong>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


            </MudTabs>
        </div>


        @* ── Bottom Actions ── *@
        <div class="opf-bottom-actions">

            <button class="opf-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للقائمة
            </button>

            @if (CanSave && !_locked)
            {
                <div class="opf-bottom-right">

                    @if (_activeTab < 2)
                    {
                        <button class="opf-next-btn" @onclick="() => _activeTab++">
                            التالي
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    }

                    <button class="opf-bottom-save"
                            @onclick="SaveAsync"
                            disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ العملية</span>
                        }
                    </button>

                </div>
            }

        </div>

    }
</div>


@* ═══════════════════════════════════════════
   CSS
═══════════════════════════════════════════ *@
<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       HERO ADDITIONS
    ================================================================ */
    .op-hero-badge {
        display: inline-flex; align-items: center;
        padding: 3px 10px; border-radius: 20px;
        font-size: 11px; font-weight: 800;
    }

    .badge-new       { background: rgba(34,197,94,.2);  color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-pending   { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); border: 1px solid rgba(255,255,255,.2); }
    .badge-assigned  { background: rgba(59,130,246,.25); color: #93c5fd; border: 1px solid rgba(59,130,246,.3); }
    .badge-intransit { background: rgba(234,88,12,.25);  color: #fdba74; border: 1px solid rgba(234,88,12,.3); }
    .badge-delivered { background: rgba(20,184,166,.25); color: #99f6e4; border: 1px solid rgba(20,184,166,.3); }
    .badge-closed    { background: rgba(234,179,8,.25);  color: #fde68a; border: 1px solid rgba(234,179,8,.3); }
    .badge-cancelled { background: rgba(239,68,68,.25);  color: #fca5a5; border: 1px solid rgba(239,68,68,.3); }

    .op-back-btn {
        display: inline-flex; align-items: center; gap: 5px;
        height: 36px; padding: 0 13px;
        border: 1px solid rgba(255,255,255,.2); border-radius: 9px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .op-back-btn:hover { background: rgba(255,255,255,.14); }
    .op-back-btn svg  { transform: rotate(180deg); }

    .op-save-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 18px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .op-save-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }
    .op-save-btn:disabled { opacity: .6; cursor: not-allowed; }

    /* Hero Summary */
    .op-hero-summary {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px);
        margin-top: 4px;
    }

    .op-sum-item {
        flex: 1; display: flex; align-items: center; gap: 10px;
        padding: 12px 16px;
    }

    .op-sum-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }

    .op-sum-icon {
        width: 32px; height: 32px; flex: 0 0 32px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.10); color: rgba(255,255,255,.7);
    }

    .op-sum-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .op-sum-val   { font-size: 13px; font-weight: 800; color: #fff; margin-top: 2px; }
    .sum-green    { color: #6ee7b7; }

    /* ================================================================
       BODY
    ================================================================ */
    .opf-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 180px);
        padding: 16px 20px 32px;
        max-width: 1050px; width: 100%;
        margin: 0 auto;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* ================================================================
       STATES
    ================================================================ */
    .opf-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 280px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .opf-state-icon {
        width: 68px; height: 68px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .opf-state-icon.perm { background: #fff0f2; color: var(--fc-red); }

    .opf-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .opf-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    .opf-state-back {
        margin-top: 8px; padding: 9px 20px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-text);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .opf-state-back:hover { background: #f0f4fa; }

    /* ================================================================
       LOADING
    ================================================================ */
    .opf-loading-wrap {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 14px; min-height: 260px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .opf-spinner {
        width: 36px; height: 36px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: opf-spin .75s linear infinite;
    }
    @@keyframes opf-spin { to { transform: rotate(360deg); } }

    .opf-loading-text { font-size: 13px; font-weight: 600; color: var(--fc-muted); }

    /* ================================================================
       BANNERS
    ================================================================ */
    .opf-locked-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px; border-radius: 12px;
        background: linear-gradient(135deg, #fffbeb, #fff8e0);
        border: 1px solid #fde68a;
        box-shadow: 0 2px 10px rgba(234,179,8,.10);
    }

    .locked-icon  { flex: 0 0 auto; color: #d97706; }
    .locked-text  { display: flex; flex-direction: column; gap: 2px; }
    .locked-text strong { font-size: 13px; font-weight: 800; color: #92400e; }
    .locked-text span   { font-size: 11.5px; color: #b45309; }

    .opf-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600;
        animation: opf-banner-in .25s ease;
    }
    @@keyframes opf-banner-in {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .banner-success { background: #e9f8f0; color: #0e7a43; border: 1px solid #b5e8d0; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); border: 1px solid #ffc8d0; }

    .banner-close {
        margin-right: auto; background: none; border: none;
        color: inherit; opacity: .6; cursor: pointer; font-size: 13px;
    }
    .banner-close:hover { opacity: 1; }

    /* ================================================================
       BOOKING PICKER
    ================================================================ */
    .opf-booking-picker {
        display: flex; align-items: center; gap: 14px;
        padding: 14px 18px; border-radius: 12px;
        background: linear-gradient(135deg, #f5f8ff, #eef4ff);
        border: 1px solid #c8d8fb;
        flex-wrap: wrap;
    }

    .booking-picker-icon {
        width: 40px; height: 40px; flex: 0 0 40px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        border: 1px solid #bdd4fc;
    }

    .booking-picker-title { font-size: 13px; font-weight: 800; color: #1c2b43; }
    .booking-picker-sub   { font-size: 11px; color: var(--fc-muted); margin-top: 2px; }

    .booking-picker-select-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px;
    }

    .bp-select-icon {
        position: absolute; right: 12px; color: #9aaabb;
        pointer-events: none; z-index: 1;
    }

