        "EXPENSE"          => "مصروف",
        "INVOICE"          => "فاتورة",
        "CREDITNOTE"       => "إشعار دائن",
        "PAYMENT"          => "دفعة",
        "SUPPLIER_INVOICE" => "فاتورة مورد",
        "SUPPLIER_PAYMENT" => "دفعة مورد",
        "MAINTENANCE"      => "صيانة",
        "CASH_RECEIPT"     => "سند قبض",
        "CASH_PAYMENT"     => "سند صرف",
        "SHIPPING_AGENT"   => "وكيل ملاحي",
        _                  => t
    };

    private static string ResetAr(string r) => r switch
    {
        "Never"   => "أبداً",
        "Yearly"  => "سنوي",
        "Monthly" => "شهري",
        _         => r
    };

    private static string Example(NumberingDto s)
        => $"{s.Prefix}{s.CurrentNumber.ToString().PadLeft(s.NumberLength, '0')}";

    private record NumberingDto(
        string DocumentType,
        string Prefix,
        int    NumberLength,
        string ResetPeriod,
        int    CurrentNumber,
        short  Year
    );
}