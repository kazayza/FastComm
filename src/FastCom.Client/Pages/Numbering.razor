@page "/master/numbering"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>جدول الترقيم — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">البيانات الأساسية</div>
                <h1 class="fc-hero-title">جدول الترقيم</h1>
                <p class="fc-hero-sub">سلاسل أرقام المستندات — البادئة وطول الرقم ودورية التصفير</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="LoadAsync" Style="color:#9FB4CC" />
                @if (CanManage)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.DateRange" OnClick="OpenPrepare">
                        تجهيز سنة جديدة
                    </MudButton>
                }
            </div>
        </div>

        <div class="fc-kpis-glass">
            <div class="fc-kpi">
                <div class="fc-kpi-lb">سلاسل السنة</div>
                <div class="fc-kpi-num">@_items.Count</div>
            </div>
            <div class="fc-kpi">
                <div class="fc-kpi-lb">إجمالي الأرقام المصروفة</div>
                <div class="fc-kpi-num">@_items.Sum(i => i.CurrentNumber).ToString("N0")</div>
            </div>
            <div class="fc-kpi">
                <div class="fc-kpi-lb">السنة المعروضة</div>
                <div class="fc-kpi-num">@(_year ?? DateTime.UtcNow.Year)</div>
            </div>
        </div>
    </div>
</div>

<div class="fc-page">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">ليس لديك صلاحية عرض البيانات الأساسية.</MudAlert>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">

            @* ── تنبيه: الترقيم بيتم بـ Stored Procedure ── *@
            <div class="fc-alert fc-alert-info">
                <div class="fc-alert-ic"><MudIcon Icon="@Icons.Material.Filled.Info" /></div>
                <div class="fc-alert-body">
                    <div class="fc-alert-title">الأرقام بتتولّد تلقائيًا</div>
                    <div>الصيغة: <b>البادئة + السنة + "-" + الرقم</b> — مثال <b>OP-2026-000042</b>.
                        هنا بتغيّر الشكل بس؛ الكود هو اللي بيصرف الأرقام.</div>
                </div>
            </div>

            @* ── فلتر السنة ── *@
            <div class="fc-fsec">
                <div class="fc-fsec-head">
                    <span class="fc-fsec-n">1</span>
                    <div>
                        <div class="fc-fsec-t">السلاسل</div>
                        <div class="fc-fsec-d">كل نوع مستند له سلسلة مستقلة لكل سنة</div>
                    </div>
                    <span class="fc-fsec-ic"><MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" /></span>
                </div>

                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap">
                    <select class="fc-sel" value="@_year" @onchange="OnYearChanged" style="max-width:150px">
                        @foreach (var y in _years) { <option value="@y">@y</option> }
                    </select>
                    <input class="fc-sel" placeholder="بحث بالنوع أو البادئة…" @bind="_q"
                           @bind:event="oninput" style="max-width:260px" />
                    <span class="fc-cell-sub">عرض @Filtered.Count() من @_items.Count</span>
                </div>

                <div class="fc-table-wrap"><table class="fc-table">
                    <thead><tr>
                        <th>النوع</th><th>البادئة</th><th>طول الرقم</th>
                        <th>العدّاد</th><th>التصفير</th><th>الرقم الجاي</th><th style="width:70px"></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var i in Filtered)
                        {
                            <tr>
                                <td class="fc-cell-main">
                                    @i.TypeNameAr
                                    <div class="fc-cell-sub">@i.DocumentType</div>
                                </td>
                                <td><span class="fc-role-chip">@i.Prefix</span></td>
                                <td>@i.NumberLength</td>
                                <td>@i.CurrentNumber.ToString("N0")</td>
                                <td class="fc-cell-sub">@PeriodAr(i.ResetPeriod)</td>
                                <td><b>@i.Sample</b></td>
                                <td>
                                    @if (CanManage)
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                                       Color="Color.Primary" title="تعديل" OnClick="() => OpenEdit(i)" />
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Filtered.Any())
                        {
                            <tr><td colspan="7"><div class="fc-empty">مافيش سلاسل للسنة دي</div></td></tr>
                        }
                    </tbody>
                </table></div>
            </div>

        </div></div>
    }
</div>

@* ═══════════ مودال: تعديل سلسلة ═══════════ *@
@if (_editOpen && CanManage && _e is not null)
{
    <div class="fc-modal-backdrop" @onclick="CloseEdit">
        <div class="fc-modal fc-modal-sm" @onclick:stopPropagation="true">
            <div class="fc-modal-head">
                <div>
                    <div class="fc-modal-title">تعديل سلسلة @_e.TypeNameAr</div>
                    <div class="fc-modal-sub">@_e.DocumentType · سنة @_e.Year</div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseEdit" />
            </div>
            <div class="fc-modal-body">
                @if (_msg is not null)
                {
                    <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined"
                              Class="mb-4">@_msg</MudAlert>
                }

                <div class="fc-alert fc-alert-warn">
                    <div class="fc-alert-ic"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div class="fc-alert-body">
                        <div class="fc-alert-title">النوع والسنة مقفولين</div>
                        <div>الكود بينادي الاسم <b>@_e.DocumentType</b> حرفيًا — تغييره هيوقّف الترقيم.</div>
                    </div>
                </div>

                <div class="fc-form-grid" style="margin-top:14px">
                    <div class="fc-fld">
                        <div class="fc-fld-lb">البادئة<i>*</i></div>
                        <input class="fc-sel fc-sel-lg" @bind="_f.Prefix" maxlength="20" dir="ltr" />
                        <div class="fc-fld-hint">حروف إنجليزية وشرطة — زي OP- أو INV-</div>
                    </div>
                    <div class="fc-fld">
                        <div class="fc-fld-lb">طول الرقم</div>
                        <select class="fc-sel fc-sel-lg" @bind="_f.NumberLength">
                            @foreach (var l in new[] { 4, 5, 6, 7, 8 }) { <option value="@l">@l أرقام</option> }
                        </select>
                    </div>
                    <div class="fc-fld">
                        <div class="fc-fld-lb">دورية التصفير</div>
                        <select class="fc-sel fc-sel-lg" @bind="_f.ResetPeriod">
                            <option value="Yearly">سنوي</option>
                            <option value="Monthly">شهري</option>
                            <option value="Never">أبدي</option>
                        </select>
                    </div>
                    <div class="fc-fld">
                        <div class="fc-fld-lb">العدّاد</div>
                        <input type="number" min="0" class="fc-sel fc-sel-lg" value="@_f.CurrentNumber"
                               @onchange="e => _f.CurrentNumber = ParseLong(e.Value)" />
                        <div class="fc-fld-hint">حاليًا @_e.CurrentNumber — يطلع لفوق بس، أو صفر للبداية من جديد</div>
                    </div>
                    <div class="fc-fld fc-field-full">
                        <div class="fc-fld-lb">معاينة الرقم الجاي</div>
                        <div class="fc-sel fc-sel-lg" style="display:flex;align-items:center;font-weight:800;letter-spacing:.5px">
                            @Preview
                        </div>
                    </div>
                </div>
            </div>
            <div class="fc-modal-foot">
                <MudButton Variant="Variant.Text" OnClick="CloseEdit">إلغاء</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                           StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">حفظ</MudButton>
            </div>
        </div>
    </div>
}

@* ═══════════ مودال: تجهيز سنة جديدة ═══════════ *@
@if (_prepOpen && CanManage)
{
    <div class="fc-modal-backdrop" @onclick="() => _prepOpen = false">
        <div class="fc-modal fc-modal-sm" @onclick:stopPropagation="true">
            <div class="fc-modal-head">
                <div>
                    <div class="fc-modal-title">تجهيز سلاسل سنة جديدة</div>
                    <div class="fc-modal-sub">بينسخ البادئة وطول الرقم من آخر سنة · العدّاد من الصفر</div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _prepOpen = false" />
            </div>
            <div class="fc-modal-body">
                @if (_msg is not null)
                {
                    <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined"
                              Class="mb-4">@_msg</MudAlert>
                }
                <div class="fc-alert fc-alert-warn">
                    <div class="fc-alert-ic"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div class="fc-alert-body">
                        <div class="fc-alert-title">لازم تعملها قبل أول مستند في السنة</div>
                        <div>لو سلاسل السنة مش موجودة، النظام هيرفض إنشاء أي حجز أو فاتورة جديدة.</div>
                    </div>
                </div>
                <div class="fc-fld" style="margin-top:14px">
                    <div class="fc-fld-lb">السنة</div>
                    <input type="number" class="fc-sel fc-sel-lg" value="@_prepYear"
                           @onchange="e => _prepYear = (short)ParseLong(e.Value)" />
                </div>
            </div>
            <div class="fc-modal-foot">
                <MudButton Variant="Variant.Text" OnClick="() => _prepOpen = false">إلغاء</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                           OnClick="PrepareAsync">تجهيز</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("MASTERDATA.VIEW") ?? false;
    private bool CanManage => _user?.Can("MASTERDATA.MANAGE") ?? false;

    private List<Item> _items = new();
    private List<short> _years = new();
    private short? _year;
    private string _q = "";

    private bool _editOpen, _prepOpen, _saving;
    private string? _msg; private bool _ok = true;
    private Item? _e;
    private Form _f = new();
    private short _prepYear = (short)(DateTime.UtcNow.Year + 1);

    /// <summary>مطابق لـ <c>NumberingController.Item</c> — 11 حقل.</summary>
    public class Item
    {
        public int NumberSequenceId { get; set; }
        public int? BranchId { get; set; }
        public string DocumentType { get; set; } = "";
        public string TypeNameAr { get; set; } = "";
        public string Prefix { get; set; } = "";
        public short Year { get; set; }
        public long CurrentNumber { get; set; }
        public byte NumberLength { get; set; }
        public string ResetPeriod { get; set; } = "";
        public string Sample { get; set; } = "";
        public DateTime? UpdatedAt { get; set; }
    }

    /// <summary>مطابق لـ <c>NumberingController.Upsert</c> — 4 حقول.</summary>
    public class Form
    {
        public string Prefix { get; set; } = "";
        public byte NumberLength { get; set; } = 6;
        public string ResetPeriod { get; set; } = "Yearly";
        public long CurrentNumber { get; set; }
    }

    private IEnumerable<Item> Filtered => _items.Where(i =>
        string.IsNullOrWhiteSpace(_q) ||
        i.TypeNameAr.Contains(_q, StringComparison.OrdinalIgnoreCase) ||
        i.DocumentType.Contains(_q, StringComparison.OrdinalIgnoreCase) ||
        i.Prefix.Contains(_q, StringComparison.OrdinalIgnoreCase));

    /// <summary>معاينة حية — نفس صيغة الـ SP.</summary>
    private string Preview
    {
        get
        {
            if (_e is null) return "";
            var l = _f.NumberLength < 1 ? 1 : (int)_f.NumberLength;
            var s = (_f.CurrentNumber + 1).ToString();
            if (s.Length < l) s = new string('0', l - s.Length) + s;
            return $"{_f.Prefix?.Trim().ToUpperInvariant()}{_e.Year}-{s}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _years = await Http.GetFromJsonAsync<List<short>>("api/master/numbering/years") ?? new();
            if (_year is null) _year = _years.FirstOrDefault();
            if (_year is null) return;
            _items = await Http.GetFromJsonAsync<List<Item>>($"api/master/numbering?year={_year}") ?? new();
        }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; _ok = false; }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        _year = short.TryParse(e.Value?.ToString(), out var y) ? y : _year;
        await LoadAsync();
    }

    private void OpenEdit(Item i)
    {
        _e = i;
        _f = new Form
        {
            Prefix        = i.Prefix,
            NumberLength  = i.NumberLength,
            ResetPeriod   = i.ResetPeriod,
            CurrentNumber = i.CurrentNumber
        };
        _msg = null; _editOpen = true;
    }

    private void CloseEdit() { _editOpen = false; _e = null; _msg = null; }

    private void OpenPrepare() { _msg = null; _prepOpen = true; }

    private async Task SaveAsync()
    {
        if (_saving || _e is null) return;
        if (string.IsNullOrWhiteSpace(_f.Prefix)) { _ok = false; _msg = "البادئة مطلوبة"; return; }

        _saving = true; _msg = null;
        try
        {
            var res = await Http.PutAsJsonAsync($"api/master/numbering/{_e.NumberSequenceId}", new
            {
                prefix        = _f.Prefix,
                numberLength  = _f.NumberLength,
                resetPeriod   = _f.ResetPeriod,
                currentNumber = (long?)_f.CurrentNumber
            });
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { CloseEdit(); await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task PrepareAsync()
    {
        if (_saving) return;
        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/master/numbering/prepare-year", new { year = _prepYear });
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { _prepOpen = false; _year = _prepYear; await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private static long ParseLong(object? v) => long.TryParse(v?.ToString(), out var n) && n >= 0 ? n : 0;

    private static string PeriodAr(string p) => p switch
    {
        "Yearly" => "سنوي", "Monthly" => "شهري", "Never" => "أبدي", _ => p
    };

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "✅ تم" : "حصل خطأ — حاول تاني"; }
    }
}
