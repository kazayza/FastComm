@code {
    private List<NumberingDto> _items    = new();
    private List<short>        _allYears = new();
    private short?             _year;
    private bool               _loading  = true;
    private string?            _error;
    private bool               _fabOpen;

    private bool  _prepareOpen;
    private short _prepareYear = (short)(DateTime.UtcNow.Year + 1);
    private bool  _prepareBusy;

    private bool          _editOpen;
    private NumberingDto? _editItem;
    private string        _editPrefix  = "";
    private int           _editLength;
    private string        _editReset   = "";
    private int           _editCurrent;
    private bool          _editBusy;

    private bool CanView   => _user?.Can("NUMBERING.VIEW")   ?? false;
    private bool CanManage => _user?.Can("NUMBERING.MANAGE") ?? false;
    private AuthUser? _user;

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        StateHasChanged(); // إجبار الـ UI على عرض Loading فورًا
        try
        {
            var url   = _year is null
                ? "api/master/numbering"
                : $"api/master/numbering?year={_year}";
            _items    = await Http.GetFromJsonAsync<List<NumberingDto>>(url) ?? new();
            var years = await Http.GetFromJsonAsync<List<short>>("api/master/numbering/years");
            _allYears = years ?? new();
        }
        catch (Exception ex)
        {
            _error = "فشل التحميل: " + ex.Message;
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged(); // إجبار الـ UI على التحديث بعد انتهاء التحميل
        }
    }

    // ── إصلاح SetYear: async بدل fire-and-forget ──
    private async Task SetYear(short? y)
    {
        _year = y;
        await LoadAsync();
    }

    private void ToggleFab()
    {
        _fabOpen = !_fabOpen;
        StateHasChanged();
    }

    private void OnFabKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") ToggleFab();
    }

    // ── أزرار الـ FAB يغلقون القائمة أولاً ثم ينفذون الأمر ──
    private async Task HandleOpenPrepare()
    {
        _fabOpen = false;
        StateHasChanged();
        await Task.Delay(180); // انتظر انتهاء animation الإغلاق
        OpenPrepare();
    }

    private async Task HandleRefresh()
    {
        _fabOpen = false;
        StateHasChanged();
        await LoadAsync();
    }

    private void OpenPrepare()
    {
        _prepareYear = (short)(DateTime.UtcNow.Year + 1);
        _prepareOpen = true;
        StateHasChanged();
    }

    private void ClosePrepare()
    {
        _prepareOpen = false;
        StateHasChanged();
    }

    private async Task DoPrepare()
    {
        _prepareBusy = true;
        StateHasChanged();
        try
        {
            var res = await Http.PostAsJsonAsync(
                $"api/master/numbering/prepare-year?year={_prepareYear}", new { });
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add($"تم إنشاء سلاسل سنة {_prepareYear}", Severity.Success);
                _prepareOpen = false;
                await LoadAsync();
            }
            else
            {
                var msg = await res.Content.ReadAsStringAsync();
                Snackbar.Add("فشل: " + msg, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally
        {
            _prepareBusy = false;
            StateHasChanged();
        }
    }

    private void OpenEdit(NumberingDto s)
    {
        _editItem    = s;
        _editPrefix  = s.Prefix;
        _editLength  = s.NumberLength;
        _editReset   = s.ResetPeriod;
        _editCurrent = s.CurrentNumber;
        _editOpen    = true;
        StateHasChanged();
    }

    private void CloseEdit()
    {
        _editOpen = false;
        StateHasChanged();
    }

    private async Task DoEdit()
    {
        if (_editItem is null) return;
        _editBusy = true;
        StateHasChanged();
        try
        {
            var payload = new
            {
                prefix        = _editPrefix.Trim(),
                numberLength  = _editLength,
                resetPeriod   = _editReset,
                currentNumber = _editCurrent
            };
            var res = await Http.PutAsJsonAsync(
                $"api/master/numbering/{_editItem.DocumentType}", payload);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("تم حفظ التعديلات بنجاح", Severity.Success);
                _editOpen = false;
                await LoadAsync();
            }
            else
            {
                var msg = await res.Content.ReadAsStringAsync();
                Snackbar.Add("فشل: " + msg, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally
        {
            _editBusy = false;
            StateHasChanged();
        }
    }

    private static string GetTypeColor(string t) => t switch
    {
        "BOOKING"   or "INVOICE"          => "blue",
        "OPERATION" or "TRIP"             => "green",
        "CUSTOMER"  or "SUPPLIER"         => "purple",
        "DRIVER"    or "EMPLOYEE"         => "cyan",
        "VEHICLE"   or "TRAILER"          => "orange",
        "EXPENSE"   or "MAINTENANCE"      => "red",
        "PAYMENT"   or "SUPPLIER_PAYMENT" => "green",
        _                                 => "default"
    };

    private static string TypeAr(string t) => t switch
    {
        "BOOKING"          => "حجز",
        "OPERATION"        => "عملية",
        "TRIP"             => "رحلة",
        "CUSTODY"          => "عهدة",
        "CUSTOMER"         => "عميل",
