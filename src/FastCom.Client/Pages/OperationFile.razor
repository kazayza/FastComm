    .bk-add-detail-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 9px;
        background: var(--fc-blue);
        color: #fff;
        font-size: 10px;
        font-weight: 800;
    }
    .bk-add-detail-inline-btn:hover .bk-add-detail-count {
        background: #fff;
        color: var(--fc-blue);
    }

    /* إجمالي الضمان — سطر + حجز */
    .bk-guar-linetotal {
        margin-top: 6px;
        font-size: 11.5px;
        font-weight: 700;
        color: #b45309;
    }
    .bk-guar-linetotal span { color: #8a94a3; font-weight: 600; }
    .bk-guar-total-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 4px 0 14px;
        padding: 12px 16px;
        border: 1.5px solid rgba(217, 119, 6, .35);
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(217, 119, 6, .07), rgba(217, 119, 6, .02));
        color: #b45309;
        font-size: 12.5px;
        font-weight: 700;
    }
    .bk-guar-total-bar strong { font-size: 15px; margin-inline-start: auto; }
    .bk-guar-cur { color: #8a94a3; font-size: 11px; }

