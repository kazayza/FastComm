    /* تثبيت الأعمدة عشان أرقام الإجمالي تنزل تحت أعمدتها بالظبط */
    .opf-exp-table { table-layout: fixed; }
    .opf-exp-table td, .opf-exp-table th {
        overflow-wrap: anywhere; word-break: break-word;
    }

    /* أيقونة (i) — التوضيح يظهر تول تيب عند المرور */
