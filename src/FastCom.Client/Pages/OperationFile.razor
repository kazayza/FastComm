@page "/operations/{Id:long}/file"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>ملف العملية — فاست كوم</PageTitle>

<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">
            <div class="doc-hero-row">
                <div class="doc-hero-left">
                    <div class="doc-hero-crumb"><span>التشغيل · ملف العملية</span></div>
                    <h1 class="fc-hero-title">ملف العملية @(_d?.OperationNumber ?? "")</h1>
                    @if (_d is not null)
                    {
                        <p class="fc-hero-sub">
                            حجز الوكيل: <b>@(_d.AgentReference ?? "—")</b> · العميل: @_d.CustomerName · الحالة: @_d.Status
                        </p>
                    }
                </div>
                <div class="doc-hero-right">
                    @if (CanInvoiceCreate && _d is not null && _d.Status != "Cancelled" && _lines.Count > 0)
                    {
                        <a class="doc-hero-btn solid" href="@($"/invoices/new?operationId={Id}&customerId={_d.CustomerId}")">إنشاء فاتورة العميل</a>
                    }
                    <a class="doc-hero-btn solid" href="@($"/transport-requests/new/{Id}")">تعديل الطلب</a>
                    <a class="doc-hero-btn" href="@($"/operations/new/{Id}")">تعديل العملية</a>
                </div>
            </div>

            @if (_d is not null)
            {
                <div class="doc-kpis-row">
                    <div class="doc-kpi doc-kpi-blue">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round"/></svg></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_d.RevenueNet.ToString("N2")</div>
                                <div class="doc-kpi-label">إيراد (صافي)</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-amber">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/><path d="M8 7h8M8 11h8M8 15h5" stroke-linecap="round"/></svg></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_d.ActualCost.ToString("N2")</div>
                                <div class="doc-kpi-label">تكلفة فعلية</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-green">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 6l-9.5 9.5-5-5L1 18" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 6h6v6" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@((_d.RevenueNet - _d.ActualCost).ToString("N2"))</div>
                                <div class="doc-kpi-label">الربح التقديري</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-blue">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_trips.Count / @_containers.Count</div>
                                <div class="doc-kpi-label">رحلات / حاويات</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_d is null)
{
    <div class="doc-loading">جارٍ تحميل ملف العملية...</div>
}
else
{
    <div class="bk-body">
        <div class="tab-section">
            <div class="doc-sec-head">
                <div class="tab-section-head" style="margin-bottom:0">
                    <div class="tab-section-icon blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round"/></svg>
                    </div>
                    <div>
                        <div class="tab-section-title">سطور الإيراد</div>
                        <div class="tab-section-sub">ما يدفعه العميل عن هذه العملية — تُعدَّل الكمية والسعر والخصم من هنا</div>
                    </div>
                </div>
                @if (CanEditLines)
                {
                    <button type="button" class="doc-btn primary" @onclick="SaveRevenueAsync" disabled="@_savingRev">حفظ السطور</button>
                }
            </div>
            <div class="doc-table-wrap">
                <table class="doc-table">
                    <thead>
                        <tr><th>الخدمة</th><th>البيان</th><th>الكمية</th><th>السعر</th><th>الخصم</th><th>الصافي</th>@if (CanEditLines) { <th></th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _lines)
                        {
                            <tr>
                                <td>@l.ServiceName</td>
                                <td>@l.Description</td>
                                @if (CanEditLines)
                                {
                                    <td><input type="number" class="doc-inline-input" style="width:78px" min="0" step="any" value="@Fmt(l.Quantity)" @onchange="e => l.Quantity = ParseDec(e.Value)" /></td>
                                    <td><input type="number" class="doc-inline-input" style="width:104px" min="0" step="any" value="@Fmt(l.UnitPrice)" @onchange="e => l.UnitPrice = ParseDec(e.Value)" /></td>
                                    <td><input type="number" class="doc-inline-input" style="width:88px" min="0" step="any" value="@Fmt(l.Discount)" @onchange="e => l.Discount = ParseDec(e.Value)" /></td>
                                }
                                else
                                {
                                    <td>@l.Quantity</td>
                                    <td>@l.UnitPrice.ToString("N2")</td>
                                    <td>@l.Discount.ToString("N2")</td>
                                }
                                <td><b>@l.LineNet.ToString("N2")</b></td>
                                @if (CanEditLines)
                                {
                                    <td>
                                        <button type="button" class="doc-icon-btn danger" title="حذف السطر" @onclick="() => _lines.Remove(l)">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (CanEditLines)
            {
                <div class="doc-form-row">
                    <div class="form-field" style="flex:2">
                        <label class="field-label">خدمة جديدة</label>
                        <div class="field-select-wrap">
                            <select class="field-input field-select" @bind="_newRevServiceId">
                                <option value="0">— اختر الخدمة —</option>
                                @foreach (var sv in _services) { <option value="@sv.Id">@sv.Label</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">السعر</label>
                        <div class="field-input-group">
                            <input type="number" class="field-input" min="0" step="any" value="@Fmt(_newRevPrice)" @onchange="e => _newRevPrice = ParseDec(e.Value)" />
                        </div>
                    </div>
                    <div class="form-field doc-form-action">
                        <button type="button" class="doc-btn outline" @onclick="AddRevenueLine">إضافة سطر</button>
                    </div>
                </div>
            }
        </div>

        <div class="tab-section">
            <div class="doc-sec-head">
                <div class="tab-section-head" style="margin-bottom:0">
                    <div class="tab-section-icon green" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
                    </div>
                    <div>
                        <div class="tab-section-title">الحاويات (@_containers.Count)</div>
                        <div class="tab-section-sub">الحاويات الفعلية المربوطة بالعملية</div>
                    </div>
                </div>
                @if (CanOpEdit) { <button type="button" class="doc-btn outline" @onclick="SyncContainersAsync" disabled="@_syncing">مزامنة من الحجز</button> }
            </div>
            @if (_bkLines.Count > 0)
            {
                <div class="doc-table-wrap" style="margin-bottom:14px">
                    <table class="doc-table">
                        <thead>
                            <tr><th>سطور الحاويات المسجلة في الطلب — النوع</th><th>العدد</th><th>الوزن (كجم)</th><th>ضمان الحاوية</th><th>ملاحظات</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _bkLines)
                            {
                                <tr>
                                    <td>@(l.TypeName ?? "—")</td>
                                    <td>@l.RequestedQty</td>
                                    <td>@(l.WeightKg?.ToString("N0") ?? "—")</td>
                                    <td>@(l.GuaranteePerContainer?.ToString("N0") ?? "—")</td>
                                    <td>@(l.Notes ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_containers.Count == 0)
            {
                <p class="doc-empty">لا توجد حاويات فعلية مرتبطة بعد — تُنسخ تلقائيًا من تفاصيل حجز الوكيل عند إنشاء العملية، أو أضفها من النموذج التالي.</p>
            }
            else
            {
                <div class="doc-table-wrap">
                    <table class="doc-table">
                        <thead>
                            <tr><th>رقم الحاوية</th><th>النوع</th><th>البوليصة</th><th>الحالة</th>@if (CanOpEdit && !IsClosed) { <th></th> }</tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _containers)
                            {
                                <tr>
                                    <td>@(c.ContainerNumber ?? "—")</td>
                                    <td>@(c.TypeName ?? "—")</td>
                                    @if (CanOpEdit && !IsClosed)
                                    {
                                        <td><input type="text" class="doc-inline-input" style="width:170px" placeholder="رقم البوليصة" @bind="c.EditBl" /></td>
                                    }
                                    else
                                    {
                                        <td>@(c.BLNumber ?? "—")</td>
                                    }
                                    <td>@c.Status</td>
                                    @if (CanOpEdit && !IsClosed)
                                    {
                                        <td>
                                            <button type="button" class="doc-icon-btn" title="حفظ البوليصة" @onclick="() => SaveContainerBlAsync(c)">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (CanOpEdit && !IsClosed)
            {
                <div class="doc-form-row">
                    <div class="form-field" style="flex:2">
                        <label class="field-label">رقم حاوية جديد</label>
                        <div class="field-input-group">
                            <input type="text" class="field-input" @bind="_newContNumber" />
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">النوع</label>
                        <div class="field-select-wrap">
                            <select class="field-input field-select" @bind="_newContTypeId">
                                <option value="0">— اختر النوع —</option>
                                @foreach (var t in _containerTypes) { <option value="@t.Id">@t.Label</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">البوليصة</label>
                        <div class="field-input-group">
                            <input type="text" class="field-input" @bind="_newContBl" />
                        </div>
                    </div>
                    <div class="form-field doc-form-action">
                        <button type="button" class="doc-btn outline" @onclick="AddContainerAsync" disabled="@_addingCont">إضافة حاوية</button>
                    </div>
                </div>
            }
        </div>

        <div class="tab-section">
            <div class="doc-sec-head">
                <div class="tab-section-head" style="margin-bottom:0">
                    <div class="tab-section-icon blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    </div>
                    <div>
                        <div class="tab-section-title">الرحلات (@_trips.Count)</div>
                        <div class="tab-section-sub">رحلة لكل حاوية — يُربط السائق والسيارة من المورد نفسه تلقائيًا</div>
                    </div>
                </div>
                @if (CanTripCreate) { <button type="button" class="doc-btn primary" @onclick="() => _showTripForm = !_showTripForm">إضافة رحلة</button> }
            </div>

            @if (_showTripForm)
            {
                <div class="doc-form-row wrap">
                    <div class="form-field" style="flex:2">
                        <label class="field-label">نوع المصروف <span class="field-required">*</span></label>
                        <div class="form-field-with-dropdown">
                            <div class="field-select-wrap">
                                <input class="field-input field-select"
                                       value="@QeTypeText"
                                       placeholder="ابحث عن النوع..."
                                       @oninput="OnQeTypeSearch"
                                       @onfocus="() => { _showQeTypeDd = true; _qeFilteredTypes = QeFilterTypes(); }"
                                       @onfocusout="() => _showQeTypeDd = false" />
                            </div>
                            @if (_showQeTypeDd && _qeFilteredTypes.Count > 0)
                            {
                                <div class="field-dropdown" @onmousedown:preventDefault="true">
                                    @foreach (var t in _qeFilteredTypes)
                                    {
                                        <div class="field-dropdown-item" @onmousedown="() => PickQeType(t)">@t.Label</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    @if (QeCurrentType?.IsReceiptRequired == true)
                    {
                        <div class="form-field" style="flex:1.4">
                            <label class="field-label">نوع الإيصال <span class="field-required">*</span></label>
                            <div class="field-select-wrap">
                                <select class="field-input field-select" @bind="_qe.ReceiptTypeId">
                                    <option value="">— اختر —</option>
                                    @foreach (var r in _qeReceiptTypes) { <option value="@r.Id">@r.Label</option> }
                                </select>
                            </div>
                        </div>
                        <div class="form-field" style="flex:1">
                            <label class="field-label">رقم الإيصال</label>
                            <div class="field-input-group">
                                <input type="text" class="field-input" @bind="_qe.ReceiptNumber" />
                            </div>
                        </div>
                    }
                    <div class="form-field" style="flex:1">
                        <label class="field-label">المبلغ المدفوع <span class="field-required">*</span></label>
                        <div class="field-input-group">
                            <input type="number" class="field-input" min="0" step="any" value="@Fmt(_qe.Amount)" @onchange="e => _qe.Amount = ParseDec(e.Value)" />
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">يتحمّله العميل</label>
                        <div class="field-input-group">
                            <input type="number" class="field-input" min="0" step="any" value="@FmtN(_qe.Billable)" @onchange="e => _qe.Billable = ParseDecN(e.Value)" />
                        </div>
                    </div>
                    <div class="form-field" style="flex:1.3">
                        <label class="field-label">مصدر المال</label>
                        <div class="qe-src-toggle">
                            <button type="button" class="@(_qe.Source == "Custody" ? "on" : "")" @onclick='() => _qe.Source = "Custody"'>من عهدة</button>
                            <button type="button" class="@(_qe.Source == "Treasury" ? "on" : "")" @onclick='() => _qe.Source = "Treasury"'>من الخزينة</button>
                        </div>
                    </div>
                    @if (_qe.Source == "Custody")
                    {
                        <div class="form-field" style="flex:1.8">
                            <label class="field-label">العهدة <span class="field-required">*</span></label>
                            <div class="field-select-wrap">
                                <select class="field-input field-select"
                                        value="@_qe.CustodyId"
                                        @onchange="e => _qe.CustodyId = long.TryParse(e.Value?.ToString(), out var cv) && cv > 0 ? cv : (long?)null">
                                    <option value="">— اختر العهدة —</option>
                                    @foreach (var c in _qeCustodies) { <option value="@c.Id">@c.Label — @c.AmountIssued.ToString("N2") ج.م</option> }
                                </select>
                            </div>
                        </div>
                    }
                    <div class="form-field" style="flex:1.6">
                        <label class="field-label">البيان</label>
                        <div class="field-input-group">
                            <input type="text" class="field-input" @bind="_qe.Description" />
                        </div>
                    </div>
                    <div class="form-field doc-form-action">
                        <button type="button" class="doc-btn primary" @onclick="QuickExpenseAsync" disabled="@_savingExp">إضافة سريعة</button>
                    </div>
                </div>
            }
            <div class="doc-table-wrap">
                <table class="doc-table">
                    <thead>
                        <tr><th>الخدمة</th><th>البيان</th><th>الكمية</th><th>السعر</th><th>الخصم</th><th>الصافي</th>@if (CanEditLines) { <th></th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _lines)
                        {
                            <tr>
                                <td>@l.ServiceName</td>
                                <td>@l.Description</td>
                                @if (CanEditLines)
                                {
                                    <td><input type="number" class="doc-inline-input" style="width:78px" min="0" step="any" value="@Fmt(l.Quantity)" @onchange="e => l.Quantity = ParseDec(e.Value)" /></td>
                                    <td><input type="number" class="doc-inline-input" style="width:104px" min="0" step="any" value="@Fmt(l.UnitPrice)" @onchange="e => l.UnitPrice = ParseDec(e.Value)" /></td>
                                    <td><input type="number" class="doc-inline-input" style="width:88px" min="0" step="any" value="@Fmt(l.Discount)" @onchange="e => l.Discount = ParseDec(e.Value)" /></td>
                                }
                                else
                                {
                                    <td>@l.Quantity</td>
                                    <td>@l.UnitPrice.ToString("N2")</td>
                                    <td>@l.Discount.ToString("N2")</td>
                                }
                                <td><b>@l.LineNet.ToString("N2")</b></td>
                                @if (CanEditLines)
                                {
                                    <td>
                                        <button type="button" class="doc-icon-btn danger" title="حذف السطر" @onclick="() => _lines.Remove(l)">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (CanEditLines)
            {
                <div class="doc-form-row">
                    <div class="form-field" style="flex:2">
                        <label class="field-label">خدمة جديدة</label>
                        <div class="field-select-wrap">
                            <select class="field-input field-select" @bind="_newRevServiceId">
                                <option value="0">— اختر الخدمة —</option>
                                @foreach (var sv in _services) { <option value="@sv.Id">@sv.Label</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">السعر</label>
                        <div class="field-input-group">
                            <input type="number" class="field-input" min="0" step="any" value="@Fmt(_newRevPrice)" @onchange="e => _newRevPrice = ParseDec(e.Value)" />
                        </div>
                    </div>
                    <div class="form-field doc-form-action">
                        <button type="button" class="doc-btn outline" @onclick="AddRevenueLine">إضافة سطر</button>
                    </div>
                </div>
            }
        </div>

        <div class="tab-section">
            <div class="doc-sec-head">
                <div class="tab-section-head" style="margin-bottom:0">
                    <div class="tab-section-icon green" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
                    </div>
                    <div>
                        <div class="tab-section-title">الحاويات (@_containers.Count)</div>
                        <div class="tab-section-sub">الحاويات الفعلية المربوطة بالعملية</div>
                    </div>
                </div>
                @if (CanOpEdit) { <button type="button" class="doc-btn outline" @onclick="SyncContainersAsync" disabled="@_syncing">مزامنة من الحجز</button> }
            </div>
            @if (_bkLines.Count > 0)
            {
                <div class="doc-table-wrap" style="margin-bottom:14px">
                    <table class="doc-table">
                        <thead>
                            <tr><th>سطور الحاويات المسجلة في الطلب — النوع</th><th>العدد</th><th>الوزن (كجم)</th><th>ضمان الحاوية</th><th>ملاحظات</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _bkLines)
                            {
                                <tr>
                                    <td>@(l.TypeName ?? "—")</td>
                                    <td>@l.RequestedQty</td>
                                    <td>@(l.WeightKg?.ToString("N0") ?? "—")</td>
                                    <td>@(l.GuaranteePerContainer?.ToString("N0") ?? "—")</td>
                                    <td>@(l.Notes ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_containers.Count == 0)
            {
                <p class="doc-empty">لا توجد حاويات فعلية مرتبطة بعد — تُنسخ تلقائيًا من تفاصيل حجز الوكيل عند إنشاء العملية، أو أضفها من النموذج التالي.</p>
            }
            else
            {
                <div class="doc-table-wrap">
                    <table class="doc-table">
                        <thead>
                            <tr><th>رقم الحاوية</th><th>النوع</th><th>البوليصة</th><th>الحالة</th>@if (CanOpEdit && !IsClosed) { <th></th> }</tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _containers)
                            {
                                <tr>
                                    <td>@(c.ContainerNumber ?? "—")</td>
                                    <td>@(c.TypeName ?? "—")</td>
                                    @if (CanOpEdit && !IsClosed)
                                    {
                                        <td><input type="text" class="doc-inline-input" style="width:170px" placeholder="رقم البوليصة" @bind="c.EditBl" /></td>
                                    }
                                    else
                                    {
                                        <td>@(c.BLNumber ?? "—")</td>
                                    }
                                    <td>@c.Status</td>
                                    @if (CanOpEdit && !IsClosed)
                                    {
                                        <td>
                                            <button type="button" class="doc-icon-btn" title="حفظ البوليصة" @onclick="() => SaveContainerBlAsync(c)">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (CanOpEdit && !IsClosed)
            {
                <div class="doc-form-row">
                    <div class="form-field" style="flex:2">
                        <label class="field-label">رقم حاوية جديد</label>
                        <div class="field-input-group">
                            <input type="text" class="field-input" @bind="_newContNumber" />
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">النوع</label>
                        <div class="field-select-wrap">
                            <select class="field-input field-select" @bind="_newContTypeId">
                                <option value="0">— اختر النوع —</option>
                                @foreach (var t in _containerTypes) { <option value="@t.Id">@t.Label</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">البوليصة</label>
                        <div class="field-input-group">
                            <input type="text" class="field-input" @bind="_newContBl" />
                        </div>
                    </div>
                    <div class="form-field doc-form-action">
                        <button type="button" class="doc-btn outline" @onclick="AddContainerAsync" disabled="@_addingCont">إضافة حاوية</button>
                    </div>
                </div>
            }
        </div>

        <div class="tab-section">
            <div class="doc-sec-head">
                <div class="tab-section-head" style="margin-bottom:0">
                    <div class="tab-section-icon blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    </div>
                    <div>
                        <div class="tab-section-title">الرحلات (@_trips.Count)</div>
                        <div class="tab-section-sub">رحلة لكل حاوية — يُربط السائق والسيارة من المورد نفسه تلقائيًا</div>
                    </div>
                </div>
                @if (CanTripCreate) { <button type="button" class="doc-btn primary" @onclick="() => _showTripForm = !_showTripForm">إضافة رحلة</button> }
            </div>

            @if (_showTripForm)
            {
                <div class="doc-form-row wrap">
                    <div class="form-field" style="flex:2">
                        <label class="field-label">السائق <span class="field-required">*</span></label>
                        <div class="field-select-wrap">
                            <select class="field-input field-select" value="@_tf.DriverId" @onchange="e => OnDriverPicked(ParseInt(e.Value))">
                                <option value="0">— اختر السائق —</option>
                                @foreach (var d in OrderedDriverOpts()) { <option value="@d.Id">@d.Label</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-field" style="flex:2">
                        <label class="field-label">العربية <span class="field-required">*</span></label>
                        <div class="field-select-wrap">
                            <select class="field-input field-select" value="@_tf.VehicleId" @onchange="e => OnVehiclePicked(ParseInt(e.Value))">
                                <option value="0">— اختر العربية —</option>
                                @foreach (var v in OrderedVehicleOpts()) { <option value="@v.Id">@v.Label</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">المقطورة</label>
                        <div class="field-select-wrap">
                            <select class="field-input field-select" value="@(_tf.TrailerId?.ToString() ?? "")" @onchange="e => _tf.TrailerId = ParseIntN(e.Value)">
                                <option value="">— بدون —</option>
                                @foreach (var v in _trailers) { <option value="@v.Id">@v.Label</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">ميعاد التحرك</label>
                        <div class="field-input-group">
                            <input type="datetime-local" class="field-input" value="@_tf.PlannedStartAt" @onchange="e => _tf.PlannedStartAt = e.Value?.ToString()" />
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">النولون</label>
                        <div class="field-input-group">
                            <input type="number" class="field-input" min="0" step="any" value="@FmtN(_tf.Freight)" @onchange="e => _tf.Freight = ParseDecN(e.Value)" />
                        </div>
                    </div>
                    <div class="form-field doc-form-action">
                        <button type="button" class="doc-btn primary" @onclick="AddTripAsync" disabled="@_savingTrip">حفظ الرحلة</button>
                    </div>
                </div>
            }

            <div class="doc-table-wrap">
                <table class="doc-table">
                    <thead>
                        <tr><th>الرحلة</th><th>السائق</th><th>العربية</th><th>المخطط</th><th>النولون</th><th>الحالة</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _trips)
                        {
                            <tr>
                                <td><a class="doc-link" href="@($"/trips/new/{t.TripId}")">@t.TripNumber</a></td>
                                <td>@t.DriverName</td>
                                <td>@t.VehiclePlate</td>
                                <td>@(t.PlannedStartAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td>@(t.FreightAmount?.ToString("N2") ?? "—")</td>
                                <td>@TripStatusAr(t.Status)</td>
                                <td>
                                    <a class="doc-icon-btn" title="تعديل الرحلة" href="@($"/trips/new/{t.TripId}")">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9" stroke-linecap="round"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linejoin="round"/></svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-section">
            <div class="doc-sec-head">
                <div class="tab-section-head" style="margin-bottom:0">
                    <div class="tab-section-icon amber" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/><path d="M8 7h8M8 11h8M8 15h5" stroke-linecap="round"/></svg>
                    </div>
                    <div>
                        <div class="tab-section-title">المصروفات (@_expenses.Count)</div>
                        <div class="tab-section-sub">مصروفات التشغيل المربوطة بالعملية دي</div>
                    </div>
                </div>
                <a class="doc-btn outline" href="/expenses/new">مصروف جديد (شاشة كاملة)</a>
            </div>
            @if (CanExpenseCreate && !IsClosed)
            {
                <div class="doc-form-row wrap">
                    <div class="form-field" style="flex:2">
                        <label class="field-label">نوع المصروف <span class="field-required">*</span></label>
                        <div class="field-select-wrap">
                            <select class="field-input field-select" @bind="_qe.TypeId">
                                <option value="0">— اختر النوع —</option>
                                @foreach (var t in _expenseTypes) { <option value="@t.Id">@t.Label</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">المبلغ المدفوع <span class="field-required">*</span></label>
                        <div class="field-input-group">
                            <input type="number" class="field-input" min="0" step="any" value="@Fmt(_qe.Amount)" @onchange="e => _qe.Amount = ParseDec(e.Value)" />
                        </div>
                    </div>
                    <div class="form-field" style="flex:1">
                        <label class="field-label">يتحمّله العميل</label>
                        <div class="field-input-group">
                            <input type="number" class="field-input" min="0" step="any" value="@FmtN(_qe.Billable)" @onchange="e => _qe.Billable = ParseDecN(e.Value)" />
                        </div>
                    </div>
                    <div class="form-field" style="flex:2">
                        <label class="field-label">البيان</label>
                        <div class="field-input-group">
                            <input type="text" class="field-input" @bind="_qe.Description" />
                        </div>
                    </div>
                    <div class="form-field doc-form-action">
                        <button type="button" class="doc-btn primary" @onclick="QuickExpenseAsync" disabled="@_savingExp">إضافة سريعة</button>
                    </div>
                </div>
            }
            <div class="doc-table-wrap">
                <table class="doc-table">
                    <thead>
                        <tr><th>الرقم</th><th>النوع</th><th>الإيصال</th><th>التاريخ</th><th>المبلغ</th><th>الحالة</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var x in _expenses)
                        {
                            <tr>
                                <td>@x.ExpenseNumber</td>
                                <td>@x.TypeName</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(x.ReceiptTypeName))
                                    {
                                        <span>@x.ReceiptTypeName</span>
                                        @if (!string.IsNullOrWhiteSpace(x.ReferenceNumber))
                                        {
                                            <div class="doc-sub">@x.ReferenceNumber</div>
                                        }
                                    }
                                    else { <span class="doc-sub">—</span> }
                                </td>
                                <td>@x.ExpenseDate.ToString("yyyy-MM-dd")</td>
                                <td>@x.Amount.ToString("N2")</td>
                                <td>@x.Status</td>
                                <td>
                                    <a class="doc-icon-btn" title="تعديل المصروف" href="@($"/expenses/new/{x.ExpenseId}")">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9" stroke-linecap="round"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linejoin="round"/></svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private AuthUser? _user;
    private bool CanTripCreate => _user?.Can("TRIP.CREATE") ?? false;
    private bool CanOpEdit => _user?.Can("OPERATION.EDIT") ?? false;
    private bool CanExpenseCreate => _user?.Can("EXPENSE.CREATE") ?? false;
    private bool CanInvoiceCreate => _user?.Can("INVOICE.CREATE") ?? false;
    private bool IsClosed => _d?.Status is "Closed" or "Cancelled";
    private bool CanEditLines => CanOpEdit && !IsClosed;
    private bool _syncing;

    /* ── تحرير مباشر من الملف: إيراد/حاويات/مصروف سريع ── */
    private List<Opt> _services = new(), _containerTypes = new(), _expenseTypes = new();
    private bool _savingRev;
    private int _newRevServiceId;
    private decimal _newRevPrice;
    private string? _newContNumber, _newContBl;
    private int _newContTypeId;
    private bool _addingCont;

    private class QuickExp
    {
        public int TypeId { get; set; } public decimal Amount { get; set; }
        public decimal? Billable { get; set; } public string? Description { get; set; }
        public int? ReceiptTypeId { get; set; } public string? ReceiptNumber { get; set; }
        public string Source { get; set; } = "Treasury"; public long? CustodyId { get; set; }
    }
    private QuickExp _qe = new();
    private bool _savingExp;

    public class QExpType { public int Id { get; set; } public string Label { get; set; } = ""; public bool IsReceiptRequired { get; set; } public bool IsFreightAdvance { get; set; } }
    public class QCustody { public long Id { get; set; } public string Label { get; set; } = ""; public decimal AmountIssued { get; set; } }
    public class QMethod { public int Id { get; set; } public bool IsCashBased { get; set; } }
    private List<QExpType> _qeTypes = new();
    private List<QCustody> _qeCustodies = new();
    private List<Opt> _qeReceiptTypes = new();
    private int? _qeCashMethodId;
    private string _qeTypeSearch = "";
    private bool _qeTypeTouched, _showQeTypeDd;
    private List<QExpType> _qeFilteredTypes = new();

    private QExpType? QeCurrentType => _qeTypes.FirstOrDefault(t => t.Id == _qe.TypeId);
    private string QeTypeText =>
        !_qeTypeTouched && _qe.TypeId > 0
            ? (_qeTypes.FirstOrDefault(t => t.Id == _qe.TypeId)?.Label ?? "")
            : _qeTypeSearch;

    private void OnQeTypeSearch(ChangeEventArgs e)
    {
        _qeTypeSearch = e.Value?.ToString() ?? ""; _qeTypeTouched = true; _showQeTypeDd = true;
        _qeFilteredTypes = QeFilterTypes();
    }

    private List<QExpType> QeFilterTypes() =>
        string.IsNullOrWhiteSpace(_qeTypeSearch)
            ? _qeTypes
            : _qeTypes.Where(t => t.Label.Contains(_qeTypeSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private void PickQeType(QExpType t)
    { _showQeTypeDd = false; _qeTypeTouched = true; _qeTypeSearch = t.Label; _qe.TypeId = t.Id; }

    private void AddRevenueLine()
    {
        if (_newRevServiceId <= 0) { Snackbar.Add("اختر الخدمة أولًا", Severity.Warning); return; }
        _lines.Add(new RevLine
        {
            ServiceId   = _newRevServiceId,
            ServiceName = _services.FirstOrDefault(s => s.Id == _newRevServiceId)?.Label ?? "",
            Quantity    = 1,
            UnitPrice   = _newRevPrice
        });
        _newRevPrice = 0;
    }

    private async Task SaveRevenueAsync()
    {
        if (_d is null) return;
        _savingRev = true;
        try
        {
            var payload = new
            {
                bookingId     = _d.BookingId,
                customerId    = _d.CustomerId,
                serviceId     = _d.ServiceId,
                portId        = _d.PortId,
                destinationId = _d.DestinationId,
                tahteeqPortId = _d.TahteeqPortId,
                tripTypeId    = _d.TripTypeId,
                plannedDate   = string.IsNullOrEmpty(_d.PlannedDate) ? null : _d.PlannedDate[..10],
                estimatedCost = _d.EstimatedCost,
                notes         = _d.Notes,
                revenueLines  = _lines.Select(l => new
                {
                    serviceId   = l.ServiceId,
                    description = l.Description,
                    quantity    = l.Quantity,
                    unitPrice   = l.UnitPrice,
                    discount    = l.Discount,
                    taxRateId   = l.TaxRateId,
                    priceRuleId = l.PriceRuleId
                }).ToList()
            };
            var res = await Http.PutAsJsonAsync($"api/operations/{Id}", payload);
            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode) { Snackbar.Add("✅ تم حفظ سطور الإيراد", Severity.Success); await LoadAsync(); }
            else Snackbar.Add(msg, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally { _savingRev = false; }
    }

    private async Task SaveContainerBlAsync(OpContainer c)
    {
        try
        {
            var res = await Http.PutAsJsonAsync($"api/operations/{Id}/containers/{c.OperationContainerId}",
                new { blNumber = c.EditBl });
            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode) { Snackbar.Add(msg, Severity.Success); await LoadAsync(); }
            else Snackbar.Add(msg, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task AddContainerAsync()
    {
        if (string.IsNullOrWhiteSpace(_newContNumber)) { Snackbar.Add("أدخل رقم الحاوية", Severity.Warning); return; }
        if (_newContTypeId <= 0) { Snackbar.Add("اختر نوع الحاوية", Severity.Warning); return; }
        _addingCont = true;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/operations/{Id}/containers",
                new { containerNumber = _newContNumber, containerTypeId = _newContTypeId, blNumber = _newContBl });
            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(msg, Severity.Success);
                _newContNumber = null; _newContBl = null;
                await LoadAsync();
            }
            else Snackbar.Add(msg, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally { _addingCont = false; }
    }

    private class CreatedRes { public long Id { get; set; } public string? Message { get; set; } }

    private async Task QuickExpenseAsync()
    {
        if (_savingExp) return;
        if (_qe.TypeId <= 0) { Snackbar.Add("اختر نوع المصروف", Severity.Warning); return; }
        if (_qe.Amount <= 0) { Snackbar.Add("يجب أن يكون المبلغ أكبر من صفر", Severity.Warning); return; }
        if (QeCurrentType?.IsReceiptRequired == true && _qe.ReceiptTypeId is null)
        { Snackbar.Add("هذا النوع يستدعي إيصالًا — اختر نوع الإيصال", Severity.Warning); return; }
        if (_qe.Source == "Custody" && _qe.CustodyId is null)
        { Snackbar.Add("اختر العهدة التي خرج منها المال", Severity.Warning); return; }
        _savingExp = true;
        try
        {
            var payload = new
            {
                expenseTypeId   = _qe.TypeId,
                expenseDate     = DateTime.Today.ToString("yyyy-MM-dd"),
                description     = _qe.Description,
                amount          = _qe.Amount,
                operationId     = Id,
                tripId          = (long?)null,
                driverId        = (int?)null,
                vehicleId       = (int?)null,
                supplierId      = (int?)null,
                custodyId       = _qe.Source == "Custody" ? _qe.CustodyId : (long?)null,
                taxRateId       = (int?)null,
                isTaxDeductible = (bool?)null,
                referenceNumber = QeCurrentType?.IsReceiptRequired == true ? _qe.ReceiptNumber : (string?)null,
                receiptTypeId   = _qe.ReceiptTypeId,
                paymentMethodId = _qeCashMethodId,
                notes           = (string?)null,
                asDraft         = false,
                billableAmount  = _qe.Billable
            };
            var res = await Http.PostAsJsonAsync("api/expenses", payload);
            if (!res.IsSuccessStatusCode)
            {
                Snackbar.Add(await MsgOf(res), Severity.Error);
                return;
            }

            var created = await res.Content.ReadFromJsonAsync<CreatedRes>();
            if (_qe.Source == "Treasury" && created is not null && created.Id > 0)
            {
                var payRes = await Http.PostAsJsonAsync($"api/expenses/{created.Id}/set-paid", new { to = "Paid" });
                if (!payRes.IsSuccessStatusCode)
                {
                    Snackbar.Add("أُنشئ المصروف، لكن تعليمه مدفوعًا من الخزينة فشل: " + await MsgOf(payRes), Severity.Warning);
                    _qe = new(); _qeTypeSearch = ""; _qeTypeTouched = false;
                    await LoadAsync();
                    return;
                }
            }

            Snackbar.Add(created?.Message ?? "تمت إضافة المصروف", Severity.Success);
            _qe = new(); _qeTypeSearch = ""; _qeTypeTouched = false;
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally { _savingExp = false; }
    }

    private async Task SyncContainersAsync()
    {
        _syncing = true;
        try
        {
            var res = await Http.PostAsync($"api/operations/{Id}/sync-containers", null);
            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode) { Snackbar.Add(msg, Severity.Success); await LoadAsync(); }
            else Snackbar.Add(msg, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally { _syncing = false; }
    }

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }
    private List<Opt> _drivers = new(), _vehicles = new(), _trailers = new();

    public class PairOpt { public int Id { get; set; } public string Label { get; set; } = ""; public int? SupplierId { get; set; } public bool IsCompany { get; set; } }
    private List<PairOpt> _driverPairs = new(), _vehiclePairs = new();

    private static bool SameSource(PairOpt a, PairOpt b) =>
        (a.IsCompany && b.IsCompany) ||
        (!a.IsCompany && !b.IsCompany && a.SupplierId is not null && a.SupplierId == b.SupplierId);

    private void OnDriverPicked(int id)
    {
        _tf.DriverId = id;
        var dr = _driverPairs.FirstOrDefault(x => x.Id == id);
        if (dr is null) return;
        var cur = _vehiclePairs.FirstOrDefault(x => x.Id == _tf.VehicleId);
        if (cur is not null && SameSource(cur, dr)) return;
        var m = _vehiclePairs.Where(v => SameSource(v, dr)).ToList();
        if (m.Count == 1) _tf.VehicleId = m[0].Id;
    }

    private void OnVehiclePicked(int id)
    {
        _tf.VehicleId = id;
        var v = _vehiclePairs.FirstOrDefault(x => x.Id == id);
        if (v is null) return;
        var cur = _driverPairs.FirstOrDefault(x => x.Id == _tf.DriverId);
        if (cur is not null && SameSource(cur, v)) return;
        var m = _driverPairs.Where(d => SameSource(d, v)).ToList();
        if (m.Count == 1) _tf.DriverId = m[0].Id;
    }

    private List<Opt> OrderedDriverOpts()
    {
        var v = _vehiclePairs.FirstOrDefault(x => x.Id == _tf.VehicleId);
        if (v is null) return _drivers;
        return _drivers.OrderByDescending(o =>
        {
            var p = _driverPairs.FirstOrDefault(x => x.Id == o.Id);
            return p is not null && SameSource(p, v) ? 1 : 0;
        }).ToList();
    }

    private List<Opt> OrderedVehicleOpts()
    {
        var dr = _driverPairs.FirstOrDefault(x => x.Id == _tf.DriverId);
        if (dr is null) return _vehicles;
        return _vehicles.OrderByDescending(o =>
        {
            var p = _vehiclePairs.FirstOrDefault(x => x.Id == o.Id);
            return p is not null && SameSource(p, dr) ? 1 : 0;
        }).ToList();
    }

    public class Detail
    {
        public long OperationId { get; set; } public string OperationNumber { get; set; } = "";
        public long? BookingId { get; set; } public string? BookingNumber { get; set; }
        public string? AgentReference { get; set; }
        public int CustomerId { get; set; } public string CustomerName { get; set; } = "";
        public int? ServiceId { get; set; } public int? PortId { get; set; }
        public int? DestinationId { get; set; } public int? TahteeqPortId { get; set; }
        public int? TripTypeId { get; set; } public decimal EstimatedCost { get; set; }
        public string? Notes { get; set; }
        public string Status { get; set; } = ""; public string? PlannedDate { get; set; }
        public decimal RevenueNet { get; set; } public decimal RevenueTax { get; set; } public decimal ActualCost { get; set; }
