        display: inline-flex; align-items: center; height: 38px; padding: 0 16px;
        border-radius: 10px; border: 1.5px solid var(--fc-border); background: #fff; color: var(--fc-text);
        font-size: 12.5px; font-weight: 800; text-decoration: none; cursor: pointer; white-space: nowrap;
        transition: all .15s ease;
    }
    .opf-act:hover { border-color: var(--fc-blue); color: var(--fc-blue); background: var(--fc-blue-lt); }
    /* أزرار الهيرو الغامق: شفافة بيضاء + العنبر الصلب زي الهيرو القديم */
