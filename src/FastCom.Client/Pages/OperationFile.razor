    .opf-tot-info:focus .opf-tot-tip { opacity: 1; visibility: visible; }

    @@media (max-width: 680px) {
        .opf-tot td { padding: 10px; }
        .opf-tot-lbl b { font-size: 12px; }
        .opf-tot-v { font-size: 13px; }
        .opf-tot-chips { gap: 6px; }
        .opf-tot-tip { width: 280px; font-size: 11px; }
    }
    .doc-link { color: var(--fc-blue); font-weight: 800; text-decoration: none; }
    .doc-link:hover { text-decoration: underline; }
    .doc-sub { font-size: 11px; color: #8496b0; font-weight: 700; }

    /* ================================================================
       8) الأزرار
    ================================================================ */
    .doc-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        height: 37px; padding: 0 16px; border-radius: 10px; cursor: pointer; white-space: nowrap;
        font-family: inherit; font-size: 12.5px; font-weight: 800; text-decoration: none;
        border: 1.5px solid var(--fc-border); background: #fff; color: var(--fc-blue);
        transition: all .15s ease;
    }
    .doc-btn:hover { border-color: var(--fc-blue); background: var(--fc-blue-lt); }
    .doc-btn.primary {
        border-color: transparent; color: #fff;
        background: linear-gradient(135deg, var(--fc-blue), var(--fc-blue-dk));
        box-shadow: 0 4px 12px rgba(30,110,245,.26);
    }
    .doc-btn.primary:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(30,110,245,.34); }
