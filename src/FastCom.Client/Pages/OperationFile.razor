        border-radius: 9px; box-shadow: 0 8px 24px rgba(10,27,59,.3);
        font-size: 11.5px; font-weight: 600; font-style: normal; line-height: 1.9;
        text-align: right; white-space: normal;
        opacity: 0; visibility: hidden; transition: opacity .16s ease, visibility .16s ease;
