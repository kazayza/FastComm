        max-width: 1440px; margin: 0 auto; width: 100%; box-sizing: border-box;
        padding: 18px clamp(14px, 3vw, 40px) 80px;
        display: flex; flex-direction: column; gap: 14px;
    }
    .opf-page * { font-family: "Cairo","Tajawal","Inter",Arial,sans-serif; box-sizing: border-box; }

    @@keyframes opf-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes opf-spin { to { transform: rotate(360deg); } }

    .opf-loading {
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
        background: var(--fc-card); border: 1px solid var(--fc-border); border-radius: 16px;
        padding: 70px 20px; color: var(--fc-muted); font-weight: 700; font-size: 13px;
        box-shadow: 0 2px 10px rgba(15,41,82,.05);
    }
    .opf-spinner {
        width: 34px; height: 34px; border-radius: 50%;
        border: 3px solid #dbe4f2; border-top-color: var(--fc-blue);
        animation: opf-spin .75s linear infinite;
    }

    /* ================================================================
       3) رأس الملف — هيرو غامق (نفس ارتفاع النسخة الفاتحة بالظبط)
       🔧 لو عايز لون الهيرو القديم بالحرف: بدّل سطر background ده بس
    ================================================================ */
    .opf-head {
        display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap;
        border-radius: 16px;
        padding: 18px 22px 16px; position: relative; overflow: hidden;
        background: linear-gradient(135deg, #0a1e4a 0%, #10357a 55%, #1e5fd0 140%);
        border: 1px solid rgba(255,255,255,.10);
        color: #fff;
        box-shadow: 0 10px 28px rgba(10,30,74,.30);
        animation: opf-in .3s ease both;
    }
    .opf-head::before {
        content: ""; position: absolute; top: 0; right: 0; left: 0; height: 3px;
        background: linear-gradient(90deg, var(--fc-blue), rgba(255,255,255,.35) 55%, transparent);
    }
    /* توهج خفيف جوه الهيرو */
    .opf-head::after {
        content: ""; position: absolute; left: -60px; bottom: -80px;
        width: 260px; height: 260px; border-radius: 50%; pointer-events: none;
        background: radial-gradient(circle, rgba(110,168,255,.18), transparent 70%);
    }

    .opf-crumb { font-size: 10.5px; font-weight: 800; letter-spacing: .4px; color: rgba(255,255,255,.6); margin-bottom: 5px; }

    .opf-title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .opf-title { margin: 0; font-size: 21px; font-weight: 900; color: #fff; line-height: 1.25; }

    /* ── Badge الحالة (افتراضي فاتح — جوه الهيرو بيتحول للتلات الشفاف تحت) ── */
    .opf-status {
        display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border-radius: 20px;
        font-size: 11px; font-weight: 800; white-space: nowrap;
    }
    .opf-status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .opf-status.sm { padding: 2.5px 9px; font-size: 10.5px; }
    .st-blue   { background: var(--fc-blue-lt);  color: var(--fc-blue-dk); border: 1px solid #c4d8fb; }
    .st-green  { background: var(--fc-green-lt); color: #0e7a43;            border: 1px solid #b5e8d0; }
    .st-red    { background: var(--fc-red-lt);   color: var(--fc-red);      border: 1px solid #ffc8d0; }
    .st-amber  { background: var(--fc-amber-lt); color: #9a6d08;            border: 1px solid #f0d98a; }
    .st-purple { background: #f3eeff;            color: var(--fc-purple);   border: 1px solid #ddccf7; }
    .st-gray   { background: #eef2f7;            color: #5b6b82;            border: 1px solid #d8e0eb; }

    /* نسخ الهيرو الغامق من نفس الألوان */
    .opf-head .st-blue   { background: rgba(59,130,246,.28);  color: #93c5fd; border-color: rgba(59,130,246,.42); }
    .opf-head .st-green  { background: rgba(34,197,94,.22);   color: #86efac; border-color: rgba(34,197,94,.38); }
    .opf-head .st-red    { background: rgba(239,68,68,.22);   color: #fca5a5; border-color: rgba(239,68,68,.38); }
    .opf-head .st-amber  { background: rgba(234,179,8,.22);   color: #fde68a; border-color: rgba(234,179,8,.38); }
    .opf-head .st-purple { background: rgba(168,85,247,.22);  color: #d8b4fe; border-color: rgba(168,85,247,.38); }
    .opf-head .st-gray   { background: rgba(255,255,255,.12); color: rgba(255,255,255,.78); border-color: rgba(255,255,255,.22); }

    .opf-meta { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 9px; }
    .opf-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 11px; border-radius: 8px; background: #f6f9fd; border: 1px solid #e4ecf6;
