        public decimal Quantity { get; set; } public decimal UnitPrice { get; set; } public decimal Discount { get; set; }
        public int? TaxRateId { get; set; } public long? PriceRuleId { get; set; }
        public decimal LineNet { get; set; }
    }
    public class DetailResponse { public Detail Operation { get; set; } = new(); public List<RevLine> RevenueLines { get; set; } = new(); }

    public class OpTrip
    {
        public long TripId { get; set; } public string TripNumber { get; set; } = "";
        public string DriverName { get; set; } = ""; public string VehiclePlate { get; set; } = "";
        public string Status { get; set; } = ""; public DateTime? PlannedStartAt { get; set; }
        public decimal? FreightAmount { get; set; } public int SequenceNo { get; set; }
    }
    public class OpContainer
    {
        public long OperationContainerId { get; set; } public string? ContainerNumber { get; set; }
        public string? TypeName { get; set; } public string Status { get; set; } = ""; public string? BLNumber { get; set; }
        public string? EditBl { get; set; }
    }
    public class BkLineView
    {
        public string? TypeName { get; set; } public int RequestedQty { get; set; }
        public decimal? WeightKg { get; set; } public decimal? GuaranteePerContainer { get; set; }
        public string? Notes { get; set; }
