    /* ═══════ #78 — توزيع سطور الإيراد حسب وجهة كل رحلة ═══════ */

    private class TripGroup
    {
        public int? PortId { get; set; } public int? DestinationId { get; set; } public int? TahteeqPortId { get; set; }
        public string Route { get; set; } = ""; public int Count { get; set; }
    }

    private class SuggRes
    {
        /* #95 — null ⇒ مفيش قاعدة مطابقة في قوائم الأسعار */
        public decimal? UnitPrice { get; set; } public decimal? CostPrice { get; set; }
        public int? TaxRateId { get; set; } public long? PriceRuleId { get; set; } public string? Source { get; set; }
    }

    private static string RouteOf(OpTrip t)
    {
        var s = t.PortName is not null && t.DestName is not null ? $"من {t.PortName} إلى {t.DestName}"
              : t.PortName is not null                           ? $"من {t.PortName}"
              : t.DestName is not null                           ? $"إلى {t.DestName}" : "";
        if (t.TahteeqName is not null) s = s.Length > 0 ? $"{s} — تعتيق {t.TahteeqName}" : $"تعتيق {t.TahteeqName}";
        return s.Length > 0 ? s : "بدون خط سير محدد";
    }

    /* مجموعات الرحلات حسب خط السير — بتتحسب من الرحلات المحمّلة أصلًا */
    private List<TripGroup> TripGroups() =>
        _trips.GroupBy(t => new { t.PortId, t.DestinationId, t.TahteeqPortId })
              .Select(g => new TripGroup
              {
                  PortId        = g.Key.PortId,
                  DestinationId = g.Key.DestinationId,
                  TahteeqPortId = g.Key.TahteeqPortId,
                  Count         = g.Count(),
                  Route         = RouteOf(g.First())
              })
              .OrderByDescending(x => x.Count)
              .ToList();

    /* اقتراح فقط — المستخدم يعدّل أو يلغي، ومافيش منع */
    private async Task SplitRevenueByDestinationAsync()
    {
        if (_d is null) return;
        var groups = TripGroups();
        if (groups.Count < 2) return;

        var svcId = _d.ServiceId ?? (_lines.Count > 0 ? _lines[0].ServiceId : 0);
        if (svcId <= 0) { Snackbar.Add("اختر الخدمة أولًا قبل التوزيع", Severity.Warning); return; }
        var svcName = _services.FirstOrDefault(s => s.Id == svcId)?.Label ?? "";

        var built = new List<RevLine>();
        foreach (var g in groups)
        {
            var ln = new RevLine
            {
                ServiceId   = svcId,
                ServiceName = svcName,
                Quantity    = g.Count,
                Description = g.Route
            };
            await SuggestForRouteAsync(ln, g);
            built.Add(ln);
        }

        _lines.Clear();
        foreach (var ln in built) _lines.Add(ln);
        _splitDone = true;
        Snackbar.Add($"تم توزيع الإيراد على {groups.Count} بنود حسب وجهات الرحلات — راجع الأسعار واحفظ", Severity.Info);
    }

    private async Task SuggestForRouteAsync(RevLine ln, TripGroup g)
    {
        if (_d is null || _d.CustomerId <= 0 || ln.ServiceId <= 0) return;
        var url = $"api/operations/price-suggest?customerId={_d.CustomerId}&serviceId={ln.ServiceId}" +
                  (g.PortId        is not null ? $"&portId={g.PortId}" : "") +
                  (g.DestinationId is not null ? $"&destinationId={g.DestinationId}" : "") +
                  (g.TahteeqPortId is not null ? $"&tahteeqPortId={g.TahteeqPortId}" : "");
        try
        {
            var s = await Http.GetFromJsonAsync<SuggRes>(url);
            if (s is null) return;
            /* #95 — null ⇒ مفيش قاعدة مطابقة؛ ما نلمسش السعر الموجود */
            if (s.UnitPrice is null) return;
            ln.UnitPrice   = s.UnitPrice.Value;
            ln.TaxRateId   = s.TaxRateId;
            ln.PriceRuleId = s.PriceRuleId;
        }
        catch { /* الاقتراح اختياري */ }
    }

    private async Task SaveRevenueAsync()
    {
        if (_d is null) return;
        _savingRev = true;
        try
        {
            var payload = new
            {
                bookingId     = _d.BookingId,
                customerId    = _d.CustomerId,
                serviceId     = _d.ServiceId,
                portId        = _d.PortId,
                destinationId = _d.DestinationId,
                tahteeqPortId = _d.TahteeqPortId,
                tripTypeId    = _d.TripTypeId,
                plannedDate   = string.IsNullOrEmpty(_d.PlannedDate) ? null : _d.PlannedDate[..10],
                estimatedCost = _d.EstimatedCost,
                notes         = _d.Notes,
                revenueLines  = _lines.Select(l => new
                {
                    serviceId   = l.ServiceId,
                    description = l.Description,
                    quantity    = l.Quantity,
                    unitPrice   = l.UnitPrice,
                    discount    = l.Discount,
                    taxRateId   = l.TaxRateId,
                    priceRuleId = l.PriceRuleId
                }).ToList()
            };
            var res = await Http.PutAsJsonAsync($"api/operations/{Id}", payload);
            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode) { Snackbar.Add("✅ تم حفظ سطور الإيراد", Severity.Success); await LoadAsync(); }
            else Snackbar.Add(msg, Severity.Error);
