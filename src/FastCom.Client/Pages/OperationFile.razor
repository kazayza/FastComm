    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();

        /* نفس طلبات الـ Options زي الأصل بالظبط — بس متوازية بدل واحدة ورا التانية */
        var tDrivers  = SafeGet("api/options/drivers");
        var tVehicles = SafeGet("api/options/vehicles");
        var tTrailers = SafeGet("api/options/trailers");
        var tDrvPairs = SafeGetList<PairOpt>("api/options/drivers-pairing");
        var tVehPairs = SafeGetList<PairOpt>("api/options/vehicles-pairing");
        var tServices = SafeGet("api/options/services");
        var tContTps  = SafeGet("api/options/container-types");
        var tQeTypes  = SafeGetList<QExpType>("api/options/expense-types");
        var tCustod   = SafeGetList<QCustody>("api/options/custodies");
        var tRecTps   = SafeGet("api/options/receipt-types");
        var tMethods  = SafeGetList<QMethod>("api/options/payment-methods");

        await Task.WhenAll(tDrivers, tVehicles, tTrailers, tDrvPairs, tVehPairs, tServices, tContTps, tQeTypes, tCustod, tRecTps, tMethods);

        _drivers      = tDrivers.Result;
        _vehicles     = tVehicles.Result;
        _trailers     = tTrailers.Result;
        _driverPairs  = tDrvPairs.Result;
        _vehiclePairs = tVehPairs.Result;
        _services       = tServices.Result;
        _containerTypes = tContTps.Result;
        _qeTypes        = tQeTypes.Result;
        _qeCustodies    = tCustod.Result;
        _qeReceiptTypes = tRecTps.Result;
        _qeCashMethodId = tMethods.Result.FirstOrDefault(m => m.IsCashBased)?.Id;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var d = await Http.GetFromJsonAsync<DetailResponse>($"api/operations/{Id}");
            if (d is not null) { _d = d.Operation; _lines = d.RevenueLines; }
        }
        catch { }
        _trips      = await SafeGetList<OpTrip>($"api/operations/{Id}/trips");
        _containers = await SafeGetList<OpContainer>($"api/operations/{Id}/containers");
        foreach (var c in _containers) c.EditBl = c.BLNumber;
        _bkLines  = await SafeGetList<BkLineView>($"api/operations/{Id}/booking-lines");
        _expenses = await SafeGetList<ExpLine>($"api/expenses?operationId={Id}");
    }

    private async Task<List<Opt>> SafeGet(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Opt>>(url) ?? new(); } catch { return new(); }
    }
    private async Task<List<T>> SafeGetList<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); } catch { return new(); }
    }

    private async Task AddTripAsync()
    {
        if (_tf.DriverId <= 0 || _tf.VehicleId <= 0) { Snackbar.Add("اختر السائق والسيارة", Severity.Warning); return; }
        var payload = new
        {
            driverId      = _tf.DriverId,
            vehicleId     = _tf.VehicleId,
            trailerId     = _tf.TrailerId,
            tripTypeId    = (int?)null,
            plannedStartAt = _tf.PlannedStartAt,
            notes         = (string?)null,
            freightAmount = _tf.Freight,
            /* #79 — الرحلة الجديدة ترث خط سير العملية (زي quick-create بالظبط).
               كانت بتتعمل بمسار فاضي. */
            portId        = _d?.PortId,
            destinationId = _d?.DestinationId,
            tahteeqPortId = _d?.TahteeqPortId,
            operations    = new[] { new { operationId = Id, sequenceNo = _trips.Count + 1, pickupAt = (string?)null, deliveryAt = (string?)null, notes = (string?)null } }
        };
        _savingTrip = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/trips", payload);
            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(msg, Severity.Success);
                _showTripForm = false; _tf = new();
                await LoadAsync();
            }
            else Snackbar.Add(msg, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally { _savingTrip = false; }
    }

    private static string Fmt(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string FmtN(decimal? v) => v?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    private static decimal ParseDec(object? v) =>
        decimal.TryParse(v?.ToString(), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var d) ? d
        : (decimal.TryParse(v?.ToString(), out d) ? d : 0);
    private static decimal? ParseDecN(object? v) =>
        string.IsNullOrWhiteSpace(v?.ToString()) ? null
        : (decimal.TryParse(v!.ToString(), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var d) ? d
          : (decimal.TryParse(v.ToString(), out d) ? d : (decimal?)null));
    private static int ParseInt(object? v) => int.TryParse(v?.ToString(), out var i) ? i : 0;
    private static int? ParseIntN(object? v) => int.TryParse(v?.ToString(), out var i) && i > 0 ? i : null;

    private static string TripStatusAr(string s) => s switch
    {
        "Planned" => "مخططة", "InProgress" => "جارية", "Completed" => "مكتملة",
        "Cancelled" => "ملغاة", "Closed" => "مغلقة", _ => s
    };

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}

<style>
    /* ================================================================
       1) TOKENS — نفس هوية فاست كوم
    ================================================================ */
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-dk:   #1559cf;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-card:      #ffffff;
    }

    /* ================================================================
       2) PAGE SHELL
    ================================================================ */
