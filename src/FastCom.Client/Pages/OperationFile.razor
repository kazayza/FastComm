@page "/operations/{Id:long}/file"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>ملف العملية — فاست كوم</PageTitle>

<div class="opf-page">

    @if (_d is null)
    {
        <div class="opf-loading">
            <div class="opf-spinner"></div>
            <div>جارٍ تحميل ملف العملية...</div>
        </div>
    }
    else
    {
        <!-- ═══════════ 1) رأس الملف (هيرو غامق) ═══════════ -->
        <header class="opf-head">
            <div class="opf-head-info">
                <div class="opf-crumb">التشغيل · ملف العملية</div>
                <div class="opf-title-row">
                    <h1 class="opf-title">ملف العملية @_d.OperationNumber</h1>
                    <span class="opf-status @StatusClass(_d.Status)">@StatusLabel(_d.Status)</span>
                </div>
                <div class="opf-meta">
                    @if (!string.IsNullOrWhiteSpace(_d.BookingNumber))
                    {
                        <span class="opf-chip">حجز رقم <b>@_d.BookingNumber</b></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_d.AgentReference))
                    {
                        <span class="opf-chip">مرجع الوكيل <b>@_d.AgentReference</b></span>
                    }
                    <span class="opf-chip">العميل <b>@_d.CustomerName</b></span>
                </div>
            </div>
            <div class="opf-actions">
                @if (CanInvoiceCreate && _d.Status != "Cancelled" && _lines.Count > 0)
                {
                    <a class="opf-act primary" href="@($"/invoices/new?operationId={Id}&customerId={_d.CustomerId}")">إنشاء فاتورة العميل</a>
                }
                <a class="opf-act" href="@($"/transport-requests/new/{Id}")">تعديل الطلب</a>
                <a class="opf-act" href="@($"/operations/new/{Id}")">تعديل العملية</a>
            </div>
        </header>

        <!-- ═══════════ 2) شريط الأرقام ═══════════ -->
        <div class="opf-strip">
            @if (CanViewFinancials)
            {
                <div class="opf-stat">
                    <div class="opf-stat-ic c-blue">
                        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round"/></svg>
                    </div>
                    <div>
                        <div class="opf-stat-num">@Revenue.ToString("N2")</div>
                        <div class="opf-stat-lbl">إيراد (صافي)</div>
                    </div>
                </div>
                <div class="opf-stat">
                    <div class="opf-stat-ic c-amber">
                        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/><path d="M8 7h8M8 11h8M8 15h5" stroke-linecap="round"/></svg>
                    </div>
                    <div>
                        <div class="opf-stat-num">@_d.ActualCost.ToString("N2")</div>
                        <div class="opf-stat-lbl">تكلفة فعلية</div>
                    </div>
                </div>
                <div class="opf-stat">
                    <div class="opf-stat-ic @(Profit >= 0 ? "c-green" : "c-red")">
                        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 6l-9.5 9.5-5-5L1 18" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 6h6v6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div>
                        <div class="opf-stat-num @(Profit >= 0 ? "pos" : "neg")">@Profit.ToString("N2")</div>
                        <div class="opf-stat-lbl">
                            الربح التقديري
                            @if (MarginText is not null)
                            {
                                <span class="@MarginCls">@MarginText</span>
                            }
                        </div>
                    </div>
                </div>
            }
            <div class="opf-stat">
                <div class="opf-stat-ic c-slate">
                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </div>
                <div>
                    <div class="opf-stat-num">@_trips.Count <span class="opf-stat-sep">/</span> @_containers.Count</div>
                    <div class="opf-stat-lbl">رحلات / حاويات</div>
                </div>
            </div>
        </div>

        <!-- ═══════════ 3) التابات ═══════════ -->
        <nav class="opf-tabsbar">
            <button type="button" class="@TabCls("revenue")" @onclick='() => _activeTab = "revenue"'>
                <span class="opf-tab-ic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round"/></svg></span>
                سطور الإيراد <span class="n">@_lines.Count</span>
            </button>
            <button type="button" class="@TabCls("containers")" @onclick='() => _activeTab = "containers"'>
                <span class="opf-tab-ic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg></span>
                الحاويات <span class="n">@_containers.Count</span>
            </button>
            <button type="button" class="@TabCls("trips")" @onclick='() => _activeTab = "trips"'>
                <span class="opf-tab-ic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>
                الرحلات <span class="n">@_trips.Count</span>
            </button>
            <button type="button" class="@TabCls("expenses")" @onclick='() => _activeTab = "expenses"'>
                <span class="opf-tab-ic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/><path d="M8 7h8M8 11h8M8 15h5" stroke-linecap="round"/></svg></span>
                المصروفات <span class="n">@_expenses.Count</span>
            </button>
        </nav>

        <!-- ═══════════ تاب: سطور الإيراد ═══════════ -->
        @if (_activeTab == "revenue")
        {
            <section class="opf-panel">
                <div class="opf-sec-head">
                    <div class="opf-sec-id">
                        <div class="opf-sec-ic blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round"/></svg>
                        </div>
                        <div>
                            <div class="opf-sec-title">سطور الإيراد</div>
                            <div class="opf-sec-sub">ما يدفعه العميل عن هذه العملية — تُعدَّل الكمية والسعر والخصم من هنا</div>
                        </div>
                    </div>
                    @if (CanEditLines)
                    {
                        <button type="button" class="doc-btn primary" @onclick="SaveRevenueAsync" disabled="@_savingRev">حفظ السطور</button>
                    }
                </div>

                @* #78 — رحلات العملية موزعة على أكتر من خط سير *@
                @if (CanEditLines && !_splitDone && TripGroups().Count > 1)
                {
                    <div class="opf-split-banner" role="status">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="10" r="3"/><path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/>
                        </svg>
                        <div class="opf-split-body">
                            <strong>@_trips.Count رحلات</strong> على <strong>@TripGroups().Count خطوط سير مختلفة</strong> — سعر كل وجهة ممكن يختلف
                            <ul class="opf-split-list">
                                @foreach (var g in TripGroups())
                                {
                                    <li>@g.Route — <strong>@g.Count</strong> رحلة</li>
                                }
                            </ul>
                        </div>
                        <button type="button" class="opf-split-fix" @onclick="SplitRevenueByDestinationAsync">
                            وزّع على بنود
                        </button>
                        <button type="button" class="opf-split-x" @onclick="() => _splitDone = true"
                                aria-label="إخفاء التنبيه">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
                                 stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </div>
                }

                @if (_lines.Count == 0)
                {
                    <div class="opf-empty">
                        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <b>لا توجد سطور إيراد بعد</b>
                        <span>أضف سطرًا من النموذج بالأسفل ثم اضغط «حفظ السطور».</span>
                    </div>
                }
                else
                {
                    <div class="doc-table-wrap">
                        <table class="doc-table">
                            <thead>
                                <tr>
                                    <th>الخدمة</th><th>البيان</th><th>الكمية</th>
                                    @if (CanViewFinancials) { <th>السعر</th><th>الخصم</th><th>الصافي</th> }
                                    @if (CanEditLines) { <th></th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in _lines)
                                {
                                    <tr>
                                        <td><b>@l.ServiceName</b></td>
                                        <td>@(string.IsNullOrWhiteSpace(l.Description) ? "—" : l.Description)</td>
                                        @if (CanEditLines)
                                        {
                                            <td><input type="number" class="doc-inline-input num" style="width:78px" min="0" step="any" value="@Fmt(l.Quantity)" @onchange="e => l.Quantity = ParseDec(e.Value)" /></td>
                                            <td><input type="number" class="doc-inline-input num" style="width:104px" min="0" step="any" value="@Fmt(l.UnitPrice)" @onchange="e => l.UnitPrice = ParseDec(e.Value)" /></td>
                                            <td><input type="number" class="doc-inline-input num" style="width:88px" min="0" step="any" value="@Fmt(l.Discount)" @onchange="e => l.Discount = ParseDec(e.Value)" /></td>
                                        }
                                        else
                                        {
                                            <td class="num">@l.Quantity</td>
                                            @if (CanViewFinancials)
                                            {
                                                <td class="num">@l.UnitPrice.ToString("N2")</td>
                                                <td class="num">@l.Discount.ToString("N2")</td>
                                            }
                                        }
                                        <td class="num">
                                            @if (CanViewFinancials)
                                            {
                                                <b class="net">@l.LineNet.ToString("N2")</b>
                                            }
                                            else
                                            {
                                                <span class="opf-mask" title="مبلغ — يحتاج صلاحية رؤية المبالغ">••••</span>
                                            }
                                        </td>
                                        @if (CanEditLines)
                                        {
                                            <td>
                                                <button type="button" class="doc-icon-btn danger" title="حذف السطر" @onclick="() => _lines.Remove(l)">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (CanEditLines)
                {
                    <div class="opf-quickform">
                        <div class="doc-form-row wrap">
                            <div class="form-field" style="flex:2">
                                <label class="field-label">خدمة جديدة <span class="field-required">*</span></label>
                                <div class="field-select-wrap">
                                    <select class="field-input field-select" value="@_newRevServiceId"
                                            @onchange="OnNewRevServicePicked" disabled="@_suggestBusy">
                                        <option value="0">— اختر الخدمة —</option>
                                        @foreach (var sv in _services) { <option value="@sv.Id">@sv.Label</option> }
                                    </select>
                                </div>
                            </div>
                            <div class="form-field" style="flex:2">
                                <label class="field-label">البيان</label>
                                <div class="field-input-group">
                                    <input type="text" class="field-input" @bind="_newRevDesc" />
                                </div>
                            </div>
                            <div class="form-field" style="flex:1">
                                <label class="field-label">الكمية <span class="field-required">*</span></label>
                                <div class="field-input-group">
                                    <input type="number" class="field-input" min="0" step="any" value="@Fmt(_newRevQty)" @onchange="e => _newRevQty = ParseDec(e.Value)" />
                                </div>
                            </div>
                            <div class="form-field" style="flex:1">
                                <label class="field-label">السعر</label>
                                <div class="field-input-group">
                                    <input type="number" class="field-input" min="0" step="any" value="@Fmt(_newRevPrice)"
                                           @onchange="e => _newRevPrice = ParseDec(e.Value)" disabled="@_suggestBusy" />
                                </div>
                                <span class="opf-price-src @(_suggestBusy ? "busy" : "")">
                                    @(_suggestBusy ? "جاري جلب السعر من قائمة الأسعار…" : _priceSource)
                                </span>
                            </div>
                            <div class="form-field" style="flex:1">
                                <label class="field-label">الخصم</label>
                                <div class="field-input-group">
                                    <input type="number" class="field-input" min="0" step="any" value="@Fmt(_newRevDisc)" @onchange="e => _newRevDisc = ParseDec(e.Value)" />
                                </div>
                            </div>
                            <div class="form-field doc-form-action">
                                <button type="button" class="doc-btn" @onclick="SuggestNewPriceAsync"
                                        disabled="@(_suggestBusy || _newRevServiceId <= 0)">اقترح السعر</button>
                                <button type="button" class="doc-btn primary" @onclick="AddRevenueLine"
                                        disabled="@_suggestBusy">+ إضافة سطر</button>
                                <button type="button" class="doc-btn" @onclick="AddRevenueLineFromLast" disabled="@_lines.Count == 0">نسخ من آخر سطر</button>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        <!-- ═══════════ تاب: الحاويات ═══════════ -->
        @if (_activeTab == "containers")
        {
            <section class="opf-panel">
                <div class="opf-sec-head">
                    <div class="opf-sec-id">
                        <div class="opf-sec-ic green">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
                        </div>
                        <div>
                            <div class="opf-sec-title">الحاويات (@_containers.Count)</div>
                            <div class="opf-sec-sub">الحاويات الفعلية المربوطة بالعملية</div>
                        </div>
                    </div>
                    @if (CanOpEdit)
                    {
                        <button type="button" class="doc-btn" @onclick="SyncContainersAsync" disabled="@_syncing">مزامنة من الحجز</button>
                    }
                </div>

                @if (_bkLines.Count > 0)
                {
                    <div class="opf-note-title">كما وردت في طلب الحجز</div>
                    <div class="doc-table-wrap" style="margin-bottom:16px">
                        <table class="doc-table">
                            <thead>
                                <tr><th>النوع</th><th>العدد</th><th>الوزن (كجم)</th><th>ضمان الحاوية</th><th>ملاحظات</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var l in _bkLines)
                                {
                                    <tr>
                                        <td>@(l.TypeName ?? "—")</td>
                                        <td class="num">@l.RequestedQty</td>
                                        <td class="num">@(l.WeightKg?.ToString("N0") ?? "—")</td>
                                        <td class="num">
                                            @if (CanViewFinancials)
                                            {
                                                @(l.GuaranteePerContainer?.ToString("N0") ?? "—")
                                            }
                                            else
                                            {
                                                <span class="opf-mask" title="مبلغ — يحتاج صلاحية رؤية المبالغ">••••</span>
                                            }
                                        </td>
                                        <td>@(l.Notes ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_containers.Count == 0)
                {
                    <div class="opf-empty">
                        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><path d="M3.3 7l8.7 5 8.7-5M12 22V12" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <b>لا توجد حاويات فعلية بعد</b>
                        <span>تُنسخ تلقائيًا من تفاصيل حجز الوكيل عند إنشاء العملية، أو أضفها من النموذج بالأسفل.</span>
                    </div>
                }
                else
                {
                    <div class="doc-table-wrap">
                        <table class="doc-table">
                            <thead>
                                <tr><th>رقم الحاوية</th><th>النوع</th><th>البوليصة</th><th>الحالة</th>@if (CanOpEdit && !IsClosed) { <th></th> }</tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _containers)
                                {
                                    <tr>
                                        <td><b>@(c.ContainerNumber ?? "—")</b></td>
                                        <td>@(c.TypeName ?? "—")</td>
                                        @if (CanOpEdit && !IsClosed)
                                        {
                                            <td><input type="text" class="doc-inline-input" style="width:170px" placeholder="رقم البوليصة" @bind="c.EditBl" /></td>
                                        }
                                        else
                                        {
                                            <td>@(c.BLNumber ?? "—")</td>
                                        }
                                        <td><span class="opf-status sm @StatusClass(c.Status)">@StatusLabel(c.Status)</span></td>
                                        @if (CanOpEdit && !IsClosed)
                                        {
                                            <td>
                                                <button type="button" class="doc-icon-btn" title="حفظ البوليصة" @onclick="() => SaveContainerBlAsync(c)">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (CanOpEdit && !IsClosed)
                {
                    <div class="opf-quickform">
                        <div class="doc-form-row wrap">
                            <div class="form-field" style="flex:2">
                                <label class="field-label">رقم حاوية جديد</label>
                                <div class="field-input-group">
                                    <input type="text" class="field-input" @bind="_newContNumber" />
                                </div>
                            </div>
                            <div class="form-field" style="flex:1">
                                <label class="field-label">النوع</label>
                                <div class="field-select-wrap">
                                    <select class="field-input field-select" @bind="_newContTypeId">
                                        <option value="0">— اختر النوع —</option>
                                        @foreach (var t in _containerTypes) { <option value="@t.Id">@t.Label</option> }
                                    </select>
                                </div>
                            </div>
                            <div class="form-field" style="flex:1">
                                <label class="field-label">البوليصة</label>
                                <div class="field-input-group">
                                    <input type="text" class="field-input" @bind="_newContBl" />
                                </div>
                            </div>
                            <div class="form-field doc-form-action">
                                <button type="button" class="doc-btn" @onclick="AddContainerAsync" disabled="@_addingCont">+ إضافة حاوية</button>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        <!-- ═══════════ تاب: الرحلات ═══════════ -->
        @if (_activeTab == "trips")
        {
            <section class="opf-panel">
                <div class="opf-sec-head">
                    <div class="opf-sec-id">
                        <div class="opf-sec-ic blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        </div>
                        <div>
                            <div class="opf-sec-title">الرحلات (@_trips.Count)</div>
                            <div class="opf-sec-sub">رحلة لكل حاوية — يُربط السائق والسيارة من المورد نفسه تلقائيًا</div>
                        </div>
                    </div>
                    @if (CanTripCreate)
                    {
                        <button type="button" class="doc-btn primary" @onclick="() => _showTripForm = !_showTripForm">@(_showTripForm ? "إغلاق النموذج" : "+ إضافة رحلة")</button>
                    }
                </div>

                @if (_showTripForm)
                {
                    <div class="opf-quickform">
                        <div class="doc-form-row wrap">
                            <div class="form-field" style="flex:2">
                                <label class="field-label">السائق <span class="field-required">*</span></label>
                                <div class="field-select-wrap">
                                    <select class="field-input field-select" value="@_tf.DriverId" @onchange="e => OnDriverPicked(ParseInt(e.Value))">
                                        <option value="0">— اختر السائق —</option>
                                        @foreach (var d in OrderedDriverOpts()) { <option value="@d.Id">@d.Label</option> }
                                    </select>
                                </div>
                            </div>
                            <div class="form-field" style="flex:2">
                                <label class="field-label">العربية <span class="field-required">*</span></label>
                                <div class="field-select-wrap">
                                    <select class="field-input field-select" value="@_tf.VehicleId" @onchange="e => OnVehiclePicked(ParseInt(e.Value))">
                                        <option value="0">— اختر العربية —</option>
                                        @foreach (var v in OrderedVehicleOpts()) { <option value="@v.Id">@v.Label</option> }
                                    </select>
                                </div>
                            </div>
                            <div class="form-field" style="flex:1">
                                <label class="field-label">المقطورة</label>
                                <div class="field-select-wrap">
                                    <select class="field-input field-select" value="@(_tf.TrailerId?.ToString() ?? "")" @onchange="e => _tf.TrailerId = ParseIntN(e.Value)">
                                        <option value="">— بدون —</option>
                                        @foreach (var v in _trailers) { <option value="@v.Id">@v.Label</option> }
                                    </select>
                                </div>
                            </div>
                            <div class="form-field" style="flex:1.2">
                                <label class="field-label">ميعاد التحرك</label>
                                <div class="field-input-group">
                                    <input type="datetime-local" class="field-input" value="@_tf.PlannedStartAt" @onchange="e => _tf.PlannedStartAt = e.Value?.ToString()" />
                                </div>
                            </div>
                            <div class="form-field" style="flex:1">
                                <label class="field-label">النولون</label>
                                <div class="field-input-group">
                                    <input type="number" class="field-input" min="0" step="any" value="@FmtN(_tf.Freight)" @onchange="e => _tf.Freight = ParseDecN(e.Value)" />
                                </div>
                            </div>
                            <div class="form-field doc-form-action">
                                <button type="button" class="doc-btn primary" @onclick="AddTripAsync" disabled="@_savingTrip">حفظ الرحلة</button>
                            </div>
                        </div>
                    </div>
                }

                @if (_trips.Count == 0)
                {
                    <div class="opf-empty">
                        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        <b>لا توجد رحلات بعد</b>
                        <span>أضف رحلة جديدة واربطها بسائق وعربية من النموذج بالأعلى.</span>
                    </div>
                }
                else
                {
                    <div class="doc-table-wrap">
                        <table class="doc-table">
                            <thead>
                                <tr><th>الرحلة</th><th>السائق</th><th>العربية</th><th>ميعاد التحرك</th><th>النولون</th><th>الحالة</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var t in _trips)
                                {
                                    <tr>
                                        <td><a class="doc-link" href="@($"/trips/new/{t.TripId}")">@t.TripNumber</a></td>
                                        <td>@t.DriverName</td>
                                        <td>@t.VehiclePlate</td>
                                        <td class="num">@(t.PlannedStartAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                        <td class="num">
                                            @if (CanViewFinancials)
                                            {
                                                @(t.FreightAmount?.ToString("N2") ?? "—")
                                            }
                                            else
                                            {
                                                <span class="opf-mask" title="مبلغ — يحتاج صلاحية رؤية المبالغ">••••</span>
                                            }
                                        </td>
                                        <td><span class="opf-status sm @TripStatusClass(t.Status)">@TripStatusAr(t.Status)</span></td>
                                        <td>
                                            <a class="doc-icon-btn" title="تعديل الرحلة" href="@($"/trips/new/{t.TripId}")">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9" stroke-linecap="round"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linejoin="round"/></svg>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        <!-- ═══════════ تاب: المصروفات ═══════════ -->
        @if (_activeTab == "expenses")
        {
            <section class="opf-panel">
                <div class="opf-sec-head">
                    <div class="opf-sec-id">
                        <div class="opf-sec-ic amber">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/><path d="M8 7h8M8 11h8M8 15h5" stroke-linecap="round"/></svg>
                        </div>
                        <div>
                            <div class="opf-sec-title">المصروفات (@_expenses.Count)</div>
                            <div class="opf-sec-sub">مصروفات التشغيل المربوطة بالعملية</div>
                        </div>
                    </div>
                    <a class="doc-btn" href="/expenses/new">مصروف جديد (شاشة كاملة)</a>
                </div>

                @if (CanExpenseCreate && !IsClosed)
                {
                    <div class="opf-quickform">
                        <div class="doc-form-row wrap">
                            <div class="form-field" style="flex:2">
                                <label class="field-label">نوع المصروف <span class="field-required">*</span></label>
                                <div class="form-field-with-dropdown">
                                    <div class="field-select-wrap">
                                        <input class="field-input"
                                               value="@QeTypeText"
                                               placeholder="اكتب للبحث عن النوع..."
                                               @oninput="OnQeTypeSearch"
                                               @onfocus="() => { _showQeTypeDd = true; _qeFilteredTypes = QeFilterTypes(); }"
                                               @onfocusout="() => _showQeTypeDd = false" />
                                    </div>
                                    @if (_showQeTypeDd && _qeFilteredTypes.Count > 0)
                                    {
                                        <div class="field-dropdown" @onmousedown:preventDefault="true">
                                            @foreach (var t in _qeFilteredTypes)
                                            {
                                                <div class="field-dropdown-item" @onmousedown="() => PickQeType(t)">@t.Label</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            @if (QeCurrentType?.IsReceiptRequired == true)
                            {
                                <div class="form-field" style="flex:1.4">
                                    <label class="field-label">نوع الإيصال <span class="field-required">*</span></label>
                                    <div class="field-select-wrap">
                                        <select class="field-input field-select" @bind="_qe.ReceiptTypeId">
                                            <option value="">— اختر —</option>
                                            @foreach (var r in _qeReceiptTypes) { <option value="@r.Id">@r.Label</option> }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-field" style="flex:1">
                                    <label class="field-label">رقم الإيصال</label>
                                    <div class="field-input-group">
                                        <input type="text" class="field-input" @bind="_qe.ReceiptNumber" />
                                    </div>
                                </div>
                            }
                            <div class="form-field" style="flex:1">
                                <label class="field-label">المبلغ المدفوع <span class="field-required">*</span></label>
                                <div class="field-input-group">
                                    <input type="number" class="field-input" min="0" step="any" value="@Fmt(_qe.Amount)" @onchange="e => _qe.Amount = ParseDec(e.Value)" />
                                </div>
                            </div>
                            <div class="form-field" style="flex:1">
                                <label class="field-label">تاريخ المصروف <span class="field-required">*</span></label>
                                <div class="field-input-group">
                                    <input type="date" class="field-input" value="@_qe.Date"
                                           @onchange="SetQeDate" />
                                </div>
                            </div>
                            <div class="form-field" style="flex:1">
                                <label class="field-label">يتحمّله العميل</label>
                                <div class="field-input-group">
                                    <input type="number" class="field-input" min="0" step="any" value="@FmtN(_qe.Billable)" @onchange="e => _qe.Billable = ParseDecN(e.Value)" />
                                </div>
                            </div>
                            <div class="form-field" style="flex:1.3">
                                <label class="field-label">مصدر المال</label>
                                <div class="qe-src-toggle">
                                    <button type="button" class="@(_qe.Source == "Custody" ? "on" : "")" @onclick='() => _qe.Source = "Custody"'>من عهدة</button>
                                    <button type="button" class="@(_qe.Source == "Treasury" ? "on" : "")" @onclick='() => _qe.Source = "Treasury"'>من الخزينة</button>
                                </div>
                            </div>
                            @if (_qe.Source == "Custody")
                            {
                                <div class="form-field" style="flex:1.8">
                                    <label class="field-label">العهدة <span class="field-required">*</span></label>
                                    <div class="field-select-wrap">
                                        <select class="field-input field-select"
                                                value="@_qe.CustodyId"
                                                @onchange="e => _qe.CustodyId = long.TryParse(e.Value?.ToString(), out var cv) && cv > 0 ? cv : (long?)null">
                                            <option value="">— اختر العهدة —</option>
                                            @foreach (var c in _qeCustodies) { <option value="@c.Id">@c.Label — @c.AmountIssued.ToString("N2") ج.م</option> }
                                        </select>
                                    </div>
                                </div>
                            }
                            @* #79 — نسب المصروف لرحلة (مبيت، أعطال، غرامات...) *@
                            <div class="form-field" style="flex:1.6">
                                <label class="field-label">الرحلة</label>
                                <select class="field-input field-select" value="@_qe.TripId" @onchange="PickQeTrip">
                                    <option value="">— بدون رحلة —</option>
                                    @foreach (var tr in _trips)
                                    {
                                        <option value="@tr.TripId">@tr.TripNumber — @tr.DriverName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-field" style="flex:1.6">
                                <label class="field-label">البيان</label>
                                <div class="field-input-group">
                                    <input type="text" class="field-input" @bind="_qe.Description" />
                                </div>
                            </div>
                            <div class="form-field doc-form-action">
                                <button type="button" class="doc-btn primary" @onclick="QuickExpenseAsync" disabled="@_savingExp">إضافة سريعة</button>
                            </div>
                        </div>
                    </div>
                }

                @if (_expenses.Count == 0)
                {
                    <div class="opf-empty">
                        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/><path d="M8 7h8M8 11h8M8 15h5" stroke-linecap="round"/></svg>
                        <b>لا توجد مصروفات مربوطة بالعملية</b>
                        <span>أضف مصروفًا سريعًا من النموذج بالأعلى أو من شاشة المصروفات الكاملة.</span>
                    </div>
                }
                else
                {
                    <div class="doc-table-wrap">
                        <table class="doc-table opf-exp-table">
                            <colgroup>
                                <col style="width:12%" /><col style="width:23%" /><col style="width:17%" />
                                <col style="width:11%" /><col style="width:13%" /><col style="width:12%" />
                                <col style="width:9%" /><col style="width:3%" />
                            </colgroup>
                            <thead>
                                <tr><th>الرقم</th><th>النوع</th><th>الإيصال</th><th>التاريخ</th><th>المبلغ</th><th class="th-bill">على العميل</th><th>الحالة</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var x in _expenses)
                                {
                                    <tr>
                                        <td class="num">@x.ExpenseNumber</td>
                                        <td><b>@x.TypeName</b></td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(x.ReceiptTypeName))
                                            {
                                                <span>@x.ReceiptTypeName</span>
                                                @if (!string.IsNullOrWhiteSpace(x.ReferenceNumber))
                                                {
                                                    <div class="doc-sub">@x.ReferenceNumber</div>
                                                }
                                            }
                                            else { <span class="doc-sub">—</span> }
                                        </td>
                                        <td class="num">@x.ExpenseDate.ToString("yyyy-MM-dd")</td>
                                        <td class="num"><b>@x.Amount.ToString("N2")</b></td>
                                        <td class="num">
                                            @if (x.BillableAmount > 0)
                                            {
                                                <b class="opf-bill">@x.BillableAmount.ToString("N2")</b>
                                            }
                                            else { <span class="doc-sub">—</span> }
                                        </td>
                                        <td><span class="opf-status sm @StatusClass(x.Status)">@StatusLabel(x.Status)</span></td>
                                        <td>
                                            <a class="doc-icon-btn" title="تعديل المصروف" href="@($"/expenses/new/{x.ExpenseId}")">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9" stroke-linecap="round"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linejoin="round"/></svg>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="opf-tot">
                                    <td colspan="4" class="opf-tot-lbl">
                                        <b>الإجمالي</b>
                                        <span class="opf-tot-cnt">
                                            @_expenses.Count مصروف مربوط بالعملية
                                            <span class="opf-tot-info" tabindex="0">i
                                                <span class="opf-tot-tip" role="tooltip">
                                                    <b>على الشركة</b> = إجمالي المصروف − على العميل
                                                    (اللي بيتفوتر للعميل ويرجعله).
                                                    <b>التكلفة الفعلية</b> = نصيب الشركة من المصروفات
                                                    + نصيب العملية من نولون السائق + توزيع مصروفات الرحلة،
                                                    وبتستثني سلف النولون لأنها متغطّية ضمن نولون النقلَة.
                                                </span>
                                            </span>
                                        </span>
                                    </td>
                                    <td class="num opf-tot-v">@ExpTotal.ToString("N2")</td>
                                    <td class="num opf-tot-v bill">@ExpBillable.ToString("N2")</td>
                                    <td colspan="2"></td>
                                </tr>
                                <tr class="opf-tot2">
                                    <td colspan="8">
                                        <div class="opf-tot-chips">
                                            <span class="opf-chip">إجمالي المصروف <b>@ExpTotal.ToString("N2")</b></span>
                                            <span class="opf-chip">على العميل <b>@ExpBillable.ToString("N2")</b></span>
                                            <span class="opf-chip">على الشركة <b>@ExpCompany.ToString("N2")</b></span>
                                            <span class="opf-chip dark">التكلفة الفعلية <b>@OpCost.ToString("N2")</b></span>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    [Parameter] public long Id { get; set; }

    /* ── التاب النشط ── */
    private string _activeTab = "revenue";
    private string TabCls(string t) => _activeTab == t ? "opf-tab on" : "opf-tab";

    /* ── عرض الحالة والأرباح ── */
    /* #90 — 🔴 المحمّل على العميل **ليس إيرادًا** (فلوس مدفوعة بالنيابة عن
       العميل وهيردّها) ⇒ الإيراد = RevenueNet بس. والتكلفة `ActualCost`
       محسوبة في الداتا = نصيب الشركة (بعد خصم المحمّل، وعدا سلف النولون)
       + توزيع الرحلة + نولون السائق. */
    /* ── #92 سطر الإجماليات في تاب المصروفات ── */
    private decimal ExpTotal    => _expenses.Sum(x => x.Amount);
    private decimal ExpBillable => _expenses.Sum(x => x.BillableAmount);
    private decimal ExpCompany  => ExpTotal - ExpBillable;
    private decimal OpCost      => _d is null ? 0m : _d.ActualCost;

    private decimal Revenue => _d is null ? 0m : _d.RevenueNet;
    private decimal Profit  => _d is null ? 0m : _d.RevenueNet - _d.ActualCost;
    private string MarginCls => Profit >= 0 ? "opf-margin" : "opf-margin neg";
    private string? MarginText
    {
        get
        {
            if (_d is null || Revenue <= 0) return null;
            return $"{(Profit >= 0 ? "+" : "−")}{Math.Abs(Profit / Revenue * 100):N0}%";
        }
    }

    private static string StatusLabel(string s) => s switch
    {
        "New" => "جديدة", "Draft" => "مسودة", "Confirmed" => "مؤكدة",
        "Assigned" => "معرّفة", "InProgress" => "قيد التنفيذ", "Completed" => "مكتملة",
        "Closed" => "مغلقة", "Cancelled" => "ملغاة",
        /* #92 — «Posted» هي الحالة الافتراضية لكل مصروف (DF_Expenses_Status)
           وكانت بتطلع بالإنجليزي لأنها مش في القاموس. */
        "Posted" => "مُرحّل", "Unpaid" => "غير مدفوع",
        "PartiallyPaid" => "مدفوع جزئيًا", "Active" => "نشط", "Suspended" => "موقوف",
        "Paid" => "مدفوع", "Approved" => "معتمد", "Pending" => "معلّق", "Rejected" => "مرفوض",
        _ => s
    };
    private static string StatusClass(string s) => s switch
    {
        "New" or "Confirmed" => "st-blue",
        "Completed" or "Paid" or "Posted" or "Active" => "st-green",
        "Cancelled" or "Rejected" => "st-red",
        "InProgress" or "Draft" or "Pending" => "st-amber",
        "Assigned" or "Approved" => "st-purple",
        _ => "st-gray"
    };
    private static string TripStatusClass(string s) => s switch
    {
        "Planned" => "st-blue", "InProgress" => "st-amber", "Completed" => "st-green",
        "Cancelled" => "st-red", "Closed" => "st-gray", _ => "st-gray"
    };

    private AuthUser? _user;
    private bool CanTripCreate => _user?.Can("TRIP.CREATE") ?? false;
    private bool CanOpEdit => _user?.Can("OPERATION.EDIT") ?? false;
    private bool CanExpenseCreate => _user?.Can("EXPENSE.CREATE") ?? false;
    private bool CanInvoiceCreate => _user?.Can("INVOICE.CREATE") ?? false;
    private bool CanViewFinancials => (_user?.IsAdmin ?? false) || (_user?.Can("OPERATION.VIEW_FINANCIALS") ?? false);
    private bool IsClosed => _d?.Status is "Closed" or "Cancelled";
    private bool CanEditLines => CanViewFinancials && CanOpEdit && !IsClosed;
    private bool _syncing;

    /* ── تحرير مباشر من الملف: إيراد/حاويات/مصروف سريع ── */
    private List<Opt> _services = new(), _containerTypes = new();
    private bool _savingRev;
    private int _newRevServiceId;
    private decimal _newRevPrice;
    /* #93 — السعر بييجي أوتوماتيك من قائمة الأسعار لما تختار الخدمة */
    private bool _suggestBusy;
    private string _priceSource = "";
    private decimal _newRevQty;
    private string? _newRevDesc;
    private decimal _newRevDisc;
    private int? _newRevTaxRateId;
    private long? _newRevRuleId;
    private string? _newContNumber, _newContBl;
    private int _newContTypeId;
    private bool _addingCont;

    private class QuickExp
    {
        public int TypeId { get; set; } public decimal Amount { get; set; }
        public decimal? Billable { get; set; } public string? Description { get; set; }
        public int? ReceiptTypeId { get; set; } public string? ReceiptNumber { get; set; }
        public string Source { get; set; } = "Treasury"; public long? CustodyId { get; set; }
        /* التاريخ كان DateTime.Today ثابت في الـ payload — بقى خانة في الفورم،
           وافتراضيًا النهارده. السيرفر بيقبله زي ما هو (ExpensesController:39 Dt()). */
        public string Date { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        /* #79 — المصروف بيتنسب لرحلة وسائق (كانوا null ثابت في الـ payload) */
        public long? TripId { get; set; } public int? DriverId { get; set; }
    }
    private QuickExp _qe = new();

    /* تاريخ المصروف — method group مش lambda: السلسلة "yyyy-MM-dd" جوه
       خاصية @onchange="..." كانت بتكسر الرازور (CS1026). */
    private void SetQeDate(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _qe.Date = DateTime.TryParse(v, out var d) ? d.ToString("yyyy-MM-dd")
                                                   : DateTime.Today.ToString("yyyy-MM-dd");
    }

    /* #79 — لمّا تختار رحلة، السائق يتعبّى منها تلقائي */
    private void PickQeTrip(ChangeEventArgs e)
    {
        _qe.TripId   = long.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;
        _qe.DriverId = _trips.FirstOrDefault(t => t.TripId == _qe.TripId)?.DriverId;
    }
    private bool _savingExp;

    public class QExpType { public int Id { get; set; } public string Label { get; set; } = ""; public bool IsReceiptRequired { get; set; } public bool IsFreightAdvance { get; set; } }
    public class QCustody { public long Id { get; set; } public string Label { get; set; } = ""; public decimal AmountIssued { get; set; } }
    public class QMethod { public int Id { get; set; } public bool IsCashBased { get; set; } }
    private List<QExpType> _qeTypes = new();
    private List<QCustody> _qeCustodies = new();
    private List<Opt> _qeReceiptTypes = new();
    private int? _qeCashMethodId;
    private string _qeTypeSearch = "";
    private bool _qeTypeTouched, _showQeTypeDd;
    private List<QExpType> _qeFilteredTypes = new();

    private QExpType? QeCurrentType => _qeTypes.FirstOrDefault(t => t.Id == _qe.TypeId);
    private string QeTypeText =>
        !_qeTypeTouched && _qe.TypeId > 0
