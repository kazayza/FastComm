/* ═══════ #93 — السعر الأوتوماتيك من قوائم الأسعار ═══════
       نفس endpoint `price-suggest` اللي بيستخدمه RequestForm:
       قاعدة العميل → التعريفة العامة.  (#95 شال سعر الخدمة الافتراضي)
       🔴 الشاشة دي ما بتبعتش containerTypeId — فقاعدة محدّدة بنوع حاوية
       مش هتطابق هنا. معروف ومتسجّل في #99.
       البُعد (ميناء/وجهة/تحقيق) بيتاخد من أكثر وجهة رحلات متكررة
       عشان القاعدة الأخص هي اللي تكسب. */
    private TripGroup? MainTripGroup() => TripGroups().FirstOrDefault();

    private async Task OnNewRevServicePicked(ChangeEventArgs e)
    {
        var id = ParseInt(e.Value);
        _newRevServiceId = id;
        _newRevPrice = 0;
        _priceSource = "";
        if (id > 0) await SuggestNewPriceAsync();
    }

    private async Task SuggestNewPriceAsync()
    {
        if (_d is null || _d.CustomerId <= 0 || _newRevServiceId <= 0 || _suggestBusy) return;
        _suggestBusy = true;
        try
        {
            var g = MainTripGroup();
            var url = $"api/operations/price-suggest?customerId={_d.CustomerId}&serviceId={_newRevServiceId}" +
                      (g?.PortId        is not null ? $"&portId={g.PortId}" : "") +
                      (g?.DestinationId is not null ? $"&destinationId={g.DestinationId}" : "") +
                      (g?.TahteeqPortId is not null ? $"&tahteeqPortId={g.TahteeqPortId}" : "");
            var r = await Http.GetFromJsonAsync<SuggRes>(url);
            if (r is null) { _priceSource = "ما قدرش يجيب السعر"; return; }
            /* #95 — السعر من قوائم الأسعار بس؛ null ⇒ مفيش قاعدة مطابقة */
            if (r.UnitPrice is null)
            {   /* #99 — جملة بسيطة بس */
                _priceSource = "لا يوجد قاعدة تسعير";
                return; }
            _newRevPrice = r.UnitPrice.Value;
            _newRevTaxRateId = r.TaxRateId;
            _newRevRuleId = r.PriceRuleId;
            _priceSource = "يوجد قاعدة تسعير";   /* #99 — جملة بسيطة بس */
        }
        catch { _priceSource = "تعذّر جلب السعر من قائمة الأسعار"; }
        finally { _suggestBusy = false; }
    }

    private void AddRevenueLine()
        {
            if (_newRevServiceId <= 0) { Snackbar.Add("اختر الخدمة أولًا", Severity.Warning); return; }
            _lines.Add(new RevLine
            {
                ServiceId   = _newRevServiceId,
                ServiceName = _services.FirstOrDefault(s => s.Id == _newRevServiceId)?.Label ?? "",
                Quantity    = _newRevQty,
                UnitPrice   = _newRevPrice,
                Discount    = _newRevDisc,
                Description = _newRevDesc ?? "",
                TaxRateId   = _newRevTaxRateId,
                PriceRuleId = _newRevRuleId
            });
            _newRevPrice = 0;
            _newRevQty = 0;
            _newRevDesc = "";
            _newRevDisc = 0;
            _newRevTaxRateId = null;
            _newRevRuleId = null;
            _priceSource = "";
        }

    private void AddRevenueLineFromLast()
    {
        if (_lines.Count == 0) return;
        var last = _lines.Last();
        _lines.Add(new RevLine
        {
