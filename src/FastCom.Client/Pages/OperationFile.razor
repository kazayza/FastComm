    /* ================================================================
       4) شريط الأرقام
    ================================================================ */
    .opf-strip {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        background: var(--fc-card); border: 1px solid var(--fc-border); border-radius: 16px;
        overflow: hidden; box-shadow: 0 2px 12px rgba(15,41,82,.06);
        animation: opf-in .35s ease both;
    }
    .opf-stat { display: flex; align-items: center; gap: 12px; padding: 16px 20px; }
    .opf-stat + .opf-stat { border-inline-start: 1px solid #edf1f7; }

    .opf-stat-ic {
        width: 42px; height: 42px; flex: 0 0 42px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
    }
    .c-blue  { background: var(--fc-blue-lt);  color: var(--fc-blue); }
    .c-green { background: var(--fc-green-lt); color: var(--fc-green); }
