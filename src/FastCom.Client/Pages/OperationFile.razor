    /* ================================================================
       TAB SECTION
    ================================================================ */
    .tab-section {
        padding: 24px clamp(16px, 3vw, 40px) 28px;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    .tab-section-head {
        display: flex; align-items: flex-start; gap: 12px;
        margin-bottom: 22px; padding-bottom: 18px;
        border-bottom: 1px solid #edf1f7;
    }

    .tab-section-icon {
        width: 42px; height: 42px; flex: 0 0 42px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 12px;
    }
    .tab-section-icon.blue  { background: var(--fc-blue-lt);  color: var(--fc-blue);  border: 1px solid #bdd4fc; }
    .tab-section-icon.green { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .tab-section-icon.amber { background: var(--fc-amber-lt); color: var(--fc-amber); border: 1px solid #f0d070; }

    .tab-section-title { font-size: 15px; font-weight: 800; color: #1c2b43; line-height: 1.2; }
    .tab-section-sub   { font-size: 11px; font-weight: 500; color: var(--fc-muted); margin-top: 3px; }

    .tab-section-sub-head {
        display: flex; align-items: center; gap: 7px;
        font-size: 12px; font-weight: 800; color: #344258;
        margin: 22px 0 10px;
        padding-top: 18px; border-top: 1px solid #edf1f7;
    }

    /* ================================================================
       FORM
    ================================================================ */
    .bk-form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 18px;
        width: 100%;
    }

    @@media (max-width: 768px) {
        .bk-form-grid {
            grid-template-columns: 1fr;
        }
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        position: relative;
    }

    .field-label {
        font-size: 12px; font-weight: 800; color: #344258;
        display: flex; align-items: center; gap: 4px;
    }

    .field-required { color: var(--fc-red); font-size: 14px; line-height: 1; }

    .field-input {
        height: 42px; width: 100%;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 13px; padding: 0 12px;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        outline: none;
    }
    .field-input:focus {
        border-color: var(--fc-blue);
        box-shadow: 0 0 0 3px rgba(30,110,245,.10);
        background: #fff;
    }
    .field-input:disabled { opacity: .7; background: #f3f5f8; cursor: not-allowed; }
    .field-input.field-error {
        border-color: var(--fc-red);
        box-shadow: 0 0 0 3px rgba(224,48,72,.08);
    }
    .field-input::placeholder { color: #b0bcc8; }

    .field-textarea {
        height: auto; padding: 10px 12px;
        resize: vertical; min-height: 80px;
    }

    /* Select with icon */
    .field-select-wrap {
        position: relative; display: flex; align-items: center;
    }

    .field-select-icon {
        position: absolute; right: 12px; color: #9aaabb;
        pointer-events: none; z-index: 1;
    }

    .field-select {
        padding-right: 36px; cursor: pointer;
        -webkit-appearance: none; appearance: none;
    }
    .field-select:disabled { cursor: not-allowed; }

    /* Input with prefix */
    .field-input-group { position: relative; display: flex; align-items: center; }

    .field-prefix {
        position: absolute; right: 12px;
        display: flex; align-items: center;
        color: #9aaabb; pointer-events: none; z-index: 1;
    }

    .field-input.with-prefix { padding-right: 36px; }

    /* Field Dropdown — للبحث (نفس تصميم field-input) */
    .field-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        left: 0;
        margin-top: 4px;
        background: #fafcff;
        border: 1px solid #d8e2f0;
        border-radius: 9px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
        max-height: 240px;
        overflow-y: auto;
        z-index: 100;
    }

    .field-dropdown-item {
        padding: 10px 12px;
        font-family: inherit;
        font-size: 13px;
        color: var(--fc-text);
        cursor: pointer;
        transition: background .1s;
    }

    .field-dropdown-item:hover {
        background: #eaf1ff;
    }

    .field-hint {
        display: flex; align-items: center; gap: 5px;
        font-size: 10.5px; color: var(--fc-muted); font-weight: 500;
    }

    .field-err-msg { font-size: 10.5px; color: var(--fc-red); font-weight: 700; }

    /* ================================================================
       ROUTE VISUAL
    ================================================================ */
    .bk-route-visual {
        display: flex; align-items: center; gap: 0;
        margin-top: 22px; padding: 14px 20px;
        background: linear-gradient(135deg, #f5f8ff, #eef4ff);
        border: 1px solid #c8d8fb; border-radius: 12px;
        animation: bk-banner-in .25s ease;
    }

    .route-point { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }

    .route-dot {
        width: 14px; height: 14px; border-radius: 50%;
        border: 3px solid;
    }
    .dot-from { background: var(--fc-blue-lt);  border-color: var(--fc-blue); }
    .dot-to   { background: var(--fc-green-lt); border-color: var(--fc-green); }

    .route-label { display: flex; flex-direction: column; gap: 2px; }
    .route-caption { font-size: 9px; font-weight: 600; color: #8899ae; }
    .route-label strong { font-size: 13px; font-weight: 800; color: var(--fc-text); }

    .route-line {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; gap: 0; position: relative; margin: 0 10px;
    }
    .route-truck { font-size: 20px; margin-top: -4px; }

    /* ================================================================
       CONTAINER CARDS
    ================================================================ */
    .bk-containers-empty {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 10px; min-height: 180px;
        border: 2px dashed #d8e8f8; border-radius: 12px;
        background: #f8fbff; text-align: center; padding: 30px;
    }

