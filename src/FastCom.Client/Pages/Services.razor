@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("MASTERDATA.VIEW") ?? false;
    private bool CanManage => (_user?.Can("PRICING.CREATE") ?? false) || (_user?.Can("PRICING.EDIT") ?? false);

    private static readonly string[] Units = { "Trip", "Job", "Hour", "Day", "Unit", "Km", "Ton" };

    private List<Item> _items = new();
    private List<TaxOpt> _taxRates = new();
    private bool _loading;
    private string _search = "";
    private bool _saving;
    private string? _msg;
    private bool _ok = true;
    private bool _fabOpen;
    private int _activeTab;
    private bool _triedSave;
    private int? _editId;
    private bool _modalOpen;
    private Form _f = new();

    public class Item
    {
        public int ServiceId { get; set; }
        public string ServiceCode { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string? NameEn { get; set; }
        public string Unit { get; set; } = "";
        public decimal DefaultSellingPrice { get; set; }
        public decimal DefaultCost { get; set; }
        public int? TaxRateId { get; set; }
        public string? TaxRateName { get; set; }
        public bool IsTaxable { get; set; }
        public string? Gs1Code { get; set; }
        public string? EgsCode { get; set; }
        public bool IsActive { get; set; }
        public int UsageCount { get; set; }
    }

    public class Form
    {
        public string ServiceCode { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string? NameEn { get; set; }
        public string Unit { get; set; } = "Trip";
        public decimal DefaultSellingPrice { get; set; }
        public decimal DefaultCost { get; set; }
        public int? TaxRateId { get; set; }
        public bool IsTaxable { get; set; } = true;
        public string? Gs1Code { get; set; }
        public string? EgsCode { get; set; }
        public bool IsActive { get; set; } = true;
        public int UsageCount { get; set; }
    }

    public class TaxOpt
    {
        public int Id { get; set; }
        public string Label { get; set; } = "";
    }

    private static string UnitAr(string u) => u switch
    {
        "Trip" => "رحلة", "Job" => "مهمة", "Hour" => "ساعة", "Day" => "يوم",
        "Unit" => "وحدة", "Km" => "كيلومتر", "Ton" => "طن", _ => u
    };

    private static string Money(decimal v) => v.ToString("N2");

    private IEnumerable<Item> Filtered => _items.Where(d =>
        string.IsNullOrWhiteSpace(_search) ||
        d.ServiceCode.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        d.NameAr.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        (d.NameEn ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        try { _taxRates = await Http.GetFromJsonAsync<List<TaxOpt>>("api/options/tax-rates") ?? new(); }
        catch { _taxRates = new(); }
        await LoadAsync();
    }

    private async Task Reload()
    {
        _fabOpen = false;
        await LoadAsync();
        Snackbar.Add("تم تحديث البيانات", Severity.Success);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/master/services") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل تحميل البيانات: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void ToggleFab() => _fabOpen = !_fabOpen;
    private void CloseFab() => _fabOpen = false;

    private void ResetForm()
    {
        _editId = null;
        _f = new Form();
        _msg = null;
        _triedSave = false;
        _activeTab = 0;
    }

    private void OpenCreate()
    {
        _fabOpen = false;
        ResetForm();
        _modalOpen = true;
    }

    private void Edit(Item s)
    {
        _editId = s.ServiceId;
        _f = new Form
        {
            ServiceCode         = s.ServiceCode,
            NameAr              = s.NameAr,
            NameEn              = s.NameEn,
            Unit                = s.Unit,
            DefaultSellingPrice = s.DefaultSellingPrice,
            DefaultCost         = s.DefaultCost,
            TaxRateId           = s.TaxRateId,
            IsTaxable           = s.IsTaxable,
            Gs1Code             = s.Gs1Code,
            EgsCode             = s.EgsCode,
            IsActive            = s.IsActive,
            UsageCount          = s.UsageCount
        };
        _msg = null;
        _modalOpen = true;
        _triedSave = false;
        _activeTab = 0;
    }

    private void Close() { _modalOpen = false; }

    private void OnTaxChanged(ChangeEventArgs e) =>
        _f.TaxRateId = int.TryParse(e.Value?.ToString(), out var n) && n > 0 ? n : null;

    private async Task SaveAsync()
    {
        if (_saving) return;
        _triedSave = true;

        if (string.IsNullOrWhiteSpace(_f.ServiceCode))
        {
            _ok = false;
            _msg = "يرجى كتابة الكود التعريفي للخدمة";
            _activeTab = 0;
            return;
        }
        if (string.IsNullOrWhiteSpace(_f.NameAr))
        {
            _ok = false;
            _msg = "يرجى كتابة اسم الخدمة باللغة العربية";
            _activeTab = 0;
            return;
        }

        _saving = true;
        _msg = null;
        try
        {
            var payload = new
            {
                serviceCode         = _f.ServiceCode.Trim(),
                nameAr              = _f.NameAr.Trim(),
                nameEn              = _f.NameEn?.Trim(),
                unit                = _f.Unit,
                defaultSellingPrice = _f.DefaultSellingPrice,
                defaultCost         = _f.DefaultCost,
                taxRateId           = _f.TaxRateId,
                isTaxable           = _f.IsTaxable,
                gs1Code             = _f.Gs1Code?.Trim(),
                egsCode             = _f.EgsCode?.Trim(),
                isActive            = _f.IsActive
            };

            var res = _editId is null
                ? await Http.PostAsJsonAsync("api/master/services", payload)
                : await Http.PutAsJsonAsync($"api/master/services/{_editId}", payload);

            _msg = await MsgOf(res);
            _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                Close();
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _ok = false;
            _msg = "فشل في حفظ البيانات: " + ex.Message;
        }
        finally { _saving = false; }
    }

    private async Task ToggleAsync(Item s, bool activate)
    {
        try
        {
            var url = $"api/master/services/{s.ServiceId}/" + (activate ? "activate" : "deactivate");
            var res = await Http.PostAsync(url, null);
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("فشل: " + ex.Message, Severity.Error);
        }
    }

    private static decimal ParseDec(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n >= 0 ? n : 0m;

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch
        {
            return res.IsSuccessStatusCode ? "تمت العملية بنجاح" : "حصل خطأ غير متوقع";
        }
    }
}