@page "/login"
@layout BlankLayout
@using FastCom.Client.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject CompanyService Company
@inject ISnackbar Snackbar

<PageTitle>تسجيل الدخول — @_company.DisplayName</PageTitle>

<div class="fc-login-page">

    @* ── لوحة البراند ──────────────────────────────────────────────── *@
    <div class="fc-login-brand">
        <div class="fc-brand-glow fc-brand-glow-1"></div>
        <div class="fc-brand-glow fc-brand-glow-2"></div>

        <img src="img/logo.png" class="fc-login-logo" alt="FastCom" />
        <h1>@_company.DisplayName</h1>
        <p class="fc-brand-tagline">نظام إدارة مكتب نقل الحاويات والموانئ</p>

        <ul class="fc-brand-list">
            <li><span class="fc-brand-check">✓</span><span>حجوزات وعمليات نقل متكاملة من الميناء للعميل</span></li>
            <li><span class="fc-brand-check">✓</span><span>رحلات وسائقين وعهد ومصروفات تحت السيطرة</span></li>
            <li><span class="fc-brand-check">✓</span><span>فواتير وتحصيلات وخزينة بدون أوراق</span></li>
            <li><span class="fc-brand-check">✓</span><span>تقارير ربحية لحظية لكل عملية وعميل</span></li>
        </ul>

        <div class="fc-brand-badge">
            <span class="fc-brand-badge-dot"></span>
            بيئة تشغيل حقيقية — بياناتك محفوظة ومؤمّنة
        </div>
    </div>

    @* ── بطاقة الدخول ──────────────────────────────────────────────── *@
    <div class="fc-login-side">
        <div class="fc-login-box">

            <img src="img/logo-icon.png" class="fc-login-mark" alt="FastCom" />

            <div class="fc-login-welcome">
                <h2>FastComm</h2>
                <p>سجّل دخولك للمتابعة إلى لوحة التحكم</p>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                    @_error
                </MudAlert>
            }

            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <MudTextField T="string"
                              @bind-Value="_model.UserName"
                              Label="اسم المستخدم"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                              For="@(() => _model.UserName)"
                              AutoFocus="true"
                              Immediate="true"
                              Class="mb-4" />

                <MudTextField T="string"
                              @bind-Value="_model.Password"
                              Label="كلمة المرور"
                              Variant="Variant.Outlined"
                              InputType="@_pwdType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_pwdIcon"
                              OnAdornmentClick="TogglePassword"
                              For="@(() => _model.Password)"
                              Immediate="true"
                              Class="mb-4" />

                <MudCheckBox T="bool" @bind-Value="_model.RememberMe"
                             Label="تذكّرني" Color="Color.Primary" Dense="true"
                             Class="mb-2" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           Disabled="_busy"
                           Class="fc-login-btn mt-4">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>جارٍ التحقق...</span>
                    }
                    else
                    {
                        <span>دخول</span>
                    }
                </MudButton>
            </EditForm>

            <div class="fc-login-foot">
                <span>© @DateTime.Now.Year @_company.DisplayName</span>
                @if (!string.IsNullOrWhiteSpace(_company.Phone))
                {
                    <span>@_company.Phone</span>
                }
            </div>

        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private LoginModel _model = new();
    private CompanyInfo _company = new();

    private string? _error;
    private bool _busy;

    private bool _pwdVisible;
    private InputType _pwdType = InputType.Password;
    private string _pwdIcon = Icons.Material.Filled.Lock;

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "اسم المستخدم مطلوب")]
        public string UserName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "كلمة المرور مطلوبة")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _company = await Company.GetAsync();

        // لو مسجّل دخول بالفعل، حوّله على طول
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            GoHome();
    }

    private void TogglePassword()
    {
        _pwdVisible = !_pwdVisible;
        _pwdType = _pwdVisible ? InputType.Text : InputType.Password;
        _pwdIcon = _pwdVisible
            ? Icons.Material.Filled.LockOpen
            : Icons.Material.Filled.Lock;
    }

    private async Task SubmitAsync()
    {
        _busy  = true;
        _error = null;
        StateHasChanged();

        var (ok, msg) = await Auth.LoginAsync(
            _model.UserName.Trim(), _model.Password, _model.RememberMe);

        _busy = false;

        if (ok)
        {
            Snackbar.Add($"أهلًا {_model.UserName}", Severity.Success);
            GoHome();
        }
        else
        {
            _error = msg;
        }
    }

    private void GoHome()
    {
        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : "/" + ReturnUrl;
        Nav.NavigateTo(target, forceLoad: false);
    }
}
