    .icon-green  { background: var(--fc-green-lt);  color: var(--fc-green);  border: 1px solid #b0e0c5; }
    .icon-purple { background: var(--fc-purple-lt); color: var(--fc-purple); border: 1px solid #d0bfef; }
    .icon-teal   { background: var(--fc-teal-lt);   color: var(--fc-teal);   border: 1px solid #b0e0dc; }

    .st-section-title { font-size: 14.5px; font-weight: 800; color: #1c2b43; line-height: 1.2; }
    .st-section-sub   { font-size: 11px; font-weight: 500; color: var(--fc-muted); margin-top: 3px; }

    .st-updated-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 9px; border-radius: 7px;
