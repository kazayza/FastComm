    .st-select-wrap { position: relative; }
    .st-sel-icon {
        position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
        color: #9aaabb; pointer-events: none; z-index: 1;
    }
    .st-select { padding-right: 36px; cursor: pointer; -webkit-appearance: none; appearance: none; }

    .st-hint { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--fc-muted); font-weight: 500; }

    /* ================================================================
       ACTIONS BAR
    ================================================================ */
    .st-actions-bar {
