@code {
    private AuthUser? _user;
    private bool CanManage => _user?.Can("SETTINGS.MANAGE") ?? false;

    private int    _tab;
    private bool   _loading, _saving;
    private string? _err;
    private bool   _newOpen;
    private string? _newErr;
    private string _keySearch     = "";
    private string _keyTypeFilter = "";

    private ProfileOut?      _p;
    private ProfileForm?     _pf;
    private List<SettingRow>? _settings;
    private List<TaxOpt>     _taxRates   = new();
    private List<string>     _valueTypes = new() { "String", "Int", "Bool", "Decimal", "Json", "Date" };
    private NewForm _nf = new();

    private static readonly List<SettingRow> NoSet = new();

    private string CompanyName => string.IsNullOrWhiteSpace(_p?.LegalNameAr) ? "—" : _p!.LegalNameAr;
    private int SystemKeys => _settings?.Count(s => s.IsSystem) ?? 0;
    private int LogoCount  => Slots.Count(s => !string.IsNullOrEmpty(s.Path));

    private IEnumerable<SettingRow> FilteredKeys =>
        (_settings ?? NoSet).Where(s =>
            (string.IsNullOrEmpty(_keyTypeFilter) || s.ValueType == _keyTypeFilter) &&
            (string.IsNullOrEmpty(_keySearch) ||
             s.SettingKey.Contains(_keySearch, StringComparison.OrdinalIgnoreCase) ||
             (s.Description ?? "").Contains(_keySearch, StringComparison.OrdinalIgnoreCase)));

    private List<Slot> Slots => new()
    {
        new("main",  "الشعار الرئيسي",       _p?.LogoPath),
        new("dark",  "الشعار (نسخة غامقة)", _p?.LogoDarkPath),
        new("stamp", "الختم الرسمي",          _p?.StampPath)
    };

    private static string TruncatePath(string? path)
    {
        if (string.IsNullOrEmpty(path)) return "—";
        var name = System.IO.Path.GetFileName(path);
        return name.Length > 28 ? name[..25] + "..." : name;
    }

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        await LoadAsync();
    }

    private async Task Reload() { await LoadAsync(); Snackbar.Add("اتحدّثت", Severity.Success); }

    private async Task LoadAsync()
    {
        _loading = true; _err = null;
        try
        {
            _p = await Http.GetFromJsonAsync<ProfileOut>("api/settings/company");
            if (_p is not null) _pf = ProfileForm.From(_p);

            _settings = await Http.GetFromJsonAsync<List<SettingRow>>("api/settings");

            var opt = await Http.GetFromJsonAsync<Opts>("api/settings/options");
            if (opt is not null)
            {
                _taxRates   = opt.TaxRates   ?? new();
                _valueTypes = opt.ValueTypes is { Count: > 0 } ? opt.ValueTypes : _valueTypes;
            }
        }
        catch (Exception ex) { _err = ex.Message; }
        finally { _loading = false; }
    }

