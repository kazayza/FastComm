@page "/settings"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>الإعدادات — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">النظام · الإعدادات</div>
                <h1 class="fc-hero-title">الإعدادات</h1>
                <p class="fc-hero-sub">بيانات الشركة اللي بتتطبع في الفواتير والمستندات · ومفاتيح النظام العامة</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
            </div>
        </div>

        <div class="fc-kpis fc-kpis-glass">
            <div class="fc-kpi">
                <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.Business" /></div>
                <div>
                    <div class="fc-kpi-num" style="font-size:.95rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px">
                        @CompanyName
                    </div>
                    <div class="fc-kpi-lb">الشركة</div>
                </div>
            </div>
            <div class="fc-kpi">
                <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.Tune" /></div>
                <div><div class="fc-kpi-num">@(_settings?.Count ?? 0)</div><div class="fc-kpi-lb">مفتاح النظام</div></div>
            </div>
            <div class="fc-kpi">
                <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" /></div>
                <div><div class="fc-kpi-num">@SystemKeys</div><div class="fc-kpi-lb">مفاتيح أساسية</div></div>
            </div>
            <div class="fc-kpi">
                <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Image" /></div>
                <div>
                    <div class="fc-kpi-num">@LogoCount</div>
                    <div class="fc-kpi-lb">شعار / ختم</div>
                </div>
            </div>
        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="st-body">

    @if (_err is not null)
    {
        <div class="st-error-box" role="alert">
            <div class="st-err-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20"
                     fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 8v4M12 16h.01" stroke-linecap="round"/>
                </svg>
            </div>
            <div>
                <strong>تعذّر تحميل الإعدادات</strong>
                <p>@_err</p>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="st-loading-wrap">
            <div class="st-spinner" aria-label="جاري التحميل"></div>
            <span>جاري تحميل الإعدادات...</span>
        </div>
    }
    else if (_pf is not null || _settings is not null)
    {
        <div class="st-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="st-tab-panel"
                     @bind-ActivePanelIndex="_tab"
                     Class="st-mud-tabs">


                @* ══════════════════════════════════════
                   TAB 1 — بيانات الشركة
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="stab-label">
                            <div class="stab-icon stab-gold" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                    <path d="M9 22V12h6v10"/>
                                </svg>
                            </div>
                            <span>بيانات الشركة</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="st-tab-section">

                            @* ── البيانات القانونية ── *@
                            <div class="st-section-card">
                                <div class="st-section-head">
                                    <div class="st-section-icon icon-blue" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="st-section-title">البيانات القانونية</div>
                                        <div class="st-section-sub">بتتطبع في الفواتير والمستندات الرسمية</div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_p?.UpdatedAt))
                                    {
                                        <span class="st-updated-badge">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3l2 2" stroke-linecap="round"/>
                                            </svg>
                                            آخر حفظ @_p!.UpdatedAt
                                        </span>
                                    }
                                </div>

                                <div class="st-form-grid">

                                    <div class="st-field">
                                        <label class="st-label">
                                            الاسم القانوني (عربي)
                                            <span class="st-required">*</span>
                                        </label>
                                        <input class="st-input" @bind="_pf!.LegalNameAr" placeholder="الاسم القانوني الكامل" />
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">الاسم القانوني (إنجليزي)</label>
                                        <input class="st-input" @bind="_pf!.LegalNameEn" placeholder="Legal Name in English" dir="ltr" />
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">الاسم التجاري (عربي)</label>
                                        <input class="st-input" @bind="_pf!.TradeNameAr" placeholder="الاسم المعروف به" />
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">الاسم التجاري (إنجليزي)</label>
                                        <input class="st-input" @bind="_pf!.TradeNameEn" placeholder="Trade Name" dir="ltr" />
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">
                                            الرقم الضريبي
                                            <span class="st-required">*</span>
                                        </label>
                                        <div class="st-input-group">
                                            <span class="st-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 16 16" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="1.7">
                                                    <rect x="2" y="2" width="12" height="12" rx="2"/>
                                                    <path d="M5 8h6M5 5h6M5 11h4" stroke-linecap="round"/>
                                                </svg>
                                            </span>
                                            <input class="st-input with-prefix" @bind="_pf!.TaxNumber"
                                                   placeholder="15 رقم" dir="ltr" />
                                        </div>
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">رقم التسجيل (القيمة المضافة)</label>
                                        <input class="st-input" @bind="_pf!.VatRegistrationNumber"
                                               placeholder="اختياري" dir="ltr" />
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">السجل التجاري</label>
                                        <input class="st-input" @bind="_pf!.CommercialRegister"
                                               placeholder="رقم السجل التجاري" dir="ltr" />
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">كود العملة</label>
                                        <input class="st-input" maxlength="3" @bind="_pf!.CurrencyCode"
                                               placeholder="EGP" dir="ltr" style="text-transform:uppercase" />
                                        <div class="st-hint">3 حروف — مثال: EGP أو USD</div>
                                    </div>

                                </div>
                            </div>


                            @* ── العنوان والتواصل ── *@
                            <div class="st-section-card">
                                <div class="st-section-head">
                                    <div class="st-section-icon icon-green" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="st-section-title">العنوان والتواصل</div>
                                        <div class="st-section-sub">بيانات الاتصال بالشركة</div>
                                    </div>
                                </div>

                                <div class="st-form-grid">

                                    <div class="st-field">
                                        <label class="st-label">
                                            العنوان (عربي)
                                            <span class="st-required">*</span>
                                        </label>
                                        <input class="st-input" @bind="_pf!.AddressAr" placeholder="العنوان الكامل" />
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">العنوان (إنجليزي)</label>
                                        <input class="st-input" @bind="_pf!.AddressEn" placeholder="Full Address" dir="ltr" />
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">المدينة (عربي)</label>
                                        <div class="st-input-group">
                                            <span class="st-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                                    <circle cx="12" cy="10" r="3"/>
                                                </svg>
                                            </span>
                                            <input class="st-input with-prefix" @bind="_pf!.CityAr" placeholder="القاهرة" />
                                        </div>
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">المدينة (إنجليزي)</label>
                                        <input class="st-input" @bind="_pf!.CityEn" placeholder="Cairo" dir="ltr" />
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">التليفون</label>
                                        <div class="st-input-group">
                                            <span class="st-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-4.99-5 19.79 19.79 0 01-3.07-8.67A2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                                                </svg>
                                            </span>
                                            <input class="st-input with-prefix" @bind="_pf!.Phone"
                                                   type="tel" placeholder="02-XXXXXXXX" dir="ltr" />
                                        </div>
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">الموبايل</label>
                                        <div class="st-input-group">
                                            <span class="st-prefix" aria-hidden="true">📱</span>
                                            <input class="st-input with-prefix" @bind="_pf!.Mobile"
                                                   type="tel" placeholder="01X-XXXXXXXX" dir="ltr" />
                                        </div>
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">البريد الإلكتروني</label>
                                        <div class="st-input-group">
                                            <span class="st-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="13" height="13"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                                    <path d="M22 6l-10 7L2 6"/>
                                                </svg>
                                            </span>
                                            <input class="st-input with-prefix" @bind="_pf!.Email"
                                                   type="email" placeholder="info@company.com" dir="ltr" />
                                        </div>
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">الموقع الإلكتروني</label>
                                        <div class="st-input-group">
                                            <span class="st-prefix" aria-hidden="true">🌐</span>
                                            <input class="st-input with-prefix" @bind="_pf!.Website"
                                                   placeholder="https://company.com" dir="ltr" />
                                        </div>
                                    </div>

                                </div>
                            </div>


                            @* ── أزرار الحفظ ── *@
                            <div class="st-actions-bar">
                                @if (CanManage)
                                {
                                    <button class="st-save-btn" @onclick="SaveProfile" disabled="@_saving">
                                        @if (_saving)
                                        {
                                            <span class="btn-spinner sm" aria-hidden="true"></span>
                                            <span>جاري الحفظ...</span>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" width="16" height="16"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                                <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            <span>حفظ بيانات الشركة</span>
                                        }
                                    </button>
                                    <span class="st-required-note">
                                        الحقول بالنجمة <span class="st-required">*</span> مطلوبة
                                    </span>
                                }
                                else
                                {
                                    <div class="st-no-perm">
                                        <svg viewBox="0 0 24 24" width="16" height="16"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             aria-hidden="true">
                                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                                            <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                                        </svg>
                                        عرض فقط — التعديل يحتاج صلاحية
                                        <code>SETTINGS.MANAGE</code>
                                    </div>
                                }
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 2 — الشعار والختم
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="stab-label">
                            <div class="stab-icon stab-purple" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <path d="M21 15l-5-5L5 21"/>
                                </svg>
                            </div>
                            <span>الشعار والختم</span>
                            @if (LogoCount > 0)
                            {
                                <span class="stab-count">@LogoCount</span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="st-tab-section">

                            <div class="st-section-card">
                                <div class="st-section-head">
                                    <div class="st-section-icon icon-purple" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                                            <circle cx="8.5" cy="8.5" r="1.5"/>
                                            <path d="M21 15l-5-5L5 21"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="st-section-title">الشعار والختم</div>
                                        <div class="st-section-sub">
                                            png · jpg · webp — الحد الأقصى 5 ميجا لكل ملف
                                        </div>
                                    </div>
                                </div>

                                <div class="st-logo-grid">

                                    @foreach (var slot in Slots)
                                    {
                                        var slotKind = slot.Kind;
                                        <div class="st-logo-card">

                                            @* Preview Area *@
                                            <div class="st-logo-preview @(string.IsNullOrEmpty(slot.Path) ? "preview-empty" : "preview-filled")">
                                                @if (!string.IsNullOrEmpty(slot.Path))
                                                {
                                                    <img src="@slot.Path"
                                                         alt="@slot.Label"
                                                         class="st-logo-img" />
                                                    <div class="st-logo-overlay">
                                                        <span>تغيير</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="st-logo-placeholder" aria-hidden="true">
                                                        <svg viewBox="0 0 24 24" width="36" height="36"
                                                             fill="none" stroke="currentColor" stroke-width="1.4">
                                                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                                                            <circle cx="8.5" cy="8.5" r="1.5"/>
                                                            <path d="M21 15l-5-5L5 21"/>
                                                        </svg>
                                                        <span>لا يوجد</span>
                                                    </div>
                                                }
                                            </div>

                                            @* Meta *@
                                            <div class="st-logo-meta">
                                                <div class="st-logo-name">@slot.Label</div>
                                                @if (!string.IsNullOrEmpty(slot.Path))
                                                {
                                                    <div class="st-logo-path" title="@slot.Path">
                                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                                             aria-hidden="true">
                                                            <path d="M13 10V4a1 1 0 00-1-1H4a1 1 0 00-1 1v6"/>
                                                            <path d="M7 14l-4-4 4-4M9 14l4-4-4-4"/>
                                                        </svg>
                                                        @TruncatePath(slot.Path)
                                                    </div>
                                                }
                                            </div>

                                            @* Upload Button *@
                                            @if (CanManage)
                                            {
                                                <label class="st-upload-btn @(string.IsNullOrEmpty(slot.Path) ? "upload-empty" : "upload-replace")">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2"
                                                         aria-hidden="true">
                                                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                                                        <path d="M17 8l-5-5-5 5M12 3v12" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                    @(string.IsNullOrEmpty(slot.Path) ? "رفع الملف" : "تغيير")
                                                    <InputFile OnChange="e => OnLogo(e, slot.Kind)"
                                                               style="display:none"
                                                               accept=".png,.jpg,.jpeg,.webp" />
                                                </label>
                                            }

                                        </div>
                                    }

                                </div>

                                @* Upload Tips *@
                                <div class="st-upload-tips">
                                    <div class="st-tip">
                                        <svg viewBox="0 0 16 16" width="12" height="12"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        الشعار الرئيسي: يفضل 400×200 px على خلفية شفافة (PNG)
                                    </div>
                                    <div class="st-tip">
                                        <svg viewBox="0 0 16 16" width="12" height="12"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        الختم: يفضل مربع 300×300 px على خلفية شفافة
                                    </div>
                                    <div class="st-tip">
                                        <svg viewBox="0 0 16 16" width="12" height="12"
                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                             aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        الشعار الغامق: للأماكن ذات الخلفية الداكنة — نفس المقاسات
                                    </div>
                                </div>

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 3 — إعدادات الفوترة
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="stab-label">
                            <div class="stab-icon stab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <span>الفوترة</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="st-tab-section">

                            <div class="st-section-card">
                                <div class="st-section-head">
                                    <div class="st-section-icon icon-blue" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="st-section-title">إعدادات الفوترة</div>
                                        <div class="st-section-sub">الضريبة الافتراضية والسنة المالية وحاشية الفاتورة</div>
                                    </div>
                                </div>

                                <div class="st-form-grid">

                                    <div class="st-field">
                                        <label class="st-label">نسبة الضريبة الافتراضية</label>
                                        <div class="st-select-wrap">
                                            <svg class="st-sel-icon" viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M20 12V22H4V12M22 7H2v5h20V7zM12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
                                            </svg>
                                            <select class="st-input st-select" @bind="_pf!.DefaultTaxRateId">
                                                <option value="">— بدون ضريبة افتراضية —</option>
                                                @foreach (var t in _taxRates)
                                                {
                                                    <option value="@t.TaxRateId">@t.NameAr (@t.Rate%)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="st-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            بتتطبق على العميل اللي ملهوش نسبة معرّفة
                                        </div>
                                    </div>

                                    <div class="st-field">
                                        <label class="st-label">شهر بداية السنة المالية</label>
                                        <div class="st-select-wrap">
                                            <svg class="st-sel-icon" viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                            </svg>
                                            <select class="st-input st-select" @bind="_pf!.FiscalYearStartMonth">
                                                @for (var m = 1; m <= 12; m++)
                                                {
                                                    var mm = m;
                                                    <option value="@mm">@MonthName(mm)</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="st-field st-field-full">
                                        <label class="st-label">حاشية الفاتورة (عربي)</label>
                                        <input class="st-input" @bind="_pf!.InvoiceFooterNoteAr"
                                               placeholder="مثال: شكراً لتعاملكم معنا · جميع المبالغ بالجنيه المصري" />
                                    </div>

                                    <div class="st-field st-field-full">
                                        <label class="st-label">حاشية الفاتورة (إنجليزي)</label>
                                        <input class="st-input" @bind="_pf!.InvoiceFooterNoteEn"
                                               placeholder="Thank you for your business · All amounts in EGP"
                                               dir="ltr" />
                                    </div>

                                </div>

                                @* Preview الحاشية *@
                                @if (!string.IsNullOrWhiteSpace(_pf?.InvoiceFooterNoteAr) || !string.IsNullOrWhiteSpace(_pf?.InvoiceFooterNoteEn))
                                {
                                    <div class="st-invoice-preview">
                                        <div class="st-inv-prev-label">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                <circle cx="12" cy="12" r="3"/>
                                            </svg>
                                            معاينة الحاشية
                                        </div>
                                        <div class="st-inv-prev-body">
                                            @if (!string.IsNullOrWhiteSpace(_pf?.InvoiceFooterNoteAr))
                                            {
                                                <div class="st-inv-prev-ar">@_pf!.InvoiceFooterNoteAr</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(_pf?.InvoiceFooterNoteEn))
                                            {
                                                <div class="st-inv-prev-en" dir="ltr">@_pf!.InvoiceFooterNoteEn</div>
                                            }
                                        </div>
                                    </div>
                                }

                            </div>

                            <div class="st-actions-bar">
                                @if (CanManage)
                                {
                                    <button class="st-save-btn" @onclick="SaveProfile" disabled="@_saving">
                                        @if (_saving)
                                        {
                                            <span class="btn-spinner sm" aria-hidden="true"></span>
                                            <span>جاري الحفظ...</span>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" width="16" height="16"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 aria-hidden="true">
                                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                                <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            <span>حفظ إعدادات الفوترة</span>
                                        }
                                    </button>
                                }
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 4 — مفاتيح النظام
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="stab-label">
                            <div class="stab-icon stab-teal" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                    <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <span>مفاتيح النظام</span>
                            @if (_settings?.Count > 0)
                            {
                                <span class="stab-count">@_settings!.Count</span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="st-tab-section">

                            @* ── Toolbar ── *@
                            <div class="st-keys-toolbar">

                                <div class="st-keys-search-wrap">
                                    <svg class="st-keys-search-icon" viewBox="0 0 24 24"
                                         width="15" height="15" fill="none" stroke="currentColor"
                                         stroke-width="2" aria-hidden="true">
                                        <circle cx="11" cy="11" r="8"/>
                                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                    </svg>
                                    <input class="st-keys-search"
                                           placeholder="ابحث بالمفتاح أو الوصف..."
                                           @bind="_keySearch"
                                           @bind:event="oninput"
                                           aria-label="بحث في المفاتيح" />
                                </div>

                                <div class="st-keys-type-filter">
                                    <select class="st-input" @bind="_keyTypeFilter">
                                        <option value="">كل الأنواع</option>
                                        @foreach (var vt in _valueTypes)
                                        {
                                            <option value="@vt">@vt</option>
                                        }
                                    </select>
                                </div>

                                <div class="st-keys-actions">
                                    @if (CanManage)
                                    {
                                        <button class="st-save-btn sm"
                                                @onclick="SaveBulk"
                                                disabled="@_saving">
                                            @if (_saving)
                                            {
                                                <span class="btn-spinner sm" aria-hidden="true"></span>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" width="14" height="14"
                                                     fill="none" stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                                    <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            }
                                            حفظ التعديلات
                                        </button>
                                        <button class="st-add-key-btn" @onclick="OpenNew">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                                 aria-hidden="true">
                                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                            </svg>
                                            مفتاح جديد
                                        </button>
                                    }
                                    <span class="st-keys-count">
                                        @FilteredKeys.Count() من @(_settings?.Count ?? 0)
                                    </span>
                                </div>

                            </div>

                            @* ── Keys Table ── *@
                            @if (_settings is null || !_settings.Any())
                            {
                                <div class="st-keys-empty">
                                    <div class="st-keys-empty-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="40" height="40"
                                             fill="none" stroke="currentColor" stroke-width="1.4">
                                            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                            <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                                        </svg>
                                    </div>
                                    <div class="st-keys-empty-title">مافيش مفاتيح لسه</div>
                                    <div class="st-keys-empty-sub">
                                        دوس «مفتاح جديد» وضيف الأول،
                                        أو نفّذ <code>sql/FastCom-settings-seed.sql</code>
                                    </div>
                                    @if (CanManage)
                                    {
                                        <button class="st-add-key-btn mt-10" @onclick="OpenNew">
                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                                 aria-hidden="true">
                                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                            </svg>
                                            مفتاح جديد
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="st-keys-table-wrap">
                                    <table class="st-keys-table" aria-label="جدول مفاتيح النظام">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="th-start" style="min-width:200px">المفتاح</th>
                                                <th scope="col" style="min-width:220px">القيمة</th>
                                                <th scope="col">النوع</th>
                                                <th scope="col" style="min-width:220px">الوصف</th>
                                                <th scope="col">آخر تحديث</th>
                                                @if (CanManage)
                                                {
                                                    <th scope="col" style="width:80px"></th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var s in FilteredKeys)
                                            {
                                                <tr>
                                                    <td class="td-start">
                                                        <div class="st-key-cell">
                                                            <div class="st-key-name" dir="ltr">@s.SettingKey</div>
                                                            @if (s.IsSystem)
                                                            {
                                                                <span class="st-system-badge">أساسي</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="st-val-cell">
                                                            @if (s.ValueType == "Bool")
                                                            {
                                                                <select class="st-input-sm" @bind="s.SettingValue">
                                                                    <option value="true">✅ نعم</option>
                                                                    <option value="false">❌ لا</option>
                                                                </select>
                                                            }
                                                            else if (s.ValueType == "Date")
                                                            {
                                                                <input type="date" class="st-input-sm"
                                                                       value="@s.SettingValue"
                                                                       @onchange="e => s.SettingValue = e.Value?.ToString() ?? s.SettingValue" />
                                                            }
                                                            else
                                                            {
                                                                <input class="st-input-sm" @bind="s.SettingValue" placeholder="—" />
                                                            }
                                                            <button class="st-copy-btn"
        @onclick="() => CopyToClipboard(s.SettingValue ?? string.Empty)"
        title="نسخ القيمة"
        aria-label="نسخ قيمة @s.SettingKey">
                                                                <svg viewBox="0 0 24 24" width="12" height="12"
                                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                                    <rect x="9" y="9" width="13" height="13" rx="2"/>
                                                                    <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                                                                </svg>
                                                            </button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="st-type-chip @TypeChipClass(s.ValueType)">
                                                            @s.ValueType
                                                        </span>
                                                    </td>
                                                    <td class="td-desc">@(s.Description ?? "—")</td>
                                                    <td class="td-muted">@(s.UpdatedAt ?? "—")</td>
                                                    @if (CanManage)
                                                    {
                                                        <td>
                                                            @if (!s.IsSystem)
                                                            {
                                                                <button class="st-del-key"
                                                                        @onclick="() => DeleteKey(s)"
                                                                        title="حذف"
                                                                        aria-label="حذف @s.SettingKey">
                                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                                        <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                                    </svg>
                                                                </button>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>


            </MudTabs>
        </div>
    }

</div>


@* ═══════════════════════════════════════════
   MODAL — مفتاح جديد
═══════════════════════════════════════════ *@
@if (_newOpen)
{
    <div class="st-modal-backdrop" @onclick="CloseNew"
         role="dialog" aria-modal="true" aria-label="إضافة مفتاح جديد">
        <div class="st-modal" @onclick:stopPropagation="true">

            <div class="st-modal-head">
                <div class="st-modal-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                        <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <div class="st-modal-title">مفتاح جديد</div>
                    <div class="st-modal-sub">الحروف الكبيرة والأرقام والنقطة والشرطة السفلية فقط</div>
                </div>
                <button class="st-modal-close" @onclick="CloseNew" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_newErr is not null)
            {
                <div class="st-modal-banner banner-error" role="alert">
                    <span>@_newErr</span>
                    <button @onclick="() => _newErr = null">✕</button>
                </div>
            }

            <div class="st-modal-body">

                <div class="st-field">
                    <label class="st-label">
                        اسم المفتاح
                        <span class="st-required">*</span>
                    </label>
                    <input class="st-input"
                           @bind="_nf.SettingKey"
                           placeholder="CUSTODY.MAX_AMOUNT"
                           dir="ltr"
                           style="text-transform:uppercase"
                           aria-required="true" />
                    <div class="st-hint">
                        <svg viewBox="0 0 16 16" width="10" height="10"
                             fill="none" stroke="currentColor" stroke-width="1.8"
                             aria-hidden="true">
                            <circle cx="8" cy="8" r="6"/>
                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                        </svg>
                        حروف كبيرة وأرقام ونقطة وشرطة سفلية — مثال: INVOICE.AUTO_NUMBER
                    </div>
                </div>

                <div class="st-field">
                    <label class="st-label">النوع</label>
                    <div class="st-select-wrap">
                        <svg class="st-sel-icon" viewBox="0 0 24 24" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                            <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                        </svg>
                        <select class="st-input st-select" @bind="_nf.ValueType">
                            @foreach (var vt in _valueTypes)
                            {
                                <option value="@vt">@vt</option>
                            }
                        </select>
                    </div>
                    <div class="st-type-hint-box">
                        <span class="st-type-chip-sm @TypeChipClass(_nf.ValueType)">@_nf.ValueType</span>
                        <span>@TypeHint(_nf.ValueType)</span>
                    </div>
                </div>

                <div class="st-field">
                    <label class="st-label">القيمة</label>
                    <input class="st-input"
                           @bind="_nf.SettingValue"
                           placeholder="سيبها فاضية لو مش عايز تحدد قيمة الآن"
                           dir="ltr" />
                </div>

                <div class="st-field">
                    <label class="st-label">الوصف</label>
                    <input class="st-input"
                           @bind="_nf.Description"
                           placeholder="وصف مختصر — بيظهر في الجدول" />
                </div>

            </div>

            <div class="st-modal-foot">
                <button class="st-modal-cancel" @onclick="CloseNew">إلغاء</button>
                <button class="st-modal-save" @onclick="SaveNew" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الإضافة...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                        </svg>
                        <span>إضافة المفتاح</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   CSS
═══════════════════════════════════════════ *@
<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-teal:      #0d9488;
        --fc-teal-lt:   #e6faf8;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       BODY
    ================================================================ */
    .st-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1100px; width: 100%;
        margin: 0 auto;
    }

    /* ================================================================
       ERROR / LOADING
    ================================================================ */
    .st-error-box {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 14px 18px; border-radius: 12px;
        background: var(--fc-red-lt); border: 1px solid #ffc8cf;
        margin-bottom: 16px;
    }
    .st-err-icon { flex: 0 0 auto; color: var(--fc-red); }
    .st-error-box strong { display: block; font-size: 13px; font-weight: 800; color: #b02040; }
    .st-error-box p { margin: 3px 0 0; font-size: 11.5px; color: var(--fc-red); }

    .st-loading-wrap {
        display: flex; align-items: center; justify-content: center;
        gap: 12px; min-height: 200px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        color: var(--fc-muted); font-size: 13px; font-weight: 600;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .st-spinner {
        width: 28px; height: 28px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: st-spin .75s linear infinite;
    }
    @@keyframes st-spin { to { transform: rotate(360deg); } }

    /* ================================================================
       TABS
    ================================================================ */
    .st-tabs-wrap {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    .st-mud-tabs .mud-tabs-toolbar {
        background: linear-gradient(180deg, #f9fafd 0%, #f3f6fb 100%);
        border-bottom: 2px solid #e8edf5;
        padding: 0 16px; min-height: 56px;
    }

    .st-mud-tabs .mud-tab {
        font-family: "Cairo","Tajawal","Inter",Arial,sans-serif;
        font-size: 12px; font-weight: 700; color: var(--fc-muted);
        padding: 0 6px; min-width: unset; transition: color .15s ease;
    }
    .st-mud-tabs .mud-tab.mud-tab-active { color: var(--fc-blue) !important; font-weight: 800; }
    .st-mud-tabs .mud-tab-slider { background: var(--fc-blue) !important; height: 3px; border-radius: 3px 3px 0 0; }
    .st-mud-tabs .mud-tab:hover:not(.mud-tab-active) { color: var(--fc-text); background: rgba(0,0,0,.03); border-radius: 8px; }

    .st-tab-panel { padding: 0; }

    /* Tab Labels */
    .stab-label { display: flex; align-items: center; gap: 7px; padding: 0 4px; white-space: nowrap; }

    .stab-icon {
        width: 26px; height: 26px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 7px;
    }
    .stab-blue   { background: var(--fc-blue-lt);   color: var(--fc-blue); }
    .stab-green  { background: var(--fc-green-lt);  color: var(--fc-green); }
    .stab-gold   { background: var(--fc-amber-lt);  color: #9a6d08; }
    .stab-purple { background: var(--fc-purple-lt); color: var(--fc-purple); }
    .stab-teal   { background: var(--fc-teal-lt);   color: var(--fc-teal); }

    .stab-count {
        min-width: 18px; height: 18px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 5px; padding: 0 4px;
        background: var(--fc-teal-lt); color: var(--fc-teal);
        font-size: 10px; font-weight: 900;
        font-family: "Inter", Arial, sans-serif;
    }

    /* ================================================================
       TAB SECTION
    ================================================================ */
    .st-tab-section { padding: 20px 24px 24px; display: flex; flex-direction: column; gap: 18px; }

    /* ================================================================
       SECTION CARDS
    ================================================================ */
    .st-section-card {
        border: 1px solid #e4edf8; border-radius: 14px;
        background: linear-gradient(180deg, #fafcff, #f5f8fb);
        padding: 18px 20px;
        transition: border-color .15s ease;
    }
    .st-section-card:hover { border-color: #c8d8f0; }

    .st-section-head {
        display: flex; align-items: flex-start; gap: 12px;
        margin-bottom: 20px; padding-bottom: 16px;
        border-bottom: 1px solid #e4edf8;
        flex-wrap: wrap;
    }

    .st-section-icon {
        width: 42px; height: 42px; flex: 0 0 42px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
    }
