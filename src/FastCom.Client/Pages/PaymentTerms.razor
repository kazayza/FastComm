        public string? NameEn { get; set; }
        public int DueDays { get; set; } = 30;
        public int UsageCount { get; set; }   /* للـ UI بس — قفل الكود */
    }

    /* ── مشتقات العرض ── */
    private IEnumerable<Item> Filtered =>
        _items.Where(Match)
              .OrderBy(i => i.DueDays)
              .ThenBy(i => i.Code, StringComparer.OrdinalIgnoreCase);

    private int UsedCount   => _items.Count(i => i.UsageCount > 0);
    private int UnusedCount => _items.Count(i => i.UsageCount == 0);
    private int AvgDays     => _items.Count == 0
        ? 0
        : (int)Math.Round(_items.Average(i => (double)i.DueDays));

    /// <summary>الكود مقفل عند التعديل إذا كان مرتبطًا بعملاء — نفس قيد الـ API.</summary>
    private bool CodeLocked => _editId is not null && _f.UsageCount > 0;

    private bool Match(Item t)
    {
        var ok = _filter switch
        {
            "used"   => t.UsageCount > 0,
            "unused" => t.UsageCount == 0,
            _        => true
        };
        if (!ok) return false;
        if (string.IsNullOrWhiteSpace(_search)) return true;

        var q = _search.Trim();
        return t.Code.Contains(q, StringComparison.OrdinalIgnoreCase)
            || t.NameAr.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (t.NameEn?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private static string DaysLabel(int d) => d switch
    {
        0    => "فوري",
        1    => "يوم واحد",
        2    => "يومان",
        30   => "شهر",
        60   => "شهران",
        90   => "3 شهور",
        < 11 => $"{d} أيام",
        _    => $"{d} يومًا"
    };

    /// <summary>يقصر الكود على [A-Za-z0-9] ويحوله لأحرف كبيرة — مطابق لقاعدة الـ API.</summary>
    private void OnCodeInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        _f.Code = new string(raw.Where(char.IsLetterOrDigit).ToArray()).ToUpperInvariant();
    }

    private void OpenAdd()
    {
        _editId = null;
        _f = new Form();
        _msg = null;
        _tried = false;
        _modalOpen = true;
    }

    private void CloseModal() => _modalOpen = false;

    /* ── الزر العائم FAB (نفس شاشة الخدمات / طرق الدفع) ── */
    private void ToggleFab()
    {
        _fabOpen = !_fabOpen;
        StateHasChanged();
    }

    private async Task HandleReload()
    {
        _fabOpen = false;
        StateHasChanged();
        await LoadAsync();
        Snackbar.Add("تم تحديث البيانات", Severity.Success);
    }

    private async Task HandleOpenCreate()
    {
        _fabOpen = false;
        StateHasChanged();
        await Task.Delay(180);
        OpenAdd();
    }

    /// <summary>يضبط المدة من أزرار الاقتراح السريعة.</summary>
    private void SetPreset(int days) => _f.DueDays = days;

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) { _loading = false; return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Http.GetFromJsonAsync<List<Item>>("api/master/payment-terms") ?? new();
        }
        catch (Exception ex)
        {
            _items = new();
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private void ResetForm()
    {
        var keepUsage = _f.UsageCount;
        _f = new Form { UsageCount = keepUsage };
        _msg = null;
        _tried = false;
    }

    private void Edit(Item t)
    {
        if (!CanManage) return;
        _editId = t.PaymentTermId;
        _f = new Form
        {
            Code = t.Code, NameAr = t.NameAr, NameEn = t.NameEn,
            DueDays = t.DueDays, UsageCount = t.UsageCount
        };
        _msg = null;
        _tried = false;
        _modalOpen = true;
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _tried = true;
        if (string.IsNullOrWhiteSpace(_f.Code))   { _ok = false; _msg = "الكود مطلوب"; return; }
        if (string.IsNullOrWhiteSpace(_f.NameAr)) { _ok = false; _msg = "الاسم بالعربي مطلوب"; return; }
        if (_f.DueDays is < 0 or > 730)           { _ok = false; _msg = "أيام الاستحقاق لازم تكون بين 0 و 730"; return; }

        _saving = true; _msg = null;
        try
        {
            var payload = new { code = _f.Code, nameAr = _f.NameAr, nameEn = _f.NameEn, dueDays = _f.DueDays };
            var res = _editId is null
                ? await Http.PostAsJsonAsync("api/master/payment-terms", payload)
                : await Http.PutAsJsonAsync($"api/master/payment-terms/{_editId}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { ResetForm(); _editId = null; _modalOpen = false; await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "✅ تم" : "حصل خطأ — حاول تاني"; }
    }
}
