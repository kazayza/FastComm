@page "/master/paymentterms"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>شروط الدفع — فاست كوم</PageTitle>


@* ════════════════════════════════════════════════════════════
   شروط الدفع — تصميم عربي كامل (RTL)
   الهيرو = نفس شاشة الخدمات / طرق الدفع:
   .hero-wrapper › .fc-hero.fc-hero-slim › .fc-hero-inner › .doc-hero-row
   (.doc-hero-left + .doc-hero-right) › .doc-kpis-row (.doc-kpi ×4)
   والإنشاء عبر الزر العائم .fc-fab-container — مفيش زر في الهيرو
   ════════════════════════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">
            <div class="doc-hero-row">
                <div class="doc-hero-left">
                    <div class="doc-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="2" y="5" width="20" height="14" rx="2"/>
                            <path d="M2 10h20" stroke-linecap="round"/>
                        </svg>
                        <span>البيانات الأساسية · شروط الدفع</span>
                    </div>
                    <h1 class="fc-hero-title">شروط الدفع</h1>
                    <p class="fc-hero-sub">مدد الاستحقاق المتفق عليها مع العملاء — تُختار تلقائيًا عند إصدار الفاتورة</p>
                </div>
                <div class="doc-hero-right">
                    <span class="doc-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

            @* ═══ KPIs — .doc-kpis-row (نفس شاشة الخدمات) ═══ *@
            @if (CanView)
            {
                <div class="doc-kpis-row">
                    <div class="doc-kpi doc-kpi-blue">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_items.Count</div>
                                <div class="doc-kpi-label">إجمالي الشروط</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-green">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@UsedCount</div>
                                <div class="doc-kpi-label">مستخدمة في عملاء</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-amber">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@UnusedCount</div>
                                <div class="doc-kpi-label">غير مستخدمة</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-red">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@AvgDays</div>
                                <div class="doc-kpi-label">متوسط الاستحقاق (يوم)</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* ═══ الجسم — .doc-body (نفس عرض الهيرو: --fc-page-w) ═══ *@
<div class="doc-body">


    @* ═══ TOOLBAR ═══ *@
    @if (CanView)
    {
        <div class="pt-toolbar">
            <div class="pt-search">
                <svg class="pt-search-ic" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                </svg>
                <input class="pt-search-input" placeholder="ابحث بالكود أو الاسم..."
                       @bind="_search" @bind:event="oninput" aria-label="بحث" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <button type="button" class="pt-search-clear" @onclick="() => _search = string.Empty" aria-label="مسح البحث">×</button>
                }
            </div>

            <div class="pt-filters" role="group" aria-label="تصفية">
                <button type="button" class="pt-filter @(_filter == "all" ? "active" : "")"
                        @onclick='() => _filter = "all"'>
                    الكل <span class="pt-filter-count">@_items.Count</span>
                </button>
                <button type="button" class="pt-filter @(_filter == "used" ? "active" : "")"
                        @onclick='() => _filter = "used"'>
                    مستخدمة <span class="pt-filter-count">@UsedCount</span>
                </button>
                <button type="button" class="pt-filter @(_filter == "unused" ? "active" : "")"
                        @onclick='() => _filter = "unused"'>
                    غير مستخدمة <span class="pt-filter-count">@UnusedCount</span>
                </button>
            </div>

            <span class="pt-results">
                <strong>@Filtered.Count()</strong> من @_items.Count
            </span>
        </div>
    }


    @* ═══ TABLE ═══ *@
    @if (!CanView)
    {
        <div class="pt-state">
            <div class="pt-state-ic pt-state-ic-err">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="pt-state-t">وصول محظور</div>
            <div class="pt-state-s">
                تحتاج إلى صلاحية <code class="pt-perm">MASTERDATA.VIEW</code> لعرض شروط الدفع.
            </div>
        </div>
    }
    else if (_loading)
    {
        <div class="pt-state">
            <div class="pt-spinner"></div>
            <div class="pt-state-s">جاري تحميل الشروط...</div>
        </div>
    }
    else if (_error is not null)
    {
        <div class="pt-state">
            <div class="pt-state-ic pt-state-ic-err">!</div>
            <div class="pt-state-t">تعذّر تحميل البيانات</div>
            <div class="pt-state-s">@_error</div>
            <button type="button" class="pt-btn pt-btn-ghost" @onclick="LoadAsync">إعادة المحاولة</button>
        </div>
    }
    else if (!Filtered.Any())
    {
        <div class="pt-state">
            <div class="pt-state-ic">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="6" y1="15" x2="12" y2="15"/>
                </svg>
            </div>
            <div class="pt-state-t">@(_items.Count == 0 ? "لا توجد شروط دفع" : "لا نتائج مطابقة")</div>
            <div class="pt-state-s">
                @(_items.Count == 0
                    ? "ابدأ بإضافة أول شرط دفع لتستخدمه في الفواتير."
                    : "جرّب تعديل كلمة البحث أو إظهار كل الفلاتر.")
            </div>
            @if (_items.Count > 0)
            {
                <button type="button" class="pt-btn pt-btn-ghost"
                        @onclick='() => { _search = string.Empty; _filter = "all"; }'>مسح الفلاتر</button>
            }
            else if (CanManage)
            {
                <button type="button" class="pt-btn pt-btn-primary" @onclick="OpenAdd">إضافة أول شرط</button>
            }
        </div>
    }
    else
    {
        <div class="pt-card">
            <div class="pt-table-wrap">
                <table class="pt-table">
                    <thead>
                        <tr>
                            <th style="width:150px;">الكود</th>
                            <th>الاسم بالعربية</th>
                            <th style="width:170px;">الاسم بالإنجليزية</th>
                            <th class="pt-th-center" style="width:130px;">الاستحقاق</th>
                            <th class="pt-th-center" style="width:140px;">الاستخدام</th>
                            @if (CanManage)
                            {
                                <th class="pt-th-center" style="width:70px;">تعديل</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Filtered)
                        {
                            <tr @onclick="() => Edit(t)">
                                <td><span class="pt-code">@t.Code</span></td>
                                <td>@t.NameAr</td>
                                <td class="pt-td-en" dir="ltr">@(string.IsNullOrWhiteSpace(t.NameEn) ? "—" : t.NameEn)</td>
                                <td class="pt-td-center">
                                    <span class="pt-days @(t.DueDays == 0 ? "pt-days-now" : t.DueDays <= 30 ? "pt-days-s" : "pt-days-l")">
                                        @DaysLabel(t.DueDays)
                                    </span>
                                </td>
                                <td class="pt-td-center">
                                    @if (t.UsageCount > 0)
                                    {
                                        <span class="pt-badge pt-badge-used">مستخدمة · @t.UsageCount</span>
                                    }
                                    else
                                    {
                                        <span class="pt-badge pt-badge-free">غير مستخدمة</span>
                                    }
                                </td>
                                @if (CanManage)
                                {
                                    <td class="pt-td-center">
                                        <button type="button" class="pt-edit" aria-label="تعديل"
                                                @onclick:stopPropagation="true" @onclick="() => Edit(t)">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ═══ MODAL ═══ *@
    @if (_modalOpen && CanManage)
    {
        <div class="pt-modal-backdrop" @onclick="CloseModal" role="dialog" aria-modal="true"
             aria-label="@(_editId is null ? "شرط دفع جديد" : "تعديل شرط الدفع")">
            <div class="pt-modal" @onclick:stopPropagation="true">

                <div class="pt-modal-head">
                    <div class="pt-head-icon @(_editId is null ? "pt-icon-create" : "pt-icon-edit")" aria-hidden="true">
                        @if (_editId is null)
                        {
                            <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        }
                    </div>
                    <div class="pt-head-text">
                        <div class="pt-head-title">@(_editId is null ? "شرط دفع جديد" : "تعديل شرط الدفع")</div>
                        <div class="pt-head-sub">
                            @(_editId is null
                                ? "أضف مدة استحقاق جديدة لتُختار عند إصدار الفاتورة."
                                : $"الكود: {_f.Code} · مرتبط بـ {_f.UsageCount} عميل")
                        </div>
                    </div>
                    <button type="button" class="pt-head-close" @onclick="CloseModal" aria-label="إغلاق">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>

                <div class="pt-modal-body">
                    <div class="pt-form-grid">
                        <div class="form-field">
                            <label class="field-label" for="pt-code">
                                الكود <span class="field-required">*</span>
                            </label>
                            <input id="pt-code" type="text" maxlength="30" placeholder="NET30" autocomplete="off"
                                   class="field-input ltr @(_tried && string.IsNullOrWhiteSpace(_f.Code) ? "field-error" : "")"
                                   value="@_f.Code" @oninput="OnCodeInput" disabled="@CodeLocked" />
                            @if (CodeLocked)
                            {
                                <span class="field-hint">مقفل — الكود مرتبط بـ @_f.UsageCount عميل، يمكنك تعديل المدة فقط.</span>
                            }
                            else
                            {
                                <span class="field-hint">حروف إنجليزية وأرقام فقط — حتى 30 حرف.</span>
                            }
                            @if (_tried && string.IsNullOrWhiteSpace(_f.Code))
                            {
                                <span class="field-err-msg">الكود مطلوب.</span>
                            }
                        </div>

                        <div class="form-field">
                            <label class="field-label" for="pt-days">
                                أيام الاستحقاق <span class="field-required">*</span>
                            </label>
                            <div class="field-input-group">
                                <span class="field-prefix">
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                </span>
                                <input id="pt-days" type="number" min="0" max="730" step="1"
                                       class="field-input with-prefix @(_tried && (_f.DueDays < 0 || _f.DueDays > 730) ? "field-error" : "")"
                                       @bind="_f.DueDays" />
                            </div>
                            <div class="pt-presets">
                                @foreach (var p in Presets)
                                {
                                    <button type="button" class="pt-preset @(p.Days == _f.DueDays ? "on" : "")"
                                            @onclick='() => SetPreset(p.Days)'>@p.Label</button>
                                }
                            </div>
                            @if (_tried && (_f.DueDays < 0 || _f.DueDays > 730))
                            {
                                <span class="field-err-msg">المدة لازم تكون بين 0 و 730 يومًا.</span>
                            }
                        </div>
                        <div class="form-field">
                            <label class="field-label" for="pt-ar">
                                الاسم بالعربية <span class="field-required">*</span>
                            </label>
                            <input id="pt-ar" type="text" maxlength="150" placeholder="مثال: صافي 30 يوم"
                                   class="field-input @(_tried && string.IsNullOrWhiteSpace(_f.NameAr) ? "field-error" : "")"
                                   @bind="_f.NameAr" @bind:event="oninput" />
                            @if (_tried && string.IsNullOrWhiteSpace(_f.NameAr))
                            {
                                <span class="field-err-msg">الاسم بالعربية مطلوب.</span>
                            }
                            else
                            {
                                <span class="field-hint">هو الاسم الظاهر في الفواتير والتقارير.</span>
                            }
                        </div>

                        <div class="form-field">
                            <label class="field-label" for="pt-en">الاسم بالإنجليزية</label>
                            <input id="pt-en" type="text" maxlength="150" dir="ltr" placeholder="Net 30 Days"
                                   class="field-input ltr" @bind="_f.NameEn" @bind:event="oninput" />
                            <span class="field-hint">اختياري — يظهر في المستندات الإنجليزية.</span>
                        </div>

                        <div class="form-field pt-field-full">
                            <div class="pt-term-preview">
                                <span>المعاينة:</span>
                                <strong>@DaysLabel(_f.DueDays)</strong>
                                @if (!string.IsNullOrWhiteSpace(_f.NameAr))
                                {
                                    <span class="pt-preview-sep">·</span>
                                    <span>@_f.NameAr</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (_msg is not null)
                    {
                        <div class="pt-alert @(_ok ? "pt-alert-ok" : "pt-alert-err")">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.5" stroke-linecap="round"/>
                            </svg>
                            <span>@_msg</span>
                        </div>
                    }
                </div>

                <div class="pt-modal-foot">
                    <div class="pt-foot-left">
                        @if (_editId is not null)
                        {
                            <button type="button" class="pt-btn pt-btn-ghost" @onclick="ResetForm">إعادة تعيين</button>
                        }
                    </div>
                    <div class="pt-foot-right">
                        <button type="button" class="pt-foot-cancel" @onclick="CloseModal">إلغاء</button>
                        <button type="button" class="pt-foot-save" @onclick="SaveAsync" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="pt-spin"></span>
                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span>@(_editId is null ? "إضافة الشرط" : "حفظ التعديلات")</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* ══════════════════════════════════════════
   FAB — الزر العائم (نفس شاشة الخدمات / طرق الدفع)
   scrim خارج الـ container + قايمة أزرار فوق الزر
══════════════════════════════════════════ *@
@if (CanManage && !_loading)
{
    @if (_fabOpen)
    {
        <div class="fc-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
    }

    <div class="fc-fab-container">
        <div class="fc-fab-menu @(_fabOpen ? "fc-fab-menu--open" : "")" role="menu">
            <button type="button" class="fc-fab-item" role="menuitem"
                    @onclick="HandleOpenCreate">
                <span class="fc-fab-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/>
                </span>
                <span class="fc-fab-label">شرط دفع جديد</span>
            </button>
            <button type="button" class="fc-fab-item" role="menuitem"
                    @onclick="HandleReload">
                <span class="fc-fab-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"/>
                </span>
                <span class="fc-fab-label">تحديث البيانات</span>
            </button>
        </div>

        <button type="button"
                class="fc-fab-main fc-glow-gold @(_fabOpen ? "is-open" : "")"
                @onclick="ToggleFab"
                aria-label="التحكم"
                aria-expanded="@(_fabOpen ? "true" : "false")">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none"
                 stroke="currentColor" stroke-width="2.5" class="fc-fab-svg"
                 aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
}

<style>

/* ═══ 1) الهيرو + KPIs — نفس شاشة الخدمات / طرق الدفع بالحرف ═══
   .hero-wrapper (حد أقصى = --fc-page-w) › .fc-hero.fc-hero-slim ›
   .doc-hero-row (.doc-hero-left + .doc-hero-right) › .doc-kpis-row (.doc-kpi ×4)
   والجسم داخل .doc-body بنفس العرض. */
    .hero-wrapper {
        padding: 16px clamp(14px, 2.4vw, 34px) 0;
        max-width: var(--fc-page-w, 1440px);
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow: 0 12px 32px rgba(13,38,84,.15), 0 4px 12px rgba(13,38,84,.08);
        border: 1px solid rgba(255,255,255,.08);
    }

    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .doc-body {
        padding: 18px clamp(16px, 3vw, 40px) 100px;
        max-width: var(--fc-page-w, 1440px);
        margin-inline: auto;
        box-sizing: border-box;
        width: 100%;
        position: relative;
        z-index: 2;
    }

    .doc-hero-row {
        display: flex; align-items: center;
        justify-content: space-between;
        gap: 16px; flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .doc-hero-left { display: flex; flex-direction: column; gap: 2px; }

    .doc-hero-crumb {
        display: flex; align-items: center; gap: 5px;
        font-size: 10.5px; font-weight: 700;
        color: rgba(255,255,255,.55);
        margin-bottom: 2px;
    }

    .fc-hero-sub { font-size: 10.5px; color: rgba(255,255,255,.55); font-weight: 600; }

    .doc-hero-right {
        display: flex; align-items: center;
        gap: 8px; flex-shrink: 0;
    }

    .doc-hero-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 11px; border-radius: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.14);
        color: rgba(255,255,255,.7);
        font-size: 10.5px; font-weight: 700;
        white-space: nowrap;
    }

    .doc-kpis-row {
