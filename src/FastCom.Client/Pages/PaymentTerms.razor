        flex-direction: column;
        align-items: flex-start;
        gap: 0;
    }

    .fc-fab-menu {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 12px;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(8px);
        transition: opacity .22s ease, transform .22s ease, visibility .22s;
    }

    .fc-fab-menu--open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
    }

    .fc-fab-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
