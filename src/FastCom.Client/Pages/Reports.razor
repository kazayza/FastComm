                                    <div class="rpt-kpi-sub">مكتملة @_ft.Completed</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-green">
                                <div class="rpt-kpi-icon" aria-hidden="true">🛣️</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">المسافة</div>
                                    <div class="rpt-kpi-value">@Num(_ft.TotalKm)</div>
                                    <div class="rpt-kpi-sub">كيلومتر</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-red">
                                <div class="rpt-kpi-icon" aria-hidden="true">🔧</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">الصيانة</div>
                                    <div class="rpt-kpi-value">@Money(_ft.MaintCost)</div>
                                    <div class="rpt-kpi-sub">في الفترة</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-amber">
                                <div class="rpt-kpi-icon" aria-hidden="true">💼</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">عهدة مفتوحة</div>
                                    <div class="rpt-kpi-value">@_ft.Custodies</div>
                                    <div class="rpt-kpi-sub">@Money(_ft.CustodyOut)</div>
                                </div>
                            </div>
                        </div>

                        <div class="rpt-section-head">
                            <div class="rpt-section-title">👨‍✈️ أداء السائقين</div>
                        </div>
                        <div class="rpt-table-wrap" style="max-height:380px">
                            <table class="rpt-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="th-start">السائق</th>
                                        <th scope="col" class="th-num">الرحلات</th>
                                        <th scope="col" class="th-num">مكتملة</th>
                                        <th scope="col" class="th-num">المسافة</th>
                                        <th scope="col" class="th-num">متوسط الساعات</th>
                                        <th scope="col" class="th-num">العهدة المصروفة</th>
                                        <th scope="col" class="th-num">عهد مفتوحة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in _drv ?? NoDrv)
                                    {
                                        <tr>
                                            <td class="td-start">
                                                <div class="rpt-driver-name">@d.DriverName</div>
                                            </td>
                                            <td class="td-num">@d.Trips</td>
                                            <td class="td-num td-muted">@d.Completed</td>
                                            <td class="td-num">@Num(d.TotalKm)</td>
                                            <td class="td-num">@d.AvgHours</td>
                                            <td class="td-num">@Money(d.CustodyIssued)</td>
                                            <td class="td-num @NegClass(d.OpenCustodies)">@d.OpenCustodies</td>
                                        </tr>
                                    }
                                    @if (_drv is null || _drv.Count == 0)
                                    {
                                        <tr><td colspan="7" class="td-empty">مافيش رحلات في الفترة دي</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="rpt-section-head">
                            <div class="rpt-section-title">🚗 أداء السيارات</div>
                            <div class="rpt-section-sub">تكلفة التشغيل مقابل الإيراد</div>
                        </div>
                        <div class="rpt-table-wrap" style="max-height:380px">
                            <table class="rpt-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="th-start">اللوحة</th>
                                        <th scope="col" class="th-num">الرحلات</th>
                                        <th scope="col" class="th-num">مكتملة</th>
                                        <th scope="col" class="th-num">المسافة</th>
                                        <th scope="col" class="th-num">تكلفة التشغيل</th>
                                        <th scope="col" class="th-num">الصيانة</th>
                                        <th scope="col" class="th-num">الإيراد</th>
                                        <th scope="col" class="th-num">الربح</th>
                                        <th scope="col" class="th-num">تكلفة/كم</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in _veh ?? NoVeh)
                                    {
                                        <tr>
                                            <td class="td-start">
                                                <span class="rpt-plate-chip">@v.PlateNumber</span>
                                            </td>
                                            <td class="td-num">@v.Trips</td>
                                            <td class="td-num td-muted">@v.Completed</td>
                                            <td class="td-num">@Num(v.TotalKm)</td>
                                            <td class="td-num td-muted">@Money(v.TripCost)</td>
                                            <td class="td-num td-muted">@Money(v.MaintCost)</td>
                                            <td class="td-num">@Money(v.Revenue)</td>
                                            <td class="td-num @NumClass(v.Profit)">
                                                <strong>@Money(v.Profit)</strong>
                                            </td>
                                            <td class="td-num td-muted">@Money(v.CostPerKm)</td>
                                        </tr>
                                    }
                                    @if (_veh is null || _veh.Count == 0)
                                    {
                                        <tr><td colspan="9" class="td-empty">مافيش رحلات في الفترة دي</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }


                    @* ════════════════════════════════
                       TAB 3 — قائمة الدخل
                    ════════════════════════════════ *@
                    @if (_tab == 3 && CanFin && _pnl is not null)
                    {
                        <div class="rpt-kpi-grid">
                            <div class="rpt-kpi-card kpi-blue">
                                <div class="rpt-kpi-icon" aria-hidden="true">📈</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">الإيرادات (صافي)</div>
                                    <div class="rpt-kpi-value">@Money(_pnl.Revenue)</div>
                                    <div class="rpt-kpi-sub">@_pnl.InvoiceCount فاتورة</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-red">
                                <div class="rpt-kpi-icon" aria-hidden="true">🚛</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">تكلفة التشغيل</div>
                                    <div class="rpt-kpi-value val-neg">@Money(_pnl.OperationCost)</div>
                                    <div class="rpt-kpi-sub">وقود · طرق · ميناء…</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card @(_pnl.GrossProfit >= 0 ? "kpi-green" : "kpi-red")">
                                <div class="rpt-kpi-icon" aria-hidden="true">📊</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">مجمل الربح</div>
                                    <div class="rpt-kpi-value @SignCls(_pnl.GrossProfit)">
                                        @Money(_pnl.GrossProfit)
                                    </div>
                                    <div class="rpt-kpi-sub">هامش @Pct(_pnl.GrossMargin)</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card @(_pnl.NetProfit >= 0 ? "kpi-green" : "kpi-red")">
                                <div class="rpt-kpi-icon" aria-hidden="true">💰</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">صافي الربح</div>
                                    <div class="rpt-kpi-value @SignCls(_pnl.NetProfit)">
                                        @Money(_pnl.NetProfit)
                                    </div>
                                    <div class="rpt-kpi-sub">هامش @Pct(_pnl.NetMargin)</div>
                                </div>
                            </div>
                        </div>

                        <div class="rpt-split-grid">

                            @* قائمة الدخل *@
                            <div class="rpt-panel">
                                <div class="rpt-section-head">
                                    <div class="rpt-section-title">📋 قائمة الدخل</div>
                                    <div class="rpt-section-sub">@RangeFrom — @RangeTo</div>
                                </div>
                                <div class="rpt-pnl-statement">
                                    <div class="rpt-pnl-row">
                                        <span>الإيرادات (قبل الضريبة)</span>
                                        <strong>@Money(_pnl.Revenue)</strong>
                                    </div>
                                    <div class="rpt-pnl-row pnl-sub">
                                        <span>ضريبة القيمة المضافة</span>
                                        <span>@Money(_pnl.Tax)</span>
                                    </div>
                                    <div class="rpt-pnl-row pnl-cost">
                                        <span>(-) تكلفة التشغيل المباشرة</span>
                                        <span class="val-neg">@Money(_pnl.OperationCost)</span>
                                    </div>
                                    <div class="rpt-pnl-row pnl-gross">
                                        <span><strong>= مجمل الربح</strong></span>
                                        <strong class="@SignCls(_pnl.GrossProfit)">@Money(_pnl.GrossProfit)</strong>
                                    </div>
                                    <div class="rpt-pnl-row pnl-cost">
                                        <span>(-) المصروفات الإدارية</span>
                                        <span class="val-neg">@Money(_pnl.OperatingExpenses)</span>
                                    </div>
                                    <div class="rpt-pnl-row pnl-net">
                                        <span><strong>= صافي الربح</strong></span>
                                        <strong class="@SignCls(_pnl.NetProfit)">@Money(_pnl.NetProfit)</strong>
                                    </div>
                                </div>
                                <div class="rpt-pnl-note">
                                    الإيراد محسوب <strong>صافي الخصم وقبل الضريبة</strong> — الضريبة بتتحصّل لصالح مصلحة الضرائب
                                </div>
                            </div>

                            @* Chart — شهري *@
                            <div class="rpt-panel">
                                <div class="rpt-section-head">
                                    <div class="rpt-section-title">📊 إيراد مقابل تكلفة شهرياً</div>
                                </div>
                                <div class="rpt-chart-wrap">
                                    @foreach (var m in _pnlMonths ?? NoPnlMonth)
                                    {
                                        <div class="rpt-chart-col">
                                            <div class="rpt-chart-bars">
                                                <div class="rpt-bar rpt-bar-amber"
                                                     style="@BarH(m.Revenue, PnlPeak)"
                                                     title="@TipRev(m.Revenue)"></div>
                                                <div class="rpt-bar rpt-bar-green"
                                                     style="@BarH(m.OperationCost, PnlPeak)"
                                                     title="@TipCost(m.OperationCost)"></div>
                                            </div>
                                            <div class="rpt-chart-label">@ShortMonth(m.Month)</div>
                                        </div>
                                    }
                                </div>
                                <div class="rpt-chart-legend">
                                    <span><i class="rpt-legend-dot dot-amber"></i>إيراد</span>
                                    <span><i class="rpt-legend-dot dot-green"></i>تكلفة</span>
                                </div>
                            </div>

                        </div>

                        @* تفصيل التكلفة *@
                        @if (_pnlCost is not null && _pnlCost.Count > 0)
                        {
                            <div class="rpt-panel">
                                <div class="rpt-section-head">
                                    <div class="rpt-section-title">📊 تفصيل تكلفة التشغيل</div>
                                </div>
                                <div class="rpt-mix">
                                    @foreach (var (r, pct, col) in PnlCostMix)
                                    {
                                        <div class="rpt-mix-row">
                                            <div class="rpt-mix-label">@r.TypeName</div>
                                            <div class="rpt-mix-bar">
                                                <div class="rpt-mix-fill" style="@W(pct); @Bg(col)"></div>
                                            </div>
                                            <div class="rpt-mix-val">@Money(r.Amount)</div>
                                            <div class="rpt-mix-pct">@Pct(pct)</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @* الجدول الشهري *@
                        <div class="rpt-section-head">
                            <div class="rpt-section-title">📅 الأرقام شهر بشهر</div>
                        </div>
                        <div class="rpt-table-wrap">
                            <table class="rpt-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="th-start">الشهر</th>
                                        <th scope="col" class="th-num">الإيراد</th>
                                        <th scope="col" class="th-num">الضريبة</th>
                                        <th scope="col" class="th-num">تكلفة التشغيل</th>
                                        <th scope="col" class="th-num">مجمل الربح</th>
                                        <th scope="col" class="th-num">إداري</th>
                                        <th scope="col" class="th-num">صافي الربح</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in _pnlMonths ?? NoPnlMonth)
                                    {
                                        <tr>
                                            <td class="td-start"><strong>@m.MonthName</strong></td>
                                            <td class="td-num">@Money(m.Revenue)</td>
                                            <td class="td-num td-muted">@Money(m.Tax)</td>
                                            <td class="td-num val-neg">@Money(m.OperationCost)</td>
                                            <td class="td-num">@Money(m.Revenue - m.OperationCost)</td>
                                            <td class="td-num val-neg">@Money(m.OperatingExpenses)</td>
                                            <td class="td-num @SignCls(m.Revenue - m.OperationCost - m.OperatingExpenses)">
                                                <strong>@Money(m.Revenue - m.OperationCost - m.OperatingExpenses)</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @* مقارنة بالفترة السابقة *@
                        @if (_cmp is not null && _cmp.Count > 0)
                        {
                            <div class="rpt-section-head">
                                <div class="rpt-section-title">📈 مقارنة بالفترة السابقة</div>
                                <div class="rpt-section-sub">نفس عدد الأيام اللي قبل الفترة دي</div>
                            </div>
                            <div class="rpt-table-wrap">
                                <table class="rpt-table">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="th-start">البند</th>
                                            <th scope="col" class="th-num">الحالية</th>
                                            <th scope="col" class="th-num">السابقة</th>
                                            <th scope="col" class="th-num">الفرق</th>
                                            <th scope="col" class="th-num">التغير</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _cmp)
                                        {
                                            <tr>
                                                <td class="td-start"><strong>@r.Label</strong></td>
                                                <td class="td-num">@Money(r.Current)</td>
                                                <td class="td-num td-muted">@Money(r.Previous)</td>
                                                <td class="td-num @SignCls(r.Delta)">@PnlSigned(r.Delta)</td>
                                                <td class="td-num">
                                                    <span class="rpt-chip @ChgChip(r.ChangePct)">
                                                        @PnlSigned(r.ChangePct)%
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }


                    @* ════════════════════════════════
                       TAB 4 — المتأخرات
                    ════════════════════════════════ *@
                    @if (_tab == 4 && CanFin && _ovd is not null)
                    {
                        <div class="rpt-kpi-grid">
                            <div class="rpt-kpi-card kpi-red">
                                <div class="rpt-kpi-icon" aria-hidden="true">⚠️</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">إجمالي المتأخر</div>
                                    <div class="rpt-kpi-value val-neg">@Money(_ovdTotal)</div>
                                    <div class="rpt-kpi-sub">@_ovd.Count فاتورة</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-amber">
                                <div class="rpt-kpi-icon" aria-hidden="true">⏰</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">أقدم تأخير</div>
                                    <div class="rpt-kpi-value">@OldestDays يوم</div>
                                    <div class="rpt-kpi-sub">@(OldestCustomer ?? "—")</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-blue">
                                <div class="rpt-kpi-icon" aria-hidden="true">👥</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">عدد العملاء</div>
