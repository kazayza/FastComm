    /// <summary>أكبر رقم في الرسم — عشان الأعمدة تتنسب له.</summary>
    private decimal PnlPeak
    {
        get
        {
            if (_pnlMonths is null || _pnlMonths.Count == 0) return 1m;
            var max = _pnlMonths.Max(m => Math.Max(m.Revenue, m.OperationCost));
            return max <= 0 ? 1m : max;
        }
    }

