                <div class="fc-stats">
                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" /></div>
                            <div class="fc-stat-lb">الإيرادات (صافي)</div>
                        </div>
                        <div class="fc-stat-num">@Money(_pnl.Revenue)</div>
                        <div class="fc-stat-sub">من @_pnl.InvoiceCount فاتورة — قبل الضريبة</div>
                    </div>

                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.LocalShipping" /></div>
                            <div class="fc-stat-lb">تكلفة التشغيل</div>
                        </div>
                        <div class="fc-stat-num is-neg">@Money(_pnl.OperationCost)</div>
                        <div class="fc-stat-sub">وقود · طرق · ميناء · أوناش…</div>
                    </div>

                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.BarChart" /></div>
                            <div class="fc-stat-lb">مجمل الربح</div>
                        </div>
                        <div class="fc-stat-num @SignCls(_pnl.GrossProfit)">@Money(_pnl.GrossProfit)</div>
                        <div class="fc-stat-sub">هامش @Pct(_pnl.GrossMargin)</div>
                    </div>

                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.BarChart" /></div>
                            <div class="fc-stat-lb">صافي الربح</div>
                        </div>
                        <div class="fc-stat-num @SignCls(_pnl.NetProfit)">@Money(_pnl.NetProfit)</div>
                        <div class="fc-stat-sub">هامش @Pct(_pnl.NetMargin) — بعد الإداري</div>
                    </div>
                </div>

                <div class="fc-split2">
                    @* ── القائمة بالتفصيل ── *@
                    <div class="fc-panel2">
                        <div class="fc-rep-sec" style="margin-top:0">
                            <div>
                                <h3><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /> قائمة الدخل</h3>
                                <div class="fc-rep-sec-sub">من @RangeFrom إلى @RangeTo</div>
                            </div>
                        </div>

                        <div class="fc-table-wrap"><table class="fc-table-pro2">
                            <tbody>
                                <tr>
                                    <td>الإيرادات (قبل الضريبة)</td>
                                    <td style="text-align:left">@Money(_pnl.Revenue)</td>
                                </tr>
                                <tr>
                                    <td class="fc-cell-sub">ضريبة القيمة المضافة المحصّلة — فلوس الحكومة مش إيراد</td>
                                    <td style="text-align:left" class="fc-cell-sub">@Money(_pnl.Tax)</td>
                                </tr>
                                <tr>
                                    <td>(-) تكلفة التشغيل المباشرة</td>
                                    <td style="text-align:left" class="is-neg">@Money(_pnl.OperationCost)</td>
                                </tr>
                                <tr>
                                    <td><b>= مجمل الربح</b></td>
                                    <td style="text-align:left"><b>@Money(_pnl.GrossProfit)</b></td>
                                </tr>
                                <tr>
                                    <td>(-) المصروفات التشغيلية والإدارية</td>
                                    <td style="text-align:left" class="is-neg">@Money(_pnl.OperatingExpenses)</td>
                                </tr>
                                <tr>
                                    <td><b>= صافي الربح</b></td>
                                    <td style="text-align:left" class="@SignCls(_pnl.NetProfit)"><b>@Money(_pnl.NetProfit)</b></td>
                                </tr>
                            </tbody>
                        </table></div>

                        <div class="fc-field-hint" style="margin-top:10px">
                            الإيراد محسوب <b>صافي الخصم وقبل الضريبة</b> — عشان الضريبة بتتحصّل لصالح
                            مصلحة الضرائب مش إيراد للشركة.
                        </div>
                    </div>

                    @* ── صافي الربح شهريًا ── *@
                    <div class="fc-panel2">
                        <div class="fc-rep-sec" style="margin-top:0">
                            <div>
                                <h3><MudIcon Icon="@Icons.Material.Filled.BarChart" /> شهريًا</h3>
                                <div class="fc-rep-sec-sub">إيراد مقابل تكلفة</div>
                            </div>
                        </div>

                        <div class="fc-chart">
                            @foreach (var m in _pnlMonths ?? NoPnlMonth)
                            {
                                <div class="fc-chart-col">
                                    <div class="fc-chart-bars">
                                        <div class="fc-bar fc-bar-gold" style="@BarH(m.Revenue, PnlPeak)"
                                             title="@TipRev(m.Revenue)"></div>
                                        <div class="fc-bar fc-bar-green" style="@BarH(m.OperationCost, PnlPeak)"
                                             title="@TipCost(m.OperationCost)"></div>
                                    </div>
                                    <div class="fc-chart-lb">@ShortMonth(m.Month)</div>
                                </div>
                            }
                        </div>
                        <div class="fc-legend">
                            <span><i class="fc-dot fc-bar-gold"></i> إيراد</span>
                            <span><i class="fc-dot fc-bar-green"></i> تكلفة تشغيل</span>
                        </div>
                    </div>
                </div>

                @* ── تفصيل التكلفة المباشرة ── *@
                @if (_pnlCost is not null && _pnlCost.Count > 0)
                {
                    <div class="fc-panel2" style="margin-top:18px">
                        <div class="fc-rep-sec" style="margin-top:0">
                            <div>
                                <h3><MudIcon Icon="@Icons.Material.Filled.BarChart" /> تفصيل تكلفة التشغيل</h3>
                                <div class="fc-rep-sec-sub">حسب نوع المصروف — من الأكبر</div>
                            </div>
                        </div>
                        <div class="fc-mix">
                            @foreach (var (r, pct, col) in PnlCostMix)
                            {
                                <div class="fc-mix-row">
                                    <span class="fc-mix-lb">@r.TypeName</span>
                                    <span class="fc-mix-bar"><i style="@W(pct);@Bg(col)"></i></span>
                                    <span class="fc-mix-v">@Money(r.Amount)</span>
                                    <span class="fc-mix-pct">@Pct(pct)</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ── الجدول الشهري الكامل ── *@
                <div class="fc-panel2" style="margin-top:18px">
                    <div class="fc-rep-sec" style="margin-top:0">
                        <div>
                            <h3><MudIcon Icon="@Icons.Material.Filled.TableChart" /> الأرقام شهر بشهر</h3>
                        </div>
                    </div>
                    <div class="fc-table-wrap"><table class="fc-table-pro2">
                        <thead><tr>
                            <th>الشهر</th><th>الإيراد</th><th>الضريبة</th>
                            <th>تكلفة التشغيل</th><th>مجمل الربح</th>
                            <th>إداري</th><th>صافي الربح</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var m in _pnlMonths ?? NoPnlMonth)
                            {
                                <tr>
                                    <td>@m.MonthName</td>
                                    <td>@Money(m.Revenue)</td>
                                    <td class="fc-cell-sub">@Money(m.Tax)</td>
                                    <td class="is-neg">@Money(m.OperationCost)</td>
                                    <td>@Money(m.Revenue - m.OperationCost)</td>
                                    <td class="is-neg">@Money(m.OperatingExpenses)</td>
                                    <td class="@SignCls(m.Revenue - m.OperationCost - m.OperatingExpenses)">
                                        @Money(m.Revenue - m.OperationCost - m.OperatingExpenses)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>

                @* ── 📈 مقارنة بالفترة السابقة ── *@
                @if (_cmp is not null && _cmp.Count > 0)
                {
                    <div class="fc-panel2" style="margin-top:18px">
                        <div class="fc-rep-sec" style="margin-top:0">
                            <div>
                                <h3><MudIcon Icon="@Icons.Material.Filled.TrendingUp" /> مقارنة بالفترة السابقة</h3>
                                <div class="fc-rep-sec-sub">نفس عدد الأيام اللي قبل الفترة دي على طول</div>
                            </div>
                        </div>
                        <div class="fc-table-wrap"><table class="fc-table-pro2">
                            <thead><tr>
                                <th>البند</th><th>الفترة الحالية</th><th>الفترة السابقة</th>
                                <th>الفرق</th><th>التغير</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var r in _cmp)
                                {
                                    <tr>
                                        <td>@r.Label</td>
                                        <td>@Money(r.Current)</td>
                                        <td class="fc-cell-sub">@Money(r.Previous)</td>
                                        <td class="@SignCls(r.Delta)">@PnlSigned(r.Delta)</td>
                                        <td>
                                            <span class="fc-chip @ChgChip(r.ChangePct)">@PnlSigned(r.ChangePct)%</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    </div>
                }
            }

            @* ══════════════════ 🆕 المتأخرات ══════════════════ *@
            @if (_tab == 4 && CanFin && _ovd is not null)
            {
                <div class="fc-stats">
                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                            <div class="fc-stat-lb">إجمالي المتأخر</div>
                        </div>
                        <div class="fc-stat-num is-neg">@Money(_ovdTotal)</div>
                        <div class="fc-stat-sub">من @_ovd.Count فاتورة</div>
                    </div>
                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                            <div class="fc-stat-lb">أقدم تأخير</div>
                        </div>
                        <div class="fc-stat-num">@OldestDays يوم</div>
                        <div class="fc-stat-sub">@(OldestCustomer ?? "—")</div>
                    </div>
                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.People" /></div>
                            <div class="fc-stat-lb">عدد العملاء</div>
                        </div>
                        <div class="fc-stat-num">@OverdueCustomers</div>
                        <div class="fc-stat-sub">عميل عليه متأخرات</div>
                    </div>
                </div>

                <div class="fc-panel2">
                    <div class="fc-rep-sec" style="margin-top:0">
                        <div>
                            <h3><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /> فواتير عدى ميعاد سدادها</h3>
                            <div class="fc-rep-sec-sub">مرتبة من الأقدم — مش مرتبطة بالفترة المختارة</div>
                        </div>
                    </div>

                    @if (_ovd.Count == 0)
                    {
                        <div class="fc-empty">مافيش فواتير متأخرة 🎉</div>
                    }
                    else
                    {
                        <div class="fc-table-wrap"><table class="fc-table-pro2">
                            <thead><tr>
                                <th>رقم الفاتورة</th><th>العميل</th><th>الإصدار</th>
                                <th>الاستحقاق</th><th>تأخير</th><th>الإجمالي</th>
                                <th>المحصّل</th><th>المتبقي</th><th>الحالة</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var r in _ovd)
                                {
                                    <tr>
                                        <td><span class="fc-chip fc-chip-blue">@r.InvoiceNumber</span></td>
                                        <td class="fc-cell-main">@r.CustomerName</td>
                                        <td class="fc-cell-sub">@r.InvoiceDate</td>
                                        <td class="fc-cell-sub">@r.DueDate</td>
                                        <td><span class="fc-chip @DaysChip(r.DaysOverdue)">@r.DaysOverdue يوم</span></td>
                                        <td>@Money(r.GrandTotal)</td>
                                        <td>@Money(r.PaidAmount)</td>
                                        <td class="is-neg"><b>@Money(r.Balance)</b></td>
                                        <td>@PayStatusAr(r.PaymentStatus)</td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            }

            @* ══════════════════ 🆕 الموانئ والوجهات ══════════════════ *@
            @if (_tab == 5 && CanOps && _ports is not null)
            {
                <div class="fc-split2">
                    <div class="fc-panel2">
                        <div class="fc-rep-sec" style="margin-top:0">
                            <div>
                                <h3><MudIcon Icon="@Icons.Material.Filled.AirportShuttle" /> الموانئ</h3>
                                <div class="fc-rep-sec-sub">مرتبة من الأعلى ربحًا</div>
                            </div>
                        </div>
                        @if (_ports.Count == 0)
                        {
                            <div class="fc-empty">مافيش عمليات بميناء محدّد في الفترة دي</div>
                        }
                        else
                        {
                            <div class="fc-table-wrap"><table class="fc-table-pro2">
                                <thead><tr>
                                    <th>الميناء</th><th>عمليات</th><th>الإيراد</th>
                                    <th>التكلفة</th><th>الربح</th><th>الهامش</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var r in _ports)
                                    {
                                        <tr>
                                            <td class="fc-cell-main">@r.Name</td>
                                            <td>@r.Operations</td>
                                            <td>@Money(r.Revenue)</td>
                                            <td class="is-neg">@Money(r.Cost)</td>
                                            <td class="@SignCls(r.Profit)"><b>@Money(r.Profit)</b></td>
                                            <td><span class="fc-chip @ChgChip(r.MarginPct)">@Pct(r.MarginPct)</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
