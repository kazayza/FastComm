                            <table class="rpt-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="th-start">العميل</th>
                                        <th scope="col" class="th-num">المفوتر</th>
                                        <th scope="col" class="th-num">المحصّل</th>
                                        <th scope="col" class="th-num">الرصيد</th>
                                    </tr>
                                </thead>
