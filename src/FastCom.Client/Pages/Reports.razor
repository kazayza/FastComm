        _ovd is null || _ovd.Count == 0 ? null
        : _ovd.OrderByDescending(x => x.DaysOverdue).First().CustomerName;

    private int OverdueCustomers => _ovd?.Select(x => x.CustomerName).Distinct().Count() ?? 0;

    /// <summary>أنواع التكلفة المباشرة مرتبة + نسبتها + لونها.</summary>
    private IEnumerable<(PnlCostRow R, decimal Pct, string Col)> PnlCostMix
    {
        get
        {
            if (_pnlCost is null || _pnlCost.Count == 0) yield break;
            var total = _pnlCost.Sum(x => x.Amount);
            if (total <= 0) yield break;

            var i = 0;
            foreach (var r in _pnlCost.OrderByDescending(x => x.Amount).Take(8))
            {
                yield return (r, r.Amount / total * 100m, MixColors[i % MixColors.Length]);
                i++;
            }
        }
    }

