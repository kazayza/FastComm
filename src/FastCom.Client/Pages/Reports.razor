    private IEnumerable<(PnlCostRow R, decimal Pct, string Col)> PnlCostMix
    {
        get
        {
            if (_pnlCost is null || _pnlCost.Count == 0) yield break;
            var total = _pnlCost.Sum(x => x.Amount);
            if (total <= 0) yield break;
            var i = 0;
            foreach (var r in _pnlCost.OrderByDescending(x => x.Amount).Take(8))
            { yield return (r, r.Amount / total * 100m, MixColors[i % MixColors.Length]); i++; }
        }
    }

