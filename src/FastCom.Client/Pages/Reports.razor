@page "/reports"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject TokenStore Tokens
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>التقارير — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">التقارير</div>
                <h1 class="fc-hero-title">التقارير</h1>
                <p class="fc-hero-sub">ربحية العمليات · التدفق النقدي · أداء الأسطول — وصدّر أي تقرير Excel</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanExport)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(_busy || !CanExportNow)" OnClick="Export">
                        @(_busy ? "بيصدّر…" : "تصدير Excel")
                    </MudButton>
                }
            </div>
        </div>

        @if (Any && _range is not null)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.DateRange" /></div>
                    <div>
                        <div class="fc-kpi-num" style="font-size:.95rem">@_range.From</div>
                        <div class="fc-kpi-lb">من</div>
                    </div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.Event" /></div>
                    <div>
                        <div class="fc-kpi-num" style="font-size:.95rem">@_range.To</div>
                        <div class="fc-kpi-lb">إلى</div>
                    </div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Assessment" /></div>
                    <div>
                        <div class="fc-kpi-num">@RowsCount</div>
                        <div class="fc-kpi-lb">سجل في التقرير</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="rpt-body">

    @* ── Filter Bar ── *@
    <div class="rpt-filter-card">

        <div class="rpt-filter-head">
            <div class="rpt-filter-title">
                <svg viewBox="0 0 24 24" width="16" height="16"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                    <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                </svg>
                نطاق التقرير
            </div>
            <div class="rpt-filter-sub">الأرقام بتتحدّث من قاعدة البيانات مباشرة</div>
        </div>

        <div class="rpt-filter-controls">

            @* Quick Buttons *@
            <div class="rpt-quick-group" role="group" aria-label="اختر فترة سريعة">
                @foreach (var q in Quicks)
                {
                    <button type="button"
                            class="rpt-quick-btn @(_quick == q.Kind ? "quick-active" : "")"
                            @onclick="@(() => Quick(q.Kind))"
                            aria-pressed="@(_quick == q.Kind)">
                        @q.Label
                    </button>
                }
            </div>

            @* Date Range *@
            <div class="rpt-date-range">
                <div class="rpt-date-field">
                    <label class="rpt-date-label">من</label>
                    <div class="rpt-date-input-wrap">
                        <svg class="rpt-date-icon" viewBox="0 0 16 16" width="12" height="12"
                             fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                            <rect x="2" y="3" width="12" height="11" rx="2"/>
                            <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                        </svg>
                        <input type="date" class="rpt-date-input"
                               value="@_from"
                               @onchange="e => _from = e.Value?.ToString() ?? _from" />
                    </div>
                </div>
                <div class="rpt-date-sep" aria-hidden="true">—</div>
                <div class="rpt-date-field">
                    <label class="rpt-date-label">إلى</label>
                    <div class="rpt-date-input-wrap">
                        <svg class="rpt-date-icon" viewBox="0 0 16 16" width="12" height="12"
                             fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                            <rect x="2" y="3" width="12" height="11" rx="2"/>
                            <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                        </svg>
                        <input type="date" class="rpt-date-input"
                               value="@_to"
                               @onchange="e => _to = e.Value?.ToString() ?? _to" />
                    </div>
                </div>
            </div>

            @* Apply Button *@
            <button class="rpt-apply-btn" @onclick="LoadAsync">
                <svg viewBox="0 0 24 24" width="16" height="16"
                     fill="none" stroke="currentColor" stroke-width="2"
                     aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/>
                    <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                </svg>
                تطبيق
            </button>

        </div>

    </div>


    @if (_err is not null)
    {
        <div class="rpt-error-box" role="alert">
            <div class="rpt-err-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20"
                     fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 8v4M12 16h.01" stroke-linecap="round"/>
                </svg>
            </div>
            <div>
                <strong>تعذّر تحميل التقارير</strong>
                <p>@_err</p>
            </div>
        </div>
    }

    @if (!Any)
    {
        <div class="rpt-no-access">
            <div class="rpt-no-access-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="44" height="44"
                     fill="none" stroke="currentColor" stroke-width="1.4">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="rpt-no-access-title">مافيش صلاحية تقارير</div>
            <div class="rpt-no-access-sub">كلّم مدير النظام للحصول على الصلاحيات المطلوبة</div>
        </div>
    }
    else
    {
        <div class="rpt-main-card">

            @* ── Report Tabs ── *@
            <div class="rpt-tabs-bar" role="tablist" aria-label="أقسام التقارير">

                @if (CanOps)
                {
                    <button type="button"
                            class="rpt-tab @(_tab == 0 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 0)"
                            role="tab" aria-selected="@(_tab == 0)">
                        <span class="rpt-tab-icon" aria-hidden="true">🚛</span>
                        <span>العمليات</span>
                        @if ((_ot?.Count ?? 0) > 0)
                        {
                            <span class="rpt-tab-badge">@(_ot?.Count ?? 0)</span>
                        }
                    </button>
                }

                @if (CanFin)
                {
                    <button type="button"
                            class="rpt-tab @(_tab == 1 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 1)"
                            role="tab" aria-selected="@(_tab == 1)">
                        <span class="rpt-tab-icon" aria-hidden="true">💰</span>
                        <span>المالي</span>
                        @if ((_months?.Count ?? 0) > 0)
                        {
                            <span class="rpt-tab-badge">@(_months?.Count ?? 0)</span>
                        }
                    </button>
                }

                @if (CanFleet)
                {
                    <button type="button"
                            class="rpt-tab @(_tab == 2 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 2)"
                            role="tab" aria-selected="@(_tab == 2)">
                        <span class="rpt-tab-icon" aria-hidden="true">🚗</span>
                        <span>الأسطول</span>
                        @if (((_drv?.Count ?? 0) + (_veh?.Count ?? 0)) > 0)
                        {
                            <span class="rpt-tab-badge">@((_drv?.Count ?? 0) + (_veh?.Count ?? 0))</span>
                        }
                    </button>
                }

                @if (CanFin)
                {
                    <button type="button"
                            class="rpt-tab @(_tab == 3 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 3)"
                            role="tab" aria-selected="@(_tab == 3)">
                        <span class="rpt-tab-icon" aria-hidden="true">📊</span>
                        <span>قائمة الدخل</span>
                        @if ((_pnlMonths?.Count ?? 0) > 0)
                        {
                            <span class="rpt-tab-badge">@(_pnlMonths?.Count ?? 0)</span>
                        }
                    </button>

                    <button type="button"
                            class="rpt-tab @(_tab == 4 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 4)"
                            role="tab" aria-selected="@(_tab == 4)">
                        <span class="rpt-tab-icon" aria-hidden="true">⚠️</span>
                        <span>المتأخرات</span>
                        @if ((_ovd?.Count ?? 0) > 0)
                        {
                            <span class="rpt-tab-badge badge-red">@(_ovd?.Count ?? 0)</span>
                        }
                    </button>
                }

                @if (CanOps)
                {
                    <button type="button"
                            class="rpt-tab @(_tab == 5 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 5)"
                            role="tab" aria-selected="@(_tab == 5)">
                        <span class="rpt-tab-icon" aria-hidden="true">⚓</span>
                        <span>الموانئ</span>
                        @if (((_ports?.Count ?? 0) + (_dests?.Count ?? 0)) > 0)
                        {
                            <span class="rpt-tab-badge">@((_ports?.Count ?? 0) + (_dests?.Count ?? 0))</span>
                        }
                    </button>

                    <button type="button"
                            class="rpt-tab @(_tab == 6 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 6)"
                            role="tab" aria-selected="@(_tab == 6)">
                        <span class="rpt-tab-icon" aria-hidden="true">🔧</span>
                        <span>الخدمات</span>
                        @if ((_svcs?.Count ?? 0) > 0)
                        {
                            <span class="rpt-tab-badge">@(_svcs?.Count ?? 0)</span>
                        }
                    </button>
                }

                @if (CanFin)
                {
                    <button type="button"
                            class="rpt-tab @(_tab == 7 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 7)"
                            role="tab" aria-selected="@(_tab == 7)">
                        <span class="rpt-tab-icon" aria-hidden="true">📅</span>
                        <span>التدفق المتوقع</span>
                        @if ((_cf?.Count ?? 0) > 0)
                        {
                            <span class="rpt-tab-badge">@(_cf?.Count ?? 0)</span>
                        }
                    </button>

                    <button type="button"
                            class="rpt-tab @(_tab == 9 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 9)"
                            role="tab" aria-selected="@(_tab == 9)">
                        <span class="rpt-tab-icon" aria-hidden="true">🏦</span>
                        <span>التدفق الفعلي</span>
                        @if (_caCount > 0)
                        {
                            <span class="rpt-tab-badge">@_caCount</span>
                        }
                    </button>
                }

                @if (CanSup)
                {
                    <button type="button"
                            class="rpt-tab @(_tab == 8 ? "tab-active" : "")"
                            @onclick="@(() => _tab = 8)"
                            role="tab" aria-selected="@(_tab == 8)">
                        <span class="rpt-tab-icon" aria-hidden="true">📋</span>
                        <span>أعمار الموردين</span>
                        @if ((_sag?.Count ?? 0) > 0)
                        {
                            <span class="rpt-tab-badge">@(_sag?.Count ?? 0)</span>
                        }
                    </button>
                }

            </div>


            @* ── Loading ── *@
            @if (_loading)
            {
                <div class="rpt-loading">
                    <div class="rpt-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل التقرير...</span>
                </div>
            }
            else
            {
                <div class="rpt-tab-content">

                    @* ════════════════════════════════
                       TAB 0 — العمليات
                    ════════════════════════════════ *@
                    @if (_tab == 0 && CanOps && _ot is not null)
                    {
                        @* KPI Cards *@
                        <div class="rpt-kpi-grid">
                            <div class="rpt-kpi-card kpi-green">
                                <div class="rpt-kpi-icon" aria-hidden="true">📈</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">صافي الربح</div>
                                    <div class="rpt-kpi-value @(_ot.Profit >= 0 ? "" : "val-neg")">
                                        @Money(_ot.Profit)
                                    </div>
                                    <div class="rpt-kpi-sub">هامش @Pct(_ot.MarginPct)</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-blue">
                                <div class="rpt-kpi-icon" aria-hidden="true">💵</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">الإيراد</div>
                                    <div class="rpt-kpi-value">@Money(_ot.Revenue)</div>
                                    <div class="rpt-kpi-sub">على @_ot.Count عملية</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-red">
                                <div class="rpt-kpi-icon" aria-hidden="true">🧾</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">التكلفة</div>
                                    <div class="rpt-kpi-value">@Money(_ot.Cost)</div>
                                    <div class="rpt-kpi-sub">@CostShare من الإيراد</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-purple">
                                <div class="rpt-kpi-icon" aria-hidden="true">📄</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">المفوتر</div>
                                    <div class="rpt-kpi-value">@Money(_ot.Invoiced)</div>
                                    <div class="rpt-kpi-sub">محصّل @Money(_ot.Collected)</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-amber">
                                <div class="rpt-kpi-icon" aria-hidden="true">⏳</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">لسه مفتوحة</div>
                                    <div class="rpt-kpi-value">@_ot.Open</div>
                                    <div class="rpt-kpi-sub">@_ot.NotInvoiced مش مفوترة</div>
                                </div>
                            </div>
                        </div>

                        @* Section Header *@
                        <div class="rpt-section-head">
                            <div class="rpt-section-title">
                                <svg viewBox="0 0 24 24" width="16" height="16"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M3 3h18M3 9h18M3 15h18M3 21h18"/>
                                </svg>
                                تفصيل العمليات
                            </div>
                            <div class="rpt-section-sub">مرتبة من الأعلى ربحاً</div>
                        </div>

                        <div class="rpt-table-wrap">
                            <table class="rpt-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="th-start">العملية</th>
                                        <th scope="col">الحالة</th>
                                        <th scope="col">التسليم</th>
                                        <th scope="col" class="th-num">الإيراد</th>
                                        <th scope="col" class="th-num">التكلفة</th>
                                        <th scope="col" class="th-num">الربح</th>
                                        <th scope="col" class="th-num">الهامش</th>
                                        <th scope="col" class="th-num">المفوتر</th>
                                        <th scope="col" class="th-num">المحصّل</th>
                                        <th scope="col" class="th-num">المتبقي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in _ops ?? NoOp)
                                    {
                                        <tr>
                                            <td class="td-start">
                                                <div class="rpt-op-cell">
                                                    <div class="rpt-op-num">@r.OperationNumber</div>
                                                    <div class="rpt-op-cust">@r.CustomerName</div>
                                                    @if (!string.IsNullOrEmpty(r.InvoiceNumber))
                                                    {
                                                        <span class="rpt-inv-tag">@r.InvoiceNumber</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="rpt-chip @StatusChip(r.Status)">
                                                    @StatusAr(r.Status)
                                                </span>
                                            </td>
                                            <td class="td-muted">@(r.DeliveredAt ?? r.PlannedDate ?? "—")</td>
                                            <td class="td-num">@Money(r.Revenue)</td>
                                            <td class="td-num td-muted">@Money(r.TotalCost)</td>
                                            <td class="td-num @NumClass(r.Profit)">
                                                <strong>@Money(r.Profit)</strong>
                                            </td>
                                            <td class="td-num">
                                                <div class="rpt-margin-cell">
                                                    <span class="@MarginClass(r.MarginPct)">@Pct(r.MarginPct)</span>
                                                    <div class="rpt-mini-bar">
                                                        <div class="rpt-mini-fill @MarginClass(r.MarginPct)"
                                                             style="@W(Clamp(r.MarginPct))"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="td-num">@Money(r.Invoiced)</td>
                                            <td class="td-num">@Money(r.Collected)</td>
                                            <td class="td-num @NumClass(-r.Due)">@Money(r.Due)</td>
                                        </tr>
                                    }
                                    @if (_ops is null || _ops.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="10" class="td-empty">مافيش عمليات في الفترة دي</td>
                                        </tr>
                                    }
                                </tbody>
                                @if (_ops is not null && _ops.Count > 0)
                                {
                                    <tfoot>
                                        <tr>
                                            <td class="td-start" colspan="3">
                                                الإجمالي — <strong>@_ot.Count</strong> عملية
                                            </td>
                                            <td class="td-num"><strong>@Money(_ot.Revenue)</strong></td>
                                            <td class="td-num"><strong>@Money(_ot.Cost)</strong></td>
                                            <td class="td-num @NumClass(_ot.Profit)"><strong>@Money(_ot.Profit)</strong></td>
                                            <td class="td-num"><strong>@Pct(_ot.MarginPct)</strong></td>
                                            <td class="td-num"><strong>@Money(_ot.Invoiced)</strong></td>
                                            <td class="td-num"><strong>@Money(_ot.Collected)</strong></td>
                                            <td class="td-num"><strong>@Money(_ot.Revenue - _ot.Collected)</strong></td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    }


                    @* ════════════════════════════════
                       TAB 1 — المالي
                    ════════════════════════════════ *@
                    @if (_tab == 1 && CanFin && _fs is not null)
                    {
                        <div class="rpt-kpi-grid">
                            <div class="rpt-kpi-card kpi-blue">
                                <div class="rpt-kpi-icon" aria-hidden="true">📄</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">المفوتر</div>
                                    <div class="rpt-kpi-value">@Money(_fs.Invoiced)</div>
                                    <div class="rpt-kpi-sub">@_fs.InvoiceCount فاتورة</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-green">
                                <div class="rpt-kpi-icon" aria-hidden="true">💰</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">المحصّل</div>
                                    <div class="rpt-kpi-value">@Money(_fs.Collected)</div>
                                    <div class="rpt-kpi-sub">@_fs.PaymentCount دفعة</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-red">
                                <div class="rpt-kpi-icon" aria-hidden="true">🧾</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">المصروفات</div>
                                    <div class="rpt-kpi-value">@Money(_fs.Expenses)</div>
                                    <div class="rpt-kpi-sub">تحصيل @CollectionRate</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-green">
                                <div class="rpt-kpi-icon" aria-hidden="true">📈</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">صافي النقد</div>
                                    <div class="rpt-kpi-value @NumClass(_fs.NetCash)">@Money(_fs.NetCash)</div>
                                    <div class="rpt-kpi-sub">محصّل − مصروفات</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-amber">
                                <div class="rpt-kpi-icon" aria-hidden="true">⏰</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">مديونية العملاء</div>
                                    <div class="rpt-kpi-value val-neg">@Money(_fs.Receivable)</div>
                                    <div class="rpt-kpi-sub">كل الفواتير المفتوحة</div>
                                </div>
                            </div>
                        </div>

                        <div class="rpt-split-grid">

                            @* Chart — التدفق الشهري *@
                            <div class="rpt-panel">
                                <div class="rpt-section-head">
                                    <div class="rpt-section-title">📊 التدفق الشهري</div>
                                    <div class="rpt-section-sub">مفوتر مقابل محصّل</div>
                                </div>
                                <div class="rpt-chart-wrap">
                                    @foreach (var m in _months ?? NoMonth)
                                    {
                                        <div class="rpt-chart-col">
                                            <div class="rpt-chart-bars">
                                                <div class="rpt-bar rpt-bar-amber"
                                                     style="@BarH(m.Invoiced, MonthPeak)"
                                                     title="@TipInv(m.Invoiced)"></div>
                                                <div class="rpt-bar rpt-bar-green"
                                                     style="@BarH(m.Collected, MonthPeak)"
                                                     title="@TipCol(m.Collected)"></div>
                                            </div>
                                            <div class="rpt-chart-label">@ShortMonth(m.Month)</div>
                                        </div>
                                    }
                                </div>
                                <div class="rpt-chart-legend">
                                    <span><i class="rpt-legend-dot dot-amber"></i>مفوتر</span>
                                    <span><i class="rpt-legend-dot dot-green"></i>محصّل</span>
                                </div>
                            </div>

                            @* Mix — المصروفات *@
                            <div class="rpt-panel">
                                <div class="rpt-section-head">
                                    <div class="rpt-section-title">📊 المصروفات حسب النوع</div>
                                </div>
