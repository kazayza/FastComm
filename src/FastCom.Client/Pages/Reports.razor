                        <div class="fc-stat-sub">في الخزينة قبل @_caFrom</div>
                    </div>
                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.ArrowDownward" /></div>
                            <div class="fc-stat-lb">الوارد</div>
                        </div>
                        <div class="fc-stat-num is-pos">@Money(_cas.TotalIn)</div>
                        <div class="fc-stat-sub">@(_cas.InLines?.Sum(x => x.Count) ?? 0) حركة</div>
                    </div>
                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.ArrowUpward" /></div>
                            <div class="fc-stat-lb">الصادر</div>
                        </div>
                        <div class="fc-stat-num is-neg">@Money(_cas.TotalOut)</div>
                        <div class="fc-stat-sub">@(_cas.OutLines?.Sum(x => x.Count) ?? 0) حركة</div>
                    </div>
                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.North" /></div>
                            <div class="fc-stat-lb">رصيد آخر الفترة</div>
                        </div>
                        <div class="fc-stat-num @NetCls(_cas.Net)">@Money(_cas.Closing)</div>
                        <div class="fc-stat-sub">صافي الحركة: @Money(_cas.Net)</div>
                    </div>
                </div>

                @if (_caCount == 0)
                {
                    <div class="fc-empty"><div>مافيش حركات خزينة في الفترة دي</div></div>
