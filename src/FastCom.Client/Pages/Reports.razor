                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }


                    @* ════════════════════════════════
                       TAB 5 — الموانئ والوجهات
                    ════════════════════════════════ *@
                    @if (_tab == 5 && CanOps && _ports is not null)
                    {
                        <div class="rpt-split-grid">

                            <div class="rpt-panel">
                                <div class="rpt-section-head">
