    private class CashLine  { public string Label { get; set; } = ""; public int Count { get; set; } public decimal Amount { get; set; } public decimal Pct { get; set; } }
    private class CashMonth { public string Key { get; set; } = ""; public string MonthName { get; set; } = ""; public decimal Inflow { get; set; } public decimal Outflow { get; set; } public decimal Net { get; set; } }
    private class CashBoxRow { public string BoxName { get; set; } = ""; public decimal Inflow { get; set; } public decimal Outflow { get; set; } public decimal TransferIn { get; set; } public decimal TransferOut { get; set; } public decimal Net { get; set; } public decimal Closing { get; set; } }
    private class CashActualRes { public decimal Opening { get; set; } public decimal Closing { get; set; } public decimal TotalIn { get; set; } public decimal TotalOut { get; set; } public decimal Net { get; set; } public int Count { get; set; } public List<CashLine> InLines { get; set; } = new(); public List<CashLine> OutLines { get; set; } = new(); public List<CashLine> InSrc { get; set; } = new(); public List<CashLine> OutSrc { get; set; } = new(); public List<CashMonth> Months { get; set; } = new(); public List<CashBoxRow> Boxes { get; set; } = new(); }
    private decimal _cfTotal;

    private static readonly List<OpRow>       NoOp      = new();
    private static readonly List<MonthRow>    NoMonth   = new();
    private static readonly List<CustomerRow> NoCust    = new();
    private static readonly List<DriverRow>   NoDrv     = new();
