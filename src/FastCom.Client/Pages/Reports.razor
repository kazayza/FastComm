@page "/reports"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject TokenStore Tokens
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>التقارير — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">التقارير</div>
                <h1 class="fc-hero-title">التقارير</h1>
                <p class="fc-hero-sub">ربحية العمليات · التدفق النقدي · أداء الأسطول — وصدّر أي تقرير Excel</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanExport)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               Disabled="@_busy" OnClick="Export">
                        @(_busy ? "بيصدّر…" : "تصدير Excel")
                    </MudButton>
                }
            </div>
        </div>

        @if (Any && _range is not null)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.DateRange" /></div>
                    <div><div class="fc-kpi-num" style="font-size:1rem">@_range.From</div>
                        <div class="fc-kpi-lb">من</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.Event" /></div>
                    <div><div class="fc-kpi-num" style="font-size:1rem">@_range.To</div>
                        <div class="fc-kpi-lb">إلى</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Assessment" /></div>
                    <div><div class="fc-kpi-num">@RowsCount</div>
                        <div class="fc-kpi-lb">سجل في التقرير</div></div>
                </div>
            </div>
        }
    </div>
</div>

<div class="fc-overlap">
    <div class="fc-card">

        @* ══════════ رأس التقرير + الفلاتر ══════════ *@
        <div class="fc-rep-head">
            <div>
                <div class="fc-panel-title">نطاق التقرير</div>
                <div class="fc-cell-sub">الأرقام بتتحدّث من قاعدة البيانات مباشرة</div>
            </div>
            <div class="fc-rep-head-actions">
                @foreach (var q in Quicks)
                {
                    <button type="button" class="@QuickClass(q.Kind)" @onclick="@(() => Quick(q.Kind))">
                        @q.Label
                    </button>
                }
                <label class="fc-meta-lb">من</label>
                <input type="date" class="fc-sel" value="@_from"
                       @onchange="e => _from = e.Value?.ToString() ?? _from" />
                <label class="fc-meta-lb">إلى</label>
                <input type="date" class="fc-sel" value="@_to"
                       @onchange="e => _to = e.Value?.ToString() ?? _to" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync">تطبيق</MudButton>
            </div>
        </div>

        @if (_err is not null)
        {
            <div class="fc-alert fc-alert-bad">
                <div class="fc-alert-ic"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline" /></div>
                <div class="fc-alert-body">
                    <div class="fc-alert-title">تعذّر تحميل التقارير</div>
                    <div>@_err</div>
                </div>
            </div>
        }

        @if (!Any)
        {
            <div class="fc-empty">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" />
                <div>مافيش صلاحية تقارير — كلّم مدير النظام</div>
            </div>
        }
        else
        {
            <div class="fc-rtabs">
                @if (CanOps)
                {
                    <button type="button" class="@TabClass(0)" @onclick="@(() => _tab = 0)">
                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" />
                        العمليات
                        <span class="fc-rtab-n">@(_ot?.Count ?? 0)</span>
                    </button>
                }
                @if (CanFin)
                {
                    <button type="button" class="@TabClass(1)" @onclick="@(() => _tab = 1)">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" />
                        المالي
                        <span class="fc-rtab-n">@(_months?.Count ?? 0)</span>
                    </button>
                }
                @if (CanFleet)
                {
                    <button type="button" class="@TabClass(2)" @onclick="@(() => _tab = 2)">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Small" />
                        الأسطول
                        <span class="fc-rtab-n">@((_drv?.Count ?? 0) + (_veh?.Count ?? 0))</span>
                    </button>
                }
            </div>

            @if (_loading)
            {
                <div class="fc-loading"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> جارٍ التحميل…</div>
            }

            @* ══════════════════ العمليات ══════════════════ *@
            @if (_tab == 0 && CanOps && _ot is not null)
            {
                <div class="fc-stats">
                    <div class="fc-stat" style="--fc-accent:#14804A">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" /></div>
                            <div class="fc-stat-lb">صافي الربح</div>
                        </div>
                        <div class="fc-stat-num @NumClass(_ot.Profit)">@Money(_ot.Profit)</div>
                        <div class="fc-stat-sub">هامش <b>@Pct(_ot.MarginPct)</b></div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#16233A">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                            <div class="fc-stat-lb">الإيراد</div>
                        </div>
                        <div class="fc-stat-num">@Money(_ot.Revenue)</div>
                        <div class="fc-stat-sub">على <b>@_ot.Count</b> عملية</div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#B3261E">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Receipt" /></div>
                            <div class="fc-stat-lb">التكلفة</div>
                        </div>
                        <div class="fc-stat-num">@Money(_ot.Cost)</div>
                        <div class="fc-stat-sub"><b>@CostShare</b> من الإيراد</div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#2A6FB0">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Description" /></div>
                            <div class="fc-stat-lb">المفوتر</div>
                        </div>
                        <div class="fc-stat-num">@Money(_ot.Invoiced)</div>
                        <div class="fc-stat-sub">محصّل <b>@Money(_ot.Collected)</b></div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#C8860D">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" /></div>
                            <div class="fc-stat-lb">لسه مفتوحة</div>
                        </div>
                        <div class="fc-stat-num">@_ot.Open</div>
                        <div class="fc-stat-sub">و<b>@_ot.NotInvoiced</b> بإيراد ومفوترتش</div>
                    </div>
                </div>

                <div class="fc-rep-sec">
                    <div>
                        <h3><MudIcon Icon="@Icons.Material.Filled.TableChart" /> تفصيل العمليات</h3>
                        <div class="fc-rep-sec-sub">مرتبة من الأعلى ربحًا — اضغط على رأس العمود في Excel للترتيب</div>
                    </div>
                </div>

                <div class="fc-table-wrap">
                    <table class="fc-table-pro2">
                        <thead>
                            <tr>
                                <th>العملية</th><th>العميل</th><th>الحالة</th><th>التسليم</th>
                                <th class="num">الإيراد</th><th class="num">التكلفة</th>
                                <th class="num">الربح</th><th class="num">الهامش</th>
                                <th class="num">المفوتر</th><th class="num">المحصّل</th>
                                <th class="num">المتبقي</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _ops ?? NoOp)
                            {
                                <tr>
                                    <td>
                                        <div class="id">@r.OperationNumber</div>
                                        @if (!string.IsNullOrEmpty(r.InvoiceNumber))
                                        {
                                            <div class="fc-cell-sub">@r.InvoiceNumber</div>
                                        }
                                    </td>
                                    <td>@r.CustomerName</td>
                                    <td><span class="fc-chip @StatusChip(r.Status)">@StatusAr(r.Status)</span></td>
                                    <td class="fc-cell-sub">@(r.DeliveredAt ?? r.PlannedDate ?? "—")</td>
                                    <td class="num">@Money(r.Revenue)</td>
                                    <td class="num mut">@Money(r.TotalCost)</td>
                                    <td class="num @NumClass(r.Profit)">@Money(r.Profit)</td>
                                    <td class="num">
                                        @Pct(r.MarginPct)
                                        <span class="fc-minibar">
                                            <i class="@MarginClass(r.MarginPct)" style="@W(Clamp(r.MarginPct))"></i>
                                        </span>
                                    </td>
                                    <td class="num">@Money(r.Invoiced)</td>
                                    <td class="num">@Money(r.Collected)</td>
                                    <td class="num @NumClass(-r.Due)">@Money(r.Due)</td>
                                </tr>
                            }
                            @if (_ops is null || _ops.Count == 0)
                            {
                                <tr><td colspan="11" class="fc-empty">مافيش عمليات في الفترة دي</td></tr>
                            }
                        </tbody>
                        @if (_ops is not null && _ops.Count > 0)
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="4">الإجمالي — @_ot.Count عملية</td>
                                    <td class="num">@Money(_ot.Revenue)</td>
                                    <td class="num">@Money(_ot.Cost)</td>
                                    <td class="num">@Money(_ot.Profit)</td>
                                    <td class="num">@Pct(_ot.MarginPct)</td>
                                    <td class="num">@Money(_ot.Invoiced)</td>
                                    <td class="num">@Money(_ot.Collected)</td>
                                    <td class="num">@Money(_ot.Revenue - _ot.Collected)</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            }

            @* ══════════════════ المالي ══════════════════ *@
            @if (_tab == 1 && CanFin && _fs is not null)
            {
                <div class="fc-stats">
                    <div class="fc-stat" style="--fc-accent:#16233A">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Description" /></div>
                            <div class="fc-stat-lb">المفوتر</div>
                        </div>
                        <div class="fc-stat-num">@Money(_fs.Invoiced)</div>
                        <div class="fc-stat-sub"><b>@_fs.InvoiceCount</b> فاتورة</div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#2A6FB0">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></div>
                            <div class="fc-stat-lb">المحصّل</div>
                        </div>
                        <div class="fc-stat-num">@Money(_fs.Collected)</div>
                        <div class="fc-stat-sub"><b>@_fs.PaymentCount</b> دفعة</div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#B3261E">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Receipt" /></div>
                            <div class="fc-stat-lb">المصروفات</div>
                        </div>
                        <div class="fc-stat-num">@Money(_fs.Expenses)</div>
                        <div class="fc-stat-sub">تحصيل <b>@CollectionRate</b> من المفوتر</div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#14804A">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Savings" /></div>
                            <div class="fc-stat-lb">صافي النقد</div>
                        </div>
                        <div class="fc-stat-num @NumClass(_fs.NetCash)">@Money(_fs.NetCash)</div>
                        <div class="fc-stat-sub">محصّل − مصروفات</div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#C8860D">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.HourglassBottom" /></div>
                            <div class="fc-stat-lb">مديونية العملاء</div>
                        </div>
                        <div class="fc-stat-num is-neg">@Money(_fs.Receivable)</div>
                        <div class="fc-stat-sub">كل الفواتير المفتوحة</div>
                    </div>
                </div>

                <div class="fc-split2">
                    <div class="fc-panel2">
                        <div class="fc-rep-sec" style="margin-top:0">
                            <div>
                                <h3><MudIcon Icon="@Icons.Material.Filled.BarChart" /> التدفق الشهري</h3>
                                <div class="fc-rep-sec-sub">مفوتر مقابل محصّل</div>
                            </div>
                        </div>
                        <div class="fc-chart">
                            @foreach (var m in _months ?? NoMonth)
                            {
                                <div class="fc-chart-col">
                                    <div class="fc-chart-bars">
                                        <div class="fc-bar fc-bar-gold" style="@BarH(m.Invoiced, MonthPeak)"
                                             title="@TipInv(m.Invoiced)"></div>
                                        <div class="fc-bar fc-bar-green" style="@BarH(m.Collected, MonthPeak)"
                                             title="@TipCol(m.Collected)"></div>
                                    </div>
                                    <div class="fc-chart-lb">@ShortMonth(m.Month)</div>
                                </div>
                            }
                        </div>
                        <div class="fc-legend">
                            <span><i class="fc-dot fc-bar-gold"></i> مفوتر</span>
                            <span><i class="fc-dot fc-bar-green"></i> محصّل</span>
                        </div>
                    </div>

                    <div class="fc-panel2">
                        <div class="fc-rep-sec" style="margin-top:0">
                            <div>
                                <h3><MudIcon Icon="@Icons.Material.Filled.PieChart" /> المصروفات حسب النوع</h3>
                            </div>
                        </div>
                        <div class="fc-mix">
                            @foreach (var (e, pct, col) in ExpenseMix)
                            {
                                <div class="fc-mix-row">
                                    <div class="fc-mix-lb">
                                        <i class="fc-dot" style="@Bg(col)"></i> @e.TypeName
                                        <span class="fc-mix-pct">@Pct(pct)</span>
                                    </div>
                                    <div class="fc-mix-v">@Money(e.Total)</div>
                                    <div class="fc-mix-bar"><i style="@W(pct); background:@col"></i></div>
                                </div>
                            }
                            @if (_exp is null || _exp.Count == 0)
                            {
                                <div class="fc-empty" style="padding:26px">مافيش مصروفات في الفترة دي</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="fc-rep-sec">
                    <div>
                        <h3><MudIcon Icon="@Icons.Material.Filled.People" /> أرصدة العملاء</h3>
                        <div class="fc-rep-sec-sub">مرتبة من الأكبر مديونية — أول 30 عميل</div>
                    </div>
                </div>

                <div class="fc-table-wrap" style="max-height:420px">
                    <table class="fc-table-pro2">
                        <thead><tr><th>العميل</th><th class="num">المفوتر</th>
                            <th class="num">المحصّل</th><th class="num">الرصيد</th></tr></thead>
                        <tbody>
                            @foreach (var c in (_custs ?? NoCust).Take(30))
                            {
                                <tr>
                                    <td class="id">@c.CustomerName</td>
                                    <td class="num">@Money(c.Invoiced)</td>
                                    <td class="num mut">@Money(c.Paid)</td>
                                    <td class="num @NumClass(-c.Balance)">@Money(c.Balance)</td>
                                </tr>
                            }
                            @if (_custs is null || _custs.Count == 0)
                            {
                                <tr><td colspan="4" class="fc-empty">مافيش أرصدة</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* ══════════════════ الأسطول ══════════════════ *@
            @if (_tab == 2 && CanFleet && _ft is not null)
            {
                <div class="fc-stats">
                    <div class="fc-stat" style="--fc-accent:#16233A">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.LocalShipping" /></div>
                            <div class="fc-stat-lb">الرحلات</div>
                        </div>
                        <div class="fc-stat-num">@_ft.Trips</div>
                        <div class="fc-stat-sub">مكتملة <b>@_ft.Completed</b></div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#2A6FB0">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Route" /></div>
                            <div class="fc-stat-lb">المسافة</div>
                        </div>
                        <div class="fc-stat-num">@Num(_ft.TotalKm)</div>
                        <div class="fc-stat-sub">كيلومتر</div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#B3261E">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.Build" /></div>
                            <div class="fc-stat-lb">الصيانة</div>
                        </div>
                        <div class="fc-stat-num">@Money(_ft.MaintCost)</div>
                        <div class="fc-stat-sub">في الفترة</div>
                    </div>
                    <div class="fc-stat" style="--fc-accent:#C8860D">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></div>
                            <div class="fc-stat-lb">عهدة مفتوحة</div>
                        </div>
                        <div class="fc-stat-num">@_ft.Custodies</div>
                        <div class="fc-stat-sub">بقيمة <b>@Money(_ft.CustodyOut)</b></div>
                    </div>
                </div>

                <div class="fc-rep-sec">
                    <div>
                        <h3><MudIcon Icon="@Icons.Material.Filled.Badge" /> أداء السائقين</h3>
                    </div>
                </div>

                <div class="fc-table-wrap" style="max-height:420px">
                    <table class="fc-table-pro2">
                        <thead><tr><th>السائق</th><th class="num">الرحلات</th><th class="num">مكتملة</th>
                            <th class="num">المسافة</th><th class="num">متوسط الساعات</th>
                            <th class="num">العهدة المصروفة</th><th class="num">عهد مفتوحة</th></tr></thead>
                        <tbody>
                            @foreach (var d in _drv ?? NoDrv)
                            {
                                <tr>
                                    <td class="id">@d.DriverName</td>
                                    <td class="num">@d.Trips</td>
                                    <td class="num mut">@d.Completed</td>
                                    <td class="num">@Num(d.TotalKm)</td>
                                    <td class="num">@d.AvgHours</td>
                                    <td class="num">@Money(d.CustodyIssued)</td>
                                    <td class="num @NegClass(d.OpenCustodies)">@d.OpenCustodies</td>
                                </tr>
                            }
                            @if (_drv is null || _drv.Count == 0)
                            {
                                <tr><td colspan="7" class="fc-empty">مافيش رحلات في الفترة دي</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="fc-rep-sec">
                    <div>
                        <h3><MudIcon Icon="@Icons.Material.Filled.DirectionsCar" /> أداء السيارات</h3>
                        <div class="fc-rep-sec-sub">تكلفة التشغيل مقابل الإيراد</div>
                    </div>
                </div>

                <div class="fc-table-wrap" style="max-height:420px">
                    <table class="fc-table-pro2">
                        <thead><tr><th>اللوحة</th><th class="num">الرحلات</th><th class="num">مكتملة</th>
                            <th class="num">المسافة</th><th class="num">تكلفة التشغيل</th>
                            <th class="num">الصيانة</th><th class="num">الإيراد</th>
                            <th class="num">الربح</th><th class="num">تكلفة/كم</th></tr></thead>
                        <tbody>
                            @foreach (var v in _veh ?? NoVeh)
                            {
                                <tr>
                                    <td class="id">@v.PlateNumber</td>
                                    <td class="num">@v.Trips</td>
                                    <td class="num mut">@v.Completed</td>
                                    <td class="num">@Num(v.TotalKm)</td>
                                    <td class="num mut">@Money(v.TripCost)</td>
                                    <td class="num mut">@Money(v.MaintCost)</td>
                                    <td class="num">@Money(v.Revenue)</td>
                                    <td class="num @NumClass(v.Profit)">@Money(v.Profit)</td>
                                    <td class="num mut">@Money(v.CostPerKm)</td>
                                </tr>
                            }
                            @if (_veh is null || _veh.Count == 0)
                            {
                                <tr><td colspan="9" class="fc-empty">مافيش رحلات في الفترة دي</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    // ── صلاحيات ──
    private bool CanOps, CanFin, CanFleet, CanExport;
    private bool Any => CanOps || CanFin || CanFleet;

    // ── حالة ──
    private string _from = "";
    private string _to   = "";
    private int    _tab  = -1;
    private int    _quick = 1;
    private bool   _loading, _busy;
    private string? _err;

    // ── بيانات ──
    private RangeDto?         _range;
    private List<OpRow>?      _ops;
    private OpTotals?         _ot;
    private FinSummary?       _fs;
    private List<MonthRow>?   _months;
    private List<ExpenseRow>? _exp;
    private List<CustomerRow>? _custs;
    private List<DriverRow>?  _drv;
    private List<VehicleRow>? _veh;
    private FleetTotals?      _ft;

    private static readonly List<OpRow>       NoOp    = new();
