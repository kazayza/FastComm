                            <div class="rpt-section-sub">مرتبة من الأقدم — مش مرتبطة بالفترة المختارة</div>
                        </div>

                        @if (_ovd.Count == 0)
                        {
                            <div class="rpt-good-state">
                                <span></span>
                                <span>لايوجد فواتير متأخرة</span>
                            </div>
                        }
                        else
                        {
                            <div class="rpt-table-wrap">
                                <table class="rpt-table">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="th-start">الفاتورة</th>
                                            <th scope="col">الإصدار</th>
                                            <th scope="col">الاستحقاق</th>
                                            <th scope="col" class="th-num">تأخير</th>
                                            <th scope="col" class="th-num">الإجمالي</th>
                                            <th scope="col" class="th-num">المحصّل</th>
                                            <th scope="col" class="th-num">المتبقي</th>
                                            <th scope="col">الحالة</th>
                                        </tr>
                                    </thead>
