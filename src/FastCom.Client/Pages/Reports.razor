</div>

@code {
    // ── صلاحيات ──
    private bool CanOps, CanFin, CanFleet, CanExport, CanSup;
    private bool Any => CanOps || CanFin || CanFleet;

    // ── حالة ──
    private string _from = "";
    private string _to   = "";
    private int    _tab  = -1;
    private int    _quick = 1;
    private bool   _loading, _busy;
    private string? _err;

    // ── بيانات ──
    private RangeDto?         _range;
    private List<OpRow>?      _ops;
    private OpTotals?         _ot;
    private FinSummary?       _fs;
    private List<MonthRow>?   _months;
    private List<ExpenseRow>? _exp;
    private List<CustomerRow>? _custs;
    private List<DriverRow>?  _drv;
    private List<VehicleRow>? _veh;
    private FleetTotals?      _ft;

    /* ═══ 🆕 قائمة الدخل ═══ */
    private PnlSummary?        _pnl;
    private List<PnlMonth>?    _pnlMonths;
    private List<PnlCostRow>?  _pnlCost;
    private List<CompareRow>?  _cmp;

    /* ═══ 🆕 المتأخرات ═══ */
    private List<OverdueRow>?  _ovd;
    private decimal            _ovdTotal;

    /* ═══ 🆕 الموانئ · الخدمات · التدفق ═══ */
    private List<ProfitRow>?   _ports;
    private List<ProfitRow>?   _dests;
    private int                _noPort;
    private List<ProfitRow>?   _svcs;
    private int                _noSvc;
    private List<CashWeek>?    _cf;

    /* 🆕 أعمار ديون الموردين — api/reports/supplier-aging */
    private List<SupAgingRow>? _sag;
    private decimal _sagTotal;
    private string _sagAsOf = "";
    public class SupAgingRow
    {
        public string SupplierName { get; set; } = "";
        public int Invoices { get; set; }
        public decimal D0_30 { get; set; }
        public decimal D31_60 { get; set; }
        public decimal D61_90 { get; set; }
        public decimal D90Plus { get; set; }
        public decimal NoDue { get; set; }
        public decimal Balance { get; set; }
    }
    private class SupAgingRes { public string? AsOf { get; set; } public decimal Total { get; set; }
        public List<SupAgingRow> Rows { get; set; } = new(); }

    /* ═══ 🆕 التدفق النقدي الفعلي — api/reports/cashflow-actual ═══ */
    private CashActualRes?  _cas;
    private int _caCount;   /* 🆕 عدّاد الحركات للتبويب (مش قائمة الأشهر — CS0029) */
    private string          _caFrom = "";

    private class CashLine
    {
        public string  Label  { get; set; } = "";
        public int     Count  { get; set; }
        public decimal Amount { get; set; }
        public decimal Pct    { get; set; }
    }
    private class CashMonth
    {
        public string  Key       { get; set; } = "";
        public string  MonthName { get; set; } = "";
        public decimal Inflow    { get; set; }
        public decimal Outflow   { get; set; }
        public decimal Net       { get; set; }
    }
    private class CashBoxRow
    {
        public string  BoxName     { get; set; } = "";
        public decimal Inflow      { get; set; }
        public decimal Outflow     { get; set; }
        public decimal TransferIn  { get; set; }
        public decimal TransferOut { get; set; }
        public decimal Net         { get; set; }
        public decimal Closing     { get; set; }
    }
    private class CashActualRes
    {
        public decimal           Opening  { get; set; }
        public decimal           Closing  { get; set; }
        public decimal           TotalIn  { get; set; }
        public decimal           TotalOut { get; set; }
        public decimal           Net      { get; set; }
        public int               Count    { get; set; }
        public List<CashLine>    InLines  { get; set; } = new();
        public List<CashLine>    OutLines { get; set; } = new();
        public List<CashLine>    InSrc    { get; set; } = new();
        public List<CashLine>    OutSrc   { get; set; } = new();
        public List<CashMonth>   Months   { get; set; } = new();
        public List<CashBoxRow>  Boxes    { get; set; } = new();
    }
    private decimal            _cfTotal;

    private static readonly List<OpRow>       NoOp    = new();
    private static readonly List<MonthRow>    NoMonth = new();
    private static readonly List<CustomerRow> NoCust  = new();
    private static readonly List<DriverRow>   NoDrv   = new();
    private static readonly List<VehicleRow>  NoVeh   = new();
    private static readonly List<PnlMonth>    NoPnlMonth = new();
    private static readonly List<PnlCostRow>  NoPnlCost  = new();

    private static readonly (int Kind, string Label)[] Quicks =
        { (0, "الشهر ده"), (1, "3 شهور"), (2, "السنة دي") };

    private int RowsCount => _tab switch
    {
        0 => _ops?.Count ?? 0,
        1 => _custs?.Count ?? 0,
        3 => (_pnlMonths?.Count ?? 0) + (_pnlCost?.Count ?? 0),
        4 => _ovd?.Count ?? 0,
        5 => (_ports?.Count ?? 0) + (_dests?.Count ?? 0),
        6 => _svcs?.Count ?? 0,
        7 => _cf?.Count ?? 0,
        _ => (_drv?.Count ?? 0) + (_veh?.Count ?? 0)
    };

    protected override async Task OnInitializedAsync()
    {
        Quick(1);
        await LoadAsync();
    }

    private void Quick(int kind)
    {
        _quick = kind;
        var today = DateTime.Today;
        _to = today.ToString("yyyy-MM-dd");
        _from = kind switch
        {
            0 => new DateTime(today.Year, today.Month, 1).ToString("yyyy-MM-dd"),
            2 => new DateTime(today.Year, 1, 1).ToString("yyyy-MM-dd"),
            _ => today.AddMonths(-3).ToString("yyyy-MM-dd")
        };
    }

    private async Task Reload() { Quick(_quick); await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true; _err = null;
        try
        {
            var q = $"from={_from}&to={_to}";

            var can = await Http.GetFromJsonAsync<Perms>("api/reports/can");
            if (can is not null)
            {
                CanOps = can.Operations; CanFin = can.Financial;
                CanFleet = can.Fleet; CanExport = can.Export;
                CanSup = can.Suppliers;
            }

            if (_tab < 0) _tab = CanOps ? 0 : (CanFin ? 1 : (CanFleet ? 2 : 0));

            if (CanOps)
            {
                var o = await Http.GetFromJsonAsync<OpsRes>($"api/reports/operations?{q}");
                _ops = o?.Rows; _ot = o?.Totals; _range ??= o?.Range;
            }
            if (CanFin)
            {
                var f = await Http.GetFromJsonAsync<FinRes>($"api/reports/financial?{q}");
                _fs = f?.Summary; _months = f?.Months; _exp = f?.Expenses; _custs = f?.Customers;
                _range ??= f?.Range;
            }
            if (CanFleet)
            {
                var fl = await Http.GetFromJsonAsync<FleetRes>($"api/reports/fleet?{q}");
                _drv = fl?.Drivers; _veh = fl?.Vehicles; _ft = fl?.Totals;
                _range ??= fl?.Range;
            }
            if (CanFin)   /* 🆕 قائمة الدخل — نفس صلاحية المالي */
            {
                var pl = await Http.GetFromJsonAsync<PnlRes>($"api/reports/pnl?{q}");
                _pnl = pl?.Summary; _pnlMonths = pl?.Months; _pnlCost = pl?.CostRows;
                _range ??= pl?.Range;

                var cm = await Http.GetFromJsonAsync<CmpRes>($"api/reports/compare?{q}");
                _cmp = cm?.Rows;

                /* ⏰ المتأخرات **مش مرتبطة بالفترة** — كل الفواتير المفتوحة */
                var ov = await Http.GetFromJsonAsync<OvdRes>("api/reports/overdue");
                _ovd = ov?.Rows; _ovdTotal = ov?.Total ?? 0m;

                var cf = await Http.GetFromJsonAsync<CfRes>("api/reports/cashflow");
                _cf = cf?.Rows; _cfTotal = cf?.Total ?? 0m;

                /* 🆕 أعمار الموردين — صلاحيتها SUPPLIER.VIEW مش REPORT.FINANCIAL */
                if (CanSup)
                {
                    try
                    {
                        var sa = await Http.GetFromJsonAsync<SupAgingRes>("api/reports/supplier-aging");
                        _sag = sa?.Rows; _sagTotal = sa?.Total ?? 0m; _sagAsOf = sa?.AsOf ?? "";
                    }
                    catch { _sag = new(); }
                }

                /* 🆕 التدفق الفعلي — محتاج REPORT.FINANCIAL، وبيشتغل بالفترة */
                if (CanFin)
                {
                    try
                    {
                        _cas = await Http.GetFromJsonAsync<CashActualRes>($"api/reports/cashflow-actual?{q}");
                        _caCount = _cas?.Count ?? 0;
                        _caFrom = _from;
                    }
                    catch { _cas = new(); _caCount = 0; }
                }
            }
            if (CanOps)   /* 🆕 الموانئ + الخدمات */
            {
                var po = await Http.GetFromJsonAsync<PortsRes>($"api/reports/ports?{q}");
                _ports = po?.Ports; _dests = po?.Destinations; _noPort = po?.NoPort ?? 0;

                var sv = await Http.GetFromJsonAsync<SvcsRes>($"api/reports/services?{q}");
                _svcs = sv?.Rows; _noSvc = sv?.NoService ?? 0;
            }
        }
        catch (Exception ex) { _err = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    private string CurrentReport => _tab switch
    {
        0 => "operations",
        1 => "financial",
        3 => "pnl",
        4 => "overdue",
        5 => "ports",
        6 => "services",
        7 => "cashflow",
        8 => "supplier-aging",
        9 => "cashflow-actual",
        _ => "fleet"
    };

    private bool CanExportNow => CanExport;

    private async Task Export()
    {
        _busy = true;
        try
        {
            var bytes = await Http.GetByteArrayAsync($"api/reports/excel?report={CurrentReport}&from={_from}&to={_to}");
            if (bytes is null || bytes.Length == 0) throw new Exception("السيرفر مرجّعش ملف");

            var name = $"fastcom-{CurrentReport}-{_from}-{_to}.xlsx";
            await JS.InvokeAsync<bool>("fastcom.downloadBase64", Convert.ToBase64String(bytes),
                name, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add("✅ اتصدّر الملف", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add("فشل التصدير: " + ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    // ══════════ تنسيق ══════════

    private static readonly string[] MixColors =
        { "#C8860D", "#2A6FB0", "#14804A", "#B3261E", "#6B4FA0", "#0E7C86", "#8A6D3B", "#5A6B85" };

    /// <summary>أكبر 6 أنواع مصروفات + نسبتها من الإجمالي + لونها.</summary>
    private IEnumerable<(ExpenseRow E, decimal Pct, string Col)> ExpenseMix
    {
        get
        {
            if (_exp is null || _exp.Count == 0) yield break;
            var total = _exp.Sum(x => x.Total);
            if (total <= 0) yield break;

            var i = 0;
            foreach (var e in _exp.OrderByDescending(x => x.Total).Take(6))
            {
                yield return (e, e.Total / total * 100m, MixColors[i % MixColors.Length]);
                i++;
            }
        }
    }

    private decimal MonthPeak
    {
        get
        {
            if (_months is null || _months.Count == 0) return 1m;
            var p = _months.Max(m => Math.Max(m.Invoiced, m.Collected));
            return p > 0 ? p : 1m;
        }
    }

    private string CostShare => _ot is null || _ot.Revenue <= 0 ? "—" : Pct(_ot.Cost / _ot.Revenue * 100m);

