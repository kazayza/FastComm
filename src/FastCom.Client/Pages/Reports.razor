                                    @foreach (var (e, pct, col) in ExpenseMix)
                                    {
                                        <div class="rpt-mix-row">
                                            <div class="rpt-mix-label">
                                                <i class="rpt-legend-dot" style="@Bg(col)"></i>
                                                @e.TypeName
                                            </div>
                                            <div class="rpt-mix-bar">
                                                <div class="rpt-mix-fill" style="@W(pct); @Bg(col)"></div>
                                            </div>
                                            <div class="rpt-mix-val">@Money(e.Total)</div>
                                            <div class="rpt-mix-pct">@Pct(pct)</div>
