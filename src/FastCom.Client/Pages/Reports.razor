                    {
                        <div class="fc-table-wrap"><table class="fc-table-pro2">
                            <thead><tr>
                                <th>الخدمة</th><th>عمليات</th><th>الإيراد</th>
                                <th>التكلفة</th><th>الربح</th><th>الهامش</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var r in _svcs)
                                {
                                    <tr>
                                        <td class="fc-cell-main">@r.Name</td>
                                        <td>@r.Operations</td>
                                        <td>@Money(r.Revenue)</td>
                                        <td class="is-neg">@Money(r.Cost)</td>
                                        <td class="@SignCls(r.Profit)"><b>@Money(r.Profit)</b></td>
                                        <td><span class="fc-chip @ChgChip(r.MarginPct)">@Pct(r.MarginPct)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>

                @if (_noSvc > 0)
                {
                    <div class="fc-field-hint" style="margin-top:10px">
                        فيه <b>@_noSvc</b> عملية من غير خدمة محدّدة — مش داخلة في الجدول.
                    </div>
                }
            }

            @* ══════════════════ 🆕 التدفق النقدي المتوقع ══════════════════ *@
            @* ══════════════════ أعمار ديون الموردين ══════════════════ *@
            @if (_tab == 9 && CanFin && _cas is not null)
            {
                <div class="fc-stats">
                    <div class="fc-stat">
                        <div class="fc-stat-head">
                            <div class="fc-stat-ic"><MudIcon Icon="@Icons.Material.Filled.South" /></div>
                            <div class="fc-stat-lb">رصيد أول الفترة</div>
                        </div>
