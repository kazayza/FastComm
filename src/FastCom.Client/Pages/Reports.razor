                    <div class="fc-panel2">
                        <div class="fc-rep-sec" style="margin-top:0">
                            <div>
                                <h3><MudIcon Icon="@Icons.Material.Filled.Place" /> الوجهات</h3>
                                <div class="fc-rep-sec-sub">مرتبة من الأعلى ربحًا</div>
                            </div>
                        </div>
                        @if (_dests is null || _dests.Count == 0)
                        {
                            <div class="fc-empty">مافيش عمليات بوجهة محدّدة في الفترة دي</div>
                        }
                        else
                        {
                            <div class="fc-table-wrap"><table class="fc-table-pro2">
                                <thead><tr>
                                    <th>الوجهة</th><th>عمليات</th><th>الإيراد</th>
                                    <th>التكلفة</th><th>الربح</th><th>الهامش</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var r in _dests)
                                    {
                                        <tr>
                                            <td class="fc-cell-main">@r.Name</td>
                                            <td>@r.Operations</td>
                                            <td>@Money(r.Revenue)</td>
                                            <td class="is-neg">@Money(r.Cost)</td>
                                            <td class="@SignCls(r.Profit)"><b>@Money(r.Profit)</b></td>
                                            <td><span class="fc-chip @ChgChip(r.MarginPct)">@Pct(r.MarginPct)</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </div>

                @if (_noPort > 0)
                {
                    <div class="fc-field-hint" style="margin-top:10px">
                        فيه <b>@_noPort</b> عملية من غير ميناء محدّد — مش داخلة في الجدول.
                    </div>
                }
            }

            @* ══════════════════ 🆕 الخدمات ══════════════════ *@
            @if (_tab == 6 && CanOps && _svcs is not null)
            {
                <div class="fc-panel2">
                    <div class="fc-rep-sec" style="margin-top:0">
                        <div>
                            <h3><MudIcon Icon="@Icons.Material.Filled.BookOnline" /> ربحية الخدمات</h3>
                            <div class="fc-rep-sec-sub">الإيراد من العمليات · التكلفة = مصروفات مباشرة + نصيب الرحلات</div>
                        </div>
                    </div>

                    @if (_svcs.Count == 0)
                    {
                        <div class="fc-empty">مافيش عمليات بخدمة محدّدة في الفترة دي</div>
