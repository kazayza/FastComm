                                        <tr>
                                            <td class="td-start">
                                                <div class="rpt-customer-name">@c.CustomerName</div>
                                            </td>
                                            <td class="td-num">@Money(c.Invoiced)</td>
                                            <td class="td-num td-muted">@Money(c.Paid)</td>
