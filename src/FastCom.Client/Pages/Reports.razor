    private static readonly string[] MixColors =
        { "#C8860D", "#2A6FB0", "#14804A", "#B3261E", "#6B4FA0", "#0E7C86", "#8A6D3B", "#5A6B85" };

    private IEnumerable<(ExpenseRow E, decimal Pct, string Col)> ExpenseMix
    {
        get
        {
            if (_exp is null || _exp.Count == 0) yield break;
            var total = _exp.Sum(x => x.Total);
            if (total <= 0) yield break;
            var i = 0;
            foreach (var e in _exp.OrderByDescending(x => x.Total).Take(6))
            { yield return (e, e.Total / total * 100m, MixColors[i % MixColors.Length]); i++; }
        }
    }

    private decimal MonthPeak
    {
        get
        {
            if (_months is null || _months.Count == 0) return 1m;
            var p = _months.Max(m => Math.Max(m.Invoiced, m.Collected));
            return p > 0 ? p : 1m;
        }
    }

    private string CostShare => _ot is null || _ot.Revenue <= 0 ? "—" : Pct(_ot.Cost / _ot.Revenue * 100m);
    private string CollectionRate => _fs is null || _fs.Invoiced <= 0 ? "—" : Pct(_fs.Collected / _fs.Invoiced * 100m);

    private static decimal Clamp(decimal v) => v < 0 ? 0 : (v > 100 ? 100 : v);
    private static string W(decimal pct)  => $"width:{Clamp(pct):F1}%";
    private static string H(decimal v, decimal peak) => $"height:{(peak <= 0 ? 0 : Math.Max(2, v / peak * 100)):F1}%";
    private static string BarH(decimal v, decimal peak) => H(v, peak);
    private static string Bg(string col)  => $"background:{col}";
    private static string TipInv(decimal v)  => $"مفوتر: {v:N2}";
