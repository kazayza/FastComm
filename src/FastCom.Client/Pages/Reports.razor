                                    <th style="text-align:left">المبلغ</th><th>من الإجمالي</th></tr></thead>
                                <tbody>
                                    @foreach (var r in _cas.InLines ?? new())
                                    {
                                        <tr>
                                            <td>@r.Label</td>
                                            <td class="fc-cell-sub">@r.Count</td>
