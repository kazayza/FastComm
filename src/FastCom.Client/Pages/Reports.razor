                                    {
                                        <tr><td colspan="4" class="td-empty">مافيش أرصدة</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }


                    @* ════════════════════════════════
                       TAB 2 — الأسطول
                    ════════════════════════════════ *@
                    @if (_tab == 2 && CanFleet && _ft is not null)
                    {
                        <div class="rpt-kpi-grid">
                            <div class="rpt-kpi-card kpi-blue">
                                <div class="rpt-kpi-icon" aria-hidden="true">🚛</div>
