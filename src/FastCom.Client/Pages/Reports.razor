                                @if (_ports.Count == 0)
                                {
                                    <div class="rpt-empty-mini">مافيش عمليات بميناء محدّد</div>
                                }
                                else
                                {
                                    <div class="rpt-table-wrap">
                                        <table class="rpt-table">
                                            <thead>
                                                <tr>
                                                    <th class="th-start">الميناء</th>
                                                    <th class="th-num">عمليات</th>
                                                    <th class="th-num">الإيراد</th>
                                                    <th class="th-num">التكلفة</th>
                                                    <th class="th-num">الربح</th>
                                                    <th class="th-num">الهامش</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in _ports)
                                                {
                                                    <tr>
                                                        <td class="td-start"><strong>@r.Name</strong></td>
                                                        <td class="td-num">@r.Operations</td>
                                                        <td class="td-num">@Money(r.Revenue)</td>
                                                        <td class="td-num val-neg">@Money(r.Cost)</td>
                                                        <td class="td-num @SignCls(r.Profit)"><strong>@Money(r.Profit)</strong></td>
                                                        <td class="td-num">
                                                            <span class="rpt-chip @ChgChip(r.MarginPct)">@Pct(r.MarginPct)</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                            <div class="rpt-panel">
                                <div class="rpt-section-head">
                                    <div class="rpt-section-title">📍 الوجهات</div>
                                    <div class="rpt-section-sub">مرتبة من الأعلى ربحاً</div>
                                </div>
                                @if (_dests is null || _dests.Count == 0)
                                {
                                    <div class="rpt-empty-mini">مافيش عمليات بوجهة محدّدة</div>
                                }
                                else
                                {
                                    <div class="rpt-table-wrap">
                                        <table class="rpt-table">
                                            <thead>
                                                <tr>
                                                    <th class="th-start">الوجهة</th>
                                                    <th class="th-num">عمليات</th>
                                                    <th class="th-num">الإيراد</th>
                                                    <th class="th-num">التكلفة</th>
                                                    <th class="th-num">الربح</th>
                                                    <th class="th-num">الهامش</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in _dests)
                                                {
                                                    <tr>
                                                        <td class="td-start"><strong>@r.Name</strong></td>
                                                        <td class="td-num">@r.Operations</td>
                                                        <td class="td-num">@Money(r.Revenue)</td>
                                                        <td class="td-num val-neg">@Money(r.Cost)</td>
                                                        <td class="td-num @SignCls(r.Profit)"><strong>@Money(r.Profit)</strong></td>
                                                        <td class="td-num">
                                                            <span class="rpt-chip @ChgChip(r.MarginPct)">@Pct(r.MarginPct)</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                        </div>

                        @if (_noPort > 0)
                        {
                            <div class="rpt-hint-box">
                                <svg viewBox="0 0 16 16" width="12" height="12"
                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <circle cx="8" cy="8" r="6"/>
                                    <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                </svg>
                                فيه <strong>@_noPort</strong> عملية من غير ميناء محدّد — مش داخلة في الجدول
                            </div>
                        }
                    }


                    @* ════════════════════════════════
                       TAB 6 — الخدمات
                    ════════════════════════════════ *@
                    @if (_tab == 6 && CanOps && _svcs is not null)
                    {
                        <div class="rpt-section-head">
                            <div class="rpt-section-title">🔧 ربحية الخدمات</div>
                            <div class="rpt-section-sub">الإيراد من العمليات · التكلفة = مصروفات مباشرة + نصيب الرحلات</div>
                        </div>

                        @if (_svcs.Count == 0)
                        {
                            <div class="rpt-empty-mini">مافيش عمليات بخدمة محدّدة في الفترة دي</div>
                        }
                        else
                        {
                            <div class="rpt-table-wrap">
                                <table class="rpt-table">
                                    <thead>
                                        <tr>
                                            <th class="th-start">الخدمة</th>
                                            <th class="th-num">عمليات</th>
                                            <th class="th-num">الإيراد</th>
                                            <th class="th-num">التكلفة</th>
                                            <th class="th-num">الربح</th>
                                            <th class="th-num">الهامش</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _svcs)
                                        {
                                            <tr>
                                                <td class="td-start"><strong>@r.Name</strong></td>
                                                <td class="td-num">@r.Operations</td>
                                                <td class="td-num">@Money(r.Revenue)</td>
                                                <td class="td-num val-neg">@Money(r.Cost)</td>
                                                <td class="td-num @SignCls(r.Profit)"><strong>@Money(r.Profit)</strong></td>
                                                <td class="td-num">
                                                    <span class="rpt-chip @ChgChip(r.MarginPct)">@Pct(r.MarginPct)</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (_noSvc > 0)
                        {
                            <div class="rpt-hint-box">
                                <svg viewBox="0 0 16 16" width="12" height="12"
                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <circle cx="8" cy="8" r="6"/>
                                    <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                </svg>
                                فيه <strong>@_noSvc</strong> عملية من غير خدمة محدّدة — مش داخلة
                            </div>
                        }
                    }


                    @* ════════════════════════════════
                       TAB 7 — التدفق المتوقع
                    ════════════════════════════════ *@
                    @if (_tab == 7 && CanFin && _cf is not null)
                    {
                        <div class="rpt-kpi-grid">
                            <div class="rpt-kpi-card kpi-blue">
                                <div class="rpt-kpi-icon" aria-hidden="true">💰</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">إجمالي المتوقع</div>
                                    <div class="rpt-kpi-value">@Money(_cfTotal)</div>
                                    <div class="rpt-kpi-sub">من كل الفواتير المفتوحة</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-green">
                                <div class="rpt-kpi-icon" aria-hidden="true">📅</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">الأسبوع ده</div>
                                    <div class="rpt-kpi-value">@Money(FirstWeek)</div>
                                    <div class="rpt-kpi-sub">@FirstWeekCount فاتورة</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-red">
                                <div class="rpt-kpi-icon" aria-hidden="true">⚠️</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">متأخرة</div>
                                    <div class="rpt-kpi-value val-neg">@Money(OverdueBucket)</div>
                                    <div class="rpt-kpi-sub">تحصيل فوري</div>
                                </div>
                            </div>
                        </div>

                        <div class="rpt-panel">
                            <div class="rpt-section-head">
                                <div class="rpt-section-title">⏳ التدفق المتوقع</div>
                                <div class="rpt-section-sub">حسب تاريخ استحقاق الفواتير — 8 أسابيع جاية</div>
                            </div>
                            <div class="rpt-chart-wrap">
                                @foreach (var w in _cf)
                                {
                                    <div class="rpt-chart-col">
                                        <div class="rpt-chart-bars">
                                            <div class="rpt-bar @CfBar(w)"
                                                 style="@BarH(w.Expected, CfPeak)"
                                                 title="@TipCf(w)"></div>
                                        </div>
                                        <div class="rpt-chart-label">@CfLabel(w)</div>
                                    </div>
                                }
                            </div>
                            <div class="rpt-chart-legend">
                                <span><i class="rpt-legend-dot dot-amber"></i>متأخرة</span>
                                <span><i class="rpt-legend-dot dot-green"></i>متوقع</span>
                            </div>

                            <div class="rpt-table-wrap" style="margin-top:14px">
                                <table class="rpt-table">
                                    <thead>
                                        <tr>
                                            <th class="th-start">الفترة</th>
                                            <th class="th-num">المتوقع</th>
                                            <th class="th-num">عدد الفواتير</th>
                                            <th class="th-num">من الإجمالي</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var w in _cf)
                                        {
                                            <tr>
                                                <td class="td-start"><strong>@w.Label</strong></td>
                                                <td class="td-num"><strong>@Money(w.Expected)</strong></td>
                                                <td class="td-num">@w.Invoices</td>
                                                <td class="td-num">
                                                    <div class="rpt-mini-bar">
                                                        <div class="rpt-mini-fill" style="@W(CfPct(w))"></div>
                                                    </div>
                                                    @Pct(CfPct(w))
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }


                    @* ════════════════════════════════
                       TAB 8 — أعمار الموردين
                    ════════════════════════════════ *@
                    @if (_tab == 8 && CanSup && _sag is not null)
                    {
                        <div class="rpt-section-head">
                            <div class="rpt-section-title">📋 أعمار ديون الموردين</div>
                            <div class="rpt-section-sub">
                                حتى @_sagAsOf
                                · الإجمالي المستحق: <strong>@Money(_sagTotal)</strong>
                            </div>
                        </div>

                        @if (!_sag.Any())
                        {
                            <div class="rpt-good-state">
                                <span></span>
                                <span>لايوجد ديون مفتوحة على الموردين</span>
                            </div>
                        }
                        else
                        {
                            <div class="rpt-table-wrap">
                                <table class="rpt-table">
                                    <thead>
                                        <tr>
                                            <th class="th-start">المورد</th>
                                            <th class="th-num">فواتير</th>
                                            <th class="th-num">0-30 يوم</th>
                                            <th class="th-num">31-60</th>
                                            <th class="th-num">61-90</th>
                                            <th class="th-num">+90 يوم</th>
                                            <th class="th-num">بدون استحقاق</th>
                                            <th class="th-num">الإجمالي</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _sag)
                                        {
                                            <tr>
                                                <td class="td-start"><strong>@r.SupplierName</strong></td>
                                                <td class="td-num td-muted">@r.Invoices</td>
                                                <td class="td-num">@Money(r.D0_30)</td>
                                                <td class="td-num">@Money(r.D31_60)</td>
                                                <td class="td-num">@Money(r.D61_90)</td>
                                                <td class="td-num @NegIf(r.D90Plus)">@Money(r.D90Plus)</td>
                                                <td class="td-num td-muted">@Money(r.NoDue)</td>
                                                <td class="td-num"><strong>@Money(r.Balance)</strong></td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td class="td-start" colspan="2"><strong>الإجمالي</strong></td>
                                            <td class="td-num"><strong>@Money(_sag.Sum(x => x.D0_30))</strong></td>
                                            <td class="td-num"><strong>@Money(_sag.Sum(x => x.D31_60))</strong></td>
                                            <td class="td-num"><strong>@Money(_sag.Sum(x => x.D61_90))</strong></td>
                                            <td class="td-num"><strong>@Money(_sag.Sum(x => x.D90Plus))</strong></td>
                                            <td class="td-num"><strong>@Money(_sag.Sum(x => x.NoDue))</strong></td>
                                            <td class="td-num"><strong>@Money(_sagTotal)</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    }


                    @* ════════════════════════════════
                       TAB 9 — التدفق الفعلي
                    ════════════════════════════════ *@
                    @if (_tab == 9 && CanFin && _cas is not null)
                    {
                        <div class="rpt-kpi-grid">
                            <div class="rpt-kpi-card kpi-blue">
                                <div class="rpt-kpi-icon" aria-hidden="true">🏦</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">رصيد أول الفترة</div>
                                    <div class="rpt-kpi-value">@Money(_cas.Opening)</div>
                                    <div class="rpt-kpi-sub">قبل @_caFrom</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-green">
                                <div class="rpt-kpi-icon" aria-hidden="true">⬇️</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">الوارد</div>
                                    <div class="rpt-kpi-value val-pos">@Money(_cas.TotalIn)</div>
                                    <div class="rpt-kpi-sub">@(_cas.InLines?.Sum(x => x.Count) ?? 0) حركة</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card kpi-red">
                                <div class="rpt-kpi-icon" aria-hidden="true">⬆️</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">الصادر</div>
                                    <div class="rpt-kpi-value val-neg">@Money(_cas.TotalOut)</div>
                                    <div class="rpt-kpi-sub">@(_cas.OutLines?.Sum(x => x.Count) ?? 0) حركة</div>
                                </div>
                            </div>
                            <div class="rpt-kpi-card @(_cas.Net >= 0 ? "kpi-green" : "kpi-red")">
                                <div class="rpt-kpi-icon" aria-hidden="true">📊</div>
                                <div class="rpt-kpi-data">
                                    <div class="rpt-kpi-label">رصيد آخر الفترة</div>
                                    <div class="rpt-kpi-value @NetCls(_cas.Net)">@Money(_cas.Closing)</div>
                                    <div class="rpt-kpi-sub">صافي @Money(_cas.Net)</div>
                                </div>
                            </div>
                        </div>

                        @if (_caCount == 0)
                        {
                            <div class="rpt-empty-mini">مافيش حركات خزينة في الفترة دي</div>
                        }
                        else
                        {
                            <div class="rpt-split-grid">

                                <div class="rpt-panel">
                                    <div class="rpt-section-head">
                                        <div class="rpt-section-title">⬇️ الوارد حسب طريقة السداد</div>
                                        <div class="rpt-section-sub">@Money(_cas.TotalIn)</div>
                                    </div>
                                    <div class="rpt-table-wrap">
                                        <table class="rpt-table">
                                            <thead>
                                                <tr>
                                                    <th class="th-start">الطريقة</th>
                                                    <th class="th-num">حركات</th>
                                                    <th class="th-num">المبلغ</th>
                                                    <th class="th-num">من الإجمالي</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in _cas.InLines ?? new())
                                                {
                                                    <tr>
                                                        <td class="td-start">@r.Label</td>
                                                        <td class="td-num td-muted">@r.Count</td>
                                                        <td class="td-num"><strong>@Money(r.Amount)</strong></td>
                                                        <td class="td-num">
                                                            <div class="rpt-mini-bar">
                                                                <div class="rpt-mini-fill" style="@W(r.Pct)"></div>
                                                            </div>
                                                            @Pct(r.Pct)
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="rpt-panel">
                                    <div class="rpt-section-head">
                                        <div class="rpt-section-title">⬆️ الصادر حسب طريقة السداد</div>
                                        <div class="rpt-section-sub">@Money(_cas.TotalOut)</div>
                                    </div>
                                    <div class="rpt-table-wrap">
                                        <table class="rpt-table">
                                            <thead>
                                                <tr>
                                                    <th class="th-start">الطريقة</th>
                                                    <th class="th-num">حركات</th>
                                                    <th class="th-num">المبلغ</th>
                                                    <th class="th-num">من الإجمالي</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in _cas.OutLines ?? new())
                                                {
                                                    <tr>
                                                        <td class="td-start">@r.Label</td>
                                                        <td class="td-num td-muted">@r.Count</td>
                                                        <td class="td-num"><strong>@Money(r.Amount)</strong></td>
                                                        <td class="td-num">
                                                            <div class="rpt-mini-bar">
                                                                <div class="rpt-mini-fill" style="@W(r.Pct)"></div>
                                                            </div>
                                                            @Pct(r.Pct)
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>

                            @* الحركة حسب المصدر *@
                            <div class="rpt-split-grid">
                                <div class="rpt-panel">
                                    <div class="rpt-section-head">
                                        <div class="rpt-section-title">📥 مصادر الوارد</div>
                                    </div>
                                    <div class="rpt-table-wrap">
                                        <table class="rpt-table">
                                            <thead><tr><th class="th-start">المصدر</th><th class="th-num">حركات</th><th class="th-num">المبلغ</th></tr></thead>
                                            <tbody>
                                                @foreach (var r in _cas.InSrc ?? new())
                                                {
                                                    <tr>
                                                        <td class="td-start">@r.Label</td>
                                                        <td class="td-num td-muted">@r.Count</td>
                                                        <td class="td-num"><strong>@Money(r.Amount)</strong></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="rpt-panel">
                                    <div class="rpt-section-head">
                                        <div class="rpt-section-title">📤 مصادر الصادر</div>
                                    </div>
                                    <div class="rpt-table-wrap">
                                        <table class="rpt-table">
                                            <thead><tr><th class="th-start">المصدر</th><th class="th-num">حركات</th><th class="th-num">المبلغ</th></tr></thead>
                                            <tbody>
                                                @foreach (var r in _cas.OutSrc ?? new())
                                                {
                                                    <tr>
                                                        <td class="td-start">@r.Label</td>
                                                        <td class="td-num td-muted">@r.Count</td>
                                                        <td class="td-num"><strong>@Money(r.Amount)</strong></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            @* شهري *@
                            <div class="rpt-panel">
                                <div class="rpt-section-head">
                                    <div class="rpt-section-title">📅 الحركة شهرياً</div>
                                </div>
                                <div class="rpt-table-wrap">
                                    <table class="rpt-table">
                                        <thead>
                                            <tr>
                                                <th class="th-start">الشهر</th>
                                                <th class="th-num">الوارد</th>
                                                <th class="th-num">الصادر</th>
                                                <th class="th-num">الصافي</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in _cas.Months ?? new())
                                            {
                                                <tr>
                                                    <td class="td-start"><strong>@r.MonthName</strong></td>
                                                    <td class="td-num">@Money(r.Inflow)</td>
                                                    <td class="td-num">@Money(r.Outflow)</td>
                                                    <td class="td-num @NetCls(r.Net)"><strong>@Money(r.Net)</strong></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            @* حسب الخزينة *@
                            <div class="rpt-panel">
                                <div class="rpt-section-head">
                                    <div class="rpt-section-title">🏦 الحركة حسب الخزينة</div>
                                    <div class="rpt-section-sub">التحويلات بين الخزاين مش محسوبة في الوارد والصادر</div>
                                </div>
                                <div class="rpt-table-wrap">
                                    <table class="rpt-table">
                                        <thead>
                                            <tr>
                                                <th class="th-start">الخزينة</th>
                                                <th class="th-num">وارد</th>
                                                <th class="th-num">صادر</th>
                                                <th class="th-num">تحويل وارد</th>
                                                <th class="th-num">تحويل صادر</th>
                                                <th class="th-num">صافي الفترة</th>
                                                <th class="th-num">الرصيد الحالي</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in _cas.Boxes ?? new())
                                            {
                                                <tr>
                                                    <td class="td-start"><strong>@r.BoxName</strong></td>
                                                    <td class="td-num">@Money(r.Inflow)</td>
                                                    <td class="td-num">@Money(r.Outflow)</td>
                                                    <td class="td-num td-muted">@Money(r.TransferIn)</td>
                                                    <td class="td-num td-muted">@Money(r.TransferOut)</td>
                                                    <td class="td-num @NetCls(r.Net)"><strong>@Money(r.Net)</strong></td>
                                                    <td class="td-num"><strong>@Money(r.Closing)</strong></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }

                </div>
            }

        </div>
    }

</div>


<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       BODY
    ================================================================ */
    .rpt-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1400px; width: 100%;
        margin: 0 auto;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* ================================================================
       FILTER CARD
    ================================================================ */
    .rpt-filter-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 8px 20px rgba(15,41,82,.05);
        overflow: hidden;
    }

    .rpt-filter-head {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
    }

    .rpt-filter-title {
        display: flex; align-items: center; gap: 7px;
        font-size: 13px; font-weight: 800; color: #1c2b43;
    }

    .rpt-filter-sub { font-size: 10.5px; color: var(--fc-muted); margin-right: auto; }

    .rpt-filter-controls {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 18px; flex-wrap: wrap;
    }

    /* Quick Buttons */
    .rpt-quick-group {
        display: flex; gap: 4px; padding: 3px;
        border-radius: 9px; background: #f0f3f8;
    }

    .rpt-quick-btn {
        height: 30px; padding: 0 12px;
        border: none; border-radius: 6px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 11px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .rpt-quick-btn:hover:not(.quick-active) { background: rgba(255,255,255,.7); color: var(--fc-text); }
    .quick-active {
        background: var(--fc-card); color: var(--fc-blue);
        box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800;
    }

    /* Date Range */
    .rpt-date-range {
        display: flex; align-items: center; gap: 8px;
    }

    .rpt-date-field { display: flex; align-items: center; gap: 6px; }

    .rpt-date-label { font-size: 11px; font-weight: 700; color: #6b7d95; white-space: nowrap; }

    .rpt-date-input-wrap {
        position: relative; display: flex; align-items: center;
    }
    .rpt-date-icon { position: absolute; right: 10px; color: #9aaabb; pointer-events: none; }

    .rpt-date-input {
        height: 36px; padding: 0 30px 0 10px;
        border: 1px solid #d8e2f0; border-radius: 8px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease;
    }
    .rpt-date-input:focus { border-color: var(--fc-blue); }

    .rpt-date-sep { color: #c0ccd8; font-weight: 700; }

    .rpt-apply-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px;
        border: 0; border-radius: 8px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 12px; font-weight: 800; cursor: pointer;
        box-shadow: 0 3px 10px rgba(30,110,245,.25);
        transition: all .15s ease;
    }
    .rpt-apply-btn:hover { transform: translateY(-1px); }

    /* ================================================================
       STATES
    ================================================================ */
    .rpt-error-box {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 14px 18px; border-radius: 12px;
        background: var(--fc-red-lt); border: 1px solid #ffc8cf;
    }
    .rpt-err-icon { flex: 0 0 auto; color: var(--fc-red); }
    .rpt-error-box strong { display: block; font-size: 13px; font-weight: 800; color: #b02040; }
    .rpt-error-box p { margin: 3px 0 0; font-size: 11.5px; color: var(--fc-red); }

    .rpt-no-access {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 280px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); text-align: center; padding: 40px;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .rpt-no-access-icon { width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f4fa; color: #b0c4d8; }
    .rpt-no-access-title { font-size: 16px; font-weight: 800; color: var(--fc-text); }
    .rpt-no-access-sub   { font-size: 13px; color: var(--fc-muted); }

    /* ================================================================
       MAIN CARD
    ================================================================ */
    .rpt-main-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden; flex: 1;
    }

    /* ================================================================
       TABS BAR
    ================================================================ */
    .rpt-tabs-bar {
        display: flex; gap: 2px;
        padding: 10px 14px 0;
        background: linear-gradient(180deg, #f9fafd 0%, #f3f6fb 100%);
        border-bottom: 2px solid #e8edf5;
        overflow-x: auto; flex-wrap: nowrap;
    }

    .rpt-tab {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 12px;
        border: none; border-radius: 9px 9px 0 0;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 11.5px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
        position: relative; bottom: -2px;
    }
    .rpt-tab:hover:not(.tab-active) { color: var(--fc-text); background: rgba(255,255,255,.7); }

    .tab-active {
        background: var(--fc-card); color: var(--fc-blue);
        border: 2px solid #e8edf5; border-bottom: 2px solid var(--fc-card);
        font-weight: 800;
    }

    .rpt-tab-icon { font-size: 15px; }

    .rpt-tab-badge {
        min-width: 18px; height: 18px; border-radius: 5px; padding: 0 4px;
        display: inline-flex; align-items: center; justify-content: center;
        background: #e4eaf3; color: #8899ae;
        font-size: 9px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
    }
    .tab-active .rpt-tab-badge { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .rpt-tab-badge.badge-red { background: var(--fc-red-lt); color: var(--fc-red); border: 1px solid #ffc8cf; }

    /* ================================================================
       LOADING
    ================================================================ */
    .rpt-loading {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 200px; color: var(--fc-muted); font-size: 13px; font-weight: 600;
    }
    .rpt-spinner {
        width: 32px; height: 32px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: rpt-spin .75s linear infinite;
    }
    @@keyframes rpt-spin { to { transform: rotate(360deg); } }

    /* ================================================================
       TAB CONTENT
    ================================================================ */
    .rpt-tab-content { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 18px; }

    /* ================================================================
       KPI CARDS
    ================================================================ */
    .rpt-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
    }

    .rpt-kpi-card {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 16px; border-radius: 14px;
        border: 1px solid transparent;
        transition: all .18s ease;
    }
    .rpt-kpi-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(15,41,82,.08); }

    .kpi-blue   { background: var(--fc-blue-lt);   border-color: #c0d4fb; }
    .kpi-green  { background: var(--fc-green-lt);  border-color: #b0e0c5; }
    .kpi-red    { background: var(--fc-red-lt);    border-color: #ffc8cf; }
    .kpi-amber  { background: var(--fc-amber-lt);  border-color: #f0d898; }
    .kpi-purple { background: var(--fc-purple-lt); border-color: #d0bfef; }

    .rpt-kpi-icon { font-size: 26px; flex: 0 0 auto; }

    .rpt-kpi-label { font-size: 9.5px; color: var(--fc-muted); font-weight: 600; }
    .rpt-kpi-value {
        font-family: "Inter", Arial, sans-serif;
        font-size: 17px; font-weight: 900; color: var(--fc-text);
        line-height: 1.2; margin: 2px 0;
    }
    .rpt-kpi-sub { font-size: 10px; color: var(--fc-muted); font-weight: 500; }

    /* ================================================================
       SECTION HEADERS
    ================================================================ */
    .rpt-section-head {
        display: flex; align-items: center; gap: 12px;
        padding-bottom: 12px; border-bottom: 1px solid #edf1f7;
    }
    .rpt-section-title {
        font-size: 13.5px; font-weight: 800; color: #1c2b43;
        display: flex; align-items: center; gap: 7px; flex: 1;
    }
    .rpt-section-sub { font-size: 10.5px; color: var(--fc-muted); }

    /* ================================================================
       PANEL (sub-container)
    ================================================================ */
    .rpt-panel {
        border: 1px solid #e4edf8; border-radius: 12px;
        background: linear-gradient(180deg, #fafcff, #f5f8fb);
        padding: 16px 18px;
        display: flex; flex-direction: column; gap: 14px;
    }

    .rpt-split-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    }

    /* ================================================================
       TABLES
    ================================================================ */
    .rpt-table-wrap { overflow-x: auto; }

    .rpt-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }

    .rpt-table thead th {
        padding: 10px 12px;
        background: linear-gradient(180deg, #f0f5fc, #eaf1f9);
        color: #4a5a74; font-size: 10px; font-weight: 800;
        text-align: center; border-bottom: 2px solid #dce8f5;
        white-space: nowrap; position: sticky; top: 0; z-index: 1;
    }
    .rpt-table .th-start { text-align: right; }
    .rpt-table .th-num   { text-align: center; }

    .rpt-table tbody tr { border-bottom: 1px solid #f0f5fb; transition: background .12s ease; }
    .rpt-table tbody tr:last-child { border-bottom: none; }
    .rpt-table tbody tr:hover { background: #f5f8ff; }

    .rpt-table tbody td { padding: 10px 12px; color: #526070; text-align: center; vertical-align: middle; }
    .rpt-table .td-start { text-align: right !important; }
    .rpt-table .td-num   { text-align: center; font-family: "Inter", Arial, sans-serif; }
    .td-muted  { color: #8899ae !important; }
    .td-empty  { text-align: center; color: #9aaabb; padding: 30px; font-size: 12px; font-style: italic; }

    .rpt-table tfoot tr { background: linear-gradient(180deg, #f0f5fc, #eaf1f9); border-top: 2px solid #dce8f5; }
    .rpt-table tfoot td { padding: 10px 12px; font-weight: 800; color: #1c2b43; text-align: center; }
    .rpt-table tfoot .td-start { text-align: right !important; }

    /* Cell Styles */
    .rpt-op-num  { font-size: 11.5px; font-weight: 900; color: var(--fc-blue); font-family: "Inter", Arial, sans-serif; }
    .rpt-op-cust { font-size: 11px; color: var(--fc-text); font-weight: 700; margin-top: 3px; }
    .rpt-inv-tag { display: inline-flex; padding: 1px 6px; border-radius: 4px; background: var(--fc-blue-lt); color: var(--fc-blue); font-size: 9px; font-weight: 700; border: 1px solid #c0d4fb; margin-top: 3px; font-family: "Inter", Arial, sans-serif; }
    .rpt-inv-num { font-size: 11px; font-weight: 900; color: var(--fc-blue); font-family: "Inter", Arial, sans-serif; }
    .rpt-inv-cell { display: flex; flex-direction: column; gap: 3px; }
    .rpt-driver-name { font-size: 12.5px; font-weight: 800; color: #1c2c44; }
    .rpt-customer-name { font-size: 12.5px; font-weight: 800; color: #1c2c44; }
    .rpt-plate-chip { display: inline-flex; padding: 2px 8px; border-radius: 6px; background: #f0f4fa; border: 1px solid #e0e8f4; font-size: 11px; font-weight: 800; color: #344563; font-family: "Inter", Arial, sans-serif; }

    /* Colors */
    .val-neg { color: var(--fc-red) !important; }
    .val-pos  { color: var(--fc-green) !important; }
    .pos      { color: var(--fc-green) !important; font-weight: 800; }
    .neg      { color: var(--fc-red) !important; font-weight: 800; }

    /* Margin bar */
    .rpt-margin-cell { display: flex; flex-direction: column; align-items: center; gap: 3px; }
    .rpt-mini-bar { width: 50px; height: 4px; border-radius: 3px; background: #e4eaf3; overflow: hidden; display: inline-block; vertical-align: middle; margin-left: 4px; }
    .rpt-mini-fill { height: 100%; border-radius: inherit; background: var(--fc-green); transition: width .4s ease; }
    .hi { color: var(--fc-green); font-weight: 800; }
    .lo { color: var(--fc-red); font-weight: 800; }

    /* Chips */
    .rpt-chip { display: inline-flex; padding: 2px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; white-space: nowrap; }

    /* ================================================================
       CHART
    ================================================================ */
    .rpt-chart-wrap {
        display: flex; align-items: flex-end; gap: 6px;
        height: 160px; padding: 8px 0 0;
    }

    .rpt-chart-col {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; gap: 5px;
    }

    .rpt-chart-bars {
        flex: 1; width: 100%; display: flex;
        align-items: flex-end; justify-content: center; gap: 3px;
    }

    .rpt-bar {
        flex: 1; min-height: 3px; border-radius: 4px 4px 0 0;
        transition: height .5s cubic-bezier(.34,1.2,.64,1);
    }

    .rpt-bar-amber { background: linear-gradient(180deg, #fbbf24, #f59e0b); box-shadow: 0 -2px 8px rgba(251,191,36,.20); }
    .rpt-bar-green { background: linear-gradient(180deg, #34d399, #10b981); box-shadow: 0 -2px 8px rgba(52,211,153,.20); }

    .rpt-chart-label { font-size: 9.5px; font-weight: 700; color: #8899ae; font-family: "Inter", Arial, sans-serif; text-align: center; }

    .rpt-chart-legend { display: flex; gap: 14px; font-size: 10.5px; color: #6b7d95; font-weight: 600; }
    .rpt-chart-legend span { display: flex; align-items: center; gap: 5px; }
    .rpt-legend-dot { display: inline-block; width: 10px; height: 10px; border-radius: 3px; }
    .dot-amber { background: #f59e0b; }
    .dot-green { background: #10b981; }

    /* ================================================================
       MIX (Expense breakdown)
    ================================================================ */
    .rpt-mix { display: flex; flex-direction: column; gap: 8px; }

    .rpt-mix-row {
        display: grid; grid-template-columns: 1fr 120px 90px 50px;
        align-items: center; gap: 10px;
        font-size: 11px;
    }

    .rpt-mix-label { color: var(--fc-text); font-weight: 700; display: flex; align-items: center; gap: 6px; }
    .rpt-mix-bar { height: 6px; border-radius: 4px; background: #e4eaf3; overflow: hidden; }
    .rpt-mix-fill { height: 100%; border-radius: inherit; transition: width .4s ease; }
    .rpt-mix-val { font-family: "Inter", Arial, sans-serif; font-weight: 800; color: var(--fc-text); text-align: center; }
    .rpt-mix-pct { font-size: 10px; color: #8899ae; font-weight: 700; text-align: center; }

    /* ================================================================
       P&L Statement
    ================================================================ */
    .rpt-pnl-statement {
        display: flex; flex-direction: column; gap: 0;
        border: 1px solid #e4edf8; border-radius: 10px; overflow: hidden;
    }

    .rpt-pnl-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 14px; font-size: 12.5px; border-bottom: 1px solid #f0f5fb;
    }
    .rpt-pnl-row:last-child { border-bottom: none; }
    .pnl-sub    { background: #f9fafc; }
    .pnl-cost   { color: var(--fc-red); }
    .pnl-gross  { background: var(--fc-blue-lt); border-top: 2px solid #c0d4fb; }
    .pnl-net    { background: var(--fc-green-lt); border-top: 2px solid #b0e0c5; }

    .rpt-pnl-note {
        font-size: 10.5px; color: var(--fc-muted); font-weight: 500;
        padding: 8px 10px; border-radius: 8px;
        background: #f5f7fa; border: 1px solid #e4eaf3;
    }

    /* ================================================================
       MISC
    ================================================================ */
    .rpt-hint-box {
        display: flex; align-items: center; gap: 8px;
        padding: 10px 14px; border-radius: 9px;
        background: var(--fc-blue-lt); border: 1px solid #bdd4fc;
        color: var(--fc-blue); font-size: 11px; font-weight: 600;
    }

    .rpt-empty-mini {
        padding: 24px; text-align: center;
        color: #9aaabb; font-size: 12px; font-weight: 600;
        border: 1px dashed #e4eaf3; border-radius: 10px; background: #f9fafc;
    }

    .rpt-good-state {
        display: flex; flex-direction: column; align-items: center;
        gap: 8px; padding: 40px; text-align: center;
        color: var(--fc-green); font-size: 14px; font-weight: 700;
    }
    .rpt-good-state span:first-child { font-size: 36px; }

    /* ================================================================
       RESPONSIVE
    ================================================================ */
    @@media (max-width: 1100px) {
        .rpt-split-grid { grid-template-columns: 1fr; }
        .rpt-kpi-grid   { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 900px) {
        .rpt-filter-controls { flex-direction: column; align-items: stretch; }
        .rpt-date-range { flex-wrap: wrap; }
        .rpt-quick-group { flex-wrap: wrap; }
    }

    @@media (max-width: 680px) {
        .rpt-body { padding: 10px 12px 24px; }
        .rpt-kpi-grid { grid-template-columns: 1fr 1fr; }
        .rpt-tab-content { padding: 14px 14px 18px; }
        .rpt-mix-row { grid-template-columns: 1fr 80px 70px; }
        .rpt-mix-pct { display: none; }
    }

    @@media (max-width: 480px) {
        .rpt-tabs-bar { flex-wrap: nowrap; gap: 0; }
        .rpt-tab { padding: 0 8px; font-size: 10.5px; }
        .rpt-tab-icon { display: none; }
        .rpt-kpi-grid { grid-template-columns: 1fr; }
    }

</style>


@code {
