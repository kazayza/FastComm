    .pxl-table thead th.td-start, .pxl-table thead th.pxl-th-act { text-align: start; }

    .pxl-table tbody td {
        padding: 10px;
        text-align: center;
        border-bottom: 1px solid #F1F5F9;
        color: #33475B;
        vertical-align: middle;
    }

    .pxl-table tbody tr:hover { background: #FAFCFF; }
    .pxl-table tbody tr.is-off { background: #FBFCFD; color: #94A3B8; }

    .pxl-table td.td-start { text-align: start; }

    .pxl-general {
        display: inline-block;
        font-size: 11px; font-weight: 800; color: #B45309;
        background: rgba(232, 163, 23, .14);
        border-radius: 999px; padding: 2px 9px;
    }

