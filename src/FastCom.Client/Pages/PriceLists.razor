@code {
    private AuthUser? _user;
    private bool CanView   => (_user?.Can("PRICING.VIEW") ?? false) || (_user?.Can("PRICING.CREATE") ?? false);
    private bool CanCreate => (_user?.Can("PRICING.CREATE") ?? false);
    private bool CanEdit   => (_user?.Can("PRICING.EDIT") ?? false);
    private bool CanDelete => (_user?.Can("PRICING.DELETE") ?? false);

    private List<Lst> _lists = new();
    private List<Rule> _rules = new();
    private int? _sel; private string _selName = "";

    private List<Opt> _customers = new(), _services = new(), _ports = new(),
                      _dests = new(), _ctypes = new(), _ttypes = new();
    private List<TaxOpt> _taxRates = new();

    private bool _listOpen, _ruleOpen, _saving;
    private string? _msg; private bool _ok = true;
    private int? _listEditId;
    private long? _ruleEditId;
    private ListForm _lf = new();
    private RuleForm _rf = new();
    private bool _fabOpen;
    private int _activeTab;
    private bool _triedSave;
    private bool _loading;

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }
    public class TaxOpt { public int Id { get; set; } public string Label { get; set; } = ""; }

    public class Lst
    {
        public int PriceListId { get; set; }
        public string PriceListCode { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string? NameEn { get; set; }
        public DateOnly ValidFrom { get; set; }
        public DateOnly? ValidTo { get; set; }
        public int RuleCount { get; set; }
    }

    public class Rule
    {
        public long CustomerPriceRuleId { get; set; }
        public int CustomerId { get; set; }
        public string CustomerName { get; set; } = "";
        public int? PriceListId { get; set; }
        public string? PriceListName { get; set; }
        public int ServiceId { get; set; }
        public string ServiceName { get; set; } = "";
        public int? PortId { get; set; }
        public string? PortName { get; set; }
        public int? DestinationId { get; set; }
        public string? DestinationName { get; set; }
        public int? TahteeqPortId { get; set; }
        public string? TahteeqPortName { get; set; }
        public int? ContainerTypeId { get; set; }
        public string? ContainerTypeName { get; set; }
        public int? TripTypeId { get; set; }
        public string? TripTypeName { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal? CostPrice { get; set; }
        public int? TaxRateId { get; set; }
        public string? TaxRateName { get; set; }
        public DateOnly ValidFrom { get; set; }
        public DateOnly? ValidTo { get; set; }
        public int Priority { get; set; }
        public bool IsActive { get; set; }
        public string? Notes { get; set; }
        public int Specificity { get; set; }
    }

    public class ListForm
    {
        public string PriceListCode { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string? NameEn { get; set; }
        public string? ValidFrom { get; set; }
        public string? ValidTo { get; set; }
    }

    public class RuleForm
    {
        public int CustomerId { get; set; }
        public int ServiceId { get; set; }
        public int? PortId { get; set; }
        public int? DestinationId { get; set; }
        public int? TahteeqPortId { get; set; }
        public int? ContainerTypeId { get; set; }
        public int? TripTypeId { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal? CostPrice { get; set; }
        public int? TaxRateId { get; set; }
        public string? ValidFrom { get; set; }
        public string? ValidTo { get; set; }
        public int Priority { get; set; } = 100;
        public bool IsActive { get; set; } = true;
        public string? Notes { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;

        _customers = await SafeOpts("api/options/customers");
        _services  = await SafeOpts("api/options/services");
        _ports     = await SafeOpts("api/options/ports");
        _dests     = await SafeOpts("api/options/destinations");
        _ctypes    = await SafeOpts("api/options/container-types");
        _ttypes    = await SafeOpts("api/options/trip-types");
        try { _taxRates = await Http.GetFromJsonAsync<List<TaxOpt>>("api/options/tax-rates") ?? new(); }
        catch { _taxRates = new(); }

        await LoadListsAsync();
    }

    private async Task LoadListsAsync()
    {
        _loading = true;
        try { _lists = await Http.GetFromJsonAsync<List<Lst>>("api/master/pricelists") ?? new(); }
        catch (Exception ex) { _ok = false; _msg = "فشل تحميل البيانات: " + ex.Message; }
        if (_sel is not null) await LoadRulesAsync(_sel.Value);
        _loading = false;
    }

    private async Task SelectList(Lst l)
    {
        _sel = l.PriceListId; _selName = l.NameAr; _msg = null;
        await LoadRulesAsync(l.PriceListId);
    }

    private async Task LoadRulesAsync(int id)
    {
        try { _rules = await Http.GetFromJsonAsync<List<Rule>>($"api/master/pricelists/{id}/rules") ?? new(); }
        catch { _rules = new(); }
    }

    private async Task<List<Opt>> SafeOpts(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Opt>>(url) ?? new(); }
        catch { return new(); }
    }

    /* ── Pricelists ── */
    private void NewList()
    {
        _fabOpen = false;
        _listEditId = null;
        _lf = new ListForm { ValidFrom = DateTime.Now.ToString("yyyy-MM-dd") };
        _msg = null; _listOpen = true;
    }

    private void EditList(Lst l)
    {
        _listEditId = l.PriceListId;
        _lf = new ListForm
        {
            PriceListCode = l.PriceListCode, NameAr = l.NameAr, NameEn = l.NameEn,
            ValidFrom = l.ValidFrom.ToString("yyyy-MM-dd"),
            ValidTo   = l.ValidTo?.ToString("yyyy-MM-dd")
        };
        _msg = null; _listOpen = true;
    }

    private async Task SaveListAsync()
    {
        if (_saving) return;
        if (string.IsNullOrWhiteSpace(_lf.PriceListCode)) { _ok = false; _msg = "كود القائمة مطلوب للتشغيل"; return; }
        if (string.IsNullOrWhiteSpace(_lf.NameAr))        { _ok = false; _msg = "الاسم العربي مطلوب لتأسيس القائمة"; return; }
        if (string.IsNullOrWhiteSpace(_lf.ValidFrom))     { _ok = false; _msg = "يرجى تحديد تاريخ بداية السريان"; return; }

        _saving = true; _msg = null;
        try
        {
            var payload = new
            {
                priceListCode = _lf.PriceListCode.Trim(), nameAr = _lf.NameAr.Trim(), nameEn = _lf.NameEn?.Trim(),
                validFrom = _lf.ValidFrom, validTo = _lf.ValidTo
            };
            var res = _listEditId is null
                ? await Http.PostAsJsonAsync("api/master/pricelists", payload)
                : await Http.PutAsJsonAsync($"api/master/pricelists/{_listEditId}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { _listOpen = false; await LoadListsAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل في حفظ القائمة: " + ex.Message; }
        finally { _saving = false; }
    }

    /* ── Price Rules ── */
    private void NewRule()
    {
        _fabOpen = false;
        _ruleEditId = null;
        _rf = new RuleForm { ValidFrom = DateTime.Now.ToString("yyyy-MM-dd") };
        _msg = null; _ruleOpen = true;
        _triedSave = false; _activeTab = 0;
    }

    private void EditRule(Rule r)
    {
        _ruleEditId = r.CustomerPriceRuleId;
        _rf = new RuleForm
        {
            CustomerId      = r.CustomerId,
            ServiceId       = r.ServiceId,
            PortId          = r.PortId,
            DestinationId   = r.DestinationId,
            TahteeqPortId   = r.TahteeqPortId,
            ContainerTypeId = r.ContainerTypeId,
            TripTypeId      = r.TripTypeId,
            UnitPrice       = r.UnitPrice,
            CostPrice       = r.CostPrice,
            TaxRateId       = r.TaxRateId,
            ValidFrom       = r.ValidFrom.ToString("yyyy-MM-dd"),
            ValidTo         = r.ValidTo?.ToString("yyyy-MM-dd"),
            Priority        = r.Priority,
            IsActive        = r.IsActive,
            Notes           = r.Notes
        };
        _msg = null; _ruleOpen = true;
        _triedSave = false; _activeTab = 0;
    }

    private async Task SaveRuleAsync()
    {
        if (_saving || _sel is null) return;
        _triedSave = true;

        if (_rf.CustomerId <= 0)
        {
            _ok = false; _msg = "يرجى تحديد العميل أولاً";
            _activeTab = 0; return;
        }
        if (_rf.ServiceId <= 0)
        {
            _ok = false; _msg = "يرجى تحديد الخدمة المطلوبة";
            _activeTab = 0; return;
        }
        if (string.IsNullOrWhiteSpace(_rf.ValidFrom))
        {
            _ok = false; _msg = "تاريخ بداية سريان القاعدة مطلوب";
            _activeTab = 2; return;
        }

        _saving = true; _msg = null;
        try
        {
            var payload = new
            {
                customerId = _rf.CustomerId, priceListId = _sel, serviceId = _rf.ServiceId,
                portId = _rf.PortId, destinationId = _rf.DestinationId, tahteeqPortId = _rf.TahteeqPortId,
                containerTypeId = _rf.ContainerTypeId, tripTypeId = _rf.TripTypeId,
                unitPrice = _rf.UnitPrice, costPrice = _rf.CostPrice, taxRateId = _rf.TaxRateId,
                validFrom = _rf.ValidFrom, validTo = _rf.ValidTo,
                priority = _rf.Priority, isActive = _rf.IsActive, notes = _rf.Notes?.Trim()
            };
            var res = _ruleEditId is null
                ? await Http.PostAsJsonAsync($"api/master/pricelists/{_sel}/rules", payload)
                : await Http.PutAsJsonAsync($"api/master/pricelists/rules/{_ruleEditId}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode)
            {
                _ruleOpen = false;
                await LoadRulesAsync(_sel.Value);
                await LoadListsAsync();
            }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل حفظ القاعدة: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task DeleteRuleAsync(Rule r)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/master/pricelists/rules/{r.CustomerPriceRuleId}");
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { await LoadRulesAsync(_sel ?? 0); await LoadListsAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل الحذف: " + ex.Message; }
    }

    /* ── Helpers ── */
    private string RowCls(Lst l) => _sel == l.PriceListId ? "fc-row-sel" : "";

    private static bool IsLive(Lst l)
    {
        var t = DateOnly.FromDateTime(DateTime.Now);
        return l.ValidFrom <= t && (l.ValidTo is null || l.ValidTo >= t);
    }

    private static string Dims(Rule r)
    {
        var d = new List<string>();
        if (!string.IsNullOrWhiteSpace(r.PortName))          d.Add(r.PortName!);
        if (!string.IsNullOrWhiteSpace(r.DestinationName))   d.Add(r.DestinationName!);
        if (!string.IsNullOrWhiteSpace(r.ContainerTypeName)) d.Add(r.ContainerTypeName!);
        if (!string.IsNullOrWhiteSpace(r.TripTypeName))      d.Add(r.TripTypeName!);
        return d.Count == 0 ? "قاعدة عامة (أي بعد تشغيلي)" : string.Join(" · ", d);
    }

    private static int? Nul(object? v) => int.TryParse(v?.ToString(), out var n) && n > 0 ? n : null;
    private static long Lng(object? v) => long.TryParse(v?.ToString(), out var n) && n > 0 ? n : 0;
    private static decimal Dec(object? v) => decimal.TryParse(v?.ToString(), out var n) && n >= 0 ? n : 0m;
    private static string Money(decimal v) => v.ToString("N2");

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تمت العملية بنجاح" : "حصل خطأ غير متوقع"; }
    }

    private void ToggleFab() => _fabOpen = !_fabOpen;
    private void CloseFab() => _fabOpen = false;
    private void OnFabKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") _fabOpen = false; }
}