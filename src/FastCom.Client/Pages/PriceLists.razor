    .pxl-item-edit:hover { color: #0B56DF; border-color: #1e6ef5; }

    /* ── المنطقة الرئيسية ───────────────────────────────────────── */
    .pxl-main {
        background: #fff;
        border: 1px solid #E3E9F0;
        border-radius: 14px;
        overflow: hidden;
        min-height: 420px;
    }

    .pxl-main-empty {
        height: 100%; min-height: 420px;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 8px; padding: 40px 24px; text-align: center;
        color: #8595A8;
    }

    .pxl-main-empty h3 { font-size: 15px; font-weight: 800; color: #33475B; }
    .pxl-main-empty p  { font-size: 12.5px; max-width: 380px; line-height: 1.7; }

    .pxl-main-head {
        display: flex; align-items: flex-start; gap: 14px; flex-wrap: wrap;
        padding: 16px 18px 14px;
        border-bottom: 1px solid #EDF1F7;
    }

    .pxl-main-head-txt { flex: 1; min-width: 220px; }
    .pxl-main-title { font-size: 16px; font-weight: 900; color: #0A1B3B; margin: 0 0 8px; }

    .pxl-chips { display: flex; flex-wrap: wrap; gap: 6px; }

    .pxl-chip {
        font-size: 11px; font-weight: 800; color: #64748B;
        background: #F1F5F9; border-radius: 999px; padding: 3px 10px;
    }

    .pxl-chip-blue  { color: #0B56DF; background: rgba(30, 110, 245, .1); }
    .pxl-chip-green { color: #0e9f6e; background: rgba(14, 159, 110, .12); }
    .pxl-chip-gold  { color: #B45309; background: rgba(232, 163, 23, .14); }
    .pxl-chip-red   { color: #e02424; background: rgba(224, 36, 36, .1); }

    /* ── ملاحظة الأولوية ────────────────────────────────────────── */
    .pxl-note {
        display: flex; align-items: flex-start; gap: 9px;
        margin: 14px 18px 0;
        padding: 10px 12px;
        border: 1px solid rgba(30, 110, 245, .22);
        border-inline-start: 3px solid #1e6ef5;
        background: rgba(30, 110, 245, .05);
        border-radius: 10px;
        font-size: 11.5px; line-height: 1.75; color: #33475B;
    }

    .pxl-note svg { flex: none; color: #1e6ef5; margin-top: 2px; }

    /* ── الجدول ─────────────────────────────────────────────────── */
    .pxl-table-wrap { overflow-x: auto; padding: 14px 18px 18px; }

    .pxl-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }

    .pxl-table thead th {
        text-align: center;
        font-size: 11px; font-weight: 800; color: #64748B;
