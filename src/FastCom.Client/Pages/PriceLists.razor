@page "/master/pricelists"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>قوائم الأسعار والتعريفات — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO — الـ .fc-hero الأصلي ككارت بحواف دائرية 20px وظل عميق
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="doc-hero-row">
                <div class="doc-hero-left">
                    <div class="doc-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="2" y="4" width="20" height="16" rx="2"/><path d="M12 8v8M8 12h8" stroke-linecap="round"/>
                        </svg>
                        <span>البيانات الأساسية · الأسعار</span>
                    </div>
                    <h1 class="fc-hero-title">قوائم ومصفوفات الأسعار</h1>
                    <p class="fc-hero-sub">تخصيص أسعار خاصة بالعملاء والجهات — يطبق النظام تلقائياً القاعدة الأكثر دقة وتخصيصاً</p>
                </div>

                <div class="doc-hero-right">
                    <span class="doc-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                    <span class="doc-hero-chip doc-chip-warn">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01" stroke-linecap="round"/>
                        </svg>
                        القوائم الفعالة: @_lists.Count(IsLive)
                    </span>
                </div>
            </div>

            @if (CanView)
            {
                <div class="doc-kpis-row">
                    <div class="doc-kpi doc-kpi-blue">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Small" /></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_lists.Count</div>
                                <div class="doc-kpi-label">قوائم الأسعار</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-green">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" /></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_lists.Sum(l => l.RuleCount)</div>
                                <div class="doc-kpi-label">قواعد التسعير النشطة</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-gold">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" /></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_lists.Count(IsLive)</div>
                                <div class="doc-kpi-label">قوائم سارية حالياً</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY — عمودان: قوائم الأسعار يمين · قواعد التسعير شمال
═══════════════════════════════════════════ *@
<div class="doc-body">
    @if (!string.IsNullOrEmpty(_msg) && !_listOpen && !_ruleOpen)
    {
        <div class="pxl-banner @(_ok ? "ok" : "err")">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
            </svg>
            <span>@_msg</span>
            <button type="button" class="pxl-banner-x" @onclick="() => _msg = null" aria-label="إخفاء الرسالة">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/></svg>
            </button>
        </div>
    }

    @if (_loading)
    {
        <div class="pxl-load">
            <span class="pxl-load-bar" aria-hidden="true"></span>
            جاري تحميل قوائم الأسعار...
        </div>
    }

    @if (!CanView)
    {
        <div class="pxl-state">
            <div class="pxl-state-icon">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>تحتاج صلاحية <code>PRICING.VIEW</code> لعرض قوائم الأسعار وقواعد التسعير.</p>
        </div>
    }
    else
    {
        <div class="fc-overlap">
            <div class="pxl-grid">

                @* ══ العمود الجانبي: قوائم الأسعار ══ *@
                <aside class="pxl-rail">
                    <div class="pxl-rail-head">
                        <div class="pxl-rail-head-txt">
                            <span class="pxl-rail-title">قوائم الأسعار</span>
                            <span class="pxl-rail-sub">@_lists.Count قائمة · @(_lists.Count(IsLive)) سارية</span>
                        </div>
                        @if (CanCreate)
                        {
                            <button type="button" class="pxl-icon-btn" @onclick="NewList" title="قائمة أسعار جديدة" aria-label="قائمة أسعار جديدة">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
                            </button>
                        }
                    </div>

                    <div class="pxl-rail-list">
                        @if (!_lists.Any())
                        {
                            <div class="pxl-rail-empty">لا توجد قوائم أسعار مسجلة</div>
                        }
                        else
                        {
                            @foreach (var l in _lists)
                            {
                                <div class="pxl-item @(_sel == l.PriceListId ? "is-active" : "")" @onclick="() => SelectList(l)">
                                    <span class="pxl-item-bar" aria-hidden="true"></span>
                                    <span class="pxl-item-body">
                                        <span class="pxl-item-name">@l.NameAr</span>
                                        <span class="pxl-item-meta">
                                            <span class="pxl-item-code">@l.PriceListCode</span>
                                            <span class="pxl-item-live @(IsLive(l) ? "ok" : "off")">@(IsLive(l) ? "سارية" : "غير سارية")</span>
                                        </span>
                                    </span>
                                    <span class="pxl-item-count" title="عدد القواعد">@l.RuleCount</span>
                                    @if (CanEdit)
                                    {
                                        <button type="button" class="pxl-item-edit" @onclick="() => EditList(l)" @onclick:stopPropagation="true" title="تعديل القائمة" aria-label="تعديل القائمة">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </aside>

                @* ══ المنطقة الرئيسية: قواعد القائمة المختارة ══ *@
                <section class="pxl-main">
                    @if (_sel is null)
                    {
                        <div class="pxl-main-empty">
                            <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                                <rect x="2" y="4" width="20" height="16" rx="2"/><path d="M12 8v8M8 12h8" stroke-linecap="round"/>
                            </svg>
                            <h3>اختر قائمة أسعار للبدء</h3>
                            <p>القوائم في العمود الجانبي — اختار واحدة عشان تشوف قواعد التسعير بتاعتها وتضيف عليها.</p>
                        </div>
                    }
                    else
                    {
                        var cur = _lists.FirstOrDefault(x => x.PriceListId == _sel);
                        <div class="pxl-main-head">
                            <div class="pxl-main-head-txt">
                                <h2 class="pxl-main-title">@_selName</h2>
                                <div class="pxl-chips">
                                    <span class="pxl-chip">@_rules.Count قاعدة</span>
                                    <span class="pxl-chip pxl-chip-blue">@(_rules.Count(r => r.CustomerId is null)) تعريفة عامة</span>
                                    @if (_rules.Any())
                                    {
                                        <span class="pxl-chip pxl-chip-green">من @Money(_rules.Min(r => r.UnitPrice)) ج.م</span>
                                        <span class="pxl-chip pxl-chip-gold">لغاية @Money(_rules.Max(r => r.UnitPrice)) ج.م</span>
                                    }
                                    @if (cur is not null)
                                    {
                                        <span class="pxl-chip @(IsLive(cur) ? "pxl-chip-green" : "pxl-chip-red")">
                                            @(IsLive(cur) ? "سارية" : "غير سارية") · من @cur.ValidFrom.ToString("yyyy-MM-dd")@(cur.ValidTo is null ? "" : " لغاية " + cur.ValidTo.Value.ToString("yyyy-MM-dd"))
                                        </span>
                                    }
                                </div>
                            </div>
                            @if (CanCreate)
                            {
                                <button type="button" class="pxl-btn pxl-btn-primary" @onclick="NewRule">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
                                    قاعدة سعر جديدة
                                </button>
                            }
                        </div>

                        <div class="pxl-note">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                            </svg>
                            <span><strong>الأولوية:</strong> بتطبق القاعدة الأخص (ميناء / وجهة / تعتيق / نوع حاوية / نوع رحلة). ولو اتساوت القواعد، الرقم الأقل في عمود الأولوية هو اللي يكسب. القاعدة اللي من غير عميل = <strong>تعريفة عامة</strong> بتطبق على الكل، وقاعدة العميل بتكسب عليها دايمًا.</span>
                        </div>

                        <div class="pxl-table-wrap">
                            <table class="pxl-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="td-start">العميل</th>
                                        <th scope="col" class="td-start">الخدمة</th>
                                        <th scope="col" class="td-start">الأبعاد</th>
                                        <th scope="col">سعر البيع</th>
                                        <th scope="col">التكلفة</th>
                                        <th scope="col">الصلاحية</th>
                                        <th scope="col">الأولوية</th>
                                        @if (CanEdit)
                                        {
                                            <th scope="col" class="pxl-th-act">إجراءات</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in _rules)
                                    {
                                        <tr class="@(!r.IsActive ? "is-off" : "")">
                                            <td class="td-start">
                                                @if (r.CustomerId is null)
                                                {
                                                    <span class="pxl-general">تعريفة عامة</span>
                                                }
                                                else
                                                {
                                                    <strong>@r.CustomerName</strong>
                                                }
                                            </td>
                                            <td class="td-start"><span class="pxl-svc">@r.ServiceName</span></td>
                                            <td class="td-start pxl-dims">@(string.IsNullOrWhiteSpace(Dims(r)) ? "— بدون أبعاد —" : Dims(r))</td>
                                            <td class="pxl-money"><strong>@Money(r.UnitPrice)</strong><small> ج.م</small></td>
                                            <td class="pxl-money pxl-muted">@(r.CostPrice is null ? "—" : Money(r.CostPrice.Value) + " ج.م")</td>
                                            <td class="pxl-muted pxl-dates">
                                                @r.ValidFrom.ToString("yyyy-MM-dd")
                                                @if (r.ValidTo is not null)
                                                {
                                                    <span> لغاية @r.ValidTo.Value.ToString("yyyy-MM-dd")</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="pxl-prio">@r.Priority</span>
                                                @if (!r.IsActive)
                                                {
                                                    <span class="pxl-off-chip">موقوفة</span>
                                                }
                                            </td>
                                            @if (CanEdit)
                                            {
                                                <td>
                                                    <div class="pxl-row-act">
                                                        <button type="button" class="pxl-row-btn" @onclick="() => EditRule(r)" title="تعديل" aria-label="تعديل القاعدة">
                                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                        </button>
                                                        @if (CanDelete)
                                                        {
                                                            <button type="button" class="pxl-row-btn pxl-row-del" @onclick="() => DeleteRuleAsync(r)" title="حذف" aria-label="حذف القاعدة">
                                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                    @if (!_rules.Any())
                                    {
                                        <tr>
                                            <td colspan="@(CanEdit ? 8 : 7)">
                                                <div class="pxl-table-empty">لا توجد قواعد تسعير على القائمة دي — ضيف أول قاعدة.</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

            </div>
        </div>
    }
</div>

@* ═══════════════════════════════════════════
   محرر قائمة الأسعار
═══════════════════════════════════════════ *@
@if (_listOpen && CanCreate)
{
    <div class="pxl-backdrop" @onclick="() => _listOpen = false">
        <div class="pxl-modal pxl-modal-sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="pxl-modal-head">
                <div>
                    <div class="pxl-modal-title">@(_listEditId is null ? "قائمة أسعار جديدة" : "تعديل قائمة الأسعار")</div>
                    <div class="pxl-modal-sub">القائمة هي الوعاء اللي بيجمع قواعد التسعير</div>
                </div>
                <button type="button" class="pxl-modal-x" @onclick="() => _listOpen = false" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/></svg>
                </button>
            </div>

            <div class="pxl-modal-body">
                <div class="pxl-form">
                    <div class="pxl-field">
                        <label class="pxl-label">كود القائمة <span class="pxl-req">*</span></label>
                        <input type="text" class="pxl-input" @bind="_lf.PriceListCode" placeholder="PL-2026-01" />
                    </div>
                    <div class="pxl-field">
                        <label class="pxl-label">الاسم العربي <span class="pxl-req">*</span></label>
                        <input type="text" class="pxl-input" @bind="_lf.NameAr" placeholder="أسعار عملاء الإسكندرية" />
                    </div>
                    <div class="pxl-field">
                        <label class="pxl-label">الاسم الإنجليزي</label>
                        <input type="text" class="pxl-input" @bind="_lf.NameEn" placeholder="Alexandria rates" />
                    </div>
                    <div class="pxl-field">
                        <label class="pxl-label">سارية من <span class="pxl-req">*</span></label>
                        <input type="date" class="pxl-input" value="@_lf.ValidFrom" @onchange="e => _lf.ValidFrom = e.Value?.ToString()" />
                    </div>
                    <div class="pxl-field">
                        <label class="pxl-label">سارية لغاية</label>
                        <input type="date" class="pxl-input" value="@_lf.ValidTo" @onchange="e => _lf.ValidTo = e.Value?.ToString()" />
                        <span class="pxl-hint">فاضية = مفتوحة من غير نهاية</span>
                    </div>
                </div>
            </div>

            <div class="pxl-modal-foot">
                @if (!string.IsNullOrEmpty(_msg))
                {
                    <span class="pxl-foot-msg @(_ok ? "ok" : "err")">@_msg</span>
                }
                <span class="pxl-foot-spacer"></span>
                <button type="button" class="pxl-btn" @onclick="() => _listOpen = false">إلغاء</button>
                <button type="button" class="pxl-btn pxl-btn-primary" @onclick="SaveListAsync" disabled="@_saving">
                    @(_saving ? "جاري الحفظ..." : "حفظ القائمة")
                </button>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════
   محرر قاعدة التسعير
═══════════════════════════════════════════ *@
@if (_ruleOpen && CanCreate && _sel is not null)
{
    <div class="pxl-backdrop" @onclick="() => _ruleOpen = false">
        <div class="pxl-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="pxl-modal-head">
                <div>
                    <div class="pxl-modal-title">@(_ruleEditId is null ? "قاعدة تسعير جديدة" : "تعديل قاعدة التسعير")</div>
                    <div class="pxl-modal-sub">في قائمة: @_selName</div>
                </div>
                <button type="button" class="pxl-modal-x" @onclick="() => _ruleOpen = false" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/></svg>
                </button>
            </div>

            <div class="pxl-modal-body">

                <div class="pxl-sec">
                    <div class="pxl-sec-head"><span class="pxl-sec-n">1</span> لمين القاعدة؟</div>
                    <div class="pxl-form">
                        <div class="pxl-field">
                            <label class="pxl-label">العميل</label>
                            <select class="pxl-input" @bind="_rf.CustomerId">
                                <option value="0">— بدون عميل (تعريفة عامة) —</option>
                                @foreach (var c in _customers) { <option value="@c.Id">@c.Label</option> }
                            </select>
                            <span class="pxl-hint">من غير عميل = تعريفة عامة بتطبق على كل العملاء</span>
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">الخدمة <span class="pxl-req">*</span></label>
                            <select class="pxl-input @(_rf.ServiceId <= 0 && _triedSave ? "pxl-err" : "")" @bind="_rf.ServiceId">
                                <option value="0">— اختر الخدمة —</option>
                                @foreach (var s in _services) { <option value="@s.Id">@s.Label</option> }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="pxl-sec">
                    <div class="pxl-sec-head"><span class="pxl-sec-n">2</span> الأبعاد — سيبها فاضية عشان القاعدة تطبق على أي قيمة</div>
                    <div class="pxl-form">
                        <div class="pxl-field">
                            <label class="pxl-label">ميناء التحميل</label>
                            <select class="pxl-input" value="@_rf.PortId" @onchange="e => _rf.PortId = Nul(e.Value)">
                                <option value="">— أي ميناء —</option>
                                @foreach (var p in _ports) { <option value="@p.Id">@p.Label</option> }
                            </select>
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">الوجهة</label>
                            <select class="pxl-input" value="@_rf.DestinationId" @onchange="e => _rf.DestinationId = Nul(e.Value)">
                                <option value="">— أي وجهة —</option>
                                @foreach (var d in _dests) { <option value="@d.Id">@d.Label</option> }
                            </select>
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">ميناء التعتيق</label>
                            <select class="pxl-input" value="@_rf.TahteeqPortId" @onchange="e => _rf.TahteeqPortId = Nul(e.Value)">
                                <option value="">— أي ميناء —</option>
                                @foreach (var p in _ports) { <option value="@p.Id">@p.Label</option> }
                            </select>
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">نوع الحاوية</label>
                            <select class="pxl-input" value="@_rf.ContainerTypeId" @onchange="e => _rf.ContainerTypeId = Nul(e.Value)">
                                <option value="">— أي نوع —</option>
                                @foreach (var c in _ctypes) { <option value="@c.Id">@c.Label</option> }
                            </select>
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">نوع الرحلة</label>
                            <select class="pxl-input" value="@_rf.TripTypeId" @onchange="e => _rf.TripTypeId = Nul(e.Value)">
                                <option value="">— أي نوع —</option>
                                @foreach (var t in _ttypes) { <option value="@t.Id">@t.Label</option> }
                            </select>
                        </div>
                        <div class="pxl-field pxl-field-wide">
                            <div class="pxl-margin @((_rf.UnitPrice - (_rf.CostPrice ?? 0)) >= 0 ? "up" : "down")">
                                <span class="pxl-margin-k">هامش الربح المتوقع</span>
                                <span class="pxl-margin-v">@((_rf.UnitPrice - (_rf.CostPrice ?? 0)).ToString("N2")) ج.م</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pxl-sec">
                    <div class="pxl-sec-head"><span class="pxl-sec-n">3</span> السعر والصلاحية</div>
                    <div class="pxl-form">
                        <div class="pxl-field">
                            <label class="pxl-label">سعر البيع <span class="pxl-req">*</span></label>
                            <input type="number" min="0" step="0.01" class="pxl-input" value="@_rf.UnitPrice" @onchange="e => _rf.UnitPrice = Dec(e.Value)" />
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">التكلفة</label>
                            <input type="number" min="0" step="0.01" class="pxl-input" value="@_rf.CostPrice" @onchange="e => _rf.CostPrice = Dec(e.Value)" />
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">نسبة الضريبة</label>
                            <select class="pxl-input" value="@_rf.TaxRateId" @onchange="e => _rf.TaxRateId = Nul(e.Value)">
                                <option value="">— بدون —</option>
                                @foreach (var x in _taxRates) { <option value="@x.Id">@x.Label</option> }
                            </select>
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">الأولوية</label>
                            <input type="number" min="1" max="9999" step="1" class="pxl-input" value="@_rf.Priority" @onchange="e => _rf.Priority = (int)Lng(e.Value)" />
                            <span class="pxl-hint">الرقم الأقل = أولوية أعلى</span>
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">سارية من <span class="pxl-req">*</span></label>
                            <input type="date" class="pxl-input" value="@_rf.ValidFrom" @onchange="e => _rf.ValidFrom = e.Value?.ToString()" />
                        </div>
                        <div class="pxl-field">
                            <label class="pxl-label">سارية لغاية</label>
                            <input type="date" class="pxl-input" value="@_rf.ValidTo" @onchange="e => _rf.ValidTo = e.Value?.ToString()" />
                        </div>
                        <div class="pxl-field pxl-field-wide">
                            <label class="pxl-label">ملاحظات</label>
                            <textarea class="pxl-input pxl-textarea" rows="2" maxlength="500" @bind="_rf.Notes" placeholder="أي ملاحظات على القاعدة..."></textarea>
                        </div>
                        <div class="pxl-field pxl-field-wide">
                            <label class="pxl-switch">
                                <input type="checkbox" @bind="_rf.IsActive" />
                                <span class="pxl-switch-box" aria-hidden="true"></span>
                                <span class="pxl-switch-txt">القاعدة مفعّلة <small>لو مقفولة مش هتطبق على أي عملية</small></span>
                            </label>
                        </div>
                    </div>
                </div>

            </div>

            <div class="pxl-modal-foot">
                @if (!string.IsNullOrEmpty(_msg))
                {
                    <span class="pxl-foot-msg @(_ok ? "ok" : "err")">@_msg</span>
                }
                <span class="pxl-foot-spacer"></span>
                <button type="button" class="pxl-btn" @onclick="() => _ruleOpen = false">إلغاء</button>
                <button type="button" class="pxl-btn pxl-btn-primary" @onclick="SaveRuleAsync" disabled="@_saving">
                    @(_saving ? "جاري الحفظ..." : "حفظ القاعدة")
                </button>
            </div>
        </div>
    </div>
}


@* ═══════════════════════════════════════════
   ⚡ GLOW FAB — التزام كامل بالـ Markup لـ app.css ومحاذاة RTL والـ z-index
═══════════════════════════════════════════ *@
@if (CanCreate && !_loading)
{
    @if (_fabOpen)
    {
        <div class="fc-fab-scrim" @onclick="CloseFab"></div>
    }

    <div class="fc-fab-container">
        <div class="fc-fab-menu @(_fabOpen ? "is-open" : "")" role="menu">
            <button type="button" class="fc-fab-item" role="menuitem" @onclick="NewList">
                <span class="fc-fab-icon"><MudIcon Icon="@Icons.Material.Filled.LibraryAdd" Size="Size.Small" /></span>
                <span class="fc-fab-label">قائمة أسعار جديدة</span>
            </button>
            @if (_sel is not null)
            {
                <button type="button" class="fc-fab-item" role="menuitem" @onclick="NewRule">
                    <span class="fc-fab-icon"><MudIcon Icon="@Icons.Material.Filled.AddCard" Size="Size.Small" /></span>
                    <span class="fc-fab-label">قاعدة سعر جديدة</span>
                </button>
            }
            <button type="button" class="fc-fab-item" role="menuitem" @onclick="LoadListsAsync">
                <span class="fc-fab-icon"><MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /></span>
                <span class="fc-fab-label">تحديث البيانات</span>
            </button>
        </div>

        @* زر الـ FAB المطور مع وميض ذهبي وهالة دائرية دائمين وجاذبين للبصر *@
        <div class="fc-glow-gold-wrapper">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="fc-fab-main fc-glow-gold @(_fabOpen ? "is-open" : "")" @onclick="ToggleFab" aria-label="التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" class="fc-fab-svg">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    </div>
}

<style>
    /* ════════════════════════════════════════════════════════
       🏢 HERO & BODY AND BASIC WRAPPER (RTL fluid 2026)
    ════════════════════════════════════════════════════════ */
    .hero-wrapper {
        padding: 16px clamp(14px, 2.4vw, 34px) 0;
        max-width: var(--fc-page-w);
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow:
            0 12px 32px rgba(13, 38, 84, 0.15),
            0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .fc-hero-title-slim {
        font-size: clamp(18px, 2vw, 24px) !important;
        margin: 0 !important;
    }

    .doc-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .doc-hero-left {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .doc-hero-crumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 10.5px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 2px;
    }

    .doc-hero-sub {
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.55);
        font-weight: 600;
    }

    .doc-hero-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .doc-hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: rgba(255, 255, 255, 0.7);
        font-size: 10.5px;
        font-weight: 700;
        font-family: "Inter", Arial, sans-serif;
        white-space: nowrap;
    }

    .doc-chip-warn {
        background: rgba(239, 68, 68, 0.15) !important;
        border-color: rgba(239, 68, 68, 0.35) !important;
        color: #fca5a5 !important;
    }

    /* KPIs Row */
    .doc-kpis-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-top: 12px;
    }

    .doc-kpi {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(12px);
        border-radius: 10px;
        padding: 10px 12px;
    }

    .doc-kpi-inner { display: flex; align-items: center; gap: 10px; }

    .doc-kpi-icon {
        width: 34px; height: 34px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .doc-kpi-blue .doc-kpi-icon  { background: rgba(125, 211, 252, 0.15); color: #7dd3fc; }
    .doc-kpi-red .doc-kpi-icon   { background: rgba(252, 165, 165, 0.15); color: #fca5a5; }
    .doc-kpi-gold .doc-kpi-icon  { background: rgba(252, 211, 77, 0.15);  color: #fcd34d; }
    .doc-kpi-green .doc-kpi-icon { background: rgba(110, 231, 183, 0.15); color: #6ee7b7; }

    .doc-kpi-data { flex: 1; min-width: 0; }
    .doc-kpi-num { font-family: "Inter", Arial, sans-serif; font-size: 18px; font-weight: 900; color: #fff; line-height: 1; }
    .doc-kpi-label { font-size: 10.5px; font-weight: 700; color: rgba(255, 255, 255, 0.6); margin-top: 3px; }

    /* ── الـ Overlap لحماية الهيرو والتأكد من عدم تغطية المحتوى ── */
    .fc-overlap {
        margin-top: 20px !important;
        position: relative;
        z-index: 2;
    }

    /* ── Body Main Card ── */
    .doc-body {
        padding: 18px clamp(16px, 3vw, 40px) 100px;
        max-width: var(--fc-page-w);
        margin-inline: auto;
        box-sizing: border-box;
        width: 100%;
        position: relative;
        z-index: 2;
    }

    /* ════════════════════════════════════════════════════════
       ⚡ GLOW FAB — التزام كامل بالـ Markup لـ app.css ومحاذاة RTL والـ z-index
    ════════════════════════════════════════════════════════ */
    .fc-fab-scrim {
        position: fixed !important;
        inset: 0 !important;
        z-index: 1290 !important; /* Below container */
        background: rgba(10, 29, 50, 0.4) !important;
        backdrop-filter: blur(4px) !important;
        -webkit-backdrop-filter: blur(4px) !important;
    }

    .fc-fab-container {
        position: fixed !important;
        bottom: 24px !important;
        left: 24px !important;
        right: auto !important; /* Ensure LTR/RTL doesn't push it to right */
        top: auto !important; /* Break vertical center alignment */
        z-index: 1300 !important; /* Above scrim */
        display: flex !important;
        flex-direction: column-reverse !important;
        align-items: flex-start !important;
        gap: 12px !important;
    }

    .fc-glow-gold-wrapper {
        position: relative;
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .glow-halo {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(251, 191, 36, 0.55) 0%,
            rgba(245, 158, 11, 0.35) 40%,
            rgba(245, 158, 11, 0) 75%
        );
        filter: blur(12px);
        animation: glow-breath 2.5s ease-in-out infinite;
        pointer-events: none;
        z-index: 1;
    }

    @@keyframes glow-breath {
        0%, 100% { opacity: 0.7; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.15); }
    }

    .glow-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2.5px solid #fbbf24;
        pointer-events: none;
        opacity: 0;
        z-index: 2;
    }

    .glow-ring-1 { animation: glow-expand 2.4s ease-out infinite; animation-delay: 0s; }
    .glow-ring-2 { animation: glow-expand 2.4s ease-out infinite; animation-delay: 0.8s; }
    .glow-ring-3 { animation: glow-expand 2.4s ease-out infinite; animation-delay: 1.6s; }

    @@keyframes glow-expand {
        0% { opacity: 0.8; transform: scale(1); border-width: 3px; }
        60% { opacity: 0.4; }
        100% { opacity: 0; transform: scale(2); border-width: 1px; }
    }

    .fc-fab-main.fc-glow-gold {
        position: relative;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: 2.5px solid #fbbf24 !important;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        background: linear-gradient(135deg, var(--fc-blue) 0%, var(--fc-navy) 100%) !important;
        color: #fff;
        box-shadow:
            0 8px 24px rgba(30, 110, 245, 0.5),
            0 4px 12px rgba(251, 191, 36, 0.35),
            inset 0 1px 0 rgba(255, 255, 255, 0.3);
        transition: transform 0.25s cubic-bezier(0.34, 1.3, 0.64, 1);
        z-index: 3;
    }

    .fc-fab-main.fc-glow-gold:hover {
        transform: scale(1.08);
    }

    .fc-fab-main.fc-glow-gold:active {
        transform: scale(0.94);
    }

    .fc-fab-main.fc-glow-gold.is-open {
        background: linear-gradient(135deg, var(--fc-error) 0%, #991b1b) !important;
        border-color: #fca5a5 !important;
        box-shadow:
            0 8px 24px rgba(214, 69, 69, 0.5),
            0 4px 12px rgba(252, 165, 165, 0.35) !important;
    }

    /* ── Responsive ── */
    @@media (max-width: 1024px) {
        .doc-kpis-row { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 680px) {
        .hero-wrapper { padding: 12px 12px 0; }
        .hero-wrapper .fc-hero { border-radius: 16px !important; }
        .doc-hero-chip:first-child { display: none; }
        .doc-body { padding: 14px 12px 96px; }
        .fc-overlap { margin-top: 14px !important; }
    }

    @@media (max-width: 480px) {
        .doc-kpis-row { grid-template-columns: 1fr 1fr; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .glow-halo, .glow-ring { animation: none; }
        .glow-halo { opacity: 0.5; }
    }


    /* ================================================================
       #85 — شاشة قوائم الأسعار: عائلة pxl-* (الشاشة مكتفية ذاتيًا)
       الهوية: كحلي #0A1B3B · أزرق #1e6ef5 · دهبي #E8A317 · أخضر #0e9f6e · أحمر #e02424
    ================================================================ */
    .pxl-grid {
        display: grid;
        grid-template-columns: 296px minmax(0, 1fr);
        gap: 16px;
        align-items: start;
    }

