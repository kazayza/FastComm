@page "/invoices/print/{Id:long}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject CompanyService Company
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>طباعة فاتورة — فاست كوم</PageTitle>


@* ── Toolbar (No Print) ── *@
<div class="print-toolbar no-print">
    <button class="tb-back-btn" @onclick="Back">
        <svg viewBox="0 0 24 24" width="16" height="16"
             fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        رجوع
    </button>
    <div class="tb-info">
        @if (_e is not null)
        {
            <span class="tb-inv-num">@_e.Invoice.InvoiceNumber</span>
            <span class="tb-sep">·</span>
            <span class="tb-cust">@_e.Invoice.CustomerName</span>
        }
    </div>
    <button class="tb-print-btn" @onclick="Print">
        <svg viewBox="0 0 24 24" width="16" height="16"
             fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 6 2 18 2 18 9"/>
            <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
            <rect x="6" y="14" width="12" height="8"/>
        </svg>
        طباعة الفاتورة
    </button>
</div>


@* ── Main Content ── *@
@if (_loading)
{
    <div class="print-loading no-print">
        <div class="print-spinner"></div>
        <span>جاري تحميل الفاتورة...</span>
    </div>
}
else if (_e is null)
{
    <div class="print-error no-print">
        <svg viewBox="0 0 24 24" width="32" height="32"
             fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="12" cy="12" r="10"/>
            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
        </svg>
        <p>الفاتورة مش موجودة</p>
    </div>
}
else
{
    @* ═══════════════════════════════════════
       INVOICE SHEET
    ═══════════════════════════════════════ *@
    <div class="invoice-sheet" dir="rtl">

        @* ── HEADER ── *@
        <div class="inv-header">

            @* Company Info — RIGHT (في الـ RTL ده اليمين الفعلي) *@
            <div class="inv-company-block">
                <div class="inv-company-name">@_co.DisplayName</div>
                <div class="inv-company-details">
                    @if (!string.IsNullOrWhiteSpace(_co.TaxNumber) && _co.TaxNumber != "000000000")
                    {
                        <div class="inv-co-row">
                            <span class="inv-co-label">الرقم الضريبي</span>
                            <span class="inv-co-val" dir="ltr">@_co.TaxNumber</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_co.AddressAr))
                    {
                        <div class="inv-co-row">
                            <span class="inv-co-label">العنوان</span>
                            <span class="inv-co-val">@_co.AddressAr</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_co.Phone))
                    {
                        <div class="inv-co-row">
                            <span class="inv-co-label">التليفون</span>
                            <span class="inv-co-val" dir="ltr">@_co.Phone</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_co.Email))
                    {
                        <div class="inv-co-row">
                            <span class="inv-co-label">البريد</span>
                            <span class="inv-co-val" dir="ltr">@_co.Email</span>
                        </div>
                    }
                </div>
            </div>

            @* Center — Invoice Title *@
            <div class="inv-title-block">
                <div class="inv-doc-title">@DocTitle</div>
                <div class="inv-doc-number">@_e.Invoice.InvoiceNumber</div>
                <div class="@TaxBadgeCls">@TaxBadgeText</div>
            </div>

            @* Logo — LEFT (في الـ RTL ده اليسار الفعلي) *@
            <div class="inv-logo-block">
                @if (!string.IsNullOrWhiteSpace(_co.LogoPath))
                {
                    <img src="@_co.LogoPath"
                         alt="@_co.DisplayName"
                         class="inv-logo-img" />
                }
                else
                {
                    <div class="inv-logo-placeholder">
                        <svg viewBox="0 0 48 48" width="48" height="48"
                             fill="none" stroke="currentColor" stroke-width="1.5">
                            <rect x="4" y="4" width="40" height="40" rx="6"/>
                            <circle cx="17" cy="18" r="4"/>
                            <path d="M44 34L32 22 20 34 12 26 4 34"/>
                        </svg>
                    </div>
                }
            </div>

        </div>

        @* ── HEADER DIVIDER ── *@
        <div class="inv-header-divider">
            <div class="inv-divider-line"></div>
        </div>


        @* ── INVOICE META ── *@
        <div class="inv-meta-row">

            @* بيانات العميل *@
            <div class="inv-meta-block customer-block">
                <div class="inv-meta-title">فاتورة إلى</div>
                <div class="inv-meta-customer">@_e.Invoice.CustomerName</div>
                @if (_e.Invoice.CustomerTaxNumber is not null)
                {
                    <div class="inv-meta-detail">
                        <span class="inv-detail-label">الرقم الضريبي:</span>
                        <span dir="ltr">@_e.Invoice.CustomerTaxNumber</span>
                    </div>
                }
            </div>

            @* تفاصيل الفاتورة *@
            <div class="inv-meta-block details-block">
                <table class="inv-details-table">
                    <tbody>
                        <tr>
                            <td class="inv-detail-key">تاريخ الإصدار</td>
                            <td class="inv-detail-val" dir="ltr">@_e.Invoice.InvoiceDate</td>
                        </tr>
                        <tr>
                            <td class="inv-detail-key">تاريخ الاستحقاق</td>
                            <td class="inv-detail-val" dir="ltr">@(_e.Invoice.DueDate ?? "—")</td>
                        </tr>
                        <tr>
                            <td class="inv-detail-key">الحالة</td>
                            <td class="inv-detail-val">
                                <span class="inv-status-badge status-@_e.Invoice.Status.ToLower()">
                                    @StatusAr(_e.Invoice.Status)
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="inv-detail-key">العملة</td>
                            <td class="inv-detail-val" dir="ltr">@_e.Invoice.CurrencyCode</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>

        @* Credit Note Notice *@
        @if (_e.Invoice.OriginalInvoiceNumber is not null)
        {
            <div class="inv-credit-notice">
                <svg viewBox="0 0 20 20" width="16" height="16"
                     fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="10" cy="10" r="8"/>
                    <path d="M10 7v3M10 13h.01" stroke-linecap="round"/>
                </svg>
                هذا إشعار دائن على الفاتورة رقم
                <strong>@_e.Invoice.OriginalInvoiceNumber</strong>
            </div>
        }


        @* ── ITEMS TABLE ── *@
        <table class="inv-items-table">
            <thead>
                <tr>
                    <th class="col-num">#</th>
                    <th class="col-desc">البيان</th>
                    <th class="col-qty">الكمية</th>
                    <th class="col-price">سعر الوحدة</th>
                    <th class="col-disc">الخصم</th>
                    <th class="col-tax">الضريبة</th>
                    <th class="col-total">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var rowIdx = 0;
                }
                @foreach (var l in _e.Items)
                {
                    rowIdx++;
                    <tr class="@(rowIdx % 2 == 0 ? "row-alt" : "")">
                        <td class="col-num">@rowIdx</td>
                        <td class="col-desc">
                            <div class="item-desc">@l.Description</div>
                            @if (l.OperationNumber is not null)
                            {
                                <div class="item-op">@l.OperationNumber</div>
                            }
                        </td>
                        <td class="col-qty num-cell" dir="ltr">@l.Quantity.ToString("0.###")</td>
                        <td class="col-price num-cell" dir="ltr">@Money(l.UnitPrice)</td>
                        <td class="col-disc num-cell" dir="ltr">@Money(l.Discount)</td>
                        <td class="col-tax num-cell" dir="ltr">@l.TaxRate.ToString("0.##")%</td>
                        <td class="col-total num-cell bold-cell" dir="ltr">@Money(l.LineTotal)</td>
                    </tr>
                }
                @if (!_e.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-row">لا توجد بنود</td>
                    </tr>
                }
            </tbody>
        </table>


        @* ── TOTALS ── *@
        <div class="inv-totals-section">

            @* Notes — LEFT *@
            <div class="inv-notes-area">
                @if (_e.Invoice.Notes is not null)
                {
                    <div class="inv-notes-label">ملاحظات</div>
                    <div class="inv-notes-text">@_e.Invoice.Notes</div>
                }
            </div>

            @* Totals — RIGHT *@
            <div class="inv-totals-box">
                <div class="total-row">
                    <span class="total-label">المجموع قبل الضريبة</span>
                    <span class="total-val" dir="ltr">@Money(_e.Invoice.SubTotal)</span>
                </div>
                @if (_e.Invoice.DiscountTotal > 0)
                {
                    <div class="total-row">
                        <span class="total-label">الخصم الإجمالي</span>
                        <span class="total-val discount-val" dir="ltr">(@Money(_e.Invoice.DiscountTotal))</span>
                    </div>
                }
                <div class="total-row">
                    <span class="total-label">الضريبة</span>
                    <span class="total-val" dir="ltr">@Money(_e.Invoice.TaxTotal)</span>
                </div>
                <div class="total-divider"></div>
                <div class="total-row total-grand">
                    <span class="total-label">الإجمالي المستحق</span>
                    <span class="total-val grand-val" dir="ltr">
                        @Money(_e.Invoice.GrandTotal)
                        <small>@_e.Invoice.CurrencyCode</small>
                    </span>
                </div>
                @if (_e.Invoice.PaidAmount > 0)
                {
                    <div class="total-divider dashed"></div>
                    <div class="total-row">
                        <span class="total-label">المسدّد</span>
                        <span class="total-val paid-val" dir="ltr">@Money(_e.Invoice.PaidAmount)</span>
                    </div>
                    <div class="total-row @(_e.Invoice.Due > 0 ? "due-row" : "settled-row")">
                        <span class="total-label">المتبقي</span>
                        <span class="total-val" dir="ltr">@Money(_e.Invoice.Due)</span>
                    </div>
                }
            </div>

        </div>


        @* ── FOOTER ── *@
        <div class="inv-footer">
            <div class="inv-footer-left">
                <div class="inv-footer-company">@_co.DisplayName</div>
                @if (!string.IsNullOrWhiteSpace(_co.AddressAr))
                {
                    <div class="inv-footer-detail">@_co.AddressAr</div>
                }
            </div>
            <div class="inv-footer-center">
                @if (!string.IsNullOrWhiteSpace(_co.LogoPath))
                {
                    <img src="@_co.LogoPath" class="inv-footer-logo" alt="" aria-hidden="true" />
                }
            </div>
            <div class="inv-footer-right">
                <div class="inv-footer-detail">طُبعت في @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                <div class="inv-footer-detail">@_e.Invoice.InvoiceNumber</div>
            </div>
        </div>

    </div>
}


@* ═══════════════════════════════════════
   CSS
═══════════════════════════════════════ *@
<style>

    /* ================================================================
       NO PRINT TOOLBAR
    ================================================================ */
    .print-toolbar {
        display: flex; align-items: center; gap: 14px;
        padding: 14px 24px;
        background: #fff; border-bottom: 1px solid #e4eaf3;
        position: sticky; top: 0; z-index: 100;
        box-shadow: 0 2px 8px rgba(15,41,82,.06);
    }

    .tb-back-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 14px;
        border: 1px solid #d8e2f0; border-radius: 8px;
        background: #fff; color: #6b7d95;
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .tb-back-btn:hover { background: #f0f4fa; color: #1c2c44; }
    .tb-back-btn svg  { transform: rotate(180deg); }

    .tb-info { display: flex; align-items: center; gap: 8px; flex: 1; }
    .tb-inv-num { font-size: 14px; font-weight: 900; color: #1c2c44; font-family: "Inter", Arial, sans-serif; }
    .tb-sep  { color: #c0ccd8; }
    .tb-cust { font-size: 13px; color: #6b7d95; }

    .tb-print-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 20px;
        border: 0; border-radius: 9px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 12px rgba(30,110,245,.28);
        transition: all .15s ease;
    }
    .tb-print-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(30,110,245,.36); }

    /* ================================================================
       LOADING / ERROR
    ================================================================ */
    .print-loading {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 14px; min-height: 300px;
        color: #6b7d95; font-size: 13px; font-weight: 600;
    }

    .print-spinner {
        width: 36px; height: 36px;
        border: 3px solid #dde5f0; border-top-color: #1e6ef5;
        border-radius: 50%; animation: spin .75s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .print-error {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 200px;
        color: #e03048; font-size: 14px; font-weight: 600;
    }

    /* ================================================================
       INVOICE SHEET — A4 Proportions
    ================================================================ */
    .invoice-sheet {
        width: 210mm;
        min-height: 297mm;
        margin: 24px auto;
        background: #fff;
        padding: 14mm 16mm 12mm;
        box-shadow:
            0 4px 20px rgba(15,41,82,.08),
            0 20px 60px rgba(15,41,82,.06);
        border-radius: 4px;
        font-family: "Cairo", "Tajawal", "Times New Roman", Arial, sans-serif;
        font-size: 9pt;
        color: #1c2c44;
        position: relative;
    }

    /* ================================================================
       HEADER — 3 Columns: Company | Title | Logo
    ================================================================ */
    .inv-header {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 16px;
        align-items: flex-start;
        margin-bottom: 10px;
    }

    /* Company — RIGHT in RTL */
    .inv-company-block { text-align: right; }

    .inv-company-name {
        font-size: 16pt;
        font-weight: 900;
        color: #0f2952;
        line-height: 1.2;
        margin-bottom: 8px;
    }

    .inv-company-details { display: flex; flex-direction: column; gap: 3px; }

    .inv-co-row {
        display: flex; align-items: center;
        justify-content: flex-end;
        gap: 6px; font-size: 8pt; color: #5a6e88;
    }

    .inv-co-label {
        font-weight: 700; color: #8899ae;
        white-space: nowrap;
    }

    .inv-co-val { color: #344258; }

    /* Title — CENTER */
    .inv-title-block {
        text-align: center;
        display: flex; flex-direction: column;
        align-items: center; gap: 6px;
        padding-top: 4px;
    }

    .inv-doc-title {
        font-size: 18pt;
        font-weight: 900;
        color: #0f2952;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .inv-doc-number {
        font-size: 11pt;
        font-weight: 800;
        color: #1e6ef5;
        font-family: "Inter", "Courier New", monospace;
        background: #eaf1ff;
        padding: 3px 14px;
        border-radius: 20px;
        border: 1px solid #c0d4fb;
    }

    .fc-doc-tax {
        font-size: 8pt; font-weight: 800;
        padding: 2px 12px; border-radius: 12px;
    }

    .is-tax    { background: #e9f8f0; color: #0d8a48; border: 1px solid #b0e0c5; }
    .is-nontax { background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }

    /* Logo — LEFT in RTL */
    .inv-logo-block {
        display: flex;
        align-items: flex-start;
        justify-content: flex-end; /* في الـ RTL: flex-end = اليسار الفعلي */
    }

    .inv-logo-img {
        max-width: 120px;
        max-height: 80px;
        object-fit: contain;
        display: block;
    }

    .inv-logo-placeholder {
        width: 90px; height: 70px;
        display: flex; align-items: center; justify-content: center;
        border: 2px dashed #dde5f0;
        border-radius: 8px; color: #c0ccd8;
    }

    /* ================================================================
       HEADER DIVIDER
    ================================================================ */
    .inv-header-divider { margin: 10px 0; }

    .inv-divider-line {
        height: 2.5px;
        background: linear-gradient(90deg, #0f2952 0%, #1e6ef5 50%, #0f2952 100%);
        border-radius: 2px;
    }

    /* ================================================================
       META ROW
    ================================================================ */
    .inv-meta-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 20px;
        margin: 12px 0;
        padding: 12px 14px;
        background: #f8fafd;
        border: 1px solid #e4eaf3;
        border-radius: 8px;
    }

    .inv-meta-block {}
    .customer-block {}
    .details-block {}

    .inv-meta-title {
        font-size: 8pt; font-weight: 800; color: #8899ae;
        text-transform: uppercase; letter-spacing: .5px;
        margin-bottom: 4px;
    }

    .inv-meta-customer {
        font-size: 13pt; font-weight: 900; color: #1c2b43;
        margin-bottom: 4px;
    }

    .inv-meta-detail {
        font-size: 8pt; color: #6b7d95;
        display: flex; align-items: center; gap: 6px;
    }

    .inv-detail-label { font-weight: 700; color: #8899ae; }

    /* Details Table */
    .inv-details-table { border-collapse: collapse; min-width: 220px; }

    .inv-details-table tr + tr .inv-detail-key,
    .inv-details-table tr + tr .inv-detail-val { padding-top: 5px; }

    .inv-detail-key {
        font-size: 8pt; font-weight: 700; color: #8899ae;
        padding-left: 16px; text-align: right; white-space: nowrap;
    }

    .inv-detail-val {
        font-size: 9pt; font-weight: 800; color: #1c2b43;
        text-align: left; padding-right: 0;
    }

    .inv-status-badge {
        display: inline-flex; padding: 2px 8px; border-radius: 10px;
        font-size: 7.5pt; font-weight: 800;
    }

    .status-issued    { background: #fff8e6; color: #9a6d08; border: 1px solid #f0d898; }
    .status-approved  { background: #eaf1ff; color: #1558d6; border: 1px solid #c0d4fb; }
    .status-sent      { background: #f3eeff; color: #7c4dbd; border: 1px solid #d0bfef; }
    .status-draft     { background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }
    .status-cancelled { background: #fff0f2; color: #e03048; border: 1px solid #ffc8cf; }

    /* ================================================================
       CREDIT NOTE NOTICE
    ================================================================ */
    .inv-credit-notice {
        display: flex; align-items: center; gap: 8px;
        padding: 8px 12px; margin: 8px 0;
        background: #eaf1ff; border: 1px solid #bdd4fc;
        border-radius: 6px;
        font-size: 8.5pt; color: #1558d6; font-weight: 700;
    }

    /* ================================================================
       ITEMS TABLE
    ================================================================ */
    .inv-items-table {
        width: 100%;
        border-collapse: collapse;
        margin: 10px 0;
        font-size: 8.5pt;
    }

    .inv-items-table thead tr {
        background: linear-gradient(135deg, #0f2952, #1a3a6b);
        color: #fff;
    }

    .inv-items-table thead th {
        padding: 9px 8px;
        text-align: center;
        font-weight: 800;
        font-size: 8pt;
        letter-spacing: .3px;
        border: 1px solid #1a3a6b;
    }

    .inv-items-table thead th:first-child { text-align: center; border-radius: 0; }
    .inv-items-table thead .col-desc      { text-align: right; padding-right: 12px; }

    .inv-items-table tbody tr { border-bottom: 1px solid #e8edf5; }
    .inv-items-table tbody tr.row-alt { background: #f8fafd; }
    .inv-items-table tbody tr:hover { background: #f0f5ff; }

    .inv-items-table tbody td {
        padding: 8px 8px;
        vertical-align: middle;
        border: 1px solid #e8edf5;
    }

    .col-num   { text-align: center; width: 28px; color: #8899ae; font-size: 7.5pt; }
    .col-desc  { text-align: right; min-width: 140px; padding-right: 12px !important; }
    .col-qty   { text-align: center; width: 60px; }
    .col-price { text-align: center; width: 90px; }
    .col-disc  { text-align: center; width: 80px; }
    .col-tax   { text-align: center; width: 60px; }
    .col-total { text-align: center; width: 100px; }

    .num-cell { font-family: "Inter", "Courier New", monospace; color: #344258; }

    .bold-cell {
        font-family: "Inter", "Courier New", monospace;
        font-weight: 900; color: #0f2952; font-size: 9.5pt;
    }

    .item-desc { font-weight: 700; color: #1c2b43; }
    .item-op   { font-size: 7pt; color: #8899ae; margin-top: 2px; }

    .empty-row {
        text-align: center; color: #9aaabb;
        padding: 20px; font-style: italic;
    }

    /* ================================================================
       TOTALS SECTION
    ================================================================ */
    .inv-totals-section {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 20px;
        margin-top: 12px;
        align-items: flex-start;
    }

    .inv-notes-area { padding-top: 4px; }

    .inv-notes-label {
        font-size: 8pt; font-weight: 800; color: #8899ae;
        margin-bottom: 6px; text-transform: uppercase; letter-spacing: .5px;
    }

    .inv-notes-text {
        font-size: 8.5pt; color: #5a6e88;
        line-height: 1.6;
        padding: 8px 10px;
        background: #f8fafd;
        border-right: 3px solid #c0d4fb;
        border-radius: 0 6px 6px 0;
        max-width: 260px;
    }

    .inv-totals-box {
        min-width: 230px;
        border: 1.5px solid #e4eaf3;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
    }

    .total-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 7px 14px;
        border-bottom: 1px solid #f0f3f8;
        font-size: 9pt;
    }

    .total-row:last-child { border-bottom: none; }

    .total-label { color: #6b7d95; font-weight: 600; }
    .total-val   { font-family: "Inter", monospace; font-weight: 700; color: #1c2b43; }

    .discount-val { color: #e03048; }
    .paid-val     { color: #16a35b; }

    .total-divider {
        height: 1.5px; background: #e4eaf3; margin: 2px 0;
    }
    .total-divider.dashed { background: repeating-linear-gradient(90deg, #e4eaf3 0, #e4eaf3 6px, transparent 6px, transparent 12px); }

    .total-grand {
        background: linear-gradient(135deg, #0f2952, #1a3a6b) !important;
        border-top: none !important;
    }

    .total-grand .total-label { color: rgba(255,255,255,.85); font-size: 9pt; font-weight: 800; }

    .grand-val {
        font-size: 12pt !important;
        font-weight: 900 !important;
        color: #fff !important;
        display: flex; align-items: baseline; gap: 4px;
    }

    .grand-val small { font-size: 8pt; font-weight: 700; opacity: .8; }

    .due-row      { background: #fff8f8; }
    .due-row .total-val { color: #e03048; font-weight: 900; }

    .settled-row  { background: #f0fdf8; }
    .settled-row .total-val { color: #16a35b; font-weight: 900; }

    /* ================================================================
       FOOTER
    ================================================================ */
    .inv-footer {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        margin-top: 16px;
        padding-top: 10px;
        border-top: 1.5px solid #e4eaf3;
        font-size: 7.5pt;
        color: #8899ae;
    }

    .inv-footer-left  { text-align: right; }
    .inv-footer-right { text-align: left; }
    .inv-footer-center { text-align: center; }

    .inv-footer-company { font-weight: 800; color: #344258; font-size: 8pt; }
    .inv-footer-detail  { color: #8899ae; }

    .inv-footer-logo {
        max-height: 28px; max-width: 80px;
        object-fit: contain; opacity: .6;
    }

    /* ================================================================
       PRINT STYLES
    ================================================================ */
    @@media print {

        .no-print { display: none !important; }

        body {
            margin: 0; padding: 0;
            background: #fff !important;
        }

        .invoice-sheet {
            width: 100%;
            min-height: auto;
            margin: 0;
            padding: 10mm 12mm;
            box-shadow: none !important;
            border-radius: 0;
        }

        .inv-items-table { page-break-inside: avoid; }

        .inv-totals-section { page-break-inside: avoid; }

        .inv-footer { page-break-inside: avoid; }

        .row-alt { background: #f8fafd !important; -webkit-print-color-adjust: exact; }

        .inv-items-table thead tr { -webkit-print-color-adjust: exact; }

        .total-grand { -webkit-print-color-adjust: exact; }
    }

    @@media screen and (max-width: 240mm) {
        .invoice-sheet { width: 100%; margin: 10px auto; padding: 14px; }
        .inv-header     { grid-template-columns: 1fr auto; }
        .inv-logo-block { display: none; }
        .inv-totals-section { grid-template-columns: 1fr; }
        .inv-footer { grid-template-columns: 1fr; }
        .inv-footer-center { display: none; }
    }

