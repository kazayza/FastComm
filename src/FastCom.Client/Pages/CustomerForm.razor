@page "/customers/new"
@page "/customers/new/{Id:int}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "تسجيل عميل جديد" : "تعديل بيانات العميل") — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="pay-hero-row">
                <div class="pay-hero-left">
                    <div class="pay-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        <span>البيانات الأساسية · الشركاء والأطراف</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">
                        @if (_id is null)
                        {
                            <span>تسجيل عميل جديد</span>
                        }
                        else
                        {
                            <span>@_f.NameAr</span>
                        }
                    </h1>
                    <span class="pay-hero-sub">
                        @(_id is null ? "إدخال شريك تجاري جديد وتحديد تصنيفه وهويته القانونية والمالية" : "تحديث الهوية التجارية، التراخيص، وإدارة جهات الاتصال المقترنة بحساب العميل")
                    </span>
                </div>

                <div class="pay-hero-right">
                    <button type="button" class="pay-hero-refresh" @onclick="GoBack" title="رجوع للقائمة">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    @if (CanSave)
                    {
                        <button type="button" class="pay-hero-add" @onclick="SaveAsync" disabled="@_saving" title="حفظ التغييرات">
                            @if (_saving)
                            {
                                <span class="btn-spinner sm" aria-hidden="true"></span>
                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                    <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                    <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span>حفظ العميل</span>
                            }
                        </button>
                    }
                </div>
            </div>

            @* ── ملخص العميل في حالة التعديل أو خطوات الإنشاء في حالة الإضافة الجديدة ── *@
            @if (_id is not null && !_loading)
            {
                <div class="pay-kpis-strip">
                    <div class="pay-kpi-item">
                        <div class="pay-kpi-icon kpi-blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">الكود التعريفي</div>
                            <div class="pay-kpi-val">@CustomerCode</div>
                        </div>
                    </div>
                    <div class="pay-kpi-div" aria-hidden="true"></div>
                    <div class="pay-kpi-item">
                        <div class="pay-kpi-icon kpi-green">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">طبيعة الحساب</div>
                            <div class="pay-kpi-val kpi-val-green">@(IsCompany ? "شركة ومؤسسة" : "حساب فردي")</div>
                        </div>
                    </div>
                    <div class="pay-kpi-div" aria-hidden="true"></div>
                    <div class="pay-kpi-item">
                        <div class="pay-kpi-icon kpi-blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">السجل الضريبي/القومي</div>
                            <div class="pay-kpi-val">@(IsCompany ? _f.TaxNumber : _f.NationalId)</div>
                        </div>
                    </div>
                    <div class="pay-kpi-div" aria-hidden="true"></div>
                    <div class="pay-kpi-item">
                        <div class="pay-kpi-icon kpi-amber">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="1" x2="12" y2="23"></line>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">سقف الائتمان</div>
                            <div class="pay-kpi-val kpi-val-amber">@Money(_f.CreditLimit) <small>ج.م</small></div>
                        </div>
                    </div>
                </div>
            }
            else if (_id is null && !_loading)
            {
                <div class="cust-steps-bar" aria-label="خطوات تسجيل العميل الجديد">
                    <div class="cust-step-node active">
                        <div class="step-circle">1</div>
                        <div class="step-text-label">البيانات التعريفية والمالية</div>
                    </div>
                    <div class="step-connector-line" aria-hidden="true"></div>
                    <div class="cust-step-node @(_activeTab == 4 ? "active" : "pending")">
                        <div class="step-circle">2</div>
                        <div class="step-text-label">جهات الاتصال والتوزيع</div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY SECTION
═══════════════════════════════════════════ *@
<div class="pay-body">

    @if (!CanSave && !CanViewContacts)
    {
        <div class="pay-state-box">
            <div class="pay-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>@(_id is null ? "ليست لديك الصلاحية الأمنية الكافية لإضافة عملاء جدد." : "ليست لديك الصلاحية الأمنية الكافية لتعديل بيانات هذا العميل.")</p>
            <button class="bottom-back-btn" @onclick="GoBack" type="button">العودة لدليل العملاء</button>
        </div>
    }
    else if (_loading)
    {
        <div class="pay-loading">
            <div class="pay-spinner" aria-label="جاري التحميل"></div>
            <span>جاري تهيئة ملف بيانات الشريك التجاري...</span>
        </div>
    }
    else
    {
        @if (_msg is not null)
        {
            <div class="svc-banner @(_ok ? "svc-banner-ok" : "svc-banner-err")" role="alert" style="margin-bottom: 14px; border-radius: 10px;">
                <div class="svc-banner-ic" aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span class="svc-banner-msg">@_msg</span>
                <button class="svc-banner-x" @onclick="() => _msg = null" type="button">✕</button>
            </div>
        }

        <div class="bk-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="bk-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="bk-mud-tabs">

                @* ── TAB 1: التعريف الأساسي ── *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <span>التعريف الموحد</span>
                            @if (HasTabError(1))
                            {
                                <span class="btab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon blue" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">الهوية والتعريف التجاري</div>
                                    <div class="tab-section-sub">تحديد تصنيف الكيان المالي للعميل، وصيغة الاسم الرسمي</div>
                                </div>
                            </div>

                            <div class="bk-form-grid">

                                @* طبيعة ونوع العميل *@
                                <div class="form-field">
                                    <label class="field-label">طبيعة العميل التشغيلية <span class="field-required">*</span></label>
                                    <div class="type-toggle-group-custom" role="group" aria-label="اختر تصنيف الحساب">
                                        <button type="button" class="type-toggle-btn @(_f.CustomerType == "Company" ? "active-company" : "")" @onclick='() => { if (_id is null) _f.CustomerType = "Company"; }' disabled="@(_id is not null)">
                                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                                <line x1="8" y1="21" x2="16" y2="21"/>
                                            </svg>
                                            مؤسسة / شركة تجارية
                                        </button>
                                        <button type="button" class="type-toggle-btn @(_f.CustomerType == "Individual" ? "active-individual" : "")" @onclick='() => { if (_id is null) _f.CustomerType = "Individual"; }' disabled="@(_id is not null)">
                                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                                <circle cx="12" cy="7" r="4"/>
                                            </svg>
                                            حساب فردي
                                        </button>
                                    </div>
                                    @if (_id is not null)
                                    {
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01"/>
                                            </svg>
                                            التصنيف القانوني مغلق ولا يصح تعديله بعد إتمام الإنشاء
                                        </div>
                                    }
                                </div>

                                @* الاسم بالعربية *@
                                <div class="form-field">
                                    <label class="field-label" for="nameAr">الاسم التجاري (باللغة العربية) <span class="field-required">*</span></label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                                            </svg>
                                        </span>
                                        <input id="nameAr" class="field-input with-prefix @(string.IsNullOrWhiteSpace(_f.NameAr) && _triedSave ? "field-error" : "")" @bind="_f.NameAr" placeholder="اسم العميل أو الكيان كاملاً..." maxlength="200" aria-required="true" />
                                    </div>
                                    @if (string.IsNullOrWhiteSpace(_f.NameAr) && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">الاسم باللغة العربية مطلوب إلزاميًا</div>
                                    }
                                </div>

                                @* الاسم بالإنجليزية *@
                                <div class="form-field">
                                    <label class="field-label" for="nameEn">الاسم التجاري (باللغة الإنجليزية)</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                            </svg>
                                        </span>
                                        <input id="nameEn" class="field-input with-prefix" @bind="_f.NameEn" placeholder="Official english trade name..." maxlength="200" dir="ltr" />
                                    </div>
                                </div>

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>

                @* ── TAB 2: البيانات القانونية والضرائب ── *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <path d="M14 2v6h6M16 13H8M16 17H8" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <span>الرقم الضريبي / القومي</span>
                            @if (HasTabError(2))
                            {
                                <span class="btab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon blue" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                        <line x1="8" y1="21" x2="16" y2="21"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">التراخيص القانونية والمواثيق الرسمية</div>
                                    <div class="tab-section-sub">توفير الرقم الضريبي أو الهوية الوطنية والسجل التجاري لإصدار معاملات الفاتورة الإلكترونية بدقة</div>
                                </div>
                            </div>

                            <div class="bk-form-grid">
                                @if (IsCompany)
                                {
                                    @* الرقم الضريبي *@
                                    <div class="form-field">
                                        <label class="field-label" for="taxNumber">الرقم الضريبي الموحد <span class="field-required">*</span></label>
                                        <div class="field-input-group">
                                            <span class="field-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                                                    <line x1="12" y1="8" x2="12" y2="16"/>
                                                </svg>
                                            </span>
                                            <input id="taxNumber" class="field-input with-prefix @(string.IsNullOrWhiteSpace(_f.TaxNumber) && _triedSave ? "field-error" : "")" @bind="_f.TaxNumber" placeholder="000-000-000" maxlength="50" dir="ltr" aria-required="true" />
                                        </div>
                                        @if (string.IsNullOrWhiteSpace(_f.TaxNumber) && _triedSave)
                                        {
                                            <div class="field-err-msg" role="alert">الرقم الضريبي الموحد إلزامي لشركات المبيعات</div>
                                        }
                                    </div>

                                    @* السجل التجاري *@
                                    <div class="form-field">
                                        <label class="field-label" for="commReg">قيد السجل التجاري</label>
                                        <div class="field-input-group">
                                            <span class="field-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                                    <path d="M14 2v6h6"/>
                                                </svg>
                                            </span>
                                            <input id="commReg" class="field-input with-prefix" @bind="_f.CommercialRegister" placeholder="رقم القيد السجلي..." maxlength="50" dir="ltr" />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @* الرقم القومي *@
                                    <div class="form-field">
                                        <label class="field-label" for="natId"> الرقم القومي<span class="field-required">*</span></label>
                                        <div class="field-input-group">
                                            <span class="field-prefix" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                                    <circle cx="12" cy="7" r="4"/>
                                                </svg>
                                            </span>
                                            <input id="natId" class="field-input with-prefix @(string.IsNullOrWhiteSpace(_f.NationalId) && _triedSave ? "field-error" : "")" @bind="_f.NationalId" placeholder="2991010XXXXXXX" maxlength="14" dir="ltr" aria-required="true" />
                                        </div>
                                        @if (string.IsNullOrWhiteSpace(_f.NationalId) && _triedSave)
                                        {
                                            <div class="field-err-msg" role="alert">رقم الهوية القومية مطلوب للحسابات الفردية</div>
                                        }
                                    </div>
                                }
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>

                @* ── TAB 3: التواصل والعنوان ── *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                                </svg>
                            </div>
                            <span>قنوات ومنافذ التواصل</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon green" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                        <line x1="16" y1="21" x2="8" y2="21"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">بيانات قنوات التواصل الجغرافي</div>
                                    <div class="tab-section-sub">عناوين المراسلات، التليفونات الرسمية، والبريد الإلكتروني للإشعارات المباشرة</div>
                                </div>
                            </div>

                            <div class="bk-form-grid">

                                @* التليفون *@
                                <div class="form-field">
                                    <label class="field-label" for="phone">رقم تليفون المكتب</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-4.99-5 19.79 19.79 0 01-3.07-8.67A2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                                            </svg>
                                        </span>
                                        <input id="phone" class="field-input with-prefix" @bind="_f.Phone" placeholder="02-XXXXXXXX" type="tel" dir="ltr" />
                                    </div>
                                </div>

                                @* البريد *@
                                <div class="form-field">
                                    <label class="field-label" for="email">عنوان البريد الإلكتروني للمراسلات</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                                <path d="M22 6l-10 7L2 6"/>
                                            </svg>
                                        </span>
                                        <input id="email" class="field-input with-prefix" @bind="_f.Email" placeholder="billing@partner.com" type="email" dir="ltr" />
                                    </div>
                                </div>

                                @* المدينة *@
                                <div class="form-field">
                                    <label class="field-label" for="city">الموقع / المدينة الجغرافية</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                                <circle cx="12" cy="10" r="3"/>
                                            </svg>
                                        </span>
                                        <input id="city" class="field-input with-prefix" @bind="_f.CityAr" placeholder="القاهرة، الإسكندرية..." />
                                    </div>
                                </div>

                                @* العنوان *@
                                <div class="form-field form-field-full">
                                    <label class="field-label" for="address">العنوان التفصيلي وموقع التسليم المعتمد</label>
                                    <textarea id="address" class="field-input field-textarea" @bind="_f.AddressAr" rows="2" placeholder="أدخل العنوان بالتفصيل ليتم تضمينه وتوجيهه تلقائياً للمستندات والمطبوعات..."></textarea>
                                </div>

                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>

                @* ── TAB 4: الضوابط الائتمانية وبوابة العملاء ── *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-amber" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="4" width="22" height="16" rx="2"/>
                                    <path d="M1 10h22"/>
                                </svg>
                            </div>
                            <span>الائتمان وبوابة الوصول</span>
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon amber" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="1" x2="12" y2="23"></line>
                                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">إعدادات سقف الائتمان ومحددات الوصول</div>
                                    <div class="tab-section-sub">ضبط السقوف الائتمانية والتحكم بنطاق ولوج بوابة المبيعات للعميل</div>
                                </div>
                            </div>

                            <div class="bk-form-grid">
                                
                                @* حد الائتمان *@
                                <div class="form-field">
                                    <label class="field-label" for="creditLimit">السقف الائتماني للحساب</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix">ج.م</span>
                                        <input id="creditLimit" class="field-input with-prefix" type="number" min="0" step="0.01" value="@_f.CreditLimit" @onchange="e => _f.CreditLimit = ParseAmount(e.Value)" placeholder="0.00" />
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        القيمة (صفر) تعني سقفاً غير مقيد — سيقوم النظام بتحذير الموظفين عند تخطي السقف المحدد مسبقاً
                                    </div>
                                </div>

                            </div>

                            @* ── بوابة الوصول التفاعلية ── *@
                            <div class="portal-toggle-box @(_f.PortalEnabled ? "portal-active" : "")">
                                <div class="portal-toggle-content">
                                    <div class="portal-toggle-icon @(_f.PortalEnabled ? "icon-active" : "")" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                            <line x1="8" y1="21" x2="16" y2="21"/>
                                        </svg>
                                    </div>
                                    <div class="portal-toggle-text">
                                        <div class="portal-toggle-title">تفعيل البوابة الرقمية للعميل</div>
                                        <div class="portal-toggle-sub">تمكين الشريك من تصفح الفواتير الجارية وإيصالات السداد عبر روابط سريعة آمنة</div>
                                    </div>
                                </div>
                                <label class="toggle-switch" aria-label="مفتاح تفعيل بوابة العميل">
                                    <input type="checkbox" @bind="_f.PortalEnabled" role="switch" aria-checked="@_f.PortalEnabled" />
                                    <span class="toggle-track">
                                        <span class="toggle-thumb"></span>
                                    </span>
                                </label>
                            </div>

                            @if (_f.PortalEnabled)
                            {
                                <div class="portal-info-box" role="status">
                                    <div class="portal-info-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                                        </svg>
                                    </div>
                                    <div class="portal-info-text">
                                        <strong>بوابة العميل الرقمية مفعّلة حالياً</strong>
                                        <p>بإمكانك قيد وتوليد روابط الولوج المشتركة والمؤقتة لهذا العميل من كشف حساب قائمة العملاء بعد إتمام الحفظ.</p>
                                    </div>
                                </div>
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>

                @* ── TAB 5: جهات الاتصال المسجلة ── *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-red" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                </svg>
                            </div>
                            <span>جهات الاتصال المقترنة</span>
                            @if (_contacts.Count > 0)
                            {
                                <span class="ctab-count" style="margin-inline-start:4px">@_contacts.Count</span>
                            }
                            @if (_id is null)
                            {
                                <div class="ctab-lock-icon" aria-label="مقفل مؤقتاً">
                                    <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                    </svg>
                                </div>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon red" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <div style="flex:1">
                                    <div class="tab-section-title">جهات الاتصال والممثلين المعتمدين للعميل</div>
                                    <div class="tab-section-sub">
                                        الممثل <strong>الرئيسي</strong> سيتم إدراجه وتعيينه تلقائياً عند فتح وحفظ بوالص التشغيل والحجوزات
                                    </div>
                                </div>
                                @if (_id is not null && CanEditContacts)
                                {
                                    <button type="button" class="add-contact-btn" @onclick="OpenNewContact">
                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                        </svg>
                                        إضافة جهة اتصال
                                    </button>
                                }
                            </div>

                            @if (_id is null)
                            {
                                <div class="contacts-locked-box">
                                    <div class="locked-icon-svg" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.6">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                    </div>
                                    <div class="locked-title">يرجى حفظ سجل العميل أولاً</div>
                                    <div class="locked-sub">بإمكانك إضافة وربط جهات الاتصال والممثلين الرسميين بعد قيد وتأسيس سجل العميل الجديد</div>
                                </div>
                            }
                            else if (_contactsLoading)
                            {
                                <div class="contacts-loading">
                                    <div class="cust-spinner sm" aria-label="جاري سحب المدخلات من السيرفر"></div>
                                    <span>جاري قراءة جهات الاتصال المعتمدة...</span>
                                </div>
                            }
                            else if (_contacts.Count == 0)
                            {
                                <div class="contacts-empty">
                                    <div class="empty-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6">
                                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                        </svg>
                                    </div>
                                    <div class="empty-title">لا توجد أي جهات اتصال مسجلة</div>
                                    <div class="empty-sub">يتطلب النظام إضافة ممثل ومفوض رسمي واحد على الأقل لتنسيق المعاملات بملف العميل</div>
                                    @if (CanEditContacts)
                                    {
                                        <button type="button" class="add-contact-btn mt-10" @onclick="OpenNewContact">
                                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                            </svg>
                                            تسجيل جهة اتصال جديدة
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="contacts-list">
                                    @foreach (var c in _contacts)
                                    {
                                        <div class="contact-card @(c.IsPrimary ? "contact-primary" : "")">

                                            <div class="contact-avatar" aria-hidden="true">
                                                @(c.ContactName.Length > 0 ? c.ContactName[0].ToString() : "؟")
                                            </div>

                                            <div class="contact-info">
                                                <div class="contact-name">@c.ContactName</div>
                                                @if (!string.IsNullOrWhiteSpace(c.JobTitle))
                                                {
                                                    <div class="contact-job">@c.JobTitle</div>
                                                }
                                                <div class="contact-meta">
                                                    @if (!string.IsNullOrWhiteSpace(c.Phone))
                                                    {
                                                        <span class="contact-meta-item" dir="ltr">
                                                            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-4.99-5 19.79 19.79 0 01-3.07-8.67A2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                                                            </svg>
                                                            @c.Phone
                                                        </span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(c.Mobile))
                                                    {
                                                        <span class="contact-meta-item" dir="ltr">
                                                            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                                                                <line x1="12" y1="18" x2="12" y2="18"/>
                                                            </svg>
                                                            @c.Mobile
                                                        </span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(c.Email))
                                                    {
                                                        <span class="contact-meta-item" dir="ltr">
                                                            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                                                <path d="M22 6l-10 7L2 6"/>
                                                            </svg>
                                                            @c.Email
                                                        </span>
                                                    }
                                                </div>
                                            </div>

                                            <div class="contact-chips">
                                                @if (c.IsPrimary)
                                                {
                                                    <span class="contact-chip chip-primary">
                                                        <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                                        </svg>
                                                        رئيسية
                                                    </span>
                                                }
                                                @if (c.CanReceiveInvoices)
                                                {
                                                    <span class="contact-chip chip-invoice">
                                                        <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                                        </svg>
                                                        إشعارات فواتير
                                                    </span>
                                                }
                                                @if (!c.IsActive)
                                                {
                                                    <span class="contact-chip chip-inactive">معطلة</span>
                                                }
                                            </div>

                                            <div class="contact-actions">
                                                @if (CanEditContacts)
                                                {
                                                    <button type="button" class="contact-btn edit-btn" @onclick="() => OpenEditContact(c)" title="تعديل الممثل الرسمي">
                                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                        </svg>
                                                    </button>
                                                }
                                                @if (CanDeleteContact)
                                                {
                                                    <button type="button" class="contact-btn del-btn" @onclick="() => AskDelete(c)" title="حذف">
                                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            </div>

                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>

            </MudTabs>
        </div>


        @* Bottom Actions *@
        <div class="cust-bottom-actions">
            <button class="bottom-back-btn" @onclick="GoBack" type="button">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع للقائمة
            </button>

            @if (CanSave)
            {
                <div class="bottom-save-group">
                    <button class="bottom-save-btn" @onclick="SaveAsync" disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ بيانات العميل</span>
                        }
                    </button>
                </div>
            }
        </div>

    }
</div>


@* ═══════════════════════════════════════════
   MODAL — إضافة وتعديل جهة اتصال (معيار svc-modal)
═══════════════════════════════════════════ *@
@if (_contactOpen)
{
    <div class="cust-modal-backdrop" @onclick="CloseContactModal" role="dialog" aria-modal="true">
        <div class="cust-modal" @onclick:stopPropagation="true">

            <div class="modal-head">
                <div class="modal-head-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="modal-title">
                        @(_editId is null ? "إضافة جهة اتصال جديدة للعميل" : "تعديل جهة الاتصال")
                    </div>
                    <div class="modal-sub">سيتم إدراج الممثل المعتمد الجديد تلقائياً في خيارات السندات والحجوزات</div>
                </div>
                <button class="modal-close-btn" @onclick="CloseContactModal" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_cmsg is not null)
            {
                <div class="modal-banner @(_cok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_cmsg</span>
                    <button type="button" @onclick="() => _cmsg = null" aria-label="إغلاق التنبيه">✕</button>
                </div>
            }

            <div class="modal-body">

                <div class="cust-form-grid">

                    <div class="form-field">
                        <label class="field-label" for="cname">اسم الممثل المفوض <span class="field-required">*</span></label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </span>
                            <input id="cname" class="svc-input with-prefix" @bind="_cf.ContactName" maxlength="150" placeholder="الاسم ثلاثي..." />
                        </div>
                    </div>

                    <div class="form-field">
                        <label class="field-label" for="cjob">المسمى والصفة الوظيفية</label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                                </svg>
                            </span>
                            <input id="cjob" class="svc-input with-prefix" @bind="_cf.JobTitle" maxlength="100" placeholder="مدير مبيعات، مسؤول حركة..." />
                        </div>
                    </div>

                    <div class="form-field">
                        <label class="field-label" for="cphone">رقم تليفون المكتب</label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-4.99-5 19.79 19.79 0 01-3.07-8.67A2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                                </svg>
                            </span>
                            <input id="cphone" class="svc-input with-prefix" @bind="_cf.Phone" maxlength="50" placeholder="02-XXXXXXXX" type="tel" dir="ltr" />
                        </div>
                    </div>

                    <div class="form-field">
                        <label class="field-label" for="cmobile">رقم الموبايل الشخصي</label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                                    <line x1="12" y1="18" x2="12" y2="18"/>
                                </svg>
                            </span>
                            <input id="cmobile" class="svc-input with-prefix" @bind="_cf.Mobile" maxlength="50" placeholder="01X-XXXXXXXX" type="tel" dir="ltr" />
                        </div>
                        <div class="field-hint">
                            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <circle cx="8" cy="8" r="6"/>
                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                            </svg>
                            يتطلب النظام إدخال تليفون المكتب أو رقم الموبايل بحد أدنى لتوثيق التسجيل
                        </div>
                    </div>

                    <div class="form-field form-field-full">
                        <label class="field-label" for="cemail">البريد الإلكتروني المباشر</label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                    <path d="M22 6l-10 7L2 6"/>
                                </svg>
                            </span>
                            <input id="cemail" class="svc-input with-prefix" @bind="_cf.Email" maxlength="254" placeholder="contact.name@company.com" type="email" dir="ltr" />
                        </div>
                    </div>

                </div>

                @* ── خيارات التعيين لجهة الاتصال ── *@
                <div class="modal-checks">

                    <label class="check-item @(_cf.IsPrimary ? "check-active" : "")">
                        <input type="checkbox" @bind="_cf.IsPrimary" aria-label="تعيين كجهة اتصال رئيسية للعميل" />
                        <div class="check-icon primary-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                            </svg>
                        </div>
                        <div class="check-text">
                            <span class="check-title">جهة الاتصال المحاسبية والتشغيلية الرئيسية</span>
                            <span class="check-sub">مفوض أول مالي للشركة — تظهر تلقائياً في واجهة الحجز والمقاصات</span>
                        </div>
                    </label>

                    <label class="check-item @(_cf.CanReceiveInvoices ? "check-active" : "")">
                        <input type="checkbox" @bind="_cf.CanReceiveInvoices" aria-label="خيار استلام الفواتير الدورية بالبريد" />
                        <div class="check-icon invoice-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="check-text">
                            <span class="check-title">مفوض باستلام كشوفات الفواتير والإشعارات</span>
                            <span class="check-sub">سيقوم النظام بإرسال نسخ الفواتير الضريبية دورياً لهذا البريد</span>
                        </div>
                    </label>

                    <label class="check-item @(_cf.IsActive ? "check-active" : "check-inactive-item")">
                        <input type="checkbox" @bind="_cf.IsActive" aria-label="مفتاح تفعيل الحساب" />
                        <div class="check-icon active-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 5 12" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="check-text">
                            <span class="check-title">جهة اتصال نشطة ومفعّلة</span>
                            <span class="check-sub">إيقاف التفعيل يخفي جهة الاتصال من القوائم التشغيلية</span>
                        </div>
                    </label>

                </div>

            </div>

            <div class="modal-foot">
                <button class="modal-cancel-btn" @onclick="CloseContactModal" type="button">إلغاء</button>
                <button class="modal-save-btn" @onclick="SaveContactAsync" disabled="@_csaving" type="button">
                    @if (_csaving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري حفظ المعطيات...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                            <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>إتمام الحفظ</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — تأكيد الحذف النهائي للممثل (جهة اتصال)
═══════════════════════════════════════════ *@
@if (_delTarget is not null)
{
    <div class="cust-modal-backdrop" @onclick="() => _delTarget = null" role="dialog" aria-modal="true">
        <div class="cust-modal cust-modal-sm" @onclick:stopPropagation="true">

            <div class="modal-head">
                <div class="modal-head-icon danger-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                    </svg>
                </div>
                <div>
                    <div class="modal-title">تأكيد حذف ممثل العميل</div>
                    <div class="modal-sub danger-sub">إجراء نهائي ولا يمكن التراجع عنه</div>
                </div>
                <button class="modal-close-btn" @onclick="() => _delTarget = null" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                <div class="del-confirm-box">
                    <div class="del-contact-name">@_delTarget.ContactName</div>
                    <div class="del-warning">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                            <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                        </svg>
                        <span>انتبه: لن يسمح النظام بحذف ممثل مقترن تاريخياً ببوالص أو حجوزات تشغيل قائمة، يفضل إلغاء تفعيل وضعيته لمنع ظهوره.</span>
                    </div>
                </div>
            </div>

            <div class="modal-foot">
                <button class="modal-cancel-btn" @onclick="() => _delTarget = null" type="button">تراجع</button>
                <button class="modal-delete-btn" @onclick="DoDeleteAsync" disabled="@_cdel" type="button">
                    @if (_cdel)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الحذف...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                        </svg>
                        <span>تأكيد الحذف النهائي</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


@* ── GLOW FAB (الإجراء السريع والوصول المباشر في الزاوية) ── *@
@if (CanSave && !_loading)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            <button type="button" class="glow-fab-item primary" role="menuitem" @onclick="SaveAsync" disabled="@_saving">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                        <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <span>@(_saving ? "جاري الحفظ..." : "حفظ بيانات العميل")</span>
            </button>
            <button type="button" class="glow-fab-item danger" role="menuitem" @onclick="GoBack">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span>إلغاء والعودة للدليل</span>
            </button>
        </div>

        <div class="glow-fab-container">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="glow-fab-btn" @onclick="ToggleFab" aria-label="لوحة التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

    </div>
}

@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
}


@* ═══════════════════════════════════════════
   CSS STYLES (منسقة ومتطابقة بالكامل)
═══════════════════════════════════════════ *@
<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ── Hero ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px; margin: 0 auto; width: 100%;
        box-sizing: border-box; position: relative; z-index: 1;
    }
    .hero-wrapper .fc-hero {
        border-radius: 20px !important; overflow: hidden;
        box-shadow: 0 12px 32px rgba(13, 38, 84, 0.15), 0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .hero-wrapper .fc-hero.fc-hero-slim { padding-top: 18px !important; padding-bottom: 22px !important; }

    .pay-hero-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 6px; }
    .pay-hero-left { flex: 1; min-width: 200px; }
    .pay-hero-crumb { display: flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.55); margin-bottom: 2px; }
    .pay-hero-sub { font-size: 13px; color: rgba(255,255,255,.55); }
    .pay-hero-right { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

    .pay-hero-refresh {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.75); cursor: pointer; transition: background .15s;
    }
    .pay-hero-refresh:hover { background: rgba(255, 255, 255, 0.14); }

    .pay-hero-add {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; border-radius: 9px;
        border: none; background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .pay-hero-add:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }

    /* ── KPIs Glass Strip ── */
    .pay-kpis-strip {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px); margin-top: 14px;
    }
    .pay-kpi-item { flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px 16px; }
    .pay-kpi-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }
    .pay-kpi-icon {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
    }
    .kpi-blue  { background: rgba(30,110,245,.2); color: #93c5fd; }
    .kpi-amber { background: rgba(234,179,8,.2);  color: #fde68a; }
    .kpi-red   { background: rgba(239,68,68,.2);  color: #fca5a5; }
    .kpi-green { background: rgba(34,197,94,.2);  color: #86efac; }

    .pay-kpi-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .pay-kpi-val { font-size: 15px; font-weight: 900; color: #fff; margin-top: 2px; }
    .pay-kpi-val small { font-size: 10px; font-weight: 600; opacity: .7; }
    .kpi-val-amber { color: #fde68a; }
    .kpi-val-red   { color: #fca5a5; }
    .kpi-val-green { color: #86efac; }

    /* ── Step Progress Indicator ── */
    .cust-steps-bar {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 16px; border-radius: 12px;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        margin-top: 14px; width: fit-content;
    }
    .cust-step-node { display: flex; align-items: center; gap: 8px; color: rgba(255, 255, 255, 0.4); }
    .cust-step-node.active { color: #fff; font-weight: 800; }
    .step-circle {
        width: 24px; height: 24px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.12); color: inherit;
        font-size: 10.5px; font-weight: 900;
    }
    .cust-step-node.active .step-circle { background: var(--fc-blue); color: #fff; }
    .step-text-label { font-size: 11px; }
    .step-connector-line { width: 32px; height: 1.5px; background: rgba(255, 255, 255, 0.15); }

    /* ── Body ── */
    .pay-body {
        background: var(--fc-bg); min-height: calc(100vh - 180px);
        padding: 18px clamp(16px, 3vw, 40px) 96px;
        max-width: 1440px; width: 100%; margin: 0 auto;
        box-sizing: border-box; position: relative; z-index: 2;
        display: flex; flex-direction: column; gap: 14px;
    }

    .pay-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 280px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .pay-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .pay-state-icon.perm { background: #fff0f2; color: var(--fc-red); }

    .svc-banner { display: flex; align-items: center; gap: 10px; padding: 12px 20px; flex: 0 0 auto; font-size: 12.5px; font-weight: 600; }
    .svc-banner-ok { background: #e9f8f0; color: #0e7a43; border-bottom: 1px solid #b5e8d0; }
    .svc-banner-err { background: #fff0f2; color: #D64545; border-bottom: 1px solid #ffc8cf; }
    .svc-banner-x { background: none; border: none; color: inherit; opacity: .5; cursor: pointer; display: flex; margin-right: auto; }

    /* ── Tabs ── */
    .bk-tabs-wrap {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden; flex: 1;
    }
    .bk-mud-tabs .mud-tabs-toolbar {
        background: linear-gradient(180deg, #f9fafd 0%, #f3f6fb 100%);
        border-bottom: 2px solid #e8edf5; padding: 0 16px; min-height: 54px;
    }
    .bk-mud-tabs .mud-tab { font-family: inherit; font-size: 12px; font-weight: 700; color: var(--fc-muted); padding: 0 6px; min-width: unset; transition: color .15s ease; }
    .bk-mud-tabs .mud-tab.mud-tab-active { color: var(--fc-blue) !important; font-weight: 800; }
    .bk-mud-tabs .mud-tab-slider { background: var(--fc-blue) !important; height: 3px; border-radius: 3px 3px 0 0; }
    .bk-tab-panel { padding: 0; }

    .btab-label { display: flex; align-items: center; gap: 7px; padding: 0 4px; white-space: nowrap; }
    .btab-icon { width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: 7px; }
    .btab-blue { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .btab-green { background: var(--fc-green-lt); color: var(--fc-green); }
    .btab-amber { background: var(--fc-amber-lt); color: var(--fc-amber); }
    .btab-red { background: var(--fc-red-lt); color: var(--fc-red); }
    .btab-err-dot {
        width: 7px; height: 7px; border-radius: 50%; background: var(--fc-red); flex: 0 0 7px;
        animation: bk-pulse 1.5s ease infinite;
    }
    @@keyframes bk-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.4); } 50% { box-shadow: 0 0 0 5px rgba(224,48,72,0); } }
    .ctab-count {
        min-width: 18px; height: 18px; display: flex; align-items: center; justify-content: center;
        border-radius: 5px; padding: 0 4px; background: var(--fc-blue-lt); color: var(--fc-blue);
        font-size: 10px; font-weight: 900;
    }
    .ctab-lock-icon { margin-inline-start: 4px; color: var(--fc-muted); opacity: 0.6; }

    /* ── Tab Sections & Forms ── */
    .tab-section { padding: 24px clamp(16px, 3vw, 40px) 28px; max-width: 1440px; margin: 0 auto; width: 100%; box-sizing: border-box; }
    .tab-section-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid #edf1f7; }
    .tab-section-icon { width: 42px; height: 42px; flex: 0 0 42px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    .tab-section-icon.blue { background: var(--fc-blue-lt); color: var(--fc-blue); border: 1px solid #bdd4fc; }
    .tab-section-icon.green { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .tab-section-icon.amber { background: var(--fc-amber-lt); color: var(--fc-amber); border: 1px solid #f0d898; }
    .tab-section-title { font-size: 15px; font-weight: 800; color: #1c2b43; line-height: 1.2; }
    .tab-section-sub { font-size: 11px; font-weight: 500; color: var(--fc-muted); margin-top: 3px; }

    .tab-section-sub-head { display: flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 800; color: #344258; margin: 22px 0 12px; padding-top: 18px; border-top: 1px solid #edf1f7; }

    .bk-form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; width: 100%; }
    .form-field { display: flex; flex-direction: column; gap: 6px; position: relative; }
    .form-field-full { grid-column: 1 / -1; }
    .field-label { font-size: 12px; font-weight: 800; color: #344258; display: flex; align-items: center; gap: 4px; }
    .field-required { color: var(--fc-red); font-size: 14px; line-height: 1; }

    .field-input {
        height: 42px; width: 100%; border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text); font-family: inherit; font-size: 13px; padding: 0 12px;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease; outline: none; box-sizing: border-box;
    }
    .field-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); background: #fff; }
    .field-input:disabled { opacity: .7; background: #f3f5f8; cursor: not-allowed; }
    .field-input.field-error { border-color: var(--fc-red); box-shadow: 0 0 0 3px rgba(224,48,72,.08); }
    .field-textarea { height: auto; padding: 10px 12px; resize: vertical; min-height: 70px; }

    .field-input-group { position: relative; display: flex; align-items: center; width: 100%; }
    .field-prefix { position: absolute; right: 12px; display: flex; align-items: center; font-size: 11px; font-weight: 700; color: #9aaabb; pointer-events: none; z-index: 1; }
