    private bool _showSupplierDropdown;
    private int _focusedSupplierIndex = -1;
    private List<Opt> _suppliers = new();
    private List<Opt> _filteredSuppliers = new();

    /* Tab Error Detection */
    private bool HasTabError(int tab) => _triedSave && tab switch
    {
        1 => string.IsNullOrWhiteSpace(_f.NameAr),
        2 => (IsCompany  && string.IsNullOrWhiteSpace(_f.TaxNumber)) ||
             (!IsCompany && string.IsNullOrWhiteSpace(_f.NationalId)),
        _ => false
    };

