@code {
    [Parameter] public int? Id { get; set; }
    private int?   _id;
    private string CustomerCode = "";
    private int    _activeTab;
    private bool   _triedSave;

    private AuthUser? _user;
    private bool CanCreate => _user?.Can("CUSTOMER.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("CUSTOMER.EDIT")   ?? false;
    private bool CanSave   => _id is null ? CanCreate : CanEdit;

    private bool _loading; private bool _saving;
    private string? _msg; private bool _ok = true;

    private Form _f = new();

    /* ══ جهات الاتصال ══ */
    private bool CanViewContacts  => _user?.Can("CUSTOMER.VIEW")   ?? false;
    private bool CanEditContacts  => _user?.Can("CUSTOMER.EDIT")   ?? false;
    private bool CanDeleteContact => _user?.Can("CUSTOMER.DELETE") ?? false;

    private List<Contact> _contacts = new();
    private bool          _contactsLoading;
    private bool          _contactOpen, _csaving;
    private string?       _cmsg; private bool _cok = true;
    private int?          _editId;
    private Contact       _cf = new();
    private Contact?      _delTarget; private bool _cdel;

    /* Tab Error Detection */
    private bool HasTabError(int tab) => _triedSave && tab switch
    {
        1 => string.IsNullOrWhiteSpace(_f.NameAr),
        2 => (IsCompany  && string.IsNullOrWhiteSpace(_f.TaxNumber)) ||
             (!IsCompany && string.IsNullOrWhiteSpace(_f.NationalId)),
        _ => false
    };

    private class Contact
    {
        public int     CustomerContactId  { get; set; }
        public int     CustomerId         { get; set; }
        public string  ContactName        { get; set; } = "";
        public string? JobTitle           { get; set; }
        public string? Phone              { get; set; }
        public string? Mobile             { get; set; }
        public string? Email              { get; set; }
        public bool    IsPrimary          { get; set; }
        public bool    CanReceiveInvoices { get; set; }
        public bool    IsActive           { get; set; }
    }

    private string CApi => $"api/customers/{_id}/contacts";

    private async Task LoadContactsAsync()
    {
        if (_id is null) return;
        _contactsLoading = true;
        try   { _contacts = await Http.GetFromJsonAsync<List<Contact>>(CApi) ?? new(); }
        catch { _contacts = new(); }
        finally { _contactsLoading = false; }
    }

    private void OpenNewContact()
    {
        _editId = null;
        _cf = new Contact { IsActive = true, IsPrimary = _contacts.Count == 0 };
        _cmsg = null; _cok = true; _contactOpen = true;
    }

    private void OpenEditContact(Contact c)
    {
        _editId = c.CustomerContactId;
        _cf = new Contact
        {
            CustomerContactId  = c.CustomerContactId,
            ContactName        = c.ContactName,
            JobTitle           = c.JobTitle,
            Phone              = c.Phone,
            Mobile             = c.Mobile,
            Email              = c.Email,
            IsPrimary          = c.IsPrimary,
            CanReceiveInvoices = c.CanReceiveInvoices,
            IsActive           = c.IsActive
        };
        _cmsg = null; _cok = true; _contactOpen = true;
    }

    private void CloseContactModal()
    {
        _contactOpen = false; _editId = null; _cmsg = null;
        _cf = new Contact();
    }

    private async Task SaveContactAsync()
    {
        if (string.IsNullOrWhiteSpace(_cf.ContactName))
        { _cok = false; _cmsg = "اسم جهة الاتصال مطلوب"; return; }

        if (string.IsNullOrWhiteSpace(_cf.Phone) && string.IsNullOrWhiteSpace(_cf.Mobile))
        { _cok = false; _cmsg = "لازم تليفون أو موبايل على الأقل"; return; }

        var payload = new
        {
            contactName        = _cf.ContactName.Trim(),
            jobTitle           = _cf.JobTitle,
            phone              = _cf.Phone,
            mobile             = _cf.Mobile,
            email              = _cf.Email,
            isPrimary          = _cf.IsPrimary,
            canReceiveInvoices = _cf.CanReceiveInvoices,
            isActive           = _cf.IsActive
        };

        _csaving = true; _cmsg = null;
        try
        {
            var res = _editId is null
                ? await Http.PostAsJsonAsync(CApi, payload)
                : await Http.PutAsJsonAsync($"{CApi}/{_editId}", payload);

            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            { _cok = false; _cmsg = Msg(body, "الحفظ فشل"); return; }

            Snackbar.Add(Msg(body, "✅ اتحفظت"), Severity.Success);
            CloseContactModal();
            await LoadContactsAsync();
        }
        catch (Exception ex) { _cok = false; _cmsg = "الحفظ فشل: " + ex.Message; }
        finally { _csaving = false; }
    }

    private void AskDelete(Contact c) { _delTarget = c; }

    private async Task DoDeleteAsync()
    {
        if (_delTarget is null) return;
        _cdel = true;
        try
        {
            var res  = await Http.DeleteAsync($"{CApi}/{_delTarget.CustomerContactId}");
            var body = await res.Content.ReadAsStringAsync();

            if (!res.IsSuccessStatusCode)
            { Snackbar.Add(Msg(body, "الحذف فشل"), Severity.Error); return; }

            Snackbar.Add(Msg(body, "✅ اتحذفت"), Severity.Success);
            _delTarget = null;
            await LoadContactsAsync();
        }
        catch (Exception ex) { Snackbar.Add("الحذف فشل: " + ex.Message, Severity.Error); }
        finally { _cdel = false; }
    }

    private static string Msg(string body, string fallback)
    {
        if (string.IsNullOrWhiteSpace(body) || body.TrimStart().StartsWith("<")) return fallback;
        try
        {
            using var d = System.Text.Json.JsonDocument.Parse(body);
            if (d.RootElement.TryGetProperty("message", out var m)) return m.GetString() ?? fallback;
        }
        catch { }
        return fallback;
    }

    private bool IsCompany => _f.CustomerType == "Company";

    public class Form
    {
        public string  CustomerType       { get; set; } = "Company";
        public string  NameAr             { get; set; } = "";
        public string? NameEn             { get; set; }
        public string? TaxNumber          { get; set; }
        public string? NationalId         { get; set; }
        public string? CommercialRegister { get; set; }
        public string? Phone              { get; set; }
        public string? Email              { get; set; }
        public string? AddressAr          { get; set; }
        public string? CityAr             { get; set; }
        public decimal CreditLimit        { get; set; }
        public bool    PortalEnabled      { get; set; }
    }

    public class Detail
    {
        public int     CustomerId         { get; set; }
        public string  CustomerCode       { get; set; } = "";
        public string  CustomerType       { get; set; } = "";
        public string  NameAr             { get; set; } = "";
        public string? NameEn             { get; set; }
        public string? TaxNumber          { get; set; }
        public string? NationalId         { get; set; }
        public string? CommercialRegister { get; set; }
        public string? Phone              { get; set; }
        public string? Email              { get; set; }
        public string? AddressAr          { get; set; }
        public string? CityAr             { get; set; }
        public decimal CreditLimit        { get; set; }
        public bool    PortalEnabled      { get; set; }
        public bool    IsActive           { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id   = Id;

        if (!CanSave && !CanViewContacts) return;

        _loading = true;
        try   { if (_id is not null) await LoadAsync(_id.Value); }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; _ok = false; }
        finally { _loading = false; }

        if (_id is not null && CanViewContacts) await LoadContactsAsync();
    }

    private async Task LoadAsync(int id)
    {
        var d = await Http.GetFromJsonAsync<Detail>($"api/customers/{id}");
        if (d is null) { _msg = "العميل غير موجود"; _ok = false; return; }

        CustomerCode = d.CustomerCode;
        _f = new Form
        {
            CustomerType       = d.CustomerType,
            NameAr             = d.NameAr,
            NameEn             = d.NameEn,
            TaxNumber          = d.TaxNumber,
            NationalId         = d.NationalId,
            CommercialRegister = d.CommercialRegister,
            Phone              = d.Phone,
            Email              = d.Email,
            AddressAr          = d.AddressAr,
            CityAr             = d.CityAr,
            CreditLimit        = d.CreditLimit,
            PortalEnabled      = d.PortalEnabled
        };
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _triedSave = true;

        /* Validate */
        if (string.IsNullOrWhiteSpace(_f.NameAr))
        { _msg = "الاسم بالعربي مطلوب"; _ok = false; _activeTab = 0; return; }

        if (IsCompany && string.IsNullOrWhiteSpace(_f.TaxNumber))
        { _msg = "الرقم الضريبي مطلوب للشركة"; _ok = false; _activeTab = 1; return; }

        if (!IsCompany && string.IsNullOrWhiteSpace(_f.NationalId))
        { _msg = "الرقم القومي مطلوب للفرد"; _ok = false; _activeTab = 1; return; }

        _saving = true; _msg = null;
        try
        {
            var payload = new
            {
                customerType       = _f.CustomerType,
                nameAr             = _f.NameAr,
                nameEn             = _f.NameEn,
                taxNumber          = _f.TaxNumber,
                nationalId         = _f.NationalId,
                commercialRegister = _f.CommercialRegister,
                phone              = _f.Phone,
                email              = _f.Email,
                addressAr          = _f.AddressAr,
                cityAr             = _f.CityAr,
                creditLimit        = _f.CreditLimit,
                portalEnabled      = _f.PortalEnabled
            };

            var res = _id is null
                ? await Http.PostAsJsonAsync("api/customers", payload)
                : await Http.PutAsJsonAsync($"api/customers/{_id}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            Snackbar.Add(_msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) GoBack();
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private void GoBack() => Nav.NavigateTo("/customers");

    private static decimal ParseAmount(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n > 0 ? n : 0m;

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "✅ تم الحفظ" : "حصل خطأ — حاول تاني"; }
    }
}