@page "/vehicle-account"
@page "/vehicles/{VehicleId:int}/account"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>كشف حساب المركبة — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="pay-hero-row">
                <div class="pay-hero-left">
                    <div class="pay-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="1" y="3" width="15" height="13" rx="2"/>
                            <path d="M16 8h4l3 3v5h-7V8z"/>
                            <circle cx="5.5" cy="18.5" r="2.5"/>
                            <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                        <span>الأسطول التشغيلي · كشوفات الحسابات المالية</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">
                        كشف حساب المركبة @(_stmt is null ? "" : _stmt.PlateNumber)
                    </h1>
                    <span class="pay-hero-sub">كشف الحركة المالية والمحاسبية من @(_from == default ? "—" : _from.ToString("dd/MM/yyyy")) حتى @(_to == default ? "—" : _to.AddDays(-1).ToString("dd/MM/yyyy"))</span>
                </div>

                <div class="pay-hero-right">
                    <button type="button" class="pay-hero-refresh" @onclick="LoadAsync" title="تحديث البيانات">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 4v6h-6"/>
                            <path d="M1 20v-6h6"/>
                            <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                        </svg>
                    </button>
                    <button type="button" class="pay-hero-add" @onclick="OpenPayment">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                        </svg>
                        تسجيل دفعة جديدة
                    </button>
                    <span class="pay-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @_monthLabel
                    </span>
                </div>
            </div>

            @* ── KPI Connected Glass Strip ── *@
            <div class="pay-kpis-strip">

                <div class="pay-kpi-item">
                    <div class="pay-kpi-icon kpi-blue">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 21h18M3 10h18M5 6h14M10 10v11M14 10v11" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="pay-kpi-text">
                        <div class="pay-kpi-label">الرصيد المُرحّل السابق</div>
                        <div class="pay-kpi-val">@Money(_stmt?.Opening ?? 0) <small>ج.م</small></div>
                    </div>
                </div>

                <div class="pay-kpi-div" aria-hidden="true"></div>

                <div class="pay-kpi-item">
                    <div class="pay-kpi-icon kpi-green">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                            <polyline points="17 6 23 6 23 12"/>
                        </svg>
                    </div>
                    <div class="pay-kpi-text">
                        <div class="pay-kpi-label">إجمالي النولون المستحق</div>
                        <div class="pay-kpi-val kpi-val-green">@Money(_stmt?.TotalDebit ?? 0) <small>ج.م</small></div>
                    </div>
                </div>

                <div class="pay-kpi-div" aria-hidden="true"></div>

                <div class="pay-kpi-item">
                    <div class="pay-kpi-icon kpi-red">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/>
                            <polyline points="17 18 23 18 23 12"/>
                        </svg>
                    </div>
                    <div class="pay-kpi-text">
                        <div class="pay-kpi-label">إجمالي الخصومات والدفعات</div>
                        <div class="pay-kpi-val kpi-val-red">@Money(_stmt?.TotalCredit ?? 0) <small>ج.م</small></div>
                    </div>
                </div>

                <div class="pay-kpi-div" aria-hidden="true"></div>

                <div class="pay-kpi-item">
                    <div class="pay-kpi-icon kpi-amber">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <div class="pay-kpi-text">
                        <div class="pay-kpi-label">رصيد الإقفال آخر الفترة</div>
                        <div class="pay-kpi-val kpi-val-amber">@Money(_stmt?.Closing ?? 0) <small>ج.م</small></div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="pay-body">

    <div class="pay-card">

        @* ── Toolbar ── *@
        <div class="pay-toolbar">

            <div class="va-filter-wrap">
                <svg class="va-filter-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                    <path d="M16 8h4l3 3v5h-7V8z"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
                <select class="va-filter-select" @bind="_selectedVehicleId" @bind:after="LoadAsync">
                    <option value="0">— اختر المركبة —</option>
                    @foreach (var v in _vehicles)
                    {
                        <option value="@v.VehicleId">@v.PlateNumber — @v.VehicleType</option>
                    }
                </select>
            </div>

            <div class="va-filter-wrap">
                <svg class="va-filter-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                </svg>
                <select class="va-filter-select" @bind="_month" @bind:after="LoadAsync">
                    @foreach (var m in _months)
                    {
                        <option value="@m.ToString("yyyy-MM")">@m.ToString("MMMM yyyy")</option>
                    }
                </select>
            </div>

            <button type="button" class="va-print-btn" @onclick="Print" title="طباعة كشف الحساب">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 6 2 18 2 18 9"/>
                    <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
                    <rect x="6" y="14" width="12" height="8"/>
                </svg>
                طباعة
            </button>

            <div class="pay-results-badge">
                <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <circle cx="8" cy="8" r="6"/>
                    <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                </svg>
                @if (_stmt is not null)
                {
                    <span>عرض <strong>@_stmt.Lines.Count</strong> حركة مالية</span>
                }
                else
                {
                    <span>لا توجد بيانات</span>
                }
            </div>

        </div>


        @* ── Content ── *@
        @if (_loading)
        {
            <div class="pay-loading">
                <div class="pay-spinner" aria-label="جاري التحميل"></div>
                <span>جاري تحميل الحركات المالية للفترة المحددة...</span>
            </div>
        }
        else if (_selectedVehicleId <= 0)
        {
            <div class="pay-empty">
                <div class="pay-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                        <path d="M16 8h4l3 3v5h-7V8z"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                        <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                </div>
                <div class="pay-empty-title">يرجى اختيار المركبة أولاً</div>
                <div class="pay-empty-sub">حدد المركبة والفترة المالية لعرض كشف الحساب المفصل</div>
            </div>
        }
        else if (_stmt is null || _stmt.Lines.Count == 0)
        {
            <div class="pay-empty">
                <div class="pay-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.4">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
                    </svg>
                </div>
                <div class="pay-empty-title">لا توجد حركات مالية في هذه الفترة</div>
                <div class="pay-empty-sub">لم يتم تسجيل أي حركة مالية على هذه المركبة خلال شهر @_monthLabel</div>
            </div>
        }
        else
        {
            <div class="pay-table-wrap">
                <table class="pay-table" aria-label="كشف حساب المركبة">
                    <thead>
                        <tr>
                            <th class="th-start" style="width:110px">التاريخ</th>
                            <th style="width:130px">نوع الحركة</th>
                            <th style="width:130px">المرجع</th>
                            <th class="th-start">البيان الوصفي</th>
                            <th style="width:120px">مدين</th>
                            <th style="width:120px">دائن</th>
                            <th style="width:130px">الرصيد الجاري</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* الرصيد الافتتاحي كصف ثابت *@
                        <tr class="va-opening-row">
                            <td class="td-start va-date-cell">@_from.ToString("dd/MM/yyyy")</td>
                            <td colspan="3" class="td-start">
                                <div class="va-opening-label">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path d="M23 4v6h-6"/>
                                        <path d="M20.49 15A9 9 0 016 6l5-5"/>
                                    </svg>
                                    الرصيد المُرحّل من الفترة السابقة
                                </div>
                            </td>
                            <td class="td-muted">—</td>
                            <td class="td-muted">—</td>
                            <td>
                                <span class="va-balance-chip opening">@Money(_stmt.Opening)</span>
                            </td>
                        </tr>

                        @foreach (var l in _stmt.Lines)
                        {
                            <tr>
                                <td class="td-start va-date-cell">@l.Date.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="va-kind-chip kind-@l.Kind.ToLower()">
                                        <span class="va-kind-dot" aria-hidden="true"></span>
                                        @KindAr(l.Kind)
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(l.Ref))
                                    {
                                        <span class="va-ref-chip">@l.Ref</span>
                                    }
                                    else
                                    {
                                        <span class="td-muted">—</span>
                                    }
                                </td>
                                <td class="td-start va-desc-cell">@(l.Description ?? "—")</td>
                                <td>
                                    @if (l.Debit > 0)
                                    {
                                        <span class="va-num va-num-debit">@Money(l.Debit)</span>
                                    }
                                    else
                                    {
                                        <span class="td-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (l.Credit > 0)
                                    {
                                        <span class="va-num va-num-credit">@Money(l.Credit)</span>
                                    }
                                    else
                                    {
                                        <span class="td-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="va-balance-chip @(l.Balance < 0 ? "neg" : "pos")">
                                        @Money(l.Balance)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="td-start va-total-label">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <line x1="12" y1="1" x2="12" y2="23"/>
                                    <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                </svg>
                                إجمالي الحركة المالية للفترة
                            </td>
                            <td><span class="va-num va-num-debit">@Money(_stmt.TotalDebit)</span></td>
                            <td><span class="va-num va-num-credit">@Money(_stmt.TotalCredit)</span></td>
                            <td><span class="va-balance-chip closing">@Money(_stmt.Closing)</span></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }

    </div>
</div>


@* ═══════════════════════════════════════════
   MODAL — تسجيل دفعة مالية (svc-modal Standard)
═══════════════════════════════════════════ *@
@if (_payOpen)
{
    <div class="svc-modal-backdrop" @onclick="() => _payOpen = false" role="dialog" aria-modal="true">
        <div class="svc-modal svc-modal-sm" @onclick:stopPropagation="true">

            <div class="svc-modal-head">
                <div class="svc-head-icon svc-icon-create" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23"/>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">تسجيل دفعة مالية جديدة</div>
                    <div class="svc-head-sub">تحصيل مبلغ من حساب المركبة <strong>@_stmt?.PlateNumber</strong></div>
                </div>
                <button class="svc-head-close" @onclick="() => _payOpen = false" aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            <div class="svc-modal-body" style="padding: 22px 24px">
                <div class="svc-grid">

                    <div class="svc-field svc-full">
                        <label class="svc-label">القيمة المالية المستلمة <span class="svc-req">*</span></label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix txt">ج.م</span>
                            <input type="number" step="0.01" min="0.01"
                                   class="svc-input ltr with-prefix"
                                   @bind="_payAmount"
                                   placeholder="0.00" />
                        </div>
                    </div>

                    <div class="svc-field svc-full">
                        <label class="svc-label">البيان والملاحظات</label>
                        <div class="svc-input-wrap">
                            <span class="svc-prefix">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                            </span>
                            <input type="text" class="svc-input with-prefix"
                                   @bind="_payDesc"
                                   maxlength="200"
                                   placeholder="مثال: دفعة تسوية شهر مارس..." />
                        </div>
                    </div>

                </div>
            </div>

            <div class="svc-modal-foot">
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="() => _payOpen = false" type="button">تراجع</button>
                    <button class="svc-btn-save" @onclick="SavePayment" disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري تسجيل الدفعة...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>تسجيل الدفعة</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}


@* ── GLOW FAB ── *@
<div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">
    <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
        <button type="button" class="glow-fab-item" role="menuitem" @onclick="OpenPayment">
            <span class="glow-fab-item-ic">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </span>
            <span>تسجيل دفعة مالية</span>
        </button>
        <button type="button" class="glow-fab-item" role="menuitem" @onclick="Print">
            <span class="glow-fab-item-ic">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polyline points="6 9 6 2 18 2 18 9"/>
                    <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
                    <rect x="6" y="14" width="12" height="8"/>
                </svg>
            </span>
            <span>طباعة كشف الحساب</span>
        </button>
        <button type="button" class="glow-fab-item" role="menuitem" @onclick="LoadAsync">
            <span class="glow-fab-item-ic">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M23 4v6h-6"/>
                    <path d="M1 20v-6h6"/>
                    <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                </svg>
            </span>
            <span>تحديث الكشف</span>
        </button>
    </div>

    <div class="glow-fab-container">
        <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
        <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
        <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
        <span class="glow-halo" aria-hidden="true"></span>

        <button type="button" class="glow-fab-btn" @onclick="() => _fabOpen = !_fabOpen" aria-label="لوحة التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
</div>

@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="() => _fabOpen = false" aria-hidden="true"></div>
}


@* ═══════════════════════════════════════════
   CSS STYLES
═══════════════════════════════════════════ *@
<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ── Hero ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px; margin: 0 auto; width: 100%;
        box-sizing: border-box; position: relative; z-index: 1;
    }
    .hero-wrapper .fc-hero {
        border-radius: 20px !important; overflow: hidden;
        box-shadow: 0 12px 32px rgba(13, 38, 84, 0.15), 0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .hero-wrapper .fc-hero.fc-hero-slim { padding-top: 18px !important; padding-bottom: 22px !important; }

    .pay-hero-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 6px; }
    .pay-hero-left { flex: 1; min-width: 200px; }
    .pay-hero-crumb { display: flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.55); margin-bottom: 2px; }
    .pay-hero-sub { font-size: 13px; color: rgba(255,255,255,.55); font-weight: 600; }
    .pay-hero-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
