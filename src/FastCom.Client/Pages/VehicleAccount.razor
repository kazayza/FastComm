@code {
    [Parameter] public int VehicleId { get; set; }

    private StatementOut? _stmt;
    private List<VehicleOpt> _vehicles = new();
    private int _selectedVehicleId;
    private bool _loading = true;
    private bool _fabOpen;
    private bool _payOpen;
    private bool _saving;
    private decimal _payAmount;
    private string? _payDesc;

    private DateTime _from;
    private DateTime _to;
    private string _month = "";
    private string _monthLabel = "";
    private List<DateTime> _months = new();

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        _months = Enumerable.Range(0, 12).Select(i => today.AddMonths(-i)).ToList();
        _month = today.ToString("yyyy-MM");

        try { _vehicles = await Http.GetFromJsonAsync<List<VehicleOpt>>("api/vehicle-accounts/vehicles") ?? new(); }
        catch { _vehicles = new(); }

        _selectedVehicleId = VehicleId > 0 ? VehicleId : (_vehicles.FirstOrDefault()?.VehicleId ?? 0);
        if (_selectedVehicleId > 0) await LoadAsync();
        else _loading = false;
    }

    private async Task LoadAsync()
    {
        if (_selectedVehicleId <= 0) { _stmt = null; _loading = false; return; }
        _loading = true;
        _from = DateTime.ParseExact(_month + "-01", "yyyy-MM-dd", null);
        _to = _from.AddMonths(1);
        _monthLabel = _from.ToString("MMMM yyyy");

        try
        {
            _stmt = await Http.GetFromJsonAsync<StatementOut>(
                $"api/vehicle-accounts/{_selectedVehicleId}/statement?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}");
        }
        catch { _stmt = null; }
        finally { _loading = false; }
    }

    private void OpenPayment()
    {
        _fabOpen = false;
        _payAmount = 0;
        _payDesc = null;
        _payOpen = true;
    }

    private async Task SavePayment()
    {
        if (_payAmount <= 0)
        {
            Snackbar.Add("يرجى إدخال مبلغ صحيح أكبر من صفر", Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/vehicle-accounts/payment", new
            {
                vehicleId = _selectedVehicleId,
                txDate = (string?)null,
                amount = _payAmount,
                paymentMethodId = (int?)null,
                description = _payDesc
            });
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("تم تسجيل الدفعة المالية بنجاح", Severity.Success);
                _payOpen = false;
                await LoadAsync();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add(err, Severity.Error);
            }
        }
        catch { Snackbar.Add("تعذر تسجيل الدفعة — يرجى المحاولة مرة أخرى", Severity.Error); }
        finally { _saving = false; }
    }

    private void Print()
    {
        _fabOpen = false;
        Nav.NavigateTo($"/vehicles/{_selectedVehicleId}/account?print=1", true);
    }

    private static string KindAr(string k) => k switch
    {
        "Freight" => "نولون رحلة",
        "Custody" => "عهدة نقدية",
        "Expense" => "مصروف تشغيلي",
