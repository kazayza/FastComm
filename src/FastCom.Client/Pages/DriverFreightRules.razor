@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("MASTERDATA.VIEW")   ?? false;
    private bool CanManage => _user?.Can("MASTERDATA.MANAGE") ?? false;

    private List<Item> _items       = new();
    private List<Opt>  _ports       = new();
    private List<Opt>  _destinations = new();
    private List<Opt>  _tripTypes   = new();

    private bool    _loading;
    private string  _search    = "";
    private bool    _saving;
    private string? _msg;
    private bool    _ok        = true;
    private bool    _fabOpen;
    private bool    _modalOpen;
    private bool    _triedSave;
    private int?    _editId;
    private Form    _f = new();
    private Item?   _editItem;
    private Item?   _deleteItem;

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }

    public class Item
    {
        public int      DriverFreightRuleId { get; set; }
        public int?     PortId              { get; set; }
        public string?  PortName            { get; set; }
        public int?     DestinationId       { get; set; }
        public string?  DestinationName     { get; set; }
        public int?     TripTypeId          { get; set; }
        public string?  TripTypeName        { get; set; }
        public decimal  Amount              { get; set; }
        public string   ValidFrom           { get; set; } = "";
        public string?  ValidTo             { get; set; }
        public int      Priority            { get; set; }
        public bool     IsActive            { get; set; }
        public string?  Notes               { get; set; }
    }

    public class Form
    {
        public int?     PortId        { get; set; }
        public int?     DestinationId { get; set; }
        public int?     TripTypeId    { get; set; }
        public decimal  Amount        { get; set; }
        public DateOnly  ValidFrom    { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly? ValidTo      { get; set; }
        public int      Priority      { get; set; } = 100;
        public bool     IsActive      { get; set; } = true;
        public string?  Notes         { get; set; }
    }

    private static string RouteOf(Item r)
    {
        var from = string.IsNullOrWhiteSpace(r.PortName) ? "أي ميناء" : r.PortName;
        var to   = string.IsNullOrWhiteSpace(r.DestinationName) ? "أي وجهة" : r.DestinationName;
        var type = string.IsNullOrWhiteSpace(r.TripTypeName) ? "" : $" · {r.TripTypeName}";
        return $"{from} ← {to}{type}";
    }

    private int CoveringToday()
    {
        var today = DateTime.Today.ToString("yyyy-MM-dd");
        return _items.Count(r => r.IsActive &&
            string.CompareOrdinal(r.ValidFrom, today) <= 0 &&
            (string.IsNullOrWhiteSpace(r.ValidTo) || string.CompareOrdinal(r.ValidTo, today) >= 0));
    }

    private IEnumerable<Item> Filtered => _items.Where(r =>
        string.IsNullOrWhiteSpace(_search) ||
        (r.PortName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        (r.DestinationName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        (r.TripTypeName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        (r.Notes ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        try
        {
            _ports        = await Http.GetFromJsonAsync<List<Opt>>("api/options/ports") ?? new();
            _destinations = await Http.GetFromJsonAsync<List<Opt>>("api/options/destinations") ?? new();
            _tripTypes    = await Http.GetFromJsonAsync<List<Opt>>("api/options/trip-types") ?? new();
        }
        catch { /* القوائم اختيارية — الشاشة تشتغل من غيرها */ }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _items = await Http.GetFromJsonAsync<List<Item>>("api/driver-freight-rules") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ToggleFab() { _fabOpen = !_fabOpen; StateHasChanged(); }

    private async Task HandleReload()
    {
        _fabOpen = false;
        StateHasChanged();
        await LoadAsync();
        Snackbar.Add("تم تحديث البيانات", Severity.Success);
    }

    private async Task HandleOpenCreate()
    {
        _fabOpen = false;
        StateHasChanged();
        await Task.Delay(180);
        ResetForm();
        _modalOpen = true;
        StateHasChanged();
    }

    private void ResetForm()
    {
        _editId    = null;
        _editItem  = null;
        _f         = new Form();
        _msg       = null;
        _triedSave = false;
        StateHasChanged();
    }

    private void OpenEdit(Item r)
    {
        _editId   = r.DriverFreightRuleId;
        _editItem = r;
        _f = new Form
        {
            PortId        = r.PortId,
            DestinationId = r.DestinationId,
            TripTypeId    = r.TripTypeId,
            Amount        = r.Amount,
            ValidFrom     = DateOnly.TryParse(r.ValidFrom, out var vf) ? vf : DateOnly.FromDateTime(DateTime.Today),
            ValidTo       = DateOnly.TryParse(r.ValidTo, out var vt) ? vt : null,
            Priority      = r.Priority,
            IsActive      = r.IsActive,
            Notes         = r.Notes
        };
        _msg       = null;
        _triedSave = false;
        _modalOpen = true;
        StateHasChanged();
    }

    private void CloseModal() { _modalOpen = false; StateHasChanged(); }

    private void AskDelete(Item r) { _deleteItem = r; StateHasChanged(); }

    private async Task ConfirmDeleteAsync()
    {
        if (_saving || _deleteItem is null) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var res = await Http.DeleteAsync($"api/driver-freight-rules/{_deleteItem.DriverFreightRuleId}");
            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(msg, Severity.Success);
                _deleteItem = null;
                await LoadAsync();
            }
            else Snackbar.Add(msg, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally { _saving = false; StateHasChanged(); }
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _triedSave = true;

        if (_f.Amount <= 0)
        {
            _ok = false; _msg = "النولون يجب أن يكون أكبر من صفر";
            StateHasChanged(); return;
        }
        if (_f.ValidTo is not null && _f.ValidTo < _f.ValidFrom)
        {
            _ok = false; _msg = "تاريخ «ساري حتى» قبل «ساري من»";
            StateHasChanged(); return;
        }

        _saving = true; _msg = null;
        StateHasChanged();

        try
        {
            var payload = new
            {
                portId        = _f.PortId,
                destinationId = _f.DestinationId,
                tripTypeId    = _f.TripTypeId,
                amount        = _f.Amount,
                validFrom     = _f.ValidFrom.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
                validTo       = _f.ValidTo?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
                priority      = _f.Priority,
                isActive      = _f.IsActive,
                notes         = _f.Notes?.Trim()
            };

            var res = _editId is null
                ? await Http.PostAsJsonAsync("api/driver-freight-rules", payload)
                : await Http.PutAsJsonAsync($"api/driver-freight-rules/{_editId}", payload);

            _msg = await MsgOf(res);
            _ok  = res.IsSuccessStatusCode;

            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                CloseModal();
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _ok  = false;
            _msg = "فشل: " + ex.Message;
            Snackbar.Add(_msg, Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch
        {
            return res.IsSuccessStatusCode ? "تمت العملية بنجاح" : "حدث خطأ غير متوقع";
        }
    }
}
