@page "/master/freightrules"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>نوالين السائقين — فاست كوم</PageTitle>

<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">
            <div class="doc-hero-row">
                <div class="doc-hero-left">
                    <div class="doc-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <line x1="12" y1="1" x2="12" y2="23"/>
                            <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                        </svg>
                        <span>البيانات الأساسية · نوالين السائقين</span>
                    </div>
                    <h1 class="fc-hero-title">نوالين السائقين</h1>
                    <p class="fc-hero-sub">نولون النقله = أجرة السائق — تكلفة على الشركة حسب المسار</p>
                </div>
                <div class="doc-hero-right">
                    <span class="doc-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>
            @if (CanView)
            {
                <div class="doc-kpis-row">
                    <div class="doc-kpi doc-kpi-blue">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_items.Count</div>
                                <div class="doc-kpi-label">القواعد المسجلة</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-green">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_items.Count(i => i.IsActive)</div>
                                <div class="doc-kpi-label">قواعد نشطة</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-amber">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@CoveringToday()</div>
                                <div class="doc-kpi-label">سارية اليوم</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="doc-body">
    @if (!CanView)
    {
        <div class="doc-state-box">
            <div class="state-icon-wrap perm">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none"
                     stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليست لديك الصلاحية الكافية لعرض نوالين السائقين</p>
        </div>
    }
    else
    {
        <div class="fc-overlap">
            <div class="doc-card">

                <div class="doc-banner banner-info" role="alert">
                    <div class="banner-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <span>
                        كل قاعدة = مسار (ميناء · وجهة · نوع رحلة) + مبلغ + فترة سريان.
                        البند الفارغ يعني <strong>«أي قيمة»</strong>،
                        والاقتراح التلقائي في الرحلات يأخذ <strong>القاعدة الأخص</strong> ثم الأولوية ثم الأحدث.
                    </span>
                </div>

                <div class="doc-toolbar">
                    <div class="doc-search-wrap">
                        <svg class="doc-search-icon" viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                        </svg>
                        <input class="doc-search-input"
                               placeholder="ابحث بالميناء أو الوجهة أو النوع..."
                               @bind="_search" @bind:event="oninput"
                               aria-label="البحث"/>
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <button class="doc-search-clear"
                                    @onclick="() => _search = string.Empty"
                                    aria-label="مسح" type="button">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                     stroke="currentColor" stroke-width="2.5">
                                    <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                                </svg>
                            </button>
                        }
                    </div>
                    <div class="doc-results-badge">
                        <svg viewBox="0 0 16 16" width="11" height="11" fill="none"
                             stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <circle cx="8" cy="8" r="6"/>
                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                        </svg>
                        عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                    </div>
                </div>

                @if (_loading)
                {
                    <div class="doc-loading">
                        <div class="doc-spinner"></div>
                        <span>جاري تحميل نوالين السائقين...</span>
                    </div>
                }
                else
                {
                    <div class="doc-table-wrap">
                        <table class="doc-table" aria-label="جدول نوالين السائقين">
                            <thead>
                                <tr>
                                    <th scope="col" class="th-start">المسار</th>
                                    <th scope="col">النولون</th>
                                    <th scope="col">ساري من</th>
                                    <th scope="col">ساري حتى</th>
                                    <th scope="col">الأولوية</th>
                                    <th scope="col">الحالة</th>
                                    @if (CanManage)
                                    {
                                        <th scope="col" style="width:170px">إجراءات</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Filtered)
                                {
                                    <tr class="@(_editId == r.DriverFreightRuleId ? "row--editing" : "")">
                                        <td class="td-start">
                                            <div class="doc-file-info">
                                                <span class="doc-file-title">@RouteOf(r)</span>
                                                @if (!string.IsNullOrWhiteSpace(r.Notes))
                                                {
                                                    <span class="doc-file-desc">@r.Notes</span>
                                                }
                                            </div>
                                        </td>
                                        <td><span class="tax-badge tax-badge--has">@r.Amount.ToString("N2") ج.م</span></td>
                                        <td>@r.ValidFrom</td>
                                        <td>@(string.IsNullOrWhiteSpace(r.ValidTo) ? "بدون نهاية" : r.ValidTo)</td>
                                        <td>@r.Priority</td>
                                        <td>
                                            <span class="usage-badge @(r.IsActive ? "usage-badge--active" : "usage-badge--zero")">
                                                @(r.IsActive ? "نشطة" : "معطلة")
                                            </span>
                                        </td>
                                        @if (CanManage)
                                        {
                                            <td>
                                                <div class="doc-row-actions">
                                                    <button class="doc-btn-download"
                                                            @onclick="() => OpenEdit(r)"
                                                            title="تعديل" type="button">
                                                        <svg viewBox="0 0 24 24" width="13" height="13"
                                                             fill="none" stroke="currentColor" stroke-width="2.5">
                                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                        </svg>
                                                        تعديل
                                                    </button>
                                                    <button class="doc-btn-download"
                                                            @onclick="() => AskDelete(r)"
                                                            title="حذف" type="button">
                                                        <svg viewBox="0 0 24 24" width="13" height="13"
                                                             fill="none" stroke="currentColor" stroke-width="2.5">
                                                            <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"
                                                                  stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>
                                                        حذف
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                                @if (!Filtered.Any())
                                {
                                    <tr>
                                        <td colspan="@(CanManage ? "7" : "6")">
                                            <div class="doc-empty-table">لا توجد قواعد نولون مطابقة</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* ══════════════ FAB ══════════════ *@
@if (CanManage && !_loading)
{
    @if (_fabOpen)
    {
        <div class="fc-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
    }

    <div class="fc-fab-container">
        <div class="fc-fab-menu @(_fabOpen ? "fc-fab-menu--open" : "")" role="menu">
            <button type="button" class="fc-fab-item" role="menuitem"
                    @onclick="HandleOpenCreate">
                <span class="fc-fab-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/>
                </span>
                <span class="fc-fab-label">قاعدة نولون جديدة</span>
            </button>
            <button type="button" class="fc-fab-item" role="menuitem"
                    @onclick="HandleReload">
                <span class="fc-fab-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"/>
                </span>
                <span class="fc-fab-label">تحديث البيانات</span>
            </button>
        </div>

        <button type="button"
                class="fc-fab-main fc-glow-gold @(_fabOpen ? "is-open" : "")"
                @onclick="ToggleFab"
                aria-label="التحكم"
                aria-expanded="@(_fabOpen ? "true" : "false")">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none"
                 stroke="currentColor" stroke-width="2.5"
                 class="fc-fab-svg" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
}

@* ══════════════ MODAL — إضافة/تعديل ══════════════ *@
@if (_modalOpen && CanManage)
{
    <div class="svc-modal-backdrop" @onclick="CloseModal"
         role="dialog" aria-modal="true">
        <div class="svc-modal" @onclick:stopPropagation="true">

            <div class="svc-modal-head">
                <div class="svc-head-icon @(_editId is null ? "svc-icon-create" : "svc-icon-edit")"
                     aria-hidden="true">
                    @if (_editId is null)
                    {
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="8 12 12 16 16 12"/>
                            <line x1="12" y1="8" x2="12" y2="16"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                    }
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">
                        @(_editId is null ? "إضافة قاعدة نولون جديدة" : "تعديل قاعدة النولون")
                    </div>
                    <div class="svc-head-sub">
                        @if (_editId is null)
                        {
                            <span>حدد المسار والمبلغ وفترة السريان</span>
                        }
                        else
                        {
                            <span>تعديل: <strong>@RouteOf(_editItem!)</strong></span>
                        }
                    </div>
                </div>
                <button class="svc-head-close" @onclick="CloseModal"
                        aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                         stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="svc-banner @(_ok ? "svc-banner-ok" : "svc-banner-err")"
                     role="alert">
                    <div class="svc-banner-ic" aria-hidden="true">
                        @if (_ok)
                        {
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                 stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                            </svg>
                        }
                    </div>
                    <span class="svc-banner-msg">@_msg</span>
                    <button class="svc-banner-x" @onclick="() => _msg = null" type="button">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }

            <div class="svc-modal-body">
                <div class="svc-section">
                    <div class="svc-section-head">
                        <div class="svc-section-ic blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="10" r="3"/>
                                <path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 10-16 0c0 3 2.7 7 8 11.7z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="svc-section-title">المسار</div>
                            <div class="svc-section-sub">
                                اترك البند فارغًا ليعني «أي قيمة» — القاعدة الأخص لها الأولوية
                            </div>
                        </div>
                    </div>

                    <div class="svc-grid">
                        <div class="svc-field">
                            <label class="svc-label" for="fr-port">ميناء السحب</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M2 20a2.4 2.4 0 002 1 2.4 2.4 0 002-1 2.4 2.4 0 012-1 2.4 2.4 0 012 1 2.4 2.4 0 002 1 2.4 2.4 0 002-1 2.4 2.4 0 012-1 2.4 2.4 0 012 1 2.4 2.4 0 002 1 2.4 2.4 0 002-1"/>
                                        <path d="M4 18l-2-7h20l-2 7M12 3v8"/>
                                    </svg>
                                </span>
                                <select id="fr-port" class="svc-input svc-select with-prefix" @bind="_f.PortId">
                                    <option value="">— أي ميناء —</option>
                                    @foreach (var o in _ports)
                                    {
                                        <option value="@o.Id">@o.Label</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="fr-dest">الوجهة</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="10" r="3"/>
                                        <path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 10-16 0c0 3 2.7 7 8 11.7z"/>
                                    </svg>
                                </span>
                                <select id="fr-dest" class="svc-input svc-select with-prefix" @bind="_f.DestinationId">
                                    <option value="">— أي وجهة —</option>
                                    @foreach (var o in _destinations)
                                    {
                                        <option value="@o.Id">@o.Label</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="fr-type">نوع الرحلة</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 6v6l4 2" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <select id="fr-type" class="svc-input svc-select with-prefix" @bind="_f.TripTypeId">
                                    <option value="">— أي نوع —</option>
                                    @foreach (var o in _tripTypes)
                                    {
                                        <option value="@o.Id">@o.Label</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="fr-amount">
                                النولون (ج.م) <span class="svc-req">*</span>
                            </label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="1" x2="12" y2="23"/>
                                        <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                    </svg>
                                </span>
                                <input id="fr-amount" type="number" min="0.01" step="0.01"
                                       class="svc-input ltr with-prefix @(_triedSave && _f.Amount <= 0 ? "svc-err" : "")"
                                       @bind="_f.Amount" dir="ltr" placeholder="0.00"/>
                            </div>
                            @if (_triedSave && _f.Amount <= 0)
                            {
                                <div class="svc-err-msg">النولون يجب أن يكون أكبر من صفر</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="svc-section">
                    <div class="svc-section-head">
                        <div class="svc-section-ic blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2"/>
                                <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div>
                            <div class="svc-section-title">السريان</div>
                            <div class="svc-section-sub">
                                الفترة التي تُطبق فيها القاعدة على الرحلات الجديدة
                            </div>
                        </div>
                    </div>

                    <div class="svc-grid">
                        <div class="svc-field">
                            <label class="svc-label" for="fr-from">
                                ساري من <span class="svc-req">*</span>
                            </label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                                        <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <input id="fr-from" type="date"
                                       class="svc-input ltr with-prefix"
                                       @bind="_f.ValidFrom" dir="ltr"/>
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="fr-to">ساري حتى</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                                        <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <input id="fr-to" type="date"
                                       class="svc-input ltr with-prefix"
                                       @bind="_f.ValidTo" dir="ltr"/>
                            </div>
                            <div class="svc-hint">فارغ = سارية بدون نهاية</div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="fr-priority">الأولوية</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                                <input id="fr-priority" type="number" min="0"
                                       class="svc-input ltr with-prefix"
                                       @bind="_f.Priority" dir="ltr"/>
                            </div>
                            <div class="svc-hint">الرقم الأصغر = أولوية أعلى عند تساوي الأبعاد</div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="fr-active">الحالة</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                        <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                                <select id="fr-active" class="svc-input svc-select with-prefix" @bind="_f.IsActive">
                                    <option value="true">نشطة</option>
                                    <option value="false">معطلة</option>
                                </select>
                            </div>
                        </div>

                        <div class="svc-field" style="grid-column: 1 / -1;">
                            <label class="svc-label" for="fr-notes">ملاحظات</label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                    </svg>
                                </span>
                                <input id="fr-notes" class="svc-input with-prefix"
                                       @bind="_f.Notes" maxlength="200"
                                       placeholder="ملاحظات اختيارية عن القاعدة"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="svc-modal-foot">
                <div class="svc-foot-left">
                    @if (_editId is not null)
                    {
                        <button class="svc-btn-reset" @onclick="ResetForm" type="button">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <polyline points="1 4 1 10 7 10"/>
                                <path d="M3.51 15a9 9 0 102.13-9.36L1 10"/>
                            </svg>
                            إعادة تعيين
                        </button>
                    }
                </div>
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="CloseModal" type="button">
                        إلغاء
                    </button>
                    <button class="svc-btn-save" @onclick="SaveAsync"
                            disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none"
                                 stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>@(_editId is null ? "إضافة القاعدة" : "حفظ التعديلات")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ══════════════ MODAL — تأكيد الحذف ══════════════ *@
@if (_deleteItem is not null && CanManage)
{
    <div class="svc-modal-backdrop" @onclick="() => _deleteItem = null"
         role="dialog" aria-modal="true">
        <div class="svc-modal" style="max-width: 440px;" @onclick:stopPropagation="true">
            <div class="svc-modal-head">
                <div class="svc-head-icon svc-icon-edit" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">تأكيد الحذف</div>
                    <div class="svc-head-sub">
                        سيتم حذف قاعدة <strong>@RouteOf(_deleteItem!)</strong> — الرحلات المسعرة سابقًا لا تتأثر
                    </div>
                </div>
                <button class="svc-head-close" @onclick="() => _deleteItem = null"
                        aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                         stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <div class="svc-modal-foot">
                <div class="svc-foot-left"></div>
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="() => _deleteItem = null" type="button">
                        تراجع
                    </button>
                    <button class="svc-btn-save" @onclick="ConfirmDeleteAsync"
                            disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري الحذف...</span>
                        }
                        else
                        {
                            <span>تأكيد الحذف</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .hero-wrapper {
        padding: 16px clamp(14px, 2.4vw, 34px) 0;
        max-width: var(--fc-page-w, 1440px);
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow: 0 12px 32px rgba(13,38,84,.15), 0 4px 12px rgba(13,38,84,.08);
        border: 1px solid rgba(255,255,255,.08);
    }

    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .fc-overlap { margin-top: 20px !important; position: relative; z-index: 2; }

    .doc-body {
        padding: 18px clamp(16px, 3vw, 40px) 100px;
        max-width: var(--fc-page-w, 1440px);
        margin-inline: auto;
        box-sizing: border-box;
        width: 100%;
        position: relative;
        z-index: 2;
    }

    .doc-card {
        background: #fff;
        border: 1px solid #dde5f0;
        border-radius: 18px;
        box-shadow: 0 4px 24px rgba(15,41,82,.05);
        overflow: hidden;
    }

    .doc-hero-row {
        display: flex; align-items: center;
        justify-content: space-between;
        gap: 16px; flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .doc-hero-left  { display: flex; flex-direction: column; gap: 2px; }

    .doc-hero-crumb {
        display: flex; align-items: center; gap: 5px;
        font-size: 10.5px; font-weight: 700;
        color: rgba(255,255,255,.55);
        margin-bottom: 2px;
    }

    .fc-hero-sub {
        font-size: 10.5px;
        color: rgba(255,255,255,.55);
        font-weight: 600;
    }

    .doc-hero-right {
        display: flex; align-items: center;
        gap: 8px; flex-shrink: 0;
    }

    .doc-hero-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 11px; border-radius: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.14);
        color: rgba(255,255,255,.7);
        font-size: 10.5px; font-weight: 700;
        white-space: nowrap;
    }

    .doc-kpis-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-top: 12px;
    }

    .doc-kpi {
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        backdrop-filter: blur(12px);
        border-radius: 10px;
        padding: 10px 12px;
    }

    .doc-kpi-inner { display: flex; align-items: center; gap: 10px; }

    .doc-kpi-icon {
        width: 34px; height: 34px; border-radius: 9px;
        display: flex; align-items: center;
        justify-content: center; flex-shrink: 0;
    }

    .doc-kpi-blue .doc-kpi-icon  { background: rgba(125,211,252,.15); color: #7dd3fc; }
    .doc-kpi-green .doc-kpi-icon { background: rgba(110,231,183,.15); color: #6ee7b7; }
    .doc-kpi-amber .doc-kpi-icon { background: rgba(251,191,36,.15);  color: #fbbf24; }

    .doc-kpi-data   { flex: 1; min-width: 0; }

    .doc-kpi-num {
        font-size: 18px; font-weight: 900;
        color: #fff; line-height: 1;
    }

    .doc-kpi-label {
        font-size: 10.5px; font-weight: 700;
        color: rgba(255,255,255,.6); margin-top: 3px;
    }

    .doc-banner {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 14px 18px; font-size: 13px; font-weight: 600;
        line-height: 1.6; border-bottom: 1px solid transparent;
    }

    .banner-info {
        background: #f4f8ff; color: #1a56db;
        border-bottom-color: #dbe8fc;
    }

    .banner-icon { flex: 0 0 auto; margin-top: 2px; }

    .doc-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: #fff; border: 1px solid #dde5f0;
        border-radius: 14px; padding: 40px; text-align: center;
    }

    .state-icon-wrap {
        width: 68px; height: 68px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }

    .state-icon-wrap.perm { background: #fff0f2; color: #D64545; }
    .doc-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; }
    .doc-state-box p  { margin: 0; font-size: 13px; color: #6B7A8F; }

    .doc-toolbar {
        display: flex; align-items: center;
        justify-content: space-between; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg,#fff,#fafbfd);
        border-bottom: 1px solid #edf1f7;
        flex-wrap: wrap;
    }

    .doc-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 0 1 280px; min-width: 180px;
    }

    .doc-search-icon {
        position: absolute; right: 10px;
        color: #9aaabb; pointer-events: none;
    }

    .doc-search-input {
        width: 100%; height: 36px;
        padding: 0 32px 0 10px;
        border: 1px solid #d8e2f0; border-radius: 8px;
        background: #fafcff;
        font-family: inherit; font-size: 12px; outline: none;
    }

    .doc-search-input:focus {
        border-color: #0B56DF;
        box-shadow: 0 0 0 3px rgba(11,86,223,.08);
    }

    .doc-search-clear {
        position: absolute; left: 8px;
        display: flex; align-items: center; justify-content: center;
        width: 20px; height: 20px; border-radius: 50%;
        border: none; background: #edf1f7;
        color: #8899ae; cursor: pointer;
    }

    .doc-results-badge {
        display: flex; align-items: center; gap: 5px;
        font-size: 11px; color: #8899ae; font-weight: 600;
    }

    .doc-results-badge strong { color: #5a6e88; }

    .doc-table-wrap { overflow-x: auto; }

    .doc-table {
        width: 100%; border-collapse: collapse; font-size: 13px;
    }

    .doc-table thead th {
        padding: 11px 14px;
        background: linear-gradient(180deg,#f7f9fc,#f0f3f8);
        color: #4a5a74; font-size: 11px; font-weight: 800;
        text-align: center;
        border-bottom: 2px solid #e4eaf3;
        white-space: nowrap;
    }

    .doc-table .th-start { text-align: right; }

    .doc-table tbody tr {
        border-bottom: 1px solid #f0f3f8;
        transition: background .12s;
    }

    .doc-table tbody tr:last-child { border-bottom: none; }
    .doc-table tbody tr:hover      { background: #fafcff; }
    .doc-table tbody tr.row--editing { background: #f0f6ff !important; }

    .doc-table tbody td {
        padding: 12px 14px; color: #526070;
        text-align: center; vertical-align: middle;
    }

    .td-start { text-align: right !important; }
    .td-muted  { color: #8899ae; font-size: 11.5px; }

    .doc-type-badge {
        display: inline-flex; padding: 2.5px 10px; border-radius: 6px;
        background: #f0f4fa; border: 1px solid #e0e8f4;
        font-size: 10.5px; font-weight: 800; color: #344258;
        font-family: 'Courier New', monospace;
        letter-spacing: .5px;
    }

    .doc-file-info  { display: flex; flex-direction: column; gap: 2px; }
    .doc-file-title { font-size: 13px; font-weight: 700; color: #1A2332; }
    .doc-file-desc  { font-size: 11px; color: #8899ae; }

    .tax-badge {
        display: inline-block;
        padding: 3px 10px; border-radius: 20px;
        font-size: 11px; font-weight: 700;
    }

    .tax-badge--none { background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0; }
    .tax-badge--has  { background: #dcfce7; color: #16a34a; border: 1px solid #bbf7d0; }

    .usage-badge {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 28px; height: 24px; padding: 0 8px;
        border-radius: 20px; font-size: 12px; font-weight: 700;
    }

    .usage-badge--active { background: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .usage-badge--zero   { background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0; }

    .doc-row-actions {
        display: flex; align-items: center;
        gap: 6px; justify-content: center;
    }

    .doc-btn-download {
        display: inline-flex; align-items: center; gap: 4px;
        height: 28px; padding: 0 10px;
        border: 1px solid #bdd4fc; border-radius: 6px;
        background: #eaf1ff; color: #0B56DF;
        font-family: inherit; font-size: 10.5px; font-weight: 800;
        cursor: pointer; transition: all .12s;
    }

    .doc-btn-download:hover { background: #0B56DF; color: #fff; }

    .doc-empty-table {
        padding: 40px; text-align: center;
        color: #9aaabb; font-size: 13px; font-weight: 700;
    }

    .doc-loading {
        display: flex; align-items: center; justify-content: center;
        gap: 10px; min-height: 200px;
        color: #6B7A8F; font-size: 12.5px; font-weight: 700;
    }

    .doc-spinner {
        width: 28px; height: 28px;
        border: 2.5px solid #dde5f0;
        border-top-color: #0B56DF;
        border-radius: 50%;
        animation: doc-spin .7s linear infinite;
    }

    @@keyframes doc-spin { to { transform: rotate(360deg); } }

    /* ══════ FAB ══════ */
    .fc-fab-scrim {
        position: fixed; inset: 0;
        background: rgba(0,0,0,.25);
        backdrop-filter: blur(3px);
        z-index: 1200;
    }

    .fc-fab-container {
        position: fixed;
        left: 28px; bottom: 28px;
        z-index: 1300;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .fc-fab-menu {
        display: flex; flex-direction: column; gap: 8px;
        margin-bottom: 12px;
        opacity: 0; visibility: hidden;
        pointer-events: none;
        transform: translateY(8px);
        transition: opacity .22s ease, transform .22s ease, visibility .22s;
    }

    .fc-fab-menu--open {
        opacity: 1; visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
    }

    .fc-fab-item {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 16px; border-radius: 12px;
        background: #fff; border: 1.5px solid #dde5f0;
        box-shadow: 0 4px 16px rgba(0,0,0,.12);
        cursor: pointer; font-size: 13px; font-weight: 600;
        color: #1c2c44; font-family: inherit;
        transition: background .15s, border-color .15s, transform .15s;
        white-space: nowrap; width: 100%;
    }

    .fc-fab-item:hover {
        background: #f4f7fb;
        border-color: #0B56DF;
        transform: translateX(2px);
    }

    .fc-fab-icon {
        display: flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 8px;
        background: #eaf1ff; color: #0B56DF; flex-shrink: 0;
    }

    .fc-fab-main {
        width: 60px; height: 60px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; border: none;
        transition: transform .2s, box-shadow .2s;
        position: relative;
    }

    .fc-fab-main:hover { transform: scale(1.06); }

    .fc-fab-svg {
        transition: transform .3s cubic-bezier(.34,1.56,.64,1);
    }

    .fc-fab-main.is-open .fc-fab-svg { transform: rotate(135deg); }

    .fc-glow-gold {
        background: linear-gradient(135deg, #0B56DF 0%, #083CA8 100%) !important;
        border: 2px solid #FF8015 !important;
        color: #fff;
        box-shadow: 0 4px 16px rgba(11,86,223,.4);
        animation: fc-gold-pulse 2.2s infinite;
    }

    .fc-glow-gold::before {
        content: "";
        position: absolute; inset: -2px;
        border-radius: 50%;
        border: 2px solid #FF8015;
        opacity: 0; pointer-events: none;
        animation: fc-ring-expand 2.2s cubic-bezier(.24,0,.38,1) infinite;
    }

    @@keyframes fc-gold-pulse {
        0%,100% { box-shadow: 0 0 0 0 rgba(255,128,21,.6), 0 8px 24px rgba(11,86,223,.4); }
        50%     { box-shadow: 0 0 0 12px rgba(255,128,21,0), 0 12px 32px rgba(11,86,223,.55); }
    }

    @@keyframes fc-ring-expand {
        0%   { transform: scale(1); opacity: .8; border-width: 3px; }
        100% { transform: scale(1.6); opacity: 0; border-width: 1px; }
    }

    .fc-glow-gold.is-open {
        background: linear-gradient(135deg, #D64545 0%, #991b1b 100%) !important;
        border-color: #fca5a5 !important;
        animation: none !important;
    }

    .fc-glow-gold.is-open::before { animation: none !important; }

    /* ══════ MODAL ══════ */
    .svc-modal-backdrop {
        position: fixed; inset: 0; z-index: 1400;
        background: rgba(10,27,59,.62);
        backdrop-filter: blur(6px);
        display: flex; align-items: center; justify-content: center;
        padding: 20px;
        animation: svc-fade .2s ease both;
    }

    @@keyframes svc-fade { from { opacity: 0; } to { opacity: 1; } }

    .svc-modal {
        width: 100%; max-width: 560px;
        background: #fff; border-radius: 20px;
        box-shadow: 0 25px 60px rgba(10,27,59,.28), 0 8px 20px rgba(10,27,59,.12);
        overflow: hidden;
        animation: svc-pop .28s cubic-bezier(.22,.9,.36,1.1) both;
        max-height: 92vh;
        display: flex; flex-direction: column;
    }

    @@keyframes svc-pop {
        from { opacity: 0; transform: translateY(20px) scale(.96); }
        to   { opacity: 1; transform: none; }
    }

    .svc-modal-head {
        display: flex; align-items: center; gap: 14px;
        padding: 20px 24px;
        background: linear-gradient(135deg, #0A1B3B 0%, #16306B 100%);
        color: #fff; flex: 0 0 auto;
        position: relative; overflow: hidden;
    }

    .svc-modal-head::before {
        content: "";
        position: absolute; top: -50px; right: -50px;
        width: 200px; height: 200px; border-radius: 50%;
        background: radial-gradient(circle, rgba(255,128,21,.15) 0%, transparent 70%);
        pointer-events: none;
    }

    .svc-head-icon {
        width: 46px; height: 46px; flex: 0 0 46px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 13px; position: relative; z-index: 1;
    }

    .svc-icon-create {
        background: rgba(27,158,94,.2); color: #6ee7b7;
        border: 1px solid rgba(110,231,183,.3);
    }

    .svc-icon-edit {
        background: rgba(255,128,21,.2); color: #FFD9B8;
        border: 1px solid rgba(255,128,21,.3);
    }

    .svc-head-text  { flex: 1; min-width: 0; position: relative; z-index: 1; }
    .svc-head-title { font-size: 16px; font-weight: 800; color: #fff; line-height: 1.3; }
    .svc-head-sub   { font-size: 11.5px; color: rgba(255,255,255,.62); margin-top: 3px; }
    .svc-head-sub strong { color: #FFD9B8; font-weight: 700; }

    .svc-head-close {
        width: 34px; height: 34px; flex: 0 0 34px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255,255,255,.15); border-radius: 9px;
        background: rgba(255,255,255,.06); color: rgba(255,255,255,.7);
        cursor: pointer; transition: all .15s; position: relative; z-index: 1;
    }

    .svc-head-close:hover {
        background: rgba(255,255,255,.14);
        color: #fff; transform: rotate(90deg);
    }

    .svc-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 20px; flex: 0 0 auto;
        font-size: 12.5px; font-weight: 600;
    }

    .svc-banner-ok  { background: #e9f8f0; color: #0e7a43; border-bottom: 1px solid #b5e8d0; }
    .svc-banner-err { background: #fff0f2; color: #D64545; border-bottom: 1px solid #ffc8cf; }
    .svc-banner-ic  { flex: 0 0 auto; }
    .svc-banner-msg { flex: 1; }

    .svc-banner-x {
        background: none; border: none;
        color: inherit; opacity: .5;
        cursor: pointer; display: flex;
    }

    .svc-banner-x:hover { opacity: 1; }

    .svc-modal-body { flex: 1 1 auto; overflow-y: auto; padding: 0; }

    .svc-section { padding: 22px 24px 26px; }

    .svc-section-head {
        display: flex; align-items: flex-start; gap: 12px;
        margin-bottom: 20px; padding-bottom: 16px;
        border-bottom: 1px solid #edf1f7;
    }

    .svc-section-ic {
        width: 40px; height: 40px; flex: 0 0 40px;
        display: flex; align-items: center;
        justify-content: center; border-radius: 11px;
    }

    .svc-section-ic.blue {
        background: #eaf1ff; color: #0B56DF;
        border: 1px solid #bdd4fc;
    }

    .svc-section-title { font-size: 14.5px; font-weight: 800; color: #1A2332; line-height: 1.2; }
    .svc-section-sub   { font-size: 11px; font-weight: 500; color: #6B7A8F; margin-top: 3px; }

    .svc-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .svc-field  { display: flex; flex-direction: column; gap: 5px; }

    .svc-label {
        font-size: 11.5px; font-weight: 800; color: #344258;
        display: flex; align-items: center; gap: 4px;
    }

    .svc-req { color: #D64545; font-size: 13px; }

    .svc-input-wrap {
        position: relative; display: flex; align-items: center;
    }

    .svc-prefix {
