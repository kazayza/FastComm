    .svc-btn-save:disabled { opacity: .6; cursor: not-allowed; }

    .svc-spinner {
        width: 15px; height: 15px;
        border: 2px solid rgba(255,255,255,.3);
        border-top-color: #fff; border-radius: 50%;
        animation: doc-spin .7s linear infinite;
    }

    @@media (max-width: 900px) {
        .doc-toolbar { flex-direction: column; align-items: stretch; gap: 10px; }
        .doc-search-wrap { width: 100% !important; flex: 1 1 100%; }
        .svc-grid { grid-template-columns: 1fr; }
        .doc-kpis-row { grid-template-columns: repeat(2, 1fr); }
