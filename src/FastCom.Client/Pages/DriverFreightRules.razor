    .svc-foot-right { margin-right: auto; }

    .svc-btn-reset {
        display: inline-flex; align-items: center; gap: 5px;
        height: 38px; padding: 0 14px;
        border: 1px solid #fde68a; border-radius: 9px;
        background: #fffbeb; color: #92400e;
        font-family: inherit; font-size: 11.5px; font-weight: 800;
        cursor: pointer; transition: all .15s;
    }

    .svc-btn-reset:hover { background: #fef3c7; border-color: #fbbf24; }

    .svc-btn-cancel {
        height: 38px; padding: 0 16px;
        border: 1.5px solid #d8e2f0; border-radius: 9px;
        background: #fff; color: #6B7A8F;
        font-family: inherit; font-size: 12px; font-weight: 700;
        cursor: pointer; transition: all .15s;
    }

    .svc-btn-cancel:hover {
        background: #f0f4fa; color: #1A2332; border-color: #c0ccd8;
    }

    .svc-btn-save {
        display: inline-flex; align-items: center; gap: 7px;
