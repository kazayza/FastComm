@page "/drivers"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>السائقين — فاست كوم</PageTitle>


<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">البيانات الأساسية · الأسطول</div>
                <h1 class="fc-hero-title">السائقين</h1>
                <p class="fc-hero-sub">داخلي (موظفين) وخارجي (موردين) — مع الرخص والحالات</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="GoNew">سائق جديد</MudButton>
                }
            </div>
        </div>

        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.Badge" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">إجمالي السائقين</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(d => d.Status == "Active")</div><div class="fc-kpi-lb">نشط</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div><div class="fc-kpi-num">@ExpiringSoon</div><div class="fc-kpi-lb">رخص تنتهي خلال 30 يوم</div></div>
                </div>
            </div>
        }
    </div>
</div>


<div class="dr-body">

    @if (!CanView)
    {
        <div class="dr-state-box">
            <div class="dr-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض السائقين</p>
        </div>
    }
    else
    {
        <div class="dr-card">

            <div class="dr-toolbar">
                <div class="dr-search-wrap">
                    <svg class="dr-search-icon" viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="dr-search-input"
                           placeholder="ابحث بالاسم أو الكود..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="dr-search-clear"
                                @onclick="() => _search = string.Empty">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="dr-type-filters" role="group" aria-label="فلتر النوع">
                    <button class="dr-type-btn @(_typeFilter == "all" ? "active" : "")"
                            @onclick='() => _typeFilter = "all"'>
                        الكل
                        <span class="dr-type-count">@_items.Count</span>
                    </button>
                    <button class="dr-type-btn @(_typeFilter == "Internal" ? "active-blue" : "")"
                            @onclick='() => _typeFilter = "Internal"'>
                        👔 داخلي
                        <span class="dr-type-count">@_items.Count(d => d.DriverType == "Internal")</span>
                    </button>
                    <button class="dr-type-btn @(_typeFilter == "External" ? "active-purple" : "")"
                            @onclick='() => _typeFilter = "External"'>
                        🚗 خارجي
                        <span class="dr-type-count">@_items.Count(d => d.DriverType == "External")</span>
                    </button>
                </div>

                <div class="dr-results-badge">
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>
            </div>

            @if (_loading)
            {
                <div class="dr-loading">
                    <div class="dr-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل السائقين...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="dr-empty">
                    <div class="dr-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="42" height="42"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div class="dr-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) ? "لا يوجد سائقين" : "لا توجد نتائج")
                    </div>
                    <div class="dr-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search) ? "ابدأ بإضافة أول سائق" : "جرّب كلمة بحث مختلفة")
                    </div>
                    @if (CanCreate && string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="dr-add-btn" @onclick="GoNew">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            سائق جديد
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="dr-table-wrap">
                    <table class="dr-table" aria-label="قائمة السائقين">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">السائق</th>
                                <th scope="col">النوع</th>
                                <th scope="col">الموبايل</th>
                                <th scope="col">الرخصة</th>
                                <th scope="col">الحالة</th>
                                @if (CanEdit)
                                {
                                    <th scope="col" style="width:110px">إجراءات</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Filtered)
                            {
                                var licStatus = GetLicStatus(d.LicenseExpiryDate);

                                <tr class="@(d.Status != "Active" ? "row-inactive" : "")">

                                    <td class="td-start">
                                        <div class="dr-driver-cell">
                                            <div class="dr-avatar @(d.DriverType == "Internal" ? "av-blue" : "av-purple")"
                                                 aria-hidden="true">
                                                @(d.FullName.Length > 0 ? d.FullName[0].ToString() : "؟")
                                            </div>
                                            <div class="dr-driver-info">
                                                <div class="dr-driver-name">@d.FullName</div>
                                                <span class="dr-code-chip">@d.DriverCode</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        @if (d.DriverType == "Internal")
                                        {
                                            <span class="dr-chip chip-blue">👔 داخلي</span>
                                        }
                                        else
                                        {
                                            <span class="dr-chip chip-purple">🚗 خارجي</span>
                                        }
                                    </td>

                                    <td class="td-muted" dir="ltr">@(d.Mobile ?? "—")</td>

                                    <td>
                                        @if (d.LicenseExpiryDate is null)
                                        {
                                            <span class="td-muted">—</span>
                                        }
                                        else if (licStatus == "expired")
                                        {
                                            <span class="dr-chip chip-red">
                                                <span class="dr-chip-dot dot-red" aria-hidden="true"></span>
                                                منتهية
                                            </span>
                                        }
                                        else if (licStatus == "soon")
                                        {
                                            <span class="dr-chip chip-amber">
                                                <span class="dr-chip-dot dot-amber" aria-hidden="true"></span>
                                                ⚠️ @d.LicenseExpiryDate.Value.ToString("yyyy-MM-dd")
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="dr-lic-date">
                                                <svg viewBox="0 0 16 16" width="10" height="10"
                                                     fill="none" stroke="currentColor" stroke-width="1.7"
                                                     aria-hidden="true">
                                                    <rect x="2" y="3" width="12" height="11" rx="2"/>
                                                    <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                                                </svg>
                                                @d.LicenseExpiryDate.Value.ToString("yyyy-MM-dd")
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @{
                                            var (cls, label) = d.Status switch
                                            {
                                                "Active"    => ("chip-green",  "نشط"),
                                                "Suspended" => ("chip-red",    "موقوف"),
                                                _           => ("chip-gray",   "غير نشط")
                                            };
                                        }
                                        <span class="dr-chip @cls">
                                            <span class="dr-chip-dot @(d.Status == "Active" ? "dot-green" : d.Status == "Suspended" ? "dot-red" : "dot-gray")"
                                                  aria-hidden="true"></span>
                                            @label
                                        </span>
                                    </td>

                                    @if (CanEdit)
                                    {
                                        <td>
                                            <div class="dr-actions">
                                                <button class="dr-act-btn act-edit"
                                                        @onclick="() => GoEdit(d)"
                                                        title="تعديل"
                                                        aria-label="تعديل @d.FullName">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                                @if (CanDelete)
                                                {
                                                    @if (_confirmId == d.DriverId)
                                                    {
                                                        <button class="dr-confirm-del"
                                                                @onclick="() => Delete(d)">
                                                            حذف؟
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="dr-act-btn act-delete"
                                                                @onclick="() => _confirmId = d.DriverId"
                                                                title="حذف"
                                                                aria-label="حذف @d.FullName">
                                                            <svg viewBox="0 0 24 24" width="14" height="14"
                                                                 fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                            </svg>
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    .dr-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1200px; width: 100%; margin: 0 auto;
    }

    .dr-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .dr-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .dr-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .dr-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .dr-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    .dr-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    /* Toolbar */
    .dr-toolbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7; flex-wrap: wrap;
    }

    .dr-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px; max-width: 360px;
    }
    .dr-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }
    .dr-search-input {
        width: 100%; height: 38px; padding: 0 36px 0 12px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .dr-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .dr-search-input::placeholder { color: #b0bcc8; }
    .dr-search-clear {
        position: absolute; left: 10px;
        display: flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        border: none; background: #edf1f7; color: #8899ae; cursor: pointer;
    }

    .dr-type-filters {
        display: flex; gap: 4px; padding: 3px;
        border-radius: 9px; background: #f0f3f8;
    }

    .dr-type-btn {
        display: flex; align-items: center; gap: 5px;
        height: 32px; padding: 0 10px;
        border: none; border-radius: 7px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 11px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .dr-type-btn:hover:not(.active):not(.active-blue):not(.active-purple) {
        background: rgba(255,255,255,.6); color: var(--fc-text);
    }
    .dr-type-btn.active      { background: var(--fc-card); color: var(--fc-text); box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800; }
    .dr-type-btn.active-blue { background: var(--fc-card); color: var(--fc-blue); box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800; }
    .dr-type-btn.active-purple { background: var(--fc-card); color: var(--fc-purple); box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800; }

    .dr-type-count {
        min-width: 16px; height: 16px; border-radius: 4px; padding: 0 3px;
        display: flex; align-items: center; justify-content: center;
        font-size: 9px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
        background: #e4eaf3; color: #8899ae;
    }
    .active .dr-type-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .active-blue .dr-type-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .active-purple .dr-type-count { background: var(--fc-purple-lt); color: var(--fc-purple); }

    .dr-results-badge {
        display: flex; align-items: center; gap: 5px;
        margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap;
    }
    .dr-results-badge strong { color: #5a6e88; }

    /* Loading / Empty */
    .dr-loading {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 200px; color: var(--fc-muted); font-size: 12px; font-weight: 600;
    }
    .dr-spinner {
        width: 32px; height: 32px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: dr-spin .75s linear infinite;
    }
    @@keyframes dr-spin { to { transform: rotate(360deg); } }

    .dr-empty {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 10px; min-height: 240px; padding: 40px; text-align: center;
    }
    .dr-empty-icon { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f4fa; color: #b0c4d8; }
    .dr-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .dr-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    .dr-add-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; margin-top: 6px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; transition: all .15s ease;
    }
    .dr-add-btn:hover { background: var(--fc-blue); color: #fff; }

    /* Table */
    .dr-table-wrap { overflow-x: auto; }
    .dr-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }

    .dr-table thead th {
        padding: 10px 12px;
        background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 10.5px; font-weight: 800;
        text-align: center; border-bottom: 2px solid #e4eaf3;
        white-space: nowrap; position: sticky; top: 0; z-index: 1;
    }
    .dr-table .th-start { text-align: right; }

    .dr-table tbody tr { border-bottom: 1px solid #f0f3f8; transition: background .12s ease; }
    .dr-table tbody tr:last-child { border-bottom: none; }
    .dr-table tbody tr:hover { background: #fafcff; }
    .dr-table tbody tr.row-inactive { opacity: .6; }

    .dr-table tbody td { padding: 11px 12px; color: #526070; text-align: center; vertical-align: middle; }
    .td-start { text-align: right !important; }
    .td-muted { color: #8899ae; font-size: 11px; }

    /* Driver Cell */
    .dr-driver-cell { display: flex; align-items: center; gap: 10px; }

    .dr-avatar {
        width: 38px; height: 38px; flex: 0 0 38px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; font-weight: 800; color: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,.10);
    }
    .av-blue   { background: linear-gradient(135deg, #1558d6, #1e6ef5); }
    .av-purple { background: linear-gradient(135deg, #6035a0, #7c4dbd); }

    .dr-driver-name  { font-size: 13px; font-weight: 800; color: #1c2c44; }
    .dr-code-chip {
        display: inline-flex; padding: 1px 7px; border-radius: 5px;
        background: #f0f4fa; border: 1px solid #e0e8f4;
        font-size: 10px; font-weight: 800; color: #5a6e88;
        font-family: "Inter", Arial, sans-serif; margin-top: 3px;
    }

    /* Chips */
    .dr-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 9px; border-radius: 7px;
        font-size: 10.5px; font-weight: 800; white-space: nowrap;
    }
    .dr-chip-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; }

    .chip-blue   { background: var(--fc-blue-lt);   color: var(--fc-blue);   border: 1px solid #c0d4fb; }
    .chip-purple { background: var(--fc-purple-lt); color: var(--fc-purple); border: 1px solid #d0bfef; }
    .chip-green  { background: var(--fc-green-lt);  color: var(--fc-green);  border: 1px solid #b0e0c5; }
    .chip-red    { background: var(--fc-red-lt);    color: var(--fc-red);    border: 1px solid #ffc8cf; }
    .chip-amber  { background: var(--fc-amber-lt);  color: #9a6d08;          border: 1px solid #f0d898; }
    .chip-gray   { background: #f0f3f8;             color: #6b7d95;          border: 1px solid #dde5f0; }

    .dot-green { background: var(--fc-green); }
    .dot-red   { background: var(--fc-red); }
    .dot-amber { background: var(--fc-amber); }
    .dot-gray  { background: #9aaabb; }

    .dr-lic-date { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #6b7d95; justify-content: center; }

    /* Actions */
    .dr-actions { display: flex; align-items: center; gap: 4px; justify-content: center; }

    .dr-act-btn {
        width: 30px; height: 30px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; cursor: pointer;
        transition: all .15s ease; background: transparent;
    }
    .act-edit   { color: var(--fc-blue); }
    .act-delete { color: var(--fc-red); }
    .act-edit:hover   { background: var(--fc-blue-lt); border-color: #c0d4fb; }
    .act-delete:hover { background: var(--fc-red-lt);  border-color: #ffc8cf; }

    .dr-confirm-del {
        height: 26px; padding: 0 9px;
        border: none; border-radius: 6px;
        background: linear-gradient(135deg, #e03048, #c0182e);
        color: #fff; font-family: inherit;
        font-size: 9.5px; font-weight: 800; cursor: pointer;
        animation: dr-pulse 1s ease infinite;
    }
    @@keyframes dr-pulse {
        0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.35); }
        50%     { box-shadow: 0 0 0 5px rgba(224,48,72,0); }
    }

    @@media (max-width: 900px) {
        .dr-toolbar { flex-direction: column; align-items: stretch; }
        .dr-search-wrap { max-width: 100%; }
        .dr-results-badge { margin-right: 0; }
    }

