@page "/drivers"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>السائقين — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">البيانات الأساسية · الأسطول</div>
                <h1 class="fc-hero-title">السائقين</h1>
                <p class="fc-hero-sub">داخلي (موظفين) وخارجي (موردين) — مع الرخص والحالات</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="GoNew">سائق جديد</MudButton>
                }
            </div>
        </div>
        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.Badge" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">إجمالي السائقين</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(d => d.Status == "Active")</div><div class="fc-kpi-lb">نشط</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div><div class="fc-kpi-num">@ExpiringSoon</div><div class="fc-kpi-lb">رخص تنتهي خلال 30 يوم</div></div></div>
            </div>
        }
    </div>
</div>

<div class="fc-page">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">ليس لديك صلاحية عرض السائقين.</MudAlert>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">
            <div class="fc-toolbar">
                <MudTextField T="string" Value="_search" ValueChanged="v => _search = v"
                              Placeholder="ابحث بالاسم أو الكود..." Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="fc-search-box" Immediate="true" />
                <span class="fc-count">عرض @Filtered.Count() من @_items.Count</span>
            </div>
            @if (_loading)
            {
                <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else
            {
                <div class="fc-table-wrap"><table class="fc-table fc-table-pro">
                    <thead><tr><th>الكود</th><th>الاسم</th><th>النوع</th><th>الموبايل</th><th>انتهاء الرخصة</th><th>الحالة</th>
                        @if (CanEdit) { <th style="width:120px; text-align:left">إجراءات</th> }</tr></thead>
                    <tbody>
                        @foreach (var d in Filtered)
                        {
                            <tr>
                                <td><span class="fc-role-chip">@d.DriverCode</span></td>
                                <td><div class="fc-cell-main">@d.FullName</div></td>
                                <td>@if (d.DriverType == "Internal") { <span class="fc-chip fc-chip-blue"><i></i>داخلي</span> }
                                    else { <span class="fc-chip fc-chip-purple"><i></i>خارجي</span> }</td>
                                <td class="fc-cell-sub">@(d.Mobile ?? "—")</td>
                                <td>
                                    @if (d.LicenseExpiryDate is null) { <span class="fc-cell-sub">—</span> }
                                    else if (d.LicenseExpiryDate.Value < DateOnly.FromDateTime(DateTime.Today))
                                    { <span class="fc-chip fc-chip-bad"><i></i>منتهية</span> }
                                    else if (d.LicenseExpiryDate.Value <= DateOnly.FromDateTime(DateTime.Today.AddDays(30)))
                                    { <span class="fc-chip fc-chip-warn"><i></i>@d.LicenseExpiryDate.Value.ToString("yyyy-MM-dd")</span> }
                                    else { <span class="fc-cell-sub">@d.LicenseExpiryDate.Value.ToString("yyyy-MM-dd")</span> }
                                </td>
                                <td>@(d.Status == "Active" ? "نشط" : d.Status == "Suspended" ? "موقوف" : "غير نشط")</td>
                                @if (CanEdit)
                                {
                                    <td><div class="fc-row-actions">
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => GoEdit(d)" />
                                        @if (_confirmId == d.DriverId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => Delete(d)">متأكد؟</MudButton>
                                        }
                                        else if (CanDelete)
                                        {
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => _confirmId = d.DriverId" />
                                        }
                                    </div></td>
                                }
                            </tr>
                        }
                        @if (!Filtered.Any())
                        {
                            <tr><td colspan="7"><div class="fc-empty"><div>لايوجد اى سائقين على النظام</div></div></td></tr>
                        }
                    </tbody>
                </table></div>
            }
        </div></div>
    }

</div>

@code {
    private AuthUser? _user;
    private bool CanView => _user?.Can("DRIVER.VIEW") ?? false;
    private bool CanCreate => _user?.Can("DRIVER.CREATE") ?? false;
    private bool CanEdit => _user?.Can("DRIVER.EDIT") ?? false;
    private bool CanDelete => _user?.Can("DRIVER.DELETE") ?? false;

    private List<Item> _items = new();
    private bool _loading; private string _search = ""; private int? _confirmId;


    public class Item { public int DriverId { get; set; } public string DriverCode { get; set; } = "";
        public string DriverType { get; set; } = ""; public string FullName { get; set; } = "";
        public string? Mobile { get; set; } public DateOnly? LicenseExpiryDate { get; set; } public string Status { get; set; } = ""; }


    private int ExpiringSoon => _items.Count(d =>
        d.LicenseExpiryDate is not null && d.LicenseExpiryDate.Value > DateOnly.FromDateTime(DateTime.Today) &&
        d.LicenseExpiryDate.Value <= DateOnly.FromDateTime(DateTime.Today.AddDays(30)));

    private IEnumerable<Item> Filtered => string.IsNullOrWhiteSpace(_search) ? _items :
        _items.Where(d => d.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                          d.DriverCode.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    /* 🔴 الفورم بقى شاشة مستقلة — `/drivers/new` */
    private void GoNew() => Nav.NavigateTo("/drivers/new");
    private void GoEdit(Item d) => Nav.NavigateTo($"/drivers/new/{d.DriverId}");

    private async Task Reload() { await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/drivers") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }



    private async Task Delete(Item d)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/drivers/{d.DriverId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
