    @@media (prefers-reduced-motion: reduce) {
        .glow-halo, .glow-ring { animation: none; }
        .glow-halo { opacity: 0.5; }
    }
</style>

@code {
    private AuthUser? _user;
    private bool CanManage => _user?.Can("ROLE.MANAGE") ?? false;

    private List<RoleItem>   _roles   = new();
    private List<PermModule> _catalog = new();
    private bool   _loading;
    private string? _loadError;

    private RoleItem?      _sel;
    private int?           _selId;
    private HashSet<int>   _selIds = new();
    private bool           _saving;

    /* FAB */
    private bool _fabOpen;

    /* Modal */
    private bool    _roleModalOpen;
    private int?    _editId;
    private bool    _editIsSystem;
    private string  _roleCode   = "";
    private string  _roleNameAr = "";
    private string? _roleNameEn;
    private bool    _roleActive = true;
    private bool    _roleSaving;
    private string? _roleMsg;
    private bool    _roleOk;
    private bool    _confirmDel;

    /* DTOs */
    public class RoleItem
    {
        public int    Id              { get; set; }
        public string RoleCode        { get; set; } = "";
        public string NameAr          { get; set; } = "";
        public string? NameEn         { get; set; }
        public bool   IsSystem        { get; set; }
        public bool   IsActive        { get; set; }
        public int    UserCount       { get; set; }
        public int    PermissionCount { get; set; }
    }

    public class PermItem
    {
        public int    PermissionId   { get; set; }
        public string PermissionCode { get; set; } = "";
        public string NameAr         { get; set; } = "";
    }

    public class PermModule
    {
        public string         ModuleCode { get; set; } = "";
        public List<PermItem> Items      { get; set; } = new();
    }

    private int TotalPerms        => _catalog.Sum(m => m.Items.Count);
    private int TotalUsersOnRoles => _roles.Sum(r => r.UserCount);
    private int SelCount          => _selIds.Count;
    private int ModCount(PermModule m) => m.Items.Count(i => _selIds.Contains(i.PermissionId));

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanManage) await LoadAsync();
    }

    private async Task Reload()
    {
        _fabOpen = false;
        await LoadAsync();
        Snackbar.Add("تم التحديث بنجاح", Severity.Success);
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            _roles   = await Http.GetFromJsonAsync<List<RoleItem>>("api/roles")       ?? new();
            _catalog = await Http.GetFromJsonAsync<List<PermModule>>("api/permissions") ?? new();

            if (_selId is not null)
            {
                _sel = _roles.FirstOrDefault(r => r.Id == _selId);
                if (_sel is not null) await LoadMatrix(_sel);
            }
            else if (_roles.Any())
            {
                await SelectRole(_roles.First());
            }
        }
        catch (Exception ex)
        {
            _loadError = "فشل التحميل: " + ex.Message;
            Snackbar.Add(_loadError, Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task SelectRole(RoleItem r)
    {
        _selId = r.Id; _sel = r;
        await LoadMatrix(r);
    }

    private async Task LoadMatrix(RoleItem r)
    {
        _selIds = new();
        if (r.IsSystem) return;
        try
        {
            var ids = await Http.GetFromJsonAsync<List<int>>($"api/roles/{r.Id}/permissions");
            _selIds = ids is null ? new() : ids.ToHashSet();
        }
        catch { _selIds = new(); }
    }

    private void TogglePerm(int pid, bool v)
    {
        if (v) _selIds.Add(pid); else _selIds.Remove(pid);
    }

    private void ToggleModule(PermModule m)
    {
        if (ModCount(m) == m.Items.Count)
            foreach (var i in m.Items) _selIds.Remove(i.PermissionId);
        else
            foreach (var i in m.Items) _selIds.Add(i.PermissionId);
    }

    private async Task SaveMatrixAsync()
    {
        if (_sel is null || _sel.IsSystem) return;
        _saving = true;
        try
        {
            var res = await Http.PutAsJsonAsync($"api/roles/{_sel.Id}/permissions", _selIds.ToList());
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل الحفظ: " + ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task SaveMatrixWithFab()
    {
        _fabOpen = false;
        await SaveMatrixAsync();
    }

    /* ── FAB States ── */
    private void ToggleFab() => _fabOpen = !_fabOpen;
    private void CloseFab() => _fabOpen = false;
    private void OnFabKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") _fabOpen = false; }

    /* ── Modal ── */
    private void OpenCreate()
    {
        _fabOpen = false;
        _editId = null; _editIsSystem = false;
        _roleCode = _roleNameAr = ""; _roleNameEn = null;
        _roleActive = true; _roleMsg = null; _confirmDel = false;
        _roleModalOpen = true;
    }

    private void OpenEdit()
    {
        if (_sel is null) return;
        _editId = _sel.Id; _editIsSystem = _sel.IsSystem;
        _roleCode = _sel.RoleCode; _roleNameAr = _sel.NameAr;
        _roleNameEn = _sel.NameEn; _roleActive = _sel.IsActive;
        _roleMsg = null; _confirmDel = false;
        _roleModalOpen = true;
    }

    private void CloseRoleModal() { _roleModalOpen = false; }

    private async Task SaveRoleAsync()
    {
        if (string.IsNullOrWhiteSpace(_roleNameAr))
        { _roleOk = false; _roleMsg = "الاسم العربي مطلوب"; return; }

        _roleSaving = true; _roleMsg = null;
        try
        {
            HttpResponseMessage res;
            if (_editId is null)
            {
                if (string.IsNullOrWhiteSpace(_roleCode))
                { _roleOk = false; _roleMsg = "كود الدور مطلوب"; _roleSaving = false; return; }

                res = await Http.PostAsJsonAsync("api/roles", new
                {
                    roleCode = _roleCode.Trim(),
                    nameAr   = _roleNameAr.Trim(),
                    nameEn   = _roleNameEn
                });
            }
            else
            {
                res = await Http.PutAsJsonAsync($"api/roles/{_editId}", new
                {
                    nameAr   = _roleNameAr.Trim(),
                    nameEn   = _roleNameEn,
                    isActive = _roleActive
                });
            }

            var msg = await MsgOf(res);
            _roleOk = res.IsSuccessStatusCode; _roleMsg = msg;

            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(msg, Severity.Success);
                CloseRoleModal();
                await LoadAsync();
            }
        }
        catch (Exception ex) { _roleOk = false; _roleMsg = "فشل الحفظ: " + ex.Message; }
        finally { _roleSaving = false; }
    }

    private async Task DeleteRoleAsync()
    {
        if (_editId is null) return;
        try
        {
            var res = await Http.DeleteAsync($"api/roles/{_editId}");
            var msg = await MsgOf(res);
            Snackbar.Add(msg, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode)
            {
                CloseRoleModal(); _selId = null;
                await LoadAsync();
            }
        }
        catch (Exception ex) { Snackbar.Add("فشل الحذف: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var body = await res.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return res.IsSuccessStatusCode ? "تم" : "خطأ غير معروف";
            var doc = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(body);
            if (doc.TryGetProperty("message", out var m)) return m.GetString() ?? body;
            return body;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ HTTP {(int)res.StatusCode}"; }
    }
}