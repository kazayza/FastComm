@page "/roles"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>الأدوار والصلاحيات — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO — كارت مستقل بحواف دائرية وارتفاع مضغوط
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="rl-hero-row">
                <div class="rl-hero-left">
                    <div class="rl-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                        <span>الإدارة · الأمن</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">إدارة الأدوار والصلاحيات</h1>
                    <span class="rl-hero-sub">تحديث الصلاحيات يتم تفعيله فوراً للمستخدمين دون الحاجة لإعادة تسجيل الدخول</span>
                </div>

                <div class="rl-hero-right">
                    <span class="rl-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                    <span class="rl-hero-chip rl-chip-highlight">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01" stroke-linecap="round"/>
                        </svg>
                        أدوار نشطة: @_roles.Count(r => r.IsActive)
                    </span>
                </div>
            </div>

            <div class="rl-kpis-row">
                <div class="rl-kpi rl-kpi-blue">
                    <div class="rl-kpi-inner">
                        <div class="rl-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" /></div>
                        <div class="rl-kpi-data">
                            <div class="rl-kpi-num">@_roles.Count</div>
                            <div class="rl-kpi-label">إجمالي الأدوار</div>
                        </div>
                    </div>
                </div>
                <div class="rl-kpi rl-kpi-gold">
                    <div class="rl-kpi-inner">
                        <div class="rl-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /></div>
                        <div class="rl-kpi-data">
                            <div class="rl-kpi-num">@TotalPerms</div>
                            <div class="rl-kpi-label">صلاحية بالنظام</div>
                        </div>
                    </div>
                </div>
                <div class="rl-kpi rl-kpi-red">
                    <div class="rl-kpi-inner">
                        <div class="rl-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" /></div>
                        <div class="rl-kpi-data">
                            <div class="rl-kpi-num">@_roles.Count(r => r.IsSystem)</div>
                            <div class="rl-kpi-label">أدوار أساسية</div>
                        </div>
                    </div>
                </div>
                <div class="rl-kpi rl-kpi-green">
                    <div class="rl-kpi-inner">
                        <div class="rl-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" /></div>
                        <div class="rl-kpi-data">
                            <div class="rl-kpi-num">@TotalUsersOnRoles</div>
                            <div class="rl-kpi-label">مستخدمين مفعلين</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="rl-body">

    @if (!CanManage)
    {
        <div class="rl-state-box">
            <div class="rl-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية إدارة الأدوار والصلاحيات (ROLE.MANAGE)</p>
        </div>
    }
    else if (_loading && !_roles.Any())
    {
        <div class="rl-loading-wrap">
            <div class="rl-spinner" aria-label="جاري التحميل"></div>
            <div class="rl-loading-text">جاري تحميل الأدوار والصلاحيات...</div>
        </div>
    }
    else
    {
        <div class="rl-layout">

            @* ══════════════════════════════════════
               عمود الأدوار (يمين الشاشة)
            ══════════════════════════════════════ *@
            <div class="rl-sidebar">

                <div class="rl-sidebar-head">
                    <div class="rl-sidebar-title">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                        قائمة الأدوار المتاحة
                    </div>
                    <span class="rl-sidebar-count">@_roles.Count</span>
                </div>

                <div class="rl-roles-list">
                    @if (!_roles.Any())
                    {
                        <div class="rl-roles-empty">
                            <span>لا توجد أدوار مسجلة حالياً</span>
                        </div>
                    }

                    @foreach (var r in _roles)
                    {
                        <button class="rl-role-card @(_selId == r.Id ? "rl-card-active" : "")"
                                @onclick="() => SelectRole(r)"
                                aria-pressed="@(_selId == r.Id)"
                                aria-label="@r.NameAr">

                            <div class="rl-role-avatar rl-av-@(r.Id % 6)" aria-hidden="true">
                                @(r.NameAr.Length > 0 ? r.NameAr[0].ToString() : "؟")
                            </div>

                            <div class="rl-role-info">
                                <div class="rl-role-name">@r.NameAr</div>
                                <div class="rl-role-meta">
                                    <span class="rl-role-code">@r.RoleCode</span>
                                    @if (r.IsSystem)
                                    {
                                        <span class="rl-system-badge-icon" title="دور أساسي مقيد للنظام">
                                            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                                        </span>
                                    }
                                    @if (!r.IsActive)
                                    {
                                        <span class="rl-inactive-badge">موقوف</span>
                                    }
                                </div>
                            </div>

                            <div class="rl-role-stats">
                                <div class="rl-stat">
                                    <span class="rl-stat-num">@r.PermissionCount</span>
                                    <span class="rl-stat-lb">صلاحية</span>
                                </div>
                                <div class="rl-stat-sep" aria-hidden="true"></div>
                                <div class="rl-stat">
                                    <span class="rl-stat-num">@r.UserCount</span>
                                    <span class="rl-stat-lb">مستخدم</span>
                                </div>
                            </div>

                        </button>
                    }
                </div>

            </div>

            @* ══════════════════════════════════════
               لوحة مصفوفة الصلاحيات (يسار الشاشة)
            ══════════════════════════════════════ *@
            <div class="rl-matrix-panel">

                @if (_sel is null)
                {
                    <div class="rl-matrix-empty">
                        <div class="rl-matrix-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="44" height="44"
                                 fill="none" stroke="currentColor" stroke-width="1.4">
                                <rect x="3" y="11" width="18" height="11" rx="2"/>
                                <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="rl-matrix-empty-title">يرجى اختيار دور من القائمة اليمنى</div>
                        <div class="rl-matrix-empty-sub">لتتمكن من مراجعة وتعديل مصفوفة الصلاحيات الممنوحة له</div>
                    </div>
                }
                else
                {
                    @* ── مروّس المصفوفة ── *@
                    <div class="rl-matrix-head">

                        <div class="rl-matrix-head-info">
                            <div class="rl-matrix-role-avatar rl-av-@(_sel.Id % 6)" aria-hidden="true">
                                @(_sel.NameAr.Length > 0 ? _sel.NameAr[0].ToString() : "؟")
                            </div>
                            <div>
                                <div class="rl-matrix-role-name">
                                    @_sel.NameAr
                                    @if (_sel.IsSystem)
                                    {
                                        <span class="rl-system-chip">أساسي للنظام</span>
                                    }
                                    @if (!_sel.IsActive)
                                    {
                                        <span class="rl-inactive-chip">موقوف</span>
                                    }
                                </div>
                                <div class="rl-matrix-role-sub">
                                    <span>@_sel.RoleCode</span>
                                    <span class="rl-dot" aria-hidden="true">·</span>
                                    <span>@_sel.UserCount مستخدم مفعل</span>
                                    <span class="rl-dot" aria-hidden="true">·</span>
                                    <span class="rl-sel-count">@SelCount صلاحية مفعلة</span>
                                </div>
                            </div>
                        </div>

                        <div class="rl-matrix-head-actions">
                            <button class="rl-edit-role-btn" @onclick="OpenEdit" aria-label="تعديل الدور">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                تعديل بيانات الدور
                            </button>
                        </div>

                    </div>

                    @* ── تنبيه لو دور أساسي ── *@
                    @if (_sel.IsSystem)
                    {
                        <div class="rl-system-banner" role="status">
                            <div class="system-banner-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div class="system-banner-text">
                                <strong>دور أساسي مقيد للنظام — الصلاحيات غير قابلة للتعديل</strong>
                                <span>صلاحيات هذا الدور كاملة حمايةً للنظام والمستخدمين من القفل الذاتي غير المقصود.</span>
                            </div>
                        </div>
                    }

                    @* ── إحصاءات سريعة ── *@
                    @if (!_sel.IsSystem)
                    {
                        <div class="rl-quick-stats">
                            <div class="rl-qs-item">
                                <div class="rl-qs-num">@SelCount</div>
                                <div class="rl-qs-label">ممنوحة</div>
                            </div>
                            <div class="rl-qs-sep" aria-hidden="true"></div>
                            <div class="rl-qs-item">
                                <div class="rl-qs-num">@(TotalPerms - SelCount)</div>
                                <div class="rl-qs-label">غير ممنوحة</div>
                            </div>
                            <div class="rl-qs-sep" aria-hidden="true"></div>
                            <div class="rl-qs-item">
                                <div class="rl-qs-num">@TotalPerms</div>
                                <div class="rl-qs-label">الإجمالي</div>
                            </div>
                            <div class="rl-qs-bar-wrap">
                                <div class="rl-qs-bar">
                                    <div class="rl-qs-bar-fill"
                                         style="width:@(TotalPerms > 0 ? (SelCount * 100 / TotalPerms) : 0)%"></div>
                                </div>
                                <span class="rl-qs-pct">
                                    @(TotalPerms > 0 ? (SelCount * 100 / TotalPerms) : 0)%
                                </span>
                            </div>
                        </div>
                    }

                    @* ── جدول مصفوفة الوحدات والصلاحيات ── *@
                    <div class="rl-modules-wrap">
                        @if (_sel.IsSystem)
                        {
                            @foreach (var mod in _catalog)
                            {
                                <div class="rl-module-card rl-module-locked">
                                    <div class="rl-module-head">
                                        <div class="rl-module-title-wrap">
                                            <div class="rl-module-icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                                                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                                                </svg>
                                            </div>
                                            <span class="rl-module-name">@mod.ModuleCode</span>
                                            <span class="rl-module-count-badge locked">
                                                @mod.Items.Count / @mod.Items.Count
                                            </span>
                                        </div>
                                    </div>
                                    <div class="rl-perms-grid">
                                        @foreach (var p in mod.Items)
                                        {
                                            <div class="rl-perm-item rl-perm-active">
                                                <div class="rl-perm-check-icon active" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5">
                                                        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </div>
                                                <span class="rl-perm-name">@p.NameAr</span>
                                                <span class="rl-perm-code">@p.PermissionCode</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            @foreach (var mod in _catalog)
                            {
                                var modCount   = ModCount(mod);
                                var modAll     = modCount == mod.Items.Count;
                                var modPartial = modCount > 0 && !modAll;

                                <details class="rl-module-card" open="@(modCount > 0)">
                                    <summary class="rl-module-head" aria-label="@mod.ModuleCode">
                                        <div class="rl-module-title-wrap">
                                            <div class="rl-module-chevron" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </div>
                                            <span class="rl-module-name">@mod.ModuleCode</span>
                                            <span class="rl-module-count-badge @(modAll ? "badge-all" : modPartial ? "badge-partial" : "badge-none")">
                                                @modCount / @mod.Items.Count
                                            </span>
                                        </div>

                                        <button class="rl-toggle-all-btn @(modAll ? "toggle-all-active" : "")"
                                                type="button"
                                                @onclick="() => ToggleModule(mod)"
                                                @onclick:stopPropagation="true"
                                                aria-label="تحديد الكل">
                                            @if (modAll)
                                            {
                                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                                                </svg>
                                                <span>إلغاء الكل</span>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                                <span>اختيار الكل</span>
                                            }
                                        </button>
                                    </summary>

                                    <div class="rl-perms-grid">
                                        @foreach (var p in mod.Items)
                                        {
                                            var isOn = _selIds.Contains(p.PermissionId);

                                            <label class="rl-perm-item @(isOn ? "rl-perm-active" : "")" aria-label="@p.NameAr">
                                                <input type="checkbox" checked="@isOn"
                                                       @onchange="e => TogglePerm(p.PermissionId, (bool)e.Value!)"
                                                       class="rl-perm-checkbox" />
                                                <div class="rl-perm-check-icon @(isOn ? "active" : "")" aria-hidden="true">
                                                    @if (isOn)
                                                    {
                                                        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5">
                                                            <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>
                                                    }
                                                </div>
                                                <div class="rl-perm-text">
                                                    <span class="rl-perm-name">@p.NameAr</span>
                                                    <span class="rl-perm-code">@p.PermissionCode</span>
                                                </div>
                                            </label>
                                        }
                                    </div>
                                </details>
                            }
                        }
                    </div>
                }

            </div>

        </div>
    }
</div>

@* ═══════════════════════════════════════════
   ⚡ GLOW FAB — الوميض الدائم ثنائي الإجراءات
═══════════════════════════════════════════ *@
@if (CanManage && !_loading)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            @* زر دور جديد *@
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="OpenCreate">
                <span class="glow-fab-item-ic">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                </span>
                <span class="glow-fab-item-lb">إنشاء دور جديد</span>
            </button>
            @* زر التحديث *@
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="Reload">
                <span class="glow-fab-item-ic">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                </span>
                <span class="glow-fab-item-lb">تحديث البيانات</span>
            </button>
        </div>

        @* زر الوميض الأساسي التفاعلي للحفظ السريع عند تعديل دور غير أساسي *@
        <div class="glow-fab-container">
            @if (_sel is not null && !_sel.IsSystem)
            {
                <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
                <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
                <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
                <span class="glow-halo" aria-hidden="true"></span>

                <button type="button" class="glow-fab-btn" @onclick="SaveMatrixWithFab" disabled="@_saving"
                        title="حفظ الصلاحيات الحالية" aria-label="حفظ الصلاحيات">
                    @if (_saving)
                    {
                        <span class="btn-spinner"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                            <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                </button>
            }
            else
            {
                <button type="button" class="glow-fab-btn glow-fab-neutral" @onclick="ToggleFab" @onkeydown="OnFabKeyDown">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" class="glow-fab-icon">
                        <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                    </svg>
                </button>
            }
        </div>

    </div>
}

@* ═══════════════════════════════════════════
   MODAL — دور جديد / تعديل
═══════════════════════════════════════════ *@
@if (_roleModalOpen)
{
    <div class="cust-modal-backdrop" @onclick="CloseRoleModal" role="dialog" aria-modal="true">
        <div class="cust-modal cust-modal-sm" @onclick:stopPropagation="true">

            <div class="modal-head">
                <div class="modal-head-icon @(_editId is null ? "icon-blue" : "icon-amber")" aria-hidden="true">
                    @if (_editId is null)
                    {
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                    }
                </div>
                <div>
                    <div class="modal-title">@(_editId is null ? "دور جديد" : "تعديل دور")</div>
                    <div class="modal-sub">
                        @(_editId is null ? "الدور الجديد يبدأ بصفر صلاحيات — وزّعها من المصفوفة" : "تعديل اسم الدور وحالته")
                    </div>
                </div>
                <button class="modal-close-btn" @onclick="CloseRoleModal" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_roleMsg is not null)
            {
                <div class="modal-banner @(_roleOk ? "banner-success" : "banner-error")" role="alert">
                    <span>@_roleMsg</span>
                    <button class="banner-close" @onclick="() => _roleMsg = null">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }

            <div class="modal-body">
                @if (_editId is null)
                {
                    <div class="modal-form-field">
                        <label class="modal-field-label">كود الدور <span class="field-required">*</span></label>
                        <div class="modal-field-hint">باللغة الإنجليزية (أحرف كبيرة) — مثال: MANAGER</div>
                        <input class="modal-field-input @(string.IsNullOrWhiteSpace(_roleCode) && _roleSaving ? "field-error" : "")"
                               @bind="_roleCode" placeholder="ROLE_CODE" maxlength="50" dir="ltr" aria-required="true" />
                    </div>
                }

                <div class="modal-form-field">
                    <label class="modal-field-label">الاسم بالعربي <span class="field-required">*</span></label>
                    <input class="modal-field-input" @bind="_roleNameAr" placeholder="اسم الدور بالعربية" maxlength="100" aria-required="true" />
                </div>

                <div class="modal-form-field">
                    <label class="modal-field-label">الاسم بالإنجليزي</label>
                    <input class="modal-field-input" @bind="_roleNameEn" placeholder="Role name in English" maxlength="100" dir="ltr" />
                </div>

                @if (_editId is not null)
                {
                    <div class="modal-toggle-field">
                        <div class="modal-toggle-text">
                            <div class="modal-toggle-title">الدور مفعّل</div>
                            <div class="modal-toggle-sub">الأدوار الموقوفة لا تظهر عند تعيين مستخدمين</div>
                        </div>
                        <label class="toggle-switch" aria-label="تفعيل الدور">
                            <input type="checkbox" @bind="_roleActive" role="switch" aria-checked="@_roleActive" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                }
            </div>

            <div class="modal-foot">
                @if (_editId is not null && !_editIsSystem)
                {
                    @if (_confirmDel)
                    {
                        <button class="modal-delete-btn pulse-del" @onclick="DeleteRoleAsync">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                            </svg>
                            حذف نهائي — متأكد؟
                        </button>
                    }
                    else
                    {
                        <button class="modal-delete-outline-btn" @onclick="() => _confirmDel = true">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                            </svg>
                            حذف
                        </button>
                    }
                    <span style="flex:1"></span>
                }
                <button class="modal-cancel-btn" @onclick="CloseRoleModal">إلغاء</button>
                <button class="modal-save-btn" @onclick="SaveRoleAsync" disabled="@_roleSaving">
                    @if (_roleSaving)
                    {
                        <span class="btn-spinner sm"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                            <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>حفظ</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       HERO WRAPPER — كارت مستقل بحواف دائرية
    ================================================================ */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow:
            0 12px 32px rgba(13, 38, 84, 0.15),
            0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .fc-hero-title-slim {
        font-size: clamp(18px, 2vw, 24px) !important;
        margin: 0 !important;
    }

    .rl-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .rl-hero-left {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .rl-hero-crumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 10.5px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 2px;
    }

    .rl-hero-sub {
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.55);
        font-weight: 600;
    }

    .rl-hero-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .rl-hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: rgba(255, 255, 255, 0.7);
        font-size: 10.5px;
        font-weight: 700;
        font-family: "Inter", Arial, sans-serif;
        white-space: nowrap;
    }

    .rl-chip-highlight {
        background: rgba(251, 191, 36, 0.15) !important;
        border-color: rgba(251, 191, 36, 0.35) !important;
        color: #fcd34d !important;
    }

    /* الـ KPIs التشغيلية مدمجة بالهيرو بصف واحد أنيق */
    .rl-kpis-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        margin-top: 12px;
    }

    .rl-kpi {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(12px);
        border-radius: 10px;
        padding: 10px 12px;
    }

    .rl-kpi-inner {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .rl-kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .rl-kpi-blue .rl-kpi-icon   { background: rgba(125, 211, 252, 0.15); color: #7dd3fc; }
    .rl-kpi-gold .rl-kpi-icon   { background: rgba(252, 211, 77, 0.15);  color: #fcd34d; }
    .rl-kpi-red .rl-kpi-icon    { background: rgba(252, 165, 165, 0.15); color: #fca5a5; }
    .rl-kpi-green .rl-kpi-icon  { background: rgba(110, 231, 183, 0.15); color: #6ee7b7; }

    .rl-kpi-data {
        flex: 1;
        min-width: 0;
    }

    .rl-kpi-num {
        font-family: "Inter", Arial, sans-serif;
        font-size: 18px;
        font-weight: 900;
        color: #fff;
        line-height: 1;
    }

    .rl-kpi-label {
        font-size: 10.5px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.6);
        margin-top: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ================================================================
       BODY & LAYOUT (z-index للتأكد من عدم تغطية المحتوى)
    ================================================================ */
    .rl-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 18px clamp(16px, 3vw, 40px) 100px;
        max-width: 1440px;
        width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
        position: relative;
        z-index: 2;
    }

    .rl-layout {
        display: grid;
        grid-template-columns: 290px minmax(0, 1fr);
        gap: 18px;
        align-items: start;
        position: relative;
        z-index: 2;
    }

    /* ── Sidebar ── */
    .rl-sidebar {
        background: var(--fc-card);
        border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 4px 24px rgba(15, 41, 82, 0.05);
        overflow: hidden;
        position: sticky;
        top: 80px;
    }

    .rl-sidebar-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 14px 16px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
    }

    .rl-sidebar-title {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 800;
        color: var(--fc-text);
    }

    .rl-sidebar-count {
        min-width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        padding: 0 5px;
        background: var(--fc-blue-lt);
        color: var(--fc-blue);
        font-size: 10px;
        font-weight: 900;
        font-family: "Inter", Arial, sans-serif;
    }

    .rl-roles-list {
        display: flex;
        flex-direction: column;
        padding: 8px;
        gap: 4px;
        max-height: 65vh;
        overflow-y: auto;
    }

    .rl-roles-empty {
        padding: 30px;
        text-align: center;
        color: #9aaabb;
        font-size: 12px;
        font-weight: 600;
    }

    /* Role Cards */
    .rl-role-card {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid transparent;
        background: transparent;
        cursor: pointer;
        text-align: right;
        font-family: inherit;
        transition: all 0.15s ease;
    }

    .rl-role-card:hover {
        background: #f5f7fc;
        border-color: #e4eaf3;
    }

    .rl-card-active {
        background: var(--fc-blue-lt) !important;
        border-color: #bdd4fc !important;
        box-shadow: 0 2px 10px rgba(30,110,245,.08);
    }

    .rl-role-avatar,
    .rl-matrix-role-avatar {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14.5px;
        font-weight: 900;
        color: #fff;
        box-shadow: 0 2px 6px rgba(0,0,0,.10);
    }

    .rl-matrix-role-avatar {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        border-radius: 12px;
        font-size: 18px;
    }

    .rl-av-0 { background: linear-gradient(135deg, #1558d6, #1e6ef5); }
    .rl-av-1 { background: linear-gradient(135deg, #6035a0, #7c4dbd); }
    .rl-av-2 { background: linear-gradient(135deg, #0d8a48, #16a35b); }
    .rl-av-3 { background: linear-gradient(135deg, #b87d08, #e09a10); }
    .rl-av-4 { background: linear-gradient(135deg, #b02040, #e03048); }
    .rl-av-5 { background: linear-gradient(135deg, #0a7a6e, #0d9488); }

    .rl-role-info {
        flex: 1;
        min-width: 0;
    }

    .rl-role-name {
        font-size: 12.5px;
        font-weight: 800;
        color: #1c2c44;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .rl-card-active .rl-role-name {
        color: var(--fc-blue);
    }

    .rl-role-meta {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 2px;
    }

    .rl-role-code {
        font-size: 9.5px;
        font-weight: 700;
        color: #8899ae;
        font-family: "Inter", Arial, sans-serif;
    }
    .rl-card-active .rl-role-code {
        color: #6b9bd2;
    }

    .rl-system-badge-icon {
        display: inline-flex;
        align-items: center;
        color: #9a6d08;
    }

    .rl-inactive-badge {
        display: inline-flex;
        padding: 0 5px;
        border-radius: 4px;
        background: #fff0f2;
        color: var(--fc-red);
        font-size: 9px;
        font-weight: 800;
        border: 1px solid #ffc8cf;
    }

    .rl-role-stats {
        display: flex;
        align-items: center;
        gap: 0;
        flex: 0 0 auto;
    }

    .rl-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
        padding: 0 7px;
    }

    .rl-stat-num {
        font-size: 13px;
        font-weight: 900;
        color: var(--fc-text);
        font-family: "Inter", Arial, sans-serif;
    }
    .rl-stat-lb {
        font-size: 8.5px;
        color: #9aaabb;
        font-weight: 600;
        white-space: nowrap;
    }
    .rl-card-active .rl-stat-num {
        color: var(--fc-blue);
    }

    .rl-stat-sep {
        width: 1px;
        height: 24px;
        background: #e4eaf3;
        flex: 0 0 1px;
    }

    /* ── Matrix Panel ── */
    .rl-matrix-panel {
        background: var(--fc-card);
        border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 4px 24px rgba(15, 41, 82, 0.05);
        overflow: hidden;
    }

    .rl-matrix-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 340px;
        text-align: center;
        padding: 40px;
    }

    .rl-matrix-empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f4fa;
        color: #b0c4d8;
    }

    .rl-matrix-empty-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--fc-text);
    }

    .rl-matrix-empty-sub {
        font-size: 12px;
        color: var(--fc-muted);
    }

    .rl-matrix-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 16px 20px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
        flex-wrap: wrap;
    }

    .rl-matrix-head-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .rl-matrix-role-name {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        font-size: 15px;
        font-weight: 900;
        color: #1c2b43;
    }

    .rl-system-chip {
        display: inline-flex;
        align-items: center;
        padding: 2px 9px;
        border-radius: 7px;
        background: #fff8e0;
        color: #9a6d08;
        font-size: 10px;
        font-weight: 800;
        border: 1px solid #f0d898;
    }

    .rl-inactive-chip {
        display: inline-flex;
        align-items: center;
        padding: 2px 9px;
        border-radius: 7px;
        background: var(--fc-red-lt);
        color: var(--fc-red);
        font-size: 10px;
        font-weight: 800;
        border: 1px solid #ffc8cf;
    }

    .rl-matrix-role-sub {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: var(--fc-muted);
        margin-top: 3px;
    }

    .rl-dot {
        opacity: .4;
    }

    .rl-sel-count {
        color: var(--fc-blue);
        font-weight: 800;
    }

    .rl-matrix-head-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .rl-edit-role-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--fc-border);
        border-radius: 9px;
        background: var(--fc-card);
        color: var(--fc-text);
        font-family: inherit;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all .15s ease;
    }

    .rl-edit-role-btn:hover {
        background: #f0f4fa;
        border-color: #c0ccd8;
    }

    /* System Blocked Banner */
    .rl-system-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        background: linear-gradient(135deg, #fff8e0, #fffbef);
        border-bottom: 1px solid #f0d898;
    }

    .system-banner-icon {
        flex: 0 0 auto;
        color: #d97706;
    }

    .system-banner-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .system-banner-text strong {
        font-size: 13px;
        font-weight: 800;
        color: #92400e;
    }

    .system-banner-text span {
        font-size: 11px;
        color: #b45309;
    }

    /* Quick stats */
    .rl-quick-stats {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 12px 20px;
        background: #f9fafd;
        border-bottom: 1px solid #edf1f7;
    }

    .rl-qs-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding: 0 16px;
        flex: 0 0 auto;
    }

    .rl-qs-num {
        font-family: "Inter", Arial, sans-serif;
        font-size: 18px;
        font-weight: 900;
        color: var(--fc-text);
    }

    .rl-qs-label {
        font-size: 9.5px;
        color: #9aaabb;
        font-weight: 600;
    }

    .rl-qs-sep {
        width: 1px;
        height: 34px;
        background: #e4eaf3;
        flex: 0 0 1px;
    }

    .rl-qs-bar-wrap {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 16px;
    }

    .rl-qs-bar {
        flex: 1;
        height: 8px;
        border-radius: 5px;
        background: #e4eaf3;
        overflow: hidden;
    }

    .rl-qs-bar-fill {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--fc-blue), #42a5f5);
        transition: width .5s cubic-bezier(.34,1.2,.64,1);
    }

    .rl-qs-pct {
        font-family: "Inter", Arial, sans-serif;
        font-size: 12px;
        font-weight: 800;
        color: var(--fc-blue);
        min-width: 38px;
        text-align: center;
    }

    /* Modules Accordion */
    .rl-modules-wrap {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .rl-module-card {
        border: 1px solid #e4edf8;
        border-radius: 12px;
        background: linear-gradient(180deg, #fafcff, #f5f8fb);
        overflow: hidden;
        transition: border-color .15s ease;
    }

    .rl-module-card:hover {
        border-color: #c8d8f0;
    }

    .rl-module-locked {
        border-color: #f0d898;
        background: linear-gradient(180deg, #fffcf0, #fffbef);
    }

    .rl-module-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 14px;
        background: linear-gradient(180deg, #f0f5fc, #eaf1f9);
        border-bottom: 1px solid #dce8f5;
        cursor: pointer;
        list-style: none;
        transition: background .12s ease;
    }

    .rl-module-head:hover {
        background: linear-gradient(180deg, #e8f0fc, #dfe9f8);
    }

    .rl-module-locked .rl-module-head {
        background: linear-gradient(180deg, #fdf5e0, #faefd0);
        border-color: #f0d898;
    }

    .rl-module-head::-webkit-details-marker { display: none; }
    .rl-module-head::marker { display: none; }

    .rl-module-title-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .rl-module-chevron {
        color: #9aaabb;
        transition: transform .2s ease;
        display: flex;
        align-items: center;
    }

    details[open] .rl-module-chevron {
        transform: rotate(180deg);
    }

    .rl-module-icon {
        color: #d97706;
        display: flex;
    }

    .rl-module-name {
        font-size: 12.5px;
        font-weight: 800;
        color: var(--fc-text);
        font-family: "Inter", Arial, sans-serif;
    }

    .rl-module-count-badge {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 800;
        font-family: "Inter", Arial, sans-serif;
    }

    .badge-all { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .badge-partial { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }
    .badge-none { background: #f0f3f8; color: #8899ae; border: 1px solid #dde5f0; }
    .locked { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }

    .rl-toggle-all-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 28px;
        padding: 0 10px;
        border: 1px solid #bdd4fc;
        border-radius: 7px;
        background: var(--fc-blue-lt);
        color: var(--fc-blue);
        font-family: inherit;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
        transition: all .12s ease;
    }

    .rl-toggle-all-btn:hover {
        background: var(--fc-blue);
        color: #fff;
    }

    .toggle-all-active {
        background: var(--fc-red-lt) !important;
        color: var(--fc-red) !important;
        border-color: #ffc8cf !important;
    }

    .toggle-all-active:hover {
        background: var(--fc-red) !important;
        color: #fff !important;
    }

    /* Matrix Permissions Grid */
    .rl-perms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 6px;
        padding: 12px 14px;
    }

    .rl-perm-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 8px;
        border: 1px solid #e8edf5;
        background: #fafcff;
        cursor: pointer;
        transition: all .12s ease;
        user-select: none;
    }

    .rl-perm-item:hover {
        border-color: #bdd4fc;
        background: var(--fc-blue-lt);
    }

    .rl-perm-active {
        border-color: #bdd4fc !important;
        background: var(--fc-blue-lt) !important;
    }

    .rl-perm-checkbox {
        display: none;
    }

    .rl-perm-check-icon {
        width: 18px;
        height: 18px;
        flex: 0 0 18px;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #d8e2f0;
        background: #fff;
        transition: all .12s ease;
    }

    .rl-perm-check-icon.active {
        background: var(--fc-blue);
        border-color: var(--fc-blue);
        color: #fff;
    }

    .rl-perm-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .rl-perm-name {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--fc-text);
        line-height: 1.3;
    }

    .rl-perm-active .rl-perm-name {
        color: var(--fc-blue);
    }

    .rl-perm-code {
        font-size: 9px;
        color: #9aaabb;
        font-weight: 600;
        font-family: "Inter", Arial, sans-serif;
    }

    /* ================================================================
       ⚡ GLOW FAB — الوميض الدائم ثنائي الإجراءات (مخصص للحفظ)
    ================================================================ */
    .glow-fab-scrim {
        position: fixed;
        inset: 0;
        z-index: 1298;
        background: rgba(10, 20, 40, 0.4);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        animation: glow-fadein 0.2s ease both;
    }

    @@keyframes glow-fadein { from { opacity: 0; } to { opacity: 1; } }

    .glow-fab-wrap {
        position: fixed;
        left: 28px;
        bottom: 28px;
        z-index: 1299;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
    }

    .glow-fab-container {
        position: relative;
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* وميض دائم خارجي */
    .glow-halo {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.5) 0%, rgba(16, 185, 129, 0.2) 50%, rgba(16, 185, 129, 0) 75%);
        filter: blur(12px);
        animation: glow-breath 2.5s ease-in-out infinite;
        pointer-events: none;
        z-index: 1;
    }

    @@keyframes glow-breath {
        0%, 100% { opacity: 0.7; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.15); }
    }

    .glow-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2.5px solid #10b981;
        pointer-events: none;
        opacity: 0;
        z-index: 2;
    }

    .glow-ring-1 { animation: glow-expand 2.4s ease-out infinite; animation-delay: 0s; }
    .glow-ring-2 { animation: glow-expand 2.4s ease-out infinite; animation-delay: 0.8s; }
    .glow-ring-3 { animation: glow-expand 2.4s ease-out infinite; animation-delay: 1.6s; }

    @@keyframes glow-expand {
        0% { opacity: 0.8; transform: scale(1); border-width: 3px; }
        60% { opacity: 0.4; }
        100% { opacity: 0; transform: scale(2); border-width: 1px; }
    }

    /* زر الـ FAB الرئيسي الأخضر للحفظ السريع والذهبي للفتح */
    .glow-fab-btn {
        position: relative;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: 2.5px solid #6ee7b7;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        box-shadow:
            0 8px 24px rgba(16, 185, 129, 0.45),
            0 4px 12px rgba(110, 231, 183, 0.35),
            inset 0 1px 0 rgba(255, 255, 255, 0.3);
        transition: transform 0.25s cubic-bezier(0.34, 1.3, 0.64, 1);
        z-index: 3;
    }

    .glow-fab-btn:hover {
        transform: scale(1.08);
    }

    .glow-fab-btn:active {
        transform: scale(0.94);
    }

    .glow-fab-btn:focus-visible {
        outline: none;
    }

    /* نمط حيادي عند قفل حفظ الصلاحيات (ليعمل فقط كقائمة منبثقة) */
    .glow-fab-neutral {
        background: linear-gradient(135deg, #1e6ef5 0%, #0d47a1 100%) !important;
        border-color: #fbbf24 !important;
        box-shadow: 0 8px 24px rgba(30,110,245,0.4), 0 4px 12px rgba(251,191,36,0.2) !important;
    }

    .glow-fab-icon {
        transition: transform 0.3s cubic-bezier(0.34, 1.3, 0.64, 1);
    }

    .glow-fab-wrap.is-open .glow-fab-icon {
        transform: rotate(135deg);
    }

    /* تحويل الزر للأحمر عند الفتح كمستجيب للإلغاء */
    .glow-fab-wrap.is-open .glow-fab-btn {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%) !important;
        border-color: #fca5a5 !important;
        box-shadow:
            0 8px 24px rgba(220, 38, 38, 0.5),
            0 4px 12px rgba(252, 165, 165, 0.35) !important;
    }

    .glow-fab-wrap.is-open .glow-halo {
        background: radial-gradient(circle, rgba(252, 165, 165, 0.55) 0%, rgba(220, 38, 38, 0.35) 40%, rgba(220, 38, 38, 0) 75%);
    }

    .glow-fab-wrap.is-open .glow-ring {
        border-color: #fca5a5 !important;
    }

    /* قائمة الأزرار */
    .glow-fab-menu {
        display: flex;
        flex-direction: column;
        gap: 8px;
        opacity: 0;
        pointer-events: none;
        transform: translateY(15px) scale(0.9);
        transform-origin: bottom left;
        transition: opacity 0.22s ease, transform 0.28s cubic-bezier(0.34, 1.3, 0.64, 1);
    }

    .glow-fab-wrap.is-open .glow-fab-menu {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0) scale(1);
    }

    .glow-fab-item {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-width: 180px;
        padding: 10px 14px;
        background: #fff;
        border: 1px solid #e4eaf2;
        border-radius: 12px;
        box-shadow:
            0 6px 20px rgba(15, 41, 82, 0.14),
            0 2px 6px rgba(15, 41, 82, 0.08);
        font-family: inherit;
        font-size: 12.5px;
        font-weight: 800;
        color: #1c2b43;
        cursor: pointer;
        transition: all 0.18s ease;
        white-space: nowrap;
    }

    .glow-fab-item:hover {
        border-color: #1e6ef5;
        transform: translateX(-4px);
        box-shadow:
            0 8px 24px rgba(30, 110, 245, 0.22),
            0 3px 8px rgba(15, 41, 82, 0.12);
    }

    .glow-fab-item-ic {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #eaf1ff, #dbe8fc);
        color: #1e6ef5;
        flex-shrink: 0;
    }

    .glow-fab-item-lb { flex: 1; text-align: right; }

    /* Staggered menu */
    .glow-fab-wrap.is-open .glow-fab-item:nth-child(1) { transition-delay: 0.04s; }
    .glow-fab-wrap.is-open .glow-fab-item:nth-child(2) { transition-delay: 0.08s; }

    /* ================================================================
       MODALS
    ================================================================ */
    .cust-modal-backdrop {
        position: fixed; inset: 0; z-index: 1000;
        background: rgba(10,20,40,.55); backdrop-filter: blur(4px);
        display: flex; align-items: center; justify-content: center;
        padding: 20px; animation: rl-fade-in .2s ease;
    }

    .cust-modal {
        width: 100%; max-width: 580px;
        background: var(--fc-card); border: 1px solid rgba(0,0,0,.08);
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(10,20,50,.15), 0 30px 80px rgba(10,20,50,.20);
        overflow: hidden;
        animation: rl-modal-in .25s cubic-bezier(.34,1.3,.64,1);
        max-height: 90vh; overflow-y: auto;
    }
    .cust-modal-sm { max-width: 460px; }

    .modal-head {
        display: flex; align-items: center; gap: 12px;
        padding: 18px 20px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
    }

    .modal-head-icon {
        width: 42px; height: 42px; flex: 0 0 42px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 11px;
    }
    .icon-blue  { background: var(--fc-blue-lt); color: var(--fc-blue); border: 1px solid #bdd4fc; }
    .icon-amber { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }

    .modal-title { font-size: 14.5px; font-weight: 800; color: #1c2b43; }
    .modal-sub   { font-size: 10.5px; color: var(--fc-muted); margin-top: 2px; }

    .modal-close-btn {
        margin-right: auto; width: 32px; height: 32px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid #e4eaf2; border-radius: 8px;
        background: none; color: #9aaabb; cursor: pointer;
        transition: all .15s ease;
    }
    .modal-close-btn:hover { background: #f0f4fa; color: var(--fc-text); border-color: #c0ccd8; }

    .modal-banner {
        display: flex; align-items: center; justify-content: space-between;
        gap: 10px; padding: 12px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600; margin-bottom: 14px;
        animation: banner-in .25s ease;
    }
    .banner-close {
        margin-right: auto; background: none; border: none; color: inherit; opacity: .6; cursor: pointer;
        display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 5px;
    }
    .banner-success { background: #e9f8f0; color: #0e7a43; border: 1px solid #b5e8d0; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); border: 1px solid #ffc8cf; }

    .modal-body { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
    .modal-form-field { display: flex; flex-direction: column; gap: 6px; }
    .modal-field-label { font-size: 12px; font-weight: 800; color: #344258; display: flex; align-items: center; gap: 4px; }
    .field-required { color: var(--fc-red); font-size: 14px; line-height: 1; }
    .modal-field-hint { font-size: 10px; color: #9aaabb; font-weight: 500; }

    .modal-field-input {
        height: 42px; width: 100%;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 13px; padding: 0 12px;
        outline: none; box-sizing: border-box;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .modal-field-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); background: #fff; }
    .modal-field-input.field-error { border-color: var(--fc-red); }
    .modal-field-input::placeholder { color: #b0bcc8; }

    .modal-toggle-field {
        display: flex; align-items: center; justify-content: space-between;
        gap: 14px; padding: 12px 14px; border-radius: 10px;
        border: 1px solid #e8edf5; background: #fafcff;
    }
    .modal-toggle-title { font-size: 13px; font-weight: 800; color: var(--fc-text); }
    .modal-toggle-sub   { font-size: 10.5px; color: var(--fc-muted); margin-top: 2px; }

    .toggle-switch { display: flex; align-items: center; cursor: pointer; flex-shrink: 0; }
    .toggle-switch input { display: none; }
    .toggle-track {
        position: relative; width: 44px; height: 24px;
        background: #d8e2f0; border-radius: 999px;
        transition: background .2s ease;
        display: flex; align-items: center; padding: 0 3px;
    }
    .toggle-switch input:checked + .toggle-track { background: var(--fc-blue); }
    .toggle-thumb {
        position: absolute; left: 3px;
        width: 18px; height: 18px; border-radius: 50%; background: #fff;
        box-shadow: 0 2px 5px rgba(0,0,0,.2);
        transition: left .2s ease;
    }
    .toggle-switch input:checked + .toggle-track .toggle-thumb { left: calc(100% - 21px); }

    .modal-foot {
        display: flex; align-items: center; gap: 8px;
        padding: 14px 20px;
        background: linear-gradient(180deg, #fafbfd 0%, #f4f6fb 100%);
        border-top: 1px solid #edf1f7;
    }

    .modal-cancel-btn {
        height: 38px; padding: 0 16px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .modal-cancel-btn:hover { background: #f0f4fa; color: var(--fc-text); }

    .modal-save-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 18px;
        border: 0; border-radius: 9px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 12px; font-weight: 800; cursor: pointer;
        box-shadow: 0 3px 10px rgba(30,110,245,.25);
        transition: all .15s ease;
    }
    .modal-save-btn:hover:not(:disabled) { transform: translateY(-1px); }
    .modal-save-btn:disabled { opacity: .6; cursor: not-allowed; }

    .modal-delete-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 14px;
        border: 0; border-radius: 9px;
        background: linear-gradient(135deg, #e03048, #c0182e);
        color: #fff; font-family: inherit;
        font-size: 12px; font-weight: 800; cursor: pointer;
        box-shadow: 0 3px 10px rgba(224,48,72,.25);
    }

    .modal-delete-outline-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 14px;
        border: 1px solid #ffc8cf; border-radius: 9px;
        background: var(--fc-red-lt); color: var(--fc-red);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .modal-delete-outline-btn:hover { background: var(--fc-red); color: #fff; }

    .pulse-del { animation: rl-pulse-del 1s ease infinite; }
    @@keyframes rl-pulse-del {
        0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.35); }
        50%     { box-shadow: 0 0 0 6px rgba(224,48,72,0); }
    }

    /* Spinner */
    .btn-spinner {
        width: 15px; height: 15px;
        border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
        border-radius: 50%; animation: rl-spin .7s linear infinite;
    }
    .btn-spinner.sm { width: 13px; height: 13px; }

    /* ================================================================
       RESPONSIVE
    ================================================================ */
    @@media (max-width: 1100px) {
        .rl-layout { grid-template-columns: 240px minmax(0, 1fr); }
        .rl-perms-grid { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }
    }

    @@media (max-width: 900px) {
        .rl-layout { grid-template-columns: 1fr; }
        .rl-sidebar { position: static; }
