    /* ════════════════════════════════════════════════════════
       BODY MAIN CARD
    ════════════════════════════════════════════════════════ */
    .doc-body {
        padding: 18px clamp(16px, 3vw, 40px) 100px;
        max-width: 1440px;
        margin-inline: auto;
        box-sizing: border-box;
        width: 100%;
        position: relative;
        z-index: 2;
