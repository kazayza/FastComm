@page "/documents"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject TokenStore Tokens

<PageTitle>المستندات — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">الإدارة · المستندات</div>
                <h1 class="fc-hero-title">المستندات</h1>
                <p class="fc-hero-sub">رخص ووثائق تأمين وإثبات تسليم وإيصالات — مربوطة بالجهة بتاعتها</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanUpload)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenUpload">رفع مستند</MudButton>
                }
            </div>
        </div>
        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.FactCheck" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">عدد المستندات</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(d => d.Expired)</div><div class="fc-kpi-lb">منتهي الصلاحية</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                    <div><div class="fc-kpi-num">@ExpiringSoon.Count()</div><div class="fc-kpi-lb">هينتهي خلال 30 يوم</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Storage" /></div>
                    <div><div class="fc-kpi-num">@FileSize(_items.Sum(d => d.FileSizeBytes ?? 0))</div><div class="fc-kpi-lb">إجمالي الحجم</div></div></div>
            </div>
        }
    </div>
</div>

<div class="fc-page">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">ليس لديك  صلاحية عرض المستندات.</MudAlert>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">
            <div class="fc-toolbar">
                <div class="fc-filters">
                    @foreach (var t in Tabs)
                    {
                        <button class='fc-filter @(_tab == t.Key ? "on" : "")' @onclick="() => SetTab(t.Key)">@t.Value</button>
                    }
                </div>
                <select class="fc-sel" style="max-width:190px" @bind="_typeFilter">
                    <option value="0">كل الأنواع</option>
                    @foreach (var t in _types) { <option value="@t.Id">@t.Label</option> }
                </select>
                <select class="fc-sel" style="max-width:190px" @bind="_entityFilter">
                    <option value="">كل الجهات</option>
                    @foreach (var e in EntityTypes) { <option value="@e">@EntityAr(e)</option> }
                </select>
                <MudTextField T="string" Value="_search" ValueChanged="v => _search = v"
                              Placeholder="دوّر باسم الملف أو البيان..." Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="fc-search-box" Immediate="true" />
                <span class="fc-count">عرض @Filtered.Count() من @_items.Count</span>
            </div>

            @if (_loading)
            {
                <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else
            {
                <div class="fc-table-wrap"><table class="fc-table fc-table-pro">
                    <thead><tr>
                        <th>النوع</th><th>الجهة</th><th>الملف</th><th>الحجم</th>
                        <th>الانتهاء</th><th>اترفع</th>
                        <th style="width:150px; text-align:left">إجراءات</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var d in Filtered)
                        {
                            <tr>
                                <td><span class="fc-role-chip">@d.TypeName</span></td>
                                <td class="fc-cell-main">@EntityAr(d.EntityType)
                                    <div class="fc-cell-sub">#@d.EntityId</div></td>
                                <td class="fc-cell-main">@(d.OriginalFileName ?? d.FileName)
                                    @if (d.Description is not null) { <div class="fc-cell-sub">@d.Description</div> }</td>
                                <td class="fc-cell-sub">@FileSize(d.FileSizeBytes ?? 0)</td>
                                <td>
                                    @if (d.ExpiryDate is null)
                                    {
                                        <span class="fc-cell-sub">—</span>
                                    }
                                    else if (d.Expired)
                                    {
                                        <span class="fc-chip fc-chip-bad"><i></i>@d.ExpiryDate منتهي</span>
                                    }
                                    else
                                    {
                                        <span class="fc-cell-sub">@d.ExpiryDate</span>
                                    }
                                </td>
                                <td class="fc-cell-sub">@d.UploadedAt.ToString("yyyy-MM-dd")</td>
                                <td><div class="fc-row-actions">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               OnClick="() => Download(d)">تحميل</MudButton>
                                    @if (CanDelete)
                                    {
                                        @if (_confirmId == d.DocumentId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                                       OnClick="() => Delete(d)">حذف؟</MudButton>
                                        }
                                        else
                                        {
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error" title="حذف"
                                                           OnClick="() => _confirmId = d.DocumentId" />
                                        }
                                    }
                                </div></td>
                            </tr>
                        }
                        @if (!Filtered.Any())
                        {
                            <tr><td colspan="7"><div class="fc-empty"><div>مافيش مستندات في الفلتر ده</div></div></td></tr>
                        }
                    </tbody>
                </table></div>
            }
        </div></div>
    }

    @* ═══════════ مودال: رفع مستند ═══════════ *@
    @if (_modalOpen && CanUpload)
    {
        <div class="fc-modal-backdrop" @onclick="Close">
            <div class="fc-modal fc-modal-sm" @onclick:stopPropagation="true">
                <div class="fc-modal-head">
                    <div><div class="fc-modal-title">رفع مستند</div>
                        <div class="fc-modal-sub">pdf · صور · word · excel · txt · zip — 10 ميجا كحد أقصى</div></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" />
                </div>
                <div class="fc-modal-body">
                    @if (_msg is not null)
                    {
                        <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined"
                                  Class="mb-4">@_msg</MudAlert>
                    }
                    <div class="fc-form-grid">
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">الملف *</div>
                            <InputFile OnChange="OnFilePicked" class="fc-sel fc-sel-lg" />
                            @if (_file is not null)
                            {
                                <div class="fc-cell-sub">@_file.Name — @FileSize(_file.Size)</div>
                            }
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">نوع المستند *</div>
                            <select class="fc-sel fc-sel-lg" value="@_uf.DocumentTypeId" @onchange="OnTypeChanged">
                                <option value="0">— اختر —</option>
                                @foreach (var t in _types) { <option value="@t.Id">@t.Label</option> }
                            </select>
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">الجهة *</div>
                            <select class="fc-sel fc-sel-lg" value="@_uf.EntityType" @onchange='e => _uf.EntityType = e.Value?.ToString() ?? "Other"'>
                                @foreach (var e in EntityTypes) { <option value="@e">@EntityAr(e)</option> }
                            </select>
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">رقم الجهة *</div>
                            <input type="number" min="1" class="fc-sel fc-sel-lg" value="@_uf.EntityId"
                                   @onchange="e => _uf.EntityId = ParseLong(e.Value)" />
                            <div class="fc-cell-sub">رقم العميل / السائق / الرحلة / الفاتورة…</div>
                        </div>
                        @if (CurrentType?.HasExpiry == true)
                        {
                            <div>
                                <div class="fc-panel-sub" style="margin-bottom:6px">تاريخ الانتهاء *</div>
                                <input type="date" class="fc-sel fc-sel-lg" value="@_uf.ExpiryDate"
                                       @onchange="e => _uf.ExpiryDate = e.Value?.ToString()" />
                            </div>
                        }
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">البيان</div>
                            <input class="fc-sel fc-sel-lg" value="@_uf.Description" maxlength="500"
                                   @onchange="e => _uf.Description = e.Value?.ToString()" />
                        </div>
                    </div>
                </div>
                <div class="fc-modal-foot">
                    <MudButton OnClick="Close">إلغاء</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="Upload">رفع</MudButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("DOCUMENT.DOWNLOAD") ?? false;
    private bool CanUpload => _user?.Can("DOCUMENT.UPLOAD") ?? false;
    private bool CanDelete => _user?.Can("DOCUMENT.DELETE") ?? false;

    private static readonly Dictionary<string, string> Tabs = new()
    {
        ["all"] = "الكل", ["valid"] = "ساري", ["soon"] = "هينتهي قريب", ["expired"] = "منتهي"
    };

    /// <summary>لازم يطابق CK_Documents_EntityType بالظبط.</summary>
    private static readonly string[] EntityTypes =
    {
        "Customer","Supplier","Employee","Driver","Vehicle","Trailer",
        "Booking","Operation","Trip","Container","Invoice","SupplierInvoice",
        "Expense","Custody","Payment","Maintenance","Other"
    };

    private const long MaxBytes = 10 * 1024 * 1024;

    private List<Item> _items = new();
    private List<DocType> _types = new();
    private IBrowserFile? _file;

    private bool _loading; private string _search = ""; private string _tab = "all";
    private int _typeFilter; private string _entityFilter = "";
    private long? _confirmId;
    private bool _saving; private string? _msg; private bool _ok;

    private bool _modalOpen; private UploadForm _uf = new();

    public class DocType { public int Id { get; set; } public string Label { get; set; } = "";
        public string Code { get; set; } = ""; public bool HasExpiry { get; set; } }

    public class Item
    {
        public long DocumentId { get; set; }
        public string TypeCode { get; set; } = "";
        public string TypeName { get; set; } = "";
        public bool HasExpiry { get; set; }
        public string EntityType { get; set; } = "";
        public long EntityId { get; set; }
        public string FileName { get; set; } = "";
        public string? OriginalFileName { get; set; }
        public string? ContentType { get; set; }
        public long? FileSizeBytes { get; set; }
        public string? ExpiryDate { get; set; }
        public string? Description { get; set; }
        public DateTime UploadedAt { get; set; }
        public bool Expired { get; set; }
    }

    public class UploadForm
    {
        public int DocumentTypeId { get; set; }
        public string EntityType { get; set; } = "Driver";
        public long EntityId { get; set; }
        public string? ExpiryDate { get; set; }
        public string? Description { get; set; }
    }

    private DocType? CurrentType => _types.FirstOrDefault(t => t.Id == _uf.DocumentTypeId);

    private static string EntityAr(string e) => e switch
    {
        "Customer" => "عميل", "Supplier" => "مورد", "Employee" => "موظف", "Driver" => "سائق",
        "Vehicle" => "سيارة", "Trailer" => "مقطورة", "Booking" => "حجز", "Operation" => "عملية",
        "Trip" => "رحلة", "Container" => "حاوية", "Invoice" => "فاتورة",
        "SupplierInvoice" => "فاتورة مورد", "Expense" => "مصروف", "Custody" => "عهدة",
        "Payment" => "دفعة", "Maintenance" => "صيانة", _ => "أخرى"
    };

    private IEnumerable<Item> ExpiringSoon => _items.Where(d =>
        !d.Expired && d.ExpiryDate is not null &&
        DateOnly.TryParse(d.ExpiryDate, out var x) &&
        x <= DateOnly.FromDateTime(DateTime.Now).AddDays(30));

    private static string FileSize(long bytes) => bytes switch
    {
        <= 0          => "—",
        < 1024        => $"{bytes} B",
        < 1048576     => $"{bytes / 1024.0:N0} KB",
        _             => $"{bytes / 1048576.0:N1} MB"
    };

    private static long ParseLong(object? v) => long.TryParse(v?.ToString(), out var n) ? n : 0;

    private IEnumerable<Item> Filtered => _items.Where(d =>
        (_tab switch
        {
            "valid"   => !d.Expired,
            "soon"    => ExpiringSoon.Contains(d),
            "expired" => d.Expired,
            _         => true
        }) &&
        (_typeFilter == 0 || d.TypeName == _types.FirstOrDefault(t => t.Id == _typeFilter)?.Label) &&
        (string.IsNullOrEmpty(_entityFilter) || d.EntityType == _entityFilter) &&
        (string.IsNullOrWhiteSpace(_search) ||
         d.FileName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (d.OriginalFileName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (d.Description ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        await LoadAsync();
        try { _types = await Http.GetFromJsonAsync<List<DocType>>("api/documents/types") ?? new(); }
        catch { _types = new(); }
    }

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/documents?take=300") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void OpenUpload()
    {
        _uf = new UploadForm(); _file = null;
        _msg = null; _modalOpen = true;
    }

    private void Close() { _modalOpen = false; _file = null; }

    private void OnFilePicked(InputFileChangeEventArgs e) => _file = e.File;

    private void OnTypeChanged(ChangeEventArgs e)
    {
        _uf.DocumentTypeId = int.TryParse(e.Value?.ToString(), out var n) ? n : 0;
        if (CurrentType?.HasExpiry != true) _uf.ExpiryDate = null;
    }

    private async Task Upload()
    {
        if (_file is null)              { _ok = false; _msg = "اختار ملف"; return; }
        if (_uf.DocumentTypeId <= 0)    { _ok = false; _msg = "اختار نوع المستند"; return; }
        if (_uf.EntityId <= 0)          { _ok = false; _msg = "اكتب رقم الجهة"; return; }
        if (CurrentType?.HasExpiry == true && string.IsNullOrWhiteSpace(_uf.ExpiryDate))
        { _ok = false; _msg = "النوع ده لازم يكون له تاريخ انتهاء"; return; }

        _saving = true; _msg = null;
        try
        {
            using var buffer = new MemoryStream();
            await _file.OpenReadStream(MaxBytes).CopyToAsync(buffer);

            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(buffer.ToArray());
            fileContent.Headers.ContentType =
                System.Net.Http.Headers.MediaTypeHeaderValue.Parse(
                    string.IsNullOrWhiteSpace(_file.ContentType) ? "application/octet-stream" : _file.ContentType);
            content.Add(fileContent, "file", _file.Name);
            content.Add(new StringContent(_uf.DocumentTypeId.ToString()), "documentTypeId");
            content.Add(new StringContent(_uf.EntityType), "entityType");
            content.Add(new StringContent(_uf.EntityId.ToString()), "entityId");
            content.Add(new StringContent(_uf.ExpiryDate ?? ""), "expiryDate");
            content.Add(new StringContent(_uf.Description ?? ""), "description");

            var res = await Http.PostAsync("api/documents/upload", content);
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode) { Snackbar.Add(_msg, Severity.Success); Close(); await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل الرفع: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task Download(Item d)
    {
        try
        {
            await JS.InvokeAsync<bool>("fastcom.downloadFile",
                $"api/documents/{d.DocumentId}/download",
                d.OriginalFileName ?? d.FileName,
                await Tokens.GetTokenAsync());
        }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item d)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/documents/{d.DocumentId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
