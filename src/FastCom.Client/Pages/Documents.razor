@page "/documents"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject TokenStore Tokens

<PageTitle>المستندات والوثائق — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO — كارت مستقل بحواف دائرية وارتفاع مدمج
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="doc-hero-row">
                <div class="doc-hero-left">
                    <div class="doc-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                        <span>الإدارة · المستندات</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">الأرشيف والمستندات الرقمية</h1>
                    <span class="doc-hero-sub">إدارة وتتبع وثائق التأمين، الرخص، إثباتات التسليم، والإيصالات المربوطة بالجهات</span>
                </div>

                <div class="doc-hero-right">
                    <span class="doc-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                    @if (_items.Any(d => d.Expired))
                    {
                        <span class="doc-hero-chip doc-chip-warn">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                            </svg>
                            منتهي: @_items.Count(d => d.Expired)
                        </span>
                    }
                </div>
            </div>

            @if (CanView)
            {
                <div class="doc-kpis-row">
                    <div class="doc-kpi doc-kpi-blue">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" /></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_items.Count</div>
                                <div class="doc-kpi-label">عدد المستندات</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-red">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" /></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_items.Count(d => d.Expired)</div>
                                <div class="doc-kpi-label">منتهي الصلاحية</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-gold">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" /></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@ExpiringSoon.Count()</div>
                                <div class="doc-kpi-label">ينتهي خلال 30 يوم</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-green">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" /></div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@FileSize(_items.Sum(d => d.FileSizeBytes ?? 0))</div>
                                <div class="doc-kpi-label">إجمالي الحجم المستهلك</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="doc-body">
    @if (!CanView)
    {
        <div class="doc-state-box">
            <div class="state-icon-wrap perm">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليست لديك الصلاحية الكافية لعرض واستعراض المستندات (DOCUMENT.DOWNLOAD)</p>
        </div>
    }
    else
    {
        <div class="doc-card">
            
            @* ── شريط الفلاتر والبحث ── *@
            <div class="doc-toolbar">
                <div class="doc-filters-group">
                    <div class="doc-tabs">
                        @foreach (var t in Tabs)
                        {
                            <button class="doc-tab @(_tab == t.Key ? "active" : "")" @onclick="() => SetTab(t.Key)">
                                @t.Value
                            </button>
                        }
                    </div>

                    <select class="doc-select" @bind="_typeFilter" title="نوع المستند">
                        <option value="0">كل أنواع المستندات</option>
                        @foreach (var t in _types) { <option value="@t.Id">@t.Label</option> }
                    </select>

                    <select class="doc-select" @bind="_entityFilter" title="الجهة المربوطة">
                        <option value="">كل الجهات المربوطة</option>
                        @foreach (var e in EntityTypes) { <option value="@e">@EntityAr(e)</option> }
                    </select>
                </div>

                <div class="doc-search-wrap">
                    <svg class="doc-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="doc-search-input" placeholder="ابحث باسم الملف أو البيان..."
                           @bind="_search" @bind:event="oninput" aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="doc-search-clear" @onclick="() => _search = string.Empty" aria-label="مسح">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="doc-results-badge">
                    <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="8" cy="8" r="6"/><path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                    </svg>
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>
            </div>

            @* ── المحتوى وجدول البيانات ── *@
            @if (_loading)
            {
                <div class="doc-loading">
                    <div class="doc-spinner"></div>
                    <span>جاري تحميل قائمة المستندات...</span>
                </div>
            }
            else
            {
                <div class="doc-table-wrap">
                    <table class="doc-table" aria-label="جدول المستندات">
                        <thead>
                            <tr>
                                <th scope="col">النوع والتصنيف</th>
                                <th scope="col" class="th-start">الجهة المربوطة</th>
                                <th scope="col" class="th-start">اسم الملف والبيان</th>
                                <th scope="col">الحجم</th>
                                <th scope="col">صلاحية المستند</th>
                                <th scope="col">تاريخ الرفع</th>
                                <th scope="col" style="width: 140px">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Filtered)
                            {
                                <tr>
                                    <td>
                                        <span class="doc-type-badge">@d.TypeName</span>
                                    </td>
                                    <td class="td-start">
                                        <div class="doc-entity-cell">
                                            <span class="doc-entity-name">@EntityAr(d.EntityType)</span>
                                            <span class="doc-id-chip">#@d.EntityId</span>
                                        </div>
                                    </td>
                                    <td class="td-start">
                                        <div class="doc-file-info">
                                            <span class="doc-file-title">@(d.OriginalFileName ?? d.FileName)</span>
                                            @if (!string.IsNullOrWhiteSpace(d.Description))
                                            {
                                                <span class="doc-file-desc">@d.Description</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="td-muted font-mono" dir="ltr">@FileSize(d.FileSizeBytes ?? 0)</td>
                                    <td>
                                        @if (d.ExpiryDate is null)
                                        {
                                            <span class="td-muted">—</span>
                                        }
                                        else if (d.Expired)
                                        {
                                            <span class="doc-status-chip chip-expired">
                                                <span class="chip-dot" aria-hidden="true"></span>
                                                منتهي (@d.ExpiryDate)
                                            </span>
                                        }
                                        else if (ExpiringSoon.Contains(d))
                                        {
                                            <span class="doc-status-chip chip-soon">
                                                <span class="chip-dot" aria-hidden="true"></span>
                                                @d.ExpiryDate
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="doc-status-chip chip-valid">
                                                <span class="chip-dot" aria-hidden="true"></span>
                                                @d.ExpiryDate
                                            </span>
                                        }
                                    </td>
                                    <td class="td-muted font-mono">@d.UploadedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="doc-row-actions">
                                            <button class="doc-btn-download" @onclick="() => Download(d)" title="تحميل المستند">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                                تحميل
                                            </button>

                                            @if (CanDelete)
                                            {
                                                @if (_confirmId == d.DocumentId)
                                                {
                                                    <button class="doc-btn-confirm-del" @onclick="() => Delete(d)">
                                                        متأكد؟
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="doc-btn-del" @onclick="() => _confirmId = d.DocumentId" title="حذف المستند">
                                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                                                        </svg>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Filtered.Any())
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="doc-empty-table">لا توجد مستندات مطابقة للبحث في هذا التصنيف</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>

@* ═══════════════════════════════════════════
   ⚡ GLOW FAB — الوميض الذهبي متعدد الإجراءات
═══════════════════════════════════════════ *@
@if (CanView && !_loading)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            @if (CanUpload)
            {
                <button type="button" class="glow-fab-item" role="menuitem" @onclick="OpenUpload">
                    <span class="glow-fab-item-ic">
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" />
                    </span>
                    <span class="glow-fab-item-lb">رفع مستند جديد</span>
                </button>
            }
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="Reload">
                <span class="glow-fab-item-ic">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                </span>
                <span class="glow-fab-item-lb">تحديث البيانات</span>
            </button>
        </div>

        <div class="glow-fab-container">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="glow-fab-btn" @onclick="ToggleFab" @onkeydown="OnFabKeyDown" aria-label="التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

    </div>
}

@* ═══════════════════════════════════════════
   MODAL — رفع مستند جديد
═══════════════════════════════════════════ *@
@if (_modalOpen && CanUpload)
{
    <div class="cust-modal-backdrop" @onclick="Close" role="dialog" aria-modal="true">
        <div class="cust-modal cust-modal-md" @onclick:stopPropagation="true">

            <div class="modal-head">
                <div class="modal-head-icon icon-blue" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div>
                    <div class="modal-title">رفع وإرفاق مستند جديد</div>
                    <div class="modal-sub">ملفات PDF، صور، Word، Excel، ZIP — بحد أقصى 10 ميجابايت</div>
                </div>
                <button class="modal-close-btn" @onclick="Close" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button class="banner-close" @onclick="() => _msg = null">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }

            <div class="modal-body">
                @* Dropzone Area *@
                <div class="doc-upload-dropzone">
                    <label class="doc-dropzone-label">
                        <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.6">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <div class="doc-dropzone-text">
                            @if (_file is null)
                            {
                                <span class="doc-drop-main">اضغط هنا لاختيار الملف من جهازك</span>
                                <span class="doc-drop-sub">أو اسحب الملف وأفلته مباشرة هنا</span>
                            }
                            else
                            {
                                <span class="doc-drop-filename">@_file.Name</span>
                                <span class="doc-drop-filesize">الحجم: @FileSize(_file.Size)</span>
                            }
                        </div>
                        <InputFile OnChange="OnFilePicked" style="display:none" />
                    </label>
                </div>

                <div class="modal-form-grid">
                    <div class="modal-form-field">
                        <label class="modal-field-label">نوع وتصنيف المستند <span class="field-required">*</span></label>
                        <select class="modal-field-input" value="@_uf.DocumentTypeId" @onchange="OnTypeChanged">
                            <option value="0">— اختر نوع المستند —</option>
                            @foreach (var t in _types) { <option value="@t.Id">@t.Label</option> }
                        </select>
                    </div>

                    <div class="modal-form-field">
                        <label class="modal-field-label">الجهة المربوطة <span class="field-required">*</span></label>
                        <select class="modal-field-input" value="@_uf.EntityType" @onchange='e => _uf.EntityType = e.Value?.ToString() ?? "Other"'>
                            @foreach (var e in EntityTypes) { <option value="@e">@EntityAr(e)</option> }
                        </select>
                    </div>

                    <div class="modal-form-field">
                        <label class="modal-field-label">رقم الجهة / المعرف <span class="field-required">*</span></label>
                        <input type="number" min="1" class="modal-field-input" value="@_uf.EntityId"
                               @onchange="e => _uf.EntityId = ParseLong(e.Value)" placeholder="رقم العميل، السائق، الفاتورة..." />
                    </div>

                    @if (CurrentType?.HasExpiry == true)
                    {
                        <div class="modal-form-field">
                            <label class="modal-field-label">تاريخ الانتهاء <span class="field-required">*</span></label>
                            <input type="date" class="modal-field-input" value="@_uf.ExpiryDate"
                                   @onchange="e => _uf.ExpiryDate = e.Value?.ToString()" />
                        </div>
                    }

                    <div class="modal-form-field modal-field-full">
                        <label class="modal-field-label">الوصف والبيان التفصيلي</label>
                        <input class="modal-field-input" value="@_uf.Description" maxlength="500"
                               @onchange="e => _uf.Description = e.Value?.ToString()" placeholder="ملاحظات أو بيان المستند..." />
                    </div>
                </div>
            </div>

            <div class="modal-foot">
                <button class="modal-cancel-btn" @onclick="Close">إلغاء</button>
                <button class="modal-save-btn" @onclick="Upload" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm"></span>
                        <span>جاري الرفع...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>رفع المستند</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ════════════════════════════════════════════════════════
       HERO WRAPPER
    ════════════════════════════════════════════════════════ */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow:
            0 12px 32px rgba(13, 38, 84, 0.15),
            0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .fc-hero-title-slim {
        font-size: clamp(18px, 2vw, 24px) !important;
        margin: 0 !important;
    }

    .doc-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .doc-hero-left {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .doc-hero-crumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 10.5px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 2px;
    }

    .doc-hero-sub {
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.55);
        font-weight: 600;
    }

    .doc-hero-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .doc-hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: rgba(255, 255, 255, 0.7);
        font-size: 10.5px;
        font-weight: 700;
        font-family: "Inter", Arial, sans-serif;
        white-space: nowrap;
    }

    .doc-chip-warn {
        background: rgba(239, 68, 68, 0.15) !important;
        border-color: rgba(239, 68, 68, 0.35) !important;
        color: #fca5a5 !important;
    }

    /* KPIs Row */
    .doc-kpis-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        margin-top: 12px;
    }

    .doc-kpi {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(12px);
        border-radius: 10px;
        padding: 10px 12px;
    }

    .doc-kpi-inner { display: flex; align-items: center; gap: 10px; }

    .doc-kpi-icon {
        width: 34px; height: 34px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
