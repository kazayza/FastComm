</style>


@code {
    [Parameter] public long? Id { get; set; }
    private long?   _id;
    private string  _number    = "";
    private string  _status    = "Draft";
    private int     _activeTab = 0;
    private bool    _fabOpen;

    private AuthUser? _user;
    private bool CanCreate => _user?.Can("INVOICE.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("INVOICE.EDIT")   ?? false;
    private bool CanSave   => _id is null ? CanCreate : CanEdit;

    private bool Locked => _id is not null && _status is not ("Draft" or "Approved");

    private bool    _loading = true;
    private bool    _saving;
    private bool    _triedSave;
    private string? _msg;
    private bool    _ok = true;

    private Form     _f      = new();
    private LineForm _manual = new();
    private long     _pickOp;

    private List<Cust>  _customers         = new();
    private List<Cust>  _filteredCustomers = new();
    private List<Svc>   _services          = new();
    private List<Tax>   _taxRates          = new();
    private List<OpRef> _ops               = new();

    private string _customerSearch = "";
    private bool   _showCustomerDropdown;
    private int    _focusedItemIndex = -1; // لتتبع العنصر المختار بالأسهم

    /* ── Validation Feedback ── */
    private bool HasTabError(int tab) => _triedSave && tab switch
    {
        1 => _f.CustomerId == 0 || string.IsNullOrWhiteSpace(_f.InvoiceDate),
        2 => !_f.Items.Any(),
        _ => false
    };

    /* ── Status Arabic & Colors ── */
    private static string StatusAr(string s) => s switch
    {
        "Draft"         => "مسودة",
        "Approved"      => "معتمدة",
        "Issued"        => "مصدّرة",
        "Sent"          => "مُرسلة",
        "PartiallyPaid" => "مدفوعة جزئياً",
        "Paid"          => "مدفوعة بالكامل",
        "Cancelled"     => "ملغاة",
        _               => s
    };

    private static string StatusBadgeClass(string s) => s switch
    {
        "Draft"         => "badge-draft",
        "Approved"      => "badge-approved",
        "Issued"        => "badge-issued",
        "Sent"          => "badge-sent",
        "Paid"          => "badge-paid",
        "PartiallyPaid" => "badge-partpaid",
        "Cancelled"     => "badge-cancelled",
        _               => "badge-draft"
    };

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id = Id;
        if (!CanSave) { _loading = false; return; }

        _customers = await SafeGetT<Cust>("api/invoices/customers");
        _services  = await SafeGetT<Svc>("api/invoices/services");
        _taxRates  = await SafeGetT<Tax>("api/invoices/tax-rates");

        if (_id is not null)
        {
            await LoadAsync(_id.Value);
        }
        else
        {
            _f.InvoiceDate = DateTime.Today.ToString("yyyy-MM-dd");
            _loading = false;
        }
    }

    private async Task LoadAsync(long id)
    {
        _loading = true;
        try
        {
            var e = await Http.GetFromJsonAsync<Envelope>($"api/invoices/{id}");
            if (e is null) { _ok = false; _msg = "الفاتورة غير موجودة بالسجلات"; return; }

            _number = e.Invoice.InvoiceNumber;
            _status = e.Invoice.Status;
            _f = new Form
            {
                CustomerId  = e.Invoice.CustomerId,
                InvoiceDate = e.Invoice.InvoiceDate,
                DueDate     = e.Invoice.DueDate,
                Notes       = e.Invoice.Notes,
                Items       = e.Items.Select(x => x.ToForm()).ToList()
            };
            _customerSearch = e.Invoice.CustomerName;
            _ops = await SafeGetT<OpRef>($"api/invoices/billable-operations?customerId={_f.CustomerId}");
        }
        catch (Exception ex) { _ok = false; _msg = "فشل في تحميل الفاتورة: " + ex.Message; }
        finally { _loading = false; }
    }

    /* ── Autocomplete Search (معالجة الأحداث الذكية) ── */
    private void OnCustomerSearch(ChangeEventArgs e)
    {
        _customerSearch = e.Value?.ToString() ?? "";
        _showCustomerDropdown = true;
        _focusedItemIndex = -1; // إعادة تصفير السهم عند الكتابة الجديدة
        FilterCustomers(_customerSearch);
    }

    private void FilterCustomers(string search)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            _filteredCustomers = _customers.Take(20).ToList();
            return;
        }

        var normalized = NormalizeArabic(search.Trim());
        _filteredCustomers = _customers
            .Where(c => NormalizeArabic(c.Label).Contains(normalized) ||
                        NormalizeArabic(c.Code).Contains(normalized))
            .Take(20)
            .ToList();
    }

    private async Task OnCustomerInputKeyDown(KeyboardEventArgs e)
    {
        if (!_showCustomerDropdown || !_filteredCustomers.Any())
        {
            if (e.Key == "ArrowDown") _showCustomerDropdown = true;
            return;
        }

        if (e.Key == "ArrowDown")
        {
            _focusedItemIndex = (_focusedItemIndex + 1) % _filteredCustomers.Count;
        }
        else if (e.Key == "ArrowUp")
        {
            _focusedItemIndex = _focusedItemIndex <= 0 ? _filteredCustomers.Count - 1 : _focusedItemIndex - 1;
        }
        else if (e.Key == "Enter")
        {
            if (_focusedItemIndex >= 0 && _focusedItemIndex < _filteredCustomers.Count)
            {
                await PickCustomer(_filteredCustomers[_focusedItemIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            _showCustomerDropdown = false;
            _focusedItemIndex = -1;
        }
    }

    private void OnCustomerInputFocus()
    {
        _showCustomerDropdown = true;
        _focusedItemIndex = -1;
        FilterCustomers(_customerSearch);
    }

    private async Task OnCustomerInputBlur()
    {
        // ننتظر قليلاً للسماح لـ mousedown بتسجيل الاختيار قبل إخفاء القائمة
        await Task.Delay(200);
        _showCustomerDropdown = false;
        
        // إذا خرج المستخدم ولم يثبت عميل حقيقي، نعيد إرجاع القيمة السابقة أو تصفيرها
        if (_f.CustomerId > 0)
        {
            var current = _customers.FirstOrDefault(c => c.Id == _f.CustomerId);
            if (current != null) _customerSearch = current.Label;
        }
        else
        {
            _customerSearch = "";
        }
    }

    private async Task PickCustomer(Cust c)
    {
        if (Locked) return;
        _f.CustomerId = c.Id;
        _customerSearch = c.Label;
        _showCustomerDropdown = false;
        _focusedItemIndex = -1;
        _f.Items = new();
        _ops = await SafeGetT<OpRef>($"api/invoices/billable-operations?customerId={_f.CustomerId}");
        StateHasChanged();
    }

    private void ClearCustomerSelection()
    {
        _f.CustomerId = 0;
        _customerSearch = "";
        _focusedItemIndex = -1;
        _filteredCustomers = _customers.Take(20).ToList();
        _f.Items = new();
        _ops = new();
    }

    /* ── التطبيع الفائق للغة العربية ── */
    private static string NormalizeArabic(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;

        // إزالة الحركات والتشكيل تماماً لعدم التشويش على المطابقة
        string[] diacritics = new[] { "َ", "ُ", "ِ", "ّ", "ً", "ٌ", "ٍ", "ْ", "ـ" };
        foreach (var d in diacritics)
        {
            s = s.Replace(d, "");
        }

        return s
            .Replace('أ', 'ا')
            .Replace('إ', 'ا')
            .Replace('آ', 'ا')
            .Replace('ٱ', 'ا')
            .Replace('ء', 'ا')
            .Replace('ة', 'ه')
            .Replace('ى', 'ي')
            .Replace('ؤ', 'و')
            .Replace('ئ', 'ي')
            .Replace("  ", " ") // معالجة المسافات الثنائية
            .ToLowerInvariant()
            .Trim();
    }

    /* ── Operations Lines Import ── */
    private async Task OnPickOp(ChangeEventArgs e)
    {
        var id = long.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : 0;
        if (id == 0) return;
        try
        {
            var lines = await Http.GetFromJsonAsync<List<LineForm>>($"api/invoices/operations/{id}/lines");
            if (lines is null || lines.Count == 0)
            { 
                Snackbar.Add("هذه العملية لا تحتوي على بنود إيرادات", Severity.Warning); 
                return; 
            }
            _f.Items.AddRange(lines);
            Snackbar.Add($"تم إدراج {lines.Count} بنود بنجاح من العملية", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add("فشل استيراد العملية: " + ex.Message, Severity.Error); }
    }

    /* ── Manual Lines ── */
    private void OnManualService(ChangeEventArgs e)
    {
        var n = ParseInt(e.Value);
        _manual.ServiceId = n > 0 ? n : null;
        var s = _services.FirstOrDefault(x => x.Id == _manual.ServiceId);
        if (s is null) return;
        _manual.Description = s.Label;
        _manual.TaxRateId ??= s.TaxRateId;
    }

    private void AddManual()
    {
        if (string.IsNullOrWhiteSpace(_manual.Description))
        { 
            Snackbar.Add("يرجى اختيار الخدمة أولاً", Severity.Warning); 
            return; 
        }
        _f.Items.Add(new LineForm
        {
            ServiceId   = _manual.ServiceId, 
            Description = _manual.Description,
            Quantity    = _manual.Quantity == 0 ? 1 : _manual.Quantity,
            UnitPrice   = _manual.UnitPrice, 
            Discount    = _manual.Discount, 
            TaxRateId   = _manual.TaxRateId
        });
        _manual = new LineForm();
    }

    private void OnLineTax(LineForm l, ChangeEventArgs e)
    {
        var n = ParseInt(e.Value);
        l.TaxRateId = n > 0 ? n : null;
    }

    /* ── Computed Calculations ── */
    private decimal RateOf(int id) => _taxRates.FirstOrDefault(t => t.Id == id)?.Rate ?? 0m;
    private decimal LineSub(LineForm l) => l.Quantity * l.UnitPrice - l.Discount;
    private decimal LineTax(LineForm l) =>
        Math.Round(LineSub(l) * (l.TaxRateId is null ? 0m : RateOf(l.TaxRateId.Value)) / 100m, 4);
    private decimal LineTotal(LineForm l) => LineSub(l) + LineTax(l);
    private decimal SubTotal  => _f.Items.Sum(LineSub);
    private decimal TaxTotal  => _f.Items.Sum(LineTax);
    private decimal FormTotal => _f.Items.Sum(LineTotal);

    /* ── Save ── */
    private async Task SaveAsync()
    {
        _triedSave = true;
        _msg = null;

        if (_f.CustomerId <= 0) 
        { 
            _ok = false; 
            _msg = "يرجى اختيار العميل أولاً"; 
            _activeTab = 0;
            return; 
        }

        if (!_f.Items.Any())    
        { 
            _ok = false; 
            _msg = "يرجى إضافة بند واحد على الأقل للفاتورة"; 
            _activeTab = 1;
            return; 
        }

        _saving = true;
        try
        {
            var payload = new
            {
                customerId   = _f.CustomerId, 
                invoiceDate  = _f.InvoiceDate, 
                dueDate      = _f.DueDate,
                notes        = _f.Notes,
                items = _f.Items.Select(l => new
                {
                    operationId = l.OperationId, 
                    serviceId   = l.ServiceId, 
                    priceRuleId = l.PriceRuleId,
                    description = l.Description, 
                    quantity    = l.Quantity, 
                    unitPrice   = l.UnitPrice,
                    discount    = l.Discount, 
                    taxRateId   = l.TaxRateId
                }).ToList(),
                operationIds = _f.Items.Where(l => l.OperationId is not null)
                                       .Select(l => l.OperationId!.Value).Distinct().ToList()
            };

            var res = _id is null
                ? await Http.PostAsJsonAsync("api/invoices", payload)
                : await Http.PutAsJsonAsync($"api/invoices/{_id}", payload);

            _msg = await MsgOf(res); 
            _ok = res.IsSuccessStatusCode;

            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                Nav.NavigateTo("/invoices");
            }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل في حفظ الفاتورة: " + ex.Message; }
        finally { _saving = false; }
    }

    private void GoBack() => Nav.NavigateTo("/invoices");
    private void ToggleFab() => _fabOpen = !_fabOpen;

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم الحفظ بنجاح" : $"حدث خطأ {(int)res.StatusCode}"; }
    }

    private static string Money(decimal v) => v.ToString("N2");
    private static decimal ParseDec(object? v) => decimal.TryParse(v?.ToString(), out var n) ? n : 0m;
    private static int ParseInt(object? v)     => int.TryParse(v?.ToString(), out var n) ? n : 0;
    private static string Req(object? v)       => v?.ToString() ?? "";
    private static string? OptStr(object? v)
    {
        var t = v?.ToString();
        return string.IsNullOrWhiteSpace(t) ? null : t;
    }

    /* ── DTOs ── */
    public class Form
    {
        public int            CustomerId  { get; set; }
        public string?        InvoiceDate { get; set; }
        public string?        DueDate     { get; set; }
        public string?        Notes       { get; set; }
        public List<LineForm> Items       { get; set; } = new();
    }

    public class LineForm
    {
        public long?   OperationId     { get; set; }
        public string? OperationNumber { get; set; }
        public int?    ServiceId       { get; set; }
        public long?   PriceRuleId     { get; set; }
        public string  Description     { get; set; } = "";
        public decimal Quantity        { get; set; } = 1;
        public decimal UnitPrice       { get; set; }
        public decimal Discount        { get; set; }
        public int?    TaxRateId       { get; set; }
    }

    public class LineOut
    {
        public long    InvoiceItemId   { get; set; }
        public long?   OperationId     { get; set; }
        public string? OperationNumber { get; set; }
        public int?    ServiceId       { get; set; }
        public string  Description     { get; set; } = "";
        public decimal Quantity        { get; set; }
        public decimal UnitPrice       { get; set; }
        public decimal Discount        { get; set; }
        public int?    TaxRateId       { get; set; }
        public decimal TaxRate         { get; set; }
        public decimal LineSubtotal    { get; set; }
        public decimal LineTax         { get; set; }
        public decimal LineTotal       { get; set; }

        public LineForm ToForm() => new()
        {
            OperationId     = OperationId, 
            OperationNumber = OperationNumber, 
            ServiceId       = ServiceId,
            Description     = Description, 
            Quantity        = Quantity, 
            UnitPrice       = UnitPrice,
            Discount        = Discount, 
            TaxRateId       = TaxRateId
        };
    }

    public class Cust  { public int Id { get; set; } public string Label { get; set; } = ""; public string Code { get; set; } = ""; public int? PaymentTermId { get; set; } }
    public class Svc   { public int Id { get; set; } public string Label { get; set; } = ""; public string Unit { get; set; } = ""; public int? TaxRateId { get; set; } }
    public class Tax   { public int Id { get; set; } public string Label { get; set; } = ""; public decimal Rate { get; set; } }
    /* ── تحميل مصروفات محمّلة على العميل ── */
    private long? _pickOpBx;
    private List<BxExpense> _bxList = new();
    private HashSet<long> _bxSel = new();
    private bool _bxLoading, _bxBusy;

    public class BxExpense
    {
        public long     ExpenseId       { get; set; }
        public string   ExpenseNumber   { get; set; } = "";
        public DateTime ExpenseDate     { get; set; }
        public string   ExpenseTypeName { get; set; } = "";
        public string?  Description     { get; set; }
        public decimal  ActualAmount    { get; set; }
        public decimal  BillableAmount  { get; set; }
        public decimal  BillableTaxRate { get; set; }
    }

    private async Task OnPickOpBx(ChangeEventArgs e)
    {
        _pickOpBx = long.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null;
        _bxSel.Clear();
        _bxList = new();
        if (_pickOpBx is null) return;
        _bxLoading = true;
        try { _bxList = await SafeGetT<BxExpense>($"api/invoices/billable-expenses?operationId={_pickOpBx.Value}"); }
        finally { _bxLoading = false; }
    }

    private void ToggleBx(long id, ChangeEventArgs e)
    {
        if (e.Value is true) _bxSel.Add(id); else _bxSel.Remove(id);
    }

    private void ToggleAllBx(ChangeEventArgs e)
    {
        _bxSel.Clear();
        if (e.Value is true)
            foreach (var x in _bxList) _bxSel.Add(x.ExpenseId);
    }

    private async Task AddSelectedBx()
    {
        if (_id is null || _bxSel.Count == 0) return;
        _bxBusy = true;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/invoices/{_id}/add-expenses",
                new { expenseIds = _bxSel.ToList() });
            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(msg, Severity.Success);
                _pickOpBx = null; _bxList = new(); _bxSel.Clear();
                await LoadAsync(_id.Value);
            }
            else { _ok = false; _msg = msg; }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل في تحميل المصروفات: " + ex.Message; }
        finally { _bxBusy = false; }
    }

    public class OpRef { public long OperationId { get; set; } public string OperationNumber { get; set; } = ""; public string CustomerName { get; set; } = ""; public decimal RevenueNet { get; set; } public string? InvoiceNumber { get; set; } }

    public class Detail
    {
        public long    InvoiceId     { get; set; }
        public string  InvoiceNumber { get; set; } = "";
        public int     CustomerId    { get; set; }
        public string  CustomerName  { get; set; } = "";
        public string? InvoiceDate   { get; set; }
        public string? DueDate       { get; set; }
        public string  Status        { get; set; } = "";
        public string? Notes         { get; set; }
    }

    public class Envelope
    {
        public Detail        Invoice { get; set; } = new();
        public List<LineOut> Items   { get; set; } = new();
    }
}