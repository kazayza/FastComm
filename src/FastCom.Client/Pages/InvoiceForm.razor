@page "/invoices/new"
@page "/invoices/new/{Id:long}"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_id is null ? "فاتورة عميل جديدة" : $"تعديل {_number}") — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="bk-hero-row">
                <div class="bk-hero-left">
                    <div class="bk-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                        <span>المالية · فواتير العملاء</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">
                        @if (_id is null)
                        {
                            <span>فاتورة عميل جديدة</span>
                        }
                        else
                        {
                            <span>@_number</span>
                        }
                    </h1>
                    <span class="bk-hero-sub">
                        @(_id is null ? "إصدار فاتورة رسمية من بنود العمليات أو إضافة بنود يدوية" : $"تعديل بيانات وبنود الفاتورة رقم {_number}")
                    </span>
                </div>

                <div class="bk-hero-right">
                    @if (_id is not null)
                    {
                        <span class="bk-hero-chip @StatusBadgeClass(_status)">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 6v6l4 2" stroke-linecap="round"/>
                            </svg>
                            @StatusAr(_status)
                        </span>
                    }
                    <span class="bk-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

        </div>

        @* ── ملخص الفاتورة ── *@
        @if (!_loading && _f.CustomerId > 0)
        {
            <div class="bk-hero-summary">

                <div class="bk-sum-item">
                    <div class="bk-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div class="bk-sum-text">
                        <div class="bk-sum-label">العميل</div>
                        <div class="bk-sum-val">@(_customers.FirstOrDefault(c => c.Id == _f.CustomerId)?.Label ?? _customerSearch)</div>
                    </div>
                </div>

                <div class="bk-sum-div" aria-hidden="true"></div>

                <div class="bk-sum-item">
                    <div class="bk-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 11l3 3L22 4"/>
                            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                        </svg>
                    </div>
                    <div class="bk-sum-text">
                        <div class="bk-sum-label">عدد البنود</div>
                        <div class="bk-sum-val">@_f.Items.Count بند</div>
                    </div>
                </div>

                <div class="bk-sum-div" aria-hidden="true"></div>

                <div class="bk-sum-item">
                    <div class="bk-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="bk-sum-text">
                        <div class="bk-sum-label">تاريخ الاستحقاق</div>
                        <div class="bk-sum-val">@(_f.DueDate ?? "حسب شروط الدفع")</div>
                    </div>
                </div>

                <div class="bk-sum-div" aria-hidden="true"></div>

                <div class="bk-sum-item">
                    <div class="bk-sum-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <div class="bk-sum-text">
                        <div class="bk-sum-label">الإجمالي المستحق</div>
                        <div class="bk-sum-val total-highlight">@Money(FormTotal) ج.م</div>
                    </div>
                </div>

            </div>
        }

    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="bk-body">

    @* No Permission *@
    @if (!CanSave)
    {
        <div class="bk-state-box">
            <div class="bk-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>@(_id is null ? "ليس لديك صلاحية إنشاء فاتورة عميل جديدة." : "ليس لديك صلاحية تعديل هذه الفاتورة.")</p>
            <button class="bk-state-back" @onclick="GoBack">العودة لقائمة الفواتير</button>
        </div>
    }

    @* Loading *@
    else if (_loading)
    {
        <div class="bk-loading-wrap">
            <div class="bk-spinner" aria-label="جاري التحميل"></div>
            <div class="bk-loading-text">جاري تحميل بيانات الفاتورة...</div>
        </div>
    }

    @* MAIN CONTENT *@
    else
    {
        @* Locked Banner *@
        @if (Locked)
        {
            <div class="bk-locked-banner" role="alert">
                <div class="locked-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="locked-text">
                    <strong>الفاتورة مقفلة للتعديل</strong>
                    <span>
                        الفاتورة <b>@_number</b> بحالة «@StatusAr(_status)» — التعديل متاح فقط في حالتي «مسودة» أو «معتمدة».
                    </span>
                </div>
            </div>
        }

        @* Error/Success Banner *@
        @if (_msg is not null)
        {
            <div class="bk-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                <div aria-hidden="true">
                    @if (_ok)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                            <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    }
                </div>
                <span>@_msg</span>
                <button class="banner-close" @onclick="() => _msg = null">✕</button>
            </div>
        }

        @* ═══════ TABS ═══════ *@
        <div class="bk-tabs-wrap">

            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     PanelClass="bk-tab-panel"
                     @bind-ActivePanelIndex="_activeTab"
                     Class="bk-mud-tabs">

                @* ══════════════════════════════════════
                   TAB 1 — بيانات الفاتورة الأساسية
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <span>بيانات الفاتورة والعميل</span>
                            @if (HasTabError(1))
                            {
                                <span class="btab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon blue" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="tab-section-title">بيانات العميل والفاتورة</div>
                                    <div class="tab-section-sub">تحديد العميل، تواريخ الإصدار والاستحقاق، والملاحظات الإدارية</div>
                                </div>
                            </div>

                            <div class="bk-form-grid">

                                @* العميل — بحث *@
                                <div class="form-field">
                                    <label class="field-label" for="customer">
                                        العميل
                                        <span class="field-required" aria-label="مطلوب">*</span>
                                    </label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="11" cy="11" r="8"/>
                                                <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="customer"
                                               class="field-input with-prefix @(_f.CustomerId == 0 && _triedSave ? "field-error" : "")"
                                               value="@_customerSearch"
                                               disabled="@Locked"
                                               placeholder="ابحث باسم العميل أو الكود..."
                                               @oninput="OnCustomerSearch"
                                               @onkeydown="OnCustomerInputKeyDown"
                                               @onfocus="OnCustomerInputFocus"
                                               @onblur="OnCustomerInputBlur"
                                               aria-required="true"
                                               autocomplete="off" />

                                        @if (!string.IsNullOrEmpty(_customerSearch) && !Locked)
                                        {
                                            <button type="button" class="field-clear-btn" @onclick="ClearCustomerSelection" title="مسح الاختيار">
                                                ✕
                                            </button>
                                        }
                                    </div>
                                    @if (_showCustomerDropdown && _filteredCustomers.Count > 0)
                                    {
                                        <div class="field-dropdown">
                                            @for (int i = 0; i < _filteredCustomers.Count; i++)
                                            {
                                                var c = _filteredCustomers[i];
                                                var index = i;
                                                <div class="field-dropdown-item @(index == _focusedItemIndex ? "is-focused" : "")" 
                                                     @mousedown="() => PickCustomer(c)">
                                                    <span>@c.Label</span>
                                                    <span class="invf-code">(@c.Code)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (_f.CustomerId == 0 && _triedSave)
                                    {
                                        <div class="field-err-msg" role="alert">اختيار العميل مطلوب</div>
                                    }
                                    else
                                    {
                                        <div class="field-hint">
                                            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                            </svg>
                                            البحث ذكي وسريع
                                        </div>
                                    }
                                </div>

                                @* تاريخ الفاتورة *@
                                <div class="form-field">
                                    <label class="field-label" for="invdate">
                                        تاريخ الفاتورة
                                        <span class="field-required" aria-label="مطلوب">*</span>
                                    </label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="5" width="18" height="16" rx="2"/>
                                                <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="invdate" type="date"
                                               class="field-input with-prefix"
                                               value="@_f.InvoiceDate"
                                               disabled="@Locked"
                                               @onchange="e => _f.InvoiceDate = Req(e.Value)" />
                                    </div>
                                </div>

                                @* تاريخ الاستحقاق *@
                                <div class="form-field">
                                    <label class="field-label" for="duedate">تاريخ الاستحقاق</label>
                                    <div class="field-input-group">
                                        <span class="field-prefix" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="M12 6v6l4 2" stroke-linecap="round"/>
                                            </svg>
                                        </span>
                                        <input id="duedate" type="date"
                                               class="field-input with-prefix"
                                               value="@_f.DueDate"
                                               disabled="@Locked"
                                               @onchange="e => _f.DueDate = OptStr(e.Value)" />
                                    </div>
                                    <div class="field-hint">
                                        <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                            <circle cx="8" cy="8" r="6"/>
                                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                        </svg>
                                        اترك الفراغ ليتم حسابه تلقائياً بناءً على شروط دفع العميل المحددة مسبقاً
                                    </div>
                                </div>

                            </div>

                            @* ملاحظات الفاتورة *@
                            <div class="tab-section-sub-head">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                                ملاحظات وتوجيهات الفاتورة
                            </div>

                            <div class="form-field">
                                <textarea class="field-input field-textarea"
                                          rows="3"
                                          maxlength="1000"
                                          disabled="@Locked"
                                          placeholder="أدخل أي شروط دفع خاصة أو ملاحظات تظهر في المطبوعة..."
                                          @onchange="e => _f.Notes = OptStr(e.Value)">@_f.Notes</textarea>
                            </div>

                        </div>
                    </ChildContent>
                </MudTabPanel>


                @* ══════════════════════════════════════
                   TAB 2 — بنود الفاتورة والخدمات
                ══════════════════════════════════════ *@
                <MudTabPanel>
                    <TabContent>
                        <div class="btab-label">
                            <div class="btab-icon btab-green" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="8" y1="6" x2="21" y2="6"></line>
                                    <line x1="8" y1="12" x2="21" y2="12"></line>
                                    <line x1="8" y1="18" x2="21" y2="18"></line>
                                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                                </svg>
                            </div>
                            <span>بنود الفاتورة</span>
                            @if (_f.Items.Count > 0)
                            {
                                <span class="btab-count">@_f.Items.Count</span>
                            }
                            @if (HasTabError(2))
                            {
                                <span class="btab-err-dot" aria-label="يوجد خطأ"></span>
                            }
                        </div>
                    </TabContent>

                    <ChildContent>
                        <div class="tab-section">

                            <div class="tab-section-head">
                                <div class="tab-section-icon green" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="1" x2="12" y2="23"></line>
                                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                    </svg>
                                </div>
                                <div style="flex:1">
                                    <div class="tab-section-title">بنود وإيرادات الفاتورة</div>
                                    <div class="tab-section-sub">
                                        إجمالي
                                        <strong>@_f.Items.Count</strong>
                                        بند بقيمة
                                        <strong>@Money(FormTotal) ج.م</strong>
                                    </div>
                                </div>
                            </div>

                            @* ── إدراج من العمليات الجاهزة ── *@
                            @if (_f.CustomerId > 0 && !Locked)
                            {
                                <div class="inv-op-selector-box">
                                    <div class="inv-op-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="1" y="3" width="15" height="13" rx="2"/>
                                            <path d="M16 8h4l3 3v5h-7V8z"/>
                                            <circle cx="5.5" cy="18.5" r="2.5"/>
                                            <circle cx="18.5" cy="18.5" r="2.5"/>
                                        </svg>
                                    </div>
                                    <div class="inv-op-content">
                                        <div class="inv-op-title">إدراج بنود من العمليات المكتملة للعميل</div>
                                        <div class="field-select-wrap mt-2">
                                            <svg class="field-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                            </svg>
                                            <select class="field-input field-select"
                                                    value="@_pickOp"
                                                    @onchange="OnPickOp">
                                                <option value="0">— اختر عملية لإضافة بنود إيراداتها تلقائياً —</option>
                                                @foreach (var o in _ops)
                                                {
                                                    <option value="@o.OperationId">
                                                        @o.OperationNumber — صافي: @Money(o.RevenueNet) ج.م
                                                        @(o.InvoiceNumber is null ? " (جاهزة للفوترة)" : " · مفوترة سابقاً في " + o.InvoiceNumber)
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* ── تحميل مصروفات محمّلة على العميل ── *@
                            @if (_f.CustomerId > 0 && !Locked)
                            {
                                <div class="inv-op-selector-box inv-bx-box">
                                    <div class="inv-op-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                            <path d="M14 2v6h6M9 13h6M9 17h4" stroke-linecap="round"/>
                                        </svg>
                                    </div>
                                    <div class="inv-op-content">
                                        <div class="inv-op-title">تحميل مصروفات على العميل</div>
                                        <div class="inv-bx-sub">
                                            المصروفات التي حُدِّدت لها قيمة محمّلة (هيئة · جمارك · شرطة · طريق…)
                                            تُضاف للفاتورة بقيمتها المحمّلة لا بقيمتها الفعلية
                                        </div>

                                        @if (_id is null)
                                        {
                                            <div class="inv-bx-note">احفظ الفاتورة أولًا — ثم اختر العملية لتحميل مصروفاتها</div>
                                        }
                                        else
                                        {
                                            <div class="field-select-wrap mt-2">
                                                <svg class="field-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                                </svg>
                                                <select class="field-input field-select"
                                                        value="@_pickOpBx"
                                                        @onchange="OnPickOpBx">
                                                    <option value="0">— اختر عملية لعرض مصروفاتها القابلة للتحميل —</option>
                                                    @foreach (var o in _ops)
                                                    {
                                                        <option value="@o.OperationId">@o.OperationNumber</option>
                                                    }
                                                </select>
                                            </div>

                                            @if (_bxLoading)
                                            {
                                                <div class="inv-bx-note">جارٍ التحميل...</div>
                                            }
                                            else if (_pickOpBx is not null && _bxList.Count == 0)
                                            {
                                                <div class="inv-bx-note">لا توجد مصروفات محمّلة غير مفوترة لهذه العملية</div>
                                            }
                                            else if (_bxList.Count > 0)
                                            {
                                                <div class="inv-bx-table-wrap">
                                                    <table class="inv-bx-table">
                                                        <thead>
                                                            <tr>
                                                                <th style="width:34px"></th>
                                                                <th>المصروف</th>
                                                                <th>النوع</th>
                                                                <th>الفعلي (ج.م)</th>
                                                                <th>المحمّل (ج.م)</th>
                                                                <th>ضريبة %</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var x in _bxList)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <input type="checkbox"
                                                                               checked="@_bxSel.Contains(x.ExpenseId)"
                                                                               @onchange="e => ToggleBx(x.ExpenseId, e)"
                                                                               aria-label="اختيار @x.ExpenseNumber" />
                                                                    </td>
                                                                    <td>
                                                                        <div class="bx-num">@x.ExpenseNumber</div>
                                                                        <div class="bx-desc">@(string.IsNullOrWhiteSpace(x.Description) ? x.ExpenseTypeName : x.Description)</div>
                                                                    </td>
                                                                    <td>@x.ExpenseTypeName</td>
                                                                    <td>@Money(x.ActualAmount)</td>
                                                                    <td><strong>@Money(x.BillableAmount)</strong></td>
                                                                    <td>@x.BillableTaxRate.ToString("0.##")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div class="inv-bx-foot">
                                                    <label class="inv-bx-all">
                                                        <input type="checkbox"
                                                               checked="@(_bxSel.Count == _bxList.Count && _bxList.Count > 0)"
                                                               @onchange="ToggleAllBx" />
                                                        تحديد الكل
                                                    </label>
                                                    <button type="button" class="inv-add-btn"
                                                            @onclick="AddSelectedBx"
                                                            disabled="@(_bxBusy || _bxSel.Count == 0)">
                                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                                        </svg>
                                                        @(_bxBusy ? "جارٍ الإضافة..." : $"أضف المحدد ({_bxSel.Count}) إلى الفاتورة")
                                                    </button>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @* ── إضافة سطر يدوي ── *@
                            @if (!Locked)
                            {
                                <div class="inv-manual-card">
                                    <div class="inv-manual-head">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                        </svg>
                                        <span>إضافة بند يدوي جديد</span>
                                    </div>

                                    <div class="inv-manual-grid">
                                        @* الخدمة *@
                                        <div class="form-field span-2">
                                            <label class="field-label">الخدمة</label>
                                            <div class="field-select-wrap">
                                                <svg class="field-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                                    <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
                                                </svg>
                                                <select class="field-input field-select"
                                                        value="@_manual.ServiceId"
                                                        @onchange="OnManualService">
                                                    <option value="0">— اختر خدمة —</option>
                                                    @foreach (var s in _services)
                                                    {
                                                        <option value="@s.Id">@s.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        @* الكمية *@
                                        <div class="form-field">
                                            <label class="field-label">الكمية</label>
                                            <input type="number" step="0.001" min="0" class="field-input"
                                                   placeholder="1" value="@_manual.Quantity"
                                                   @onchange="e => _manual.Quantity = ParseDec(e.Value)" />
                                        </div>

                                        @* السعر *@
                                        <div class="form-field">
                                            <label class="field-label">السعر</label>
                                            <div class="field-input-group">
                                                <span class="field-prefix">ج.م</span>
                                                <input type="number" step="0.01" min="0" class="field-input with-prefix"
                                                       placeholder="0.00" value="@_manual.UnitPrice"
                                                       @onchange="e => _manual.UnitPrice = ParseDec(e.Value)" />
                                            </div>
                                        </div>

                                        @* الخصم *@
                                        <div class="form-field">
                                            <label class="field-label">الخصم</label>
                                            <div class="field-input-group">
                                                <span class="field-prefix">ج.م</span>
                                                <input type="number" step="0.01" min="0" class="field-input with-prefix"
                                                       placeholder="0.00" value="@_manual.Discount"
                                                       @onchange="e => _manual.Discount = ParseDec(e.Value)" />
                                            </div>
                                        </div>

                                        @* الضريبة *@
                                        <div class="form-field">
                                            <label class="field-label">الضريبة</label>
                                            <div class="field-select-wrap">
                                                <select class="field-input field-select"
                                                        value="@_manual.TaxRateId"
                                                        @onchange="e => _manual.TaxRateId = ParseInt(e.Value) == 0 ? null : ParseInt(e.Value)">
                                                    <option value="0">بدون ضريبة</option>
                                                    @foreach (var t in _taxRates)
                                                    {
                                                        <option value="@t.Id">@t.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        @* زر الإضافة *@
                                        <div class="form-field" style="align-self:flex-end">
                                            <button type="button" class="inv-add-btn" @onclick="AddManual">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                                </svg>
                                                إدراج البند
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* ── جدول البنود الفعلي ── *@
                            <div class="tab-section-sub-head" style="margin-top:28px">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <path d="M14 2v6h6"/>
                                </svg>
                                قائمة بنود الفاتورة (@_f.Items.Count)
                            </div>

                            @if (!_f.Items.Any())
                            {
                                <div class="bk-containers-empty">
                                    <div class="containers-empty-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4">
                                            <line x1="12" y1="1" x2="12" y2="23"></line>
                                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                        </svg>
                                    </div>
                                    <div class="containers-empty-title">لا توجد بنود في الفاتورة حتى الآن</div>
                                    <div class="containers-empty-sub">اختر عملية لجلب بنودها أو استخدم نموذج الإضافة اليدوية بالأعلى</div>
                                </div>
                            }
                            else
                            {
                                <div class="inv-table-wrap">
                                    <table class="inv-table">
                                        <thead>
                                            <tr>
                                                <th style="width:35px">#</th>
                                                <th>بيان الخدمة / البند</th>
                                                <th style="width:110px">الكمية</th>
                                                <th style="width:130px">السعر (ج.م)</th>
                                                <th style="width:120px">الخصم (ج.م)</th>
                                                <th style="width:140px">معدل الضريبة</th>
                                                <th style="width:130px; text-align:left">الإجمالي</th>
                                                <th style="width:50px"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var l in _f.Items)
                                            {
                                                var idx = _f.Items.IndexOf(l) + 1;
                                                <tr>
                                                    <td class="inv-td-num">@idx</td>
                                                    <td>
                                                        <div class="invf-desc">@l.Description</div>
                                                        @if (l.OperationNumber is not null)
                                                        {
                                                            <span class="invf-op-tag">
                                                                <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                                                    <path d="M16 8h4l3 3v5h-7V8z"/>
                                                                </svg>
                                                                @l.OperationNumber
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <input type="number" step="0.001" min="0" class="inv-tbl-input"
                                                               value="@l.Quantity" disabled="@Locked"
                                                               @onchange="e => l.Quantity = ParseDec(e.Value)" />
                                                    </td>
                                                    <td>
                                                        <input type="number" step="0.01" min="0" class="inv-tbl-input"
                                                               value="@l.UnitPrice" disabled="@Locked"
                                                               @onchange="e => l.UnitPrice = ParseDec(e.Value)" />
                                                    </td>
                                                    <td>
                                                        <input type="number" step="0.01" min="0" class="inv-tbl-input"
                                                               value="@l.Discount" disabled="@Locked"
                                                               @onchange="e => l.Discount = ParseDec(e.Value)" />
                                                    </td>
                                                    <td>
                                                        <select class="inv-tbl-input" value="@(l.TaxRateId ?? 0)"
                                                                disabled="@Locked"
                                                                @onchange="e => OnLineTax(l, e)">
                                                            <option value="0">بدون ضريبة</option>
                                                            @foreach (var t in _taxRates)
                                                            {
                                                                <option value="@t.Id">@t.Label</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td style="text-align:left">
                                                        <span class="inv-line-tot">@Money(LineTotal(l))</span>
                                                    </td>
                                                    <td>
                                                        @if (!Locked)
                                                        {
                                                            <button class="bk-cc-del"
                                                                    @onclick="() => _f.Items.Remove(l)"
                                                                    title="حذف البند">
                                                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                                </svg>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                @* ── Financial Stats Summary Cards ── *@
                                <div class="inv-summary-cards">
                                    <div class="inv-sum-card">
                                        <div class="inv-sum-card-head">
                                            <span class="inv-sum-card-icon blue">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
                                                </svg>
                                            </span>
                                            <span class="inv-sum-card-title">المجموع قبل الضريبة</span>
                                        </div>
                                        <div class="inv-sum-card-val">@Money(SubTotal) <small>ج.م</small></div>
                                    </div>

                                    <div class="inv-sum-card">
                                        <div class="inv-sum-card-head">
                                            <span class="inv-sum-card-icon amber">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M12 6v6l4 2"/>
                                                </svg>
                                            </span>
                                            <span class="inv-sum-card-title">إجمالي الضرائب</span>
                                        </div>
                                        <div class="inv-sum-card-val">@Money(TaxTotal) <small>ج.م</small></div>
                                    </div>

                                    <div class="inv-sum-card highlight">
                                        <div class="inv-sum-card-head">
                                            <span class="inv-sum-card-icon green">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                                </svg>
                                            </span>
                                            <span class="inv-sum-card-title">صافي الفاتورة المستحق</span>
                                        </div>
                                        <div class="inv-sum-card-val primary">@Money(FormTotal) <small>ج.م</small></div>
                                    </div>
                                </div>
                            }

                        </div>
                    </ChildContent>
                </MudTabPanel>

            </MudTabs>
        </div>


        @* ── Bottom Actions ── *@
        <div class="bk-bottom-actions">

            <button class="bk-bottom-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                رجوع لقائمة الفواتير
            </button>

            @if (CanSave && !Locked)
            {
                <div class="bk-bottom-right">

                    @if (_activeTab == 0)
                    {
                        <button class="bk-next-btn" @onclick="() => _activeTab = 1">
                            التالي: بنود الفاتورة
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    }

                    <button class="bk-bottom-save" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="btn-spinner sm" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>حفظ الفاتورة</span>
                        }
                    </button>

                </div>
            }

        </div>

    }
</div>


@* ── FAB (زر عائم للحفظ السريع) ── *@
@if (CanSave && !Locked)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="SaveAsync" disabled="@_saving">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                        <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span class="glow-fab-item-lb">@(_saving ? "جاري الحفظ..." : "حفظ الفاتورة")</span>
            </button>
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="GoBack">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span class="glow-fab-item-lb">إلغاء</span>
            </button>
        </div>

        <div class="glow-fab-container">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="glow-fab-btn" @onclick="ToggleFab" aria-label="التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

    </div>
}

@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
}


@* ═══════════════════════════════════════════
   CSS STYLES
═══════════════════════════════════════════ *@
<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ── Hero Wrapper ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }

    .hero-wrapper .fc-hero {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow: 0 12px 32px rgba(13, 38, 84, 0.15), 0 4px 12px rgba(13, 38, 84, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-wrapper .fc-hero.fc-hero-slim {
        padding-top: 18px !important;
        padding-bottom: 22px !important;
    }

    .bk-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .bk-hero-left { flex: 1; min-width: 200px; }

    .bk-hero-crumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 6px;
    }

    .bk-hero-sub { font-size: 13px; color: rgba(255, 255, 255, 0.55); }
    .bk-hero-right { display: flex; gap: 8px; flex-wrap: wrap; }

    .bk-hero-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(255, 255, 255, .1);
        border: 1px solid rgba(255, 255, 255, .2);
        font-size: 11.5px;
        color: #fff;
    }

    .badge-draft     { background: rgba(255,255,255,.12); color: rgba(255,255,255,.8); border: 1px solid rgba(255,255,255,.2); }
    .badge-approved  { background: rgba(59,130,246,.25); color: #93c5fd; border: 1px solid rgba(59,130,246,.3); }
    .badge-issued    { background: rgba(168,85,247,.25); color: #d8b4fe; border: 1px solid rgba(168,85,247,.3); }
    .badge-sent      { background: rgba(234,179,8,.25); color: #fde68a; border: 1px solid rgba(234,179,8,.3); }
    .badge-paid      { background: rgba(34,197,94,.25); color: #86efac; border: 1px solid rgba(34,197,94,.3); }
    .badge-partpaid  { background: rgba(249,115,22,.25); color: #fdba74; border: 1px solid rgba(249,115,22,.3); }
    .badge-cancelled { background: rgba(239,68,68,.25); color: #fca5a5; border: 1px solid rgba(239,68,68,.3); }

    .bk-hero-summary {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px);
        margin-top: 14px;
    }

    .bk-sum-item { flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px 16px; }
    .bk-sum-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }
    .bk-sum-icon {
        width: 32px; height: 32px; flex: 0 0 32px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.10); color: rgba(255,255,255,.7);
    }
    .bk-sum-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .bk-sum-val   { font-size: 13px; font-weight: 800; color: #fff; margin-top: 2px; }
    .total-highlight { color: #86efac !important; font-size: 14px; }

    /* ── Body ── */
    .bk-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 180px);
        padding: 18px clamp(16px, 3vw, 40px) 96px;
        max-width: 1440px; width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
        position: relative;
        z-index: 2;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* ── States & Banners ── */
    .bk-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 280px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .bk-state-icon {
        width: 68px; height: 68px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .bk-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .bk-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .bk-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }
    .bk-state-back {
        margin-top: 8px; padding: 9px 20px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-text);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: background .15s ease;
    }
    .bk-state-back:hover { background: #f0f4fa; }

    .bk-loading-wrap {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 14px; min-height: 260px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .bk-spinner {
        width: 36px; height: 36px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: bk-spin .75s linear infinite;
    }
    @@keyframes bk-spin { to { transform: rotate(360deg); } }
    .bk-loading-text { font-size: 13px; font-weight: 600; color: var(--fc-muted); }

    .bk-locked-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px; border-radius: 12px;
        background: linear-gradient(135deg, #fffbeb, #fff8e0);
        border: 1px solid #fde68a;
        box-shadow: 0 2px 10px rgba(234,179,8,.10);
    }
    .locked-icon { flex: 0 0 auto; color: #d97706; }
    .locked-text { display: flex; flex-direction: column; gap: 2px; }
    .locked-text strong { font-size: 13px; font-weight: 800; color: #92400e; }
    .locked-text span   { font-size: 11.5px; color: #b45309; }

    .bk-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600;
        animation: bk-banner-in .25s ease;
    }
    @@keyframes bk-banner-in {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .banner-success { background: #e9f8f0; color: #0e7a43; border: 1px solid #b5e8d0; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); border: 1px solid #ffc8d0; }
    .banner-close {
        margin-right: auto; background: none; border: none;
        color: inherit; opacity: .6; cursor: pointer; font-size: 13px;
        padding: 2px 6px; border-radius: 5px;
    }

    /* ── Tabs ── */
    .bk-tabs-wrap {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden; flex: 1;
    }
    .bk-mud-tabs .mud-tabs-toolbar {
        background: linear-gradient(180deg, #f9fafd 0%, #f3f6fb 100%);
        border-bottom: 2px solid #e8edf5;
        padding: 0 16px; min-height: 54px;
    }
    .bk-mud-tabs .mud-tab {
        font-family: inherit; font-size: 12px; font-weight: 700; color: var(--fc-muted);
        padding: 0 6px; min-width: unset; transition: color .15s ease;
    }
    .bk-mud-tabs .mud-tab.mud-tab-active { color: var(--fc-blue) !important; font-weight: 800; }
    .bk-mud-tabs .mud-tab-slider { background: var(--fc-blue) !important; height: 3px; border-radius: 3px 3px 0 0; }
    .bk-tab-panel { padding: 0; }

    .btab-label { display: flex; align-items: center; gap: 7px; padding: 0 4px; white-space: nowrap; }
    .btab-icon {
        width: 26px; height: 26px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 7px;
    }
    .btab-blue  { background: var(--fc-blue-lt);  color: var(--fc-blue); }
    .btab-green { background: var(--fc-green-lt); color: var(--fc-green); }
    .btab-count {
        min-width: 18px; height: 18px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 5px; padding: 0 4px;
        background: var(--fc-green-lt); color: var(--fc-green);
        font-size: 10px; font-weight: 900;
    }
    .btab-err-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--fc-red); flex: 0 0 7px;
        animation: bk-pulse 1.5s ease infinite;
    }
    @@keyframes bk-pulse {
        0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.4); }
        50%      { box-shadow: 0 0 0 5px rgba(224,48,72,0); }
    }

    /* ── Tab Sections & Forms ── */
    .tab-section {
        padding: 24px clamp(16px, 3vw, 40px) 28px;
        max-width: 1440px; margin: 0 auto; width: 100%;
        box-sizing: border-box;
    }
    .tab-section-head {
        display: flex; align-items: flex-start; gap: 12px;
        margin-bottom: 22px; padding-bottom: 18px;
        border-bottom: 1px solid #edf1f7;
    }
    .tab-section-icon {
        width: 42px; height: 42px; flex: 0 0 42px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 12px;
    }
    .tab-section-icon.blue  { background: var(--fc-blue-lt);  color: var(--fc-blue);  border: 1px solid #bdd4fc; }
    .tab-section-icon.green { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .tab-section-title { font-size: 15px; font-weight: 800; color: #1c2b43; line-height: 1.2; }
    .tab-section-sub   { font-size: 11px; font-weight: 500; color: var(--fc-muted); margin-top: 3px; }

    .tab-section-sub-head {
        display: flex; align-items: center; gap: 7px;
        font-size: 12.5px; font-weight: 800; color: #344258;
        margin: 22px 0 12px; padding-top: 18px; border-top: 1px solid #edf1f7;
    }

    .bk-form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 18px; width: 100%;
    }

    .form-field { display: flex; flex-direction: column; gap: 6px; position: relative; }
    .form-field.span-2 { grid-column: span 2; }
    .field-label { font-size: 12px; font-weight: 800; color: #344258; display: flex; align-items: center; gap: 4px; }
    .field-required { color: var(--fc-red); font-size: 14px; line-height: 1; }

    .field-input {
        height: 42px; width: 100%;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 13px; padding: 0 12px;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        outline: none; box-sizing: border-box;
    }
    .field-input:focus {
        border-color: var(--fc-blue);
        box-shadow: 0 0 0 3px rgba(30,110,245,.10);
        background: #fff;
    }
    .field-input:disabled { opacity: .7; background: #f3f5f8; cursor: not-allowed; }
    .field-input.field-error { border-color: var(--fc-red); box-shadow: 0 0 0 3px rgba(224,48,72,.08); }
    .field-textarea { height: auto; padding: 10px 12px; resize: vertical; min-height: 70px; }

    .field-select-wrap { position: relative; display: flex; align-items: center; width: 100%; }
    .field-select-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; z-index: 1; }
    .field-select { padding-right: 36px; cursor: pointer; -webkit-appearance: none; appearance: none; }
    .field-select:disabled { cursor: not-allowed; }

    .field-input-group { position: relative; display: flex; align-items: center; width: 100%; }
    .field-prefix {
        position: absolute; right: 12px; display: flex; align-items: center;
        font-size: 11px; font-weight: 700; color: #9aaabb; pointer-events: none; z-index: 1;
    }
    .field-input.with-prefix { padding-right: 36px; }

    /* زر الحذف السريع لفلتر العميل */
    .field-clear-btn {
        position: absolute; left: 12px;
        background: none; border: none;
        color: #9aaabb; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        padding: 4px; border-radius: 50%;
        transition: background .15s, color .15s;
        font-size: 11px; font-weight: bold;
    }
    .field-clear-btn:hover { background: rgba(0,0,0,0.05); color: var(--fc-red); }

    .field-dropdown {
        position: absolute; top: 100%; right: 0; left: 0; margin-top: 4px;
        background: #fafcff; border: 1px solid #d8e2f0; border-radius: 9px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12); max-height: 240px; overflow-y: auto; z-index: 100;
    }
    .field-dropdown-item {
        display: flex; justify-content: space-between; align-items: center;
        padding: 10px 12px; font-size: 13px; color: var(--fc-text); cursor: pointer; transition: background .1s;
    }
    .field-dropdown-item:hover, .field-dropdown-item.is-focused { background: #eaf1ff; color: var(--fc-blue); font-weight: 600; }
    .invf-code { color: var(--fc-muted); font-size: 11px; font-weight: 600; }
    .field-hint { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--fc-muted); font-weight: 500; }
    .field-err-msg { font-size: 10.5px; color: var(--fc-red); font-weight: 700; }

    /* ── Operations Box & Manual Line Adder ── */
    .inv-op-selector-box {
        display: flex; align-items: center; gap: 14px;
        background: linear-gradient(135deg, #f0f7ff, #e6f1fc);
        border: 1px solid #cce2fa; border-radius: 12px;
        padding: 16px 18px; margin-bottom: 20px;
    }
    .inv-op-icon {
        width: 42px; height: 42px; border-radius: 10px;
        background: #dbeafe; color: var(--fc-blue);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .inv-op-content { flex: 1; }
    .inv-op-title { font-size: 12.5px; font-weight: 800; color: #1e3a8a; }

    .inv-manual-card {
        background: #fbfcfe; border: 1px solid #e3eaf3;
        border-radius: 12px; padding: 16px 18px; margin-bottom: 22px;
    }
    .inv-manual-head {
        display: flex; align-items: center; gap: 6px;
        font-size: 12.5px; font-weight: 800; color: #1c2b43; margin-bottom: 12px;
    }
    .inv-manual-grid {
        display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1.2fr auto;
        gap: 12px; align-items: flex-end;
    }
    .inv-add-btn {
        height: 42px; padding: 0 16px;
        background: var(--fc-blue); color: #fff;
        border: none; border-radius: 9px; font-family: inherit;
        font-size: 12px; font-weight: 800; cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
        box-shadow: 0 3px 10px rgba(30,110,245,.25); transition: all .15s ease;
    }
    .inv-add-btn:hover { background: #155cd0; transform: translateY(-1px); }

    /* ── Items Table ── */
    .inv-table-wrap {
        background: #fff; border: 1px solid #e4edf8; border-radius: 12px;
        overflow-x: auto; box-shadow: 0 2px 8px rgba(15,41,82,.03); margin-top: 10px;
    }
    .inv-table { width: 100%; border-collapse: collapse; text-align: right; }
    .inv-table th {
        background: #f8fafd; padding: 12px 14px;
        font-size: 11.5px; font-weight: 800; color: #475569;
        border-bottom: 2px solid #e8edf5; white-space: nowrap;
    }
    .inv-table td {
        padding: 10px 14px; border-bottom: 1px solid #f0f4f9;
        font-size: 12.5px; vertical-align: middle;
    }
    .inv-td-num { font-weight: 800; color: var(--fc-muted); font-size: 11px; text-align: center; }
    .invf-desc { font-weight: 700; color: var(--fc-text); }
    .invf-op-tag {
        display: inline-flex; align-items: center; gap: 4px;
        margin-top: 4px; padding: 2px 8px; font-size: 10px; font-weight: 700;
        border-radius: 20px; background: rgba(30,110,245,.10); color: var(--fc-blue);
    }
    .inv-tbl-input {
        height: 36px; width: 100%;
        border: 1px solid #d8e2f0; border-radius: 7px;
        background: #fafcff; font-family: inherit; font-size: 12.5px;
        padding: 0 8px; outline: none; transition: border-color .15s ease;
    }
    .inv-tbl-input:focus { border-color: var(--fc-blue); background: #fff; }
    .inv-line-tot { font-weight: 800; color: #0f172a; font-size: 13px; }
    .bk-cc-del {
        width: 32px; height: 32px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; background: transparent;
        color: var(--fc-red); cursor: pointer; transition: all .15s ease;
    }
    .bk-cc-del:hover { background: var(--fc-red-lt); border-color: #ffc8cf; }

    .bk-containers-empty {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 10px; min-height: 180px;
        border: 2px dashed #d8e8f8; border-radius: 12px;
        background: #f8fbff; text-align: center; padding: 30px;
    }
    .containers-empty-icon {
        width: 64px; height: 64px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #edf3fb; color: #b0c4d8;
    }
    .containers-empty-title { font-size: 14px; font-weight: 800; color: var(--fc-text); }
    .containers-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    /* ── Summary Financial Cards ── */
    .inv-summary-cards {
        display: grid; grid-template-columns: repeat(3, 1fr);
        gap: 16px; margin-top: 24px;
    }
    .inv-sum-card {
        background: #fff; border: 1px solid #e2e8f0;
        border-radius: 12px; padding: 16px 18px;
        box-shadow: 0 2px 6px rgba(0,0,0,.02);
    }
    .inv-sum-card.highlight {
        background: linear-gradient(135deg, #f0fdf4, #e8f9ee);
        border-color: #bbf7d0;
    }
    .inv-sum-card-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .inv-sum-card-icon {
        width: 28px; height: 28px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
    }
    .inv-sum-card-icon.blue  { background: var(--fc-blue-lt);  color: var(--fc-blue); }
    .inv-sum-card-icon.amber { background: var(--fc-amber-lt); color: var(--fc-amber); }
    .inv-sum-card-icon.green { background: #dcfce7; color: var(--fc-green); }
    .inv-sum-card-title { font-size: 11.5px; font-weight: 700; color: #64748b; }
    .inv-sum-card-val { font-size: 18px; font-weight: 900; color: #1e293b; }
    .inv-sum-card-val.primary { color: var(--fc-green); font-size: 20px; }
    .inv-sum-card-val small { font-size: 11px; font-weight: 700; color: #94a3b8; }

    /* ── Bottom Actions ── */
    .bk-bottom-actions {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; padding: 14px 20px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 8px rgba(15,41,82,.04);
    }
    .bk-bottom-back {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .bk-bottom-back:hover { background: #f0f4fa; color: var(--fc-text); }
    .bk-bottom-back svg { transform: rotate(180deg); }
    .bk-bottom-right { display: flex; align-items: center; gap: 10px; }

    .bk-next-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .bk-next-btn:hover { background: var(--fc-blue); color: #fff; }
    .bk-next-btn svg { transform: rotate(180deg); }

    .bk-bottom-save {
        display: inline-flex; align-items: center; gap: 8px;
        height: 40px; padding: 0 22px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(30,110,245,.30); transition: all .15s ease;
    }
    .bk-bottom-save:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(30,110,245,.38); }
    .bk-bottom-save:disabled { opacity: .6; cursor: not-allowed; }

    /* ── FAB ── */
    .glow-fab-wrap { position: fixed; left: 28px; bottom: 28px; z-index: 1299; }
    .glow-fab-container { position: relative; z-index: 2; width: 64px; height: 64px; }
    .glow-fab-btn {
        position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 60px; height: 60px; border-radius: 50%;
        background: linear-gradient(135deg, #1e6ef5, #0d47a1);
        border: 2.5px solid #fbbf24; color: #fff; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 16px rgba(30, 110, 245, .4); transition: transform .2s, box-shadow .2s;
        z-index: 2;
    }
    .glow-fab-btn:hover { transform: translate(-50%, -50%) scale(1.05); }
    .glow-fab-icon { transition: transform .3s; }
    .glow-fab-wrap.is-open .glow-fab-icon { transform: rotate(130deg); }

    .glow-halo, .glow-ring {
        position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
        border-radius: 50%; pointer-events: none;
    }
    .glow-halo {
        width: 60px; height: 60px;
        background: radial-gradient(circle, rgba(30, 110, 245, .3) 0%, transparent 70%);
        animation: glow-breath 2s ease-in-out infinite;
    }
    .glow-ring {
        width: 60px; height: 60px;
        border: 2px solid rgba(30, 110, 245, .4);
        animation: glow-expand 2s ease-out infinite;
    }
    .glow-ring-2 { animation-delay: .3s; }
    .glow-ring-3 { animation-delay: .6s; }

    @@keyframes glow-breath { 0%, 100% { opacity: .5; transform: translate(-50%, -50%) scale(1); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); } }
    @@keyframes glow-expand { 0% { opacity: .8; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(2.5); } }

    .glow-fab-menu {
        position: absolute; bottom: 80px; left: 0; z-index: 3;
        display: flex; flex-direction: column; gap: 8px;
        opacity: 0; pointer-events: none; transform: translateY(10px);
        transition: opacity .2s, transform .2s;
    }
    .glow-fab-wrap.is-open .glow-fab-menu { opacity: 1; pointer-events: auto; transform: translateY(0); }
    .glow-fab-item {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 16px; border-radius: 12px; background: #fff;
        border: 1px solid #dde5f0; box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
        cursor: pointer; font-size: 13px; color: #1c2c44; white-space: nowrap;
    }
    .glow-fab-item:hover { background: #f4f7fb; border-color: #1e6ef5; }
    .glow-fab-item-ic {
        display: flex; align-items: center; justify-content: center;
        width: 28px; height: 28px; border-radius: 8px; background: #eaf1ff; color: #1e6ef5;
    }
    .glow-fab-scrim {
        position: fixed; inset: 0; background: rgba(9, 18, 35, .45);
        backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 1298;
    }

    .btn-spinner {
        width: 15px; height: 15px;
        border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
        border-radius: 50%; animation: bk-spin .7s linear infinite;
    }
    .btn-spinner.sm { width: 13px; height: 13px; }

    /* ── Responsive ── */
    @@media (max-width: 992px) {
        .inv-manual-grid { grid-template-columns: 1fr 1fr; }
        .inv-manual-grid .span-2 { grid-column: 1 / -1; }
        .inv-summary-cards { grid-template-columns: 1fr; }
        .bk-hero-summary { flex-wrap: wrap; }
        .bk-sum-item { flex: 0 0 50%; }
        .bk-sum-div:nth-child(4) { display: none; }
    }

    @@media (max-width: 768px) {
        .bk-body { padding: 12px 12px 90px; }
        .bk-form-grid { grid-template-columns: 1fr; }
        .inv-manual-grid { grid-template-columns: 1fr; }
        .bk-bottom-actions { flex-direction: column; }
        .bk-bottom-back, .bk-bottom-save, .bk-next-btn { width: 100%; justify-content: center; }
        .bk-bottom-right { width: 100%; flex-direction: column; }
        .bk-sum-item { flex: 0 0 100%; }
        .bk-sum-div { display: none; }
        .glow-fab-wrap { left: 18px; bottom: 18px; }
    }
    /* ── تحميل مصروفات محمّلة على العميل ── */
    .inv-bx-box { margin-top: 12px; }
    .inv-bx-box .inv-op-icon { background: rgba(217, 119, 6, 0.10); color: #b45309; }
    .inv-bx-sub { font-size: 11.5px; color: #64748b; margin-top: 3px; line-height: 1.7; }
    .inv-bx-note { font-size: 12px; font-weight: 700; color: #94a3b8; margin-top: 10px; }
    .inv-bx-table-wrap { margin-top: 10px; border: 1px solid #e6ebf3; border-radius: 10px; overflow: hidden; }
    .inv-bx-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .inv-bx-table th {
        background: #f6f8fb; color: #64748b;
        font-size: 10.5px; font-weight: 800;
        padding: 7px 10px; text-align: right;
        border-bottom: 1px solid #e6ebf3;
    }
    .inv-bx-table td { padding: 8px 10px; border-bottom: 1px solid #eef2f7; color: #1c2b43; }
