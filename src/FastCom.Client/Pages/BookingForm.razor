    }

    .field-input.with-prefix { padding-right: 36px; }

    .field-hint {
        display: flex; align-items: center; gap: 5px;
        font-size: 10.5px; color: var(--fc-muted); font-weight: 500;
    }

    .field-err-msg { font-size: 10.5px; color: var(--fc-red); font-weight: 700; }

    /* ================================================================
       ROUTE VISUAL
    ================================================================ */
    .bk-route-visual {
        display: flex; align-items: center; gap: 0;
        margin-top: 22px; padding: 14px 20px;
        background: linear-gradient(135deg, #f5f8ff, #eef4ff);
