        animation: bk-banner-in .25s ease;
    }

    .route-point { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }

    .route-dot {
        width: 14px; height: 14px; border-radius: 50%;
        border: 3px solid;
    }
    .dot-from { background: var(--fc-blue-lt);  border-color: var(--fc-blue); }
    .dot-to   { background: var(--fc-green-lt); border-color: var(--fc-green); }

    .route-label { display: flex; flex-direction: column; gap: 2px; }
    .route-caption { font-size: 9px; font-weight: 600; color: #8899ae; }
