    /* ================================================================
       CONTAINER CARDS
    ================================================================ */
    .bk-containers-empty {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 10px; min-height: 180px;
        border: 2px dashed #d8e8f8; border-radius: 12px;
        background: #f8fbff; text-align: center; padding: 30px;
    }

    .containers-empty-icon {
        width: 70px; height: 70px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #edf3fb; color: #b0c4d8;
    }
    .containers-empty-title { font-size: 14px; font-weight: 800; color: var(--fc-text); }
    .containers-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    .bk-add-line-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 14px;
        border: 1.5px solid var(--fc-amber);
        border-radius: 9px;
        background: var(--fc-amber-lt); color: #9a6d08;
        font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; white-space: nowrap; flex-shrink: 0;
        transition: all .15s ease;
    }
    .bk-add-line-btn:hover { background: var(--fc-amber); color: #fff; }
    .bk-add-line-btn.mt-10 { margin-top: 10px; }

    .bk-container-cards { display: flex; flex-direction: column; gap: 12px; }

    .bk-container-card {
        border: 1px solid #e4edf8; border-radius: 12px;
        background: linear-gradient(180deg, #fafcff, #f5f8fb);
        overflow: hidden;
        transition: border-color .18s ease, box-shadow .18s ease;
    }
    .bk-container-card:hover {
        border-color: #c8d8f0;
        box-shadow: 0 4px 14px rgba(15,41,82,.06);
    }

    .bk-cc-head {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 14px;
        background: linear-gradient(180deg, #f0f5fc, #eaf1f9);
        border-bottom: 1px solid #dce8f5;
    }

    .bk-cc-num {
        width: 26px; height: 26px; border-radius: 8px; flex: 0 0 26px;
        display: flex; align-items: center; justify-content: center;
        background: var(--fc-blue); color: #fff;
        font-size: 11px; font-weight: 900;
        font-family: "Inter", Arial, sans-serif;
    }

    .bk-cc-type-badge {
        display: flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 7px;
        background: rgba(30,110,245,.08); border: 1px solid rgba(30,110,245,.15);
        color: var(--fc-blue); font-size: 11px; font-weight: 800;
        white-space: nowrap;
    }

    .bk-cc-total {
        flex: 1; font-size: 11px; color: #6b7d95; font-weight: 600;
    }
    .bk-cc-total strong { color: var(--fc-text); font-weight: 900; }
    .bk-cc-total span   { color: #9aaabb; }

    .bk-cc-del {
        width: 30px; height: 30px; border-radius: 7px; flex: 0 0 30px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; background: transparent;
        color: var(--fc-red); cursor: pointer;
        transition: all .15s ease;
    }
    .bk-cc-del:hover { background: var(--fc-red-lt); border-color: #ffc8cf; }

    .bk-cc-body {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 2fr;
        gap: 14px; padding: 14px 16px;
        align-items: start;
    }

    .bk-cc-notes { grid-column: 4; }

    /* Qty Control */
    .bk-qty-control {
        display: flex; align-items: center; gap: 0;
        border: 1px solid #d8e2f0; border-radius: 9px;
        overflow: hidden; background: #fafcff;
    }

    .qty-btn {
        width: 36px; height: 42px; flex: 0 0 36px;
        display: flex; align-items: center; justify-content: center;
        border: none; background: transparent;
        cursor: pointer; font-size: 18px; font-weight: 900;
        transition: background .12s ease;
    }

    .qty-minus { color: var(--fc-red); border-left: 1px solid #d8e2f0; }
    .qty-plus  { color: var(--fc-green); border-right: 1px solid #d8e2f0; }

    .qty-minus:hover { background: var(--fc-red-lt); }
    .qty-plus:hover  { background: var(--fc-green-lt); }

    .qty-input {
        flex: 1; text-align: center; border: none !important;
        border-radius: 0 !important; background: transparent !important;
        box-shadow: none !important;
        font-weight: 800; font-size: 14px;
    }

    /* ================================================================
       BOTTOM ACTIONS
    ================================================================ */
    .bk-bottom-actions {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; padding: 14px 20px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 8px rgba(15,41,82,.04);
    }

    .bk-bottom-back {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1px solid var(--fc-border); border-radius: 9px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .bk-bottom-back:hover { background: #f0f4fa; color: var(--fc-text); }
    .bk-bottom-back svg { transform: rotate(180deg); }

    .bk-bottom-right { display: flex; align-items: center; gap: 10px; }

    .bk-next-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 38px; padding: 0 16px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .bk-next-btn:hover { background: var(--fc-blue); color: #fff; }
    .bk-next-btn svg { transform: rotate(180deg); }

    .bk-bottom-save {
        display: inline-flex; align-items: center; gap: 8px;
        height: 40px; padding: 0 22px;
        border: 0; border-radius: 10px;
        background: linear-gradient(135deg, #1e6ef5, #1558d6);
        color: #fff; font-family: inherit;
        font-size: 13px; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 14px rgba(30,110,245,.30);
        transition: all .15s ease;
    }
    .bk-bottom-save:hover:not(:disabled) {
        transform: translateY(-1px); box-shadow: 0 6px 18px rgba(30,110,245,.38);
    }
    .bk-bottom-save:disabled { opacity: .6; cursor: not-allowed; }

    /* ================================================================
       SPINNER
    ================================================================ */
    .btn-spinner {
        width: 15px; height: 15px;
        border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
        border-radius: 50%; animation: bk-spin .7s linear infinite;
    }
    .btn-spinner.sm { width: 13px; height: 13px; }

    /* ================================================================
       RESPONSIVE
    ================================================================ */
    @@media (max-width: 900px) {
        .bk-form-grid { grid-template-columns: 1fr; }
        .bk-cc-body   { grid-template-columns: 1fr 1fr; }
        .bk-cc-notes  { grid-column: 1 / -1; }
        .bk-hero-summary { flex-wrap: wrap; }
        .bk-sum-item { flex: 0 0 50%; }
        .bk-sum-div:nth-child(4) { display: none; }
        .tab-section { padding: 18px 16px 22px; }
    }

    @@media (max-width: 680px) {
        .bk-body { padding: 10px 12px 24px; }
        .bk-cc-body { grid-template-columns: 1fr; }
        .bk-cc-notes { grid-column: 1; }
        .bk-bottom-actions { flex-direction: column; }
        .bk-bottom-back, .bk-bottom-save { width: 100%; justify-content: center; }
        .bk-bottom-right { width: 100%; flex-direction: column; }
        .bk-next-btn { width: 100%; justify-content: center; }
        .bk-sum-item { flex: 0 0 100%; }
        .bk-sum-div { display: none; }
        .route-label strong { font-size: 11px; }
    }

    @@media (max-width: 480px) {
        .bk-hero-summary { display: none; }
    }

</style>


@code {
    [Parameter] public long? Id { get; set; }
    private long?  _id;
    private string BookingNumber = "";
    private string _status       = "Draft";
    private bool   _locked;
    private int    _activeTab;
    private bool   _triedSave;

    private AuthUser? _user;
    private bool CanCreate => _user?.Can("BOOKING.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("BOOKING.EDIT")   ?? false;
    private bool CanSave   => _id is null ? CanCreate : CanEdit;

    private bool    _loading; private bool _saving;
    private string? _msg;     private bool _ok;

    private List<Opt> _customers      = new();
    private List<Opt> _contacts       = new();
    private List<Opt> _services       = new();
    private List<Opt> _ports          = new();
    private List<Opt> _destinations   = new();
    private List<Opt> _tripTypes      = new();
    private List<Opt> _containerTypes = new();

    private List<LineRow> _lines = new();
    private Form          _f     = new();

    /* ── Validation ── */
    private bool HasTabError(int tab) => _triedSave && tab switch
    {
        1 => _f.CustomerId == 0,
        3 => _lines.Count == 0 || _lines.All(l => l.TypeId == 0 || l.Qty <= 0),
        _ => false
    };

    /* ── Status ── */
    private static string StatusAr(string s) => s switch
    {
        "Draft"      => "مسودة",
        "Confirmed"  => "مؤكد",
        "Assigned"   => "متخصص",
        "InProgress" => "قيد التنفيذ",
        "Completed"  => "مكتمل",
        "Cancelled"  => "ملغي",
        _            => s
    };

    private static string StatusBadgeClass(string s) => s switch
    {
        "Draft"      => "badge-draft",
        "Confirmed"  => "badge-confirmed",
        "Assigned"   => "badge-assigned",
        "InProgress" => "badge-inprogress",
        "Completed"  => "badge-completed",
        "Cancelled"  => "badge-cancelled",
        _            => "badge-draft"
    };

    /* ── DTOs ── */
    public class Opt
    {
        public int    Id    { get; set; }
        public string Label { get; set; } = "";
    }

    public class LineRow
    {
        public int      TypeId   { get; set; }
        public int      Qty      { get; set; } = 1;
        public decimal? WeightKg { get; set; }
        public string?  Notes    { get; set; }
    }

    public class Form
    {
        public int     CustomerId        { get; set; }
        public int?    ContactId         { get; set; }
        public string? RequestedDate     { get; set; }
        public int?    ServiceId         { get; set; }
        public int?    PortId            { get; set; }
        public int?    DestinationId     { get; set; }
        public int?    TripTypeId        { get; set; }
        public string? CustomerReference { get; set; }
        public string? Notes             { get; set; }
    }

    public class DetailRow
    {
        public int      ContainerTypeId { get; set; }
        public int      RequestedQty    { get; set; }
        public decimal? WeightKg        { get; set; }
        public string?  Notes           { get; set; }
    }

    public class DetailBooking
    {
        public string  BookingNumber      { get; set; } = "";
        public int     CustomerId         { get; set; }
        public string? RequestedDate      { get; set; }
        public int?    ServiceId          { get; set; }
        public int?    PortId             { get; set; }
        public int?    DestinationId      { get; set; }
        public int?    TripTypeId         { get; set; }
        public string? CustomerReference  { get; set; }
        public int?    ContactId          { get; set; }
        public string? Notes              { get; set; }
        public string  Status             { get; set; } = "Draft";
    }

    public class DetailResponse
    {
        public DetailBooking Booking { get; set; } = new();
        public List<DetailRow> Lines { get; set; } = new();
    }

    /* ── Helpers ── */
    private static int      ParseInt(object? v, int fallback) =>
        int.TryParse(v?.ToString(), out var n) && n > 0 ? n : fallback;

    private static decimal? ParseDec(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n > 0 ? n : null;

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        _id   = Id;

        if (!CanSave) return;

        _loading = true;
        try
        {
            _customers      = await SafeGet("api/options/customers");
            _services       = await SafeGet("api/options/services");
            _ports          = await SafeGet("api/options/ports");
            _destinations   = await SafeGet("api/options/destinations");
            _tripTypes      = await SafeGet("api/options/trip-types");
            _containerTypes = await SafeGet("api/options/container-types");

            if (_id is not null) await LoadBookingAsync(_id.Value);
            else AddLine();
        }
        catch (Exception ex) { _msg = "فشل التحميل: " + ex.Message; _ok = false; }
        finally { _loading = false; }
    }

    private async Task<List<Opt>> SafeGet(string url)
    {
        try { return await Http.GetFromJsonAsync<List<Opt>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task LoadBookingAsync(long id)
    {
        var d = await Http.GetFromJsonAsync<DetailResponse>($"api/bookings/{id}");
        if (d is null) { _msg = "الحجز مش موجود"; _ok = false; return; }

        BookingNumber = d.Booking.BookingNumber;
        _status       = d.Booking.Status;
        _locked       = _status is not ("Draft" or "Confirmed");

        _f = new Form
        {
            CustomerId        = d.Booking.CustomerId,
            ContactId         = d.Booking.ContactId,
            RequestedDate     = d.Booking.RequestedDate,
            ServiceId         = d.Booking.ServiceId,
            PortId            = d.Booking.PortId,
            DestinationId     = d.Booking.DestinationId,
            TripTypeId        = d.Booking.TripTypeId,
            CustomerReference = d.Booking.CustomerReference,
            Notes             = d.Booking.Notes
        };

        _lines = d.Lines.Select(l => new LineRow
        {
            TypeId   = l.ContainerTypeId,
            Qty      = l.RequestedQty,
            WeightKg = l.WeightKg,
            Notes    = l.Notes
        }).ToList();

        if (_lines.Count == 0) AddLine();
        await LoadContactsAsync(_f.CustomerId);
    }

    private void AddLine()
    {
        _lines.Add(new LineRow
        {
            TypeId = _containerTypes.FirstOrDefault()?.Id ?? 0,
            Qty    = 1
        });
    }

    private void RemoveLine(int idx)
    {
        if (idx >= 0 && idx < _lines.Count) _lines.RemoveAt(idx);
    }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        _f.CustomerId = int.TryParse(e.Value?.ToString(), out var n) ? n : 0;
        _f.ContactId  = null;
        _contacts     = new();
        if (_f.CustomerId > 0) await LoadContactsAsync(_f.CustomerId);
    }

    private async Task LoadContactsAsync(int customerId)
    {
        try
        {
            _contacts = await Http.GetFromJsonAsync<List<Opt>>(
                $"api/options/contacts?customerId={customerId}") ?? new();
        }
        catch { _contacts = new(); }
    }

    private void GoBack() => Nav.NavigateTo("/bookings");

    /* ── Save ── */
    private async Task SaveAsync()
    {
        _triedSave = true;
        _msg       = null;

        if (_f.CustomerId <= 0)
        {
            _ok  = false;
            _msg = "لازم تختار العميل";
            _activeTab = 0;
            return;
        }

        var lines = _lines.Where(l => l.TypeId > 0 && l.Qty > 0).ToList();
        if (lines.Count == 0)
        {
            _ok  = false;
            _msg = "ضيف حاوية واحدة على الأقل";
            _activeTab = 2;
            return;
        }

        var payload = new
        {
            customerId        = _f.CustomerId,
            requestedDate     = _f.RequestedDate,
            serviceId         = _f.ServiceId,
            portId            = _f.PortId,
            destinationId     = _f.DestinationId,
            tripTypeId        = _f.TripTypeId,
            customerReference = _f.CustomerReference,
            contactId         = _f.ContactId,
            notes             = _f.Notes,
            lines             = lines.Select(l => new
            {
                containerTypeId = l.TypeId,
                requestedQty    = l.Qty,
                weightKg        = l.WeightKg,
                notes           = l.Notes
            })
        };

        _saving = true;
        try
        {
            var res = _id is null
                ? await Http.PostAsJsonAsync("api/bookings", payload)
                : await Http.PutAsJsonAsync($"api/bookings/{_id}", payload);

            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(msg, Severity.Success);
                Nav.NavigateTo("/bookings");
            }
            else { _ok = false; _msg = msg; }
        }
        catch (Exception ex) { _ok = false; _msg = "مش قادر أوصل للسيرفر: " + ex.Message; }
        finally { _saving = false; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}