@page "/custodies"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>العهد — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">المالية · العهد</div>
                <h1 class="fc-hero-title">العهد</h1>
                <p class="fc-hero-sub">فلوس بتتسلّم للسائق أو الموظف على الرحلة — بيتصرف منها، والباقي يُرد، وبعدين تتسوّى وتتقفل</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
            </div>
        </div>

        @* FAB *@
        @if (CanCreate)
        {
            <div class="fc-fab-container">
                <button class="fc-fab-main" @onclick="OpenIssue" title="صرف عهدة">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 5v14M5 12h14"/>
                    </svg>
                </button>
            </div>
        }

        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi fc-kpi-click @(_tab == "open" ? "fc-kpi-active" : "")" role="button" tabindex="0"
                     @onclick='() => SetTab("open")'>
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.Savings" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(c => c.Status != "Closed")</div><div class="fc-kpi-lb">عهد مفتوحة</div></div>
                </div>
                <div class="fc-kpi fc-kpi-click @(_tab == "all" ? "fc-kpi-active" : "")" role="button" tabindex="0"
                     @onclick='() => SetTab("all")'>
                    <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></div>
                    <div><div class="fc-kpi-num">@Money(OpenRemaining)</div><div class="fc-kpi-lb">باقي معاهم</div></div>
                </div>
                <div class="fc-kpi fc-kpi-click @(_tab == "all" ? "fc-kpi-active" : "")" role="button" tabindex="0"
                     @onclick='() => SetTab("all")'>
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                    <div><div class="fc-kpi-num">@Money(ThisMonth)</div><div class="fc-kpi-lb">اتصرف الشهر ده</div></div>
                </div>
                <div class="fc-kpi fc-kpi-click @(_tab == "Submitted" ? "fc-kpi-active" : "")" role="button" tabindex="0"
                     @onclick='() => SetTab("Submitted")'>
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(c => c.Status == "Submitted")</div><div class="fc-kpi-lb">مستنية اعتماد</div></div>
                </div>
            </div>
        }
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="cu-body">

    @if (!CanView)
    {
        <div class="cu-state-box">
            <div class="cu-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض العهد — تواصل مع المسؤول</p>
        </div>
    }
    else
    {
        <div class="cu-card">

            @* ── Toolbar ── *@
            <div class="cu-toolbar">

                <div class="cu-search-wrap">
                    <svg class="cu-search-icon" viewBox="0 0 24 24"
                         width="16" height="16" fill="none" stroke="currentColor"
                         stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="cu-search-input"
                           placeholder="ابحث برقم العهدة أو الرحلة أو الاسم..."
                           @bind="_search"
                           @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="cu-search-clear" @onclick="() => _search = string.Empty" aria-label="مسح">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="cu-results-badge">
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>

            </div>


            @* ── Status Tabs ── *@
            <div class="cu-status-bar">
                <div class="cu-status-tabs" role="group" aria-label="فلتر الحالة">
                    @foreach (var t in _statusTabs)
                    {
                        var count = t.Key == "all"
                            ? _items.Count
                            : _items.Count(x => x.Status == t.Key);

                        <button class="cu-status-tab @(_tab == t.Key ? "active" : "")"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="cu-tab-dot @StatusDotColor(t.Key)" aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="cu-tab-count">@count</span>
                        </button>
                    }
                </div>

                @* Workflow Visual *@
                <div class="cu-workflow" aria-label="مراحل العهدة">
                    <div class="cu-wf-step wf-blue">مفتوحة</div>
                    <div class="cu-wf-arrow" aria-hidden="true">→</div>
                    <div class="cu-wf-step wf-amber">تسوية</div>
                    <div class="cu-wf-arrow" aria-hidden="true">→</div>
                    <div class="cu-wf-step wf-purple">اعتماد</div>
                    <div class="cu-wf-arrow" aria-hidden="true">→</div>
                    <div class="cu-wf-step wf-green">مقفولة</div>
                </div>

            </div>


            @* ── Content ── *@
            @if (_loading)
            {
                <div class="cu-loading">
                    <div class="cu-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل العهد...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="cu-empty">
                    <div class="cu-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="42" height="42"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <circle cx="12" cy="14" r="2"/>
                        </svg>
                    </div>
                    <div class="cu-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) ? "لا توجد عهد في هذا الفلتر" : "لا توجد نتائج")
                    </div>
                    <div class="cu-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search)
                            ? "جرّب فلتر مختلف أو اصرف عهدة جديدة"
                            : "جرّب كلمة بحث مختلفة")
                    </div>
                    @if (CanCreate && string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="cu-add-btn" @onclick="OpenIssue">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            صرف عهدة جديدة
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="cu-table-wrap">
                    <table class="cu-table" aria-label="قائمة العهد">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">العهدة</th>
                                <th scope="col">الرحلة</th>
                                <th scope="col">المبالغ</th>
                                <th scope="col">التقدم</th>
                                <th scope="col">الباقي</th>
                                <th scope="col">الحالة</th>
                                <th scope="col" style="width:220px">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Filtered)
                            {
                                var spentPct = c.AmountIssued + c.AdditionalDue > 0
                                    ? (double)(c.AmountSpent / (c.AmountIssued + c.AdditionalDue) * 100)
                                    : 0;
                                var returnedPct = c.AmountIssued + c.AdditionalDue > 0
                                    ? (double)(c.AmountReturned / (c.AmountIssued + c.AdditionalDue) * 100)
                                    : 0;

                                <tr class="@(c.Status == "Closed" ? "row-closed" : "")">

                                    @* ── العهدة: رقم + صاحب + تاريخ ── *@
                                    <td class="td-start">
                                        <div class="cu-custody-cell">
                                            <div class="cu-avatar @AvatarClass(c.Status)"
                                                 aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="16" height="16"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                    <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                                    <circle cx="12" cy="14" r="2"/>
                                                </svg>
                                            </div>
                                            <div class="cu-custody-info">
                                                <button class="cu-code-btn"
                                                        @onclick="() => Open(c)"
                                                        aria-label="فتح دفتر العهدة @c.CustodyNumber">
                                                    @c.CustodyNumber
                                                </button>
                                                <div class="cu-owner-name">
                                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                                         aria-hidden="true">
                                                        <path d="M13 14v-1a3 3 0 00-3-3H6a3 3 0 00-3 3v1"/>
                                                        <circle cx="8" cy="5" r="3"/>
                                                    </svg>
                                                    @c.OwnerName
                                                </div>
                                                <div class="cu-custody-meta">
                                                    <span class="cu-owner-type-tag @(c.OwnerType == "Driver" ? "tag-driver" : "tag-employee")">
                                                        @(c.OwnerType == "Driver" ? "سائق" : "موظف")
                                                    </span>
                                                    <span class="cu-date-tag">
                                                        @c.CustodyDate.ToString("MM/dd")
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    @* ── الرحلة ── *@
                                    <td>
                                        <div class="cu-trip-cell">
                                            <span class="cu-trip-tag">
                                                <svg viewBox="0 0 16 16" width="10" height="10"
                                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                                     aria-hidden="true">
                                                    <rect x="1" y="2" width="10" height="8" rx="1"/>
                                                    <path d="M11 5h3l2 2v3h-5V5z"/>
                                                    <circle cx="3.5" cy="12" r="1.5"/>
                                                    <circle cx="12.5" cy="12" r="1.5"/>
                                                </svg>
                                                @c.TripNumber
                                            </span>
                                            @if (c.DriverName is not null)
                                            {
                                                <div class="cu-trip-driver">@c.DriverName</div>
                                            }
                                        </div>
                                    </td>

                                    @* ── المبالغ ── *@
                                    <td>
                                        <div class="cu-amounts-cell">
                                            <div class="cu-amount-row">
                                                <span class="cu-amt-label">صُرف</span>
                                                <span class="cu-amt-val issued">@Money(c.AmountIssued)</span>
                                            </div>
                                            @if (c.AdditionalDue > 0)
                                            {
                                                <div class="cu-amount-row">
                                                    <span class="cu-amt-label">إضافي</span>
                                                    <span class="cu-amt-val extra">+@Money(c.AdditionalDue)</span>
                                                </div>
                                            }
                                            <div class="cu-amount-row">
                                                <span class="cu-amt-label">أُنفق</span>
                                                <span class="cu-amt-val spent">@Money(c.AmountSpent)</span>
                                            </div>
                                            <div class="cu-amount-row">
                                                <span class="cu-amt-label">رُدّ</span>
                                                <span class="cu-amt-val returned">@Money(c.AmountReturned)</span>
                                            </div>
                                        </div>
                                    </td>

                                    @* ── Progress Bar ── *@
                                    <td>
                                        <div class="cu-progress-cell">
                                            <div class="cu-progress-bar" title="المنصرف @spentPct.ToString("0")% · المرتد @returnedPct.ToString("0")%">
                                                <div class="cu-prog-spent"
                                                     style="width:@Math.Min(spentPct, 100)%"
                                                     aria-label="المنصرف @spentPct.ToString("0")%">
                                                </div>
                                                <div class="cu-prog-returned"
                                                     style="width:@Math.Min(returnedPct, 100)%"
                                                     aria-label="المرتد @returnedPct.ToString("0")%">
                                                </div>
                                            </div>
                                            <div class="cu-progress-labels">
                                                <span class="prog-spent-lbl">@spentPct.ToString("0")%</span>
                                                <span class="prog-returned-lbl">@returnedPct.ToString("0")%</span>
                                            </div>
                                        </div>
                                    </td>

                                    @* ── الباقي ── *@
                                    <td>
                                        <span class="cu-remaining-badge @(c.Remaining > 0 ? "rem-pos" : "rem-zero")">
                                            @if (c.Remaining > 0)
                                            {
                                                <svg viewBox="0 0 16 16" width="10" height="10"
                                                     fill="none" stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <path d="M8 3v5l3 3" stroke-linecap="round"/>
                                                    <circle cx="8" cy="8" r="6"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 16 16" width="10" height="10"
                                                     fill="none" stroke="currentColor" stroke-width="2"
                                                     aria-hidden="true">
                                                    <path d="M3 8l3 3 7-7" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            }
                                            @Money(c.Remaining)
                                        </span>
                                    </td>

                                    @* ── الحالة ── *@
                                    <td>
                                        <span class="cu-chip @StatusChipClass(c.Status)">
                                            <span class="cu-chip-dot @StatusDotClass(c.Status)"
                                                  aria-hidden="true"></span>
                                            @StatusAr(c.Status)
                                        </span>
                                    </td>

                                    @* ── إجراءات ── *@
                                    <td>
                                        <div class="cu-actions">

                                            @* دفتر *@
                                            <button class="cu-act-btn act-info"
                                                    @onclick="() => Open(c)"
                                                    title="دفتر العهدة"
                                                    aria-label="دفتر @c.CustodyNumber">
                                                <svg viewBox="0 0 24 24" width="14" height="14"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                                                </svg>
                                            </button>

                                            @if (c.Status is "Open" or "PartiallySettled" && CanSettle)
                                            {
                                                @* رد / إضافة *@
                                                <button class="cu-act-btn act-tx"
                                                        @onclick="() => OpenTx(c)"
                                                        title="رد باقي / إضافة"
                                                        aria-label="حركة على @c.CustodyNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                                        <circle cx="12" cy="14" r="2"/>
                                                    </svg>
                                                </button>

                                                @* مصروف *@
                                                <button class="cu-act-btn act-expense"
                                                        @onclick="() => GoExpense(c)"
                                                        title="مصروف على العهدة"
                                                        aria-label="مصروف على @c.CustodyNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                                    </svg>
                                                </button>

                                                @* تسوية *@
                                                <button class="cu-act-btn act-settle"
                                                        @onclick="() => Settle(c)"
                                                        title="تقديم التسوية"
                                                        aria-label="تسوية @c.CustodyNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                                        <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* اعتماد *@
                                            @if (c.Status == "Submitted" && CanApprove)
                                            {
                                                <button class="cu-act-btn act-approve"
                                                        @onclick="() => OpenApprove(c)"
                                                        title="اعتماد التسوية"
                                                        aria-label="اعتماد @c.CustodyNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M9 12l2 2 4-4"/>
                                                        <path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* إغلاق *@
                                            @if (c.Status == "Approved" && CanClose)
                                            {
                                                <button class="cu-act-btn act-close"
                                                        @onclick="() => CloseCustody(c)"
                                                        title="إغلاق العهدة"
                                                        aria-label="إغلاق @c.CustodyNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                                                        <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* حذف *@
                                            @if (c.Status == "Open" && CanDelete && c.TxCount <= 1 && c.AmountSpent == 0)
                                            {
                                                @if (_confirmId == c.CustodyId)
                                                {
                                                    <button class="cu-confirm-del" @onclick="() => Delete(c)">
                                                        حذف؟
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="cu-act-btn act-delete"
                                                            @onclick="() => _confirmId = c.CustodyId"
                                                            title="حذف"
                                                            aria-label="حذف @c.CustodyNumber">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   MODAL — صرف عهدة
═══════════════════════════════════════════ *@
@if (_issueOpen && CanCreate)
{
    <div class="cu-modal-backdrop" @onclick="CloseIssue"
         role="dialog" aria-modal="true" aria-label="صرف عهدة">
        <div class="cu-modal" @onclick:stopPropagation="true">

            <div class="cu-modal-head">
                <div class="cu-modal-icon issue-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        <path d="M12 12v4M10 14h4" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <div class="cu-modal-title">صرف عهدة جديدة 💰</div>
                    <div class="cu-modal-sub">الرقم بيتولد تلقائياً (CUS-)</div>
                </div>
                <button class="cu-modal-close" @onclick="CloseIssue" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="cu-modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button @onclick="() => _msg = null">✕</button>
                </div>
            }

            <div class="cu-modal-body">

                <div class="cu-modal-grid">

                    @* الرحلة *@
                    <div class="cu-mfield">
                        <label class="cu-mlabel">
                            الرحلة
                            <span class="cu-mrequired">*</span>
                        </label>
                        <div class="cu-mselect-wrap">
                            <svg class="cu-mselect-icon" viewBox="0 0 24 24"
                                 width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <rect x="1" y="3" width="15" height="13" rx="2"/>
                                <path d="M16 8h4l3 3v5h-7V8z"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                            <select class="cu-minput cu-mselect"
                                    value="@_nf.TripId"
                                    @onchange="OnTripChanged"
                                    aria-required="true">
                                <option value="">— اختر رحلة —</option>
                                @foreach (var t in _trips)
                                {
                                    <option value="@t.TripId">
                                        @t.TripNumber — @t.DriverName (@TripStatusAr(t.Status))
                                    </option>
                                }
                            </select>
                        </div>
                        @if (SelectedTrip is not null)
                        {
                            <div class="cu-mhint selected-trip">
                                <svg viewBox="0 0 16 16" width="11" height="11"
                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <path d="M13 14v-1a3 3 0 00-3-3H6a3 3 0 00-3 3v1"/>
                                    <circle cx="8" cy="5" r="3"/>
                                </svg>
                                سائق الرحلة: <strong>@SelectedTrip.DriverName</strong>
                            </div>
                        }
                    </div>

                    @* تاريخ الصرف *@
                    <div class="cu-mfield">
                        <label class="cu-mlabel">تاريخ الصرف</label>
                        <div class="cu-mfield-group">
                            <span class="cu-mprefix" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                                    <path d="M7 3V7M17 3V7M3 10H21" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input type="datetime-local"
                                   class="cu-minput with-prefix"
                                   value="@_nf.CustodyDate"
                                   @onchange="e => _nf.CustodyDate = e.Value?.ToString()" />
                        </div>
                    </div>

                    @* نوع صاحب العهدة *@
                    <div class="cu-mfield">
                        <label class="cu-mlabel">صاحب العهدة</label>
                        <div class="cu-owner-toggle" role="group" aria-label="نوع صاحب العهدة">
                            <button type="button"
                                    class="cu-owner-btn @(_nf.OwnerType == "Driver" ? "owner-active-driver" : "")"
                                    @onclick='() => OnOwnerTypeChanged_Click("Driver")'
                                    aria-pressed="@(_nf.OwnerType == "Driver")">
                                <svg viewBox="0 0 24 24" width="16" height="16"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                                سائق
                            </button>
                            <button type="button"
                                    class="cu-owner-btn @(_nf.OwnerType == "Employee" ? "owner-active-emp" : "")"
                                    @onclick='() => OnOwnerTypeChanged_Click("Employee")'
                                    aria-pressed="@(_nf.OwnerType == "Employee")">
                                <svg viewBox="0 0 24 24" width="16" height="16"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                </svg>
                                موظف
                            </button>
                        </div>
                    </div>

                    @* الاختيار حسب النوع *@
                    <div class="cu-mfield">
                        <label class="cu-mlabel">
                            @(_nf.OwnerType == "Driver" ? "السائق" : "الموظف")
                            <span class="cu-mrequired">*</span>
                        </label>
                        <div class="cu-mselect-wrap">
                            <svg class="cu-mselect-icon" viewBox="0 0 24 24"
                                 width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            @if (_nf.OwnerType == "Driver")
                            {
                                <select class="cu-minput cu-mselect"
                                        value="@_nf.OwnerId"
                                        @onchange="e => _nf.OwnerId = ParseInt(e.Value)">
                                    <option value="0">— اختر السائق —</option>
                                    @foreach (var d in _drivers)
                                    {
                                        <option value="@d.Id">@d.Label</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <select class="cu-minput cu-mselect"
                                        value="@_nf.OwnerId"
                                        @onchange="e => _nf.OwnerId = ParseInt(e.Value)">
                                    <option value="0">— اختر الموظف —</option>
                                    @foreach (var em in _employees)
                                    {
                                        <option value="@em.Id">@em.Label</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>

                    @* مبلغ العهدة *@
                    <div class="cu-mfield">
                        <label class="cu-mlabel">
                            مبلغ العهدة
                            <span class="cu-mrequired">*</span>
                        </label>
                        <div class="cu-mfield-group">
                            <span class="cu-mprefix" aria-hidden="true">ج.م</span>
                            <input type="number" min="0" step="0.01"
                                   class="cu-minput with-prefix"
                                   value="@_nf.AmountIssued"
                                   placeholder="0.00"
                                   @onchange="e => _nf.AmountIssued = ParseAmount(e.Value)" />
                        </div>
                    </div>

                    @* ملاحظات *@
                    <div class="cu-mfield">
                        <label class="cu-mlabel">ملاحظات</label>
                        <input class="cu-minput"
                               value="@_nf.Notes"
                               maxlength="500"
                               placeholder="أي ملاحظات..."
                               @onchange="e => _nf.Notes = e.Value?.ToString()" />
                    </div>

                </div>

            </div>

            <div class="cu-modal-foot">
                <button class="cu-modal-cancel" @onclick="CloseIssue">إلغاء</button>
                <button class="cu-modal-save issue-save"
                        @onclick="SaveIssue"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <path d="M12 12v4M10 14h4" stroke-linecap="round"/>
                        </svg>
                    }
                    صرف العهدة
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — رد باقي / إضافة
═══════════════════════════════════════════ *@
@if (_txOpen && CanSettle && _txTarget is not null)
{
    <div class="cu-modal-backdrop" @onclick="CloseTx"
         role="dialog" aria-modal="true" aria-label="حركة على العهدة">
        <div class="cu-modal" @onclick:stopPropagation="true">

            <div class="cu-modal-head">
                <div class="cu-modal-icon tx-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                        <circle cx="12" cy="14" r="2"/>
                    </svg>
                </div>
                <div>
                    <div class="cu-modal-title">حركة على العهدة @_txTarget.CustodyNumber</div>
                    <div class="cu-modal-sub">المتاح للرد: <strong>@Money(MaxRefund(_txTarget)) ج.م</strong></div>
                </div>
                <button class="cu-modal-close" @onclick="CloseTx" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="cu-modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button @onclick="() => _msg = null">✕</button>
                </div>
            }

            @* الـ Summary Strip للعهدة *@
            <div class="cu-tx-summary-strip">
                <div class="cu-tx-sum-item">
                    <div class="cu-tx-sum-label">صُرف</div>
                    <div class="cu-tx-sum-val sum-issued">@Money(_txTarget.AmountIssued)</div>
                </div>
                <div class="cu-tx-sum-sep" aria-hidden="true"></div>
                <div class="cu-tx-sum-item">
                    <div class="cu-tx-sum-label">أُنفق</div>
                    <div class="cu-tx-sum-val sum-spent">@Money(_txTarget.AmountSpent)</div>
                </div>
                <div class="cu-tx-sum-sep" aria-hidden="true"></div>
                <div class="cu-tx-sum-item">
                    <div class="cu-tx-sum-label">رُدّ</div>
                    <div class="cu-tx-sum-val sum-returned">@Money(_txTarget.AmountReturned)</div>
                </div>
                <div class="cu-tx-sum-sep" aria-hidden="true"></div>
                <div class="cu-tx-sum-item">
                    <div class="cu-tx-sum-label">الباقي</div>
                    <div class="cu-tx-sum-val @(_txTarget.Remaining > 0 ? "sum-remaining" : "sum-zero")">
                        @Money(_txTarget.Remaining)
                    </div>
                </div>
            </div>

            <div class="cu-modal-body">

                @* نوع الحركة *@
                <div class="cu-tx-type-group" role="group" aria-label="نوع الحركة">
                    <button type="button"
                            class="cu-tx-type-btn @(_tx.Type == "Refund" ? "tx-active-refund" : "")"
                            @onclick='() => _tx.Type = "Refund"'
                            aria-pressed="@(_tx.Type == "Refund")">
                        <svg viewBox="0 0 24 24" width="18" height="18"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                            <path d="M9 22V12h6v10"/>
                        </svg>
                        رد باقي العهدة
                    </button>
                    <button type="button"
                            class="cu-tx-type-btn @(_tx.Type == "Additional" ? "tx-active-add" : "")"
                            @onclick='() => _tx.Type = "Additional"'
                            aria-pressed="@(_tx.Type == "Additional")">
                        <svg viewBox="0 0 24 24" width="18" height="18"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                        </svg>
                        إضافة مبلغ
                    </button>
                </div>

                <div class="cu-modal-grid">

                    <div class="cu-mfield">
                        <label class="cu-mlabel">
                            المبلغ
                            <span class="cu-mrequired">*</span>
                        </label>
                        <div class="cu-mfield-group">
                            <span class="cu-mprefix" aria-hidden="true">ج.م</span>
                            <input type="number" min="0.01" step="0.01"
                                   class="cu-minput with-prefix"
                                   value="@_tx.Amount"
                                   placeholder="0.00"
                                   @onchange="e => _tx.Amount = ParseAmount(e.Value)" />
                        </div>
                        @if (_tx.Type == "Refund" && MaxRefund(_txTarget) > 0)
                        {
                            <div class="cu-mhint">
                                <svg viewBox="0 0 16 16" width="10" height="10"
                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <circle cx="8" cy="8" r="6"/>
                                    <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                </svg>
                                الحد الأقصى للرد: @Money(MaxRefund(_txTarget)) ج.م
                            </div>
                        }
                    </div>

                    <div class="cu-mfield">
                        <label class="cu-mlabel">التاريخ</label>
                        <div class="cu-mfield-group">
                            <span class="cu-mprefix" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <path d="M12 6v6l4 2" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input type="datetime-local"
                                   class="cu-minput with-prefix"
                                   value="@_tx.TxDate"
                                   @onchange="e => _tx.TxDate = e.Value?.ToString()" />
                        </div>
                    </div>

                    <div class="cu-mfield cu-mfield-full">
                        <label class="cu-mlabel">ملاحظات</label>
                        <input class="cu-minput"
                               value="@_tx.Notes"
                               maxlength="500"
                               placeholder="أي تفاصيل إضافية..."
                               @onchange="e => _tx.Notes = e.Value?.ToString()" />
                    </div>

                </div>

            </div>

            <div class="cu-modal-foot">
                <button class="cu-modal-cancel" @onclick="CloseTx">إلغاء</button>
                <button class="cu-modal-save @(_tx.Type == "Refund" ? "refund-save" : "add-save")"
                        @onclick="SaveTx"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <circle cx="12" cy="14" r="2"/>
                        </svg>
                    }
                    @(_tx.Type == "Refund" ? "تسجيل الرد" : "إضافة المبلغ")
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — اعتماد التسوية
═══════════════════════════════════════════ *@
@if (_approveOpen && _approveTarget is not null)
{
    <div class="cu-modal-backdrop" @onclick="CloseApprove"
         role="dialog" aria-modal="true" aria-label="اعتماد التسوية">
        <div class="cu-modal cu-modal-sm" @onclick:stopPropagation="true">

            <div class="cu-modal-head">
                <div class="cu-modal-icon approve-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 12l2 2 4-4"/>
                        <path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                    </svg>
                </div>
                <div>
                    <div class="cu-modal-title">اعتماد تسوية @_approveTarget.CustodyNumber ✅</div>
                    <div class="cu-modal-sub danger-sub">راجع الأرقام — بعد الاعتماد مافيش تعديل</div>
                </div>
                <button class="cu-modal-close" @onclick="CloseApprove" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="cu-modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button @onclick="() => _msg = null">✕</button>
                </div>
            }

            <div class="cu-modal-body">

                @* Summary Cards *@
                <div class="cu-approve-summary">
                    <div class="cu-app-sum-card">
                        <div class="cu-app-sum-label">المصروف</div>
                        <div class="cu-app-sum-val">@Money(_approveTarget.AmountIssued)</div>
                        <div class="cu-app-sum-curr">ج.م</div>
                    </div>
                    <div class="cu-app-sum-card">
                        <div class="cu-app-sum-label">المنصرف فعلاً</div>
                        <div class="cu-app-sum-val spent">@Money(_approveTarget.AmountSpent)</div>
                        <div class="cu-app-sum-curr">ج.م</div>
                    </div>
                    <div class="cu-app-sum-card">
                        <div class="cu-app-sum-label">المرتد</div>
                        <div class="cu-app-sum-val returned">@Money(_approveTarget.AmountReturned)</div>
                        <div class="cu-app-sum-curr">ج.م</div>
                    </div>
                    <div class="cu-app-sum-card @(_approveTarget.Remaining > 0 ? "card-warn" : "card-ok")">
                        <div class="cu-app-sum-label">الباقي</div>
                        <div class="cu-app-sum-val remaining">@Money(_approveTarget.Remaining)</div>
                        <div class="cu-app-sum-curr">ج.م</div>
                    </div>
                </div>

                @if (_needAdditional)
                {
                    <div class="cu-additional-warn" role="alert">
                        <div class="cu-add-warn-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="20" height="20"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                                <path d="M12 9v4M12 17h.01" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div>
                            <strong>صرف أكتر من العهدة!</strong>
                            <p>فعّل الاختيار ده عشان الفرق يتسجل كمبلغ إضافي على العهدة</p>
                        </div>
                    </div>

                    <label class="cu-additional-check @(_addAdditional ? "check-active" : "")">
                        <input type="checkbox" @bind="_addAdditional" />
                        <div class="cu-add-check-box" aria-hidden="true">
                            @if (_addAdditional)
                            {
                                <svg viewBox="0 0 24 24" width="12" height="12"
                                     fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            }
                        </div>
                        <div class="cu-add-check-text">
                            <span>سجّل الفرق كمبلغ إضافي على العهدة</span>
                            <small>هيتسجل تلقائياً كـ «إضافة مبلغ»</small>
                        </div>
                    </label>
                }

            </div>

            <div class="cu-modal-foot">
                <button class="cu-modal-cancel" @onclick="CloseApprove">إلغاء</button>
                <button class="cu-modal-save approve-save"
                        @onclick="ConfirmApprove"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الاعتماد...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M9 12l2 2 4-4"/>
                            <path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                        </svg>
                        <span>اعتماد التسوية</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   MODAL — دفتر العهدة V2
═══════════════════════════════════════════ *@
@if (_detailOpen && _detail is not null)
{
    <div class="cu-modal-backdrop" @onclick="CloseDetail"
         role="dialog" aria-modal="true" aria-label="دفتر العهدة">
        <div class="cu-modal cu-modal-xl" @onclick:stopPropagation="true">

            @* ── STICKY HEADER ── *@
            <div class="cu-modal-head cu-detail-header">

                <div class="cu-modal-icon @DetailIconClass(_detail.Custody.Status)"
                     aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                    </svg>
                </div>

                <div class="detail-head-info" style="flex:1; min-width:0">

                    <div class="cu-modal-title" style="display:flex; align-items:center; gap:8px; flex-wrap:wrap">
                        <span>دفتر العهدة</span>
                        <span class="cu-detail-code-chip">@_detail.Custody.CustodyNumber</span>
                        <span class="cu-chip @StatusChipClass(_detail.Custody.Status)">
                            <span class="cu-chip-dot @StatusDotClass(_detail.Custody.Status)"
                                  aria-hidden="true"></span>
                            @StatusAr(_detail.Custody.Status)
                        </span>
                    </div>

                    <div class="detail-head-meta">
                        <span class="detail-meta-tag">
                            <svg viewBox="0 0 16 16" width="11" height="11"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <path d="M13 14v-1a3 3 0 00-3-3H6a3 3 0 00-3 3v1"/>
                                <circle cx="8" cy="5" r="3"/>
                            </svg>
                            @_detail.Custody.OwnerName
                        </span>
                        <span class="detail-meta-tag">
                            <svg viewBox="0 0 16 16" width="11" height="11"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <rect x="1" y="2" width="10" height="8" rx="1"/>
                                <path d="M11 5h3l2 2v3h-5V5z"/>
                                <circle cx="3.5" cy="12" r="1.5"/>
                                <circle cx="12.5" cy="12" r="1.5"/>
                            </svg>
                            رحلة @_detail.Custody.TripNumber
                        </span>
                        <span class="detail-meta-tag">
                            <svg viewBox="0 0 16 16" width="11" height="11"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <rect x="2" y="3" width="12" height="11" rx="2"/>
                                <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                            </svg>
                            @_detail.Custody.CustodyDate.ToString("yyyy-MM-dd")
                        </span>
                    </div>

                </div>

                <button class="cu-modal-close" @onclick="CloseDetail" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>

            </div>


            @* ── SCROLLABLE BODY ── *@
            <div class="cu-detail-body">

                @* ── Summary Cards ── *@
                <div class="cu-detail-summary">

                    <div class="cu-detail-card">
                        <div class="detail-card-ring ring-issued" aria-hidden="true">💰</div>
                        <div class="detail-card-data">
                            <div class="detail-card-label">إجمالي المصروف</div>
                            <div class="detail-card-val issued">
                                @Money(_detail.Custody.AmountIssued)
                                @if (_detail.Custody.AdditionalDue > 0)
                                {
                                    <span class="detail-extra">+@Money(_detail.Custody.AdditionalDue)</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="cu-detail-card">
                        <div class="detail-card-ring ring-spent" aria-hidden="true">📤</div>
                        <div class="detail-card-data">
                            <div class="detail-card-label">المنصرف منها</div>
                            <div class="detail-card-val spent">@Money(_detail.Custody.AmountSpent)</div>
                        </div>
                    </div>

                    <div class="cu-detail-card">
                        <div class="detail-card-ring ring-returned" aria-hidden="true">📥</div>
                        <div class="detail-card-data">
                            <div class="detail-card-label">المرتد منها</div>
                            <div class="detail-card-val returned">@Money(_detail.Custody.AmountReturned)</div>
                        </div>
                    </div>

                    <div class="cu-detail-card @(_detail.Custody.Remaining > 0 ? "card-remaining" : "card-settled")">
                        <div class="detail-card-ring @(_detail.Custody.Remaining > 0 ? "ring-remaining" : "ring-settled")"
                             aria-hidden="true">
                            @(_detail.Custody.Remaining > 0 ? "⏳" : "✅")
                        </div>
                        <div class="detail-card-data">
                            <div class="detail-card-label">الباقي</div>
                            <div class="detail-card-val @(_detail.Custody.Remaining > 0 ? "remaining" : "zero")">
                                @Money(_detail.Custody.Remaining)
                            </div>
                        </div>
                    </div>

                </div>


                @* ── Progress Bar عريض ── *@
                @{
                    var total = _detail.Custody.AmountIssued + _detail.Custody.AdditionalDue;
                    var spentW = total > 0 ? (double)(_detail.Custody.AmountSpent / total * 100) : 0;
                    var retW = total > 0 ? (double)(_detail.Custody.AmountReturned / total * 100) : 0;
                    var remW = total > 0 ? (double)(_detail.Custody.Remaining / total * 100) : 0;
                }
                <div class="cu-detail-progress-section">
                    <div class="cu-detail-progress-bar">
                        <div class="dp-spent" style="width:@Math.Min(spentW, 100)%"
                             title="المنصرف @spentW.ToString("0")%"></div>
                        <div class="dp-returned" style="width:@Math.Min(retW, 100)%"
                             title="المرتد @retW.ToString("0")%"></div>
                    </div>
                    <div class="cu-detail-progress-legend">
                        <span class="dp-leg">
                            <i class="dp-leg-dot dp-leg-spent"></i>
                            المنصرف @spentW.ToString("0")%
                        </span>
                        <span class="dp-leg">
                            <i class="dp-leg-dot dp-leg-returned"></i>
                            المرتد @retW.ToString("0")%
                        </span>
                        <span class="dp-leg">
                            <i class="dp-leg-dot dp-leg-remaining"></i>
                            الباقي @remW.ToString("0")%
                        </span>
                    </div>
                </div>


                @* ── Timeline الحركات ── *@
                <div class="cu-detail-section">
                    <div class="cu-detail-section-head">
                        <div class="cu-detail-section-title">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                                <path d="M12 6v6l4 2" stroke-linecap="round"/>
                            </svg>
                            حركات العهدة
                        </div>
                        <span class="cu-detail-count">@_detail.Transactions.Count</span>
                    </div>

                    @if (!_detail.Transactions.Any())
                    {
                        <div class="cu-detail-empty">مافيش حركات لسه</div>
                    }
                    else
                    {
                        <div class="cu-timeline">
                            @foreach (var (t, tIdx) in _detail.Transactions.Select((x, i) => (x, i)))
                            {
                                var isLast = tIdx == _detail.Transactions.Count - 1;

                                <div class="cu-tl-item @(isLast ? "tl-last" : "")">

                                    <div class="cu-tl-marker">
                                        <div class="cu-tl-dot @TxDotClass(t.TransactionType)"
                                             aria-hidden="true">
                                            @if (t.TransactionType == "Issue")
                                            {
                                                <svg viewBox="0 0 16 16" width="9" height="9"
                                                     fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <path d="M8 4v8M4 8h8" stroke-linecap="round"/>
                                                </svg>
                                            }
                                            else if (t.TransactionType == "Refund")
                                            {
                                                <svg viewBox="0 0 16 16" width="9" height="9"
                                                     fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <path d="M4 8h8" stroke-linecap="round"/>
                                                </svg>
                                            }
                                            else if (t.TransactionType == "Expense")
                                            {
                                                <svg viewBox="0 0 16 16" width="9" height="9"
                                                     fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <path d="M5 5l6 6M11 5l-6 6" stroke-linecap="round"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 16 16" width="9" height="9"
                                                     fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <path d="M3 8l4 4 6-7" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            }
                                        </div>
                                        @if (!isLast)
                                        {
                                            <div class="cu-tl-line" aria-hidden="true"></div>
                                        }
                                    </div>

                                    <div class="cu-tl-content">
                                        <div class="cu-tl-head">
                                            <span class="cu-tl-chip @TxChipClass(t.TransactionType)">
                                                @TxAr(t.TransactionType)
                                            </span>
                                            <span class="cu-tl-amount @TxAmountClass(t.TransactionType)">
                                                @(t.TransactionType is "Refund" ? "-" : "+")@Money(t.Amount)
                                                <small>ج.م</small>
                                            </span>
                                        </div>
                                        <div class="cu-tl-date-row">
                                            <svg viewBox="0 0 16 16" width="10" height="10"
                                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                                 aria-hidden="true">
                                                <circle cx="8" cy="8" r="6"/>
                                                <path d="M8 5v3l2 2" stroke-linecap="round"/>
                                            </svg>
                                            @t.TransactionDate.ToString("yyyy-MM-dd HH:mm")
                                        </div>
                                        @if (t.Notes is not null || t.ExpenseNumber is not null)
                                        {
                                            <div class="cu-tl-note">
                                                @if (t.Notes is not null)
                                                {
                                                    <span>@t.Notes</span>
                                                }
                                                @if (t.ExpenseNumber is not null)
                                                {
                                                    <span class="tl-expense-tag">مصروف @t.ExpenseNumber</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                </div>
                            }
                        </div>
                    }
                </div>


                @* ── المصروفات المرتبطة ── *@
                <div class="cu-detail-section">
                    <div class="cu-detail-section-head">
                        <div class="cu-detail-section-title">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 aria-hidden="true">
                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                            </svg>
                            المصروفات المرتبطة
                        </div>
                        <span class="cu-detail-count">@_detail.Expenses.Count</span>
                    </div>

                    @if (!_detail.Expenses.Any())
                    {
                        <div class="cu-detail-empty">مافيش مصروفات مربوطة بالعهدة دي</div>
                    }
                    else
                    {
                        <div class="cu-expenses-list">
                            @foreach (var e in _detail.Expenses)
                            {
                                <div class="cu-expense-row">
                                    <div class="cu-exp-code">@e.ExpenseNumber</div>
                                    <div class="cu-exp-info">
                                        <div class="cu-exp-type">@e.TypeName</div>
                                        @if (!string.IsNullOrWhiteSpace(e.Description))
                                        {
                                            <div class="cu-exp-desc">@e.Description</div>
                                        }
                                    </div>
                                    <div class="cu-exp-amount">
                                        <span>@Money(e.Amount)</span>
                                        <small>ج.م</small>
                                    </div>
                                    <div class="cu-exp-pay">
                                        <span class="@PayTagClass(e.PaymentStatus)">
                                            @PayAr(e.PaymentStatus)
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>


                @* ── الملاحظات ── *@
                @if (_detail.Custody.Notes is not null)
                {
                    <div class="cu-detail-section">
                        <div class="cu-detail-section-head">
                            <div class="cu-detail-section-title">
                                <svg viewBox="0 0 24 24" width="16" height="16"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                                ملاحظات
                            </div>
                        </div>
                        <div class="cu-detail-notes">@_detail.Custody.Notes</div>
                    </div>
                }

            </div>


            @* ── STICKY FOOTER ── *@
            <div class="cu-modal-foot">
                @if (_detail.Custody.Status is "Open" or "PartiallySettled" && CanCreate)
                {
                    <button class="cu-modal-action-btn"
                            @onclick="() => GoExpense(_detail.Custody.ToItem())">
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                        مصروف على العهدة
                    </button>
                }
                <button class="cu-modal-cancel" @onclick="CloseDetail">إغلاق</button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   CSS
═══════════════════════════════════════════ *@
<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-teal:      #0d9488;
        --fc-teal-lt:   #e6faf8;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       BODY
    ================================================================ */
    .cu-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1350px; width: 100%;
        margin: 0 auto;
    }

    /* ================================================================
       STATES
    ================================================================ */
    .cu-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .cu-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .cu-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .cu-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .cu-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* ================================================================
       CARD
    ================================================================ */
    .cu-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    /* ================================================================
       TOOLBAR
    ================================================================ */
    .cu-toolbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7; flex-wrap: wrap;
    }

    .cu-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px; max-width: 380px;
    }

    .cu-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }

    .cu-search-input {
        width: 100%; height: 38px; padding: 0 36px 0 12px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .cu-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .cu-search-input::placeholder { color: #b0bcc8; }

    .cu-search-clear {
        position: absolute; left: 10px;
        display: flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        border: none; background: #edf1f7; color: #8899ae; cursor: pointer;
    }
    .cu-search-clear:hover { background: #dde5f0; }

    .cu-results-badge {
        display: flex; align-items: center; gap: 5px;
        margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap;
    }
    .cu-results-badge strong { color: #5a6e88; }

    /* ================================================================
       STATUS BAR + WORKFLOW
    ================================================================ */
    .cu-status-bar {
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 18px; background: #f9fafd;
        border-bottom: 1px solid #edf1f7; overflow-x: auto; gap: 14px;
    }

    .cu-status-tabs { display: flex; gap: 4px; padding: 3px; border-radius: 10px; background: #f0f3f8; }

    .cu-status-tab {
        display: flex; align-items: center; gap: 5px;
        height: 32px; padding: 0 10px;
        border: none; border-radius: 7px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 10.5px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .cu-status-tab:hover:not(.active) { color: var(--fc-text); background: rgba(255,255,255,.6); }
    .cu-status-tab.active {
        background: var(--fc-card); color: var(--fc-text);
        box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800;
    }

    .cu-tab-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 7px; }

    .cu-tab-count {
        min-width: 16px; height: 16px; border-radius: 4px; padding: 0 3px;
        display: flex; align-items: center; justify-content: center;
        font-size: 9px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
    }
    .cu-status-tab.active .cu-tab-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .cu-status-tab:not(.active) .cu-tab-count { background: #e4eaf3; color: #8899ae; }

    /* Dots */
    .tdot-all            { background: var(--fc-blue); }
    .tdot-open           { background: var(--fc-blue); }
    .tdot-partial        { background: var(--fc-amber); }
    .tdot-submitted      { background: var(--fc-purple); }
    .tdot-approved       { background: var(--fc-teal); }
    .tdot-closed         { background: var(--fc-green); }

    /* Workflow */
    .cu-workflow {
        display: flex; align-items: center; gap: 5px; flex-shrink: 0; flex-wrap: wrap;
    }

    .cu-wf-step {
        padding: 2px 9px; border-radius: 6px;
        font-size: 10px; font-weight: 800;
    }

    .wf-blue   { background: var(--fc-blue-lt);   color: var(--fc-blue); }
    .wf-amber  { background: var(--fc-amber-lt);  color: #9a6d08; }
    .wf-purple { background: var(--fc-purple-lt); color: var(--fc-purple); }
    .wf-green  { background: var(--fc-green-lt);  color: var(--fc-green); }

    .cu-wf-arrow { color: #c0ccd8; font-size: 12px; font-weight: 700; }

    /* ================================================================
       LOADING / EMPTY
    ================================================================ */
    .cu-loading {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 200px;
        color: var(--fc-muted); font-size: 12px; font-weight: 600;
    }

    .cu-spinner {
        width: 32px; height: 32px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: cu-spin .75s linear infinite;
    }
    @@keyframes cu-spin { to { transform: rotate(360deg); } }

    .cu-empty {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 10px; min-height: 240px; padding: 40px; text-align: center;
    }
    .cu-empty-icon {
        width: 72px; height: 72px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #f0f4fa; color: #b0c4d8;
    }
    .cu-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .cu-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    .cu-add-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; margin-top: 6px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; transition: all .15s ease;
    }
    .cu-add-btn:hover { background: var(--fc-blue); color: #fff; }

    /* ================================================================
       TABLE
    ================================================================ */
    .cu-table-wrap { overflow-x: auto; }

    .cu-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }

    .cu-table thead th {
        padding: 10px 12px;
        background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 10.5px; font-weight: 800;
        text-align: center; border-bottom: 2px solid #e4eaf3;
        white-space: nowrap; position: sticky; top: 0; z-index: 1;
    }
    .cu-table .th-start { text-align: right; }

    .cu-table tbody tr {
        border-bottom: 1px solid #f0f3f8; transition: background .12s ease;
    }
    .cu-table tbody tr:last-child { border-bottom: none; }
    .cu-table tbody tr:hover { background: #fafcff; }
    .cu-table tbody tr.row-closed { opacity: .65; background: #f9fafb; }

    .cu-table tbody td {
        padding: 11px 12px; color: #526070; text-align: center; vertical-align: middle;
    }
    .td-start { text-align: right !important; }

    /* ── Custody Cell ── */
    .cu-custody-cell { display: flex; align-items: center; gap: 10px; }

    .cu-avatar {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        color: #fff; box-shadow: 0 2px 6px rgba(0,0,0,.10);
    }

    .av-open        { background: linear-gradient(135deg, #1558d6, #1e6ef5); }
    .av-partial     { background: linear-gradient(135deg, #b87d08, #e09a10); }
    .av-submitted   { background: linear-gradient(135deg, #6035a0, #7c4dbd); }
    .av-approved    { background: linear-gradient(135deg, #0a7a6e, #0d9488); }
    .av-closed      { background: linear-gradient(135deg, #0d8a48, #16a35b); }

    .cu-custody-info { min-width: 0; }

    .cu-code-btn {
        background: none; border: none; padding: 2px 8px;
        border-radius: 6px; cursor: pointer;
        background: #f0f4fa; border: 1px solid #e0e8f4;
        font-size: 10.5px; font-weight: 800; color: var(--fc-blue);
        font-family: "Inter", Arial, sans-serif;
        transition: all .12s ease;
    }
    .cu-code-btn:hover { background: var(--fc-blue); color: #fff; border-color: var(--fc-blue); }

    .cu-owner-name {
        display: flex; align-items: center; gap: 4px;
        font-size: 12px; font-weight: 700; color: #344563; margin-top: 4px;
    }

    .cu-custody-meta { display: flex; align-items: center; gap: 5px; margin-top: 3px; flex-wrap: wrap; }

    .cu-owner-type-tag {
        display: inline-flex; padding: 1px 6px; border-radius: 4px;
        font-size: 9.5px; font-weight: 800;
    }
    .tag-driver   { background: var(--fc-blue-lt);  color: var(--fc-blue);  border: 1px solid #c0d4fb; }
    .tag-employee { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }

    .cu-date-tag {
        display: inline-flex; padding: 1px 6px; border-radius: 4px;
        background: #f0f3f8; color: #8899ae;
        font-size: 9.5px; font-weight: 600;
        font-family: "Inter", Arial, sans-serif;
    }

    /* ── Trip Cell ── */
    .cu-trip-cell { display: flex; flex-direction: column; align-items: center; gap: 4px; }

    .cu-trip-tag {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 3px 8px; border-radius: 6px;
        background: rgba(224,101,32,.08); border: 1px solid rgba(224,101,32,.15);
        color: #c0501a; font-size: 10px; font-weight: 800;
    }

    .cu-trip-driver { font-size: 10px; color: #9aaabb; }

    /* ── Amounts Cell ── */
    .cu-amounts-cell { display: flex; flex-direction: column; gap: 2px; align-items: center; }

    .cu-amount-row {
        display: flex; align-items: center; gap: 6px;
        font-size: 10.5px;
    }

    .cu-amt-label { color: #9aaabb; font-weight: 600; min-width: 32px; }

    .cu-amt-val {
        font-family: "Inter", Arial, sans-serif;
        font-size: 11px; font-weight: 700;
    }

    .cu-amt-val.issued   { color: var(--fc-text); font-size: 12px; font-weight: 900; }
    .cu-amt-val.extra    { color: var(--fc-purple); }
    .cu-amt-val.spent    { color: var(--fc-red); }
    .cu-amt-val.returned { color: var(--fc-green); }

    /* ── Progress ── */
    .cu-progress-cell {
        display: flex; flex-direction: column; gap: 4px; align-items: center;
        min-width: 80px;
    }

    .cu-progress-bar {
        width: 80px; height: 8px; border-radius: 5px;
        background: #e4eaf3; overflow: hidden; position: relative;
    }

    .cu-prog-spent {
        position: absolute; top: 0; right: 0;
        height: 100%; border-radius: 5px;
        background: linear-gradient(90deg, #f87171, #ef4444);
        transition: width .5s ease;
    }

    .cu-prog-returned {
        position: absolute; top: 0; right: 0;
        height: 100%; border-radius: 5px;
        background: linear-gradient(90deg, #34d399, #10b981);
        transition: width .5s ease;
        z-index: 1;
    }

    .cu-progress-labels {
        display: flex; justify-content: space-between; width: 80px;
    }

    .prog-spent-lbl    { font-size: 8.5px; color: var(--fc-red);   font-weight: 700; }
    .prog-returned-lbl { font-size: 8.5px; color: var(--fc-green); font-weight: 700; }

    /* ── Remaining Badge ── */
    .cu-remaining-badge {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 10px; border-radius: 8px;
        font-family: "Inter", Arial, sans-serif;
        font-size: 12px; font-weight: 900;
    }

    .rem-pos  { background: var(--fc-red-lt);   color: var(--fc-red);   border: 1px solid #ffc8cf; }
    .rem-zero { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }

    /* ── Chips ── */
    .cu-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 9px; border-radius: 7px;
        font-size: 10px; font-weight: 800; white-space: nowrap;
    }

    .cu-chip-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; }

    .chip-open      { background: var(--fc-blue-lt);   color: var(--fc-blue);   border: 1px solid #c0d4fb; }
    .chip-partial   { background: var(--fc-amber-lt);  color: #9a6d08;          border: 1px solid #f0d898; }
    .chip-submitted { background: var(--fc-purple-lt); color: var(--fc-purple); border: 1px solid #d0bfef; }
    .chip-approved  { background: var(--fc-teal-lt);   color: var(--fc-teal);   border: 1px solid #b0e0dc; }
    .chip-closed    { background: var(--fc-green-lt);  color: var(--fc-green);  border: 1px solid #b0e0c5; }

    .sdot-open      { background: var(--fc-blue); }
    .sdot-partial   { background: var(--fc-amber); }
    .sdot-submitted { background: var(--fc-purple); }
    .sdot-approved  { background: var(--fc-teal); }
    .sdot-closed    { background: var(--fc-green); }

    /* ── Actions ── */
    .cu-actions { display: flex; align-items: center; gap: 3px; justify-content: center; flex-wrap: wrap; }

    .cu-act-btn {
        width: 28px; height: 28px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; cursor: pointer;
        transition: all .15s ease; background: transparent;
    }

    .act-info    { color: var(--fc-blue); }
    .act-tx      { color: var(--fc-purple); }
    .act-expense { color: var(--fc-teal); }
    .act-settle  { color: var(--fc-amber); }
    .act-approve { color: var(--fc-green); }
    .act-close   { color: #6b7d95; }
    .act-delete  { color: var(--fc-red); }

    .act-info:hover    { background: var(--fc-blue-lt);   border-color: #c0d4fb; }
    .act-tx:hover      { background: var(--fc-purple-lt); border-color: #d0bfef; }
    .act-expense:hover { background: var(--fc-teal-lt);   border-color: #b0e0dc; }
    .act-settle:hover  { background: var(--fc-amber-lt);  border-color: #f0d898; }
    .act-approve:hover { background: var(--fc-green-lt);  border-color: #b0e0c5; }
    .act-close:hover   { background: #f0f3f8; border-color: #dde5f0; }
    .act-delete:hover  { background: var(--fc-red-lt);    border-color: #ffc8cf; }

    .cu-confirm-del {
        height: 26px; padding: 0 9px;
        border: none; border-radius: 6px;
        background: linear-gradient(135deg, #e03048, #c0182e);
        color: #fff; font-family: inherit;
        font-size: 9.5px; font-weight: 800; cursor: pointer;
        animation: cu-pulse-del 1s ease infinite;
    }
    @@keyframes cu-pulse-del {
        0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.35); }
        50%     { box-shadow: 0 0 0 5px rgba(224,48,72,0); }
    }

    /* ================================================================
       MODALS — Base
    ================================================================ */
    .cu-modal-backdrop {
        position: fixed; inset: 0; z-index: 1000;
        background: rgba(10,20,40,.60); backdrop-filter: blur(5px);
        display: flex; align-items: center; justify-content: center;
        padding: 20px; animation: cu-fade-in .2s ease;
    }
    @@keyframes cu-fade-in { from { opacity: 0; } to { opacity: 1; } }

    .cu-modal {
        width: 100%; max-width: 560px;
        background: var(--fc-card); border: 1px solid rgba(0,0,0,.08);
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(10,20,50,.18), 0 30px 80px rgba(10,20,50,.22);
        overflow: hidden;
        animation: cu-modal-in .28s cubic-bezier(.34,1.3,.64,1);
        max-height: 90vh; overflow-y: auto;
    }
    .cu-modal-sm { max-width: 460px; }
    .cu-modal-xl { max-width: 760px; }

    @@keyframes cu-modal-in {
        from { opacity: 0; transform: scale(.94) translateY(12px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    .cu-modal-head {
        display: flex; align-items: center; gap: 14px;
        padding: 20px 22px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
    }

    .cu-modal-icon {
        width: 48px; height: 48px; flex: 0 0 48px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
    }

    .issue-icon   { background: linear-gradient(135deg, #eaf1ff, #dde8ff); color: var(--fc-blue);  border: 1px solid #bdd4fc; }
    .tx-icon      { background: linear-gradient(135deg, #f3eeff, #e8dfff); color: var(--fc-purple); border: 1px solid #d0bfef; }
    .approve-icon { background: linear-gradient(135deg, #e9f8f0, #d4f0e0); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .detail-blue  { background: linear-gradient(135deg, #eaf1ff, #dde8ff); color: var(--fc-blue);  border: 1px solid #bdd4fc; }
    .detail-amber { background: linear-gradient(135deg, #fff8e6, #ffefc0); color: #9a6d08;         border: 1px solid #f0d898; }
    .detail-green { background: linear-gradient(135deg, #e9f8f0, #d4f0e0); color: var(--fc-green); border: 1px solid #b0e0c5; }

    .cu-modal-title { font-size: 15px; font-weight: 900; color: #1c2b43; }
    .cu-modal-sub   { font-size: 10.5px; color: var(--fc-muted); margin-top: 2px; }
    .danger-sub     { color: var(--fc-red) !important; }

    .cu-modal-close {
        margin-right: auto; width: 34px; height: 34px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid #e4eaf2; border-radius: 9px;
        background: none; color: #9aaabb; cursor: pointer;
        transition: all .15s ease;
    }
    .cu-modal-close:hover { background: #f0f4fa; color: var(--fc-text); border-color: #c0ccd8; }

    .cu-modal-banner {
        display: flex; align-items: center; justify-content: space-between;
        gap: 10px; padding: 10px 22px; font-size: 12px; font-weight: 600;
    }
    .cu-modal-banner button { background: none; border: none; cursor: pointer; opacity: .6; }
    .banner-success { background: #e9f8f0; color: #0e7a43; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); }

    .cu-modal-body { padding: 20px 22px; }

    .cu-modal-foot {
        display: flex; align-items: center; justify-content: flex-end; gap: 10px;
        padding: 16px 22px;
        background: linear-gradient(180deg, #fafbfd 0%, #f4f6fb 100%);
        border-top: 1px solid #edf1f7;
    }

    .cu-modal-cancel {
        height: 40px; padding: 0 18px;
        border: 1px solid var(--fc-border); border-radius: 10px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .cu-modal-cancel:hover { background: #f0f4fa; color: var(--fc-text); }

    .cu-modal-save {
        display: inline-flex; align-items: center; gap: 7px;
        height: 40px; padding: 0 20px;
        border: 0; border-radius: 10px;
        color: #fff; font-family: inherit;
        font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .cu-modal-save:hover:not(:disabled) { transform: translateY(-1px); }
    .cu-modal-save:disabled { opacity: .6; cursor: not-allowed; }

    .issue-save   { background: linear-gradient(135deg, #1e6ef5, #1558d6); box-shadow: 0 4px 14px rgba(30,110,245,.28); }
    .refund-save  { background: linear-gradient(135deg, #16a35b, #0d8a48); box-shadow: 0 4px 14px rgba(22,163,91,.28); }
    .add-save     { background: linear-gradient(135deg, #7c4dbd, #6035a0); box-shadow: 0 4px 14px rgba(124,77,189,.25); }
    .approve-save { background: linear-gradient(135deg, #16a35b, #0d8a48); box-shadow: 0 4px 14px rgba(22,163,91,.28); }

    .cu-modal-action-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 40px; padding: 0 16px;
        border: 1.5px solid var(--fc-blue); border-radius: 10px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .cu-modal-action-btn:hover { background: var(--fc-blue); color: #fff; }

    /* ================================================================
       MODAL — Form Fields
    ================================================================ */
    .cu-modal-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    }

    .cu-mfield { display: flex; flex-direction: column; gap: 6px; }
    .cu-mfield-full { grid-column: 1 / -1; }

    .cu-mlabel {
        font-size: 12px; font-weight: 800; color: #344258;
        display: flex; align-items: center; gap: 3px;
    }
    .cu-mrequired { color: var(--fc-red); font-size: 14px; }

    .cu-minput {
        height: 44px; width: 100%;
        border: 1.5px solid #d8e2f0; border-radius: 10px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 13px; padding: 0 12px;
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .cu-minput:focus {
        border-color: var(--fc-blue);
        box-shadow: 0 0 0 3px rgba(30,110,245,.10);
        background: #fff;
    }
    .cu-minput::placeholder { color: #b0bcc8; }

    .cu-mselect-wrap { position: relative; }
    .cu-mselect-icon {
        position: absolute; right: 13px; top: 50%; transform: translateY(-50%);
        color: #9aaabb; pointer-events: none; z-index: 1;
    }
    .cu-mselect { padding-right: 36px; cursor: pointer; -webkit-appearance: none; appearance: none; }

    .cu-mfield-group { position: relative; display: flex; align-items: center; }
    .cu-mprefix {
        position: absolute; right: 13px;
        display: flex; align-items: center;
        color: #9aaabb; pointer-events: none; z-index: 1;
        font-size: 11px; font-weight: 700;
    }
    .cu-minput.with-prefix { padding-right: 36px; }

    .cu-mhint { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--fc-muted); font-weight: 500; }
    .selected-trip { color: var(--fc-blue); background: var(--fc-blue-lt); padding: 4px 8px; border-radius: 6px; }

    /* Owner Toggle */
    .cu-owner-toggle { display: flex; gap: 8px; }

    .cu-owner-btn {
        flex: 1; display: flex; align-items: center; justify-content: center; gap: 7px;
        height: 48px; border: 2px solid #d8e2f0; border-radius: 10px;
        background: #fafcff; color: var(--fc-muted);
        font-family: inherit; font-size: 13px; font-weight: 700; cursor: pointer;
        transition: all .18s ease;
    }
    .cu-owner-btn:hover:not(.owner-active-driver):not(.owner-active-emp) {
        border-color: #b0c4e0; color: var(--fc-text);
    }

    .owner-active-driver {
        border-color: var(--fc-blue); background: var(--fc-blue-lt); color: var(--fc-blue);
        box-shadow: 0 0 0 3px rgba(30,110,245,.10);
    }

    .owner-active-emp {
        border-color: var(--fc-green); background: var(--fc-green-lt); color: var(--fc-green);
        box-shadow: 0 0 0 3px rgba(22,163,91,.10);
    }

    /* ================================================================
       MODAL TX — Summary Strip
    ================================================================ */
    .cu-tx-summary-strip {
        display: flex; align-items: stretch;
        background: linear-gradient(135deg, #f5f8ff, #eef4ff);
        border: 1px solid #c8d8fb;
        border-top: none; padding: 0 22px;
    }

    .cu-tx-sum-item {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 3px; padding: 12px 6px; text-align: center;
    }
    .cu-tx-sum-sep { width: 1px; background: #c8d8fb; align-self: stretch; }
    .cu-tx-sum-label { font-size: 9px; color: #8899ae; font-weight: 600; }
    .cu-tx-sum-val {
        font-family: "Inter", Arial, sans-serif;
        font-size: 15px; font-weight: 900; color: var(--fc-text);
    }
    .sum-issued   { color: var(--fc-text); }
    .sum-spent    { color: var(--fc-red); }
    .sum-returned { color: var(--fc-green); }
    .sum-remaining { color: var(--fc-red); }
    .sum-zero     { color: var(--fc-green); }

    /* TX Type Group */
    .cu-tx-type-group { display: flex; gap: 10px; margin-bottom: 18px; }

    .cu-tx-type-btn {
        flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px;
        height: 52px; border: 2px solid #d8e2f0; border-radius: 12px;
        background: #fafcff; color: var(--fc-muted);
        font-family: inherit; font-size: 13px; font-weight: 700; cursor: pointer;
        transition: all .18s ease;
    }
    .cu-tx-type-btn:hover:not(.tx-active-refund):not(.tx-active-add) {
        border-color: #b0c4e0; color: var(--fc-text);
    }

    .tx-active-refund {
        border-color: var(--fc-green); background: var(--fc-green-lt); color: var(--fc-green);
        box-shadow: 0 0 0 3px rgba(22,163,91,.10);
    }

    .tx-active-add {
        border-color: var(--fc-purple); background: var(--fc-purple-lt); color: var(--fc-purple);
        box-shadow: 0 0 0 3px rgba(124,77,189,.10);
    }

    /* ================================================================
       MODAL APPROVE — Summary Cards
    ================================================================ */
    .cu-approve-summary {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 10px; margin-bottom: 18px;
    }

    .cu-app-sum-card {
        display: flex; flex-direction: column; align-items: center;
        gap: 4px; padding: 14px 10px; border-radius: 12px;
        background: #f5f7fa; border: 1px solid #e4eaf3; text-align: center;
    }
    .cu-app-sum-card.card-warn { background: var(--fc-red-lt); border-color: #ffc8cf; }
    .cu-app-sum-card.card-ok   { background: var(--fc-green-lt); border-color: #b0e0c5; }

    .cu-app-sum-label { font-size: 9.5px; color: #8899ae; font-weight: 600; }
    .cu-app-sum-val {
        font-family: "Inter", Arial, sans-serif;
        font-size: 17px; font-weight: 900; color: var(--fc-text);
    }
    .cu-app-sum-val.spent     { color: var(--fc-red); }
    .cu-app-sum-val.returned  { color: var(--fc-green); }
    .cu-app-sum-val.remaining { color: var(--fc-red); }
    .cu-app-sum-card.card-ok .cu-app-sum-val { color: var(--fc-green); }
    .cu-app-sum-curr { font-size: 10px; color: #9aaabb; }

    /* Additional Warning */
    .cu-additional-warn {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 14px 16px; border-radius: 12px;
        background: var(--fc-amber-lt); border: 1px solid #f0d898;
        margin-bottom: 14px;
    }
    .cu-add-warn-icon { flex: 0 0 auto; color: #9a6d08; }
    .cu-additional-warn strong { display: block; font-size: 13px; font-weight: 800; color: #92400e; }
    .cu-additional-warn p { margin: 3px 0 0; font-size: 11.5px; color: #b45309; }

    .cu-additional-check {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 14px; border-radius: 10px;
        border: 1px solid #e8edf5; background: #fafcff;
        cursor: pointer; transition: all .15s ease;
    }
    .cu-additional-check input { display: none; }
    .cu-additional-check.check-active { border-color: #bdd4fc; background: var(--fc-blue-lt); }

    .cu-add-check-box {
        width: 20px; height: 20px; border-radius: 6px; flex: 0 0 20px;
        border: 2px solid #d8e2f0; background: #fff;
        display: flex; align-items: center; justify-content: center;
        transition: all .12s ease;
    }
    .check-active .cu-add-check-box { background: var(--fc-blue); border-color: var(--fc-blue); color: #fff; }

    .cu-add-check-text span { display: block; font-size: 12.5px; font-weight: 800; color: var(--fc-text); }
    .cu-add-check-text small { display: block; font-size: 10.5px; color: var(--fc-muted); margin-top: 2px; }

    /* ================================================================
       MODAL DETAIL — Body
    ================================================================ */
    .cu-detail-body { padding: 20px 22px; display: flex; flex-direction: column; gap: 22px; }

    .detail-head-info { display: flex; flex-direction: column; gap: 4px; }

    .detail-head-meta {
        display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
        font-size: 11px; color: var(--fc-muted); font-weight: 600;
    }
    .detail-meta-item { display: flex; align-items: center; gap: 4px; }
    .detail-meta-sep { opacity: .4; }

    /* Summary Cards */
    .cu-detail-summary {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
    }

    .cu-detail-card {
        display: flex; flex-direction: column; align-items: center;
        gap: 5px; padding: 16px 10px; border-radius: 14px;
        background: #f5f7fa; border: 1px solid #e4eaf3;
        text-align: center; transition: all .15s ease;
    }
    .cu-detail-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(15,41,82,.06); }
    .cu-detail-card.card-remaining { background: var(--fc-red-lt);   border-color: #ffc8cf; }
    .cu-detail-card.card-settled   { background: var(--fc-green-lt); border-color: #b0e0c5; }

    .detail-card-icon { font-size: 24px; }
    .detail-card-label { font-size: 9.5px; color: #8899ae; font-weight: 600; }
    .detail-card-val {
        font-family: "Inter", Arial, sans-serif;
        font-size: 20px; font-weight: 900; color: var(--fc-text);
        display: flex; align-items: baseline; gap: 5px;
    }
    .detail-card-val.issued   { color: var(--fc-text); }
    .detail-card-val.spent    { color: var(--fc-red); }
    .detail-card-val.returned { color: var(--fc-green); }
    .detail-card-val.remaining { color: var(--fc-red); }
    .detail-card-val.zero     { color: var(--fc-green); }

    .detail-extra { font-size: 13px; color: var(--fc-purple); font-weight: 700; }
    .detail-card-curr { font-size: 10px; color: #9aaabb; }

    /* Section */
    .cu-detail-section {
        display: flex; flex-direction: column; gap: 12px;
    }

    .cu-detail-section-head {
        display: flex; align-items: center; gap: 10px;
        padding-bottom: 10px; border-bottom: 1px solid #edf1f7;
    }

    .cu-detail-section-title {
        display: flex; align-items: center; gap: 7px;
        font-size: 13px; font-weight: 800; color: #1c2b43; flex: 1;
    }

    .cu-detail-count {
        min-width: 22px; height: 22px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 6px; padding: 0 5px;
        background: #f0f3f8; color: #6b7d95;
        font-size: 10px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
    }

    .cu-detail-empty {
        padding: 20px; text-align: center;
        color: #9aaabb; font-size: 12px; font-weight: 600;
        border: 1px dashed #e4eaf3; border-radius: 10px; background: #f9fafc;
    }

    /* Timeline */
    .cu-timeline { display: flex; flex-direction: column; gap: 0; }

    .cu-tl-item {
        display: grid;
        grid-template-columns: 14px 2px 1fr;
        gap: 0 12px;
        min-height: 52px;
    }

    .cu-tl-dot {
        width: 14px; height: 14px; border-radius: 50%; margin-top: 4px;
        border: 2px solid;
    }

    .cu-tl-line {
        background: #e4eaf3; width: 2px;
        margin: 18px auto 0; align-self: stretch;
    }

    .cu-tl-item:last-child .cu-tl-line { display: none; }

    .cu-tl-content { padding-bottom: 16px; }

    .cu-tl-head {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    }

    .cu-tl-chip {
        display: inline-flex; padding: 2px 8px; border-radius: 6px;
        font-size: 10px; font-weight: 800;
    }

    .cu-tl-amount {
        font-family: "Inter", Arial, sans-serif;
        font-size: 13px; font-weight: 900;
    }

