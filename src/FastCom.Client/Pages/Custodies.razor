    {
        "Open" => "مفتوحة", "PartiallySettled" => "تسوية جزئية", "Submitted" => "مقدّمة للتسوية",
        "Approved" => "معتمدة", "Closed" => "مقفولة", _ => s
    };

    private static string StatusChip(string s) => s switch
    {
        "Open" => "fc-chip-blue", "PartiallySettled" => "fc-chip-warn", "Submitted" => "fc-chip-purple",
        "Approved" => "fc-chip-gold", "Closed" => "fc-chip-ok", _ => "fc-chip-gray"
    };

    private static string TripStatusAr(string s) => s switch
    {
        "Planned" => "مخططة", "Assigned" => "متسندة", "InTransit" => "في الطريق",
        "Completed" => "مكتملة", "Cancelled" => "ملغية", _ => s
    };

    private static string TxAr(string t) => t switch
    {
        "Issue" => "صرف العهدة", "Expense" => "مصروف", "Refund" => "رد باقي",
        "Additional" => "إضافة مبلغ", _ => t
    };

    private static string TxChip(string t) => t switch
    {
        "Issue" => "fc-chip-blue", "Expense" => "fc-chip-warn", "Refund" => "fc-chip-ok",
        "Additional" => "fc-chip-purple", _ => "fc-chip-gray"
