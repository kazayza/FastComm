    private static string Money(decimal v) => v.ToString("N2");

    private static decimal ParseAmount(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n > 0 ? n : 0m;

    private static int ParseInt(object? v) =>
        int.TryParse(v?.ToString(), out var n) ? n : 0;

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        await LoadAsync();
        if (CanCreate) await LoadLookupsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        _trips     = await SafeGetT<TripOpt>("api/custodies/trips");
        _employees = await SafeGetT<Opt>("api/custodies/employees");
        _drivers   = await SafeGetT<Opt>("api/options/drivers");
        if (!_drivers.Any() && _trips.Any())
            _drivers = _trips.GroupBy(t => t.DriverId)
                .Select(g => new Opt { Id = g.Key, Label = g.First().DriverName })
                .ToList();
    }

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task Reload()   { await LoadAsync(); }
    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try   { _items = await Http.GetFromJsonAsync<List<Item>>("api/custodies?take=300") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    /* ── صرف عهدة ── */
    private void OpenIssue()
    {
        _nf = new NewForm { CustodyDate = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") };
        _msg = null; _issueOpen = true;
    }

    private void CloseIssue() { _issueOpen = false; _msg = null; }

    private void OnTripChanged(ChangeEventArgs e)
    {
        _nf.TripId = long.TryParse(e.Value?.ToString(), out var t) && t > 0 ? t : null;
        if (_nf.OwnerType == "Driver" && SelectedTrip is not null)
            _nf.OwnerId = SelectedTrip.DriverId;
    }

    private void OnOwnerTypeChanged_Click(string ownerType)
    {
        _nf.OwnerType = ownerType;
        _nf.OwnerId   = 0;
        if (ownerType == "Driver" && SelectedTrip is not null)
            _nf.OwnerId = SelectedTrip.DriverId;
    }

    private async Task SaveIssue()
    {
        if (_nf.IsPrimary && _nf.TripId is null) { _ok = false; _msg = "اختار الرحلة"; return; }
        if (_nf.OwnerId <= 0)   { _ok = false; _msg = "اختار صاحب العهدة"; return; }

        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/custodies", new
            {
                tripId          = _nf.TripId,
                ownerType       = _nf.OwnerType,
                ownerId         = _nf.OwnerId,
                amountIssued    = _nf.AmountIssued,
                custodyDate     = _nf.CustodyDate,
                notes           = _nf.Notes,
                isPrimary       = _nf.IsPrimary,
                parentCustodyId = _nf.ParentCustodyId
            });
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            { Snackbar.Add(_msg, Severity.Success); CloseIssue(); await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    /* ── حركة ── */
    private void OpenTx(Item c)
    {
        _txTarget = c;
        _tx = new TxForm { TxDate = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") };
        _msg = null; _txOpen = true;
    }

    private void CloseTx() { _txOpen = false; _txTarget = null; _msg = null; }

    private async Task SaveTx()
    {
        if (_txTarget is null) return;
        if (_tx.Amount <= 0) { _ok = false; _msg = "اكتب مبلغ صحيح"; return; }

        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/custodies/{_txTarget.CustodyId}/transactions", new
            {
                type      = _tx.Type,
                amount    = _tx.Amount,
                txDate    = _tx.TxDate,
                expenseId = (long?)null,
                notes     = _tx.Notes
            });
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            { Snackbar.Add(_msg, Severity.Success); CloseTx(); _detailOpen = false; await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    /* ── دفتر ── */
    private async Task Open(Item c)
    {
        try
        {
            _detail = await Http.GetFromJsonAsync<Envelope>($"api/custodies/{c.CustodyId}");
            if (_detail is null) return;
            _msg = null; _detailOpen = true;
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private void CloseDetail() { _detailOpen = false; }

    private void GoExpense(Item c)
    {
        _detailOpen = false; _issueOpen = false; _txOpen = false;
        Nav.NavigateTo($"/expenses?tripId={c.TripId}&custodyId={c.CustodyId}");
    }

    /* ── حالات ── */
    private async Task Post(string url, object? body)
    {
        try
        {
            var res = body is null
                ? await Http.PostAsync(url, null)
                : await Http.PostAsJsonAsync(url, body);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) { _detailOpen = false; _approveOpen = false; await LoadAsync(); }
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private Task Settle(Item c)       => Post($"api/custodies/{c.CustodyId}/settle",  null);
    private Task CloseCustody(Item c) => Post($"api/custodies/{c.CustodyId}/close",   null);

    private void OpenApprove(Item c)
    {
        _approveTarget = c; _addAdditional = false; _needAdditional = false;
        _msg = null; _approveOpen = true;
    }

    private void CloseApprove() { _approveOpen = false; _approveTarget = null; _msg = null; }

    private async Task ConfirmApprove()
    {
        if (_approveTarget is null) return;
        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync(
                $"api/custodies/{_approveTarget.CustodyId}/approve",
                new { addAdditional = _addAdditional });

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                _approveOpen = false; _approveTarget = null; _detailOpen = false;
                await LoadAsync();
            }
            else if (_msg.Contains("كمبلغ إضافي"))
            {
                _needAdditional = true;
            }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task Delete(Item c)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/custodies/{c.CustodyId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}