        transition: all .15s ease;
    }
    .type-save-btn:hover:not(:disabled) { transform: translateY(-1px); }
    .type-save-btn:disabled { opacity: .6; cursor: not-allowed; }

    /* ── Types Table ── */
    .exl-types-table-section { display: flex; flex-direction: column; gap: 12px; }

    .types-table-head {
        display: flex; align-items: center; gap: 10px;
