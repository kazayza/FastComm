@page "/expenses"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>المصروفات — فاست كوم</PageTitle>


@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">المالية · المصروفات</div>
                <h1 class="fc-hero-title">المصروفات</h1>
                <p class="fc-hero-sub">وقود ورسوم ميناء ونش وغرامات — المصروف المرتبط بعملية أو رحلة بيدخل في تكلفتها</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanManageTypes)
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.LocalOffer"
                               OnClick="OpenTypes"
                               Style="color:#9FB4CC">
                        أنواع المصروفات
                    </MudButton>
                }
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="GoNew">مصروف جديد</MudButton>
                }
            </div>
        </div>

        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">عدد المصروفات</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Savings" /></div>
                    <div><div class="fc-kpi-num">@Money(Active.Sum(e => e.Amount))</div><div class="fc-kpi-lb">إجمالي غير الملغي</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                    <div><div class="fc-kpi-num">@Money(ThisMonth)</div><div class="fc-kpi-lb">مصروفات الشهر</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div>
                        <div class="fc-kpi-num">@_items.Count(e => e.Status == "Posted" && !e.IsApproved)</div>
                        <div class="fc-kpi-lb">لم تُعتمد</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="ex-list-body">

    @if (!CanView)
    {
        <div class="exl-state-box">
            <div class="exl-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض المصروفات — تواصل مع المسؤول</p>
        </div>
    }
    else
    {
        <div class="exl-card">

            @* ── Toolbar ── *@
            <div class="exl-toolbar">

                <div class="exl-search-wrap">
                    <svg class="exl-search-icon" viewBox="0 0 24 24"
                         width="16" height="16" fill="none" stroke="currentColor"
                         stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="exl-search-input"
                           placeholder="ابحث بالرقم أو البيان أو المرجع..."
                           @bind="_search"
                           @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="exl-search-clear"
                                @onclick="() => _search = string.Empty"
                                aria-label="مسح">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                @* Type Filter *@
                <div class="exl-type-filter-wrap">
                    <svg viewBox="0 0 24 24" width="13" height="13"
                         fill="none" stroke="currentColor" stroke-width="2"
                         class="exl-type-icon" aria-hidden="true">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                        <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                    </svg>
                    <select class="exl-type-select" @bind="_typeFilter">
                        <option value="0">كل الأنواع</option>
                        @foreach (var t in _types)
                        {
                            <option value="@t.Id">@t.Label</option>
                        }
                    </select>
                </div>

                <div class="exl-results-badge">
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>

            </div>


            @* ── Status Tabs ── *@
            <div class="exl-status-bar">
                <div class="exl-status-tabs" role="group" aria-label="فلتر الحالة">
                    @foreach (var t in _statusTabs)
                    {
                        var count = t.Key == "all"
                            ? _items.Count
                            : _items.Count(x => x.Status == t.Key);

                        <button class="exl-status-tab @(_tab == t.Key ? "active" : "")"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="exl-tab-dot @StatusDotColor(t.Key)" aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="exl-tab-count">@count</span>
                        </button>
                    }
                </div>
            </div>


            @* ── Content ── *@
            @if (_loading)
            {
                <div class="exl-loading">
                    <div class="exl-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل المصروفات...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="exl-empty">
                    <div class="exl-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="40" height="40"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="exl-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) ? "لا توجد مصروفات في هذا الفلتر" : "لا توجد نتائج")
                    </div>
                    <div class="exl-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search)
                            ? "جرّب فلتر مختلف أو أنشئ مصروف جديد"
                            : "جرّب كلمة بحث مختلفة")
                    </div>
                    @if (CanCreate && string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="exl-add-btn" @onclick="GoNew">
                            <svg viewBox="0 0 24 24" width="16" height="16"
                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            مصروف جديد
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="exl-table-wrap">
                    <table class="exl-table" aria-label="قائمة المصروفات">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">المصروف</th>
                                <th scope="col">مربوط بـ</th>
                                <th scope="col">التاريخ</th>
                                <th scope="col">المبلغ</th>
                                <th scope="col">الدفع</th>
                                <th scope="col">الحالة</th>
                                <th scope="col" style="width:200px">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Filtered)
                            {
                                <tr class="@(e.Status == "Cancelled" ? "row-cancelled" : "")">

                                    @* ── المصروف: رقم + نوع + بيان ── *@
                                    <td class="td-start">
                                        <div class="exl-exp-cell">
                                            <div class="exl-exp-avatar @ExpAvatarClass(e.Status, e.IsApproved)"
                                                 aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="15" height="15"
                                                     fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                                </svg>
                                            </div>
                                            <div class="exl-exp-info">
                                                <div class="exl-exp-num">
                                                    <span class="exl-code-chip">@e.ExpenseNumber</span>
                                                    @if (e.IsApproved)
                                                    {
                                                        <span class="exl-approved-badge" title="معتمد">✓</span>
                                                    }
                                                </div>
                                                <div class="exl-type-name">@e.TypeName</div>
                                                @if (!string.IsNullOrWhiteSpace(e.Description))
                                                {
                                                    <div class="exl-desc">@e.Description</div>
                                                }
                                                @if (e.DriverName is not null)
                                                {
                                                    <div class="exl-driver">
                                                        <svg viewBox="0 0 16 16" width="10" height="10"
                                                             fill="none" stroke="currentColor" stroke-width="1.8"
                                                             aria-hidden="true">
                                                            <path d="M13 14v-1a3 3 0 00-3-3H6a3 3 0 00-3 3v1"/>
                                                            <circle cx="8" cy="5" r="3"/>
                                                        </svg>
                                                        @e.DriverName
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    @* ── مربوط بـ ── *@
                                    <td>
                                        <div class="exl-link-cell">
                                            @if (e.OperationNumber is not null)
                                            {
                                                <span class="exl-link-tag tag-op">
                                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                                         aria-hidden="true">
                                                        <path d="M14 11V5a1 1 0 00-.5-.87l-5-3a1 1 0 00-1 0l-5 3A1 1 0 002 5v6a1 1 0 00.5.87l5 3a1 1 0 001 0l5-3A1 1 0 0014 11z"/>
                                                    </svg>
                                                    @e.OperationNumber
                                                </span>
                                            }
                                            @if (e.TripNumber is not null)
                                            {
                                                <span class="exl-link-tag tag-trip">
                                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                                         aria-hidden="true">
                                                        <rect x="1" y="2" width="10" height="8" rx="1"/>
                                                        <path d="M11 5h3l2 2v3h-5V5z"/>
                                                        <circle cx="3.5" cy="12" r="1.5"/>
                                                        <circle cx="12.5" cy="12" r="1.5"/>
                                                    </svg>
                                                    @e.TripNumber
                                                </span>
                                            }
                                            @if (e.SupplierName is not null)
                                            {
                                                <span class="exl-link-tag tag-supplier">
                                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                                         aria-hidden="true">
                                                        <path d="M2 6l6-4 6 4v7a1 1 0 01-1 1H3a1 1 0 01-1-1V6z"/>
                                                        <path d="M6 14V8h4v6"/>
                                                    </svg>
                                                    @e.SupplierName
                                                </span>
                                            }
                                            @if (e.CustodyNumber is not null)
                                            {
                                                <span class="exl-link-tag tag-custody">
                                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                                         aria-hidden="true">
                                                        <rect x="2" y="5" width="12" height="9" rx="1"/>
                                                        <path d="M10 5V4a2 2 0 00-4 0v1"/>
                                                    </svg>
                                                    عهدة @e.CustodyNumber
                                                </span>
                                            }
                                            @if (e.OperationNumber is null && e.TripNumber is null &&
                                                 e.SupplierName is null && e.CustodyNumber is null)
                                            {
                                                <span class="td-muted">إداري</span>
                                            }
                                        </div>
                                    </td>

                                    @* ── التاريخ ── *@
                                    <td class="td-muted">
                                        <div class="exl-date-cell">
                                            <svg viewBox="0 0 16 16" width="11" height="11"
                                                 fill="none" stroke="currentColor" stroke-width="1.7"
                                                 aria-hidden="true">
                                                <rect x="2" y="3" width="12" height="11" rx="2"/>
                                                <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                                            </svg>
                                            @e.ExpenseDate.ToString("yyyy-MM-dd")
                                        </div>
                                    </td>

                                    @* ── المبلغ ── *@
                                    <td>
                                        <div class="exl-amount-cell">
                                            <span class="exl-amount-main">@Money(e.Amount)</span>
                                            <span class="exl-amount-curr">ج.م</span>
                                        </div>
                                        @if (e.TaxRate > 0)
                                        {
                                            <div class="exl-tax-sub">ضريبة @e.TaxRate.ToString("0.##")%</div>
                                        }
                                    </td>

                                    @* ── الدفع ── *@
                                    <td>
                                        <span class="exl-chip @PayChipClass(e.PaymentStatus)">
                                            <span class="exl-chip-dot @PayDotClass(e.PaymentStatus)"
                                                  aria-hidden="true"></span>
                                            @PayAr(e.PaymentStatus)
                                        </span>
                                    </td>

                                    @* ── الحالة ── *@
                                    <td>
                                        <div class="exl-status-cell">
                                            <span class="exl-chip @StatusChipClass(e.Status)">
                                                <span class="exl-chip-dot @StatusDotClass(e.Status)"
                                                      aria-hidden="true"></span>
                                                @StatusAr(e.Status)
                                            </span>
                                        </div>
                                    </td>

                                    @* ── إجراءات ── *@
                                    <td>
                                        <div class="exl-actions">

                                            @* تعديل *@
                                            @if (e.Status != "Cancelled" && CanEdit)
                                            {
                                                <button class="exl-act-btn act-edit"
                                                        @onclick="() => GoEdit(e)"
                                                        title="تعديل"
                                                        aria-label="تعديل @e.ExpenseNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* تأكيد *@
                                            @if (e.Status == "Draft" && CanEdit)
                                            {
                                                <button class="exl-act-btn act-confirm"
                                                        @onclick='() => SetStatus(e, "Posted")'
                                                        title="تأكيد"
                                                        aria-label="تأكيد @e.ExpenseNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                                        <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* اعتماد *@
                                            @if (e.Status == "Posted" && CanApprove && !e.IsApproved)
                                            {
                                                <button class="exl-act-btn act-approve"
                                                        @onclick="() => Approve(e)"
                                                        title="اعتماد"
                                                        aria-label="اعتماد @e.ExpenseNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M9 12l2 2 4-4"/>
                                                        <path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* علّم مدفوع *@
                                            @if (e.Status == "Posted" && e.PaymentStatus == "Unpaid" && CanEdit)
                                            {
                                                <button class="exl-act-btn act-pay"
                                                        @onclick="() => SetPaid(e)"
                                                        title="تعليم مدفوع"
                                                        aria-label="تعليم @e.ExpenseNumber مدفوع">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                                        <circle cx="12" cy="14" r="2"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* إلغاء *@
                                            @if (e.Status != "Cancelled" && CanEdit)
                                            {
                                                <button class="exl-act-btn act-cancel"
                                                        @onclick='() => SetStatus(e, "Cancelled")'
                                                        title="إلغاء"
                                                        aria-label="إلغاء @e.ExpenseNumber">
                                                    <svg viewBox="0 0 24 24" width="14" height="14"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10"/>
                                                        <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                                    </svg>
                                                </button>
                                            }

                                            @* حذف *@
                                            @if (CanDelete && e.PaymentStatus == "Unpaid")
                                            {
                                                @if (_confirmId == e.ExpenseId)
                                                {
                                                    <button class="exl-confirm-del"
                                                            @onclick="() => Delete(e)">
                                                        حذف؟
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="exl-act-btn act-delete"
                                                            @onclick="() => _confirmId = e.ExpenseId"
                                                            title="حذف"
                                                            aria-label="حذف @e.ExpenseNumber">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   MODAL — أنواع المصروفات
═══════════════════════════════════════════ *@
@if (_typesOpen && CanManageTypes)
{
    <div class="exl-modal-backdrop" @onclick="CloseTypes"
         role="dialog" aria-modal="true" aria-label="أنواع المصروفات">
        <div class="exl-modal" @onclick:stopPropagation="true">

            <div class="exl-modal-head">
                <div class="exl-modal-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                        <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <div class="exl-modal-title">أنواع المصروفات</div>
                    <div class="exl-modal-sub">التصنيف بيحدد هل المصروف تشغيلي ولا إداري</div>
                </div>
                <button class="exl-modal-close" @onclick="CloseTypes" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_typesMsg is not null)
            {
                <div class="exl-modal-banner @(_typesOk ? "banner-success" : "banner-error")" role="alert">
                    <span>@_typesMsg</span>
                    <button @onclick="() => _typesMsg = null">✕</button>
                </div>
            }

            <div class="exl-modal-body">

                @* ── فورم الإضافة/التعديل ── *@
                <div class="exl-type-form-card">

                    <div class="type-form-head">
                        <div class="type-form-icon" aria-hidden="true">
                            @if (_typeEditId is null)
                            {
                                <svg viewBox="0 0 24 24" width="16" height="16"
                                     fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="16" height="16"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            }
                        </div>
                        <div>
                            <div class="type-form-title">
                                @(_typeEditId is null ? "نوع جديد" : $"تعديل: {_tf.NameAr}")
                            </div>
                            <div class="type-form-sub">الكود بالحروف الإنجليزية — زي FUEL أو RENT</div>
                        </div>
                    </div>

                    <div class="exl-type-form-grid">

                        <div class="exl-type-field">
                            <label class="exl-type-label">
                                الكود
                                <span class="field-req">*</span>
                            </label>
                            <input class="exl-type-input"
                                   @bind="_tf.Code"
                                   maxlength="30"
                                   placeholder="FUEL"
                                   dir="ltr"
                                   disabled="@(_typeEditId is not null && _tf.ExpenseCount > 0)" />
                        </div>

                        <div class="exl-type-field">
                            <label class="exl-type-label">
                                الاسم بالعربي
                                <span class="field-req">*</span>
                            </label>
                            <input class="exl-type-input"
                                   @bind="_tf.NameAr"
                                   maxlength="150"
                                   placeholder="وقود" />
                        </div>

                        <div class="exl-type-field">
                            <label class="exl-type-label">الاسم بالإنجليزي</label>
                            <input class="exl-type-input"
                                   @bind="_tf.NameEn"
                                   maxlength="150"
                                   placeholder="Fuel"
                                   dir="ltr" />
                        </div>

                        <div class="exl-type-field">
                            <label class="exl-type-label">التصنيف</label>
                            <div class="exl-type-select-wrap">
                                <svg class="exl-type-sel-icon" viewBox="0 0 24 24"
                                     width="13" height="13" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                    <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/>
                                </svg>
                                <select class="exl-type-input exl-type-sel"
                                        @bind="_tf.IsOperationCost"
                                        disabled="@(_typeEditId is not null && _tf.ExpenseCount > 0)">
                                    <option value="true">تشغيلي — بيتحمل على عملية</option>
                                    <option value="false">إداري — بيتحمل على الشركة</option>
                                </select>
                            </div>
                            @if (_typeEditId is not null && _tf.ExpenseCount > 0)
                            {
                                <div class="exl-type-hint">
                                    <svg viewBox="0 0 16 16" width="10" height="10"
                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                         aria-hidden="true">
                                        <rect x="3" y="11" width="10" height="6" rx="1"/>
                                        <path d="M5 11V7a3 3 0 016 0v4"/>
                                    </svg>
                                    مقفول — عليه @_tf.ExpenseCount مصروف
                                </div>
                            }
                        </div>

                    </div>

                    @* Checkboxes *@
                    <div class="exl-type-checks">
                        <label class="exl-type-check @(_tf.IsCustodyAllowed ? "check-on" : "")">
                            <input type="checkbox" @bind="_tf.IsCustodyAllowed" />
                            <div class="check-indicator" aria-hidden="true"></div>
                            <span>يُنصرف من العهدة</span>
                        </label>
                        <label class="exl-type-check @(_tf.IsTaxDeductible ? "check-on" : "")">
                            <input type="checkbox" @bind="_tf.IsTaxDeductible" />
                            <div class="check-indicator" aria-hidden="true"></div>
                            <span>الضريبة قابلة للخصم</span>
                        </label>
                        <label class="exl-type-check @(_tf.IsActive ? "check-on" : "check-inactive")">
                            <input type="checkbox" @bind="_tf.IsActive" />
                            <div class="check-indicator" aria-hidden="true"></div>
                            <span>نشط</span>
                        </label>
                    </div>

                    <div class="type-form-actions">
                        @if (_typeEditId is not null)
                        {
                            <button class="type-cancel-btn" @onclick="ResetTypeForm">إلغاء التعديل</button>
                        }
                        <button class="type-save-btn"
                                @onclick="SaveType"
                                disabled="@_typesSaving">
                            @if (_typesSaving)
                            {
                                <span class="btn-spinner sm" aria-hidden="true"></span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     aria-hidden="true">
                                    <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                    <path d="M17 21v-8H7v8M7 3v5h8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            }
                            حفظ
                        </button>
                    </div>

                </div>


                @* ── جدول الأنواع ── *@
                <div class="exl-types-table-section">

                    <div class="types-table-head">
                        <span>الأنواع الموجودة</span>
                        <span class="types-count-badge">@_typesList.Count</span>
                    </div>

                    <div class="exl-types-table-wrap">
                        <table class="exl-types-table" aria-label="جدول أنواع المصروفات">
                            <thead>
                                <tr>
                                    <th scope="col">الكود</th>
                                    <th scope="col" class="th-start">الاسم</th>
                                    <th scope="col">التصنيف</th>
                                    <th scope="col">مصروفات</th>
                                    <th scope="col" style="width:80px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!_typesList.Any())
                                {
                                    <tr>
                                        <td colspan="5">
                                            <div class="exl-types-empty">مافيش أنواع — ضيف أول نوع</div>
                                        </td>
                                    </tr>
                                }
                                @foreach (var t in _typesList)
                                {
                                    <tr class="@(!t.IsActive ? "type-row-inactive" : "")">
                                        <td>
                                            <span class="exl-code-chip" dir="ltr">@t.Code</span>
                                        </td>
                                        <td class="td-start">
                                            <div class="type-name-cell">
                                                <span>@t.NameAr</span>
                                                @if (!t.IsActive)
                                                {
                                                    <span class="type-inactive-tag">معطّل</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="type-class-chip @(t.IsOperationCost ? "chip-op" : "chip-admin")">
                                                @(t.IsOperationCost ? "تشغيلي" : "إداري")
                                            </span>
                                        </td>
                                        <td class="td-num">@t.ExpenseCount</td>
                                        <td>
                                            <div class="type-actions">
                                                <button class="exl-act-btn act-edit"
                                                        @onclick="() => EditType(t)"
                                                        title="تعديل">
                                                    <svg viewBox="0 0 24 24" width="13" height="13"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                                @if (t.ExpenseCount == 0)
                                                {
                                                    <button class="exl-act-btn act-delete"
                                                            @onclick="() => DeleteType(t)"
                                                            title="حذف">
                                                        <svg viewBox="0 0 24 24" width="13" height="13"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>

            </div>

            <div class="exl-modal-foot">
                <button class="exl-modal-close-btn" @onclick="CloseTypes">إغلاق</button>
            </div>

        </div>
    </div>
}


@* ═══════════════════════════════════════════
   CSS
═══════════════════════════════════════════ *@
<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-teal:      #0d9488;
        --fc-teal-lt:   #e6faf8;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       BODY
    ================================================================ */
    .ex-list-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1400px; width: 100%;
        margin: 0 auto;
    }

    /* ================================================================
       STATES
    ================================================================ */
    .exl-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }

    .exl-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .exl-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .exl-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .exl-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* ================================================================
       CARD
    ================================================================ */
    .exl-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    /* ================================================================
       TOOLBAR
    ================================================================ */
    .exl-toolbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7; flex-wrap: wrap;
    }

    .exl-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px; max-width: 380px;
    }

    .exl-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }

    .exl-search-input {
        width: 100%; height: 38px; padding: 0 36px 0 12px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .exl-search-input:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .exl-search-input::placeholder { color: #b0bcc8; }

    .exl-search-clear {
        position: absolute; left: 10px;
        display: flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        border: none; background: #edf1f7; color: #8899ae; cursor: pointer;
        transition: all .12s ease;
    }
    .exl-search-clear:hover { background: #dde5f0; color: var(--fc-text); }

    .exl-type-filter-wrap {
        position: relative; display: flex; align-items: center;
        min-width: 160px; max-width: 200px;
    }
    .exl-type-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; z-index: 1; }
    .exl-type-select {
        width: 100%; height: 38px; padding: 0 34px 0 10px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none; cursor: pointer;
        -webkit-appearance: none; appearance: none;
        transition: border-color .15s ease;
    }
    .exl-type-select:focus { border-color: var(--fc-blue); }

    .exl-results-badge {
        display: flex; align-items: center; gap: 5px;
        margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap;
    }
    .exl-results-badge strong { color: #5a6e88; }

    /* ================================================================
       STATUS TABS
    ================================================================ */
    .exl-status-bar {
        padding: 10px 18px; background: #f9fafd; border-bottom: 1px solid #edf1f7; overflow-x: auto;
    }

    .exl-status-tabs { display: flex; gap: 4px; padding: 3px; border-radius: 10px; background: #f0f3f8; width: fit-content; }

    .exl-status-tab {
        display: flex; align-items: center; gap: 5px;
        height: 32px; padding: 0 10px;
        border: none; border-radius: 7px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 10.5px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .exl-status-tab:hover:not(.active) { color: var(--fc-text); background: rgba(255,255,255,.6); }
    .exl-status-tab.active {
        background: var(--fc-card); color: var(--fc-text);
        box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800;
    }

    .exl-tab-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 7px; }

    .exl-tab-count {
        min-width: 16px; height: 16px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 4px; padding: 0 3px;
        font-size: 9px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
    }
    .exl-status-tab.active .exl-tab-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .exl-status-tab:not(.active) .exl-tab-count { background: #e4eaf3; color: #8899ae; }

    .tdot-all       { background: var(--fc-blue); }
    .tdot-draft     { background: #9aaabb; }
    .tdot-posted    { background: var(--fc-green); }
    .tdot-cancelled { background: var(--fc-red); }

    /* ================================================================
       LOADING / EMPTY
    ================================================================ */
    .exl-loading {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 200px;
        color: var(--fc-muted); font-size: 12px; font-weight: 600;
    }

    .exl-spinner {
        width: 32px; height: 32px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: exl-spin .75s linear infinite;
    }
    @@keyframes exl-spin { to { transform: rotate(360deg); } }

    .exl-empty {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 10px; min-height: 240px; padding: 40px 20px; text-align: center;
    }
    .exl-empty-icon {
        width: 72px; height: 72px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #f0f4fa; color: #b0c4d8;
    }
    .exl-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .exl-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    .exl-add-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; margin-top: 6px;
        border: 1.5px solid var(--fc-blue); border-radius: 9px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; transition: all .15s ease;
    }
    .exl-add-btn:hover { background: var(--fc-blue); color: #fff; }

    /* ================================================================
       TABLE
    ================================================================ */
    .exl-table-wrap { overflow-x: auto; }

    .exl-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }

    .exl-table thead th {
        padding: 10px 12px;
        background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 10.5px; font-weight: 800;
        text-align: center; border-bottom: 2px solid #e4eaf3;
        white-space: nowrap; position: sticky; top: 0; z-index: 1;
    }
    .exl-table .th-start { text-align: right; }

    .exl-table tbody tr {
        border-bottom: 1px solid #f0f3f8; transition: background .12s ease;
    }
    .exl-table tbody tr:last-child { border-bottom: none; }
    .exl-table tbody tr:hover { background: #fafcff; }
    .exl-table tbody tr.row-cancelled { opacity: .55; }

    .exl-table tbody td {
        padding: 11px 12px; color: #526070; text-align: center; vertical-align: middle;
    }
    .td-start { text-align: right !important; }
    .td-muted { color: #8899ae; font-size: 11px; }
    .td-num   { font-family: "Inter", Arial, sans-serif; font-size: 12px; font-weight: 600; }

    /* ── Expense Cell ── */
    .exl-exp-cell { display: flex; align-items: flex-start; gap: 10px; }

    .exl-exp-avatar {
        width: 34px; height: 34px; flex: 0 0 34px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        color: #fff; box-shadow: 0 2px 6px rgba(0,0,0,.10);
        margin-top: 2px;
    }

    .av-draft     { background: linear-gradient(135deg, #7a8a9a, #5c6e80); }
    .av-posted    { background: linear-gradient(135deg, #0d8a48, #16a35b); }
    .av-approved  { background: linear-gradient(135deg, #1558d6, #1e6ef5); }
    .av-cancelled { background: linear-gradient(135deg, #b02040, #e03048); }

    .exl-exp-info { min-width: 0; }

    .exl-exp-num { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    .exl-code-chip {
        display: inline-flex; align-items: center;
        padding: 2px 8px; border-radius: 6px;
        background: #f0f4fa; border: 1px solid #e0e8f4;
        font-size: 10.5px; font-weight: 800; color: #5a6e88;
        font-family: "Inter", Arial, sans-serif;
    }

    .exl-approved-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 18px; height: 18px; border-radius: 50%;
        background: var(--fc-green-lt); color: var(--fc-green);
        font-size: 10px; font-weight: 900; border: 1px solid #b0e0c5;
    }

    .exl-type-name { font-size: 12px; font-weight: 800; color: #344563; margin-top: 3px; }
    .exl-desc      { font-size: 10.5px; color: #6b7d95; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
    .exl-driver    { display: flex; align-items: center; gap: 3px; font-size: 10px; color: #9aaabb; margin-top: 2px; }

    /* ── Link Cell ── */
    .exl-link-cell { display: flex; flex-direction: column; gap: 4px; align-items: center; }

    .exl-link-tag {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 2px 7px; border-radius: 5px;
        font-size: 9.5px; font-weight: 700;
    }
    .tag-op       { background: rgba(30,110,245,.08);  color: var(--fc-blue);   border: 1px solid rgba(30,110,245,.15); }
    .tag-trip     { background: rgba(224,101,32,.08);  color: #c0501a;          border: 1px solid rgba(224,101,32,.15); }
    .tag-supplier { background: var(--fc-purple-lt);   color: var(--fc-purple); border: 1px solid #d0bfef; }
    .tag-custody  { background: var(--fc-amber-lt);    color: #9a6d08;          border: 1px solid #f0d898; }

    /* ── Date Cell ── */
    .exl-date-cell {
        display: flex; align-items: center; gap: 4px; justify-content: center;
        color: #6b7d95; font-size: 11px;
    }

    /* ── Amount ── */
    .exl-amount-cell { display: flex; align-items: baseline; gap: 3px; justify-content: center; }
    .exl-amount-main {
        font-family: "Inter", Arial, sans-serif;
        font-size: 13px; font-weight: 800; color: var(--fc-text);
    }
    .exl-amount-curr { font-size: 9px; color: #9aaabb; font-weight: 600; }
    .exl-tax-sub { font-size: 9.5px; color: #9aaabb; text-align: center; margin-top: 2px; }

    /* ── Chips ── */
    .exl-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 9px; border-radius: 7px;
        font-size: 10px; font-weight: 800; white-space: nowrap;
    }

    .exl-chip-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; }

    /* Status */
    .chip-draft    { background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }
    .chip-posted   { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .chip-cancelled { background: var(--fc-red-lt); color: var(--fc-red); border: 1px solid #ffc8cf; }

    .sdot-draft    { background: #9aaabb; }
    .sdot-posted   { background: var(--fc-green); }
    .sdot-cancelled { background: var(--fc-red); }

    /* Payment */
    .chip-unpaid  { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }
    .chip-partial { background: var(--fc-blue-lt);  color: var(--fc-blue); border: 1px solid #c0d4fb; }
    .chip-paid    { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }

    .pdot-unpaid  { background: var(--fc-amber); }
    .pdot-partial { background: var(--fc-blue); }
    .pdot-paid    { background: var(--fc-green); }

    .exl-status-cell { display: flex; flex-direction: column; align-items: center; gap: 3px; }

    /* ── Actions ── */
    .exl-actions { display: flex; align-items: center; gap: 3px; justify-content: center; flex-wrap: wrap; }

    .exl-act-btn {
        width: 28px; height: 28px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; cursor: pointer;
        transition: all .15s ease; background: transparent;
    }

    .act-edit    { color: var(--fc-blue); }
    .act-confirm { color: var(--fc-green); }
    .act-approve { color: var(--fc-teal); }
    .act-pay     { color: var(--fc-purple); }
    .act-cancel  { color: var(--fc-red); }
    .act-delete  { color: var(--fc-red); }

    .act-edit:hover    { background: var(--fc-blue-lt);   border-color: #c0d4fb; }
    .act-confirm:hover { background: var(--fc-green-lt);  border-color: #b0e0c5; }
    .act-approve:hover { background: var(--fc-teal-lt);   border-color: #b0e0dc; }
    .act-pay:hover     { background: var(--fc-purple-lt); border-color: #d0bfef; }
    .act-cancel:hover  { background: var(--fc-red-lt);    border-color: #ffc8cf; }
    .act-delete:hover  { background: var(--fc-red-lt);    border-color: #ffc8cf; }

    .exl-confirm-del {
        height: 26px; padding: 0 9px;
        border: none; border-radius: 6px;
        background: linear-gradient(135deg, #e03048, #c0182e);
        color: #fff; font-family: inherit;
