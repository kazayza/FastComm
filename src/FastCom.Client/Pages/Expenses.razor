@code {
    private AuthUser? _user;
    private bool CanView        => _user?.Can("EXPENSE.VIEW")       ?? false;
    private bool CanCreate      => _user?.Can("EXPENSE.CREATE")     ?? false;
    private bool CanEdit        => _user?.Can("EXPENSE.EDIT")       ?? false;
    private bool CanDelete      => _user?.Can("EXPENSE.DELETE")     ?? false;
    private bool CanApprove     => _user?.Can("EXPENSE.APPROVE")    ?? false;
    private bool CanManageTypes => _user?.Can("MASTERDATA.MANAGE")  ?? false;

    private static readonly (string Key, string Value)[] _statusTabs =
    {
        ("all",       "الكل"),
        ("Draft",     "مسودة"),
        ("Posted",    "مؤكد"),
        ("Cancelled", "ملغي")
    };

    private List<Item>    _items = new();
    private List<ExpType> _types = new();
    private bool   _loading;
    private string _search     = "";
    private string _tab        = "all";
    private int    _typeFilter;
    private long?  _confirmId;

    /* ── DTOs ── */
    public class ExpType { public int Id { get; set; } public string Label { get; set; } = ""; }

    public class Item
    {
        public long     ExpenseId       { get; set; }
        public string   ExpenseNumber   { get; set; } = "";
        public string   TypeName        { get; set; } = "";
        public string?  Description     { get; set; }
        public DateTime ExpenseDate     { get; set; }
        public decimal  Amount          { get; set; }
        public decimal  TaxRate         { get; set; }
        public string?  OperationNumber { get; set; }
        public string?  TripNumber      { get; set; }
        public string?  SupplierName    { get; set; }
        public string?  DriverName      { get; set; }
        public string?  CustodyNumber   { get; set; }
        public string   PaymentStatus   { get; set; } = "";
        public string   Status          { get; set; } = "";
        public bool     IsApproved      { get; set; }
    }

    /* ── Computed ── */
    private IEnumerable<Item> Active => _items.Where(e => e.Status != "Cancelled");

    private decimal ThisMonth => _items
        .Where(e => e.Status != "Cancelled" &&
                    e.ExpenseDate.Year == DateTime.Now.Year &&
                    e.ExpenseDate.Month == DateTime.Now.Month)
        .Sum(e => e.Amount);

    private IEnumerable<Item> Filtered => _items.Where(e =>
        (_tab == "all" || e.Status == _tab) &&
        (_typeFilter == 0 || e.TypeName == _types.FirstOrDefault(t => t.Id == _typeFilter)?.Label) &&
        (string.IsNullOrWhiteSpace(_search) ||
         e.ExpenseNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (e.Description     ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (e.OperationNumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)));

    /* ── Helpers ── */
    private static string StatusAr(string s) => s switch
    {
        "Draft"     => "مسودة", "Posted" => "مؤكد",
        "Cancelled" => "ملغي",  _        => s
    };

    private static string StatusChipClass(string s) => s switch
    {
        "Draft"     => "chip-draft",
        "Posted"    => "chip-posted",
        "Cancelled" => "chip-cancelled",
        _           => "chip-draft"
    };

    private static string StatusDotClass(string s) => s switch
    {
        "Draft"     => "sdot-draft",
        "Posted"    => "sdot-posted",
        "Cancelled" => "sdot-cancelled",
        _           => "sdot-draft"
    };

    private static string StatusDotColor(string s) => s switch
    {
        "all"       => "tdot-all",
        "Draft"     => "tdot-draft",
        "Posted"    => "tdot-posted",
        "Cancelled" => "tdot-cancelled",
        _           => "tdot-all"
    };

    private static string PayAr(string p) => p switch
    {
        "Unpaid"        => "غير مدفوع",
        "PartiallyPaid" => "جزئي",
        "Paid"          => "مدفوع",
        _               => p
    };

    private static string PayChipClass(string p) => p switch
    {
        "Unpaid"        => "chip-unpaid",
        "PartiallyPaid" => "chip-partial",
        "Paid"          => "chip-paid",
        _               => "chip-unpaid"
    };

    private static string PayDotClass(string p) => p switch
    {
        "Unpaid"        => "pdot-unpaid",
        "PartiallyPaid" => "pdot-partial",
        "Paid"          => "pdot-paid",
        _               => "pdot-unpaid"
    };

    private static string ExpAvatarClass(string status, bool approved) =>
        status == "Cancelled" ? "av-cancelled"
        : approved            ? "av-approved"
        : status == "Posted"  ? "av-posted"
        : "av-draft";

    private static string Money(decimal v) => v.ToString("N0");

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        await Task.WhenAll(LoadAsync(), LoadTypesAsync());
    }

    private async Task LoadTypesAsync()
    {
        try { _types = await Http.GetFromJsonAsync<List<ExpType>>("api/options/expense-types") ?? new(); }
        catch { _types = new(); }
    }

    private void GoNew()        => Nav.NavigateTo("/expenses/new");
    private void GoEdit(Item e) => Nav.NavigateTo($"/expenses/new/{e.ExpenseId}");

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try   { _items = await Http.GetFromJsonAsync<List<Item>>("api/expenses?take=300") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task SetStatus(Item e, string to)
    {
        try
        {
            var res = await Http.PostAsJsonAsync($"api/expenses/{e.ExpenseId}/status", new { to });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Approve(Item e)
    {
        try
        {
            var res = await Http.PostAsync($"api/expenses/{e.ExpenseId}/approve", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task SetPaid(Item e)
    {
        try
        {
            var res = await Http.PostAsJsonAsync($"api/expenses/{e.ExpenseId}/pay", new { to = "Paid" });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item e)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/expenses/{e.ExpenseId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    /* ── أنواع المصروفات ── */
    private bool      _typesOpen;   private bool _typesSaving;
    private string?   _typesMsg;    private bool _typesOk = true;
    private int?      _typeEditId;
    private List<TypeItem> _typesList = new();
    private TypeForm  _tf = new();

    public class TypeItem
    {
        public int    ExpenseTypeId    { get; set; }
        public string Code             { get; set; } = "";
        public string NameAr           { get; set; } = "";
        public string? NameEn          { get; set; }
        public bool   IsCustodyAllowed { get; set; }
        public bool   IsOperationCost  { get; set; }
        public bool   IsTaxDeductible  { get; set; }
        public bool   IsActive         { get; set; }
        public int    ExpenseCount     { get; set; }
    }

    public class TypeForm
    {
        public string  Code             { get; set; } = "";
        public string  NameAr           { get; set; } = "";
        public string? NameEn           { get; set; }
        public bool    IsCustodyAllowed { get; set; } = true;
        public bool    IsOperationCost  { get; set; } = true;
        public bool    IsTaxDeductible  { get; set; } = true;
        public bool    IsActive         { get; set; } = true;
        public int     ExpenseCount     { get; set; }
    }

    private async Task OpenTypes()
    {
        _typesOpen = true; _typesMsg = null;
        ResetTypeForm();
        await LoadTypeListAsync();
    }

    private void CloseTypes()
    {
        _typesOpen = false;
        _ = LoadAsync();
    }

    private void ResetTypeForm()
    {
        _typeEditId = null;
        _tf = new TypeForm();
        _typesMsg = null;
    }

    private void EditType(TypeItem t)
    {
        _typeEditId = t.ExpenseTypeId;
        _tf = new TypeForm
        {
            Code = t.Code, NameAr = t.NameAr, NameEn = t.NameEn,
            IsCustodyAllowed = t.IsCustodyAllowed, IsOperationCost = t.IsOperationCost,
            IsTaxDeductible = t.IsTaxDeductible, IsActive = t.IsActive,
            ExpenseCount = t.ExpenseCount
        };
        _typesMsg = null;
    }

    private async Task LoadTypeListAsync()
    {
        try { _typesList = await Http.GetFromJsonAsync<List<TypeItem>>("api/expense-types") ?? new(); }
        catch (Exception ex) { _typesOk = false; _typesMsg = "فشل التحميل: " + ex.Message; }
        try { _types = await Http.GetFromJsonAsync<List<ExpType>>("api/options/expense-types") ?? new(); }
        catch { }
    }

    private async Task SaveType()
    {
        if (_typesSaving) return;
        if (string.IsNullOrWhiteSpace(_tf.Code))   { _typesOk = false; _typesMsg = "الكود مطلوب"; return; }
        if (string.IsNullOrWhiteSpace(_tf.NameAr)) { _typesOk = false; _typesMsg = "الاسم بالعربي مطلوب"; return; }

        _typesSaving = true; _typesMsg = null;
        try
        {
            var payload = new
            {
                code = _tf.Code, nameAr = _tf.NameAr, nameEn = _tf.NameEn,
                isCustodyAllowed = _tf.IsCustodyAllowed, isOperationCost = _tf.IsOperationCost,
                isTaxDeductible = _tf.IsTaxDeductible, isActive = _tf.IsActive
            };
            var res = _typeEditId is null
                ? await Http.PostAsJsonAsync("api/expense-types", payload)
                : await Http.PutAsJsonAsync($"api/expense-types/{_typeEditId}", payload);

            _typesMsg = await MsgOf(res); _typesOk = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode) { ResetTypeForm(); await LoadTypeListAsync(); }
        }
        catch (Exception ex) { _typesOk = false; _typesMsg = "فشل: " + ex.Message; }
        finally { _typesSaving = false; }
    }

    private async Task DeleteType(TypeItem t)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/expense-types/{t.ExpenseTypeId}");
            _typesMsg = await MsgOf(res); _typesOk = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode) await LoadTypeListAsync();
        }
        catch (Exception ex) { _typesOk = false; _typesMsg = "فشل: " + ex.Message; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}