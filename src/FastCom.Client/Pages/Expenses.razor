@page "/expenses"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>المصروفات — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">المالية · المصروفات</div>
                <h1 class="fc-hero-title">المصروفات</h1>
                <p class="fc-hero-sub">وقود ورسوم ميناء ونش وغرامات — المصروف المرتبط بعملية أو رحلة بيدخل في تكلفتها</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="New">مصروف جديد</MudButton>
                }
            </div>
        </div>
        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">عدد المصروفات</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Savings" /></div>
                    <div><div class="fc-kpi-num">@Money(Active.Sum(e => e.Amount))</div><div class="fc-kpi-lb">إجمالي غير الملغي</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                    <div><div class="fc-kpi-num">@Money(ThisMonth)</div><div class="fc-kpi-lb">مصروفات الشهر الحالى</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Warning" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(e => e.Status == "Posted" && !e.IsApproved)</div><div class="fc-kpi-lb">مصروفات لم تعتمد</div></div></div>
            </div>
        }
    </div>
</div>

<div class="fc-page">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">ليس لديك  صلاحية عرض المصروفات.</MudAlert>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">
            <div class="fc-toolbar">
                <div class="fc-filters">
                    @foreach (var t in Tabs)
                    {
                        <button class='fc-filter @(_tab == t.Key ? "on" : "")' @onclick="() => SetTab(t.Key)">@t.Value</button>
                    }
                </div>
                <select class="fc-sel" style="max-width:200px" @bind="_typeFilter">
                    <option value="0">كل الأنواع</option>
                    @foreach (var t in _types) { <option value="@t.Id">@t.Label</option> }
                </select>
                <MudTextField T="string" Value="_search" ValueChanged="v => _search = v"
                              Placeholder="ابحث بالرقم أو البيان أو المرجع..." Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="fc-search-box" Immediate="true" />
                <span class="fc-count">عرض @Filtered.Count() من @_items.Count</span>
            </div>

            @if (_loading)
            {
                <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else
            {
                <div class="fc-table-wrap"><table class="fc-table fc-table-pro">
                    <thead><tr>
                        <th>الرقم</th><th>النوع</th><th>البيان</th><th>مربوط بـ</th>
                        <th>التاريخ</th><th>المبلغ</th><th>الدفع</th><th>الحالة</th>
                        <th style="width:180px; text-align:left">إجراءات</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var e in Filtered)
                        {
                            <tr>
                                <td><span class="fc-role-chip">@e.ExpenseNumber</span></td>
                                <td class="fc-cell-main">@e.TypeName</td>
                                <td class="fc-cell-sub">@(e.Description ?? "—")
                                    @if (e.DriverName is not null) { <div class="fc-cell-sub">السائق: @e.DriverName</div> }</td>
                                <td class="fc-cell-sub">
                                    @if (e.OperationNumber is not null) { <div>عملية @e.OperationNumber</div> }
                                    @if (e.TripNumber is not null) { <div>رحلة @e.TripNumber</div> }
                                    @if (e.SupplierName is not null) { <div>@e.SupplierName</div> }
                                    @if (e.CustodyNumber is not null) { <div>عهدة @e.CustodyNumber</div> }
                                    @if (e.OperationNumber is null && e.TripNumber is null && e.SupplierName is null) { <span>—</span> }
                                </td>
                                <td class="fc-cell-sub">@e.ExpenseDate.ToString("yyyy-MM-dd")</td>
                                <td><b>@Money(e.Amount)</b>
                                    @if (e.TaxRate > 0) { <div class="fc-cell-sub">ضريبة @e.TaxRate.ToString("0.##")%</div> }</td>
                                <td><span class="fc-chip @PayChip(e.PaymentStatus)"><i></i>@PayAr(e.PaymentStatus)</span></td>
                                <td>
                                    <span class="fc-chip @StatusChip(e.Status)"><i></i>@StatusAr(e.Status)</span>
                                    @if (e.IsApproved) { <div class="fc-cell-sub">✓ معتمد</div> }
                                </td>
                                <td><div class="fc-row-actions">
                                    @if (e.Status != "Cancelled" && CanEdit)
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                                       Color="Color.Primary" title="تعديل" OnClick="() => Edit(e)" />
                                    }
                                    @if (e.Status == "Draft" && CanEdit)
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle"
                                                       Color="Color.Success" title="تأكيد" OnClick='() => SetStatus(e, "Posted")' />
                                    }
                                    @if (e.Status == "Posted" && CanApprove && !e.IsApproved)
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.LockOpen"
                                                       Color="Color.Warning" title="اعتماد" OnClick="() => Approve(e)" />
                                    }
                                    @if (e.Status != "Cancelled" && CanEdit)
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                                       Color="Color.Error" title="إلغاء" OnClick='() => SetStatus(e, "Cancelled")' />
                                    }
                                    @if (CanDelete && e.PaymentStatus == "Unpaid")
                                    {
                                        @if (_confirmId == e.ExpenseId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                                       OnClick="() => Delete(e)">حذف؟</MudButton>
                                        }
                                        else
                                        {
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error" title="حذف" OnClick="() => _confirmId = e.ExpenseId" />
                                        }
                                    }
                                </div></td>
                            </tr>
                        }
                        @if (!Filtered.Any())
                        {
                            <tr><td colspan="9"><div class="fc-empty"><div>لاتوجد اى مصروفات لهذا الفلتر</div></div></td></tr>
                        }
                    </tbody>
                </table></div>
            }
        </div></div>
    }

    @if (_modalOpen && CanCreate)
    {
        <div class="fc-modal-backdrop" @onclick="Close">
            <div class="fc-modal" @onclick:stopPropagation>
                <div class="fc-modal-head">
                    <div><div class="fc-modal-title">@(_editId is null ? "مصروف جديد" : "تعديل مصروف")</div>
                        <div class="fc-modal-sub">الرقم بيتولد تلقائيًا (EXP-)</div></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" />
                </div>
                <div class="fc-modal-body">
                    @if (_msg is not null)
                    {
                        <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined"
                                  Class="mb-4">@_msg</MudAlert>
                    }
                    <div class="fc-form-grid">
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">نوع المصروف *</div>
                            <select class="fc-sel fc-sel-lg" value="@_f.ExpenseTypeId" @onchange="OnTypeChanged">
                                @foreach (var t in _types) { <option value="@t.Id">@t.Label</option> }
                            </select>
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">التاريخ</div>
                            <input type="datetime-local" class="fc-sel fc-sel-lg" value="@_f.ExpenseDate"
                                   @onchange="e => _f.ExpenseDate = e.Value?.ToString()" />
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">المبلغ *</div>
                            <input type="number" min="0.01" step="0.01" class="fc-sel fc-sel-lg" value="@_f.Amount"
                                   @onchange="e => _f.Amount = ParseAmount(e.Value)" />
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">الضريبة</div>
                            <select class="fc-sel fc-sel-lg" @bind="_f.TaxRateId">
                                <option value="">بدون</option>
                                @foreach (var t in _taxRates) { <option value="@t.Id">@t.Label</option> }
                            </select>
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">العملية</div>
                            @if (CurrentType?.IsOperationCost == false)
                            {
                                <div class="fc-cell-sub" style="padding:12px 0">النوع ده مش بيتحمل على عملية</div>
                            }
                            else
                            {
                                <select class="fc-sel fc-sel-lg" @bind="_f.OperationId">
                                    <option value="">—</option>
                                    @foreach (var o in _operations)
                                    {
                                        <option value="@o.OperationId">@o.OperationNumber — @o.CustomerName</option>
                                    }
                                </select>
                            }
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">الرحلة</div>
                            <select class="fc-sel fc-sel-lg" value="@_f.TripId" @onchange="OnTripChanged">
                                <option value="">—</option>
                                @foreach (var t in _trips)
                                {
                                    <option value="@t.TripId">@t.TripNumber — @t.DriverName</option>
                                }
                            </select>
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">العهدة (لو مدفوع من عهدة)</div>
                            @if (_f.TripId is null)
                            {
                                <div class="fc-cell-sub" style="padding:12px 0">اختار الرحلة الأول</div>
                            }
                            else if (!_custodies.Any())
                            {
                                <div class="fc-cell-sub" style="padding:12px 0">مافيش عهد مفتوحة على الرحلة دي</div>
                            }
                            else
                            {
                                <select class="fc-sel fc-sel-lg" value="@_f.CustodyId" @onchange="OnCustodyChanged">
                                    <option value="">— بدون عهدة —</option>
                                    @foreach (var c in _custodies)
                                    {
                                        <option value="@c.Id">@c.Label</option>
                                    }
                                </select>
                            }
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">المورد (لو مدفوع لجهة)</div>
                            <select class="fc-sel fc-sel-lg" @bind="_f.SupplierId">
                                <option value="">—</option>
                                @foreach (var s in _suppliers) { <option value="@s.Id">@s.Label</option> }
                            </select>
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">السائق</div>
                            <select class="fc-sel fc-sel-lg" @bind="_f.DriverId">
                                <option value="">—</option>
                                @foreach (var d in _drivers) { <option value="@d.Id">@d.Label</option> }
                            </select>
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">رقم مرجعي (إيصال/فاتورة)</div>
                            <input class="fc-sel fc-sel-lg" value="@_f.ReferenceNumber" maxlength="100"
                                   @onchange="e => _f.ReferenceNumber = e.Value?.ToString()" />
                        </div>
                        <div>
                            <div class="fc-panel-sub" style="margin-bottom:6px">البيان</div>
                            <input class="fc-sel fc-sel-lg" value="@_f.Description" maxlength="500"
                                   @onchange="e => _f.Description = e.Value?.ToString()" />
                        </div>
                    </div>
                    <div class="fc-panel-sub" style="margin:18px 0 8px">ملاحظات</div>
                    <textarea class="fc-sel" rows="2" maxlength="500"
                              @onchange="e => _f.Notes = e.Value?.ToString()">@_f.Notes</textarea>
                </div>
                <div class="fc-modal-foot">
                    <MudButton Variant="Variant.Outlined" OnClick="Close">إلغاء</MudButton>
                    @if (CanEdit)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Warning" Disabled="_saving"
                                   OnClick="() => SaveAsync(true)">حفظ كمسودة</MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                               OnClick="() => SaveAsync(false)">حفظ وتأكيد</MudButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("EXPENSE.VIEW") ?? false;
    private bool CanCreate => _user?.Can("EXPENSE.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("EXPENSE.EDIT") ?? false;
    private bool CanDelete => _user?.Can("EXPENSE.DELETE") ?? false;
    private bool CanApprove => _user?.Can("EXPENSE.APPROVE") ?? false;

    private static readonly Dictionary<string, string> Tabs = new()
    {
        ["all"] = "الكل", ["Draft"] = "مسودة", ["Posted"] = "مؤكد", ["Cancelled"] = "ملغي"
    };

    private List<Item> _items = new();
    private List<ExpType> _types = new();
    private List<TaxOpt> _taxRates = new();
    private List<OpOpt> _operations = new();
    private List<TripOpt> _trips = new();
    private List<Opt> _suppliers = new();
    private List<Opt> _drivers = new();
    private List<CustodyOpt> _custodies = new();

    private bool _loading; private string _search = ""; private string _tab = "all";
    private int _typeFilter;
    private long? _confirmId;
    private bool _modalOpen; private long? _editId; private bool _saving; private string? _msg; private bool _ok;
    private Form _f = new();

    public class Opt { public int Id { get; set; } public string Label { get; set; } = ""; }
    public class TaxOpt { public int Id { get; set; } public string Label { get; set; } = "";
        public decimal Value { get; set; } }
    public class ExpType { public int Id { get; set; } public string Label { get; set; } = "";
        public bool CustodyAllowed { get; set; } public bool IsOperationCost { get; set; }
        public bool IsTaxDeductible { get; set; } }
    public class OpOpt { public long OperationId { get; set; } public string OperationNumber { get; set; } = "";
        public string CustomerName { get; set; } = ""; public string Status { get; set; } = ""; }
    public class TripOpt { public long TripId { get; set; } public string TripNumber { get; set; } = "";
        public string DriverName { get; set; } = ""; }
    public class CustodyOpt { public long Id { get; set; } public string Label { get; set; } = "";
        public string OwnerType { get; set; } = ""; public int OwnerId { get; set; }
        public long TripId { get; set; } public decimal AmountIssued { get; set; } }

    public class Item
    {
        public long ExpenseId { get; set; }
        public string ExpenseNumber { get; set; } = "";
        public string TypeName { get; set; } = "";
        public string? Description { get; set; }
        public DateTime ExpenseDate { get; set; }
        public decimal Amount { get; set; }
        public decimal TaxRate { get; set; }
        public string? OperationNumber { get; set; }
        public string? TripNumber { get; set; }
        public string? SupplierName { get; set; }
        public string? DriverName { get; set; }
        public string? CustodyNumber { get; set; }
        public string PaymentStatus { get; set; } = "";
        public string Status { get; set; } = "";
        public bool IsApproved { get; set; }
    }

    public class Detail
    {
        public int ExpenseTypeId { get; set; }
        public string? ExpenseDate { get; set; }
        public string? Description { get; set; }
        public decimal Amount { get; set; }
        public int? TaxRateId { get; set; }
        public bool IsTaxDeductible { get; set; }
        public long? OperationId { get; set; }
        public long? TripId { get; set; }
        public int? DriverId { get; set; }
        public int? SupplierId { get; set; }
        public long? CustodyId { get; set; }
        public string? ReferenceNumber { get; set; }
        public string? Notes { get; set; }
    }

    public class Form
    {
        public int ExpenseTypeId { get; set; }
        public string? ExpenseDate { get; set; }
        public string? Description { get; set; }
        public decimal Amount { get; set; }
        public long? OperationId { get; set; }
        public long? TripId { get; set; }
        public int? DriverId { get; set; }
        public int? SupplierId { get; set; }
        public long? CustodyId { get; set; }
        public int? TaxRateId { get; set; }
        public bool? IsTaxDeductible { get; set; }
        public string? ReferenceNumber { get; set; }
        public string? Notes { get; set; }
    }

    private ExpType? CurrentType => _types.FirstOrDefault(t => t.Id == _f.ExpenseTypeId);

    private IEnumerable<Item> Active => _items.Where(e => e.Status != "Cancelled");

    private decimal ThisMonth => _items
        .Where(e => e.Status != "Cancelled" &&
                    e.ExpenseDate.Year == DateTime.Now.Year && e.ExpenseDate.Month == DateTime.Now.Month)
        .Sum(e => e.Amount);

    private static string StatusAr(string s) => s switch
    {
        "Draft" => "مسودة", "Posted" => "مؤكد", "Cancelled" => "ملغي", _ => s
    };

    private static string StatusChip(string s) => s switch
    {
        "Draft" => "fc-chip-gray", "Posted" => "fc-chip-ok", "Cancelled" => "fc-chip-bad", _ => "fc-chip-gray"
    };

    private static string PayAr(string p) => p switch
    {
        "Unpaid" => "غير مدفوعه", "PartiallyPaid" => "جزئي", "Paid" => "مدفوع", _ => p
    };

    private static string PayChip(string p) => p switch
    {
        "Unpaid" => "fc-chip-warn", "PartiallyPaid" => "fc-chip-blue", "Paid" => "fc-chip-ok", _ => "fc-chip-gray"
    };

    private static string Money(decimal v) => v.ToString("N0");

    private static decimal ParseAmount(object? v) =>
        decimal.TryParse(v?.ToString(), out var n) && n > 0 ? n : 0m;

    private IEnumerable<Item> Filtered => _items.Where(e =>
        (_tab == "all" || e.Status == _tab) &&
        (_typeFilter == 0 || e.TypeName == _types.FirstOrDefault(t => t.Id == _typeFilter)?.Label) &&
        (string.IsNullOrWhiteSpace(_search) ||
         e.ExpenseNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (e.Description ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (e.OperationNumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
        if (CanCreate) await LoadLookupsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        _types     = await SafeGetT<ExpType>("api/options/expense-types");
        _taxRates  = await SafeGetT<TaxOpt>("api/options/tax-rates");
        _suppliers = await SafeGetT<Opt>("api/options/suppliers");
        _drivers   = await SafeGetT<Opt>("api/options/drivers");
        _operations = await SafeGetT<OpOpt>("api/operations?take=200");
        _trips      = await SafeGetT<TripOpt>("api/trips?take=200");
    }

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/expenses?take=300") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        _f.ExpenseTypeId = int.TryParse(e.Value?.ToString(), out var n) ? n : 0;
        var t = CurrentType;
        if (t is not null && !t.IsOperationCost) _f.OperationId = null;
        _f.IsTaxDeductible = t?.IsTaxDeductible;
    }

    private void OnTripChanged(ChangeEventArgs e)
    {
        _f.TripId = long.TryParse(e.Value?.ToString(), out var t) && t > 0 ? t : null;
        _f.CustodyId = null;
        _ = LoadCustodiesAsync();
    }

    private void OnCustodyChanged(ChangeEventArgs e)
    {
        var id = long.TryParse(e.Value?.ToString(), out var c) && c > 0 ? c : (long?)null;
        _f.CustodyId = id;
        if (id is null) return;
        var cus = _custodies.FirstOrDefault(x => x.Id == id);
        if (cus is null) return;
        // العهدة على رحلة — فلو الرحلة مش متختارة، نملاها أوتوماتيك
        _f.TripId ??= cus.TripId;
        if (cus.OwnerType == "Driver") _f.DriverId ??= cus.OwnerId;
    }

    private async Task LoadCustodiesAsync()
    {
        _custodies = _f.TripId is null
            ? new()
            : await SafeGetT<CustodyOpt>($"api/options/custodies?tripId={_f.TripId}");
    }

    private void New()
    {
        _editId = null;
        _f = new Form
        {
            ExpenseTypeId = _types.FirstOrDefault()?.Id ?? 0,
            ExpenseDate = DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
        };
        var t0 = CurrentType;
        _f.IsTaxDeductible = t0?.IsTaxDeductible;
        _msg = null; _modalOpen = true;
    }

    private async Task Edit(Item e)
    {
        try
        {
            var d = await Http.GetFromJsonAsync<Detail>($"api/expenses/{e.ExpenseId}");
            if (d is null) return;
            _editId = e.ExpenseId;
            _f = new Form
            {
                ExpenseTypeId = d.ExpenseTypeId, ExpenseDate = d.ExpenseDate,
                Description = d.Description, Amount = d.Amount,
                OperationId = d.OperationId, TripId = d.TripId,
                DriverId = d.DriverId, SupplierId = d.SupplierId, CustodyId = d.CustodyId,
                TaxRateId = d.TaxRateId, IsTaxDeductible = d.IsTaxDeductible,
                ReferenceNumber = d.ReferenceNumber, Notes = d.Notes
            };
            _msg = null; _modalOpen = true;
            await LoadCustodiesAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private void Close() { _modalOpen = false; }

    private async Task SaveAsync(bool asDraft)
    {
        _saving = true; _msg = null;
        try
        {
            var payload = new
            {
                expenseTypeId  = _f.ExpenseTypeId,
                expenseDate    = _f.ExpenseDate,
                description    = _f.Description,
                amount         = _f.Amount,
                operationId    = _f.OperationId,
                tripId         = _f.TripId,
                driverId       = _f.DriverId,
                supplierId     = _f.SupplierId,
                custodyId      = _f.CustodyId,
                taxRateId      = _f.TaxRateId,
                isTaxDeductible = _f.IsTaxDeductible,
                referenceNumber = _f.ReferenceNumber,
                notes          = _f.Notes,
                asDraft        = asDraft
            };

            var res = _editId is null
                ? await Http.PostAsJsonAsync("api/expenses", payload)
                : await Http.PutAsJsonAsync($"api/expenses/{_editId}", payload);

            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode) { Snackbar.Add(_msg, Severity.Success); Close(); await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    private async Task SetStatus(Item e, string to)
    {
        try
        {
            var res = await Http.PostAsJsonAsync($"api/expenses/{e.ExpenseId}/status", new { to });
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Approve(Item e)
    {
        try
        {
            var res = await Http.PostAsync($"api/expenses/{e.ExpenseId}/approve", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(Item e)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/expenses/{e.ExpenseId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
