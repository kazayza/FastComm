    .chip-op    { background: rgba(30,110,245,.08); color: var(--fc-blue); border: 1px solid rgba(30,110,245,.15); }
    .chip-admin { background: var(--fc-purple-lt); color: var(--fc-purple); border: 1px solid #d0bfef; }

    .type-actions { display: flex; align-items: center; gap: 4px; justify-content: center; }

    .exl-types-empty {
