    .exl-types-table tbody tr { border-bottom: 1px solid #f0f5fb; transition: background .12s ease; }
    .exl-types-table tbody tr:last-child { border-bottom: none; }
    .exl-types-table tbody tr:hover { background: #f5f8ff; }
    .exl-types-table tbody tr.type-row-inactive { opacity: .6; }

    .exl-types-table tbody td { padding: 10px 12px; color: #526070; text-align: center; vertical-align: middle; }

    .type-name-cell { display: flex; align-items: center; gap: 7px; text-align: right; font-weight: 700; color: #1c2c44; }

    .type-inactive-tag {
