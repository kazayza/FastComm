@page "/shipping-agents"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>الوكلاء الملاحيين — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ *@
<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">البيانات الأساسية · الأطراف</div>
                <h1 class="fc-hero-title">الوكلاء الملاحيين</h1>
                <p class="fc-hero-sub">شركات الملاحة اللي بتتعامل معاها — بتظهر في الفواتير</p>
            </div>
        </div>

        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">إجمالي الوكلاء</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(s => s.IsActive)</div><div class="fc-kpi-lb">نشط</div></div>
                </div>
                <div class="fc-kpi">
                    <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Block" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(s => !s.IsActive)</div><div class="fc-kpi-lb">معطّل</div></div>
                </div>
            </div>
        }
    </div>
</div>

@* ═══════════════════════════════════════════
   BODY
═══════════════════════════════════════════ *@
<div class="sa-body">

    @if (!CanView)
    {
        <div class="sa-state-box">
            <div class="sa-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض الوكلاء الملاحيين — تواصل مع المسؤول</p>
        </div>
    }
    else
    {
        <div class="sa-card">

            @* ── Toolbar ── *@
            <div class="sa-toolbar">

                <div class="sa-search-wrap">
                    <svg class="sa-search-icon" viewBox="0 0 24 24"
                         width="16" height="16" fill="none" stroke="currentColor"
                         stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="sa-search-input"
                           placeholder="ابحث بالاسم أو الكود..."
                           @bind="_search"
                           @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="sa-search-clear"
                                @onclick="() => _search = string.Empty"
                                aria-label="مسح البحث">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="sa-filters" role="group" aria-label="فلتر الحالة">
                    <button class="sa-filter @(_filter == "all" ? "active" : "")"
                            @onclick='() => _filter = "all"'
                            aria-pressed="@(_filter == "all")">
                        الكل
                        <span class="sa-filter-count">@_items.Count</span>
                    </button>
                    <button class="sa-filter @(_filter == "active" ? "active" : "")"
                            @onclick='() => _filter = "active"'
                            aria-pressed="@(_filter == "active")">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <circle cx="12" cy="12" r="5" fill="#16a35b" stroke="none"/>
                        </svg>
                        نشط
                        <span class="sa-filter-count">@_items.Count(s => s.IsActive)</span>
                    </button>
                    <button class="sa-filter @(_filter == "inactive" ? "active" : "")"
                            @onclick='() => _filter = "inactive"'
                            aria-pressed="@(_filter == "inactive")">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <circle cx="12" cy="12" r="5" fill="#e03048" stroke="none"/>
                        </svg>
                        معطّل
                        <span class="sa-filter-count">@_items.Count(s => !s.IsActive)</span>
                    </button>
                </div>

                <div class="sa-results-badge">
                    <svg viewBox="0 0 16 16" width="11" height="11"
                         fill="none" stroke="currentColor" stroke-width="1.8"
                         aria-hidden="true">
                        <circle cx="8" cy="8" r="6"/>
                        <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                    </svg>
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                </div>

            </div>

            @* ── المحتوى ── *@
            @if (_loading)
            {
                <div class="sa-loading">
                    <div class="sa-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل الوكلاء...</span>
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="sa-error-box" role="alert">
                    <div class="sa-error-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="28" height="28"
                             fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="sa-error-text">@_loadError</div>
                    <button class="sa-retry-btn" @onclick="Reload">
                        <svg viewBox="0 0 24 24" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M23 4v6h-6" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M1 20v-6h6" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        إعادة المحاولة
                    </button>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="sa-empty">
                    <div class="sa-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="40" height="40"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                            <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
                        </svg>
                    </div>
                    <div class="sa-empty-title">
                        @(string.IsNullOrWhiteSpace(_search) ? "مافيش وكلاء ملاحيين لسه" : "مافيش نتائج")
                    </div>
                    <div class="sa-empty-sub">
                        @(string.IsNullOrWhiteSpace(_search)
                            ? "ابدأ بإضافة أول وكيل ملاحي بالنقر على الزر العائم"
                            : "جرّب بكلمة بحث مختلفة")
                    </div>
                </div>
            }
            else
            {
                <div class="sa-table-wrap">
                    <table class="sa-table" aria-label="قائمة الوكلاء الملاحيين">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">الوكيل الملاحي</th>
                                <th scope="col">التليفون</th>
                                <th scope="col">البريد الإلكتروني</th>
                                <th scope="col">العنوان</th>
                                <th scope="col">الحالة</th>
                                @if (CanEdit)
                                {
                                    <th scope="col" style="width:130px">إجراءات</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Filtered)
                            {
                                <tr class="@(!s.IsActive ? "row-inactive" : "")">

                                    <td class="td-start">
                                        <div class="sa-agent-cell">
                                            <div class="sa-avatar">
                                                @(s.NameAr.Length > 0 ? s.NameAr[0].ToString() : "؟")
                                            </div>
                                            <div class="sa-agent-info">
                                                <div class="sa-agent-name">@s.NameAr</div>
                                                <div class="sa-agent-meta">
                                                    <span class="sa-code-chip">@s.Code</span>
                                                    @if (!string.IsNullOrWhiteSpace(s.NameEn))
                                                    {
                                                        <span class="sa-en-name">@s.NameEn</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="td-muted" dir="ltr">@(s.Phone ?? "—")</td>
                                    <td class="td-muted">@(s.Email ?? "—")</td>
                                    <td class="td-muted">@(s.Address ?? "—")</td>

                                    <td>
                                        @if (s.IsActive)
                                        {
                                            <span class="sa-chip chip-green">
                                                <span class="chip-dot dot-green" aria-hidden="true"></span>
                                                نشط
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="sa-chip chip-red">
                                                <span class="chip-dot dot-red" aria-hidden="true"></span>
                                                معطّل
                                            </span>
                                        }
                                    </td>

                                    @if (CanEdit)
                                    {
                                        <td>
                                            <div class="sa-actions">

                                                <button class="sa-act-btn act-edit"
                                                        @onclick="() => GoEdit(s)"
                                                        title="تعديل"
                                                        aria-label="تعديل @s.NameAr">
                                                    <svg viewBox="0 0 24 24" width="15" height="15"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>

                                                <button class="sa-act-btn @(s.IsActive ? "act-stop" : "act-start")"
                                                        @onclick="() => ToggleActive(s)"
                                                        title="@(s.IsActive ? "إيقاف" : "تفعيل")"
                                                        aria-label="@(s.IsActive ? "إيقاف" : "تفعيل") @s.NameAr">
                                                    @if (s.IsActive)
                                                    {
                                                        <svg viewBox="0 0 24 24" width="15" height="15"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"/>
                                                            <path d="M10 15V9M14 15V9" stroke-linecap="round"/>
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg viewBox="0 0 24 24" width="15" height="15"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"/>
                                                            <path d="M10 8l6 4-6 4V8z" fill="currentColor" stroke="none"/>
                                                        </svg>
                                                    }
                                                </button>

                                                @if (_confirmId == s.ShippingAgentId)
                                                {
                                                    <button class="sa-confirm-del"
                                                            @onclick="() => Delete(s)">
                                                        متأكد؟
                                                    </button>
                                                }
                                                else if (CanDelete)
                                                {
                                                    <button class="sa-act-btn act-delete"
                                                            @onclick="() => _confirmId = s.ShippingAgentId"
                                                            title="حذف"
                                                            aria-label="حذف @s.NameAr">
                                                        <svg viewBox="0 0 24 24" width="15" height="15"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                }

                                            </div>
                                        </td>
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>

@* ═══════════════════════════════════════════
   FABs — أزرار عائمة أسفل يسار الشاشة
═══════════════════════════════════════════ *@
@if (CanView)
{
    <div class="sa-fab-group">
        @* زر تحديث *@
        <button class="sa-fab sa-fab-secondary" @onclick="Reload"
                title="تحديث القائمة" aria-label="تحديث القائمة">
            <svg viewBox="0 0 24 24" width="20" height="20"
                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M23 4v6h-6" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M1 20v-6h6" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"
                      stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>

        @* زر إضافة *@
        @if (CanCreate)
        {
            <button class="sa-fab sa-fab-primary" @onclick="GoNew"
                    title="وكيل ملاحي جديد" aria-label="إضافة وكيل ملاحي جديد">
                <svg viewBox="0 0 24 24" width="24" height="24"
                     fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        }
    </div>
}

<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    .sa-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px clamp(16px, 3vw, 40px) 100px;
        width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
    }

    /* ── States ── */
    .sa-state-box {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .sa-state-icon {
        width: 68px; height: 68px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .sa-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .sa-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .sa-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* ── Card ── */
    .sa-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden; width: 100%;
    }

    /* ── Toolbar ── */
    .sa-toolbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
        flex-wrap: wrap;
    }

    .sa-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 200px; max-width: 360px;
    }
    .sa-search-icon {
        position: absolute; right: 12px; color: #9aaabb; pointer-events: none;
    }
    .sa-search-input {
        width: 100%; height: 38px;
        padding: 0 36px 0 12px;
        border: 1px solid #d8e2f0; border-radius: 9px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .sa-search-input:focus {
        border-color: var(--fc-blue);
        box-shadow: 0 0 0 3px rgba(30,110,245,.10);
    }
    .sa-search-input::placeholder { color: #b0bcc8; }
    .sa-search-clear {
        position: absolute; left: 10px;
        display: flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        border: none; background: #edf1f7; color: #8899ae;
        cursor: pointer; transition: all .12s ease;
    }
    .sa-search-clear:hover { background: #dde5f0; color: var(--fc-text); }

    .sa-filters {
        display: flex; gap: 4px;
        padding: 3px; border-radius: 9px; background: #f0f3f8;
    }
    .sa-filter {
        display: flex; align-items: center; gap: 5px;
        height: 32px; padding: 0 12px;
        border: none; border-radius: 7px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 11px; font-weight: 700;
        cursor: pointer; white-space: nowrap;
        transition: all .15s ease;
    }
    .sa-filter:hover:not(.active) { color: var(--fc-text); background: rgba(0,0,0,.04); }
    .sa-filter.active {
        background: var(--fc-card); color: var(--fc-text);
        box-shadow: 0 1px 4px rgba(15,41,82,.10);
        font-weight: 800;
    }
    .sa-filter-count {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 18px; height: 18px; padding: 0 4px;
        border-radius: 5px; font-size: 10px; font-weight: 900;
        font-family: "Inter", Arial, sans-serif;
    }
    .sa-filter.active .sa-filter-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .sa-filter:not(.active) .sa-filter-count { background: #e4eaf3; color: #8899ae; }

    .sa-results-badge {
        display: flex; align-items: center; gap: 5px;
        margin-right: auto;
        font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap;
    }
    .sa-results-badge strong { color: #5a6e88; }

    /* ── Loading / Error / Empty ── */
    .sa-loading {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 12px; min-height: 200px;
        color: var(--fc-muted); font-size: 12px; font-weight: 600;
    }
    .sa-spinner {
        width: 32px; height: 32px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: sa-spin .75s linear infinite;
    }
    @@keyframes sa-spin { to { transform: rotate(360deg); } }

    .sa-error-box {
        display: flex; flex-direction: column; align-items: center;
        gap: 10px; padding: 40px 20px; text-align: center;
    }
    .sa-error-icon { color: var(--fc-red); }
    .sa-error-text { font-size: 13px; color: var(--fc-red); font-weight: 600; }
    .sa-retry-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 34px; padding: 0 14px;
        border: 1px solid var(--fc-border); border-radius: 8px;
        background: var(--fc-card); color: var(--fc-text);
        font-family: inherit; font-size: 11px; font-weight: 700;
        cursor: pointer; transition: all .15s ease;
    }
    .sa-retry-btn:hover { background: #f0f4fa; border-color: #c0ccd8; }

    .sa-empty {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 10px; min-height: 240px; padding: 40px 20px; text-align: center;
    }
    .sa-empty-icon {
        width: 72px; height: 72px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #f0f4fa; color: #b0c4d8;
    }
    .sa-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .sa-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    /* ── Table ── */
    .sa-table-wrap { overflow-x: auto; }
    .sa-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .sa-table thead th {
        padding: 11px 14px;
        background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 11px; font-weight: 800;
        text-align: center; border-bottom: 2px solid #e4eaf3;
        white-space: nowrap; position: sticky; top: 0; z-index: 1;
    }
    .sa-table .th-start { text-align: right; }
    .sa-table tbody tr {
        border-bottom: 1px solid #f0f3f8; transition: background .12s ease;
    }
    .sa-table tbody tr:last-child { border-bottom: none; }
    .sa-table tbody tr:hover { background: #fafcff; }
    .sa-table tbody tr.row-inactive { opacity: .6; }
    .sa-table tbody td {
        padding: 12px 14px; color: #526070; text-align: center; vertical-align: middle;
    }
    .td-start { text-align: right !important; }
    .td-muted { color: #8899ae; font-size: 12px; }

    /* Agent Cell */
    .sa-agent-cell { display: flex; align-items: center; gap: 11px; }
    .sa-avatar {
        width: 38px; height: 38px; flex: 0 0 38px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; font-weight: 800; color: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,.12);
        background: linear-gradient(135deg, #1a3a6b, #1e6ef5);
    }
    .sa-agent-name { font-size: 13px; font-weight: 800; color: #1c2c44; }
    .sa-agent-meta { display: flex; align-items: center; gap: 7px; margin-top: 3px; }
    .sa-code-chip {
        display: inline-flex; align-items: center;
        padding: 1px 7px; border-radius: 5px;
        background: #f0f4fa; border: 1px solid #e0e8f4;
