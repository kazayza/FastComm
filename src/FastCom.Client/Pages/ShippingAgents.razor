@code {
    private AuthUser? _user;
    private List<ShippingAgentDto> _items = new();
    private string _search = "";
    private string _filter = "all";
    private bool _loading = true;
    private string? _loadError;
    private int? _confirmId;

    private bool CanView   => _user?.Can("SHIPPING_AGENT.VIEW")   ?? false;
    private bool CanCreate => _user?.Can("SHIPPING_AGENT.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("SHIPPING_AGENT.EDIT")   ?? false;
    private bool CanDelete => _user?.Can("SHIPPING_AGENT.DELETE") ?? false;

    private IEnumerable<ShippingAgentDto> Filtered
    {
        get
        {
            var q = _items.AsEnumerable();
            q = _filter switch
            {
                "active"   => q.Where(s => s.IsActive),
                "inactive" => q.Where(s => !s.IsActive),
                _          => q
            };
            return string.IsNullOrWhiteSpace(_search)
                ? q
                : q.Where(s =>
                    s.NameAr.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    s.Code.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (s.NameEn ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    private async Task Reload()
    {
        _confirmId = null;
        await LoadAsync();
        Snackbar.Add("تم تحديث القائمة", Severity.Success);
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try { _items = await Http.GetFromJsonAsync<List<ShippingAgentDto>>("api/shipping-agents") ?? new(); }
        catch (Exception ex) { _loadError = "فشل تحميل البيانات: " + ex.Message; }
        finally { _loading = false; }
    }

    private void GoNew() => Nav.NavigateTo("/shipping-agents/new");
    private void GoEdit(ShippingAgentDto s) => Nav.NavigateTo($"/shipping-agents/new/{s.ShippingAgentId}");

    private async Task ToggleActive(ShippingAgentDto s)
    {
        try
        {
            s.IsActive = !s.IsActive;
            var res = await Http.PutAsJsonAsync($"api/shipping-agents/{s.ShippingAgentId}", s);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private async Task Delete(ShippingAgentDto s)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/shipping-agents/{s.ShippingAgentId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var body = await res.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return res.IsSuccessStatusCode ? "تمت العملية بنجاح" : "خطأ غير معروف";
            var doc = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(body);
            if (doc.TryGetProperty("message", out var m)) return m.GetString() ?? body;
            return body;
        }
        catch { return res.IsSuccessStatusCode ? "تمت العملية بنجاح" : $"خطأ HTTP {(int)res.StatusCode}"; }
    }

    private class ShippingAgentDto
    {
        public int ShippingAgentId { get; set; }
        public string Code { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string? NameEn { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? Notes { get; set; }
        public bool IsActive { get; set; }
    }
}