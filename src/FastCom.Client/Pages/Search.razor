@page "/search"
@* 🔴 البحث محتاج توكن — والـ API بقى [Authorize] في Step 3.5 *@
@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>نتيجة البحث</PageTitle>

<div class="fc-container">
<MudText Typo="Typo.h4">نتيجة البحث</MudText>
<MudText Typo="Typo.body1" Class="muted mt-1">
    اخترت عنصرًا من البحث العام.
</MudText>

<MudPaper Class="pa-8 mt-6 text-center" Elevation="0" Outlined="true">

    <MudIcon Icon="@Icons.Material.Filled.Construction"
             Size="Size.Large" Color="Color.Warning" />

    <MudText Typo="Typo.h5" Class="mt-4">الوحدة دي لسه ما اتبنتش</MudText>

    <table class="fc-table mt-6" style="max-width:520px; margin-inline:auto;">
        <tbody>
            <tr><th>النوع</th><td><strong>@_entity</strong></td></tr>
            <tr><th>الرقم التعريفي</th><td>@_id</td></tr>
            <tr><th>هيفتح على</th><td><code>@_target</code></td></tr>
            <tr><th>هتتوصّل في</th><td>@_step</td></tr>
        </tbody>
    </table>

    <MudText Typo="Typo.body2" Class="muted mt-6">
        البحث العام شغال على قاعدة البيانات فعلًا — بس صفحات العرض لسه جاية
        مع كل وحدة في خطواتها.
    </MudText>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6"
               StartIcon="@Icons.Material.Filled.Home"
               OnClick="@(() => Nav.NavigateTo("/"))">
        الرجوع للرئيسية
    </MudButton>

</MudPaper>
</div>

@code {
    [SupplyParameterFromQuery(Name = "entity")] public string? Entity { get; set; }
    [SupplyParameterFromQuery(Name = "id")]     public string? Id     { get; set; }
    [SupplyParameterFromQuery(Name = "from")]   public string? From   { get; set; }

    private string _entity = "";
    private string _id     = "";
    private string _target = "";
    private string _step   = "";

    private static readonly Dictionary<string, string> Steps = new(StringComparer.Ordinal)
    {
        ["عميل"]   = "Step 5 — البيانات الأساسية",
        ["حجز"]    = "Step 6 — الحجوزات",
        ["عملية"]  = "Step 7 — العمليات والرحلات",
        ["رحلة"]   = "Step 7 — العمليات والرحلات",
        ["حاوية"]  = "Step 7 — العمليات والرحلات",
        ["فاتورة"] = "Step 9 — الفواتير والتحصيل",
        ["سيارة"]  = "Step 5 — البيانات الأساسية"
    };

    protected override void OnInitialized()
    {
        _entity = Entity ?? "—";
        _id     = Id ?? "—";
        _target = From ?? "—";
        _step   = Steps.TryGetValue(_entity, out var s) ? s : "—";
    }
}
