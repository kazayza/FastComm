@page "/search"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Models
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>البحث العام والموحد — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="pay-hero-row">
                <div class="pay-hero-left">
                    <div class="pay-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                        </svg>
                        <span>الرئيسية · محرك البحث الموحد</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">البحث العام والموحد</h1>
                    <span class="pay-hero-sub">ابحث بالرقم، الكود، أو الاسم عبر كافة الوحدات والقطاعات التشغيلية والمالية المصرح لك بها</span>
                </div>

                <div class="pay-hero-right">
                    <span class="pay-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

            @* ── KPI Connected Glass Strip ── *@
            @if (CanView && !_loading)
            {
                <div class="pay-kpis-strip">

                    <div class="pay-kpi-item">
                        <div class="pay-kpi-icon kpi-green">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-linecap="round"/>
                                <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">إجمالي نتائج البحث</div>
                            <div class="pay-kpi-val">@_res.Count <small>نتيجة</small></div>
                        </div>
                    </div>

                    <div class="pay-kpi-div" aria-hidden="true"></div>

                    <div class="pay-kpi-item">
                        <div class="pay-kpi-icon kpi-blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>
                                <rect x="9" y="9" width="6" height="6"/>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">قطاعات البحث المفتوحة</div>
                            <div class="pay-kpi-val kpi-val-blue">@_searchable.Count <small>قطاع</small></div>
                        </div>
                    </div>

                    <div class="pay-kpi-div" aria-hidden="true"></div>

                    <div class="pay-kpi-item">
                        <div class="pay-kpi-icon kpi-red">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                        </div>
                        <div class="pay-kpi-text">
                            <div class="pay-kpi-label">قطاعات محجوبة لعدم الصلاحية</div>
                            <div class="pay-kpi-val kpi-val-red">@_denied.Count <small>قطاع</small></div>
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY SECTION
═══════════════════════════════════════════ *@
<div class="pay-body">

    @if (!CanView)
    {
        <div class="pay-state-box">
            <div class="pay-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليست لديك الصلاحية الأمنية الكافية لاستخدام محرك البحث العام الموحد.</p>
        </div>
    }
    else
    {
        <div class="pay-card">

            @* ── صندوق البحث الرئيسي ── *@
            <div class="search-section-box">
                <div class="search-section-head">
                    <div class="search-n-badge" aria-hidden="true">1</div>
                    <div>
                        <div class="search-section-title">صندوق الاستعلامات العام</div>
                        <div class="search-section-sub">أدخل الرقم التسلسلي، أو جزء من الاسم — سيقوم النظام بالمسح والبحث الفوري</div>
                    </div>
                </div>

                <div class="search-input-container">
                    <div class="search-field-wrapper">
                        <svg class="search-prefix-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                        </svg>
                        <input class="search-input-field" 
                               placeholder="مثال: OP-2026-00042 ، شركة النور للتصدير ، INV-2026..."
                               value="@_q" 
                               @oninput="OnInput" 
                               autofocus />
                        
                        @if (!string.IsNullOrEmpty(_q))
                        {
                            <button type="button" class="search-clear-btn" @onclick="Clear" title="تصفير حقل البحث">✕</button>
                        }
                    </div>

                    <button type="button" class="search-submit-btn" @onclick="() => RunAsync(_q)" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="btn-spinner sm"></span>
                            <span>جاري التحري...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                            </svg>
                            <span>بحث</span>
                        }
                    </button>
                </div>

                @if (_denied.Count > 0)
                {
                    <div class="search-denied-alert" role="status">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        <div>
                            <strong>قطاعات محجوبة لعدم كفاية الصلاحية:</strong>
                            <span>@string.Join(" · ", _denied)</span>
                        </div>
                    </div>
                }

                @if (_err is not null)
                {
                    <div class="search-error-banner" role="alert">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        <span>@_err</span>
                    </div>
                }
            </div>

            @* ── نتائج الاستعلام الموحدة ── *@
            @if (_searched)
            {
                <div class="search-results-section">
                    <div class="search-section-head">
                        <div class="search-n-badge" aria-hidden="true">2</div>
                        <div>
                            <div class="search-section-title">السجلات المكتشفة في الفهرس</div>
                            <div class="search-section-sub">
                                @if (_busy)
                                {
                                    <span>جاري فحص وتصفية مدخلات البحث...</span>
                                }
                                else
                                {
                                    <span>تم العثور على <strong>@_res.Count</strong> نتيجة مطابقة لعبارة البحث «@_lastQ»</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (_busy)
                    {
                        <div class="pay-loading">
                            <div class="pay-spinner" aria-label="جاري تصفية النتائج"></div>
                            <span>جاري جلب السجلات المتطابقة من القواعد...</span>
                        </div>
                    }
                    else if (_res.Count == 0)
                    {
                        @* ── Empty State الفاخر والمطور عند عدم العثور على نتائج ── *@
                        <div class="flt-empty-state-box">
                            <div class="flt-empty-glow" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <circle cx="11" cy="11" r="8"/>
                                    <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <h3 class="flt-empty-title">لم نجد أي نتائج مطابقة لعبارة البحث</h3>
                            <p class="flt-empty-sub">تأكد من كتابة الكود بشكل صحيح بدون مسافات زائدة، أو استخدم كلمات بحث مختلفة أو أرقام أكثر عمومية للوصول للسجلات المطلوبة.</p>
                            <button type="button" class="flt-empty-reset-btn" @onclick="Clear">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                مسح حقل البحث والبدء من جديد
                            </button>
                        </div>
                    }
                    else
                    {
                        @foreach (var g in Grouped)
                        {
                            <div class="search-group-card">
                                <div class="search-group-header">
                                    <span class="search-group-icon">
                                        @((MarkupString)IconOf(g.Key))
                                    </span>
                                    <span class="search-group-title">@g.Key</span>
                                    <span class="search-group-count">@g.Count()</span>
                                </div>

                                <div class="pay-table-wrap">
                                    <table class="pay-table" aria-label="جدول نتائج مجموعة @g.Key">
                                        <thead>
                                            <tr>
                                                <th class="th-start" style="width:180px">الرقم المرجعي</th>
                                                <th class="th-start">اسم السجل / البيان</th>
                                                <th class="th-start">المعلومات الإضافية</th>
                                                <th style="width:100px">تفاصيل</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in g)
                                            {
                                                <tr>
                                                    <td class="td-start">
                                                        <span class="pay-code-chip font-mono">@r.Code</span>
                                                    </td>
                                                    <td class="td-start">
                                                        <div class="pay-pay-info">
                                                            <div class="pay-customer-name">@r.Title</div>
                                                            @if (!string.IsNullOrWhiteSpace(r.Badge))
                                                            {
                                                                <span class="search-badge-tag">@r.Badge</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="td-start td-muted font-weight-medium">
                                                        @(string.IsNullOrWhiteSpace(r.Subtitle) ? "—" : r.Subtitle)
                                                    </td>
                                                    <td>
                                                        <div class="pay-actions">
                                                            <button type="button" class="pay-act-btn act-info" @onclick="() => Open(r)" title="فتح ومعاينة السجل المالي">
                                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <circle cx="12" cy="12" r="10"/>
                                                                    <polyline points="12 16 12 12 8 12"/>
                                                                    <line x1="12" y1="8" x2="12.01" y2="8"/>
                                                                </svg>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                @* ── Empty State الفاخر والمطور الترحيبي عند فتح الشاشة لأول مرة ── *@
                <div class="flt-empty-state-box initial-state">
                    <div class="flt-empty-glow initial-glow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.6">
                            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <h3 class="flt-empty-title">جاهز للبحث الفوري</h3>
                    <p class="flt-empty-sub">اكتب الاسم، الكود، رقم المعاملة، الفاتورة أو لوحة الشاحنة في الصندوق بالأعلى للوصول المباشر لكافة السجلات التشغيلية والمالية بدقة.</p>
                </div>
            }

        </div>
    }
</div>

@* ── CSS STYLES ── *@
<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  --fc-amber-lt;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ── Hero ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px; margin: 0 auto; width: 100%;
        box-sizing: border-box; position: relative; z-index: 1;
    }
    .hero-wrapper .fc-hero {
        border-radius: 20px !important; overflow: hidden;
        box-shadow: 0 12px 32px rgba(13,38,84,.15), 0 4px 12px rgba(13,38,84,.08);
        border: 1px solid rgba(255,255,255,.08);
    }
    .hero-wrapper .fc-hero.fc-hero-slim { padding-top: 18px !important; padding-bottom: 22px !important; }

    .pay-hero-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 6px; }
    .pay-hero-left { flex: 1; min-width: 200px; }
    .pay-hero-crumb { display: flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.55); margin-bottom: 2px; }
    .pay-hero-sub { font-size: 13px; color: rgba(255,255,255,.55); }
    .pay-hero-right { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .pay-hero-chip { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: 8px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: rgba(255,255,255,.7); font-size: 10.5px; font-weight: 700; white-space: nowrap; }

    .si-hero-refresh {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.75); cursor: pointer; transition: background .15s;
    }
    .si-hero-refresh:hover { background: rgba(255, 255, 255, 0.14); }

    /* ── KPIs Glass Strip ── */
    .pay-kpis-strip {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px); margin-top: 14px;
    }
    .pay-kpi-item { flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px 16px; }
    .pay-kpi-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }
    .pay-kpi-icon {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
    }
    .kpi-blue  { background: rgba(30,110,245,.2); color: #93c5fd; }
    .kpi-amber { background: rgba(234,179,8,.2);  color: #fde68a; }
    .kpi-red   { background: rgba(239,68,68,.2);  color: #fca5a5; }
    .kpi-green { background: rgba(34,197,94,.2);  color: #86efac; }

    .pay-kpi-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
    .pay-kpi-val { font-size: 15px; font-weight: 900; color: #fff; margin-top: 2px; }
    .pay-kpi-val small { font-size: 10px; font-weight: 600; opacity: .7; }
    .kpi-val-amber { color: #fde68a; }
    .kpi-val-red   { color: #fca5a5; }
    .kpi-val-green { color: #86efac; }

    /* ── Body ── */
    .pay-body {
        background: var(--fc-bg); min-height: calc(100vh - 180px);
        padding: 18px clamp(16px, 3vw, 40px) 96px;
        max-width: 1440px; width: 100%; margin: 0 auto;
        box-sizing: border-box; position: relative; z-index: 2;
        display: flex; flex-direction: column; gap: 14px;
    }
    .fc-overlap { position: relative; z-index: 2; }
    .pay-card { background: var(--fc-card); border: 1px solid var(--fc-border); border-radius: var(--fc-radius); box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06); overflow: hidden; }

    .pay-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px; background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center; box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .pay-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .pay-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .pay-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .pay-state-box p { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* ── Search Container Box ── */
    .search-section-box { padding: 24px; border-bottom: 1px solid #edf1f7; }
    .search-section-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 18px; }
    .search-n-badge {
        width: 38px; height: 38px; flex: 0 0 38px; border-radius: 10px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; font-weight: 900;
    }
    .search-section-title { font-size: 14.5px; font-weight: 800; color: var(--fc-text); }
    .search-section-sub { font-size: 11px; font-weight: 500; color: var(--fc-muted); margin-top: 3px; }

    .search-input-container { display: flex; gap: 12px; align-items: center; width: 100%; max-width: 820px; }
    .search-field-wrapper { position: relative; display: flex; align-items: center; flex: 1; }
    .search-prefix-icon { position: absolute; right: 14px; color: #9aaabb; pointer-events: none; }
    .search-input-field {
        width: 100%; height: 46px; padding: 0 42px 0 12px; border: 1.5px solid #d8e2f0; border-radius: 10px;
        background: #fafcff; color: var(--fc-text); font-family: inherit; font-size: 13.5px; outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .search-input-field:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); background: #fff; }
    .search-clear-btn { position: absolute; left: 12px; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; border: none; background: #edf1f7; color: #8899ae; cursor: pointer; }
    .search-clear-btn:hover { background: #dde3ed; }

    .search-submit-btn {
        height: 46px; padding: 0 24px; border: none; border-radius: 10px;
        background: linear-gradient(135deg, var(--fc-blue), #155cd0); color: #fff;
        font-family: inherit; font-size: 13px; font-weight: 800; cursor: pointer;
        display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(30,110,245,.25);
        transition: all .15s ease;
    }
    .search-submit-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(30,110,245,.3); }
    .search-submit-btn:disabled { opacity: .6; cursor: not-allowed; }

    .search-denied-alert {
        display: inline-flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 9px;
        background: var(--fc-red-lt); border: 1px solid #ffc8cf; color: var(--fc-red);
        font-size: 11.5px; font-weight: 600; margin-top: 14px;
    }
    .search-denied-alert span { color: #526070; }

    .search-error-banner {
        display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 9px;
        background: var(--fc-red-lt); border: 1px solid #ffc8cf; color: var(--fc-red);
        font-size: 12px; font-weight: 600; margin-top: 14px;
    }

    /* ── Search Results Area ── */
    .search-results-section { padding: 24px; }
    .search-group-card {
        background: #fff; border: 1px solid #e4edf8; border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15,41,82,.03); margin-top: 18px; overflow: hidden;
    }
    .search-group-header {
        display: flex; align-items: center; gap: 10px; padding: 12px 16px;
        background: linear-gradient(180deg, #f8fafd, #f2f5fb); border-bottom: 1.5px solid #e4eaf3;
    }
    .search-group-icon {
        width: 28px; height: 28px; border-radius: 7px;
