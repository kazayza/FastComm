    [Parameter, SupplyParameterFromQuery(Name = "id")]     
    public string? LegacyId { get; set; }
    
    [Parameter, SupplyParameterFromQuery(Name = "from")]   
    public string? LegacyFrom { get; set; }

    private string _q = "";
    private string _lastQ = "";
    private bool _busy, _searched;
    private string? _err;
    private bool _loading;

    private List<SearchResult> _res = new();
    private List<string> _searchable = new();
    private List<string> _denied = new();

    private static readonly string[] Order =
        {
            "عميل", "حجز", "عملية", "رحلة", "حاوية", "فاتورة", "سيارة",
            "سائق", "مورد", "موظف", "عهدة", "مصروف", "تحصيل", "فاتورة مورد", "صيانة", "مقطورة"
        };

    private static readonly Dictionary<string, string> Routes = new(StringComparer.Ordinal)
    {
        ["عميل"]   = "/customers",
        ["حجز"]    = "/bookings",
        ["عملية"]  = "/operations",
        ["فاتورة"] = "/invoices",
        ["رحلة"]   = "/trips",
        ["حاوية"]  = "/containers",
        ["سيارة"]  = "/vehicles",
        ["سائق"]   = "/drivers",
        ["مورد"]   = "/suppliers",
        ["مصروف"]  = "/expenses",
        ["عهدة"]   = "/custodies",
        ["موظف"]   = "/employees",
        ["تحصيل"]  = "/payments",
        ["فاتورة مورد"] = "/supplier-invoices",
        ["صيانة"]  = "/maintenance",
        ["مقطورة"] = "/vehicles",
    };

    private static string NormalizeArabic(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        string[] diacritics = new[] { "َ", "ُ", "ِ", "ّ", "ً", "ٌ", "ٍ", "ْ", "ـ" };
        foreach (var d in diacritics) s = s.Replace(d, "");
        return s
            .Replace('أ', 'ا').Replace('إ', 'ا').Replace('آ', 'ا').Replace('ٱ', 'ا').Replace('ء', 'ا')
            .Replace('ة', 'ه').Replace('ى', 'ي').Replace('ؤ', 'و').Replace('ئ', 'ي')
            .Replace("  ", " ").ToLowerInvariant().Trim();
    }

    private IEnumerable<IGrouping<string, SearchResult>> Grouped =>
        _res.GroupBy(r => r.Entity)
            .OrderBy(g =>
            {
                var i = Array.IndexOf(Order, g.Key);
                return i < 0 ? int.MaxValue : i;
            })
            .ThenBy(g => g.Key);

    private bool CanView => true;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(LegacyEntity))
        {
            if (Routes.TryGetValue(LegacyEntity, out var route))
            {
                var focus = string.IsNullOrWhiteSpace(LegacyFrom) ? "" : $"?focus={Uri.EscapeDataString(LegacyFrom)}";
                Nav.NavigateTo(route + focus, replace: true);
                return;
            }
            _q = LegacyFrom ?? "";
            _lastQ = _q;
            _searched = true;
            _err = $"ليست هناك صفحة مخصصة للوحدة «{LegacyEntity}» حالياً في النظام.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(Q))
        {
            _q = Q;
            await RunAsync(_q);
        }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        _q = e.Value?.ToString() ?? "";
        if (_q.Trim().Length >= 2) await RunAsync(_q);
        else if (_q.Trim().Length == 0) { _res = new(); _searched = false; }
    }

    private async Task Reload()
    {
        if (!string.IsNullOrWhiteSpace(_q)) await RunAsync(_q);
    }

    private async Task RunAsync(string term)
    {
        var t = term.Trim();
        if (t.Length < 2)
        {
            _err = "يرجى كتابة حرفين على الأقل لبدء الفحص والبحث";
            return;
        }

        _busy = true; _err = null; _searched = true; _lastQ = t;
        try
        {
            var url = $"api/search?q={Uri.EscapeDataString(t)}&take=50";
            var res = await Http.GetAsync(url);
            var body = await res.Content.ReadAsStringAsync();

            if (!res.IsSuccessStatusCode)
            {
                _err = $"تعذر الاستجابة من السيرفر كود الخطأ: {(int)res.StatusCode}";
                _res = new();
                return;
            }
            if (string.IsNullOrWhiteSpace(body) || body.TrimStart().StartsWith("<"))
            {
                _err = "السيرفر أعاد صفحة غير متوقعة، يرجى التأكد من استجابة النظام الخلفي.";
                _res = new();
                return;
            }

            var r = System.Text.Json.JsonSerializer.Deserialize<SearchResponse>(body, JsonOpts);
            _res        = r?.Results ?? new();
            _searchable = r?.SearchableIn ?? new();
            _denied     = r?.DeniedEntities ?? new();

            if (!string.IsNullOrWhiteSpace(r?.Error)) _err = r!.Error;
        }
        catch (Exception ex)
        {
            _err = "فشل إجراء عملية التحري والبحث الموحد: " + ex.Message;
            _res = new();
        }
        finally { _busy = false; }
    }

    private void Clear()
    {
        _q = ""; _lastQ = ""; _res = new(); _searched = false; _err = null;
    }

    private void Open(SearchResult r)
    {
        if (Routes.TryGetValue(r.Entity, out var route))
        {
            Nav.NavigateTo($"{route}?focus={Uri.EscapeDataString(r.Code)}");
        }
        else
        {
            Snackbar.Add($"لا توجد شاشة عرض وتفاصيل مخصصة لوحدة «{r.Entity}» حالياً في النظام", Severity.Warning);
        }
    }

