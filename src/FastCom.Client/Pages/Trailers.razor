@page "/trailers"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>المقطورات — فاست كوم</PageTitle>

<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">الأسطول</div>
                <h1 class="fc-hero-title">المقطورات</h1>
                <p class="fc-hero-sub">المقطورات المتاحة للرحلات — اللوحة والمقاس والملكية والحالة</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث" OnClick="Reload" Style="color:#9FB4CC" />
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="GoNew">مقطورة جديدة</MudButton>
                }
            </div>
        </div>
        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.LocalShipping" /></div>
                    <div><div class="fc-kpi-num">@_items.Count</div><div class="fc-kpi-lb">إجمالي المقطورات</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(t => t.Status == "Available")</div><div class="fc-kpi-lb">متاحة</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.DirectionsCar" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(t => t.Status == "InTrip")</div><div class="fc-kpi-lb">في رحلة</div></div></div>
                <div class="fc-kpi"><div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Build" /></div>
                    <div><div class="fc-kpi-num">@_items.Count(t => t.Status == "Maintenance")</div><div class="fc-kpi-lb">صيانة</div></div></div>
            </div>
        }
    </div>
</div>

<div class="fc-page">
    @if (!CanView)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">ليس لديك صلاحية عرض المقطورات.</MudAlert>
    }
    else
    {
        <div class="fc-overlap"><div class="fc-card">
            <div class="fc-toolbar">
                <div class="fc-filters">
                    <button class='@TabClass("all")' @onclick='() => _tab = "all"'>الكل</button>
                    <button class='@TabClass("Available")' @onclick='() => _tab = "Available"'>متاحة</button>
                    <button class='@TabClass("InTrip")' @onclick='() => _tab = "InTrip"'>في رحلة</button>
                    <button class='@TabClass("Maintenance")' @onclick='() => _tab = "Maintenance"'>صيانة</button>
                    <button class='@TabClass("OutOfService")' @onclick='() => _tab = "OutOfService"'>خارج الخدمة</button>
                </div>
                <MudTextField T="string" Value="_search" ValueChanged="v => _search = v"
                              Placeholder="ابحث بالكود أو اللوحة أو النوع..." Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="fc-search-box" Immediate="true" />
                <span class="fc-count">عرض @Filtered.Count() من @_items.Count</span>
            </div>
            @if (_loading)
            {
                <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else
            {
                <div class="fc-table-wrap"><table class="fc-table fc-table-pro">
                    <thead><tr><th>الكود</th><th>رقم اللوحة</th><th>النوع</th><th>المقاس</th>
                        <th>الملكية</th><th>الحالة</th>
                        @if (CanEdit) { <th style="width:130px; text-align:left">إجراءات</th> }</tr></thead>
                    <tbody>
                        @foreach (var t in Filtered)
                        {
                            <tr>
                                <td><span class="fc-role-chip">@t.TrailerCode</span></td>
                                <td><div class="fc-cell-main">@(string.IsNullOrWhiteSpace(t.PlateNumber) ? "بدون لوحة" : t.PlateNumber)</div></td>
                                <td>@t.TrailerType</td>
                                <td class="fc-cell-sub">@SizeAr(t.SizeFeet)</td>
                                <td><span class="@OwnerCls(t.OwnershipType)">@OwnerAr(t.OwnershipType)</span></td>
                                <td><span class="@StatusCls(t.Status)">@StatusAr(t.Status)</span></td>
                                @if (CanEdit)
                                {
                                    <td><div class="fc-row-actions">
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => GoEdit(t)" />
                                        @if (CanDelete)
                                        {
                                            @if (_confirmId == t.TrailerId)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => Delete(t)">متأكد؟</MudButton>
                                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" OnClick="() => _confirmId = null" />
                                            }
                                            else
                                            {
                                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => _confirmId = t.TrailerId" />
                                            }
                                        }
                                    </div></td>
                                }
                            </tr>
                        }
                        @if (!Filtered.Any())
                        {
                            <tr><td colspan="7"><div class="fc-empty"><div>لايوجد مقطورات مطابقة</div></div></td></tr>
                        }
                    </tbody>
                </table></div>
            }
        </div></div>
    }
</div>

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("FLEET.VIEW") ?? false;
    private bool CanCreate => _user?.Can("FLEET.CREATE") ?? false;
    private bool CanEdit   => _user?.Can("FLEET.EDIT") ?? false;
    private bool CanDelete => _user?.Can("FLEET.DELETE") ?? false;

    private bool _loading = true;
    private string _search = "";
    private string _tab = "all";
    private int? _confirmId;
    private List<Item> _items = new();

    public class Item
    {
        public int TrailerId { get; set; }
        public string TrailerCode { get; set; } = "";
        public string? PlateNumber { get; set; }
        public string TrailerType { get; set; } = "";
        public byte? SizeFeet { get; set; }
        public string OwnershipType { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private IEnumerable<Item> Filtered => _items
        .Where(t => _tab == "all" || t.Status == _tab)
        .Where(t => string.IsNullOrWhiteSpace(_search)
                 || t.TrailerCode.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || (t.PlateNumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || t.TrailerType.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
        else _loading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/fleet/trailers") ?? new(); }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task Reload() { await LoadAsync(); Snackbar.Add("اتحدّث", Severity.Info); }
    private void GoNew() => Nav.NavigateTo("/trailers/new");
    private void GoEdit(Item t) => Nav.NavigateTo($"/trailers/new/{t.TrailerId}");

    private async Task Delete(Item t)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/fleet/trailers/{t.TrailerId}");
            var m = await MsgOf(res);
            Snackbar.Add(m, res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    /* ── تنسيق — أي `"` جوه attribute لازم يطلع helper (RZ1010) ── */
    private string TabClass(string k) => _tab == k ? "fc-filter on" : "fc-filter";

    private static string SizeAr(byte? f) => f is null ? "—" : f.Value + " قدم";

    private static string StatusAr(string s) => s switch
    {
        "Available"    => "متاحة",
        "InTrip"       => "في رحلة",
        "Maintenance"  => "صيانة",
        "OutOfService" => "خارج الخدمة",
        _              => s
    };

    private static string StatusCls(string s) => s switch
    {
        "Available"    => "fc-chip-ok",
        "InTrip"       => "fc-chip-blue",
        "Maintenance"  => "fc-chip-warn",
        "OutOfService" => "fc-chip-gray",
        _              => "fc-chip-gray"
    };

    private static string OwnerAr(string o) => o == "External" ? "خارجي" : "شركة";
    private static string OwnerCls(string o) => o == "External" ? "fc-chip-gold" : "fc-chip-gray";

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}
