                    <div class="tr-mfield">
                        <label class="tr-mlabel">
                            الخزينة <span class="tr-mrequired">*</span>
                        </label>
                        <div class="tr-mselect-wrap">
                            <svg class="tr-msel-icon" viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="2" y="7" width="20" height="14" rx="2"/>
                                <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            </svg>
                            <select class="tr-minput tr-msel"
                                    value="@_pf.CashBoxId"
                                    @onchange="e => _pf.CashBoxId = ParseInt(e.Value)"
                                    aria-required="true">
                                <option value="0">— اختر الخزينة —</option>
                                @foreach (var b in _boxes)
                                {
                                    <option value="@b.CashBoxId">@b.NameAr (@Money(b.CurrentBalance))</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="tr-mfield">
                        <label class="tr-mlabel">
                            المبلغ <span class="tr-mrequired">*</span>
                        </label>
                        <div class="tr-mfield-group">
                            <span class="tr-mprefix" aria-hidden="true">ج.م</span>
                            <input type="number" min="0.01" step="0.01"
                                   class="tr-minput with-prefix"
                                   value="@_pf.Amount"
                                   placeholder="0.00"
                                   @onchange="e => _pf.Amount = ParseDec(e.Value)" />
                        </div>
                    </div>

                    <div class="tr-mfield">
                        <label class="tr-mlabel">التاريخ</label>
                        <div class="tr-mfield-group">
                            <span class="tr-mprefix" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="13" height="13"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <path d="M12 6v6l4 2" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <input type="datetime-local" class="tr-minput with-prefix"
                                   value="@_pf.TxDate"
                                   @onchange="e => _pf.TxDate = e.Value?.ToString()" />
                        </div>
                    </div>

                    <div class="tr-mfield">
                        <label class="tr-mlabel">طريقة الدفع</label>
                        <div class="tr-mselect-wrap">
                            <svg class="tr-msel-icon" viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="1" y="4" width="22" height="16" rx="2"/>
                                <path d="M1 10h22"/>
                            </svg>
                            <select class="tr-minput tr-msel"
                                    value="@_pf.PaymentMethodId"
                                    @onchange="e => _pf.PaymentMethodId = ParseInt(e.Value)">
                                <option value="0">—</option>
                                @foreach (var m in _methods)
                                {
                                    <option value="@m.Id">@m.Label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="tr-mfield">
                        <label class="tr-mlabel">
                            @(_pf.Type == "Receipt" ? "العميل" : "العميل (اختياري)")
                            @if (_pf.Type == "Receipt")
                            {
                                <span class="tr-mrequired">*</span>
                            }
                        </label>
                        <div class="tr-mselect-wrap">
                            <svg class="tr-msel-icon" viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            <select class="tr-minput tr-msel"
                                    value="@_pf.CustomerId"
                                    @onchange="OnCustomerChanged">
                                <option value="0">—</option>
                                @foreach (var c in _customers)
                                {
                                    <option value="@c.Id">@c.Label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="tr-mfield">
                        <label class="tr-mlabel">المورد</label>
                        <div class="tr-mselect-wrap">
                            <svg class="tr-msel-icon" viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                <path d="M9 22V12h6v10"/>
                            </svg>
                            <select class="tr-minput tr-msel"
                                    value="@_pf.SupplierId"
                                    @onchange="e => _pf.SupplierId = ParseInt(e.Value)">
                                <option value="0">—</option>
                                @foreach (var s in _suppliers)
                                {
                                    <option value="@s.Id">@s.Label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="tr-mfield">
                        <label class="tr-mlabel">فاتورة مرتبطة</label>
                        @if (_pf.CustomerId > 0 && _openInvoices.Any())
                        {
                            <div class="tr-mselect-wrap">
                                <svg class="tr-msel-icon" viewBox="0 0 24 24" width="14" height="14"
                                     fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round"/>
                                </svg>
                                <select class="tr-minput tr-msel"
                                        value="@_pf.InvoiceId"
                                        @onchange="e => _pf.InvoiceId = ParseLong(e.Value)">
                                    <option value="0">—</option>
                                    @foreach (var i in _openInvoices)
                                    {
                                        <option value="@i.InvoiceId">
                                            @i.InvoiceNumber — متبقي @Money(i.Due)
                                        </option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="tr-field-hint">
                                <svg viewBox="0 0 16 16" width="10" height="10"
                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <circle cx="8" cy="8" r="6"/>
                                    <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                                </svg>
                                اختار العميل الأول
                            </div>
                        }
                    </div>

                    <div class="tr-mfield">
                        <label class="tr-mlabel">المرجع</label>
                        <input class="tr-minput"
                               value="@_pf.ReferenceNumber"
                               maxlength="100"
                               placeholder="رقم مرجعي..."
                               @onchange="e => _pf.ReferenceNumber = e.Value?.ToString()" />
                    </div>

                    <div class="tr-mfield tr-mfield-full">
                        <label class="tr-mlabel">البيان</label>
                        <input class="tr-minput"
                               value="@_pf.Description"
                               maxlength="500"
                               placeholder="وصف الحركة..."
                               @onchange="e => _pf.Description = e.Value?.ToString()" />
                    </div>

                </div>

            </div>

            <div class="tr-modal-foot">
                <button class="tr-modal-cancel" @onclick="ClosePost">إلغاء</button>
                <button class="tr-modal-save @(_pf.Type == "Receipt" ? "save-green" : "save-red")"
                        @onclick="SavePost"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <circle cx="12" cy="14" r="2"/>
                        </svg>
                        <span>تسجيل الحركة</span>
                    }
                </button>
            </div>

        </div>
    </div>
}


