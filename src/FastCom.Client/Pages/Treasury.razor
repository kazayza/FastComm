                            <span class="tr-mprefix" aria-hidden="true">ج.م</span>
                            <input type="number" min="0.01" step="0.01"
                                   class="tr-minput with-prefix"
                                   value="@_tf.Amount"
                                   placeholder="0.00"
                                   @onchange="e => _tf.Amount = ParseDec(e.Value)" />
