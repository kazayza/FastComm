@* ══════════════ FAB — الإجراءات السريعة ══════════════ *@
@if (CanView && (CanPost || CanTransfer || CanManage))
{
    <div class="fc-fab-container">
        <div class="fc-fab-menu @(_fabOpen ? "is-open" : "")">
            @if (CanManage)
            {
                <a class="fc-fab-item" href="/treasury/boxes/new" @onclick="() => _fabOpen = false">
                    <span class="fc-fab-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <circle cx="12" cy="14" r="2"/>
                        </svg>
                    </span>
                    <span class="fc-fab-label">خزينة جديدة</span>
                </a>
            }
            @if (CanTransfer)
            {
                <button class="fc-fab-item" @onclick="() => { _fabOpen = false; OpenTransfer(); }">
                    <span class="fc-fab-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M17 1l4 4-4 4"/>
                            <path d="M3 11V9a4 4 0 014-4h14"/>
                            <path d="M7 23l-4-4 4-4"/>
                            <path d="M21 13v2a4 4 0 01-4 4H3"/>
                        </svg>
                    </span>
                    <span class="fc-fab-label">تحويل بين خزينتين</span>
                </button>
            }
            @if (CanPost)
            {
                <button class="fc-fab-item" @onclick="() => { _fabOpen = false; OpenPost(); }">
                    <span class="fc-fab-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="2" y="5" width="20" height="14" rx="2"/>
                            <path d="M2 10h20"/>
                        </svg>
                    </span>
                    <span class="fc-fab-label">حركة جديدة</span>
                </button>
            }
        </div>
        <button class="fc-fab-main @(_fabOpen ? "is-open" : "")"
                @onclick="() => _fabOpen = !_fabOpen"
                aria-label="إجراءات سريعة" aria-expanded="@_fabOpen">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none"
                 stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
}

@* ══════════════ مودال تسوية خزينة ══════════════ *@
@if (_settleTarget is not null)
{
    <div class="tr-modal-backdrop" @onclick="() => _settleTarget = null"
         role="dialog" aria-modal="true" aria-label="تسوية خزينة">
        <div class="tr-modal" @onclick:stopPropagation="true">
            <div class="tr-modal-head">
                <div class="tr-modal-icon icon-red" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0110 0v4"/>
                    </svg>
                </div>
                <div style="flex:1; min-width:0">
                    <div class="tr-modal-title">تسوية وإقفال @_settleTarget.NameAr</div>
                    <div class="tr-modal-sub">الرصيد هيتحوّل كامل للخزينة الرئيسية (@_defaultBoxCode)</div>
                </div>
            </div>
            <div class="tr-modal-body">
                <div class="tr-settle-box">
                    <div class="tr-settle-label">رصيد الخزينة الحالي</div>
                    <div class="tr-settle-amount @(_settleTarget.CurrentBalance >= 0 ? "bal-pos" : "bal-neg")">
                        @Money(_settleTarget.CurrentBalance) @_settleTarget.CurrencyCode
                    </div>
                </div>
                <p class="tr-settle-note">
                    الحركات والأرشيف هيفضلوا محفوظين — وممكن تعيد فتح الخزينة في أي وقت برصيد افتتاحي جديد.
                </p>
            </div>
            <div class="tr-modal-foot">
                <button class="tr-modal-cancel" @onclick="() => _settleTarget = null">تراجع</button>
                <button class="tr-modal-save save-red" @onclick="DoSettle" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري التسوية...</span>
                    }
                    else
                    {
                        <span>تسوية وإقفال</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ══════════════ مودال إعادة فتح خزينة ══════════════ *@
@if (_reopenTarget is not null)
{
    <div class="tr-modal-backdrop" @onclick="() => _reopenTarget = null"
         role="dialog" aria-modal="true" aria-label="إعادة فتح خزينة">
        <div class="tr-modal" @onclick:stopPropagation="true">
            <div class="tr-modal-head">
                <div class="tr-modal-icon icon-green" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 019.9-1"/>
                    </svg>
                </div>
                <div style="flex:1; min-width:0">
                    <div class="tr-modal-title">إعادة فتح @_reopenTarget.NameAr</div>
                    <div class="tr-modal-sub">الرصيد = الافتتاحي + الحركات السارية</div>
                </div>
            </div>
            <div class="tr-modal-body">
                <div class="tr-mfield">
                    <label class="tr-mlabel">الرصيد الافتتاحي الجديد</label>
                    <input type="number" min="0" step="0.01" class="tr-minput"
                           value="@_reopenOpening"
                           @onchange="e => _reopenOpening = ParseDec(e.Value)" />
                    <div class="fc-field-hint">الفلوس اللي هتتحط في الدرج كبداية</div>
                </div>
            </div>
            <div class="tr-modal-foot">
                <button class="tr-modal-cancel" @onclick="() => _reopenTarget = null">تراجع</button>
                <button class="tr-modal-save save-green" @onclick="DoReopen" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="btn-spinner sm" aria-hidden="true"></span>
                        <span>جاري الفتح...</span>
                    }
                    else
                    {
                        <span>إعادة فتح</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>

    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ================================================================
       BODY
    ================================================================ */
    .tr-body {
        background: var(--fc-bg);
        min-height: calc(100vh - 200px);
        padding: 16px 20px 32px;
        max-width: 1400px; width: 100%;
        margin: 0 auto;
        display: flex; flex-direction: column; gap: 14px;
    }

    /* State */
    .tr-state-box {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 300px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius); padding: 40px; text-align: center;
        box-shadow: 0 4px 20px rgba(15,41,82,.06);
    }
    .tr-state-icon { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .tr-state-icon.perm { background: #fff0f2; color: var(--fc-red); }
    .tr-state-box h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--fc-text); }
    .tr-state-box p  { margin: 0; font-size: 13px; color: var(--fc-muted); }

    /* ================================================================
       BOX CARDS
    ================================================================ */
    .tr-boxes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 12px;
    }

    .tr-box-card {
        display: flex; align-items: center; gap: 14px;
        padding: 16px 18px; border-radius: 14px;
        background: var(--fc-card); border: 1px solid var(--fc-border);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 6px 18px rgba(15,41,82,.05);
        transition: all .18s ease;
    }
    .tr-box-card:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(15,41,82,.08); }

    .tr-box-icon {
        width: 46px; height: 46px; flex: 0 0 46px; border-radius: 13px;
        display: flex; align-items: center; justify-content: center;
        background: var(--fc-amber-lt); color: #9a6d08;
        border: 1px solid #f0d898;
    }

    .tr-box-info { flex: 1; min-width: 0; }
    .tr-box-name { font-size: 13px; font-weight: 800; color: #1c2b43; }
    .tr-box-code { font-size: 10px; color: #9aaabb; font-weight: 600; margin-top: 2px; }

    .tr-box-balance { text-align: center; flex: 0 0 auto; }
    .tr-box-amount {
        font-family: "Inter", Arial, sans-serif;
        font-size: 17px; font-weight: 900;
    }
    .bal-pos { color: var(--fc-green); }
    .bal-neg { color: var(--fc-red); }
    .tr-box-currency { font-size: 9px; color: #9aaabb; font-weight: 600; text-align: center; margin-top: 2px; }

    /* ================================================================
       MAIN CARD
    ================================================================ */
    .tr-card {
        background: var(--fc-card); border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: 0 2px 6px rgba(15,41,82,.04), 0 10px 30px rgba(15,41,82,.06);
        overflow: hidden;
    }

    /* ================================================================
       TOOLBAR
    ================================================================ */
    .tr-toolbar {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 18px;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7; flex-wrap: wrap;
    }

    .tr-search-wrap {
        position: relative; display: flex; align-items: center;
        flex: 1; min-width: 180px; max-width: 320px;
    }
    .tr-search-icon { position: absolute; right: 12px; color: #9aaabb; pointer-events: none; }
    .tr-search-input {
        width: 100%; height: 36px; padding: 0 34px 0 10px;
        border: 1px solid #d8e2f0; border-radius: 8px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 12px; outline: none;
        transition: border-color .15s ease;
    }
    .tr-search-input:focus { border-color: var(--fc-blue); }
    .tr-search-input::placeholder { color: #b0bcc8; }
    .tr-search-clear {
        position: absolute; left: 8px;
        display: flex; align-items: center; justify-content: center;
        width: 20px; height: 20px; border-radius: 50%;
        border: none; background: #edf1f7; color: #8899ae; cursor: pointer;
    }

    .tr-box-filter-wrap {
        position: relative; display: flex; align-items: center;
        min-width: 140px; max-width: 180px;
    }
    .tr-box-icon-sel { position: absolute; right: 10px; color: #9aaabb; pointer-events: none; z-index: 1; }
    .tr-box-select {
        width: 100%; height: 36px; padding: 0 30px 0 8px;
        border: 1px solid #d8e2f0; border-radius: 8px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 11px; outline: none; cursor: pointer;
        -webkit-appearance: none; appearance: none;
        transition: border-color .15s ease;
    }
    .tr-box-select:focus { border-color: var(--fc-blue); }

    .tr-date-range { display: flex; align-items: center; gap: 6px; }
    .tr-date-field { display: flex; align-items: center; gap: 5px; }
    .tr-date-input {
        height: 36px; padding: 0 8px;
        border: 1px solid #d8e2f0; border-radius: 8px;
        background: #fafcff; color: var(--fc-text);
        font-family: inherit; font-size: 11px; outline: none;
        transition: border-color .15s ease; max-width: 140px;
    }
    .tr-date-input:focus { border-color: var(--fc-blue); }
    .tr-date-sep { color: #c0ccd8; font-weight: 700; }

    .tr-apply-btn {
        display: flex; align-items: center; justify-content: center;
        width: 34px; height: 34px;
        border: 1px solid var(--fc-blue); border-radius: 8px;
        background: var(--fc-blue-lt); color: var(--fc-blue);
        cursor: pointer; transition: all .12s ease; flex-shrink: 0;
    }
    .tr-apply-btn:hover { background: var(--fc-blue); color: #fff; }

    .tr-results-badge {
        display: flex; align-items: center; gap: 5px;
        margin-right: auto; font-size: 10.5px; color: #8899ae; font-weight: 600; white-space: nowrap;
    }
    .tr-results-badge strong { color: #5a6e88; }

    /* ================================================================
       STATUS TABS
    ================================================================ */
    .tr-status-bar {
        padding: 10px 18px; background: #f9fafd;
        border-bottom: 1px solid #edf1f7; overflow-x: auto;
    }

    .tr-status-tabs {
        display: flex; gap: 3px; padding: 3px;
        border-radius: 10px; background: #f0f3f8; width: fit-content;
    }

    .tr-status-tab {
        display: flex; align-items: center; gap: 5px;
        height: 30px; padding: 0 9px;
        border: none; border-radius: 7px;
        background: transparent; color: #6b7d95;
        font-family: inherit; font-size: 10.5px; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: all .15s ease;
    }
    .tr-status-tab:hover:not(.active) { color: var(--fc-text); background: rgba(255,255,255,.6); }
    .tr-status-tab.active {
        background: var(--fc-card); color: var(--fc-text);
        box-shadow: 0 1px 4px rgba(15,41,82,.10); font-weight: 800;
    }

    .tr-tab-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 7px; }

    .tr-tab-count {
        min-width: 15px; height: 15px; border-radius: 4px; padding: 0 3px;
        display: flex; align-items: center; justify-content: center;
        font-size: 9px; font-weight: 900; font-family: "Inter", Arial, sans-serif;
    }
    .tr-status-tab.active .tr-tab-count { background: var(--fc-blue-lt); color: var(--fc-blue); }
    .tr-status-tab:not(.active) .tr-tab-count { background: #e4eaf3; color: #8899ae; }

    /* Tab Dot Colors */
    .tdot-all  { background: var(--fc-blue); }
    .tdot-in   { background: var(--fc-green); }
    .tdot-out  { background: var(--fc-red); }
    .tdot-tin  { background: var(--fc-blue); }
    .tdot-tout { background: var(--fc-purple); }
    .tdot-void { background: #9aaabb; }

    /* ================================================================
       LOADING / EMPTY
    ================================================================ */
    .tr-loading {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 12px; min-height: 200px; color: var(--fc-muted); font-size: 12px; font-weight: 600;
    }
    .tr-spinner {
        width: 32px; height: 32px;
        border: 3px solid #dde5f0; border-top-color: var(--fc-blue);
        border-radius: 50%; animation: tr-spin .75s linear infinite;
    }
    @@keyframes tr-spin { to { transform: rotate(360deg); } }

    .tr-empty {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 10px; min-height: 200px; padding: 40px; text-align: center;
    }
    .tr-empty-icon { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f4fa; color: #b0c4d8; }
    .tr-empty-title { font-size: 15px; font-weight: 800; color: var(--fc-text); }
    .tr-empty-sub   { font-size: 12px; color: var(--fc-muted); }

    /* ================================================================
       TABLE
    ================================================================ */
    .tr-table-wrap { overflow-x: auto; }
    .tr-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }

    .tr-table thead th {
        padding: 10px 12px;
        background: linear-gradient(180deg, #f7f9fc, #f0f3f8);
        color: #4a5a74; font-size: 10.5px; font-weight: 800;
        text-align: center; border-bottom: 2px solid #e4eaf3;
        white-space: nowrap; position: sticky; top: 0; z-index: 1;
    }
    .tr-table .th-start { text-align: right; }

    .tr-table tbody tr { border-bottom: 1px solid #f0f3f8; transition: background .12s ease; }
    .tr-table tbody tr:last-child { border-bottom: none; }
    .tr-table tbody tr:hover { background: #fafcff; }
    .tr-table tbody tr.row-void { opacity: .55; }

    .tr-table tbody td { padding: 10px 12px; color: #526070; text-align: center; vertical-align: middle; }
    .td-start { text-align: right !important; }
    .td-muted  { color: #8899ae; font-size: 11px; }

    /* TX Cell */
    .tr-tx-cell { display: flex; align-items: center; gap: 10px; }

    .tr-tx-avatar {
        width: 34px; height: 34px; flex: 0 0 34px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px;
    }

    .av-receipt    { background: var(--fc-green-lt); border: 1px solid #b0e0c5; color: var(--fc-green); }
    .av-payment    { background: var(--fc-red-lt);   border: 1px solid #ffc8cf; color: var(--fc-red); }
    .av-transferin  { background: var(--fc-blue-lt); border: 1px solid #c0d4fb; color: var(--fc-blue); }
    .av-transferout { background: var(--fc-purple-lt); border: 1px solid #d0bfef; color: #7c5cd6; }

    .tr-tx-info { display: flex; flex-direction: column; gap: 3px; }

    .tr-tx-chip {
        display: inline-flex; padding: 2px 8px; border-radius: 6px;
        font-size: 10px; font-weight: 800; white-space: nowrap;
    }

    .chip-receipt     { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .chip-payment     { background: var(--fc-red-lt);   color: var(--fc-red);   border: 1px solid #ffc8cf; }
    .chip-transferin  { background: var(--fc-blue-lt);  color: var(--fc-blue);  border: 1px solid #c0d4fb; }
    .chip-transferout { background: var(--fc-purple-lt); color: var(--fc-purple); border: 1px solid #d0bfef; }

    .tr-tx-date { font-size: 10px; color: #9aaabb; font-family: "Inter", Arial, sans-serif; }

    .tr-box-tag {
        display: inline-flex; padding: 3px 8px; border-radius: 6px;
        background: var(--fc-amber-lt); border: 1px solid #f0d898;
        color: #9a6d08; font-size: 10.5px; font-weight: 800;
    }

    .tr-counterpart { font-size: 10px; color: #9aaabb; margin-top: 3px; }

    .tr-amount-cell {
        font-family: "Inter", Arial, sans-serif;
        font-size: 13px; font-weight: 900;
    }
    .amount-in  { color: var(--fc-green); }
    .amount-out { color: var(--fc-red); }

    .tr-party-name { font-size: 12px; font-weight: 700; color: #344563; }

    .tr-ref-tag {
        display: inline-flex; padding: 1px 6px; border-radius: 4px;
        font-size: 9.5px; font-weight: 700; margin-top: 3px;
    }
    .tag-inv  { background: var(--fc-blue-lt); color: var(--fc-blue); border: 1px solid #c0d4fb; }
    .tag-cust { background: var(--fc-amber-lt); color: #9a6d08; border: 1px solid #f0d898; }

    .tr-ref-desc { font-size: 11px; color: #6b7d95; }

    .tr-cheque-tag {
        display: flex; align-items: center; gap: 3px;
        font-size: 9.5px; color: #8899ae; margin-top: 3px;
    }

    .tr-chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 7px; font-size: 10.5px; font-weight: 800; }
    .tr-chip-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; }

    .chip-posted { background: var(--fc-green-lt); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .chip-void   { background: #f0f3f8; color: #6b7d95; border: 1px solid #dde5f0; }

    .dot-green { background: var(--fc-green); }
    .dot-red   { background: var(--fc-red); }

    /* Actions */
    .tr-act-btn {
        width: 28px; height: 28px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid transparent; cursor: pointer;
        transition: all .15s ease; background: transparent;
    }
    .act-void { color: var(--fc-red); }
    .act-void:hover { background: var(--fc-red-lt); border-color: #ffc8cf; }

    .tr-confirm-void {
        height: 26px; padding: 0 9px;
        border: none; border-radius: 6px;
        background: linear-gradient(135deg, #e03048, #c0182e);
        color: #fff; font-family: inherit;
        font-size: 9.5px; font-weight: 800; cursor: pointer;
        animation: tr-pulse 1s ease infinite;
    }
    @@keyframes tr-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.35); } 50% { box-shadow: 0 0 0 5px rgba(224,48,72,0); } }

    /* ================================================================
       MODALS
    ================================================================ */
    .tr-modal-backdrop {
        position: fixed; inset: 0; z-index: 9999;
        background: rgba(10,20,40,.58); backdrop-filter: blur(5px);
        display: flex; align-items: center; justify-content: center;
        padding: 20px; animation: tr-fade-in .2s ease;
    }
    @@keyframes tr-fade-in { from { opacity: 0; } to { opacity: 1; } }

    .tr-modal {
        width: 100%; max-width: 620px;
        background: var(--fc-card); border: 1px solid rgba(0,0,0,.08);
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(10,20,50,.18), 0 30px 80px rgba(10,20,50,.22);
        overflow: hidden;
        animation: tr-modal-in .28s cubic-bezier(.34,1.3,.64,1);
        max-height: calc(100vh - 40px);
        display: flex; flex-direction: column;
    }
    .tr-modal-sm { max-width: 480px; }
    .tr-modal-xl { max-width: 760px; }

    @@keyframes tr-modal-in {
        from { opacity: 0; transform: scale(.94) translateY(12px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* STICKY Header */
    .tr-modal-head {
        display: flex; align-items: center; gap: 14px;
        padding: 18px 22px; flex: 0 0 auto;
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border-bottom: 1px solid #edf1f7;
        box-shadow: 0 2px 8px rgba(15,41,82,.05);
    }

    .tr-modal-icon {
        width: 48px; height: 48px; flex: 0 0 48px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
    }

    .icon-green { background: linear-gradient(135deg, #e9f8f0, #d4f0e0); color: var(--fc-green); border: 1px solid #b0e0c5; }
    .icon-red   { background: linear-gradient(135deg, #fff0f2, #ffe8ec); color: var(--fc-red);   border: 1px solid #ffc8cf; }
    .icon-blue  { background: linear-gradient(135deg, #eaf1ff, #dde8ff); color: var(--fc-blue);  border: 1px solid #bdd4fc; }

    .tr-modal-title { font-size: 15px; font-weight: 900; color: #1c2b43; }
    .tr-modal-sub   { font-size: 10.5px; color: var(--fc-muted); margin-top: 2px; }

    .tr-modal-close {
        margin-right: auto; width: 34px; height: 34px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid #e4eaf2; border-radius: 9px;
        background: none; color: #9aaabb; cursor: pointer;
        transition: all .15s ease;
    }
    .tr-modal-close:hover { background: #f0f4fa; color: var(--fc-text); }

    .tr-modal-banner {
        display: flex; align-items: center; justify-content: space-between;
        gap: 10px; padding: 10px 22px; font-size: 12px; font-weight: 600; flex: 0 0 auto;
    }
    .tr-modal-banner button { background: none; border: none; cursor: pointer; opacity: .6; }
    .banner-success { background: #e9f8f0; color: #0e7a43; }
    .banner-error   { background: #fff0f2; color: var(--fc-red); }

    /* SCROLLABLE Body */
    .tr-modal-body {
        padding: 20px 22px; overflow-y: auto; flex: 1 1 auto; min-height: 0;
        display: flex; flex-direction: column; gap: 16px;
    }

    /* STICKY Footer */
    .tr-modal-foot {
        display: flex; align-items: center; justify-content: flex-end; gap: 10px;
        padding: 14px 22px; flex: 0 0 auto;
        background: linear-gradient(180deg, #fafbfd 0%, #f4f6fb 100%);
        border-top: 1px solid #edf1f7;
    }

    .tr-modal-cancel {
        height: 40px; padding: 0 18px;
        border: 1px solid var(--fc-border); border-radius: 10px;
        background: var(--fc-card); color: var(--fc-muted);
        font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
        transition: all .15s ease;
    }
    .tr-modal-cancel:hover { background: #f0f4fa; color: var(--fc-text); }

    .tr-modal-save {
        display: inline-flex; align-items: center; gap: 7px;
        height: 40px; padding: 0 20px;
        border: 0; border-radius: 10px;
        color: #fff; font-family: inherit;
        font-size: 12px; font-weight: 800; cursor: pointer;
        transition: all .15s ease;
    }
    .tr-modal-save:hover:not(:disabled) { transform: translateY(-1px); }
    .tr-modal-save:disabled { opacity: .6; cursor: not-allowed; }

    .save-green { background: linear-gradient(135deg, #16a35b, #0d8a48); box-shadow: 0 4px 14px rgba(22,163,91,.28); }
    .save-red   { background: linear-gradient(135deg, #e03048, #c0182e); box-shadow: 0 4px 14px rgba(224,48,72,.28); }
    .save-blue  { background: linear-gradient(135deg, #1e6ef5, #1558d6); box-shadow: 0 4px 14px rgba(30,110,245,.28); }

    /* ================================================================
       MODAL FORM
    ================================================================ */
    /* Type Toggle */
    .tr-type-toggle { display: flex; gap: 10px; }

    .tr-type-btn {
        flex: 1; display: flex; align-items: center; justify-content: center; gap: 7px;
        height: 50px; border: 2px solid #d8e2f0; border-radius: 11px;
        background: #fafcff; color: var(--fc-muted);
        font-family: inherit; font-size: 13px; font-weight: 700; cursor: pointer;
        transition: all .18s ease;
    }
    .tr-type-btn:hover:not(.type-receipt):not(.type-payment) { border-color: #b0c4e0; color: var(--fc-text); }

    .type-receipt { border-color: var(--fc-green); background: var(--fc-green-lt); color: var(--fc-green); box-shadow: 0 0 0 3px rgba(22,163,91,.10); font-weight: 800; }
    .type-payment { border-color: var(--fc-red);   background: var(--fc-red-lt);   color: var(--fc-red);   box-shadow: 0 0 0 3px rgba(224,48,72,.08); font-weight: 800; }

    .tr-modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    .tr-mfield { display: flex; flex-direction: column; gap: 6px; }
    .tr-mfield-full { grid-column: 1 / -1; }

    .tr-mlabel { font-size: 11.5px; font-weight: 800; color: #344258; display: flex; align-items: center; gap: 3px; }
    .tr-mrequired { color: var(--fc-red); font-size: 13px; }

    .tr-minput {
        height: 42px; width: 100%;
        border: 1.5px solid #d8e2f0; border-radius: 9px;
        background: #fff; color: var(--fc-text);
        font-family: inherit; font-size: 13px; padding: 0 12px;
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .tr-minput:focus { border-color: var(--fc-blue); box-shadow: 0 0 0 3px rgba(30,110,245,.10); }
    .tr-minput::placeholder { color: #b0bcc8; }

    .tr-mselect-wrap { position: relative; }
    .tr-msel-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #9aaabb; pointer-events: none; z-index: 1; }
    .tr-msel { padding-right: 36px; cursor: pointer; -webkit-appearance: none; appearance: none; }

    .tr-mfield-group { position: relative; display: flex; align-items: center; }
    .tr-mprefix {
        position: absolute; right: 12px;
        display: flex; align-items: center;
        color: #9aaabb; pointer-events: none; z-index: 1;
        font-size: 11px; font-weight: 700;
    }
    .tr-minput.with-prefix { padding-right: 36px; }

    .tr-field-hint { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--fc-muted); font-weight: 500; padding: 8px 0; }

    /* ================================================================
       TRANSFER VISUAL
    ================================================================ */
    .tr-transfer-visual {
        display: flex; align-items: center; gap: 0;
        padding: 16px 18px; border-radius: 12px;
        background: linear-gradient(135deg, #f5f8ff, #eef4ff);
        border: 1px solid #c8d8fb;
    }

    .tr-transfer-box {
        flex: 1; text-align: center; padding: 10px;
        border-radius: 10px;
    }
    .from-box { background: rgba(224,48,72,.06); border: 1px solid #ffc8cf; }
    .to-box   { background: rgba(22,163,91,.06);  border: 1px solid #b0e0c5; }

    .tr-tb-label { font-size: 9px; font-weight: 700; color: #9aaabb; text-transform: uppercase; margin-bottom: 4px; }
    .tr-tb-name  { font-size: 13px; font-weight: 800; color: #1c2b43; }

    .tr-transfer-arrow {
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        padding: 0 16px; color: var(--fc-blue);
    }

    .tr-transfer-amount {
        font-family: "Inter", Arial, sans-serif;
        font-size: 12px; font-weight: 900; color: var(--fc-blue);
        background: var(--fc-blue-lt); border: 1px solid #c0d4fb;
        padding: 2px 8px; border-radius: 6px;
    }

    /* Spinner */
    .btn-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: tr-spin .7s linear infinite; }
    .btn-spinner.sm { width: 13px; height: 13px; }

    /* ================================================================
       RESPONSIVE
    ================================================================ */
    @@media (max-width: 1100px) {
        .tr-boxes-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 900px) {
        .tr-toolbar { flex-direction: column; align-items: stretch; }
        .tr-search-wrap { max-width: 100%; }
        .tr-results-badge { margin-right: 0; }
        .tr-modal-grid { grid-template-columns: 1fr; }
        .tr-type-toggle { flex-direction: column; }
        .tr-date-range { flex-wrap: wrap; }
    }

    @@media (max-width: 680px) {
        .tr-body { padding: 10px 12px 24px; }
        .tr-toolbar { padding: 10px 12px; }
        .tr-boxes-grid { grid-template-columns: 1fr; }
        .tr-status-tabs { flex-wrap: wrap; }
        .tr-modal-backdrop { padding: 10px; }
        .tr-modal { border-radius: 16px; }
        .tr-transfer-visual { flex-direction: column; gap: 10px; }
        .tr-transfer-arrow { flex-direction: row; }
    }

    @@media (max-width: 480px) {
        .tr-status-tab { padding: 0 7px; font-size: 9.5px; }
        .tr-tab-dot { display: none; }
    }

    /* ═══ المرحلة 2 — خزائن + FAB + كروت فلاتر ═══ */
    .tr-box-card { position: relative; }
    .tr-box-card.box-closed { opacity: .62; }
    .tr-box-card.box-closed:hover { opacity: 1; }

    .tr-box-badge {
        display: inline-block; font-size: 9px; font-weight: 800; padding: 1px 7px;
        border-radius: 999px; margin-right: 6px; vertical-align: middle;
    }
    .badge-main   { background: #eaf1ff; color: var(--fc-blue); border: 1px solid #bdd4fc; }
    .badge-closed { background: #f0f4fa; color: #6b7d94; border: 1px solid #dbe4ee; }

    .tr-box-emp {
        display: flex; align-items: center; gap: 4px;
        font-size: 10px; font-weight: 700; color: #5c6e85; margin-top: 3px;
    }

    .tr-box-actions {
        position: absolute; top: 8px; left: 8px;
        display: flex; gap: 5px; opacity: 0; transition: opacity .18s ease;
    }
    .tr-box-card:hover .tr-box-actions,
    .tr-box-card:focus-within .tr-box-actions { opacity: 1; }

    .tr-box-act {
        width: 26px; height: 26px; border-radius: 8px; display: inline-flex;
        align-items: center; justify-content: center; cursor: pointer;
        background: #fff; border: 1px solid var(--fc-line, #e3e9f0); color: #5c6e85;
        transition: all .15s ease;
    }
    .tr-box-act:hover { border-color: var(--fc-blue); color: var(--fc-blue); }
    .tr-box-act.act-settle:hover { border-color: var(--fc-red); color: var(--fc-red); }
    .tr-box-act.act-reopen:hover { border-color: var(--fc-green); color: var(--fc-green); }

    .tr-box-add {
        border-style: dashed; justify-content: center; text-decoration: none;
        color: var(--fc-blue); gap: 12px;
    }
    .tr-box-add:hover { border-color: var(--fc-blue); background: #f5f9ff; }
    .tr-box-add-plus {
        width: 40px; height: 40px; border-radius: 12px; flex: 0 0 auto;
        background: #eaf1ff; color: var(--fc-blue);
        display: flex; align-items: center; justify-content: center;
    }

    .tr-settle-box {
        background: #f5f8fb; border: 1px solid var(--fc-line, #e3e9f0);
        border-radius: 12px; padding: 14px; text-align: center;
    }
    .tr-settle-label { font-size: 11px; font-weight: 800; color: #5c6e85; }
    .tr-settle-amount { font-size: 22px; font-weight: 900; margin-top: 4px; }
    .tr-settle-note { font-size: 11.5px; color: #5c6e85; line-height: 1.7; margin: 0; }

    .tr-banner-close {
        background: none; border: none; cursor: pointer; padding: 4px;
        display: inline-flex; align-items: center; justify-content: center;
        color: inherit; opacity: .7; transition: opacity .15s ease;
    }
    .tr-banner-close:hover { opacity: 1; }

    /* كروت KPI — فلترة */
    .fc-kpi-click { cursor: pointer; transition: transform .15s ease, box-shadow .15s ease; }
    .fc-kpi-click:hover { transform: translateY(-2px); }
    .fc-kpi-active {
        outline: 2px solid var(--fc-blue);
        outline-offset: -2px;
        box-shadow: 0 4px 14px rgba(30,110,245,.18);
    }

    /* FAB */
    .fc-fab-container {
        position: fixed; bottom: 24px; left: 24px; z-index: 1000;
        display: flex; flex-direction: column-reverse; align-items: flex-start; gap: 12px;
    }
    .fc-fab-main {
        width: 56px; height: 56px; border-radius: 50%; border: none;
        background: linear-gradient(135deg, #1e6ef5, #1558d6); color: #fff;
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 16px rgba(30,110,245,.4);
        transition: all .25s cubic-bezier(.34,1.3,.64,1);
    }
    .fc-fab-main:hover { transform: scale(1.08); box-shadow: 0 6px 24px rgba(30,110,245,.5); }
    .fc-fab-main.is-open { transform: rotate(45deg); }
    .fc-fab-menu {
        display: flex; flex-direction: column; gap: 10px;
        opacity: 0; visibility: hidden; transform: translateY(10px);
        transition: all .25s cubic-bezier(.34,1.3,.64,1);
    }
    .fc-fab-menu.is-open { opacity: 1; visibility: visible; transform: translateY(0); }
    .fc-fab-item {
        display: flex; align-items: center; gap: 10px; padding: 10px 16px;
        background: #fff; border: 1px solid #e4eaf2; border-radius: 12px;
        cursor: pointer; box-shadow: 0 2px 12px rgba(10,20,50,.12);
        transition: all .2s ease; white-space: nowrap; text-decoration: none;
    }
    .fc-fab-item:hover { background: #f5f8fb; border-color: #c8d8f0; transform: translateX(-4px); }
    .fc-fab-icon {
        width: 36px; height: 36px; border-radius: 10px;
        background: var(--fc-blue-lt, #e8f1ff); color: var(--fc-blue, #1e6ef5);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .fc-fab-label { font-size: 13px; font-weight: 700; color: #344258; }

    @@media (max-width: 768px) {
        .fc-fab-container { bottom: 16px; left: 16px; }
        .fc-fab-main { width: 48px; height: 48px; }
        .fc-fab-item { padding: 8px 12px; }
        .fc-fab-label { font-size: 12px; }
    }

    @@media print {
        .fc-fab-container { display: none !important; }
    }

</style>


@code {
    private AuthUser? _user;
    private bool CanView     => _user?.Can("TREASURY.VIEW")     ?? false;
    private bool CanPost     => _user?.Can("TREASURY.POST")     ?? false;
    private bool CanVoid     => _user?.Can("TREASURY.VOID")     ?? false;
    private bool CanTransfer => _user?.Can("TREASURY.TRANSFER") ?? false;
    private bool CanManage   => _user?.Can("TREASURY.MANAGE")   ?? false;

    private static readonly (string Key, string Value)[] _tabItems =
    {
        ("all",         "الكل"),
        ("Receipt",     "وارد"),
        ("Payment",     "صادر"),
        ("TransferIn",  "تحويل وارد"),
        ("TransferOut", "تحويل صادر"),
        ("Void",        "ملغية")
    };

    private List<Box>     _boxes        = new();
    private List<Tx>      _txs          = new();
    private List<Cust>    _customers    = new();
    private List<Opt>     _suppliers    = new();
    private List<Method>  _methods      = new();
    private List<OpenInv> _openInvoices = new();

    private bool    _loading;
    private string  _search    = "";
    private string  _tab       = "all";
    private int     _boxFilter;
    private string? _from;
    private string? _to;
    private long?   _confirmId;
    private bool    _saving;
    private string? _msg;
    private bool    _ok;

    private bool         _postOpen;
    private PostForm     _pf = new();
    private bool         _transferOpen;
    private TransferForm _tf = new();

    /* ── المرحلة 2: خزائن متعددة ── */
    private bool    _fabOpen;
    private string  _kpi = "";
    private string  _defaultBoxCode = "MAIN";
    private Box?    _settleTarget;
    private Box?    _reopenTarget;
    private decimal _reopenOpening;

    /* ── DTOs ── */
    public class Opt    { public int Id { get; set; } public string Label { get; set; } = ""; }
    public class Cust   { public int Id { get; set; } public string Label { get; set; } = ""; }
    public class Method { public int Id { get; set; } public string Label { get; set; } = ""; public bool RequiresChequeNo { get; set; } }
    public class OpenInv { public long InvoiceId { get; set; } public string InvoiceNumber { get; set; } = ""; public decimal GrandTotal { get; set; } public decimal PaidAmount { get; set; } public decimal Due { get; set; } }

    public class Box
    {
        public int     CashBoxId       { get; set; }
        public string  Code            { get; set; } = "";
        public string  NameAr          { get; set; } = "";
        public decimal OpeningBalance  { get; set; }
        public decimal CurrentBalance  { get; set; }
        public string  CurrencyCode    { get; set; } = "EGP";
        public int     TxCount         { get; set; }
        public bool    IsActive        { get; set; }
        public string  Status          { get; set; } = "Open";
        public int?    ResponsibleEmployeeId   { get; set; }
        public string? ResponsibleEmployeeName { get; set; }
    }

    public class DefaultBoxRes { public string Code { get; set; } = "MAIN"; }

    public class Tx
    {
        public long     CashTransactionId { get; set; }
        public DateTime TransactionDate   { get; set; }
        public string   TransactionType   { get; set; } = "";
        public int      CashBoxId         { get; set; }
        public string   CashBoxName       { get; set; } = "";
        public decimal  Amount            { get; set; }
        public string?  MethodName        { get; set; }
        public string?  CustomerName      { get; set; }
        public string?  SupplierName      { get; set; }
        public string?  InvoiceNumber     { get; set; }
        public string?  CustodyNumber     { get; set; }
        public string?  CounterpartName   { get; set; }
        public string?  ChequeNumber      { get; set; }
        public string?  ReferenceNumber   { get; set; }
        public string?  Description       { get; set; }
        public string   Status            { get; set; } = "";
    }

    public class PostForm
    {
        public string  Type            { get; set; } = "Receipt";
        public int     CashBoxId       { get; set; }
        public string? TxDate          { get; set; }
        public decimal Amount          { get; set; }
        public int     PaymentMethodId { get; set; }
        public int     CustomerId      { get; set; }
        public int     SupplierId      { get; set; }
        public long    InvoiceId       { get; set; }
        public string? ChequeNumber    { get; set; }
        public string? ReferenceNumber { get; set; }
        public string? Description     { get; set; }
    }

    public class TransferForm
    {
        public int     FromCashBoxId { get; set; }
        public int     ToCashBoxId   { get; set; }
        public string? TxDate        { get; set; }
        public decimal Amount        { get; set; }
        public string? Description   { get; set; }
    }

    /* ── Computed ── */
    private decimal TotalBalance => _boxes.Sum(b => b.CurrentBalance);

    private IEnumerable<Tx> Posted => _txs.Where(t => t.Status == "Posted");

    private decimal TodayIn => Posted
        .Where(t => t.TransactionType == "Receipt" && t.TransactionDate.Date == DateTime.Now.Date)
        .Sum(t => t.Amount);

    private decimal TodayOut => Posted
        .Where(t => t.TransactionType == "Payment" && t.TransactionDate.Date == DateTime.Now.Date)
        .Sum(t => t.Amount);

    private IEnumerable<Tx> Filtered => _txs.Where(t =>
        (_tab switch
        {
            "all"  => true,
            "Void" => t.Status == "Void",
            _      => t.Status == "Posted" && t.TransactionType == _tab
        }) &&
        (_boxFilter == 0 || t.CashBoxId == _boxFilter) &&
        (string.IsNullOrWhiteSpace(_search) ||
         (t.Description    ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (t.ReferenceNumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (t.ChequeNumber   ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (t.CustomerName   ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)));

    /* ── Helpers ── */
    private static string TxAr(string t) => t switch
    {
        "Receipt"     => "وارد",
        "Payment"     => "صادر",
        "TransferIn"  => "تحويل وارد",
        "TransferOut" => "تحويل صادر",
        _             => t
    };

    private static string TxChipClass(string t) => t switch
    {
        "Receipt"     => "chip-receipt",
        "Payment"     => "chip-payment",
        "TransferIn"  => "chip-transferin",
        "TransferOut" => "chip-transferout",
        _             => "chip-receipt"
    };

    private static string TxAvatarClass(string t) => t switch
    {
        "Receipt"     => "tr-tx-avatar av-receipt",
        "Payment"     => "tr-tx-avatar av-payment",
        "TransferIn"  => "tr-tx-avatar av-transferin",
        "TransferOut" => "tr-tx-avatar av-transferout",
        _             => "tr-tx-avatar av-receipt"
    };

    private static string TabDotColor(string t) => t switch
    {
        "all"         => "tdot-all",
        "Receipt"     => "tdot-in",
        "Payment"     => "tdot-out",
        "TransferIn"  => "tdot-tin",
        "TransferOut" => "tdot-tout",
        "Void"        => "tdot-void",
        _             => "tdot-all"
    };

    private static string Money(decimal v)     => v.ToString("N2");
    private static decimal ParseDec(object? v) => decimal.TryParse(v?.ToString(), out var n) ? n : 0m;
    private static int    ParseInt(object? v)  => int.TryParse(v?.ToString(), out var n) ? n : 0;
    private static long   ParseLong(object? v) => long.TryParse(v?.ToString(), out var n) ? n : 0;

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        await LoadAsync();
        _customers = await SafeGetT<Cust>("api/treasury/customers");
        _suppliers = await SafeGetT<Opt>("api/options/suppliers");
        _methods   = await SafeGetT<Method>("api/options/payment-methods");
        try
        {
            var db = await Http.GetFromJsonAsync<DefaultBoxRes>("api/treasury/default-box");
            if (db is not null && !string.IsNullOrWhiteSpace(db.Code)) _defaultBoxCode = db.Code;
        }
        catch { /* الافتراضي MAIN */ }
    }

    private async Task<List<T>> SafeGetT<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _boxes = await Http.GetFromJsonAsync<List<Box>>("api/treasury/boxes") ?? new();

            var url = "api/treasury/transactions?take=300";
            if (!string.IsNullOrWhiteSpace(_from)) url += "&from=" + Uri.EscapeDataString(_from);
            if (!string.IsNullOrWhiteSpace(_to))   url += "&to="   + Uri.EscapeDataString(_to);
            _txs = await Http.GetFromJsonAsync<List<Tx>>(url) ?? new();
        }
        catch (Exception ex) { Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    /* ── حركة جديدة ── */
    private void OpenPost()
    {
        _pf = new PostForm
        {
            TxDate    = DateTime.Now.ToString("yyyy-MM-ddTHH:mm"),
            CashBoxId = _boxes.FirstOrDefault()?.CashBoxId ?? 0
        };
        _openInvoices = new(); _msg = null; _postOpen = true;
    }

    private void ClosePost() { _postOpen = false; _msg = null; }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        _pf.CustomerId = ParseInt(e.Value);
        _pf.InvoiceId  = 0;
        _openInvoices = _pf.CustomerId > 0
            ? await SafeGetT<OpenInv>($"api/payments/open-invoices?customerId={_pf.CustomerId}")
            : new();
    }

    private async Task SavePost()
    {
        if (_pf.CashBoxId <= 0) { _ok = false; _msg = "اختار الخزينة"; return; }
        if (_pf.Amount <= 0)    { _ok = false; _msg = "اكتب مبلغ"; return; }
        if (_pf.Type == "Receipt" && _pf.CustomerId <= 0)
        { _ok = false; _msg = "القبض لازم يكون من عميل"; return; }

        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/treasury/transactions", new
            {
                type            = _pf.Type,
                cashBoxId       = _pf.CashBoxId,
                txDate          = _pf.TxDate,
                amount          = _pf.Amount,
                paymentMethodId = _pf.PaymentMethodId == 0 ? (int?)null : _pf.PaymentMethodId,
                customerId      = _pf.CustomerId == 0 ? (int?)null : _pf.CustomerId,
                supplierId      = _pf.SupplierId == 0 ? (int?)null : _pf.SupplierId,
                invoiceId       = _pf.InvoiceId == 0 ? (long?)null : _pf.InvoiceId,
                custodyId       = (long?)null,
                chequeNumber    = _pf.ChequeNumber,
                chequeDate      = (string?)null,
                bankAccount     = (string?)null,
                referenceNumber = _pf.ReferenceNumber,
                description     = _pf.Description
            });
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode) { Snackbar.Add(_msg, Severity.Success); ClosePost(); await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    /* ── تحويل ── */
    private void OpenTransfer()
    {
        _tf = new TransferForm { TxDate = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") };
        _msg = null; _transferOpen = true;
    }

    private void CloseTransfer() { _transferOpen = false; _msg = null; }

    private async Task SaveTransfer()
    {
        if (_tf.FromCashBoxId <= 0 || _tf.ToCashBoxId <= 0) { _ok = false; _msg = "اختار الخزينتين"; return; }
        if (_tf.Amount <= 0) { _ok = false; _msg = "اكتب مبلغ"; return; }

        _saving = true; _msg = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/treasury/transfer", new
            {
                fromCashBoxId = _tf.FromCashBoxId,
                toCashBoxId   = _tf.ToCashBoxId,
                txDate        = _tf.TxDate,
                amount        = _tf.Amount,
                description   = _tf.Description
            });
            _msg = await MsgOf(res); _ok = res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode) { Snackbar.Add(_msg, Severity.Success); CloseTransfer(); await LoadAsync(); }
        }
        catch (Exception ex) { _ok = false; _msg = "فشل: " + ex.Message; }
        finally { _saving = false; }
    }

    /* ── إلغاء ── */
    private async Task Void(Tx t)
    {
        try
        {
            var res = await Http.PostAsync($"api/treasury/transactions/{t.CashTransactionId}/void", null);
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
    }

    /* ── فلترة بالكروت ── */
    private async Task SetKpi(string k)
    {
        _kpi = _kpi == k ? "" : k;          // الضغط تاني بيلغي الفلتر
        if (_kpi is "" or "posted")
        {
            _tab = "all"; _from = null; _to = null;
        }
        else
        {
            _tab = _kpi;                     // Receipt / Payment
            _from = DateTime.Now.ToString("yyyy-MM-dd");
            _to   = _from;
        }
        _confirmId = null;
        await LoadAsync();
    }

    /* ── تسوية / إعادة فتح خزينة ── */
    private void OpenSettle(Box b) { _settleTarget = b; }

    private void OpenReopen(Box b) { _reopenTarget = b; _reopenOpening = 0m; }

    private async Task DoSettle()
    {
        if (_settleTarget is null) return;
        _saving = true;
        try
        {
            var res = await Http.PostAsync($"api/treasury/boxes/{_settleTarget.CashBoxId}/settle", null);
            var m = await MsgOf(res);
            if (res.IsSuccessStatusCode) { Snackbar.Add(m, Severity.Success); _settleTarget = null; await LoadAsync(); }
            else Snackbar.Add(m, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task DoReopen()
    {
        if (_reopenTarget is null) return;
        _saving = true;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/treasury/boxes/{_reopenTarget.CashBoxId}/reopen",
                new { openingBalance = _reopenOpening });
            var m = await MsgOf(res);
            if (res.IsSuccessStatusCode) { Snackbar.Add(m, Severity.Success); _reopenTarget = null; await LoadAsync(); }
            else Snackbar.Add(m, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم" : $"خطأ {(int)res.StatusCode}"; }
    }
}