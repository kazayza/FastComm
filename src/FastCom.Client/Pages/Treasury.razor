@page "/treasury"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>الخزينة — فاست كوم</PageTitle>


<div class="fc-hero">
    <div class="fc-hero-inner">
        <div class="fc-page-head">
            <div>
                <div class="fc-crumb">المالية · الخزينة</div>
                <h1 class="fc-hero-title">الخزينة</h1>
                <p class="fc-hero-sub">الصناديق النقدية وحركاتها — الأرصدة بتتحدّث أوتوماتيك من الحركات</p>
            </div>
            <div class="fc-head-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="تحديث"
                               OnClick="Reload" Style="color:#9FB4CC" />
            </div>
        </div>

        @if (CanView)
        {
            <div class="fc-kpis fc-kpis-glass">
                <div class="fc-kpi fc-kpi-click @(_kpi == "" ? "fc-kpi-active" : "")" role="button" tabindex="0"
                     @onclick='() => SetKpi("")' title="عرض كل الحركات">
                    <div class="fc-kpi-ic fc-kpi-blue"><MudIcon Icon="@Icons.Material.Filled.AccountBalance" /></div>
                    <div><div class="fc-kpi-num">@Money(TotalBalance)</div><div class="fc-kpi-lb">إجمالي الأرصدة</div></div>
                </div>
                <div class="fc-kpi fc-kpi-click @(_kpi == "Receipt" ? "fc-kpi-active" : "")" role="button" tabindex="0"
                     @onclick='() => SetKpi("Receipt")' title="وارد النهاردة">
                    <div class="fc-kpi-ic fc-kpi-green"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                    <div><div class="fc-kpi-num">@Money(TodayIn)</div><div class="fc-kpi-lb">وارد النهاردة</div></div>
                </div>
                <div class="fc-kpi fc-kpi-click @(_kpi == "Payment" ? "fc-kpi-active" : "")" role="button" tabindex="0"
                     @onclick='() => SetKpi("Payment")' title="صادر النهاردة">
                    <div class="fc-kpi-ic fc-kpi-red"><MudIcon Icon="@Icons.Material.Filled.Savings" /></div>
                    <div><div class="fc-kpi-num">@Money(TodayOut)</div><div class="fc-kpi-lb">صادر النهاردة</div></div>
                </div>
                <div class="fc-kpi fc-kpi-click @(_kpi == "posted" ? "fc-kpi-active" : "")" role="button" tabindex="0"
                     @onclick='() => SetKpi("posted")' title="الحركات السارية">
                    <div class="fc-kpi-ic fc-kpi-gold"><MudIcon Icon="@Icons.Material.Filled.FactCheck" /></div>
                    <div><div class="fc-kpi-num">@_txs.Count(t => t.Status == "Posted")</div><div class="fc-kpi-lb">حركة سارية</div></div>
                </div>
            </div>
        }
    </div>
</div>


<div class="tr-body">

    @if (!CanView)
    {
        <div class="tr-state-box">
            <div class="tr-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"
                     fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليس لديك صلاحية عرض الخزينة</p>
        </div>
    }
    else
    {
        @* ── Boxes Cards ── *@
        @if (_boxes.Any())
        {
            <div class="tr-boxes-grid">
                @foreach (var b in _boxes)
                {
                    <div class="tr-box-card @(b.Status == "Closed" ? "box-closed" : "")">
                        <div class="tr-box-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="22" height="22"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="7" width="20" height="14" rx="2"/>
                                <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                                <circle cx="12" cy="14" r="2"/>
                            </svg>
                        </div>
                        <div class="tr-box-info">
                            <div class="tr-box-name">
                                @b.NameAr
                                @if (b.Code == _defaultBoxCode)
                                {
                                    <span class="tr-box-badge badge-main">رئيسية</span>
                                }
                                @if (b.Status == "Closed")
                                {
                                    <span class="tr-box-badge badge-closed">مقفولة</span>
                                }
                            </div>
                            <div class="tr-box-code">@b.Code · @b.TxCount حركة</div>
                            @if (!string.IsNullOrEmpty(b.ResponsibleEmployeeName))
                            {
                                <div class="tr-box-emp">
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none"
                                         stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    @b.ResponsibleEmployeeName
                                </div>
                            }
                        </div>
                        <div class="tr-box-balance">
                            <div class="tr-box-amount @(b.CurrentBalance >= 0 ? "bal-pos" : "bal-neg")">
                                @Money(b.CurrentBalance)
                            </div>
                            <div class="tr-box-currency">@b.CurrencyCode</div>
                        </div>
                        @if (CanManage)
                        {
                            <div class="tr-box-actions">
                                @if (b.Status == "Open" && b.Code != _defaultBoxCode)
                                {
                                    <a class="tr-box-act" href="/treasury/boxes/new/@b.CashBoxId"
                                       title="تعديل الخزينة" aria-label="تعديل @b.NameAr">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
                                             stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </a>
                                    <button class="tr-box-act act-settle"
                                            title="تسوية وإقفال"
                                            aria-label="تسوية @b.NameAr"
                                            @onclick="() => OpenSettle(b)">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
                                             stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                                        </svg>
                                    </button>
                                }
                                @if (b.Status == "Closed")
                                {
                                    <button class="tr-box-act act-reopen"
                                            title="إعادة فتح"
                                            aria-label="إعادة فتح @b.NameAr"
                                            @onclick="() => OpenReopen(b)">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
                                             stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                                            <path d="M7 11V7a5 5 0 019.9-1"/>
                                        </svg>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                @if (CanManage)
                {
                    <a class="tr-box-card tr-box-add" href="/treasury/boxes/new" aria-label="خزينة جديدة">
                        <div class="tr-box-add-plus" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="24" height="24" fill="none"
                                 stroke="currentColor" stroke-width="2.2">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="tr-box-info">
                            <div class="tr-box-name">خزينة جديدة</div>
                            <div class="tr-box-code">درج موظف أو خزينة فرعية</div>
                        </div>
                    </a>
                }
            </div>
        }


        @* ── Transactions Card ── *@
        <div class="tr-card">

            @* ── Toolbar ── *@
            <div class="tr-toolbar">

                <div class="tr-search-wrap">
                    <svg class="tr-search-icon" viewBox="0 0 24 24" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="tr-search-input"
                           placeholder="ابحث بالبيان أو المرجع أو العميل..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="بحث" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="tr-search-clear" @onclick="() => _search = string.Empty">
                            <svg viewBox="0 0 24 24" width="14" height="14"
                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                @* Box Filter *@
                <div class="tr-box-filter-wrap">
                    <svg class="tr-box-icon-sel" viewBox="0 0 24 24" width="13" height="13"
                         fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                    </svg>
                    <select class="tr-box-select" @bind="_boxFilter">
                        <option value="0">كل الخزائن</option>
                        @foreach (var b in _boxes)
                        {
                            <option value="@b.CashBoxId">@b.NameAr</option>
                        }
                    </select>
                </div>

                @* Date Range *@
                <div class="tr-date-range">
                    <div class="tr-date-field">
                        <svg viewBox="0 0 16 16" width="11" height="11"
                             fill="none" stroke="currentColor" stroke-width="1.7"
                             aria-hidden="true">
                            <rect x="2" y="3" width="12" height="11" rx="2"/>
                            <path d="M5 1v3M11 1v3M2 7h12" stroke-linecap="round"/>
                        </svg>
                        <input type="date" class="tr-date-input"
                               value="@_from"
                               @onchange="e => _from = e.Value?.ToString()"
                               aria-label="من تاريخ" />
                    </div>
                    <span class="tr-date-sep" aria-hidden="true">—</span>
                    <div class="tr-date-field">
                        <svg viewBox="0 0 16 16" width="11" height="11"
                             fill="none" stroke="currentColor" stroke-width="1.7"
                             aria-hidden="true">
                            <circle cx="8" cy="8" r="6"/>
                            <path d="M8 5v3l2 2" stroke-linecap="round"/>
                        </svg>
                        <input type="date" class="tr-date-input"
                               value="@_to"
                               @onchange="e => _to = e.Value?.ToString()"
                               aria-label="إلى تاريخ" />
                    </div>
                    <button class="tr-apply-btn" @onclick="LoadAsync">
                        <svg viewBox="0 0 24 24" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2"
                             aria-hidden="true">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>

                <div class="tr-results-badge">
                    عرض <strong>@Filtered.Count()</strong> من <strong>@_txs.Count</strong>
                </div>

            </div>


            @* ── Status Tabs ── *@
            <div class="tr-status-bar">
                <div class="tr-status-tabs" role="group" aria-label="فلتر النوع">
                    @foreach (var t in _tabItems)
                    {
                        var cnt = t.Key == "all"
                            ? _txs.Count
                            : t.Key == "Void"
                                ? _txs.Count(x => x.Status == "Void")
                                : _txs.Count(x => x.Status == "Posted" && x.TransactionType == t.Key);

                        <button class="tr-status-tab @(_tab == t.Key ? "active" : "")"
                                @onclick="() => SetTab(t.Key)"
                                aria-pressed="@(_tab == t.Key)">
                            <span class="tr-tab-dot @TabDotColor(t.Key)" aria-hidden="true"></span>
                            <span>@t.Value</span>
                            <span class="tr-tab-count">@cnt</span>
                        </button>
                    }
                </div>
            </div>


            @* ── Content ── *@
            @if (_loading)
            {
                <div class="tr-loading">
                    <div class="tr-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل الحركات...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                <div class="tr-empty">
                    <div class="tr-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="42" height="42"
                             fill="none" stroke="currentColor" stroke-width="1.4">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 00-4 0v2M8 7V5a2 2 0 00-4 0v2"/>
                            <circle cx="12" cy="14" r="2"/>
                        </svg>
                    </div>
                    <div class="tr-empty-title">لا توجد حركات</div>
                    <div class="tr-empty-sub">جرّب فلتر مختلف أو غيّر نطاق التاريخ</div>
                </div>
            }
            else
            {
                <div class="tr-table-wrap">
                    <table class="tr-table" aria-label="حركات الخزينة">
                        <thead>
                            <tr>
                                <th scope="col" class="th-start">الحركة</th>
                                <th scope="col">الخزينة</th>
                                <th scope="col">المبلغ</th>
                                <th scope="col">الطريقة</th>
                                <th scope="col">الطرف</th>
                                <th scope="col">المرجع</th>
                                <th scope="col">الحالة</th>
                                @if (CanVoid)
                                {
                                    <th scope="col" style="width:90px">إجراءات</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Filtered)
                            {
                                <tr class="@(t.Status == "Void" ? "row-void" : "")">

                                    @* ── الحركة: نوع + تاريخ ── *@
                                    <td class="td-start">
                                        <div class="tr-tx-cell">
                                            <div class="tr-tx-avatar @TxAvatarClass(t.TransactionType)"
                                                 aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="16" height="16"
                                                     fill="none" stroke="currentColor" stroke-width="2.1"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    @if (t.TransactionType == "Receipt")
                                                    {
                                                        <path d="M12 3v13M6 11l6 6 6-6" />
                                                    }
                                                    else if (t.TransactionType == "Payment")
                                                    {
                                                        <path d="M12 21V8M6 13l6-6 6 6" />
                                                    }
                                                    else if (t.TransactionType == "TransferIn")
                                                    {
                                                        <path d="M4 12h15M13 6l6 6-6 6" />
                                                    }
                                                    else if (t.TransactionType == "TransferOut")
                                                    {
                                                        <path d="M20 12H5M11 6l-6 6 6 6" />
                                                    }
                                                    else
                                                    {
                                                        <rect x="2" y="5" width="20" height="14" rx="2" />
                                                        <path d="M2 10h20" />
                                                    }
                                                </svg>
                                            </div>
                                            <div class="tr-tx-info">
                                                <span class="tr-tx-chip @TxChipClass(t.TransactionType)">
                                                    @TxAr(t.TransactionType)
                                                </span>
                                                <div class="tr-tx-date">@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</div>
                                            </div>
                                        </div>
                                    </td>

                                    @* ── الخزينة ── *@
                                    <td>
                                        <div class="tr-box-tag">@t.CashBoxName</div>
                                        @if (t.CounterpartName is not null)
                                        {
                                            <div class="tr-counterpart">⇄ @t.CounterpartName</div>
                                        }
                                    </td>

                                    @* ── المبلغ ── *@
                                    <td>
                                        <div class="tr-amount-cell @(t.TransactionType == "Receipt" || t.TransactionType == "TransferIn" ? "amount-in" : "amount-out")">
                                            @(t.TransactionType == "Payment" || t.TransactionType == "TransferOut" ? "−" : "+")
                                            @Money(t.Amount)
                                        </div>
                                    </td>

                                    @* ── الطريقة ── *@
                                    <td class="td-muted">@(t.MethodName ?? "—")</td>

                                    @* ── الطرف ── *@
                                    <td>
                                        @if (t.CustomerName is not null || t.SupplierName is not null)
                                        {
                                            <div class="tr-party-name">
                                                @(t.CustomerName ?? t.SupplierName)
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="td-muted">—</span>
                                        }
                                        @if (t.InvoiceNumber is not null)
                                        {
                                            <span class="tr-ref-tag tag-inv">ف @t.InvoiceNumber</span>
                                        }
                                        @if (t.CustodyNumber is not null)
                                        {
                                            <span class="tr-ref-tag tag-cust">ع @t.CustodyNumber</span>
                                        }
                                    </td>

                                    @* ── المرجع ── *@
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(t.ReferenceNumber) || !string.IsNullOrWhiteSpace(t.Description))
                                        {
                                            <div class="tr-ref-desc">
                                                @(t.ReferenceNumber ?? t.Description)
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="td-muted">—</span>
                                        }
                                        @if (t.ChequeNumber is not null)
                                        {
                                            <div class="tr-cheque-tag">
                                                <svg viewBox="0 0 16 16" width="9" height="9"
                                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                                     aria-hidden="true">
                                                    <rect x="2" y="4" width="12" height="9" rx="1"/>
                                                    <path d="M5 8h6M5 11h4" stroke-linecap="round"/>
                                                </svg>
                                                @t.ChequeNumber
                                            </div>
                                        }
                                    </td>

                                    @* ── الحالة ── *@
                                    <td>
                                        @if (t.Status == "Posted")
                                        {
                                            <span class="tr-chip chip-posted">
                                                <span class="tr-chip-dot dot-green" aria-hidden="true"></span>
                                                سارية
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="tr-chip chip-void">
                                                <span class="tr-chip-dot dot-red" aria-hidden="true"></span>
                                                ملغية
                                            </span>
                                        }
                                    </td>

                                    @* ── إجراءات ── *@
                                    @if (CanVoid)
                                    {
                                        <td>
                                            @if (t.Status == "Posted")
                                            {
                                                @if (_confirmId == t.CashTransactionId)
                                                {
                                                    <button class="tr-confirm-void"
                                                            @onclick="() => Void(t)">
                                                        إلغاء؟
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="tr-act-btn act-void"
                                                            @onclick="() => _confirmId = t.CashTransactionId"
                                                            title="إلغاء الحركة"
                                                            aria-label="إلغاء @t.CashTransactionId">
                                                        <svg viewBox="0 0 24 24" width="14" height="14"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"/>
                                                            <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                                                        </svg>
                                                    </button>
                                                }
                                            }
                                        </td>
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }
</div>


@* ═══════════════════════════════════════════
   MODAL — حركة جديدة
═══════════════════════════════════════════ *@
@if (_postOpen && CanPost)
{
    <div class="tr-modal-backdrop" @onclick="ClosePost"
         role="dialog" aria-modal="true" aria-label="حركة خزينة جديدة">
        <div class="tr-modal tr-modal-xl" @onclick:stopPropagation="true">

            <div class="tr-modal-head">
                <div class="tr-modal-icon @(_pf.Type == "Receipt" ? "icon-green" : "icon-red")"
                     aria-hidden="true">
                    @if (_pf.Type == "Receipt")
                    {
                        <svg viewBox="0 0 24 24" width="22" height="22"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2v20M2 12l10-10 10 10" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="22" height="22"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22V2M22 12l-10 10L2 12" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                </div>
                <div style="flex:1; min-width:0">
                    <div class="tr-modal-title">حركة خزينة جديدة</div>
                    <div class="tr-modal-sub">الرصيد بيتحدّث أوتوماتيك بعد الحفظ</div>
                </div>
                <button class="tr-modal-close" @onclick="ClosePost" aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="tr-modal-banner @(_ok ? "banner-success" : "banner-error")" role="alert">
                    <span>@_msg</span>
                    <button class="tr-banner-close" @onclick="() => _msg = null"
                            aria-label="إغلاق التنبيه">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                             stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }

            <div class="tr-modal-body">

                @* ── نوع الحركة ── *@
                <div class="tr-type-toggle" role="group" aria-label="نوع الحركة">
                    <button type="button"
                            class="tr-type-btn @(_pf.Type == "Receipt" ? "type-receipt" : "")"
                            @onclick='() => { _pf.Type = "Receipt"; _pf.CustomerId = 0; _openInvoices = new(); }'
                            aria-pressed="@(_pf.Type == "Receipt")">
                        <svg viewBox="0 0 24 24" width="18" height="18"
                             fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M12 2v20M2 12l10-10 10 10" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        قبض (وارد)
