@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("MASTERDATA.VIEW")   ?? false;
    private bool CanManage => _user?.Can("MASTERDATA.MANAGE") ?? false;

    private List<Item> _items = new();
    private bool    _loading;
    private string  _search    = "";
    private bool    _saving;
    private string? _msg;
    private bool    _ok        = true;
    private bool    _fabOpen;
    private bool    _modalOpen;
    private bool    _triedSave;
    private int?    _editId;
    private Form    _f = new();
    private Item?   _deleteItem;

    public class Item
    {
        public int      ContainerTypeId  { get; set; }
        public string   Code             { get; set; } = "";
        public string   NameAr           { get; set; } = "";
        public string?  NameEn           { get; set; }
        public byte     SizeFeet         { get; set; }
        public bool     IsReefer         { get; set; }
        public decimal? GuaranteeAmount  { get; set; }
        public bool     IsActive         { get; set; }
        public int      UsageCount       { get; set; }
    }

    public class Form
    {
        public string   Code            { get; set; } = "";
        public string   NameAr          { get; set; } = "";
        public string?  NameEn          { get; set; }
        public int      SizeFeet        { get; set; } = 40;
        public bool     IsReefer        { get; set; }
        public decimal? GuaranteeAmount { get; set; }
        public bool     IsActive        { get; set; } = true;
        public int      UsageCount      { get; set; }
    }

    private IEnumerable<Item> Filtered => _items.Where(i =>
        string.IsNullOrWhiteSpace(_search) ||
        i.Code.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        i.NameAr.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        (i.NameEn ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (!CanView) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _items = await Http.GetFromJsonAsync<List<Item>>("api/container-types") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("فشل التحميل: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ToggleFab() { _fabOpen = !_fabOpen; StateHasChanged(); }

    private async Task HandleReload()
    {
        _fabOpen = false;
        StateHasChanged();
        await LoadAsync();
        Snackbar.Add("تم تحديث البيانات", Severity.Success);
    }

    private async Task HandleOpenCreate()
    {
        _fabOpen = false;
        StateHasChanged();
        await Task.Delay(180);
        ResetForm();
        _modalOpen = true;
        StateHasChanged();
    }

    private void ResetForm()
    {
        _editId    = null;
        _f         = new Form();
        _msg       = null;
        _triedSave = false;
        StateHasChanged();
    }

    private void OpenEdit(Item t)
    {
        _editId = t.ContainerTypeId;
        _f = new Form
        {
            Code            = t.Code,
            NameAr          = t.NameAr,
            NameEn          = t.NameEn,
            SizeFeet        = t.SizeFeet,
            IsReefer        = t.IsReefer,
            GuaranteeAmount = t.GuaranteeAmount,
            IsActive        = t.IsActive,
            UsageCount      = t.UsageCount
        };
        _msg       = null;
        _triedSave = false;
        _modalOpen = true;
        StateHasChanged();
    }

    private void CloseModal() { _modalOpen = false; StateHasChanged(); }

    private void AskDelete(Item t) { _deleteItem = t; StateHasChanged(); }

    private async Task ConfirmDeleteAsync()
    {
        if (_saving || _deleteItem is null) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var res = await Http.DeleteAsync($"api/container-types/{_deleteItem.ContainerTypeId}");
            var msg = await MsgOf(res);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(msg, Severity.Success);
                _deleteItem = null;
                await LoadAsync();
            }
            else Snackbar.Add(msg, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("فشل: " + ex.Message, Severity.Error); }
        finally { _saving = false; StateHasChanged(); }
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _triedSave = true;

        if (string.IsNullOrWhiteSpace(_f.Code))
        {
            _ok = false; _msg = "الكود مطلوب";
            StateHasChanged(); return;
        }
        if (string.IsNullOrWhiteSpace(_f.NameAr))
        {
            _ok = false; _msg = "الاسم بالعربية مطلوب";
            StateHasChanged(); return;
        }
        if (_f.SizeFeet is <= 0 or > 60)
        {
            _ok = false; _msg = "المقاس من 1 إلى 60 قدمًا";
            StateHasChanged(); return;
        }

        _saving = true; _msg = null;
        StateHasChanged();

        try
        {
            var payload = new
            {
                code            = _f.Code.Trim(),
                nameAr          = _f.NameAr.Trim(),
                nameEn          = _f.NameEn?.Trim(),
                sizeFeet        = _f.SizeFeet,
                isReefer        = _f.IsReefer,
                guaranteeAmount = _f.GuaranteeAmount is > 0 ? _f.GuaranteeAmount : null,
                isActive        = _f.IsActive
            };

            var res = _editId is null
                ? await Http.PostAsJsonAsync("api/container-types", payload)
                : await Http.PutAsJsonAsync($"api/container-types/{_editId}", payload);

            _msg = await MsgOf(res);
            _ok  = res.IsSuccessStatusCode;

            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(_msg, Severity.Success);
                CloseModal();
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _ok  = false;
            _msg = "فشل: " + ex.Message;
            Snackbar.Add(_msg, Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch
        {
            return res.IsSuccessStatusCode ? "تمت العملية بنجاح" : "حدث خطأ غير متوقع";
        }
    }
}
