    .svc-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 20px; flex: 0 0 auto;
        font-size: 12.5px; font-weight: 600;
    }

    .svc-banner-ok  { background: #e9f8f0; color: #0e7a43; border-bottom: 1px solid #b5e8d0; }
    .svc-banner-err { background: #fff0f2; color: #D64545; border-bottom: 1px solid #ffc8cf; }
    .svc-banner-ic  { flex: 0 0 auto; }
