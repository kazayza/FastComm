@page "/master/containertypes"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>أنواع الحاويات — فاست كوم</PageTitle>

<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">
            <div class="doc-hero-row">
                <div class="doc-hero-left">
                    <div class="doc-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                            <path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"/>
                        </svg>
                        <span>البيانات الأساسية · أنواع الحاويات</span>
                    </div>
                    <h1 class="fc-hero-title">أنواع الحاويات</h1>
                    <p class="fc-hero-sub">عادية وثلاجة ومولد — مع مبلغ ضمان كل نوع</p>
                </div>
                <div class="doc-hero-right">
                    <span class="doc-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>
            @if (CanView)
            {
                <div class="doc-kpis-row">
                    <div class="doc-kpi doc-kpi-blue">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_items.Count</div>
                                <div class="doc-kpi-label">الأنواع المسجلة</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-green">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_items.Count(i => i.IsActive)</div>
                                <div class="doc-kpi-label">أنواع نشطة</div>
                            </div>
                        </div>
                    </div>
                    <div class="doc-kpi doc-kpi-amber">
                        <div class="doc-kpi-inner">
                            <div class="doc-kpi-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small"/>
                            </div>
                            <div class="doc-kpi-data">
                                <div class="doc-kpi-num">@_items.Count(i => i.GuaranteeAmount is > 0)</div>
                                <div class="doc-kpi-label">لها مبلغ ضمان</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="doc-body">
    @if (!CanView)
    {
        <div class="doc-state-box">
            <div class="state-icon-wrap perm">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none"
                     stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليست لديك الصلاحية الكافية لعرض أنواع الحاويات</p>
        </div>
    }
    else
    {
        <div class="fc-overlap">
            <div class="doc-card">

                <div class="doc-banner banner-info" role="alert">
                    <div class="banner-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <span>
                        <strong>مبلغ الضمان</strong> لكل نوع يُستخدم في حساب ضمان العمليات تلقائيًا
                        (بانل الضمان في فورم العملية) — تكلفة على الشركة <strong>غير مستردة</strong>،
                        تُصرف لمورد الضمان.
                    </span>
                </div>

                <div class="doc-toolbar">
                    <div class="doc-search-wrap">
                        <svg class="doc-search-icon" viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                        </svg>
                        <input class="doc-search-input"
                               placeholder="ابحث بالكود أو الاسم..."
                               @bind="_search" @bind:event="oninput"
                               aria-label="البحث"/>
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <button class="doc-search-clear"
                                    @onclick="() => _search = string.Empty"
                                    aria-label="مسح" type="button">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                     stroke="currentColor" stroke-width="2.5">
                                    <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                                </svg>
                            </button>
                        }
                    </div>
                    <div class="doc-results-badge">
                        <svg viewBox="0 0 16 16" width="11" height="11" fill="none"
                             stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <circle cx="8" cy="8" r="6"/>
                            <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                        </svg>
                        عرض <strong>@Filtered.Count()</strong> من <strong>@_items.Count</strong>
                    </div>
                </div>

                @if (_loading)
                {
                    <div class="doc-loading">
                        <div class="doc-spinner"></div>
                        <span>جاري تحميل أنواع الحاويات...</span>
                    </div>
                }
                else
                {
                    <div class="doc-table-wrap">
                        <table class="doc-table" aria-label="جدول أنواع الحاويات">
                            <thead>
                                <tr>
                                    <th scope="col" class="th-start">الكود</th>
                                    <th scope="col" class="th-start">الاسم</th>
                                    <th scope="col">المقاس</th>
                                    <th scope="col">ثلاجة</th>
                                    <th scope="col">مبلغ الضمان</th>
                                    <th scope="col">الاستخدام</th>
                                    @if (CanManage)
                                    {
                                        <th scope="col" style="width:170px">إجراءات</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Filtered)
                                {
                                    <tr class="@(_editId == t.ContainerTypeId ? "row--editing" : "")">
                                        <td class="td-start">
                                            <span class="doc-type-badge">@t.Code</span>
                                        </td>
                                        <td class="td-start">
                                            <div class="doc-file-info">
                                                <span class="doc-file-title">@t.NameAr</span>
                                                @if (!string.IsNullOrWhiteSpace(t.NameEn))
                                                {
                                                    <span class="doc-file-desc">@t.NameEn</span>
                                                }
                                            </div>
                                        </td>
                                        <td><span class="doc-type-badge">@t.SizeFeet قدم</span></td>
                                        <td>
                                            <span class="usage-badge @(t.IsReefer ? "usage-badge--active" : "usage-badge--zero")">
                                                @(t.IsReefer ? "ثلاجة" : "عادية")
                                            </span>
                                        </td>
                                        <td>
                                            @if (t.GuaranteeAmount is > 0)
                                            {
                                                <span class="tax-badge tax-badge--has">@t.GuaranteeAmount.Value.ToString("N2") ج.م</span>
                                            }
                                            else
                                            {
                                                <span class="tax-badge tax-badge--none">غير محدد</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="usage-badge @(t.UsageCount > 0 ? "usage-badge--active" : "usage-badge--zero")">
                                                @t.UsageCount
                                            </span>
                                        </td>
                                        @if (CanManage)
                                        {
                                            <td>
                                                <div class="doc-row-actions">
                                                    <button class="doc-btn-download"
                                                            @onclick="() => OpenEdit(t)"
                                                            title="تعديل" type="button">
                                                        <svg viewBox="0 0 24 24" width="13" height="13"
                                                             fill="none" stroke="currentColor" stroke-width="2.5">
                                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                        </svg>
                                                        تعديل
                                                    </button>
                                                    @if (t.UsageCount == 0)
                                                    {
                                                        <button class="doc-btn-download"
                                                                @onclick="() => AskDelete(t)"
                                                                title="حذف" type="button">
                                                            <svg viewBox="0 0 24 24" width="13" height="13"
                                                                 fill="none" stroke="currentColor" stroke-width="2.5">
                                                                <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"
                                                                      stroke-linecap="round" stroke-linejoin="round"/>
                                                            </svg>
                                                            حذف
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                                @if (!Filtered.Any())
                                {
                                    <tr>
                                        <td colspan="@(CanManage ? "7" : "6")">
                                            <div class="doc-empty-table">لا توجد أنواع حاويات مطابقة</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* ══════════════ FAB ══════════════ *@
@if (CanManage && !_loading)
{
    @if (_fabOpen)
    {
        <div class="fc-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
    }

    <div class="fc-fab-container">
        <div class="fc-fab-menu @(_fabOpen ? "fc-fab-menu--open" : "")" role="menu">
            <button type="button" class="fc-fab-item" role="menuitem"
                    @onclick="HandleOpenCreate">
                <span class="fc-fab-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/>
                </span>
                <span class="fc-fab-label">نوع حاوية جديد</span>
            </button>
            <button type="button" class="fc-fab-item" role="menuitem"
                    @onclick="HandleReload">
                <span class="fc-fab-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"/>
                </span>
                <span class="fc-fab-label">تحديث البيانات</span>
            </button>
        </div>

        <button type="button"
                class="fc-fab-main fc-glow-gold @(_fabOpen ? "is-open" : "")"
                @onclick="ToggleFab"
                aria-label="التحكم"
                aria-expanded="@(_fabOpen ? "true" : "false")">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none"
                 stroke="currentColor" stroke-width="2.5"
                 class="fc-fab-svg" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
}

@* ══════════════ MODAL — إضافة/تعديل ══════════════ *@
@if (_modalOpen && CanManage)
{
    <div class="svc-modal-backdrop" @onclick="CloseModal"
         role="dialog" aria-modal="true">
        <div class="svc-modal" @onclick:stopPropagation="true">

            <div class="svc-modal-head">
                <div class="svc-head-icon @(_editId is null ? "svc-icon-create" : "svc-icon-edit")"
                     aria-hidden="true">
                    @if (_editId is null)
                    {
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="8 12 12 16 16 12"/>
                            <line x1="12" y1="8" x2="12" y2="16"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                    }
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">
                        @(_editId is null ? "إضافة نوع حاوية جديد" : "تعديل نوع الحاوية")
                    </div>
                    <div class="svc-head-sub">
                        @if (_editId is null)
                        {
                            <span>تحديد الكود والاسم والمقاس ومبلغ الضمان</span>
                        }
                        else
                        {
                            <span>تعديل: <strong>@_f.NameAr</strong> (@_f.Code)</span>
                        }
                    </div>
                </div>
                <button class="svc-head-close" @onclick="CloseModal"
                        aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                         stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            @if (_msg is not null)
            {
                <div class="svc-banner @(_ok ? "svc-banner-ok" : "svc-banner-err")"
                     role="alert">
                    <div class="svc-banner-ic" aria-hidden="true">
                        @if (_ok)
                        {
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                 stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/>
                            </svg>
                        }
                    </div>
                    <span class="svc-banner-msg">@_msg</span>
                    <button class="svc-banner-x" @onclick="() => _msg = null" type="button">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }

            <div class="svc-modal-body">
                <div class="svc-section">
                    <div class="svc-section-head">
                        <div class="svc-section-ic blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                <path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"/>
                            </svg>
                        </div>
                        <div>
                            <div class="svc-section-title">بيانات النوع</div>
                            <div class="svc-section-sub">
                                الكود بالحروف الإنجليزية — مثل DRY-40 أو REEFER-20
                            </div>
                        </div>
                    </div>

                    <div class="svc-grid">
                        <div class="svc-field">
                            <label class="svc-label" for="ct-code">
                                الكود التعريفي <span class="svc-req">*</span>
                            </label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <polyline points="16 18 22 12 16 6"/>
                                        <polyline points="8 6 2 12 8 18"/>
                                    </svg>
                                </span>
                                <input id="ct-code"
                                       class="svc-input ltr with-prefix @(_triedSave && string.IsNullOrWhiteSpace(_f.Code) ? "svc-err" : "")"
                                       @bind="_f.Code" maxlength="30" dir="ltr"
                                       placeholder="مثال: DRY-40"
                                       disabled="@(_editId is not null && _f.UsageCount > 0)"/>
                            </div>
                            @if (_editId is not null && _f.UsageCount > 0)
                            {
                                <div class="svc-hint warn">
                                    <svg viewBox="0 0 16 16" width="11" height="11" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="7" width="10" height="7" rx="1"/>
                                        <path d="M5 7V5a3 3 0 016 0v2"/>
                                    </svg>
                                    مقفل — مستخدم في @_f.UsageCount بند
                                </div>
                            }
                            @if (_triedSave && string.IsNullOrWhiteSpace(_f.Code))
                            {
                                <div class="svc-err-msg">الكود مطلوب</div>
                            }
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="ct-namear">
                                الاسم بالعربية <span class="svc-req">*</span>
                            </label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M4 7V4h16v3M9 20h6M12 4v16"/>
                                    </svg>
                                </span>
                                <input id="ct-namear"
                                       class="svc-input with-prefix @(_triedSave && string.IsNullOrWhiteSpace(_f.NameAr) ? "svc-err" : "")"
                                       @bind="_f.NameAr" maxlength="100"
                                       placeholder="مثال: حاوية 40 قدم عادية"/>
                            </div>
                            @if (_triedSave && string.IsNullOrWhiteSpace(_f.NameAr))
                            {
                                <div class="svc-err-msg">الاسم بالعربية مطلوب</div>
                            }
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="ct-nameen">
                                الاسم بالإنجليزية
                            </label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
                                    </svg>
                                </span>
                                <input id="ct-nameen"
                                       class="svc-input ltr with-prefix"
                                       @bind="_f.NameEn" maxlength="100"
                                       dir="ltr" placeholder="e.g. 40ft Dry"/>
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="ct-size">
                                المقاس (قدم) <span class="svc-req">*</span>
                            </label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M21 3H3v18" stroke-linecap="round"/>
                                        <path d="M7 3v4M11 3v6M15 3v4M19 3v6" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <input id="ct-size" type="number" min="1" max="60"
                                       class="svc-input ltr with-prefix @(_triedSave && _f.SizeFeet <= 0 ? "svc-err" : "")"
                                       @bind="_f.SizeFeet" dir="ltr" placeholder="40"/>
                            </div>
                            @if (_triedSave && _f.SizeFeet <= 0)
                            {
                                <div class="svc-err-msg">المقاس من 1 إلى 60 قدمًا</div>
                            }
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="ct-reefer">
                                ثلاجة
                            </label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <select id="ct-reefer"
                                        class="svc-input svc-select with-prefix"
                                        @bind="_f.IsReefer">
                                    <option value="false">عادية</option>
                                    <option value="true">ثلاجة</option>
                                </select>
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="ct-guar">
                                مبلغ الضمان (ج.م)
                            </label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                </span>
                                <input id="ct-guar" type="number" min="0" step="0.01"
                                       class="svc-input ltr with-prefix"
                                       @bind="_f.GuaranteeAmount" dir="ltr"
                                       placeholder="0.00"/>
                            </div>
                            <div class="svc-hint">
                                مبلغ ثابت لكل حاوية من هذا النوع — تكلفة على الشركة غير مستردة
                            </div>
                        </div>

                        <div class="svc-field">
                            <label class="svc-label" for="ct-active">
                                الحالة
                            </label>
                            <div class="svc-input-wrap">
                                <span class="svc-prefix">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                        <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                                <select id="ct-active"
                                        class="svc-input svc-select with-prefix"
                                        @bind="_f.IsActive">
                                    <option value="true">نشط — يظهر في الحجوزات</option>
                                    <option value="false">معطل — مخفي من الاختيار</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="svc-modal-foot">
                <div class="svc-foot-left">
                    @if (_editId is not null)
                    {
                        <button class="svc-btn-reset" @onclick="ResetForm" type="button">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <polyline points="1 4 1 10 7 10"/>
                                <path d="M3.51 15a9 9 0 102.13-9.36L1 10"/>
                            </svg>
                            إعادة تعيين
                        </button>
                    }
                </div>
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="CloseModal" type="button">
                        إلغاء
                    </button>
                    <button class="svc-btn-save" @onclick="SaveAsync"
                            disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none"
                                 stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>@(_editId is null ? "إضافة النوع" : "حفظ التعديلات")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ══════════════ MODAL — تأكيد الحذف ══════════════ *@
@if (_deleteItem is not null && CanManage)
{
    <div class="svc-modal-backdrop" @onclick="() => _deleteItem = null"
         role="dialog" aria-modal="true">
        <div class="svc-modal" style="max-width: 440px;" @onclick:stopPropagation="true">
            <div class="svc-modal-head">
                <div class="svc-head-icon svc-icon-edit" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="svc-head-text">
                    <div class="svc-head-title">تأكيد الحذف</div>
                    <div class="svc-head-sub">
                        سيتم حذف النوع <strong>@_deleteItem.NameAr</strong> (@_deleteItem.Code)
                    </div>
                </div>
                <button class="svc-head-close" @onclick="() => _deleteItem = null"
                        aria-label="إغلاق" type="button">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                         stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <div class="svc-modal-foot">
                <div class="svc-foot-left"></div>
                <div class="svc-foot-right">
                    <button class="svc-btn-cancel" @onclick="() => _deleteItem = null" type="button">
                        تراجع
                    </button>
                    <button class="svc-btn-save" @onclick="ConfirmDeleteAsync"
                            disabled="@_saving" type="button">
                        @if (_saving)
                        {
                            <span class="svc-spinner"></span>
                            <span>جاري الحذف...</span>
                        }
                        else
                        {
                            <span>تأكيد الحذف</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .hero-wrapper {
        padding: 16px clamp(14px, 2.4vw, 34px) 0;
