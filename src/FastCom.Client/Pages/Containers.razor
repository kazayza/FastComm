</style>

@code {
    private AuthUser? _user;
    private bool CanView   => _user?.Can("MASTERDATA.VIEW") ?? false;
    private bool CanManage => _user?.Can("MASTERDATA.MANAGE") ?? false;

    private static readonly Dictionary<string, string> Tabs = new()
    {
        ["all"] = "الكل", 
        ["Available"] = "متاحة", 
        ["InTransit"] = "في الطريق",
        ["AtPort"] = "في الميناء", 
        ["AtDepot"] = "في المخزن",
        ["Delivered"] = "تم التسليم", 
        ["Returned"] = "مرتجعة"
    };

    private List<Item> _items = new();
    private bool _loading; 
    private string _search = ""; 
    private string _tab = "all";
    private long? _confirmId;
    private bool _fabOpen;

    public class Item
    {
        public long ContainerId { get; set; }
        public string ContainerNumber { get; set; } = "";
        public string TypeName { get; set; } = "";
        public byte SizeFeet { get; set; }
        public bool IsReefer { get; set; }
        public string OwnerType { get; set; } = "";
        public string? OwnerName { get; set; }
        public decimal? WeightKg { get; set; }
        public string CurrentStatus { get; set; } = "";
    }

    private static string StatusAr(string s) => s switch
    {
        "Available" => "متاحة للتشغيل", 
        "InTransit" => "في الطريق", 
        "AtPort" => "في الميناء",
        "AtDepot" => "في المخزن", 
        "Delivered" => "تم التسليم", 
        "Returned" => "مرتجعة", 
        _ => s
    };

    private static string OwnerAr(string o) => o switch
    {
        "ShippingLine" => "خط ملاحي", 
        "Customer" => "عميل خارجي",
        "Leased" => "مستأجرة", 
        "Company" => "ملكية داخلية", 
        _ => o
    };

    private static string StatusChipClass(string s) => s switch
    {
        "Available" => "chip-available", 
        "InTransit" => "chip-intransit",
        "AtPort" => "chip-atport", 
        "AtDepot" => "chip-atdepot",
        "Delivered" => "chip-delivered", 
        "Returned" => "chip-returned", 
        _ => "chip-available"
    };

    private static string StatusDotClass(string s) => s switch
    {
        "Available" => "dot-available", 
        "InTransit" => "dot-intransit",
        "AtPort" => "dot-atport", 
        "AtDepot" => "dot-atdepot",
        "Delivered" => "dot-delivered", 
        "Returned" => "dot-returned", 
        _ => "dot-available"
    };

    private static string ContainerAvatarClass(string s) => s switch
    {
        "Available" => "av-available", 
        "InTransit" => "av-intransit",
        "AtPort" => "av-atport", 
        "AtDepot" => "av-atdepot",
        "Delivered" => "av-delivered", 
        "Returned" => "av-returned", 
        _ => "av-available"
    };

    private static string NormalizeArabic(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        string[] diacritics = new[] { "َ", "ُ", "ِ", "ّ", "ً", "ٌ", "ٍ", "ْ", "ـ" };
        foreach (var d in diacritics) s = s.Replace(d, "");
        return s
            .Replace('أ', 'ا').Replace('إ', 'ا').Replace('آ', 'ا').Replace('ٱ', 'ا').Replace('ء', 'ا')
            .Replace('ة', 'ه').Replace('ى', 'ي').Replace('ؤ', 'و').Replace('ئ', 'ي')
            .Replace("  ", " ").ToLowerInvariant().Trim();
    }

    private IEnumerable<Item> Filtered => _items.Where(c =>
        (_tab == "all" || c.CurrentStatus == _tab) &&
        (string.IsNullOrWhiteSpace(_search) ||
         NormalizeArabic(c.ContainerNumber).Contains(NormalizeArabic(_search)) ||
         NormalizeArabic(c.OwnerName ?? "").Contains(NormalizeArabic(_search))));

    protected override async Task OnInitializedAsync()
    {
        _user = await Auth.GetUserAsync();
        if (CanView) await LoadAsync();
    }

    private void GoNew() => Nav.NavigateTo("/containers/new");
    private void GoEdit(Item c) => Nav.NavigateTo($"/containers/new/{c.ContainerId}");

    private async Task Reload() { await LoadAsync(); }

    private void SetTab(string t) { _tab = t; _confirmId = null; }
    private void ToggleFab() => _fabOpen = !_fabOpen;

    /* ── دالة إعادة ضبط الفلاتر والبحث الجاري للـ Empty State ── */
    private void ResetFilters()
    {
        _search = "";
        _tab = "all";
        _confirmId = null;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<Item>>("api/containers") ?? new(); }
        catch (Exception ex) { Snackbar.Add("تعذر تحميل الحاويات: " + ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task Delete(Item c)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/containers/{c.ContainerId}");
            Snackbar.Add(await MsgOf(res), res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            _confirmId = null;
            if (res.IsSuccessStatusCode) await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add("فشل الإلغاء: " + ex.Message, Severity.Error); }
    }

    private static async Task<string> MsgOf(HttpResponseMessage res)
    {
        try
        {
            var b = await res.Content.ReadAsStringAsync();
            var d = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(b);
            return d.TryGetProperty("message", out var m) ? m.GetString() ?? b : b;
        }
        catch { return res.IsSuccessStatusCode ? "تم بنجاح" : $"حدث خطأ {(int)res.StatusCode}"; }
    }
}