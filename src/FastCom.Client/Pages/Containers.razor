@page "/containers"
@attribute [Authorize]
@using System.Net.Http.Json
@using FastCom.Client.Auth
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>إدارة الحاويات التشغيلية — فاست كوم</PageTitle>

@* ═══════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════ *@
<div class="hero-wrapper">
    <div class="fc-hero fc-hero-slim">
        <div class="fc-hero-inner">

            <div class="flt-hero-row">
                <div class="flt-hero-left">
                    <div class="flt-hero-crumb">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                            <line x1="8" y1="21" x2="16" y2="21"/>
                            <line x1="12" y1="17" x2="12" y2="21"/>
                        </svg>
                        <span>البيانات الأساسية · الأسطول التشغيلي</span>
                    </div>
                    <h1 class="fc-hero-title fc-hero-title-slim">دليل وإدارة الحاويات</h1>
                    <span class="flt-hero-sub">متابعة الحاويات الفعلية — تحديد النوع والمواصفات الفنية، جهات الملكية، والموقع الجغرافي الحالي للحاوية</span>
                </div>

                <div class="flt-hero-right">
                    <button type="button" class="flt-hero-refresh" @onclick="Reload" title="تحديث البيانات">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 4v6h-6"/>
                            <path d="M1 20v-6h6"/>
                            <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                        </svg>
                    </button>
                    @if (CanManage)
                    {
                        <button type="button" class="flt-hero-add" @onclick="GoNew" title="تسجيل حاوية جديدة">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                            </svg>
                            تسجيل حاوية جديدة
                        </button>
                    }
                    <span class="flt-hero-chip">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
                        </svg>
                        @DateTime.Now.ToString("dddd، dd MMMM yyyy")
                    </span>
                </div>
            </div>

            @* ── KPI Connected Glass Strip (Tied with Filters) ── *@
            @if (CanView && !_loading)
            {
                <div class="flt-kpis-strip">

                    <div class="flt-kpi-item @(_tab == "all" ? "kpi-active" : "")" @onclick='() => SetTab("all")' role="button" tabindex="0" title="عرض إجمالي الحاويات">
                        <div class="flt-kpi-icon kpi-blue">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                <line x1="8" y1="21" x2="16" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">إجمالي الحاويات</div>
                            <div class="flt-kpi-val">@_items.Count</div>
                        </div>
                    </div>

                    <div class="flt-kpi-div" aria-hidden="true"></div>

                    <div class="flt-kpi-item @(_tab == "Available" ? "kpi-active" : "")" @onclick='() => SetTab("Available")' role="button" tabindex="0" title="تصفية الحاويات المتاحة">
                        <div class="flt-kpi-icon kpi-green">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                                <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">حاويات جاهزة ومتاحة</div>
                            <div class="flt-kpi-val val-green">@_items.Count(c => c.CurrentStatus == "Available")</div>
                        </div>
                    </div>

                    <div class="flt-kpi-div" aria-hidden="true"></div>

                    <div class="flt-kpi-item @(_tab == "InTransit" ? "kpi-active" : "")" @onclick='() => SetTab("InTransit")' role="button" tabindex="0" title="تصفية الحاويات التي في الطريق">
                        <div class="flt-kpi-icon kpi-amber">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="3" width="15" height="13" rx="2"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">حاويات قيد النقل</div>
                            <div class="flt-kpi-val val-amber">@_items.Count(c => c.CurrentStatus == "InTransit")</div>
                        </div>
                    </div>

                    <div class="flt-kpi-div" aria-hidden="true"></div>

                    <div class="flt-kpi-item">
                        <div class="flt-kpi-icon kpi-red">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </div>
                        <div class="flt-kpi-text">
                            <div class="flt-kpi-label">الحاويات المبرّدة (Reefer)</div>
                            <div class="flt-kpi-val val-red">@_items.Count(c => c.IsReefer)</div>
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>
</div>


@* ═══════════════════════════════════════════
   BODY SECTION
═══════════════════════════════════════════ *@
<div class="flt-body">

    @if (!CanView)
    {
        <div class="flt-state-box">
            <div class="flt-state-icon perm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>ليس لديك صلاحية</h3>
            <p>ليست لديك الصلاحية الأمنية الكافية لعرض بيانات وجداول الحاويات.</p>
        </div>
    }
    else
    {
        <div class="flt-card">

            @* ── Toolbar ── *@
            <div class="flt-toolbar">

                <div class="flt-search-wrap">
                    <svg class="flt-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
                    </svg>
                    <input class="flt-search-input"
                           placeholder="البحث برقم الحاوية أو جهة الملكية..."
                           @bind="_search" @bind:event="oninput"
                           aria-label="البحث في الحاويات" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button type="button" class="flt-search-clear" @onclick="() => _search = string.Empty" title="مسح البحث">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                <div class="flt-results-badge">
                    <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="8" cy="8" r="6"/>
                        <path d="M8 5v3M8 11h.01" stroke-linecap="round"/>
                    </svg>
                    عرض <strong>@Filtered.Count()</strong> من إجمالي <strong>@_items.Count</strong> حاوية
                </div>

            </div>


            @* ── Status Filtering Tabs ── *@
            <div class="flt-tab-bar">
                <div class="flt-tabs" role="group" aria-label="تصفية الحاويات حسب الحالة">
                    @foreach (var t in Tabs)
                    {
                        var count = t.Key == "all"
                            ? _items.Count
                            : _items.Count(x => x.CurrentStatus == t.Key);

                        <button type="button" class='flt-tab @(_tab == t.Key ? "active" : "")' @onclick="() => SetTab(t.Key)">
                            @t.Value
                            <span class="flt-tab-count">@count</span>
                        </button>
                    }
                </div>
            </div>


            @* ── Table Content ── *@
            @if (_loading)
            {
                <div class="flt-loading">
                    <div class="flt-spinner" aria-label="جاري التحميل"></div>
                    <span>جاري تحميل سجلات الأسطول الجارية...</span>
                </div>
            }
            else if (!Filtered.Any())
            {
                @* ── الموديل الجديد والفاخر لحالة عدم وجود نتائج ── *@
                <div class="flt-empty-state-box">
                    <div class="flt-empty-glow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.6">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                            <line x1="8" y1="21" x2="16" y2="21"/>
                            <line x1="12" y1="17" x2="12" y2="21"/>
                        </svg>
                    </div>
                    <h3 class="flt-empty-title">لا توجد نتائج مطابقة للتصفية الحالية</h3>
                    <p class="flt-empty-sub">حاول تغيير الحالة النشطة من شريط التبويبات بالأعلى، أو قم بمسح نص البحث الجاري للبدء من جديد.</p>
                    @if (!string.IsNullOrWhiteSpace(_search) || _tab != "all")
                    {
                        <button type="button" class="flt-empty-reset-btn" @onclick="ResetFilters">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
                                <path d="M23 4v6h-6M1 20v-6h6"/>
                                <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                            </svg>
                            إعادة تعيين الفلاتر والبحث
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="flt-table-wrap">
                    <table class="flt-table" aria-label="سجلات الحاويات والعهدة">
                        <thead>
                            <tr>
                                <th class="th-start">رقم الحاوية</th>
                                <th>نوع الحاوية</th>
                                <th>الأبعاد والمقاس</th>
                                <th>التبعية والملكية</th>
                                <th>الوزن الأقصى</th>
                                <th>الوضع الحالي</th>
                                @if (CanManage) { <th style="width:110px">إجراءات</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Filtered)
                            {
                                <tr>
                                    <td class="td-start">
                                        <div class="flt-item-cell">
                                            <div class="flt-avatar @ContainerAvatarClass(c.CurrentStatus)" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                                    <line x1="8" y1="21" x2="16" y2="21"/>
                                                </svg>
                                            </div>
                                            <div class="flt-item-info">
                                                <div class="flt-code-plate">
                                                    <span class="flt-code-chip">@c.ContainerNumber</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="flt-type-tag text-dark">@c.TypeName</span>
                                    </td>

                                    <td>
                                        <div class="flt-type-cell">
                                            <span class="flt-type-tag">@c.SizeFeet قدم</span>
                                            @if (c.IsReefer)
                                            {
                                                <span class="flt-reefer-badge" title="حاوية مبردة فريش">
                                                    <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                                    </svg>
                                                    مبردة
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <div class="flt-type-cell" style="align-items: flex-start;">
                                            <span class="flt-ownership-badge @(c.OwnerType == "Company" ? "ownership-company" : "ownership-external")">
                                                @OwnerAr(c.OwnerType)
                                            </span>
                                            @if (!string.IsNullOrEmpty(c.OwnerName))
                                            {
                                                <div class="flt-brand-sub mt-1">@c.OwnerName</div>
                                            }
                                        </div>
                                    </td>

                                    <td class="td-muted font-mono">
                                        @(c.WeightKg.HasValue ? $"{c.WeightKg:N0} كجم" : "—")
                                    </td>

                                    <td>
                                        <span class="flt-status-chip @StatusChipClass(c.CurrentStatus)">
                                            <span class="flt-status-dot @StatusDotClass(c.CurrentStatus)" aria-hidden="true"></span>
                                            @StatusAr(c.CurrentStatus)
                                        </span>
                                    </td>

                                    @if (CanManage)
                                    {
                                        <td>
                                            <div class="flt-actions">
                                                <button type="button" class="flt-act-btn act-edit" @onclick="() => GoEdit(c)" title="تعديل بيانات الحاوية">
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                                @if (_confirmId == c.ContainerId)
                                                {
                                                    <button type="button" class="flt-confirm-del" @onclick="() => Delete(c)">تأكيد الحذف؟</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="flt-act-btn act-del" @onclick="() => _confirmId = c.ContainerId" title="حذف الحاوية من السجلات">
                                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    }

</div>


@* ── GLOW FAB (موضع ثابت وأداء دقيق في أسفل اليسار) ── *@
@if (CanManage && !_loading)
{
    <div class="glow-fab-wrap @(_fabOpen ? "is-open" : "")">

        <div class="glow-fab-menu" role="menu" aria-label="الإجراءات السريعة">
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="GoNew">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                    </svg>
                </span>
                <span>تسجيل حاوية جديدة</span>
            </button>
            <button type="button" class="glow-fab-item" role="menuitem" @onclick="Reload">
                <span class="glow-fab-item-ic">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M23 4v6h-6"/>
                        <path d="M1 20v-6h6"/>
                        <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                    </svg>
                </span>
                <span>تحديث قائمة السجلات</span>
            </button>
        </div>

        <div class="glow-fab-container">
            <span class="glow-ring glow-ring-1" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-2" aria-hidden="true"></span>
            <span class="glow-ring glow-ring-3" aria-hidden="true"></span>
            <span class="glow-halo" aria-hidden="true"></span>

            <button type="button" class="glow-fab-btn" @onclick="ToggleFab" aria-label="لوحة التحكم" aria-expanded="@(_fabOpen ? "true" : "false")">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.8" class="glow-fab-icon" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

    </div>
}

@if (_fabOpen)
{
    <div class="glow-fab-scrim" @onclick="ToggleFab" aria-hidden="true"></div>
}


@* ═══════════════════════════════════════════
   CSS STYLES
═══════════════════════════════════════════ *@
<style>
    :root {
        --fc-blue:      #1e6ef5;
        --fc-blue-lt:   #eaf1ff;
        --fc-green:     #16a35b;
        --fc-green-lt:  #e9f8f0;
        --fc-red:       #e03048;
        --fc-red-lt:    #fff0f2;
        --fc-amber:     #e09a10;
        --fc-amber-lt:  #fff8e6;
        --fc-purple:    #7c4dbd;
        --fc-purple-lt: #f3eeff;
        --fc-text:      #1c2c44;
        --fc-muted:     #6b7d95;
        --fc-border:    #dde5f0;
        --fc-bg:        #f4f7fb;
        --fc-card:      #ffffff;
        --fc-radius:    14px;
    }

    /* ── Hero ── */
    .hero-wrapper {
        padding: 16px clamp(16px, 3vw, 40px) 0;
        max-width: 1440px; margin: 0 auto; width: 100%;
        box-sizing: border-box; position: relative; z-index: 1;
    }
    .hero-wrapper .fc-hero {
        border-radius: 20px !important; overflow: hidden;
        box-shadow: 0 12px 32px rgba(13,38,84,.15), 0 4px 12px rgba(13,38,84,.08);
        border: 1px solid rgba(255,255,255,.08);
    }
    .hero-wrapper .fc-hero.fc-hero-slim { padding-top: 18px !important; padding-bottom: 22px !important; }

    .flt-hero-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 6px; }
    .flt-hero-left { flex: 1; min-width: 200px; }
    .flt-hero-crumb { display: flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.55); margin-bottom: 2px; }
    .flt-hero-sub { font-size: 13px; color: rgba(255,255,255,.55); font-weight: 600; }
    .flt-hero-right { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .flt-hero-chip { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: 8px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: rgba(255,255,255,.7); font-size: 10.5px; font-weight: 700; white-space: nowrap; }

    .flt-hero-refresh {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255,255,255,.2); background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.75); cursor: pointer; transition: background .15s;
    }
    .flt-hero-refresh:hover { background: rgba(255, 255, 255, 0.14); }

    .flt-hero-add {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 16px; border-radius: 9px;
        border: none; background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff; font-family: inherit; font-size: 12px; font-weight: 800;
        cursor: pointer; box-shadow: 0 4px 14px rgba(22,163,74,.35);
        transition: all .15s ease;
    }
    .flt-hero-add:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(22,163,74,.4); }

    /* ── KPIs Glass Strip ── */
    .flt-kpis-strip {
        display: flex; align-items: stretch;
        background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px); margin-top: 14px;
    }
    .flt-kpi-item {
        flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px 16px;
        cursor: pointer; transition: background .15s ease;
    }
    .flt-kpi-item:hover { background: rgba(255,255,255,.06); }
    .flt-kpi-item.kpi-active { background: rgba(30,110,245,.28); border-radius: 8px; }
    .flt-kpi-div { width: 1px; background: rgba(255,255,255,.10); align-self: stretch; }
    .flt-kpi-icon {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
    }
    .kpi-blue  { background: rgba(30,110,245,.2); color: #93c5fd; }
    .kpi-amber { background: rgba(234,179,8,.2);  color: #fde68a; }
    .kpi-red   { background: rgba(239,68,68,.2);  color: #fca5a5; }
    .kpi-green { background: rgba(34,197,94,.2);  color: #86efac; }

    .flt-kpi-label { font-size: 9.5px; color: rgba(255,255,255,.5); font-weight: 600; }
