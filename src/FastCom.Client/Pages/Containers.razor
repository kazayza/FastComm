    @@keyframes flt-pulse-del { 0%,100% { box-shadow: 0 0 0 0 rgba(224,48,72,.35); } 50% { box-shadow: 0 0 0 5px rgba(224,48,72,0); } }

    /* ── NEW Empty State Premium Box ── */
    .flt-empty-state-box {
